        "-j"
      ],
      "usage": [
        "-j, --jobs <JOBS>"
      ],
      "tip": [
        "Number of parallel downloads (1-64, default: 4)."
      ],
      "next": [
        {
          "name": "1",
          "tip": [
            "Sequential downloads."
          ]
        },
        {
          "name": "16",
          "tip": [
            "Maximum recommended parallelism."
          ]
        },
        {
          "name": "4",
          "tip": [
            "Default parallelism."
          ]
        },
        {
          "name": "8",
          "tip": [
            "Higher parallelism."
          ]
        }
      ]
    },
    {
      "name": "--no-folder",
      "tip": [
        "Download files directly into target without repo folder."
