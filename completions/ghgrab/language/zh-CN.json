          "tip": [
            "用于匹配特定发行版资产的正则表达式。"
          ],
          "next": []
        },
        {
          "name": "--bin-path",
          "usage": [
            "--bin-path <BIN_PATH>"
          ],
          "tip": [
            "将选定的二进制文件安装到指定目录。"
          ],
          "next": []
        },
        {
          "name": "--cwd",
          "tip": [
            "将文件下载到当前目录。"
          ]
        },
        {
          "name": "--extract",
          "tip": [
            "下载后解压归档资产。"
          ]
        },
        {
          "name": "--file-type",
          "usage": [
            "--file-type <FILE_TYPE>"
          ],
          "tip": [
            "首选工件类型。"
          ],
          "next": [
            {
              "name": "any",
              "tip": [
                "任意工件类型（默认）。"
              ]
            },
            {
              "name": "archive",
              "tip": [
                "仅归档文件（zip、tar.gz 等）。"
              ]
            },
            {
              "name": "binary",
              "tip": [
                "仅二进制文件。"
              ]
            }
          ]
        },
        {
          "name": "--os",
          "usage": [
            "--os <OS>"
          ],
          "tip": [
            "覆盖检测到的操作系统。"
          ],
          "next": [
            {
              "name": "linux",
              "tip": [
                "Linux。"
              ]
            },
            {
              "name": "macos",
              "tip": [
                "macOS。"
              ]
            },
            {
              "name": "windows",
              "tip": [
                "Windows。"
              ]
            }
          ]
        },
        {
          "name": "--out",
          "usage": [
            "--out <OUT>"
          ],
          "tip": [
            "本次运行的自定义输出目录。"
          ],
          "next": []
        },
        {
          "name": "--prerelease",
          "tip": [
            "未指定标签时允许选择预发布版本。"
          ]
        },
        {
          "name": "--tag",
          "usage": [
            "--tag <TAG>"
          ],
          "tip": [
            "下载特定的发行版标签。"
          ],
          "next": []
        },
        {
          "name": "--token",
          "usage": [
            "--token <TOKEN>"
          ],
          "tip": [
            "一次性 GitHub 令牌。使用 auto/gh 从 GitHub CLI 读取。"
          ],
          "next": [
            {
              "name": "auto",
              "tip": [
                "运行时从 GitHub CLI 读取令牌。"
              ]
            },
            {
              "name": "gh",
              "tip": [
                "从 GitHub CLI 读取令牌（auto 的别名）。"
              ]
            }
          ]
        }
      ]
    }
