          "tip": [
            "覆盖检测到的架构。"
          ],
          "next": [
            {
              "name": "aarch64",
              "tip": [
                "64 位 ARM。"
              ]
            },
            {
              "name": "amd64",
              "tip": [
                "64 位 x86。"
              ]
            },
            {
              "name": "arm64",
              "tip": [
                "64 位 ARM（别名）。"
              ]
            },
            {
              "name": "x86_64",
              "tip": [
                "64 位 x86（别名）。"
              ]
            }
          ]
        },
        {
          "name": "--asset-regex",
          "usage": [
            "--asset-regex <ASSET_REGEX>"
