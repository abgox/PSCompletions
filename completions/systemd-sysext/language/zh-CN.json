{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "将系统扩展镜像合并到 /usr/ 和 /opt/。"
    ]
  },
  "next": [
    {
      "name": "list",
      "tip": [
        "列出已安装的扩展。"
      ]
    },
    {
      "name": "merge",
      "tip": [
        "将扩展合并到相关层级。"
      ]
    },
    {
      "name": "refresh",
      "tip": [
        "再次取消合并并合并扩展。"
      ]
    },
    {
      "name": "status",
      "tip": [
        "显示当前合并状态（默认）。"
      ]
    },
    {
      "name": "unmerge",
      "tip": [
        "从相关层级取消合并扩展。"
      ]
    }
  ],
  "option": [
    {
      "name": "--force",
      "tip": [
        "忽略版本不兼容。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--image-policy",
      "usage": [
        "--image-policy=POLICY"
      ],
      "tip": [
        "指定磁盘镜像解析策略。"
      ],
      "next": []
    },
    {
      "name": "--json",
      "usage": [
        "--json=pretty|short|off"
      ],
      "tip": [
        "生成 JSON 输出。",
        "可能值: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--mutable",
      "usage": [
        "--mutable=yes|no|auto|import|ephemeral|ephemeral-import"
      ],
      "tip": [
        "指定合并层级的可变模式。",
        "可能值: yes, no, auto, import, ephemeral, ephemeral-import"
      ],
      "next": [
        {
          "name": "auto"
        },
        {
          "name": "ephemeral"
        },
        {
          "name": "ephemeral-import"
        },
        {
          "name": "import"
        },
        {
          "name": "no"
        },
        {
          "name": "yes"
        }
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "不显示页眉和页脚。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--no-reload",
      "tip": [
        "不重新加载服务管理器。"
      ]
    },
    {
      "name": "--noexec",
      "usage": [
        "--noexec=BOOL"
      ],
      "tip": [
        "是否以 noexec 挂载扩展覆盖层。"
      ],
      "next": []
    },
    {
      "name": "--root",
      "usage": [
        "--root=PATH"
      ],
      "tip": [
        "相对于此根路径操作。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    }
  ]
}
