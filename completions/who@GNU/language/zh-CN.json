{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "打印当前已登录用户的信息。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "等同于 -b -d --login -p -r -t -T -u"
      ]
    },
    {
      "name": "--boot",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --boot"
      ],
      "tip": [
        "系统上次启动的时间"
      ]
    },
    {
      "name": "--count",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --count"
      ],
      "tip": [
        "所有登录名以及各自登录的用户数"
      ]
    },
    {
      "name": "--dead",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --dead"
      ],
      "tip": [
        "打印已失效的进程"
      ]
    },
    {
      "name": "--heading",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --heading"
      ],
      "tip": [
        "打印一行列标题"
      ]
    },
    {
      "name": "--login",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --login"
      ],
      "tip": [
        "打印系统的登录进程"
      ]
    },
    {
      "name": "--lookup",
      "tip": [
        "尝试通过 DNS 把主机名转换为规范形式"
      ]
    },
    {
      "name": "--process",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --process"
      ],
      "tip": [
        "打印由 init 启动的活动进程"
      ]
    },
    {
      "name": "--runlevel",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --runlevel"
      ],
      "tip": [
        "打印当前运行级别"
      ]
    },
    {
      "name": "--short",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --short"
      ],
      "tip": [
        "只打印名字、行号和时间（默认）"
      ]
    },
    {
      "name": "--time",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --time"
      ],
      "tip": [
        "打印系统时钟最后一次变化的时间"
      ]
    },
    {
      "name": "--users",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --users"
      ],
      "tip": [
        "列出已登录的用户"
      ]
    },
    {
      "name": "--writable",
      "alias": [
        "--message",
        "--mesg",
        "-T",
        "-w"
      ],
      "usage": [
        "-T, -w, --mesg, --message, --writable"
      ],
      "tip": [
        "用 +、- 或 ? 表示用户的留言状态",
        "等同于 -T"
      ]
    },
    {
      "name": "-m",
      "tip": [
        "只输出与 stdin 相关的主机名和用户名"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
