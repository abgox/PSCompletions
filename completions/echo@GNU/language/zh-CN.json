{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把这些字符串回显到标准输出。"
    ]
  },
  "option": [
    {
      "name": "-e",
      "tip": [
        "启用反斜杠转义的解释"
      ]
    },
    {
      "name": "-E",
      "tip": [
        "不解释反斜杠转义（默认）"
      ]
    },
    {
      "name": "-n",
      "tip": [
        "不输出末尾的换行符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
