{
  "meta": {
    "url": "https://aube.jdx.dev",
    "description": [
      "运行 package.json 中定义的脚本（aube run 独立版本）"
    ]
  },
  "option": [
    {
      "name": "--color",
      "tip": [
        "即使 stderr 不是 TTY 也强制彩色输出"
      ]
    },
    {
      "name": "--diag",
      "usage": [
        "--diag [<MODE>]"
      ],
      "tip": [
        "启用冷安装诊断"
      ],
      "next": [
        {
          "name": "full",
          "tip": [
            "完整诊断模式"
          ]
        },
        {
          "name": "live",
          "tip": [
            "实时诊断模式"
          ]
        },
        {
          "name": "summary",
          "tip": [
            "摘要诊断模式"
          ]
        },
        {
          "name": "trace",
          "tip": [
            "追踪诊断模式"
          ]
        }
      ]
    },
    {
      "name": "--diag-file",
      "usage": [
        "--diag-file <PATH>"
      ],
      "tip": [
        "诊断 JSONL 追踪文件路径"
      ],
      "next": []
    },
    {
      "name": "--diag-threshold-ms",
      "usage": [
        "--diag-threshold-ms <MS>"
      ],
      "tip": [
        "实时模式阈值（毫秒）"
      ],
      "next": []
    },
    {
      "name": "--disable-global-virtual-store",
      "alias": [
        "--disable-gvs"
      ],
      "usage": [
        "--disable-gvs, --disable-global-virtual-store"
      ],
      "tip": [
        "强制关闭共享全局虚拟存储"
      ]
    },
    {
      "name": "--enable-global-virtual-store",
      "alias": [
        "--enable-gvs"
      ],
      "usage": [
        "--enable-gvs, --enable-global-virtual-store"
      ],
      "tip": [
        "强制开启共享全局虚拟存储"
      ]
    },
    {
      "name": "--fail-if-no-match",
      "tip": [
        "当 workspace 选择器无匹配时报错"
      ]
    },
    {
      "name": "--fetch-retries",
      "usage": [
        "--fetch-retries <N>"
      ],
      "tip": [
        "重试次数"
      ],
      "next": []
    },
    {
      "name": "--fetch-retry-factor",
      "usage": [
        "--fetch-retry-factor <N>"
      ],
      "tip": [
        "指数退避因子"
      ],
      "next": []
    },
    {
      "name": "--fetch-retry-maxtimeout",
      "usage": [
        "--fetch-retry-maxtimeout <MS>"
      ],
      "tip": [
        "超时上限（毫秒）"
      ],
      "next": [
        {
          "name": "1000"
        },
        {
          "name": "5000"
        }
      ]
    },
    {
      "name": "--fetch-retry-mintimeout",
      "usage": [
        "--fetch-retry-mintimeout <MS>"
      ],
      "tip": [
        "超时下限（毫秒）"
      ],
      "next": [
        {
          "name": "1000"
        },
        {
          "name": "5000"
        }
      ]
    },
    {
      "name": "--fetch-timeout",
      "usage": [
        "--fetch-timeout <MS>"
      ],
      "tip": [
        "每个请求的 HTTP 超时"
      ],
      "next": [
        {
          "name": "1000"
        },
        {
          "name": "5000"
        }
      ]
    },
    {
      "name": "--filter",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --filter <WORKSPACE>"
      ],
      "tip": [
        "限定作用于指定的 workspace 包"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--filter-prod",
      "usage": [
        "--filter-prod <PATTERN>"
      ],
      "tip": [
        "仅生产环境过滤器"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--frozen-lockfile",
      "tip": [
        "当 lockfile 漂移时报错"
      ]
    },
    {
      "name": "--if-present",
      "tip": [
        "如果脚本在 package.json 中不存在时不报错"
      ]
    },
    {
      "name": "--inspect",
      "usage": [
        "--inspect[=<[[HOST:]PORT]>]"
      ],
      "tip": [
        "将 --inspect 转发给 Node 后端脚本"
      ],
      "next": []
    },
    {
      "name": "--inspect-brk",
      "usage": [
        "--inspect-brk[=<[[HOST:]PORT]>]"
      ],
      "tip": [
        "转发 --inspect-brk"
      ],
      "next": []
    },
    {
      "name": "--loglevel",
      "usage": [
        "--loglevel <LEVEL>"
      ],
      "tip": [
        "设置日志级别"
      ],
      "next": [
        {
          "name": "debug",
          "tip": [
            "Debug 级别日志"
          ]
        },
        {
          "name": "error",
          "tip": [
            "Error 级别日志"
          ]
        },
        {
          "name": "info",
          "tip": [
            "Info 级别日志"
          ]
        },
        {
          "name": "silent",
          "tip": [
            "静默模式 - 无日志输出"
          ]
        },
        {
          "name": "trace",
          "tip": [
            "Trace 级别日志"
          ]
        },
        {
          "name": "warn",
          "tip": [
            "Warning 级别日志"
          ]
        }
      ]
    },
    {
      "name": "--no-bail",
      "tip": [
        "脚本失败后继续递归执行"
      ]
    },
    {
      "name": "--no-color",
      "tip": [
        "禁用彩色输出"
      ]
    },
    {
      "name": "--no-frozen-lockfile",
      "tip": [
        "即使 lockfile 是最新的也始终重新解析"
      ]
    },
    {
      "name": "--no-install",
      "tip": [
        "跳过自动安装检查"
      ]
    },
    {
      "name": "--no-sort",
      "tip": [
        "禁用拓扑排序"
      ]
    },
    {
      "name": "--parallel",
      "tip": [
        "在所有匹配的 workspace 中并发运行脚本"
      ]
    },
    {
      "name": "--prefer-frozen-lockfile",
      "tip": [
        "lockfile 新鲜时使用，过期时重新解析"
      ]
    },
    {
      "name": "--prefix",
      "alias": [
        "--dir",
        "--cd",
        "-C"
      ],
      "usage": [
        "-C, --cd, --dir, --prefix <DIR>"
      ],
      "tip": [
        "运行前切换到指定目录"
      ],
      "next": []
    },
    {
      "name": "--recursive",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --recursive"
      ],
      "tip": [
        "在所有 workspace 包上运行"
      ]
    },
    {
      "name": "--registry",
      "usage": [
        "--registry <URL>"
      ],
      "tip": [
        "覆盖默认 registry URL"
      ],
      "next": []
    },
    {
      "name": "--report-summary",
      "tip": [
        "写入递归运行摘要文件"
      ]
    },
    {
      "name": "--reporter",
      "usage": [
        "--reporter <NAME>"
      ],
      "tip": [
        "输出格式"
      ],
      "next": [
        {
          "name": "append-only",
          "tip": [
            "仅追加输出格式"
          ]
        },
        {
          "name": "default",
          "tip": [
            "默认输出格式"
          ]
        },
        {
          "name": "ndjson",
          "tip": [
            "换行分隔 JSON 格式"
          ]
        },
        {
          "name": "silent",
          "tip": [
            "静默输出 - 无 reporter 输出"
          ]
        }
      ]
    },
    {
      "name": "--reporter-hide-prefix",
      "tip": [
        "在并行输出行上隐藏 <package>: 标签"
      ]
    },
    {
      "name": "--resume-from",
      "usage": [
        "--resume-from <PACKAGE>"
      ],
      "tip": [
        "从指定包开始恢复递归执行"
      ],
      "next": []
    },
    {
      "name": "--reverse",
      "tip": [
        "反转递归执行顺序"
      ]
    },
    {
      "name": "--silent",
      "tip": [
        "禁止所有非错误输出"
      ]
    },
    {
      "name": "--sort",
      "tip": [
        "按拓扑顺序对递归包排序（用于覆盖之前的 --no-sort）"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "启用详细/调试日志（--loglevel debug 的快捷方式）"
      ]
    },
    {
      "name": "--workspace-concurrency",
      "usage": [
        "--workspace-concurrency <N>"
      ],
      "tip": [
        "限制并发递归包数量"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    },
    {
      "name": "--workspace-root",
      "tip": [
        "从 workspace 根目录运行"
      ]
    },
    {
      "name": "-s",
      "tip": [
        "禁止包装器输出，同时仍显示脚本 stdout/stderr"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本并检查更新"
      ]
    }
  ]
}
