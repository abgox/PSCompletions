{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示 ISO-9660 文件系统的长度。"
    ]
  },
  "option": [
    {
      "name": "--divisor",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --divisor=<number>"
      ],
      "tip": [
        "将字节数除以 <number>。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--sectors",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --sectors"
      ],
      "tip": [
        "显示扇区数和大小。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
