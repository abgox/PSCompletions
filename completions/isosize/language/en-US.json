{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Show the length of an ISO-9660 filesystem."
    ]
  },
  "option": [
    {
      "name": "--divisor",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --divisor=<number>"
      ],
      "tip": [
        "Divide the amount of bytes by <number>."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--sectors",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --sectors"
      ],
      "tip": [
        "Show sector count and size."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
