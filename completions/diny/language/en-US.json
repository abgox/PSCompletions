{
  "meta": {
    "url": "https://github.com/dinoDanic/diny",
    "description": [
      "A simple CLI tool that analyzes git diff and generates commit messages."
    ]
  },
  "next": [
    {
      "name": "auto",
      "tip": [
        "Set up git auto alias for diny commit messages."
      ],
      "next": [
        {
          "name": "remove",
          "tip": [
            "Remove the git auto alias."
          ]
        }
      ]
    },
    {
      "name": "changelog",
      "tip": [
        "Generate an AI-powered changelog for your repository."
      ]
    },
    {
      "name": "commit",
      "tip": [
        "Generate and apply a commit message from staged changes."
      ],
      "option": [
        {
          "name": "--no-verify",
          "tip": [
            "Skip pre-commit and commit-msg hooks on every commit."
          ]
        },
        {
          "name": "--print",
          "tip": [
            "Print the generated message to stdout."
          ]
        },
        {
          "name": "--push",
          "tip": [
            "Push after committing."
          ]
        }
      ]
    },
    {
      "name": "completion",
      "usage": [
        "completion <bash|fish|powershell|zsh>"
      ],
      "tip": [
        "Generate the autocompletion script for the specified shell."
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "Generate the autocompletion script for bash."
          ]
        },
        {
          "name": "fish",
          "tip": [
            "Generate the autocompletion script for fish."
          ]
        },
        {
          "name": "powershell",
          "tip": [
            "Generate the autocompletion script for powershell."
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "Generate the autocompletion script for zsh."
          ]
        }
      ]
    },
    {
      "name": "config",
      "tip": [
        "Open interactive TUI config editor."
      ]
    },
    {
      "name": "help",
      "usage": [
        "help [command]"
      ],
      "tip": [
        "Help about any command."
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "Set up git auto alias."
          ]
        },
        {
          "name": "changelog",
          "tip": [
            "Generate changelog."
          ]
        },
        {
          "name": "commit",
          "tip": [
            "Generate commit messages."
          ]
        },
        {
          "name": "completion",
          "tip": [
            "Generate autocompletion scripts."
          ]
        },
        {
          "name": "config",
          "tip": [
            "Open config editor."
          ]
        },
        {
          "name": "link",
          "tip": [
            "Link with external tools."
          ]
        },
        {
          "name": "theme",
          "tip": [
            "List available themes."
          ]
        },
        {
          "name": "timeline",
          "tip": [
            "Analyze commit history."
          ]
        },
        {
          "name": "update",
          "tip": [
            "Update diny."
          ]
        },
        {
          "name": "yolo",
          "tip": [
            "Stage, commit, and push in one shot."
          ]
        }
      ]
    },
    {
      "name": "link",
      "usage": [
        "link [tool]"
      ],
      "tip": [
        "Link diny with other developer tools."
      ],
      "next": [
        {
          "name": "lazygit",
          "tip": [
            "Link diny with LazyGit."
          ]
        }
      ]
    },
    {
      "name": "theme",
      "tip": [
        "List available UI themes."
      ]
    },
    {
      "name": "timeline",
      "tip": [
        "Analyze your commit message patterns and history."
      ]
    },
    {
      "name": "update",
      "tip": [
        "Update diny to the latest version."
      ],
      "option": [
        {
          "name": "--force",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --force"
          ],
          "tip": [
            "Force update even if already on latest version."
          ]
        }
      ]
    },
    {
      "name": "yolo",
      "tip": [
        "Stage everything, generate a commit message, commit, and push."
      ]
    }
  ],
  "option": [
    {
      "name": "--toggle",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --toggle"
      ],
      "tip": [
        "Toggle help message."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Show version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show help."
      ]
    }
  ]
