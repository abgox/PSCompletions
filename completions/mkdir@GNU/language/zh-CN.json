{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "创建这些目录（如果尚未存在）。"
    ]
  },
  "option": [
    {
      "name": "--context",
      "usage": [
        "--context[=CTX]"
      ],
      "tip": [
        "与 -Z 相同；如果指定了 CTX，则把 SELinux 或 SMACK 安全上下文设为 CTX"
      ],
      "next": []
    },
    {
      "name": "--mode",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mode <MODE>"
      ],
      "tip": [
        "设置文件模式（与 chmod 相同），而不是 a=rwx 减去 umask"
      ],
      "next": []
    },
    {
      "name": "--parents",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --parents"
      ],
      "tip": [
        "已存在时不报错，必要时创建父目录，且其权限不受 -m 选项影响"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "为每个创建的目录打印一条信息"
      ]
    },
    {
      "name": "-Z",
      "tip": [
        "把每个创建的目录的 SELinux 安全上下文设为默认类型"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
