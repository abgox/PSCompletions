{
  "meta": {
    "url": "https://github.com/sigoden/dufs",
    "description": [
      "独特的实用文件服务器。"
    ]
  },
  "option": [
    {
      "name": "--allow-all",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --allow-all"
      ],
      "tip": [
        "允许所有操作。"
      ]
    },
    {
      "name": "--allow-archive",
      "tip": [
        "允许将文件夹下载为归档文件。"
      ]
    },
    {
      "name": "--allow-delete",
      "tip": [
        "允许删除文件/文件夹。"
      ]
    },
    {
      "name": "--allow-hash",
      "tip": [
        "允许通过 ?hash 查询获取文件的 sha256 哈希值。"
      ]
    },
    {
      "name": "--allow-search",
      "tip": [
        "允许搜索文件/文件夹。"
      ]
    },
    {
      "name": "--allow-symlink",
      "tip": [
        "允许创建指向根目录外文件/文件夹的符号链接。"
      ]
    },
    {
      "name": "--allow-upload",
      "tip": [
        "允许上传文件/文件夹。"
      ]
    },
    {
      "name": "--assets",
      "usage": [
        "--assets <path>"
      ],
      "tip": [
        "设置 assets 目录路径以覆盖内置 assets。"
      ],
      "next": []
    },
    {
      "name": "--auth",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --auth <rules>"
      ],
      "tip": [
        "添加认证角色。"
      ],
      "example": [
        "--auth user:pass@/dir1:rw,/dir2"
      ],
      "next": []
    },
    {
      "name": "--bind",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bind <addrs>"
      ],
      "tip": [
        "指定绑定地址或 unix socket。"
      ],
      "next": []
    },
    {
      "name": "--completions",
      "usage": [
        "--completions <shell>"
      ],
      "tip": [
        "打印指定 shell 的补全脚本。"
      ],
      "next": [
        {
          "name": "bash"
        },
        {
          "name": "elvish"
        },
        {
          "name": "fish"
        },
        {
          "name": "powershell"
        },
        {
          "name": "zsh"
        }
      ]
    },
    {
      "name": "--compress",
      "usage": [
        "--compress <level>"
      ],
      "tip": [
        "设置 zip 压缩级别。"
      ],
      "next": [
        {
          "name": "high"
        },
        {
          "name": "low"
        },
        {
          "name": "medium"
        },
        {
          "name": "none"
        }
      ]
    },
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config <file>"
      ],
      "tip": [
        "指定配置文件。"
      ],
      "next": []
    },
    {
      "name": "--enable-cors",
      "tip": [
        "启用 CORS，设置 Access-Control-Allow-Origin: *。"
      ]
    },
    {
      "name": "--hidden",
      "usage": [
        "--hidden <value>"
      ],
      "tip": [
        "从目录列表中隐藏路径。"
      ],
      "example": [
        "--hidden tmp,*.log,*.lock"
      ],
      "next": []
    },
    {
      "name": "--log-file",
      "usage": [
        "--log-file <file>"
      ],
      "tip": [
        "指定日志保存文件，而非 stdout/stderr。"
      ],
      "next": []
    },
    {
      "name": "--log-format",
      "usage": [
        "--log-format <format>"
      ],
      "tip": [
        "自定义 http 日志格式。"
      ],
      "next": []
    },
    {
      "name": "--path-prefix",
      "usage": [
        "--path-prefix <path>"
      ],
      "tip": [
        "指定路径前缀。"
      ],
      "next": []
    },
    {
      "name": "--port",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --port <port>"
      ],
      "tip": [
        "指定监听端口。"
      ],
      "example": [
        "--port 8080"
      ],
      "next": [
        {
          "name": "443"
        },
        {
          "name": "80"
        },
        {
          "name": "8080"
        }
      ]
    },
    {
      "name": "--render-index",
      "tip": [
        "请求目录时提供 index.html，如果未找到 index.html 则返回 404。"
      ]
    },
    {
      "name": "--render-spa",
      "tip": [
        "提供 SPA（单页应用程序）服务。"
      ]
    },
    {
      "name": "--render-try-index",
      "tip": [
        "请求目录时提供 index.html，如果未找到 index.html 则返回目录列表。"
      ]
    },
    {
      "name": "--tls-cert",
      "usage": [
        "--tls-cert <path>"
      ],
      "tip": [
        "用于 HTTPS 的 SSL/TLS 证书路径。"
      ],
      "next": []
    },
    {
      "name": "--tls-key",
      "usage": [
        "--tls-key <path>"
      ],
      "tip": [
        "SSL/TLS 证书私钥路径。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助。"
      ]
    }
  ]
}
