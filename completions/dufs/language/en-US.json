{
  "meta": {
    "url": "https://github.com/sigoden/dufs",
    "description": [
      "Distinctive utility file server."
    ]
  },
  "option": [
    {
      "name": "--allow-all",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --allow-all"
      ],
      "tip": [
        "Allow all operations."
      ]
    },
    {
      "name": "--allow-archive",
      "tip": [
        "Allow download folders as archive file."
      ]
    },
    {
      "name": "--allow-delete",
      "tip": [
        "Allow delete files/folders."
      ]
    },
    {
      "name": "--allow-hash",
      "tip": [
        "Allow ?hash query to get file sha256 hash."
      ]
    },
    {
      "name": "--allow-search",
      "tip": [
        "Allow search files/folders."
      ]
    },
    {
      "name": "--allow-symlink",
      "tip": [
        "Allow symlink to files/folders outside root directory."
      ]
    },
    {
      "name": "--allow-upload",
      "tip": [
        "Allow upload files/folders."
      ]
    },
    {
      "name": "--assets",
      "usage": [
        "--assets <path>"
      ],
      "tip": [
        "Set the path to the assets directory for overriding the built-in assets."
      ],
      "next": []
    },
    {
      "name": "--auth",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --auth <rules>"
      ],
      "tip": [
        "Add auth roles."
      ],
      "example": [
        "--auth user:pass@/dir1:rw,/dir2"
      ],
      "next": []
    },
    {
      "name": "--bind",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bind <addrs>"
      ],
      "tip": [
        "Specify bind address or unix socket."
      ],
      "next": []
    },
    {
      "name": "--completions",
      "usage": [
        "--completions <shell>"
      ],
      "tip": [
        "Print shell completion script for <shell>."
      ],
      "next": [
        {
          "name": "bash"
        },
        {
          "name": "elvish"
        },
        {
          "name": "fish"
        },
        {
          "name": "powershell"
        },
        {
          "name": "zsh"
        }
      ]
    },
    {
      "name": "--compress",
      "usage": [
        "--compress <level>"
      ],
      "tip": [
        "Set zip compress level."
      ],
      "next": [
        {
          "name": "high"
        },
        {
          "name": "low"
        },
        {
          "name": "medium"
        },
        {
          "name": "none"
        }
      ]
    },
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config <file>"
      ],
      "tip": [
        "Specify configuration file."
      ],
      "next": []
    },
    {
      "name": "--enable-cors",
      "tip": [
        "Enable CORS, sets Access-Control-Allow-Origin: *."
      ]
    },
    {
      "name": "--hidden",
      "usage": [
        "--hidden <value>"
      ],
      "tip": [
        "Hide paths from directory listings."
      ],
      "example": [
        "--hidden tmp,*.log,*.lock"
      ],
      "next": []
    },
    {
      "name": "--log-file",
      "usage": [
        "--log-file <file>"
      ],
      "tip": [
        "Specify the file to save logs to, other than stdout/stderr."
      ],
      "next": []
    },
    {
      "name": "--log-format",
      "usage": [
        "--log-format <format>"
      ],
      "tip": [
        "Customize http log format."
      ],
      "next": []
    },
    {
      "name": "--path-prefix",
      "usage": [
        "--path-prefix <path>"
      ],
      "tip": [
        "Specify a path prefix."
      ],
      "next": []
    },
    {
      "name": "--port",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --port <port>"
      ],
      "tip": [
        "Specify port to listen on."
      ],
      "example": [
        "--port 8080"
      ],
      "next": [
        {
          "name": "443"
        },
        {
          "name": "80"
        },
        {
          "name": "8080"
        }
      ]
    },
    {
      "name": "--render-index",
      "tip": [
        "Serve index.html when requesting a directory, returns 404 if not found index.html."
      ]
    },
    {
      "name": "--render-spa",
      "tip": [
        "Serve SPA (Single Page Application)."
      ]
    },
    {
      "name": "--render-try-index",
      "tip": [
        "Serve index.html when requesting a directory, returns directory listing if not found index.html."
      ]
    },
    {
      "name": "--tls-cert",
      "usage": [
        "--tls-cert <path>"
      ],
      "tip": [
        "Path to an SSL/TLS certificate to serve with HTTPS."
      ],
      "next": []
    },
    {
      "name": "--tls-key",
      "usage": [
        "--tls-key <path>"
      ],
      "tip": [
        "Path to the SSL/TLS certificate's private key."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help."
      ]
    }
  ]
}
