{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Display the contents of a text file one screen at a time."
    ]
  },
  "option": [
    {
      "name": "--clean-print",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --clean-print"
      ],
      "tip": [
        "Do not scroll, clean screen and display text."
      ]
    },
    {
      "name": "--exit-on-eof",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exit-on-eof"
      ],
      "tip": [
        "Exit on End-Of-File."
      ]
    },
    {
      "name": "--lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --lines <number>"
      ],
      "tip": [
        "The number of lines per screenful."
      ],
      "next": []
    },
    {
      "name": "--logical",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --logical"
      ],
      "tip": [
        "Count logical lines, rather than screen lines."
      ]
    },
    {
      "name": "--no-pause",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --no-pause"
      ],
      "tip": [
        "Do not pause after any line containing a ^L (form feed)."
      ]
    },
    {
      "name": "--plain",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --plain"
      ],
      "tip": [
        "Suppress underlining and bold."
      ]
    },
    {
      "name": "--print-over",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --print-over"
      ],
      "tip": [
        "Do not scroll, display text and clean line ends."
      ]
    },
    {
      "name": "--silent",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --silent"
      ],
      "tip": [
        "Display help instead of ringing bell when an illegal key is pressed."
      ]
    },
    {
      "name": "--squeeze",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squeeze"
      ],
      "tip": [
        "Squeeze multiple blank lines into one."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version."
      ]
    },
    {
      "name": "-<number>",
      "tip": [
        "Same as --lines."
      ],
      "example": [
        "-20"
      ]
    },
    {
      "name": "+/<pattern>",
      "tip": [
        "Display file beginning from pattern match."
      ],
      "example": [
        "+/TODO"
      ]
    },
    {
      "name": "+<number>",
      "tip": [
        "Display file beginning from line number."
      ],
      "example": [
        "+100"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help."
      ]
    }
  ]
}
