{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "逐屏显示文本文件内容。"
    ]
  },
  "option": [
    {
      "name": "--clean-print",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --clean-print"
      ],
      "tip": [
        "不滚动，清屏并显示文本。"
      ]
    },
    {
      "name": "--exit-on-eof",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exit-on-eof"
      ],
      "tip": [
        "在文件结束时退出。"
      ]
    },
    {
      "name": "--lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --lines <number>"
      ],
      "tip": [
        "每屏显示的行数。"
      ],
      "next": []
    },
    {
      "name": "--logical",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --logical"
      ],
      "tip": [
        "计算逻辑行而非屏幕行。"
      ]
    },
    {
      "name": "--no-pause",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --no-pause"
      ],
      "tip": [
        "在包含 ^L（换页符）的行后不停顿。"
      ]
    },
    {
      "name": "--plain",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --plain"
      ],
      "tip": [
        "禁止下划线和加粗。"
      ]
    },
    {
      "name": "--print-over",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --print-over"
      ],
      "tip": [
        "不滚动，显示文本并清理行尾。"
      ]
    },
    {
      "name": "--silent",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --silent"
      ],
      "tip": [
        "按非法键时显示帮助而非响铃。"
      ]
    },
    {
      "name": "--squeeze",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squeeze"
      ],
      "tip": [
        "将多个空行压缩为一行。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "-<number>",
      "tip": [
        "与 --lines 相同。"
      ],
      "example": [
        "-20"
      ]
    },
    {
      "name": "+/<pattern>",
      "tip": [
        "从匹配模式处开始显示文件。"
      ],
      "example": [
        "+/TODO"
      ]
    },
    {
      "name": "+<number>",
      "tip": [
        "从指定行号开始显示文件。"
      ],
      "example": [
        "+100"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
