{
  "meta": {
    "url": "https://learn.microsoft.com/en-us/windows-server/administration/windows-commands/more",
    "description": [
      "逐屏显示文本文件内容。"
    ]
  },
  "option": [
    {
      "name": "--clean-print",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --clean-print"
      ],
      "tip": [
        "不滚动，显示文本并清理行尾。"
      ]
    },
    {
      "name": "--exit-on-eof",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exit-on-eof"
      ],
      "tip": [
        "在文件结束时退出。"
      ]
    },
    {
      "name": "--from-line",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --from-line <number>"
      ],
      "tip": [
        "从指定行号开始显示每个文件。"
      ],
      "next": []
    },
    {
      "name": "--lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --lines <number>"
      ],
      "tip": [
        "每屏显示的行数。"
      ],
      "next": []
    },
    {
      "name": "--logical",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --logical"
      ],
      "tip": [
        "在包含 ^L（换页符）的行后不停顿。"
      ]
    },
    {
      "name": "--no-pause",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --no-pause"
      ],
      "tip": [
        "计算逻辑行而非屏幕行。"
      ]
    },
    {
      "name": "--number",
      "usage": [
        "--number <number>"
      ],
      "tip": [
        "与 --lines 选项参数相同。"
      ],
      "next": []
    },
    {
      "name": "--pattern",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pattern <pattern>"
      ],
      "tip": [
        "在开始显示前在每个文件中搜索的字符串。"
      ],
      "next": []
    },
    {
      "name": "--print-over",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --print-over"
      ],
      "tip": [
        "不滚动，清屏并显示文本。"
      ]
    },
    {
      "name": "--silent",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --silent"
      ],
      "tip": [
        "按非法键时显示帮助而非响铃。"
      ]
    },
    {
      "name": "--squeeze",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squeeze"
      ],
      "tip": [
        "将多个空行压缩为一行。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
