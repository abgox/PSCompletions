{
  "meta": {
    "url": "https://www.gnu.org/software/gzip",
    "description": [
      "压缩或解压缩文件。"
    ]
  },
  "option": [
    {
      "name": "--ascii",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --ascii"
      ],
      "tip": [
        "ASCII 文本模式：使用本地约定转换行尾。",
        "仅在某些非 Unix 系统上受支持；在不支持的系统上会被忽略。"
      ]
    },
    {
      "name": "--best",
      "alias": [
        "-9"
      ],
      "usage": [
        "-9, --best"
      ],
      "tip": [
        "使用最慢的压缩方法（最佳压缩）。",
        "压缩级别 9。"
      ]
    },
    {
      "name": "--decompress",
      "alias": [
        "--uncompress",
        "-d"
      ],
      "usage": [
        "-d, --decompress, --uncompress"
      ],
      "tip": [
        "解压缩。"
      ]
    },
    {
      "name": "--fast",
      "alias": [
        "-1"
      ],
      "usage": [
        "-1, --fast"
      ],
      "tip": [
        "使用最快的压缩方法（压缩率较低）。",
        "压缩级别 1。"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "即使文件有多个链接或输出文件已存在，也强制进行压缩或解压缩。",
        "配合 --stdout 时，将无法识别的输入原样复制，使 zcat 表现得像 cat。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助屏幕并退出。"
      ]
    },
    {
      "name": "--keep",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --keep"
      ],
      "tip": [
        "在压缩或解压缩期间保留（不删除）输入文件。"
      ]
    },
    {
      "name": "--license",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --license"
      ],
      "tip": [
        "显示 gzip 许可证并退出。"
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "列出压缩文件的内容。",
        "与 --verbose 一起使用时，显示方法、CRC、日期和总计。"
      ]
    },
    {
      "name": "--name",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --name"
      ],
      "tip": [
        "压缩时，始终保存原始文件名和时间戳。",
        "解压缩时，如果存在则恢复它们。",
        "这是压缩时的默认行为。"
      ]
    },
    {
      "name": "--no-name",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-name"
      ],
      "tip": [
        "压缩时，不保存原始文件名和时间戳。",
        "解压缩时，不恢复它们；这是默认行为。"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制所有警告。"
      ]
    },
    {
      "name": "--recursive",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --recursive"
      ],
      "tip": [
        "递归遍历目录结构并处理找到的所有文件。"
      ]
    },
    {
      "name": "--rsyncable",
      "tip": [
        "使压缩输出对 rsync 友好。",
        "允许 rsync 只传输归档中发生变化的部分。"
      ]
    },
    {
      "name": "--suffix",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --suffix=SUF"
      ],
      "tip": [
        "使用后缀 SUF 代替 .gz 来压缩文件。",
        "允许任何不含 / 的非空后缀；建议使用 .z 和 .gz。",
        "解压缩时，在推导输出文件名时优先尝试 SUF。"
      ],
      "next": [
        {
          "name": ".gz"
        },
        {
          "name": ".tgz"
        },
        {
          "name": ".z"
        }
      ]
    },
    {
      "name": "--synchronous",
      "tip": [
        "使用同步输出。",
        "系统崩溃时更安全，但速度会慢很多。"
      ]
    },
    {
      "name": "--test",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --test"
      ],
      "tip": [
        "测试压缩文件的完整性，然后退出。"
      ]
    },
    {
      "name": "--to-stdout",
      "alias": [
        "--stdout",
        "-c"
      ],
      "usage": [
        "-c, --stdout, --to-stdout"
      ],
      "tip": [
        "将输出写入标准输出，并保留原始文件不变。",
        "有多个输入文件时，输出由多个独立压缩的成员组成。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "显示每个压缩或解压缩文件的名称和压缩率。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本号和编译选项，然后退出。"
      ]
    },
    {
      "name": "-2",
      "tip": [
        "使用压缩级别 2。"
      ]
    },
    {
      "name": "-3",
      "tip": [
        "使用压缩级别 3。"
      ]
    },
    {
      "name": "-4",
      "tip": [
        "使用压缩级别 4。"
      ]
    },
    {
      "name": "-5",
      "tip": [
        "使用压缩级别 5。"
      ]
    },
    {
      "name": "-6",
      "tip": [
        "使用压缩级别 6（默认）。"
      ]
    },
    {
      "name": "-7",
      "tip": [
        "使用压缩级别 7。"
      ]
    },
    {
      "name": "-8",
      "tip": [
        "使用压缩级别 8。"
      ]
    }
  ]
}
