{
  "meta": {
    "url": "https://github.com/ajeetdsouza/zoxide",
    "description": [
      "A smarter cd command for your terminal."
    ]
  },
  "next": [
    {
      "name": "add",
      "usage": [
        "add [OPTIONS] <PATHS>..."
      ],
      "tip": [
        "Add a new directory or increment its rank"
      ],
      "option": [
        {
          "name": "--score",
          "alias": [
            "-s"
          ],
          "usage": [
            "-s, --score <SCORE>"
          ],
          "tip": [
            "The rank to increment the entry if it exists or initialize it with if it doesn't"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "edit",
      "tip": [
        "Edit the database"
      ]
    },
    {
      "name": "import",
      "usage": [
        "import [OPTIONS] <COMMAND>"
      ],
      "tip": [
        "Import entries from another application"
      ],
      "option": [
        {
          "name": "--merge",
          "tip": [
            "Merge into existing database"
          ]
        }
      ],
      "next": [
        {
          "name": "atuin",
          "tip": [
            "Import from atuin"
          ]
        },
        {
          "name": "autojump",
          "tip": [
            "Import from autojump"
          ]
        },
        {
          "name": "fasd",
          "tip": [
            "Import from fasd"
          ]
        },
        {
          "name": "z",
          "tip": [
            "Import from z"
          ]
        },
        {
          "name": "z.lua",
          "tip": [
            "Import from z.lua"
          ]
        },
        {
          "name": "zsh-z",
          "tip": [
            "Import from zsh-z"
          ]
        }
      ]
    },
    {
      "name": "init",
      "usage": [
        "init [OPTIONS] <SHELL>"
      ],
      "tip": [
        "Generate shell configuration"
      ],
      "option": [
        {
          "name": "--cmd",
          "usage": [
            "--cmd <CMD>"
          ],
          "tip": [
            "Changes the prefix of the `z` and `zi` commands [default: z]"
          ],
          "next": []
        },
        {
          "name": "--hook",
          "usage": [
            "--hook <HOOK>"
          ],
          "tip": [
            "Changes how often zoxide increments a directory's score [default: pwd]",
            "Possible values: none, prompt, pwd"
          ],
          "next": [
            {
              "name": "none"
            },
            {
              "name": "prompt"
            },
            {
              "name": "pwd"
            }
          ]
        },
        {
          "name": "--no-cmd",
          "tip": [
            "Prevents zoxide from defining the `z` and `zi` commands"
          ]
        }
      ],
      "next": [
        {
          "name": "bash"
        },
        {
          "name": "elvish"
        },
        {
          "name": "fish"
        },
        {
          "name": "nushell"
        },
        {
          "name": "posix"
        },
        {
          "name": "powershell"
        },
        {
          "name": "tcsh"
        },
        {
          "name": "xonsh"
        },
        {
          "name": "zsh"
        }
      ]
    },
    {
      "name": "query",
      "usage": [
        "query [OPTIONS] [KEYWORDS]..."
      ],
      "tip": [
        "Search for a directory in the database"
      ],
      "option": [
        {
          "name": "--all",
          "alias": [
            "-a"
          ],
          "usage": [
            "-a, --all"
          ],
          "tip": [
            "Show unavailable directories"
          ]
        },
        {
          "name": "--base-dir",
          "usage": [
            "--base-dir <path>"
          ],
          "tip": [
            "Only search within this directory"
          ],
          "next": []
        },
        {
          "name": "--exclude",
          "usage": [
            "--exclude <path>"
          ],
          "tip": [
            "Exclude the current directory"
          ],
          "next": []
        },
        {
          "name": "--interactive",
          "alias": [
            "-i"
          ],
          "usage": [
            "-i, --interactive"
          ],
          "tip": [
            "Use interactive selection"
          ]
        },
        {
          "name": "--list",
          "alias": [
            "-l"
          ],
          "usage": [
            "-l, --list"
          ],
          "tip": [
            "List all matching directories"
          ]
        },
        {
          "name": "--score",
          "alias": [
            "-s"
          ],
          "usage": [
            "-s, --score"
          ],
          "tip": [
            "Print score with results"
          ]
        }
      ]
    },
    {
      "name": "remove",
      "usage": [
        "remove [PATHS]..."
      ],
      "tip": [
        "Remove a directory from the database"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show the help."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    }
  ]
}
