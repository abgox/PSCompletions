{
  "meta": {
    "url": "https://github.com/ajeetdsouza/zoxide",
    "description": [
      "更智能的 cd 命令。"
    ]
  },
  "next": [
    {
      "name": "add",
      "usage": [
        "add [OPTIONS] <PATHS>..."
      ],
      "tip": [
        "添加一个新目录或增加其排名"
      ],
      "option": [
        {
          "name": "--score",
          "alias": [
            "-s"
          ],
          "usage": [
            "-s, --score <SCORE>"
          ],
          "tip": [
            "如果条目存在，则增加其排名；如果不存在，则初始化其排名"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "edit",
      "tip": [
        "编辑数据库"
      ]
    },
    {
      "name": "import",
      "usage": [
        "import [OPTIONS] <COMMAND>"
      ],
      "tip": [
        "从另一个应用程序导入条目"
      ],
      "option": [
        {
          "name": "--merge",
          "tip": [
            "合并到现有数据库"
          ]
        }
      ],
      "next": [
        {
          "name": "atuin",
          "tip": [
            "从 atuin 导入"
          ]
        },
        {
          "name": "autojump",
          "tip": [
            "从 autojump 导入"
          ]
        },
        {
          "name": "fasd",
          "tip": [
            "从 fasd 导入"
          ]
        },
        {
          "name": "z",
          "tip": [
            "从 z 导入"
          ]
        },
        {
          "name": "z.lua",
          "tip": [
            "从 z.lua 导入"
          ]
        },
        {
          "name": "zsh-z",
          "tip": [
            "从 zsh-z 导入"
          ]
        }
      ]
    },
    {
      "name": "init",
      "usage": [
        "init [OPTIONS] <SHELL>"
      ],
      "tip": [
        "生成 shell 配置"
      ],
      "option": [
        {
          "name": "--cmd",
          "usage": [
            "--cmd <CMD>"
          ],
          "tip": [
            "更改 z 和 zi 命令的前缀 [默认值: z]"
          ],
          "next": []
        },
        {
          "name": "--hook",
          "usage": [
            "--hook <HOOK>"
          ],
          "tip": [
            "更改 zoxide 增加目录排名的频率 [默认值: pwd]",
            "可能值: none, prompt, pwd"
          ],
          "next": [
            {
              "name": "none"
            },
            {
              "name": "prompt"
            },
            {
              "name": "pwd"
            }
          ]
        },
        {
          "name": "--no-cmd",
          "tip": [
            "防止 zoxide 定义 z 和 zi 命令"
          ]
        }
      ],
      "next": [
        {
          "name": "bash"
        },
        {
          "name": "elvish"
        },
        {
          "name": "fish"
        },
        {
          "name": "nushell"
        },
        {
          "name": "posix"
        },
        {
          "name": "powershell"
        },
        {
          "name": "tcsh"
        },
        {
          "name": "xonsh"
        },
        {
          "name": "zsh"
        }
      ]
    },
    {
      "name": "query",
      "usage": [
        "query [OPTIONS] [KEYWORDS]..."
      ],
      "tip": [
        "在数据库中搜索目录"
      ],
      "option": [
        {
          "name": "--all",
          "alias": [
            "-a"
          ],
          "usage": [
            "-a, --all"
          ],
          "tip": [
            "显示不可用目录"
          ]
        },
        {
          "name": "--base-dir",
          "usage": [
            "--base-dir <path>"
          ],
          "tip": [
            "只在此目录内搜索"
          ],
          "next": []
        },
        {
          "name": "--exclude",
          "usage": [
            "--exclude <path>"
          ],
          "tip": [
            "排除当前目录"
          ],
          "next": []
        },
        {
          "name": "--interactive",
          "alias": [
            "-i"
          ],
          "usage": [
            "-i, --interactive"
          ],
          "tip": [
            "使用交互式选择"
          ]
        },
        {
          "name": "--list",
          "alias": [
            "-l"
          ],
          "usage": [
            "-l, --list"
          ],
          "tip": [
            "列出所有匹配目录"
          ]
        },
        {
          "name": "--score",
          "alias": [
            "-s"
          ],
          "usage": [
            "-s, --score"
          ],
          "tip": [
            "打印结果的分数"
          ]
        }
      ]
    },
    {
      "name": "remove",
      "usage": [
        "remove [PATHS]..."
      ],
      "tip": [
        "从数据库中删除目录"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
