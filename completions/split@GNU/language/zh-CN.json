{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把 FILE 切分后输出到 PREFIXaa、PREFIXab 等文件；默认每个文件 1000 行，默认 PREFIX 是 'x'。"
    ]
  },
  "option": [
    {
      "name": "--additional-suffix",
      "usage": [
        "--additional-suffix <SUFFIX>"
      ],
      "tip": [
        "在文件名后追加一个额外的 SUFFIX"
      ],
      "next": []
    },
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes <SIZE>"
      ],
      "tip": [
        "每个输出文件放 SIZE 个字节"
      ],
      "next": [
        {
          "name": "100M"
        },
        {
          "name": "10M"
        },
        {
          "name": "1M"
        }
      ]
    },
    {
      "name": "--elide-empty-files",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --elide-empty-files"
      ],
      "tip": [
        "使用 '-n' 时不生成空的输出文件"
      ]
    },
    {
      "name": "--filter",
      "usage": [
        "--filter <COMMAND>"
      ],
      "tip": [
        "写入 shell 命令 COMMAND；文件名是 $FILE"
      ],
      "next": []
    },
    {
      "name": "--hex-suffixes",
      "usage": [
        "--hex-suffixes[=FROM]"
      ],
      "tip": [
        "与 -x 相同，但可以设置起始值"
      ],
      "next": []
    },
    {
      "name": "--line-bytes",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --line-bytes <SIZE>"
      ],
      "tip": [
        "每个输出文件最多放 SIZE 字节的记录"
      ],
      "next": [
        {
          "name": "100M"
        },
        {
          "name": "10M"
        },
        {
          "name": "1M"
        }
      ]
    },
    {
      "name": "--lines",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --lines <NUMBER>"
      ],
      "tip": [
        "每个输出文件放 NUMBER 行/记录"
      ],
      "next": [
        {
          "name": "100"
        },
        {
          "name": "1000"
        }
      ]
    },
    {
      "name": "--number",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --number <CHUNKS>"
      ],
      "tip": [
        "生成 CHUNKS 个输出文件；说明参见下方"
      ],
      "next": []
    },
    {
      "name": "--numeric-suffixes",
      "usage": [
        "--numeric-suffixes[=FROM]"
      ],
      "tip": [
        "与 -d 相同，但可以设置起始值"
      ],
      "next": []
    },
    {
      "name": "--separator",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --separator <SEP>"
      ],
      "tip": [
        "用 SEP 而不是换行符作为记录分隔符；'\\0'（零）表示 NUL 字符"
      ],
      "next": []
    },
    {
      "name": "--suffix-length",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --suffix-length <N>"
      ],
      "tip": [
        "生成长度为 N 的后缀（默认 2）"
      ],
      "next": [
        {
          "name": "2"
        },
        {
          "name": "3"
        }
      ]
    },
    {
      "name": "--unbuffered",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unbuffered"
      ],
      "tip": [
        "使用 '-n r/...' 时立即把输入复制到输出"
      ]
    },
    {
      "name": "--verbose",
      "tip": [
        "在打开每个输出文件之前打印一条诊断信息"
      ]
    },
    {
      "name": "-d",
      "tip": [
        "使用从 0 开始的数字后缀，而不是字母后缀"
      ]
    },
    {
      "name": "-x",
      "tip": [
        "使用从 0 开始的十六进制后缀，而不是字母后缀"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
