{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将每个 FILE 的组更改为 GROUP"
    ]
  },
  "option": [
    {
      "name": "--changes",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --changes"
      ],
      "tip": [
        "类似 verbose，但仅在发生更改时报告"
      ]
    },
    {
      "name": "--dereference",
      "tip": [
        "影响每个符号链接的指向目标（默认），而不是符号链接本身"
      ]
    },
    {
      "name": "--from",
      "usage": [
        "--from <GROUP>"
      ],
      "tip": [
        "仅在其当前组与 GROUP 匹配时才更改组"
      ],
      "next": []
    },
    {
      "name": "--no-dereference",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --no-dereference"
      ],
      "tip": [
        "影响符号链接，而不是其指向的文件（仅在可更改符号链接属主的系统上有用）"
      ]
    },
    {
      "name": "--no-preserve-root",
      "tip": [
        "不特殊对待 /（默认）"
      ]
    },
    {
      "name": "--preserve-root",
      "tip": [
        "拒绝在 / 上递归操作"
      ]
    },
    {
      "name": "--quiet",
      "tip": [
        "隐藏大多数错误消息"
      ]
    },
    {
      "name": "--recursive",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --recursive"
      ],
      "tip": [
        "递归操作文件和目录"
      ]
    },
    {
      "name": "--reference",
      "usage": [
        "--reference <RFILE>"
      ],
      "tip": [
        "使用 RFILE 的组，而不指定 GROUP 值"
      ],
      "next": []
    },
    {
      "name": "--silent",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --silent"
      ],
      "tip": [
        "隐藏大多数错误消息"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "为每个处理过的文件输出诊断信息"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-H",
      "tip": [
        "如果命令行参数是指向目录的符号链接，则遍历它"
      ]
    },
    {
      "name": "-L",
      "tip": [
        "遍历遇到的每个指向目录的符号链接"
      ]
    },
    {
      "name": "-P",
      "tip": [
        "不遍历任何符号链接（默认）"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "打印帮助信息"
      ]
    }
  ]
}
