{
  "meta": {
    "url": "http://iscute.cn/chfs",
    "description": [
      "CuteHttpFileServer (chfs) - 免费的 HTTP 协议文件共享服务器。"
    ]
  },
  "option": [
    {
      "name": "--file=",
      "tip": [
        "指定一个配置文件去覆盖设置。"
      ],
      "example": [
        "--file=\"config.json\""
      ]
    },
    {
      "name": "--name=",
      "tip": [
        "HTTP 监听端口(默认为80)。"
      ],
      "example": [
        "--port=8080"
      ]
    },
    {
      "name": "--path=",
      "tip": [
        "指定存储共享文件的目录。"
      ],
      "example": [
        "--path=D:\\",
        "--path=\"C:\\Program Files\""
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示当前版本。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help-long",
      "alias": [
        "--help-man",
        "--help"
      ],
      "usage": [
        "--help, --help-man, --help-long"
      ],
      "tip": [
        "显示上下文相关帮助。"
      ]
    }
  ]
}
