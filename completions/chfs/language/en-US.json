{
  "meta": {
    "url": "http://iscute.cn/chfs",
    "description": [
      "CuteHttpFileServer (chfs) - a free HTTP protocol file sharing server."
    ]
  },
  "option": [
    {
      "name": "--file=",
      "usage": [
        "--file=<FILE>"
      ],
      "tip": [
        "A configuration file which overwrites the settings."
      ],
      "example": [
        "--file=\"config.json\""
      ],
      "next": []
    },
    {
      "name": "--path=",
      "usage": [
        "--path=<DIRS>"
      ],
      "tip": [
        "Directories where store shared files, separated by '|'. (default \".\")"
      ],
      "example": [
        "--path=D:\\",
        "--path=\"C:\\Program Files\""
      ],
      "separator": "|",
      "next": []
    },
    {
      "name": "--port=",
      "usage": [
        "--port=<PORT>"
      ],
      "tip": [
        "HTTP listening port. (Default 80)"
      ],
      "example": [
        "--port=8080"
      ],
      "next": [
        {
          "name": "8080"
        }
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show application version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help-long",
      "alias": [
        "--help-man",
        "--help"
      ],
      "usage": [
        "--help, --help-man, --help-long"
      ],
      "tip": [
        "Show context-sensitive help."
      ]
    }
  ]
}
