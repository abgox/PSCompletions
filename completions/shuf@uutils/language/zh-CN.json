{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "输出输入行的随机排列来打乱输入"
    ]
  },
  "option": [
    {
      "name": "--echo",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --echo"
      ],
      "tip": [
        "将每个 ARG 视为一个输入行"
      ]
    },
    {
      "name": "--head-count",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --head-count <COUNT>"
      ],
      "tip": [
        "最多输出 COUNT 行"
      ],
      "next": []
    },
    {
      "name": "--input-range",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --input-range <LO-HI>"
      ],
      "tip": [
        "将 LO 到 HI 的每个数字视为一个输入行"
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <FILE>"
      ],
      "tip": [
        "将结果写入 FILE 而非标准输出"
      ],
      "next": []
    },
    {
      "name": "--random-seed",
      "usage": [
        "--random-seed <STRING>"
      ],
      "tip": [
        "用 STRING 做种子以产生可复现的输出"
      ],
      "next": []
    },
    {
      "name": "--random-source",
      "usage": [
        "--random-source <FILE>"
      ],
      "tip": [
        "从 FILE 获取随机字节"
      ],
      "next": []
    },
    {
      "name": "--repeat",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --repeat"
      ],
      "tip": [
        "输出行可以重复"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "行分隔符为 NUL 而非换行"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
