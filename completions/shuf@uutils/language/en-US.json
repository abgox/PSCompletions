{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Shuffle the input by outputting a random permutation of input lines."
    ]
  },
  "option": [
    {
      "name": "--echo",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --echo"
      ],
      "tip": [
        "treat each ARG as an input line"
      ]
    },
    {
      "name": "--head-count",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --head-count <COUNT>"
      ],
      "tip": [
        "output at most COUNT lines"
      ],
      "next": []
    },
    {
      "name": "--input-range",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --input-range <LO-HI>"
      ],
      "tip": [
        "treat each number LO through HI as an input line"
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <FILE>"
      ],
      "tip": [
        "write result to FILE instead of standard output"
      ],
      "next": []
    },
    {
      "name": "--random-seed",
      "usage": [
        "--random-seed <STRING>"
      ],
      "tip": [
        "seed with STRING for reproducible output"
      ],
      "next": []
    },
    {
      "name": "--random-source",
      "usage": [
        "--random-source <FILE>"
      ],
      "tip": [
        "get random bytes from FILE"
      ],
      "next": []
    },
    {
      "name": "--repeat",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --repeat"
      ],
      "tip": [
        "output lines can be repeated"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "line delimiter is NUL, not newline"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
