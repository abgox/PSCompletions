{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "列出文件信息。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "不忽略以 . 开头的条目"
      ]
    },
    {
      "name": "--almost-all",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --almost-all"
      ],
      "tip": [
        "不列出隐含的 . 和 .."
      ]
    },
    {
      "name": "--author",
      "tip": [
        "配合 -l 使用，打印每个文件的作者"
      ]
    },
    {
      "name": "--block-size",
      "usage": [
        "--block-size=SIZE"
      ],
      "tip": [
        "配合 -l 使用，打印时按 SIZE 缩放大小"
      ],
      "next": []
    },
    {
      "name": "--classify",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --classify"
      ],
      "tip": [
        "在条目后附加指示符（*/=>@| 之一）"
      ]
    },
    {
      "name": "--color",
      "usage": [
        "--color[=WHEN]"
      ],
      "tip": [
        "为输出着色；WHEN 可以是 'always'、'auto' 或 'never'"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--context",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --context"
      ],
      "tip": [
        "打印每个文件的任何安全上下文"
      ]
    },
    {
      "name": "--dereference",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --dereference"
      ],
      "tip": [
        "显示符号链接的文件信息时，显示链接引用的文件信息"
      ]
    },
    {
      "name": "--dereference-command-line",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --dereference-command-line"
      ],
      "tip": [
        "跟随命令行列出的符号链接"
      ]
    },
    {
      "name": "--directory",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --directory"
      ],
      "tip": [
        "列出目录本身而非其内容"
      ]
    },
    {
      "name": "--dired",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --dired"
      ],
      "tip": [
        "生成为 Emacs' dired 模式设计的输出"
      ]
    },
    {
      "name": "--escape",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --escape"
      ],
      "tip": [
        "为非图形字符打印 C 风格转义序列"
      ]
    },
    {
      "name": "--file-type",
      "tip": [
        "类似 --classify，但不附加 '*'"
      ]
    },
    {
      "name": "--format",
      "usage": [
        "--format=WORD"
      ],
      "tip": [
        "across 对应 -x，commas 对应 -m，horizontal 对应 -x，long 对应 -l，single-column 对应 -1，verbose 对应 -l，vertical 对应 -C"
      ],
      "next": [
        {
          "name": "across"
        },
        {
          "name": "commas"
        },
        {
          "name": "horizontal"
        },
        {
          "name": "long"
        },
        {
          "name": "single-column"
        },
        {
          "name": "verbose"
        },
        {
          "name": "vertical"
        }
      ]
    },
    {
      "name": "--full-time",
      "tip": [
        "类似 -l --time-style=full-iso"
      ]
    },
    {
      "name": "--group-directories-first",
      "tip": [
        "在文件之前分组目录"
      ]
    },
    {
      "name": "--hide",
      "usage": [
        "--hide=PATTERN"
      ],
      "tip": [
        "不列出匹配 shell PATTERN 的隐含条目"
      ],
      "next": []
    },
    {
      "name": "--hide-control-chars",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --hide-control-chars"
      ],
      "tip": [
        "打印 ? 代替非图形字符"
      ]
    },
    {
      "name": "--human-readable",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --human-readable"
      ],
      "tip": [
        "配合 -l 和 -s 使用，打印如 1K 234M 2G 等大小"
      ]
    },
    {
      "name": "--hyperlink",
      "usage": [
        "--hyperlink[=WHEN]"
      ],
      "tip": [
        "超链接文件名；WHEN 可以是 'always'、'auto' 或 'never'"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--ignore",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --ignore=PATTERN"
      ],
      "tip": [
        "不列出匹配 shell PATTERN 的隐含条目"
      ],
      "next": []
    },
    {
      "name": "--ignore-backups",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --ignore-backups"
      ],
      "tip": [
        "不列出以 ~ 结尾的隐含条目"
      ]
    },
    {
      "name": "--indicator-style",
      "usage": [
        "--indicator-style=WORD"
      ],
      "tip": [
        "以 WORD 风格将指示符附加到条目名称"
      ],
      "next": [
        {
          "name": "classify"
        },
        {
          "name": "file-type"
        },
        {
          "name": "none"
        },
        {
          "name": "slash"
        }
      ]
    },
    {
      "name": "--inode",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --inode"
      ],
      "tip": [
        "打印每个文件的索引号"
      ]
    },
    {
      "name": "--kibibytes",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --kibibytes"
      ],
      "tip": [
        "磁盘使用默认为 1024 字节块"
      ]
    },
    {
      "name": "--literal",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --literal"
      ],
      "tip": [
        "不加引号地打印条目名称"
      ]
    },
    {
      "name": "--long",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l"
      ],
      "tip": [
        "使用长列表格式"
      ]
    },
    {
      "name": "--no-group",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --no-group"
      ],
      "tip": [
        "在长列表中不打印组名"
      ]
    },
    {
      "name": "--numeric-uid-gid",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --numeric-uid-gid"
      ],
      "tip": [
        "类似 -l，但列出数字用户和组 ID"
      ]
    },
    {
      "name": "--quote-name",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --quote-name"
      ],
      "tip": [
        "用双引号括起条目名称"
      ]
    },
    {
      "name": "--quoting-style",
      "usage": [
        "--quoting-style=WORD"
      ],
      "tip": [
        "为条目名称使用 WORD 引用样式"
      ],
      "next": [
        {
          "name": "c"
        },
        {
          "name": "escape"
        },
        {
          "name": "literal"
        },
        {
          "name": "locale"
        },
        {
          "name": "shell"
        },
        {
          "name": "shell-always"
        },
        {
          "name": "shell-escape"
        },
        {
          "name": "shell-escape-always"
        }
      ]
    },
    {
      "name": "--recursive",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --recursive"
      ],
      "tip": [
        "递归列出子目录"
      ]
    },
    {
      "name": "--reverse",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reverse"
      ],
      "tip": [
        "排序时反转顺序"
      ]
    },
    {
      "name": "--show-control-chars",
      "tip": [
        "原样显示非图形字符"
      ]
    },
    {
      "name": "--si",
      "tip": [
        "类似，但使用 1000 的幂而非 1024"
      ]
    },
    {
      "name": "--size",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --size"
      ],
      "tip": [
        "以块为单位打印每个文件的分配大小"
      ]
    },
    {
      "name": "--sort",
      "usage": [
        "--sort=WORD"
      ],
      "tip": [
        "按 WORD 而非名称排序"
      ],
      "next": [
        {
          "name": "extension"
        },
        {
          "name": "none"
        },
        {
          "name": "size"
        },
        {
          "name": "time"
        },
        {
          "name": "version"
        }
      ]
    },
    {
      "name": "--tabsize",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --tabsize=COLS"
      ],
      "tip": [
        "假设制表符在每个 COLS 处停止，而非 8"
      ],
      "next": []
    },
    {
      "name": "--time",
      "usage": [
        "--time=WORD"
      ],
      "tip": [
        "更改使用修改时间的默认值"
      ],
      "next": [
        {
          "name": "access"
        },
        {
          "name": "atime"
        },
        {
          "name": "birth"
        },
        {
          "name": "creation"
        },
        {
          "name": "ctime"
        },
        {
          "name": "status"
        },
        {
          "name": "use"
        }
      ]
    },
    {
      "name": "--time-style",
      "usage": [
        "--time-style=TIME_STYLE"
      ],
      "tip": [
        "配合 -l 使用的时间/日期格式"
      ],
      "next": [
        {
          "name": "full-iso"
        },
        {
          "name": "iso"
        },
        {
          "name": "locale"
        },
        {
          "name": "long-iso"
        }
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width=COLS"
      ],
      "tip": [
        "设置输出宽度为 COLS。0 表示无限制"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助信息并退出"
      ]
    }
  ]
}
