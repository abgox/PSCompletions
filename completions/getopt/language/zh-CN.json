{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "解析命令选项。"
    ]
  },
  "option": [
    {
      "name": "--alternative",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --alternative"
      ],
      "tip": [
        "允许以单个 - 开头的长选项。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--longoptions",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --longoptions <longopts>"
      ],
      "tip": [
        "要识别的长选项。"
      ],
      "next": []
    },
    {
      "name": "--name",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --name <progname>"
      ],
      "tip": [
        "报告错误时使用的名称。"
      ],
      "next": []
    },
    {
      "name": "--options",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --options <optstring>"
      ],
      "tip": [
        "要识别的短选项。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "禁用 getopt(3) 的错误报告。"
      ]
    },
    {
      "name": "--quiet-output",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --quiet-output"
      ],
      "tip": [
        "不输出正常结果。"
      ]
    },
    {
      "name": "--shell",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shell <shell>"
      ],
      "tip": [
        "将引用约定设置为 <shell> 的约定。",
        "可能值: sh, bash, csh, tcsh"
      ],
      "next": [
        {
          "name": "bash"
        },
        {
          "name": "csh"
        },
        {
          "name": "sh"
        },
        {
          "name": "tcsh"
        }
      ]
    },
    {
      "name": "--test",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --test"
      ],
      "tip": [
        "测试 getopt(1) 版本。"
      ]
    },
    {
      "name": "--unquoted",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unquoted"
      ],
      "tip": [
        "不对输出加引号。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
