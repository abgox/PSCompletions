{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Parse command options."
    ]
  },
  "option": [
    {
      "name": "--alternative",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --alternative"
      ],
      "tip": [
        "Allow long options starting with single -."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--longoptions",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --longoptions <longopts>"
      ],
      "tip": [
        "The long options to be recognized."
      ],
      "next": []
    },
    {
      "name": "--name",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --name <progname>"
      ],
      "tip": [
        "The name under which errors are reported."
      ],
      "next": []
    },
    {
      "name": "--options",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --options <optstring>"
      ],
      "tip": [
        "The short options to be recognized."
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Disable error reporting by getopt(3)."
      ]
    },
    {
      "name": "--quiet-output",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --quiet-output"
      ],
      "tip": [
        "No normal output."
      ]
    },
    {
      "name": "--shell",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shell <shell>"
      ],
      "tip": [
        "Set quoting conventions to those of <shell>.",
        "Possible values: sh, bash, csh, tcsh"
      ],
      "next": [
        {
          "name": "bash"
        },
        {
          "name": "csh"
        },
        {
          "name": "sh"
        },
        {
          "name": "tcsh"
        }
      ]
    },
    {
      "name": "--test",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --test"
      ],
      "tip": [
        "Test for getopt(1) version."
      ]
    },
    {
      "name": "--unquoted",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unquoted"
      ],
      "tip": [
        "Do not quote the output."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
