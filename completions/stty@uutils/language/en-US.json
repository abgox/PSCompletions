{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Print or change terminal characteristics."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "print all current settings in human-readable form"
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --file <DEVICE>"
      ],
      "tip": [
        "open and use the specified DEVICE instead of stdin"
      ],
      "next": []
    },
    {
      "name": "--save",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --save"
      ],
      "tip": [
        "print all current settings in a stty-readable form"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
