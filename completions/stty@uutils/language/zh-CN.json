{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "打印或更改终端特性"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "以人类可读形式打印所有当前设置"
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --file <DEVICE>"
      ],
      "tip": [
        "打开并使用指定的 DEVICE 而非 stdin"
      ],
      "next": []
    },
    {
      "name": "--save",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --save"
      ],
      "tip": [
        "以 stty 可读的形式打印所有当前设置"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
