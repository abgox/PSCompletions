{
  "meta": {
    "url": "https://rsdoctor.rs",
    "description": [
      "AI 友好的构建分析器，让构建过程透明可见。"
    ]
  },
  "next": [
    {
      "name": "analyze",
      "tip": [
        "在浏览器中打开 .rsdoctor/manifest.json 进行分析。"
      ],
      "option": [
        {
          "name": "--no-open",
          "tip": [
            "不自动打开浏览器。"
          ]
        },
        {
          "name": "--port",
          "usage": [
            "--port <NUMBER>"
          ],
          "tip": [
            "Rsdoctor 服务器的端口。"
          ],
          "next": [
            {
              "name": "3000"
            },
            {
              "name": "80"
            },
            {
              "name": "8080"
            }
          ]
        },
        {
          "name": "--profile",
          "usage": [
            "--profile <PATH>"
          ],
          "tip": [
            "Rsdoctor 服务器的 profile 文件。"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "bundle-diff",
      "tip": [
        "在浏览器中打开包差异结果进行分析。"
      ],
      "option": [
        {
          "name": "--baseline",
          "usage": [
            "--baseline <PATH>"
          ],
          "tip": [
            "作为基线的 profile json 的 url 或文件路径。"
          ],
          "next": []
        },
        {
          "name": "--current",
          "usage": [
            "--current <PATH>"
          ],
          "tip": [
            "作为当前版本的 profile json 的 url 或文件路径。"
          ],
          "next": []
        },
        {
          "name": "--html",
          "tip": [
            "输出为独立 HTML 文件。"
          ]
        },
        {
          "name": "--json",
          "usage": [
            "--json [<PATH>]"
          ],
          "tip": [
            "输出为 JSON 文件，可指定文件路径。",
            "默认: rsdoctor-diff.json。"
          ],
          "next": []
        },
        {
          "name": "--output",
          "usage": [
            "--output <PATH>"
          ],
          "tip": [
            "HTML 模式的输出文件路径。",
            "默认: rsdoctor-diff.html。"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "stats-analyze",
      "tip": [
        "在浏览器中打开 webpack stats.json 文件进行分析。"
      ],
      "option": [
        {
          "name": "--port",
          "usage": [
            "--port <NUMBER>"
          ],
          "tip": [
            "Rsdoctor 服务器的端口。"
          ],
          "next": [
            {
              "name": "3000"
            },
            {
              "name": "80"
            },
            {
              "name": "8080"
            }
          ]
        },
        {
          "name": "--profile",
          "usage": [
            "--profile <PATH>"
          ],
          "tip": [
            "待分析的 webpack stats.json 文件路径。"
          ],
          "next": []
        },
        {
          "name": "--type",
          "usage": [
            "--type <MODE>"
          ],
          "tip": [
            "包分析模式。"
          ],
          "next": [
            {
              "name": "lite",
              "tip": [
                "轻量包分析模式。"
              ]
            },
            {
              "name": "normal",
              "tip": [
                "完整包分析模式。"
              ]
            }
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示版本号。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此消息。"
      ]
    }
  ]
}
