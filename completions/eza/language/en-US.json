{
  "meta": {
    "url": "https://eza.rocks",
    "description": [
      "A modern replacement for ls."
    ]
  },
  "option": [
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Print version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--absolute",
      "usage": [
        "--absolute [<on|off|follow>]"
      ],
      "tip": [
        "Display entries with their absolute path."
      ],
      "next": [
        {
          "name": "follow"
        },
        {
          "name": "off"
        },
        {
          "name": "on"
        }
      ]
    },
    {
      "name": "--accessed",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --accessed"
      ],
      "tip": [
        "Show the accessed timestamp field."
      ]
    },
    {
      "name": "--across",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --across"
      ],
      "tip": [
        "Sort the grid across, rather than downwards."
      ]
    },
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Show hidden files. Use twice to also show '.' and '..'."
      ],
      "repeat": 2
    },
    {
      "name": "--almost-all",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --almost-all"
      ],
      "tip": [
        "Equivalent to --all; included for compatibility with ls -A."
      ]
    },
    {
      "name": "--binary",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --binary"
      ],
      "tip": [
        "Show file sizes with binary prefixes."
      ]
    },
    {
      "name": "--blocksize",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --blocksize"
      ],
      "tip": [
        "List size of allocated file system blocks."
      ]
    },
    {
      "name": "--bytes",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --bytes"
      ],
      "tip": [
        "Show file sizes in bytes, without any prefixes."
      ]
    },
    {
      "name": "--changed",
      "tip": [
        "Show the changed timestamp field."
      ]
    },
    {
      "name": "--classify",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --classify [<WHEN>]"
      ],
      "tip": [
        "Display type indicator by file names."
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--code",
      "usage": [
        "--code [=MODE]"
      ],
      "tip": [
        "Summarise lines of code by language."
      ],
      "next": [
        {
          "name": "both"
        },
        {
          "name": "lines"
        },
        {
          "name": "percent"
        }
      ]
    },
    {
      "name": "--color",
      "usage": [
        "--color [<WHEN>]"
      ],
      "tip": [
        "When to use colours."
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--color-scale",
      "usage": [
        "--color-scale [<FIELDS>...]"
      ],
      "tip": [
        "Highlight value of FIELDS distinctly."
      ],
      "next": [
        {
          "name": "age"
        },
        {
          "name": "all"
        },
        {
          "name": "size"
        }
      ]
    },
    {
      "name": "--color-scale-mode",
      "usage": [
        "--color-scale-mode <MODE>"
      ],
      "tip": [
        "Mode for --color-scale."
      ],
      "next": [
        {
          "name": "fixed"
        },
        {
          "name": "gradient"
        }
      ]
    },
    {
      "name": "--context",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --context"
      ],
      "tip": [
        "List each file's security context."
      ]
    },
    {
      "name": "--created",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --created"
      ],
      "tip": [
        "Show the created timestamp field."
      ]
    },
    {
      "name": "--dereference",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --dereference"
      ],
      "tip": [
        "Dereference symbolic links when displaying information."
      ]
    },
    {
      "name": "--extended",
      "alias": [
        "-@"
      ],
      "usage": [
        "-@, --extended"
      ],
      "tip": [
        "List each file's extended attributes and sizes."
      ]
    },
    {
      "name": "--flags",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --flags"
      ],
      "tip": [
        "List file flags (Mac, BSD, and Windows only)."
      ]
    },
    {
      "name": "--follow-symlinks",
      "tip": [
        "Drill down into symbolic links that point to directories."
      ]
    },
    {
      "name": "--git",
      "tip": [
        "List each file's Git status, if tracked or ignored."
      ]
    },
    {
      "name": "--git-ignore",
      "tip": [
        "Ignore files mentioned in .gitignore."
      ]
    },
    {
      "name": "--git-repos",
      "tip": [
        "List root of git-tree status."
      ]
    },
    {
      "name": "--git-repos-no-status",
      "tip": [
        "List root of git-tree branch name (much faster)."
      ]
    },
    {
      "name": "--grid",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --grid"
      ],
      "tip": [
        "Display entries as a grid (default)."
      ]
    },
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group"
      ],
      "tip": [
        "List each file's group."
      ]
    },
    {
      "name": "--group-directories-first",
      "tip": [
        "List directories before other files."
      ]
    },
    {
      "name": "--group-directories-last",
      "tip": [
        "List directories after other files."
      ]
    },
    {
      "name": "--header",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --header"
      ],
      "tip": [
        "Add a header row to each column."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-?"
      ],
      "usage": [
        "-?, --help"
      ],
      "tip": [
        "Print help."
      ]
    },
    {
      "name": "--hyperlink",
      "usage": [
        "--hyperlink [<WHEN>]"
      ],
      "tip": [
        "When to display entries as hyperlinks."
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--icons",
      "usage": [
        "--icons [<WHEN>]"
      ],
      "tip": [
        "When to display icons."
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--ignore-glob",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --ignore-glob <GLOBS>"
      ],
      "tip": [
        "Glob patterns of files to ignore."
      ],
      "next": []
    },
    {
      "name": "--inode",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --inode"
      ],
      "tip": [
        "List each file's inode number."
      ]
    },
    {
      "name": "--level",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --level <DEPTH>"
      ],
      "tip": [
        "Limit the depth of recursion."
      ],
      "next": []
    },
    {
      "name": "--links",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --links"
      ],
      "tip": [
        "List each file's number of hard links."
      ]
    },
    {
      "name": "--loc",
      "usage": [
        "--loc [=MODE]"
      ],
      "tip": [
        "Add lines-of-code and language columns."
      ],
      "next": [
        {
          "name": "both"
        },
        {
          "name": "lines"
        },
        {
          "name": "percent"
        }
      ]
    },
    {
      "name": "--long",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --long"
      ],
      "tip": [
        "Display extended file metadata as a table."
      ]
    },
    {
      "name": "--modified",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --modified"
      ],
      "tip": [
        "Show the modified timestamp field."
      ]
    },
    {
      "name": "--mounts",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --mounts"
      ],
      "tip": [
        "Show mount details (Linux and macOS only)."
      ]
    },
    {
      "name": "--no-filesize",
      "tip": [
        "Suppress the filesize field."
      ]
    },
    {
      "name": "--no-git",
      "tip": [
        "Suppress Git fields."
      ]
    },
    {
      "name": "--no-permissions",
      "tip": [
        "Suppress the permissions field."
      ]
    },
    {
      "name": "--no-quotes",
      "tip": [
        "Don't quote file names with spaces."
      ]
    },
    {
      "name": "--no-symlinks",
      "tip": [
        "Do not show symbolic links."
      ]
    },
    {
      "name": "--no-time",
      "tip": [
        "Suppress the time field."
      ]
    },
    {
      "name": "--no-user",
      "tip": [
        "Suppress the user field."
      ]
    },
    {
      "name": "--numeric",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --numeric"
      ],
      "tip": [
        "Show user and group as their numeric IDs."
      ]
    },
    {
      "name": "--octal-permissions",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --octal-permissions"
      ],
      "tip": [
        "List each file's permission in octal format."
      ]
    },
    {
      "name": "--oneline",
      "alias": [
        "-1"
      ],
      "usage": [
        "-1, --oneline"
      ],
      "tip": [
        "Display one entry per line."
      ]
    },
    {
      "name": "--only-dirs",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --only-dirs"
      ],
      "tip": [
        "List only directories."
      ]
    },
    {
      "name": "--only-files",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --only-files"
      ],
      "tip": [
        "List only files."
      ]
    },
    {
      "name": "--recurse",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --recurse"
      ],
      "tip": [
        "Recurse into directories."
      ]
    },
    {
      "name": "--reverse",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reverse"
      ],
      "tip": [
        "Reverse the sort order."
      ]
    },
    {
      "name": "--short-nix",
      "tip": [
        "Abbreviate Nix store hashes in file names and paths."
      ]
    },
    {
      "name": "--show-symlinks",
      "tip": [
        "Explicitly show symbolic links."
      ]
    },
    {
      "name": "--smart-group",
      "tip": [
        "Only show group if it has a different name from owner."
      ]
    },
    {
      "name": "--sort",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sort <FIELD>"
      ],
      "tip": [
        "Which field to sort by."
      ],
      "next": [
        {
          "name": ".ext"
        },
        {
          "name": ".name"
        },
        {
          "name": ".Name"
        },
        {
          "name": "accessed"
        },
        {
          "name": "age"
        },
        {
          "name": "changed"
        },
        {
          "name": "created"
        },
        {
          "name": "date"
        },
        {
          "name": "ext"
        },
        {
          "name": "inode"
        },
        {
          "name": "name"
        },
        {
          "name": "Name"
        },
        {
          "name": "none"
        },
        {
          "name": "size"
        },
        {
          "name": "type"
        }
      ]
    },
    {
      "name": "--stdin",
      "tip": [
        "Read file names from stdin."
      ]
    },
    {
      "name": "--time",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --time <FIELD>"
      ],
      "tip": [
        "Which timestamp field to show."
      ],
      "next": [
        {
          "name": "acc"
        },
        {
          "name": "accessed"
        },
        {
          "name": "ch"
        },
        {
          "name": "changed"
        },
        {
          "name": "cr"
        },
        {
          "name": "created"
        },
        {
          "name": "mod"
        },
        {
          "name": "modified"
        }
      ]
    },
    {
      "name": "--time-style",
      "usage": [
        "--time-style <STYLE>"
      ],
      "tip": [
        "How to format timestamps."
      ],
      "next": [
        {
          "name": "default"
        },
        {
          "name": "full-iso"
        },
        {
          "name": "iso"
        },
        {
          "name": "long-iso"
        },
        {
          "name": "relative"
        }
      ]
    },
    {
      "name": "--total-size",
      "tip": [
        "Show the size of a directory as the sum of its content."
      ]
    },
    {
      "name": "--treat-dirs-as-files",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --treat-dirs-as-files"
      ],
      "tip": [
        "Treat directories as files; don't list their contents."
      ]
    },
    {
      "name": "--tree",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --tree"
      ],
      "tip": [
        "Recurse into directories as a tree."
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <COLS>"
      ],
      "tip": [
        "Set screen width in columns."
      ],
      "next": []
    }
  ]
}
