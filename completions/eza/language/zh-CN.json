      "tip": [
        "按文件名显示类型指示器。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--code",
      "usage": [
        "--code [=MODE]"
      ],
      "tip": [
        "按语言汇总代码行数。"
      ],
      "next": [
        {
          "name": "both"
        },
        {
          "name": "lines"
        },
        {
          "name": "percent"
        }
      ]
    },
    {
      "name": "--color",
      "usage": [
        "--color [<WHEN>]"
      ],
      "tip": [
        "何时使用颜色。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--color-scale",
      "usage": [
        "--color-scale [<FIELDS>...]"
