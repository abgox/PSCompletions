      "tip": [
        "列出 git 树状态的根。"
      ]
    },
    {
      "name": "--git-repos-no-status",
      "tip": [
        "列出 git 树分支名（更快）。"
      ]
    },
    {
      "name": "--grid",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --grid"
      ],
      "tip": [
        "以网格形式显示条目（默认）。"
