{
  "meta": {
    "url": "https://eza.rocks",
    "description": [
      "ls 的现代替代品。"
    ]
  },
  "option": [
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "打印版本。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--absolute",
      "usage": [
        "--absolute [<on|off|follow>]"
      ],
      "tip": [
        "以绝对路径显示条目。"
      ],
      "next": [
        {
          "name": "follow"
        },
        {
          "name": "off"
        },
        {
          "name": "on"
        }
      ]
    },
    {
      "name": "--accessed",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --accessed"
      ],
      "tip": [
        "显示访问时间戳字段。"
      ]
    },
    {
      "name": "--across",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --across"
      ],
      "tip": [
        "横向排序网格，而非纵向。"
      ]
    },
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "显示隐藏文件。使用两次还显示 '.' 和 '..'。"
      ],
      "repeat": 2
    },
    {
      "name": "--almost-all",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --almost-all"
      ],
      "tip": [
        "等同于 --all；为兼容 ls -A 而包含。"
      ]
    },
    {
      "name": "--binary",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --binary"
      ],
      "tip": [
        "以二进制前缀显示文件大小。"
      ]
    },
    {
      "name": "--blocksize",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --blocksize"
      ],
      "tip": [
        "列出分配的文件系统块大小。"
      ]
    },
    {
      "name": "--bytes",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --bytes"
      ],
      "tip": [
        "以字节为单位显示文件大小，无前缀。"
      ]
