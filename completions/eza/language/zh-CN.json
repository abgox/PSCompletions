      "tip": [
        "显示创建时间戳字段。"
      ]
    },
    {
      "name": "--dereference",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --dereference"
      ],
      "tip": [
        "显示信息时取消引用符号链接。"
      ]
    },
    {
      "name": "--extended",
      "alias": [
        "-@"
      ],
      "usage": [
        "-@, --extended"
      ],
      "tip": [
        "列出每个文件的扩展属性和大小。"
      ]
    },
    {
      "name": "--flags",
      "alias": [
        "-O"
