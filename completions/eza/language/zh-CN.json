      "tip": [
        "以不同方式突出显示字段的值。"
      ],
      "next": [
        {
          "name": "age"
        },
        {
          "name": "all"
        },
        {
          "name": "size"
        }
      ]
    },
    {
      "name": "--color-scale-mode",
      "usage": [
        "--color-scale-mode <MODE>"
      ],
      "tip": [
        "--color-scale 的模式。"
      ],
      "next": [
        {
          "name": "fixed"
        },
        {
          "name": "gradient"
        }
      ]
    },
