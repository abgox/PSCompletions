{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "将特定大小或范围的内存设置为在线或离线。"
    ]
  },
  "option": [
    {
      "name": "--blocks",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --blocks"
      ],
      "tip": [
        "使用内存块。"
      ]
    },
    {
      "name": "--disable",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --disable"
      ],
      "tip": [
        "禁用内存。"
      ]
    },
    {
      "name": "--enable",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --enable"
      ],
      "tip": [
        "启用内存。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "详细输出。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--zone",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zone <name>"
      ],
      "tip": [
        "选择内存区域。",
        "可能值: DMA, DMA32, Normal, Highmem, Movable, Device"
      ],
      "next": [
        {
          "name": "Device"
        },
        {
          "name": "DMA"
        },
        {
          "name": "DMA32"
        },
        {
          "name": "Highmem"
        },
        {
          "name": "Movable"
        },
        {
          "name": "Normal"
        }
      ]
    }
  ]
}
