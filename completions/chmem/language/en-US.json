{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Set a particular size or range of memory online or offline."
    ]
  },
  "option": [
    {
      "name": "--blocks",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --blocks"
      ],
      "tip": [
        "Use memory blocks."
      ]
    },
    {
      "name": "--disable",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --disable"
      ],
      "tip": [
        "Disable memory."
      ]
    },
    {
      "name": "--enable",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --enable"
      ],
      "tip": [
        "Enable memory."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Verbose output."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--zone",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zone <name>"
      ],
      "tip": [
        "Select memory zone.",
        "Possible values: DMA, DMA32, Normal, Highmem, Movable, Device"
      ],
      "next": [
        {
          "name": "Device"
        },
        {
          "name": "DMA"
        },
        {
          "name": "DMA32"
        },
        {
          "name": "Highmem"
        },
        {
          "name": "Movable"
        },
        {
          "name": "Normal"
        }
      ]
    }
  ]
}
