{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "生成文件内容的排序索引"
    ]
  },
  "option": [
    {
      "name": "--auto-reference",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --auto-reference"
      ],
      "tip": [
        "输出自动生成的引用"
      ]
    },
    {
      "name": "--break-file",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --break-file <FILE>"
      ],
      "tip": [
        "此 FILE 中的断词字符"
      ],
      "next": []
    },
    {
      "name": "--flag-truncation",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --flag-truncation <STRING>"
      ],
      "tip": [
        "使用 STRING 标记行截断"
      ],
      "next": []
    },
    {
      "name": "--gap-size",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --gap-size <NUMBER>"
      ],
      "tip": [
        "输出字段之间的间隔列数"
      ],
      "next": []
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --ignore-case"
      ],
      "tip": [
        "排序时将小写折叠为大写"
      ]
    },
    {
      "name": "--ignore-file",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-file <FILE>"
      ],
      "tip": [
        "从 FILE 读取忽略词表"
      ],
      "next": []
    },
    {
      "name": "--macro-name",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --macro-name <STRING>"
      ],
      "tip": [
        "使用宏名称而非 xx"
      ],
      "next": []
    },
    {
      "name": "--only-file",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --only-file <FILE>"
      ],
      "tip": [
        "仅从此 FILE 读取词表"
      ],
      "next": []
    },
    {
      "name": "--references",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --references"
      ],
      "tip": [
        "每行的第一个字段为引用"
      ]
    },
    {
      "name": "--right-side-refs",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --right-side-refs"
      ],
      "tip": [
        "将引用放在右侧，不计入 -w"
      ]
    },
    {
      "name": "--sentence-regexp",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --sentence-regexp <REGEXP>"
      ],
      "tip": [
        "用于行尾或句尾"
      ],
      "next": []
    },
    {
      "name": "--traditional",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --traditional"
      ],
      "tip": [
        "行为更像 System V 的 ptx"
      ]
    },
    {
      "name": "--typeset-mode",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --typeset-mode"
      ],
      "tip": [
        "将默认宽度从 72 改为 100"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <NUMBER>"
      ],
      "tip": [
        "输出宽度（列数），不含引用"
      ],
      "next": []
    },
    {
      "name": "--word-regexp",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --word-regexp <REGEXP>"
      ],
      "tip": [
        "使用 REGEXP 匹配每个关键字"
      ],
      "next": []
    },
    {
      "name": "-O",
      "tip": [
        "生成 roff 指令形式的输出"
      ]
    },
    {
      "name": "-T",
      "tip": [
        "生成 TeX 指令形式的输出"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
