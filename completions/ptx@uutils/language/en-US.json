{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Produce a permuted index of file contents"
    ]
  },
  "option": [
    {
      "name": "--auto-reference",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --auto-reference"
      ],
      "tip": [
        "output automatically generated references"
      ]
    },
    {
      "name": "--break-file",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --break-file <FILE>"
      ],
      "tip": [
        "word break characters in this FILE"
      ],
      "next": []
    },
    {
      "name": "--flag-truncation",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --flag-truncation <STRING>"
      ],
      "tip": [
        "use STRING for flagging line truncations"
      ],
      "next": []
    },
    {
      "name": "--gap-size",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --gap-size <NUMBER>"
      ],
      "tip": [
        "gap size in columns between output fields"
      ],
      "next": []
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --ignore-case"
      ],
      "tip": [
        "fold lower case to upper case for sorting"
      ]
    },
    {
      "name": "--ignore-file",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-file <FILE>"
      ],
      "tip": [
        "read ignore word list from FILE"
      ],
      "next": []
    },
    {
      "name": "--macro-name",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --macro-name <STRING>"
      ],
      "tip": [
        "macro name to use instead of 'xx'"
      ],
      "next": []
    },
    {
      "name": "--only-file",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --only-file <FILE>"
      ],
      "tip": [
        "read only word list from this FILE"
      ],
      "next": []
    },
    {
      "name": "--references",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --references"
      ],
      "tip": [
        "first field of each line is a reference"
      ]
    },
    {
      "name": "--right-side-refs",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --right-side-refs"
      ],
      "tip": [
        "put references at right, not counted in -w"
      ]
    },
    {
      "name": "--sentence-regexp",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --sentence-regexp <REGEXP>"
      ],
      "tip": [
        "for end of lines or end of sentences"
      ],
      "next": []
    },
    {
      "name": "--traditional",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --traditional"
      ],
      "tip": [
        "behave more like System V 'ptx'"
      ]
    },
    {
      "name": "--typeset-mode",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --typeset-mode"
      ],
      "tip": [
        "change the default width from 72 to 100"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <NUMBER>"
      ],
      "tip": [
        "output width in columns, reference excluded"
      ],
      "next": []
    },
    {
      "name": "--word-regexp",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --word-regexp <REGEXP>"
      ],
      "tip": [
        "use REGEXP to match each keyword"
      ],
      "next": []
    },
    {
      "name": "-O",
      "tip": [
        "generate output as roff directives"
      ]
    },
    {
      "name": "-T",
      "tip": [
        "generate output as TeX directives"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
