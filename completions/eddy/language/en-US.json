{
  "meta": {
    "url": "https://github.com/70sh1/eddy",
    "description": [
      "Simple and fast file encryption"
    ]
  },
  "next": [
    {
      "name": "decrypt",
      "alias": [
        "dec",
        "d"
      ],
      "usage": [
        "d|dec|decrypt [file...]"
      ],
      "tip": [
        "Decrypts provided files"
      ]
    },
    {
      "name": "encrypt",
      "alias": [
        "enc",
        "e"
      ],
      "usage": [
        "e|enc|encrypt [file...]"
      ],
      "tip": [
        "Encrypts provided files"
      ]
    },
    {
      "name": "generate",
      "alias": [
        "gen",
        "g"
      ],
      "usage": [
        "g|gen|generate"
      ],
      "tip": [
        "Generates a passphrase of the given length"
      ]
    },
    {
      "name": "help",
      "alias": [
        "h"
      ],
      "usage": [
        "h|help [command]"
      ],
      "tip": [
        "Shows a list of commands or help for one command"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--force",
      "tip": [
        "Force decrypt (bypass file authentication)"
      ]
    },
    {
      "name": "--no-emoji",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-emoji"
      ],
      "tip": [
        "Disable emojis in output (default: false)"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <PATH>"
      ],
      "tip": [
        "Specify output directory PATH"
      ],
      "next": []
    },
    {
      "name": "--overwrite",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --overwrite"
      ],
      "tip": [
        "Overwrite existing files (default: false)"
      ]
    },
    {
      "name": "--passgenlen",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --passgenlen <LENGTH>"
      ],
      "tip": [
        "Specify generated passphrase LENGTH (default: 6)"
      ],
      "next": []
    },
    {
      "name": "--unsafe-password",
      "usage": [
        "--unsafe-password <PASSWORD>"
      ],
      "tip": [
        "Replace password prompt with the provided PASSWORD"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Print the version"
      ]
    }
  ]
}
