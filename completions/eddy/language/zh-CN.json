{
  "meta": {
    "url": "https://github.com/70sh1/eddy",
    "description": [
      "简单快速的文件加密工具"
    ]
  },
  "next": [
    {
      "name": "decrypt",
      "alias": [
        "dec",
        "d"
      ],
      "usage": [
        "d|dec|decrypt [file...]"
      ],
      "tip": [
        "解密指定的文件"
      ]
    },
    {
      "name": "encrypt",
      "alias": [
        "enc",
        "e"
      ],
      "usage": [
        "e|enc|encrypt [file...]"
      ],
      "tip": [
        "加密指定的文件"
      ]
    },
    {
      "name": "generate",
      "alias": [
        "gen",
        "g"
      ],
      "usage": [
        "g|gen|generate"
      ],
      "tip": [
        "生成指定长度的密码短语"
      ]
    },
    {
      "name": "help",
      "alias": [
        "h"
      ],
      "usage": [
        "h|help [command]"
      ],
      "tip": [
        "显示命令列表或某个命令的帮助"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--force",
      "tip": [
        "强制解密（绕过文件认证）"
      ]
    },
    {
      "name": "--no-emoji",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-emoji"
      ],
      "tip": [
        "禁用输出中的表情符号（默认：false）"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <PATH>"
      ],
      "tip": [
        "指定输出目录路径"
      ],
      "next": []
    },
    {
      "name": "--overwrite",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --overwrite"
      ],
      "tip": [
        "覆盖现有文件（默认：false）"
      ]
    },
    {
      "name": "--passgenlen",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --passgenlen <LENGTH>"
      ],
      "tip": [
        "指定生成密码短语的长度（默认：6）"
      ],
      "next": []
    },
    {
      "name": "--unsafe-password",
      "usage": [
        "--unsafe-password <PASSWORD>"
      ],
      "tip": [
        "用提供的密码替代密码提示"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ]
}
