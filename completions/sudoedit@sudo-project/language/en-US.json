{
  "meta": {
    "url": "https://www.sudo.ws/",
    "description": [
      "Edit files as another user."
    ]
  },
  "option": [
    {
      "name": "--",
      "tip": [
        "Stop processing command line arguments."
      ]
    },
    {
      "name": "--askpass",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --askpass"
      ],
      "tip": [
        "Use a helper program for password prompting."
      ]
    },
    {
      "name": "--bell",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --bell"
      ],
      "tip": [
        "Ring bell when prompting."
      ]
    },
    {
      "name": "--chdir",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --chdir <DIRECTORY>"
      ],
      "tip": [
        "Change the working directory before running command."
      ],
      "next": []
    },
    {
      "name": "--chroot",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --chroot <DIRECTORY>"
      ],
      "tip": [
        "Change the root directory before running command."
      ],
      "next": []
    },
    {
      "name": "--close-from",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --close-from <NUM>"
      ],
      "tip": [
        "Close all file descriptors >= NUM."
      ],
      "next": []
    },
    {
      "name": "--command-timeout",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --command-timeout <TIMEOUT>"
      ],
      "tip": [
        "Terminate command after the specified time limit."
      ],
      "next": []
    },
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group <GROUP>"
      ],
      "tip": [
        "Run command as the specified group name or ID."
      ],
      "next": []
    },
    {
      "name": "--host",
      "usage": [
        "--host <HOST>"
      ],
      "tip": [
        "Run command on host (if supported by plugin)."
      ],
      "next": []
    },
    {
      "name": "--non-interactive",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --non-interactive"
      ],
      "tip": [
        "Non-interactive mode, no prompts are used."
      ]
    },
    {
      "name": "--prompt",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --prompt <PROMPT>"
      ],
      "tip": [
        "Use the specified password prompt."
      ],
      "next": []
    },
    {
      "name": "--reset-timestamp",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --reset-timestamp"
      ],
      "tip": [
        "Invalidate timestamp file."
      ]
    },
    {
      "name": "--role",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --role <ROLE>"
      ],
      "tip": [
        "Create SELinux security context with specified role."
      ],
      "next": []
    },
    {
      "name": "--stdin",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --stdin"
      ],
      "tip": [
        "Read password from standard input."
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "Create SELinux security context with specified type."
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <USER>"
      ],
      "tip": [
        "Run command (or edit file) as specified user name or ID."
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display help message and exit."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version information and exit."
      ]
    }
  ]
}
