{
  "meta": {
    "url": "https://www.sudo.ws/",
    "description": [
      "以另一个用户的身份编辑文件。"
    ]
  },
  "option": [
    {
      "name": "--",
      "tip": [
        "停止处理命令行参数。"
      ]
    },
    {
      "name": "--askpass",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --askpass"
      ],
      "tip": [
        "使用辅助程序进行密码提示。"
      ]
    },
    {
      "name": "--bell",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --bell"
      ],
      "tip": [
        "在提示时响铃。"
      ]
    },
    {
      "name": "--chdir",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --chdir <DIRECTORY>"
      ],
      "tip": [
        "在运行命令之前更改工作目录。"
      ],
      "next": []
    },
    {
      "name": "--chroot",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --chroot <DIRECTORY>"
      ],
      "tip": [
        "在运行命令之前更改根目录。"
      ],
      "next": []
    },
    {
      "name": "--close-from",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --close-from <NUM>"
      ],
      "tip": [
        "关闭所有大于等于 NUM 的文件描述符。"
      ],
      "next": []
    },
    {
      "name": "--command-timeout",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --command-timeout <TIMEOUT>"
      ],
      "tip": [
        "在指定的时间限制后终止命令。"
      ],
      "next": []
    },
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group <GROUP>"
      ],
      "tip": [
        "以指定的组名或组 ID 运行命令。"
      ],
      "next": []
    },
    {
      "name": "--host",
      "usage": [
        "--host <HOST>"
      ],
      "tip": [
        "在主机上运行命令（如果插件支持）。"
      ],
      "next": []
    },
    {
      "name": "--non-interactive",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --non-interactive"
      ],
      "tip": [
        "非交互模式，不使用任何提示。"
      ]
    },
    {
      "name": "--prompt",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --prompt <PROMPT>"
      ],
      "tip": [
        "使用指定的密码提示。"
      ],
      "next": []
    },
    {
      "name": "--reset-timestamp",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --reset-timestamp"
      ],
      "tip": [
        "使时间戳文件失效。"
      ]
    },
    {
      "name": "--role",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --role <ROLE>"
      ],
      "tip": [
        "创建具有指定角色的 SELinux 安全上下文。"
      ],
      "next": []
    },
    {
      "name": "--stdin",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --stdin"
      ],
      "tip": [
        "从标准输入读取密码。"
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "创建具有指定类型的 SELinux 安全上下文。"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <USER>"
      ],
      "tip": [
        "以指定的用户名或用户 ID 运行命令（或编辑文件）。"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息并退出。"
      ]
    }
  ]
}
