{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Display numbers from FIRST to LAST, in steps of INCREMENT."
    ]
  },
  "option": [
    {
      "name": "--equal-width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --equal-width"
      ],
      "tip": [
        "Equalize widths of all numbers by padding with zeros"
      ]
    },
    {
      "name": "--format",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --format <FORMAT>"
      ],
      "tip": [
        "use printf style floating-point FORMAT"
      ],
      "next": []
    },
    {
      "name": "--separator",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --separator <SEPARATOR>"
      ],
      "tip": [
        "Separator character (defaults to \\n)"
      ],
      "next": []
    },
    {
      "name": "--terminator",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --terminator <TERMINATOR>"
      ],
      "tip": [
        "Terminator character (defaults to \\n)"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
