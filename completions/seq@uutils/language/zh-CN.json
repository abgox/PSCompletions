{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "按 INCREMENT 步长显示从 FIRST 到 LAST 的数字"
    ]
  },
  "option": [
    {
      "name": "--equal-width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --equal-width"
      ],
      "tip": [
        "用零填充使所有数字等宽"
      ]
    },
    {
      "name": "--format",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --format <FORMAT>"
      ],
      "tip": [
        "使用 printf 风格的浮点 FORMAT"
      ],
      "next": []
    },
    {
      "name": "--separator",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --separator <SEPARATOR>"
      ],
      "tip": [
        "分隔符（默认为 \\n）"
      ],
      "next": []
    },
    {
      "name": "--terminator",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --terminator <TERMINATOR>"
      ],
      "tip": [
        "终止符（默认为 \\n）"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
