{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把每个 NAME 在环境中设为 VALUE，然后运行 COMMAND。"
    ]
  },
  "option": [
    {
      "name": "--argv0",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --argv0 <ARG>"
      ],
      "tip": [
        "把 ARG 作为 COMMAND 的第零个参数"
      ],
      "next": []
    },
    {
      "name": "--block-signal",
      "usage": [
        "--block-signal[=SIG]"
      ],
      "tip": [
        "阻止向 COMMAND 投递 SIG 信号"
      ],
      "separator": ",",
      "next": [
        {
          "name": "HUP"
        },
        {
          "name": "INT"
        },
        {
          "name": "KILL"
        },
        {
          "name": "PIPE"
        },
        {
          "name": "QUIT"
        },
        {
          "name": "TERM"
        }
      ]
    },
    {
      "name": "--chdir",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --chdir <DIR>"
      ],
      "tip": [
        "把工作目录切换到 DIR"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --debug"
      ],
      "tip": [
        "为每个处理步骤打印详细信息"
      ]
    },
    {
      "name": "--default-signal",
      "usage": [
        "--default-signal[=SIG]"
      ],
      "tip": [
        "把 SIG 信号的处理方式重置为默认"
      ],
      "separator": ",",
      "next": [
        {
          "name": "HUP"
        },
        {
          "name": "INT"
        },
        {
          "name": "KILL"
        },
        {
          "name": "PIPE"
        },
        {
          "name": "QUIT"
        },
        {
          "name": "TERM"
        }
      ]
    },
    {
      "name": "--ignore-environment",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-environment"
      ],
      "tip": [
        "以空环境启动"
      ]
    },
    {
      "name": "--ignore-signal",
      "usage": [
        "--ignore-signal[=SIG]"
      ],
      "tip": [
        "把 SIG 信号的处理方式设为不做任何事"
      ],
      "separator": ",",
      "next": [
        {
          "name": "HUP"
        },
        {
          "name": "INT"
        },
        {
          "name": "KILL"
        },
        {
          "name": "PIPE"
        },
        {
          "name": "QUIT"
        },
        {
          "name": "TERM"
        }
      ]
    },
    {
      "name": "--list-signal-handling",
      "tip": [
        "将非默认的信号处理输出到 stderr"
      ]
    },
    {
      "name": "--null",
      "alias": [
        "-0"
      ],
      "usage": [
        "-0, --null"
      ],
      "tip": [
        "每行输出以 NUL 结尾，而不是换行符"
      ]
    },
    {
      "name": "--split-string",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --split-string <S>"
      ],
      "tip": [
        "把 S 处理并拆分成多个独立参数；用于在 shebang 行上传递多个参数"
      ],
      "next": []
    },
    {
      "name": "--unset",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unset <NAME>"
      ],
      "tip": [
        "从环境中删除该变量"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
