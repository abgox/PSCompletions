{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "折行每个 FILE 的输入内容，输出到标准输出。"
    ]
  },
  "option": [
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "按字节计数，而不是按列"
      ]
    },
    {
      "name": "--spaces",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --spaces"
      ],
      "tip": [
        "在空格处断行"
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <WIDTH>"
      ],
      "tip": [
        "使用 WIDTH 列，而不是 80"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
