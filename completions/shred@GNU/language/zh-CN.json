{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "反复覆写指定的 FILE，使得即使代价高昂的硬件探测也难以恢复其中的数据。"
    ]
  },
  "option": [
    {
      "name": "--exact",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exact"
      ],
      "tip": [
        "不把文件大小向上取整到下一个整块；对非普通文件这是默认行为"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "必要时修改权限以允许写入"
      ]
    },
    {
      "name": "--iterations",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --iterations <N>"
      ],
      "tip": [
        "覆写 N 次而不是默认的 3 次"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "10"
        },
        {
          "name": "3"
        }
      ]
    },
    {
      "name": "--random-source",
      "usage": [
        "--random-source <FILE>"
      ],
      "tip": [
        "从 FILE 获取随机字节"
      ],
      "next": []
    },
    {
      "name": "--remove",
      "usage": [
        "--remove[=HOW]"
      ],
      "tip": [
        "与 -u 类似，但由 HOW 控制删除方式；详见下方"
      ],
      "next": [
        {
          "name": "unlink"
        },
        {
          "name": "wipe"
        },
        {
          "name": "wipesync"
        }
      ]
    },
    {
      "name": "--size",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --size <N>"
      ],
      "tip": [
        "只覆写这么多字节（接受 K、M、G 之类的单位后缀）"
      ],
      "next": [
        {
          "name": "1G"
        },
        {
          "name": "1K"
        },
        {
          "name": "1M"
        }
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "显示进度"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "最后用零再覆写一次，以掩盖覆写痕迹"
      ]
    },
    {
      "name": "-u",
      "tip": [
        "覆写之后释放空间并删除文件"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
