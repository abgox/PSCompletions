{
  "meta": {
    "url": "https://github.com/ducaale/xh",
    "description": [
      "A friendly and fast tool for sending HTTP requests",
      "HTTPie alternative written in Rust"
    ]
  },
  "option": [
    {
      "name": "--all",
      "tip": [
        "Show intermediary requests/responses while following redirects"
      ]
    },
    {
      "name": "--auth",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --auth <USER[:PASS]|TOKEN>"
      ],
      "tip": [
        "Authenticate as USER with PASS or with TOKEN"
      ],
      "next": []
    },
    {
      "name": "--auth-type",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --auth-type <TYPE>"
      ],
      "tip": [
        "Specify the auth mechanism"
      ],
      "next": [
        {
          "name": "basic",
          "tip": [
            "Basic authentication"
          ]
        },
        {
          "name": "bearer",
          "tip": [
            "Bearer token"
          ]
        },
        {
          "name": "digest",
          "tip": [
            "Digest authentication"
          ]
        }
      ]
    },
    {
      "name": "--body",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --body"
      ],
      "tip": [
        "Print only the response body"
      ]
    },
    {
      "name": "--cert",
      "usage": [
        "--cert <FILE>"
      ],
      "tip": [
        "Use a client side certificate for SSL"
      ],
      "next": []
    },
    {
      "name": "--cert-key",
      "usage": [
        "--cert-key <FILE>"
      ],
      "tip": [
        "A private key file to use with --cert"
      ],
      "next": []
    },
    {
      "name": "--check-status",
      "tip": [
        "Exit with error status code if server replies with error"
      ]
    },
    {
      "name": "--compress",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --compress"
      ],
      "tip": [
        "Content compressed with Deflate algorithm"
      ]
    },
    {
      "name": "--continue",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --continue"
      ],
      "tip": [
        "Resume an interrupted download"
      ]
    },
    {
      "name": "--curl",
      "tip": [
        "Print a translation to a curl command"
      ]
    },
    {
      "name": "--curl-long",
      "tip": [
        "Use the long versions of curl's flags"
      ]
    },
    {
      "name": "--debug",
      "tip": [
        "Print full error stack traces and debug log messages"
      ]
    },
    {
      "name": "--download",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --download"
      ],
      "tip": [
        "Download the body to a file"
      ]
    },
    {
      "name": "--follow",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --follow"
      ],
      "tip": [
        "Follow redirects"
      ]
    },
    {
      "name": "--form",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --form"
      ],
      "tip": [
        "Serialize data items as form fields"
      ]
    },
    {
      "name": "--format-options",
      "usage": [
        "--format-options <OPTIONS>"
      ],
      "tip": [
        "Set output formatting options"
      ],
      "next": []
    },
    {
      "name": "--generate",
      "usage": [
        "--generate <KIND>"
      ],
      "tip": [
        "Generate shell completions or man pages"
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "Bash completion"
          ]
        },
        {
          "name": "fish",
          "tip": [
            "Fish completion"
          ]
        },
        {
          "name": "man",
          "tip": [
            "Man page"
          ]
        },
        {
          "name": "powershell",
          "tip": [
            "PowerShell completion"
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "Zsh completion"
          ]
        }
      ]
    },
    {
      "name": "--headers",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --headers"
      ],
      "tip": [
        "Print only the response headers"
      ]
    },
    {
      "name": "--help",
      "tip": [
        "Print help"
      ]
    },
    {
      "name": "--history-print",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --history-print <FORMAT>"
      ],
      "tip": [
        "The same as --print but applies only to intermediary requests"
      ],
      "next": []
    },
    {
      "name": "--http-version",
      "usage": [
        "--http-version <VERSION>"
      ],
      "tip": [
        "HTTP version to use"
      ],
      "next": [
        {
          "name": "1.0",
          "tip": [
            "HTTP 1.0"
          ]
        },
        {
          "name": "1.1",
          "tip": [
            "HTTP 1.1"
          ]
        },
        {
          "name": "2",
          "tip": [
            "HTTP/2"
          ]
        },
        {
          "name": "2-prior-knowledge",
          "tip": [
            "HTTP/2 prior knowledge"
          ]
        },
        {
          "name": "3-prior-knowledge",
          "tip": [
            "HTTP/3 prior knowledge"
          ]
        }
      ]
    },
    {
      "name": "--https",
      "tip": [
        "Make HTTPS requests if not specified in the URL"
      ]
    },
    {
      "name": "--ignore-netrc",
      "tip": [
        "Do not use credentials from .netrc"
      ]
    },
    {
      "name": "--ignore-stdin",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --ignore-stdin"
      ],
      "tip": [
        "Do not attempt to read stdin"
      ]
    },
    {
      "name": "--interface",
      "usage": [
        "--interface <NAME>"
      ],
      "tip": [
        "Bind to a network interface or local IP address"
      ],
      "next": []
    },
    {
      "name": "--ipv4",
      "alias": [
        "-4"
      ],
      "usage": [
        "-4, --ipv4"
      ],
      "tip": [
        "Resolve hostname to IPv4 addresses only"
      ]
    },
    {
      "name": "--ipv6",
      "alias": [
        "-6"
      ],
      "usage": [
        "-6, --ipv6"
      ],
      "tip": [
        "Resolve hostname to IPv6 addresses only"
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --json"
      ],
      "tip": [
        "Serialize data items as a JSON object (default)"
      ]
    },
    {
      "name": "--max-redirects",
      "usage": [
        "--max-redirects <NUM>"
      ],
      "tip": [
        "Number of redirects to follow"
      ],
      "next": []
    },
    {
      "name": "--meta",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --meta"
      ],
      "tip": [
        "Print only the response metadata"
      ]
    },
    {
      "name": "--multipart",
      "tip": [
        "Force a multipart/form-data request even without files"
      ]
    },
    {
      "name": "--native-tls",
      "tip": [
        "Use the system TLS library instead of rustls"
      ]
    },
    {
      "name": "--offline",
      "tip": [
        "Construct HTTP requests without sending them"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <FILE>"
      ],
      "tip": [
        "Save output to FILE instead of stdout"
      ],
      "next": []
    },
    {
      "name": "--pretty",
      "usage": [
        "--pretty <STYLE>"
      ],
      "tip": [
        "Controls output processing"
      ],
      "next": [
        {
          "name": "all",
          "tip": [
            "All formatting (default)"
          ]
        },
        {
          "name": "colors",
          "tip": [
            "Colors only"
          ]
        },
        {
          "name": "format",
          "tip": [
            "Formatting only"
          ]
        },
        {
          "name": "none",
          "tip": [
            "No formatting"
          ]
        }
      ]
    },
    {
      "name": "--print",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --print <FORMAT>"
      ],
      "tip": [
        "String specifying what the output should contain"
      ],
      "next": []
    },
    {
      "name": "--proxy",
      "usage": [
        "--proxy <PROTOCOL:URL>"
      ],
      "tip": [
        "Use a proxy for a protocol"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Do not print to stdout or stderr"
      ]
    },
    {
      "name": "--raw",
      "usage": [
        "--raw <RAW>"
      ],
      "tip": [
        "Pass raw request data without extra processing"
      ],
      "next": []
    },
    {
      "name": "--resolve",
      "usage": [
        "--resolve <HOST:ADDRESS>"
      ],
      "tip": [
        "Override DNS resolution for specific domain"
      ],
      "next": []
    },
    {
      "name": "--response-charset",
      "usage": [
        "--response-charset <ENCODING>"
      ],
      "tip": [
        "Override the response encoding"
      ],
      "next": []
    },
    {
      "name": "--response-mime",
      "usage": [
        "--response-mime <MIME>"
      ],
      "tip": [
        "Override the response mime type"
      ],
      "next": []
    },
    {
      "name": "--session",
      "usage": [
        "--session <FILE>"
      ],
      "tip": [
        "Create or reuse a session"
      ],
      "next": []
    },
    {
      "name": "--session-read-only",
      "usage": [
        "--session-read-only <FILE>"
      ],
      "tip": [
        "Create or read a session without updating it"
      ],
      "next": []
    },
    {
      "name": "--ssl",
      "usage": [
        "--ssl <VERSION>"
      ],
      "tip": [
        "Force a particular TLS version"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "Automatic (default)"
          ]
        },
        {
          "name": "tls1",
          "tip": [
            "TLS 1.0"
          ]
        },
        {
          "name": "tls1.1",
          "tip": [
            "TLS 1.1"
          ]
        },
        {
          "name": "tls1.2",
          "tip": [
            "TLS 1.2"
          ]
        },
        {
          "name": "tls1.3",
          "tip": [
            "TLS 1.3"
          ]
        }
      ]
    },
    {
      "name": "--stream",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --stream"
      ],
      "tip": [
        "Always stream the response body"
      ]
    },
    {
      "name": "--style",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --style <THEME>"
      ],
      "tip": [
        "Output coloring style"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "Automatic (default)"
          ]
        },
        {
          "name": "fruity",
          "tip": [
            "Fruity theme"
          ]
        },
        {
          "name": "monokai",
          "tip": [
            "Monokai theme"
          ]
        },
        {
          "name": "solarized",
          "tip": [
            "Solarized theme"
          ]
        }
      ]
    },
    {
      "name": "--timeout",
      "usage": [
        "--timeout <SEC>"
      ],
      "tip": [
        "Connection timeout of the request"
      ],
      "next": [
        {
          "name": "30"
        },
        {
          "name": "5"
        },
        {
          "name": "60"
        }
      ]
    },
    {
      "name": "--unix-socket",
      "usage": [
        "--unix-socket <FILE>"
      ],
      "tip": [
        "Connect using a Unix domain socket"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Print the whole request as well as the response"
      ]
    },
    {
      "name": "--verify",
      "usage": [
        "--verify <VERIFY>"
      ],
      "tip": [
        "SSL verification (no to skip, or CA bundle path)"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ]
}
