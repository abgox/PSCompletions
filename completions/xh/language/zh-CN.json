{
  "meta": {
    "url": "https://github.com/ducaale/xh",
    "description": [
      "一个友好且快速的 HTTP 请求发送工具。",
      "用 Rust 编写的 HTTPie 替代品。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "tip": [
        "跟踪重定向时使用 --follow 显示中间请求/响应。"
      ]
    },
    {
      "name": "--auth",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --auth <USER[:PASS]|TOKEN>"
      ],
      "tip": [
        "使用 USER 和 PASS（-A basic|digest）或 TOKEN（-A bearer）进行身份验证。"
      ],
      "next": []
    },
    {
      "name": "--auth-type",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --auth-type <TYPE>"
      ],
      "tip": [
        "指定身份验证机制。",
        "可能值: basic, bearer, digest"
      ],
      "next": [
        {
          "name": "basic",
          "tip": [
            "基本身份验证。"
          ]
        },
        {
          "name": "bearer",
          "tip": [
            "Bearer 令牌。"
          ]
        },
        {
          "name": "digest",
          "tip": [
            "摘要身份验证。"
          ]
        }
      ]
    },
    {
      "name": "--body",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --body"
      ],
      "tip": [
        "仅打印响应正文。",
        "--print=b 的快捷方式"
      ]
    },
    {
      "name": "--cert",
      "usage": [
        "--cert <FILE>"
      ],
      "tip": [
        "使用客户端 SSL 证书。"
      ],
      "next": []
    },
    {
      "name": "--cert-key",
      "usage": [
        "--cert-key <FILE>"
      ],
      "tip": [
        "与 --cert 一起使用的私钥文件。"
      ],
      "next": []
    },
    {
      "name": "--check-status",
      "tip": [
        "（默认）如果服务器返回错误，则以错误状态码退出。"
      ]
    },
    {
      "name": "--compress",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --compress"
      ],
      "tip": [
        "使用 Deflate 算法压缩内容。"
      ],
      "repeat": 99
    },
    {
      "name": "--continue",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --continue"
      ],
      "tip": [
        "恢复中断的下载。",
        "需要 --download 和 --output"
      ]
    },
    {
      "name": "--curl",
      "tip": [
        "打印转换为 curl 命令的输出。"
      ]
    },
    {
      "name": "--curl-long",
      "tip": [
        "使用 curl 标志的长格式。"
      ]
    },
    {
      "name": "--debug",
      "tip": [
        "打印完整的错误堆栈跟踪和调试日志消息。"
      ]
    },
    {
      "name": "--download",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --download"
      ],
      "tip": [
        "将正文下载到文件而不是打印它。"
      ]
    },
    {
      "name": "--follow",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --follow"
      ],
      "tip": [
        "跟踪重定向。"
      ]
    },
    {
      "name": "--form",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --form"
      ],
      "tip": [
        "将命令行数据项序列化为表单字段。"
      ]
    },
    {
      "name": "--format-options",
      "usage": [
        "--format-options <OPTIONS>"
      ],
      "tip": [
        "设置输出格式选项。"
      ],
      "next": []
    },
    {
      "name": "--generate",
      "usage": [
        "--generate <KIND>"
      ],
      "tip": [
        "生成 Shell 补全或手册页。"
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "Bash 补全。"
          ]
        },
        {
          "name": "fish",
          "tip": [
            "Fish 补全。"
          ]
        },
        {
          "name": "man",
          "tip": [
            "手册页。"
          ]
        },
        {
          "name": "powershell",
          "tip": [
            "PowerShell 补全。"
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "Zsh 补全。"
          ]
        }
      ]
    },
    {
      "name": "--headers",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --headers"
      ],
      "tip": [
        "仅打印响应头。",
        "--print=h 的快捷方式"
      ]
    },
    {
      "name": "--help",
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--history-print",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --history-print <FORMAT>"
      ],
      "tip": [
        "与 --print 相同，但仅适用于中间请求/响应。"
      ],
      "next": []
    },
    {
      "name": "--http-version",
      "usage": [
        "--http-version <VERSION>"
      ],
      "tip": [
        "要使用的 HTTP 版本。",
        "可能值: 1.0, 1.1, 2, 2-prior-knowledge, 3-prior-knowledge"
      ],
      "next": [
        {
          "name": "1.0",
          "tip": [
            "HTTP 1.0 "
          ]
        },
        {
          "name": "1.1",
          "tip": [
            "HTTP 1.1 "
          ]
        },
        {
          "name": "2",
          "tip": [
            "HTTP/2 "
          ]
        },
        {
          "name": "2-prior-knowledge",
          "tip": [
            "HTTP/2 先验知识。"
          ]
        },
        {
          "name": "3-prior-knowledge",
          "tip": [
            "HTTP/3 先验知识。"
          ]
        }
      ]
    },
    {
      "name": "--https",
      "tip": [
        "如果 URL 中未指定，则使用 HTTPS 请求。"
      ]
    },
    {
      "name": "--ignore-netrc",
      "tip": [
        "不使用 .netrc 中的凭据。"
      ]
    },
    {
      "name": "--ignore-stdin",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --ignore-stdin"
      ],
      "tip": [
        "不尝试读取 stdin。"
      ]
    },
    {
      "name": "--interface",
      "usage": [
        "--interface <NAME>"
      ],
      "tip": [
        "绑定到网络接口或本地 IP 地址。"
      ],
      "next": []
    },
    {
      "name": "--ipv4",
      "alias": [
        "-4"
      ],
      "usage": [
        "-4, --ipv4"
      ],
      "tip": [
        "将主机名仅解析为 ipv4 地址。"
      ]
    },
    {
      "name": "--ipv6",
      "alias": [
        "-6"
      ],
      "usage": [
        "-6, --ipv6"
      ],
      "tip": [
        "将主机名仅解析为 ipv6 地址。"
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --json"
      ],
      "tip": [
        "将命令行数据项序列化为 JSON 对象（默认）。"
      ]
    },
    {
      "name": "--max-redirects",
      "usage": [
        "--max-redirects <NUM>"
      ],
      "tip": [
        "跟踪的重定向次数。",
        "仅在 --follow 使用时才生效"
      ],
      "next": []
    },
    {
      "name": "--meta",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --meta"
      ],
      "tip": [
        "仅打印响应元数据。",
        "--print=m 的快捷方式"
      ]
    },
    {
      "name": "--multipart",
      "tip": [
        "与 --form 类似，但即使没有文件也强制使用 multipart/form-data 请求。"
      ]
    },
    {
      "name": "--native-tls",
      "tip": [
        "使用系统 TLS 库而不是 rustls。"
      ]
    },
    {
      "name": "--offline",
      "tip": [
        "构造 HTTP 请求但不将其发送到任何地方。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <FILE>"
      ],
      "tip": [
        "将输出保存到文件而不是 stdout。"
      ],
      "next": []
    },
    {
      "name": "--pretty",
      "usage": [
        "--pretty <STYLE>"
      ],
      "tip": [
        "控制输出处理。",
        "可能值: all, colors, format, none"
      ],
      "next": [
        {
          "name": "all",
          "tip": [
            "所有格式化（默认）。"
          ]
        },
        {
          "name": "colors",
          "tip": [
            "仅颜色。"
          ]
        },
        {
          "name": "format",
          "tip": [
            "仅格式化。"
          ]
        },
        {
          "name": "none",
          "tip": [
            "无格式化。"
          ]
        }
      ]
    },
    {
      "name": "--print",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --print <FORMAT>"
      ],
      "tip": [
        "指定输出应包含内容的字符串。"
      ],
      "next": []
    },
    {
      "name": "--proxy",
      "usage": [
        "--proxy <PROTOCOL:URL>"
      ],
      "tip": [
        "为指定协议使用代理。"
      ],
      "example": [
        "--proxy https:http://proxy.host:8080"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "不打印到 stdout 或 stderr。"
      ],
      "repeat": 99
    },
    {
      "name": "--raw",
      "usage": [
        "--raw <RAW>"
      ],
      "tip": [
        "传递原始请求数据而不进行额外处理。"
      ],
      "next": []
    },
    {
      "name": "--resolve",
      "usage": [
        "--resolve <HOST:ADDRESS>"
      ],
      "tip": [
        "覆盖特定域名到自定义 IP 的 DNS 解析。"
      ],
      "next": []
    },
    {
      "name": "--response-charset",
      "usage": [
        "--response-charset <ENCODING>"
      ],
      "tip": [
        "覆盖终端显示目的的响应编码。"
      ],
      "next": []
    },
    {
      "name": "--response-mime",
      "usage": [
        "--response-mime <MIME>"
      ],
      "tip": [
        "覆盖终端着色和格式化目的的响应 MIME 类型。"
      ],
      "next": []
    },
    {
      "name": "--session",
      "usage": [
        "--session <FILE>"
      ],
      "tip": [
        "创建、复用并更新会话。"
      ],
      "next": []
    },
    {
      "name": "--session-read-only",
      "usage": [
        "--session-read-only <FILE>"
      ],
      "tip": [
        "创建或读取会话，但不通过请求/响应交换更新它。"
      ],
      "next": []
    },
    {
      "name": "--ssl",
      "usage": [
        "--ssl <VERSION>"
      ],
      "tip": [
        "强制使用特定的 TLS 版本。",
        "可能值: auto, tls1, tls1.1, tls1.2, tls1.3"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "自动（默认）。"
          ]
        },
        {
          "name": "tls1",
          "tip": [
            "TLS 1.0 "
          ]
        },
        {
          "name": "tls1.1",
          "tip": [
            "TLS 1.1 "
          ]
        },
        {
          "name": "tls1.2",
          "tip": [
            "TLS 1.2 "
          ]
        },
        {
          "name": "tls1.3",
          "tip": [
            "TLS 1.3 "
          ]
        }
      ]
    },
    {
      "name": "--stream",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --stream"
      ],
      "tip": [
        "始终流式传输响应正文。"
      ]
    },
    {
      "name": "--style",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --style <THEME>"
      ],
      "tip": [
        "输出着色样式。",
        "可能值: auto, fruity, monokai, solarized"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "自动（默认）。"
          ]
        },
        {
          "name": "fruity",
          "tip": [
            "Fruity 主题。"
          ]
        },
        {
          "name": "monokai",
          "tip": [
            "Monokai 主题。"
          ]
        },
        {
          "name": "solarized",
          "tip": [
            "Solarized 主题。"
          ]
        }
      ]
    },
    {
      "name": "--timeout",
      "usage": [
        "--timeout <SEC>"
      ],
      "tip": [
        "请求的连接超时时间。"
      ],
      "next": [
        {
          "name": "30"
        },
        {
          "name": "5"
        },
        {
          "name": "60"
        }
      ]
    },
    {
      "name": "--unix-socket",
      "usage": [
        "--unix-socket <FILE>"
      ],
      "tip": [
        "使用 Unix 域套接字连接。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "打印完整的请求和响应。"
      ],
      "repeat": 99
    },
    {
      "name": "--verify",
      "usage": [
        "--verify <VERIFY>"
      ],
      "tip": [
        "如果为 \"no\"，则跳过 SSL 验证。",
        "如果是文件路径，则将其用作 CA 包。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本号。"
      ]
    }
  ]
}
