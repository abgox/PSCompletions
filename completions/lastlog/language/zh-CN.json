{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "格式化并打印最近登录日志。"
    ]
  },
  "option": [
    {
      "name": "--before",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --before <DAYS>"
      ],
      "tip": [
        "仅打印早于 DAYS 的 lastlog 记录。"
      ],
      "next": []
    },
    {
      "name": "--clear",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --clear"
      ],
      "tip": [
        "清除用户的 lastlog 记录。",
        "只能与 --user 一起使用。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--set",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --set"
      ],
      "tip": [
        "将用户的 lastlog 记录设置为当前时间。",
        "只能与 --user 一起使用。"
      ]
    },
    {
      "name": "--time",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --time <DAYS>"
      ],
      "tip": [
        "打印比 DAYS 更近的 lastlog 记录。"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <LOGIN|RANGE>"
      ],
      "tip": [
        "打印指定用户的 lastlog 记录。",
        "可以使用登录名、数字用户 ID 或 UID 范围。"
      ],
      "next": []
    },
    {
      "name": "-a",
      "tip": [
        "打印至少登录过一次的用户的记录。"
      ]
    }
  ]
}
