{
  "meta": {
    "url": "https://maven.apache.org",
    "description": [
      "Apache Maven，软件项目管理工具。"
    ]
  },
  "option": [
    {
      "name": "--show-version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --show-version"
      ],
      "tip": [
        "显示版本信息但不停止构建。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--activate-profiles",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --activate-profiles <arg>"
      ],
      "tip": [
        "要激活的配置文件的逗号分隔列表。"
      ],
      "next": []
    },
    {
      "name": "--also-make",
      "alias": [
        "-am"
      ],
      "usage": [
        "-am, --also-make"
      ],
      "tip": [
        "如果指定了项目列表，也构建列表所需的项目。"
      ]
    },
    {
      "name": "--also-make-dependents",
      "alias": [
        "-amd"
      ],
      "usage": [
        "-amd, --also-make-dependents"
      ],
      "tip": [
        "如果指定了项目列表，也构建依赖于列表中项目的项目。"
      ]
    },
    {
      "name": "--batch-mode",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --batch-mode"
      ],
      "tip": [
        "以非交互（批处理）模式运行。"
      ]
    },
    {
      "name": "--builder",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --builder <arg>"
      ],
      "tip": [
        "要使用的构建策略的 ID。"
      ],
      "next": []
    },
    {
      "name": "--check-plugin-updates",
      "alias": [
        "-cpu"
      ],
      "usage": [
        "-cpu, --check-plugin-updates"
      ],
      "tip": [
        "无效，仅保留用于向后兼容。"
      ]
    },
    {
      "name": "--color",
      "usage": [
        "--color <arg>"
      ],
      "tip": [
        "定义输出的颜色模式。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--debug",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --debug"
      ],
      "tip": [
        "生成执行调试输出。"
      ]
    },
    {
      "name": "--define",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --define <arg>"
      ],
      "tip": [
        "定义用户属性。"
      ],
      "next": []
    },
    {
      "name": "--encrypt-master-password",
      "alias": [
        "-emp"
      ],
      "usage": [
        "-emp, --encrypt-master-password <arg>"
      ],
      "tip": [
        "加密主安全密码。"
      ],
      "next": []
    },
    {
      "name": "--encrypt-password",
      "alias": [
        "-ep"
      ],
      "usage": [
        "-ep, --encrypt-password <arg>"
      ],
      "tip": [
        "加密服务器密码。"
      ],
      "next": []
    },
    {
      "name": "--errors",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --errors"
      ],
      "tip": [
        "生成执行错误消息。"
      ]
    },
    {
      "name": "--fail-at-end",
      "alias": [
        "-fae"
      ],
      "usage": [
        "-fae, --fail-at-end"
      ],
      "tip": [
        "仅在之后失败构建；允许所有未受影响的构建继续。"
      ]
    },
    {
      "name": "--fail-fast",
      "alias": [
        "-ff"
      ],
      "usage": [
        "-ff, --fail-fast"
      ],
      "tip": [
        "在反应器化构建中遇到第一个失败即停止。"
      ]
    },
    {
      "name": "--fail-never",
      "alias": [
        "-fn"
      ],
      "usage": [
        "-fn, --fail-never"
      ],
      "tip": [
        "永不失败构建，无论项目结果如何。"
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file <arg>"
      ],
      "tip": [
        "强制使用替代的 POM 文件。"
      ],
      "next": []
    },
    {
      "name": "--global-settings",
      "alias": [
        "-gs"
      ],
      "usage": [
        "-gs, --global-settings <arg>"
      ],
      "tip": [
        "全局设置文件的替代路径。"
      ],
      "next": []
    },
    {
      "name": "--global-toolchains",
      "alias": [
        "-gt"
      ],
      "usage": [
        "-gt, --global-toolchains <arg>"
      ],
      "tip": [
        "全局工具链文件的替代路径。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--ignore-transitive-repositories",
      "alias": [
        "-itr"
      ],
      "usage": [
        "-itr, --ignore-transitive-repositories"
      ],
      "tip": [
        "如果设置，Maven 将忽略传递依赖引入的远程仓库。"
      ]
    },
    {
      "name": "--lax-checksums",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --lax-checksums"
      ],
      "tip": [
        "如果校验和不匹配则发出警告。"
      ]
    },
    {
      "name": "--log-file",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --log-file <arg>"
      ],
      "tip": [
        "所有构建输出将进入的日志文件。"
      ],
      "next": []
    },
    {
      "name": "--no-plugin-registry",
      "alias": [
        "-npr"
      ],
      "usage": [
        "-npr, --no-plugin-registry"
      ],
      "tip": [
        "无效，仅保留用于向后兼容。"
      ]
    },
    {
      "name": "--no-plugin-updates",
      "alias": [
        "-npu"
      ],
      "usage": [
        "-npu, --no-plugin-updates"
      ],
      "tip": [
        "无效，仅保留用于向后兼容。"
      ]
    },
    {
      "name": "--no-snapshot-updates",
      "alias": [
        "-nsu"
      ],
      "usage": [
        "-nsu, --no-snapshot-updates"
      ],
      "tip": [
        "抑制 SNAPSHOT 更新。"
      ]
    },
    {
      "name": "--no-transfer-progress",
      "alias": [
        "-ntp"
      ],
      "usage": [
        "-ntp, --no-transfer-progress"
      ],
      "tip": [
        "下载或上传时不显示传输进度。"
      ]
    },
    {
      "name": "--non-recursive",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --non-recursive"
      ],
      "tip": [
        "不递归到子项目。"
      ]
    },
    {
      "name": "--offline",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offline"
      ],
      "tip": [
        "离线工作。"
      ]
    },
    {
      "name": "--projects",
      "alias": [
        "-pl"
      ],
      "usage": [
        "-pl, --projects <arg>"
      ],
      "tip": [
        "要构建的指定反应器项目的逗号分隔列表。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "安静输出 - 仅显示错误。"
      ]
    },
    {
      "name": "--raw-streams",
      "tip": [
        "忽略（Maven4 选项）。"
      ]
    },
    {
      "name": "--resume-from",
      "alias": [
        "-rf"
      ],
      "usage": [
        "-rf, --resume-from <arg>"
      ],
      "tip": [
        "从指定项目恢复反应器。"
      ],
      "next": []
    },
    {
      "name": "--settings",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --settings <arg>"
      ],
      "tip": [
        "用户设置文件的替代路径。"
      ],
      "next": []
    },
    {
      "name": "--strict-checksums",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --strict-checksums"
      ],
      "tip": [
        "如果校验和不匹配则构建失败。"
      ]
    },
    {
      "name": "--threads",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --threads <arg>"
      ],
      "tip": [
        "线程数，例如 4（整数）或 2C/2.5C（整数/浮点数）。"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    },
    {
      "name": "--toolchains",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --toolchains <arg>"
      ],
      "tip": [
        "用户工具链文件的替代路径。"
      ],
      "next": []
    },
    {
      "name": "--update-plugins",
      "alias": [
        "-up"
      ],
      "usage": [
        "-up, --update-plugins"
      ],
      "tip": [
        "无效，仅保留用于向后兼容。"
      ]
    },
    {
      "name": "--update-snapshots",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --update-snapshots"
      ],
      "tip": [
        "强制检查远程仓库中缺少的版本和更新的快照。"
      ]
    }
  ]
}
