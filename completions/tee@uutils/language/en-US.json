{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Copy standard input to each FILE, and also to standard output."
    ]
  },
  "option": [
    {
      "name": "--append",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --append"
      ],
      "tip": [
        "append to the given FILEs, do not overwrite"
      ]
    },
    {
      "name": "--ignore-interrupts",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-interrupts"
      ],
      "tip": [
        "ignore interrupt signals (ignored on non-Unix platforms)"
      ]
    },
    {
      "name": "--output-error",
      "usage": [
        "--output-error[=<OUTPUT-ERROR>]"
      ],
      "tip": [
        "set write error behavior"
      ],
      "next": [
        {
          "name": "exit"
        },
        {
          "name": "exit-nopipe"
        },
        {
          "name": "warn"
        },
        {
          "name": "warn-nopipe"
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "-p",
      "tip": [
        "set write error behavior (ignored on non-Unix platforms)"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
