{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将标准输入复制到每个 FILE，同时也复制到标准输出"
    ]
  },
  "option": [
    {
      "name": "--append",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --append"
      ],
      "tip": [
        "追加到给定的 FILE，不覆盖"
      ]
    },
    {
      "name": "--ignore-interrupts",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-interrupts"
      ],
      "tip": [
        "忽略中断信号（非 Unix 平台上被忽略）"
      ]
    },
    {
      "name": "--output-error",
      "usage": [
        "--output-error[=<OUTPUT-ERROR>]"
      ],
      "tip": [
        "设置写错误行为"
      ],
      "next": [
        {
          "name": "exit"
        },
        {
          "name": "exit-nopipe"
        },
        {
          "name": "warn"
        },
        {
          "name": "warn-nopipe"
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-p",
      "tip": [
        "设置写错误行为（非 Unix 平台上被忽略）"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
