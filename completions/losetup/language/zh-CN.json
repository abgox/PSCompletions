{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "设置和控制 loop 设备。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "列出所有已使用的设备。"
      ]
    },
    {
      "name": "--associated",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --associated <file>"
      ],
      "tip": [
        "列出与 FILE 关联的所有设备。"
      ],
      "next": []
    },
    {
      "name": "--detach",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --detach <loopdev>..."
      ],
      "tip": [
        "分离一个或多个设备。"
      ],
      "next": []
    },
    {
      "name": "--detach-all",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --detach-all"
      ],
      "tip": [
        "分离所有已使用的设备。"
      ]
    },
    {
      "name": "--direct-io",
      "usage": [
        "--direct-io[=<on|off>]"
      ],
      "tip": [
        "以 O_DIRECT 打开后备文件。",
        "可能值: on, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "on"
        }
      ]
    },
    {
      "name": "--find",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --find"
      ],
      "tip": [
        "查找第一个未使用的设备。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "使用 JSON --list 输出格式。"
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "列出所有或指定设备的信息（默认）。"
      ]
    },
    {
      "name": "--loop-ref",
      "usage": [
        "--loop-ref <string>"
      ],
      "tip": [
        "loop 设备引用。"
      ],
      "next": []
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "不为 --list 输出打印标题。"
      ]
    },
    {
      "name": "--nooverlap",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --nooverlap"
      ],
      "tip": [
        "避免设备之间可能发生的冲突。"
      ]
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <num>"
      ],
      "tip": [
        "从文件中的偏移 <num> 开始。"
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --output <cols>"
      ],
      "tip": [
        "指定 --list 输出的列。"
      ],
      "separator": ",",
      "next": [
        {
          "name": "AUTOCLEAR",
          "tip": [
            "已设置自动清除标志。"
          ]
        },
        {
          "name": "BACK-FILE",
          "tip": [
            "设备后备文件。"
          ]
        },
        {
          "name": "BACK-INO",
          "tip": [
            "后备文件 inode 号。"
          ]
        },
        {
          "name": "BACK-MAJ",
          "tip": [
            "后备文件主设备号。"
          ]
        },
        {
          "name": "BACK-MAJ:MIN",
          "tip": [
            "后备文件 major:minor 设备号。"
          ]
        },
        {
          "name": "BACK-MIN",
          "tip": [
            "后备文件次设备号。"
          ]
        },
        {
          "name": "DIO",
          "tip": [
            "使用 direct-io 访问后备文件。"
          ]
        },
        {
          "name": "LOG-SEC",
          "tip": [
            "逻辑扇区大小（字节）。"
          ]
        },
        {
          "name": "MAJ",
          "tip": [
            "loop 设备主设备号。"
          ]
        },
        {
          "name": "MAJ:MIN",
          "tip": [
            "loop 设备 major:minor 号。"
          ]
        },
        {
          "name": "MIN",
          "tip": [
            "loop 设备次设备号。"
          ]
        },
        {
          "name": "NAME",
          "tip": [
            "loop 设备名称。"
          ]
        },
        {
          "name": "OFFSET",
          "tip": [
            "从起始位置的偏移。"
          ]
        },
        {
          "name": "PARTSCAN",
          "tip": [
            "已设置分区扫描标志。"
          ]
        },
        {
          "name": "REF",
          "tip": [
            "loop 设备引用字符串。"
          ]
        },
        {
          "name": "RO",
          "tip": [
            "只读设备。"
          ]
        },
        {
          "name": "SIZELIMIT",
          "tip": [
            "文件的字节大小限制。"
          ]
        }
      ]
    },
    {
      "name": "--output-all",
      "tip": [
        "输出所有列。"
      ]
    },
    {
      "name": "--partscan",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --partscan"
      ],
      "tip": [
        "创建分区 loop 设备。"
      ]
    },
    {
      "name": "--raw",
      "tip": [
        "使用原始 --list 输出格式。"
      ]
    },
    {
      "name": "--read-only",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --read-only"
      ],
      "tip": [
        "设置只读 loop 设备。"
      ]
    },
    {
      "name": "--sector-size",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --sector-size <num>"
      ],
      "tip": [
        "将逻辑扇区大小设置为 <num>。"
      ],
      "next": []
    },
    {
      "name": "--set-capacity",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --set-capacity <loopdev>"
      ],
      "tip": [
        "调整设备大小。"
      ],
      "next": []
    },
    {
      "name": "--show",
      "tip": [
        "设置后打印设备名（与 -f 一起使用）。"
      ]
    },
    {
      "name": "--sizelimit",
      "usage": [
        "--sizelimit <num>"
      ],
      "tip": [
        "设备限制为文件的 <num> 字节。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "详细模式。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
