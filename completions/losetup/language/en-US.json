{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Set up and control loop devices."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "List all used devices."
      ]
    },
    {
      "name": "--associated",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --associated <file>"
      ],
      "tip": [
        "List all devices associated with FILE."
      ],
      "next": []
    },
    {
      "name": "--detach",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --detach <loopdev>..."
      ],
      "tip": [
        "Detach one or more devices."
      ],
      "next": []
    },
    {
      "name": "--detach-all",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --detach-all"
      ],
      "tip": [
        "Detach all used devices."
      ]
    },
    {
      "name": "--direct-io",
      "usage": [
        "--direct-io[=<on|off>]"
      ],
      "tip": [
        "Open backing file with O_DIRECT.",
        "Possible values: on, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "on"
        }
      ]
    },
    {
      "name": "--find",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --find"
      ],
      "tip": [
        "Find first unused device."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "Use JSON --list output format."
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "List info about all or specified (default)."
      ]
    },
    {
      "name": "--loop-ref",
      "usage": [
        "--loop-ref <string>"
      ],
      "tip": [
        "Loop device reference."
      ],
      "next": []
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "Don't print headings for --list output."
      ]
    },
    {
      "name": "--nooverlap",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --nooverlap"
      ],
      "tip": [
        "Avoid possible conflict between devices."
      ]
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <num>"
      ],
      "tip": [
        "Start at offset <num> into file."
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --output <cols>"
      ],
      "tip": [
        "Specify columns to output for --list."
      ],
      "separator": ",",
      "next": [
        {
          "name": "AUTOCLEAR",
          "tip": [
            "Autoclear flag set."
          ]
        },
        {
          "name": "BACK-FILE",
          "tip": [
            "Device backing file."
          ]
        },
        {
          "name": "BACK-INO",
          "tip": [
            "Backing file inode number."
          ]
        },
        {
          "name": "BACK-MAJ",
          "tip": [
            "Backing file major device number."
          ]
        },
        {
          "name": "BACK-MAJ:MIN",
          "tip": [
            "Backing file major:minor device number."
          ]
        },
        {
          "name": "BACK-MIN",
          "tip": [
            "Backing file minor device number."
          ]
        },
        {
          "name": "DIO",
          "tip": [
            "Access backing file with direct-io."
          ]
        },
        {
          "name": "LOG-SEC",
          "tip": [
            "Logical sector size in bytes."
          ]
        },
        {
          "name": "MAJ",
          "tip": [
            "Loop device major number."
          ]
        },
        {
          "name": "MAJ:MIN",
          "tip": [
            "Loop device major:minor number."
          ]
        },
        {
          "name": "MIN",
          "tip": [
            "Loop device minor number."
          ]
        },
        {
          "name": "NAME",
          "tip": [
            "Loop device name."
          ]
        },
        {
          "name": "OFFSET",
          "tip": [
            "Offset from the beginning."
          ]
        },
        {
          "name": "PARTSCAN",
          "tip": [
            "Partscan flag set."
          ]
        },
        {
          "name": "REF",
          "tip": [
            "Loop device reference string."
          ]
        },
        {
          "name": "RO",
          "tip": [
            "Read-only device."
          ]
        },
        {
          "name": "SIZELIMIT",
          "tip": [
            "Size limit of the file in bytes."
          ]
        }
      ]
    },
    {
      "name": "--output-all",
      "tip": [
        "Output all columns."
      ]
    },
    {
      "name": "--partscan",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --partscan"
      ],
      "tip": [
        "Create a partitioned loop device."
      ]
    },
    {
      "name": "--raw",
      "tip": [
        "Use raw --list output format."
      ]
    },
    {
      "name": "--read-only",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --read-only"
      ],
      "tip": [
        "Set up a read-only loop device."
      ]
    },
    {
      "name": "--sector-size",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --sector-size <num>"
      ],
      "tip": [
        "Set the logical sector size to <num>."
      ],
      "next": []
    },
    {
      "name": "--set-capacity",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --set-capacity <loopdev>"
      ],
      "tip": [
        "Resize the device."
      ],
      "next": []
    },
    {
      "name": "--show",
      "tip": [
        "Print device name after setup (with -f)."
      ]
    },
    {
      "name": "--sizelimit",
      "usage": [
        "--sizelimit <num>"
      ],
      "tip": [
        "Device is limited to <num> bytes of the file."
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Verbose mode."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
