{
  "meta": {
    "url": "https://gitlab.com/gitlab-org/cli",
    "description": [
      "An open source GitLab CLI tool that brings GitLab to your command line."
    ]
  },
  "next": [
    {
      "name": "alias",
      "usage": [
        "alias <set|list|delete>"
      ],
      "tip": [
        "Create, list, and delete aliases."
      ],
      "next": [
        {
          "name": "delete",
          "usage": [
            "delete <alias-name>"
          ],
          "tip": [
            "Delete an alias."
          ]
        },
        {
          "name": "list",
          "tip": [
            "List aliases."
          ]
        },
        {
          "name": "set",
          "usage": [
            "set <alias-name> '<command>'"
          ],
          "tip": [
            "Set an alias for a longer command."
          ]
        }
      ]
    },
    {
      "name": "api",
      "usage": [
        "api <endpoint>"
      ],
      "tip": [
        "Make an authenticated request to the GitLab API."
      ],
      "option": [
        {
          "name": "--field",
          "alias": [
            "-F"
          ],
          "usage": [
            "-F, --field <key=value>"
          ],
          "tip": [
            "Add a parameter of inferred type."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--form",
          "usage": [
            "--form <key=value>"
          ],
          "tip": [
            "Add a multipart form field."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--header",
          "alias": [
            "-H"
          ],
          "usage": [
            "-H, --header <header>"
          ],
          "tip": [
            "Add an additional HTTP request header."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--hostname",
          "usage": [
            "--hostname <hostname>"
          ],
          "tip": [
            "The GitLab hostname for the request."
          ],
          "next": []
        },
        {
          "name": "--include",
          "alias": [
            "-i"
          ],
          "usage": [
            "-i, --include"
          ],
          "tip": [
            "Include HTTP response headers in the output."
          ]
        },
        {
          "name": "--input",
          "usage": [
            "--input <file>"
          ],
          "tip": [
            "The file to use as the body for the HTTP request."
          ],
          "next": []
        },
        {
          "name": "--method",
          "alias": [
            "-X"
          ],
          "usage": [
            "-X, --method <method>"
          ],
          "tip": [
            "The HTTP method for the request."
          ],
          "next": [
            {
              "name": "DELETE",
              "tip": [
                "DELETE request."
              ]
            },
            {
              "name": "GET",
              "tip": [
                "GET request."
              ]
            },
            {
              "name": "PATCH",
              "tip": [
                "PATCH request."
              ]
            },
            {
              "name": "POST",
              "tip": [
                "POST request."
              ]
            },
            {
              "name": "PUT",
              "tip": [
                "PUT request."
              ]
            }
          ]
        },
        {
          "name": "--output",
          "usage": [
            "--output <json|ndjson>"
          ],
          "tip": [
            "Format output."
          ],
          "next": [
            {
              "name": "json",
              "tip": [
                "Pretty-printed JSON."
              ]
            },
            {
              "name": "ndjson",
              "tip": [
                "Newline-delimited JSON."
              ]
            }
          ]
        },
        {
          "name": "--paginate",
          "tip": [
            "Make additional HTTP requests to fetch all pages."
          ]
        },
        {
          "name": "--raw-field",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --raw-field <key=value>"
          ],
          "tip": [
            "Add a string parameter."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--silent",
          "tip": [
            "Do not print the response body."
          ]
        }
      ]
