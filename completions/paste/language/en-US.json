{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Write sequentially corresponding lines from each FILE to stdout."
    ]
  },
  "option": [
    {
      "name": "--delimiters",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delimiters <LIST>"
      ],
      "tip": [
        "reuse characters from LIST instead of TABs"
      ],
      "next": []
    },
    {
      "name": "--serial",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --serial"
      ],
      "tip": [
        "paste one file at a time instead of in parallel"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "line delimiter is NUL, not newline"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show the help."
      ]
    }
  ]
}
