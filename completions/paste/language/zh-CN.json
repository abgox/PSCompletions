{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将每个文件的行按顺序对应输出到标准输出。"
    ]
  },
  "option": [
    {
      "name": "--delimiters",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delimiters <LIST>"
      ],
      "tip": [
        "使用 LIST 中的字符替代 TAB 作为分隔符"
      ],
      "next": []
    },
    {
      "name": "--serial",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --serial"
      ],
      "tip": [
        "逐个处理文件而非并行处理"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "以 NUL 而非换行符作为行分隔符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
