{
  "meta": {
    "url": "https://k9scli.io/",
    "description": [
      "K9s is a terminal based UI to interact with your Kubernetes clusters.",
      "It eases navigating, observing and managing your deployed applications."
    ]
  },
  "next": [
    {
      "name": "completion",
      "usage": [
        "completion [bash|fish|powershell|zsh]"
      ],
      "tip": [
        "Generate the autocompletion script for the specified shell."
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "Generate the autocompletion script for bash."
          ]
        },
        {
          "name": "fish",
          "tip": [
            "Generate the autocompletion script for fish."
          ]
        },
        {
          "name": "powershell",
          "tip": [
            "Generate the autocompletion script for powershell."
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "Generate the autocompletion script for zsh."
          ]
        }
      ]
    },
    {
      "name": "info",
      "tip": [
        "List K9s configurations info."
      ]
    },
    {
      "name": "version",
      "usage": [
        "version [-s|--short]"
      ],
      "tip": [
        "Print version/build info."
      ],
      "option": [
        {
          "name": "--short",
          "alias": [
            "-s"
          ],
          "usage": [
            "-s, --short"
          ],
          "tip": [
            "Print K9s version info in short format."
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--all-namespaces",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --all-namespaces"
      ],
      "tip": [
        "Launch K9s in all namespaces."
      ]
    },
    {
      "name": "--as",
      "usage": [
        "--as <username>"
      ],
      "tip": [
        "Username to impersonate for the operation."
      ],
      "next": [
        {
          "name": "admin",
          "tip": [
            "Admin user."
          ]
        }
      ]
    },
    {
      "name": "--as-group",
      "usage": [
        "--as-group <group>"
      ],
      "tip": [
        "Group to impersonate for the operation.",
        "Can be specified multiple times."
      ],
      "repeat": 99,
      "next": [
        {
          "name": "system:masters",
          "tip": [
            "Cluster admin group."
          ]
        }
      ]
    },
    {
      "name": "--certificate-authority",
      "usage": [
        "--certificate-authority <file>"
      ],
      "tip": [
        "Path to a cert file for the certificate authority."
      ],
      "next": [
        {
          "name": "ca.crt",
          "tip": [
            "CA certificate file."
          ]
        }
      ]
    },
    {
      "name": "--client-certificate",
      "usage": [
        "--client-certificate <file>"
      ],
      "tip": [
        "Path to a client certificate file for TLS."
      ],
      "next": [
        {
          "name": "client.crt",
          "tip": [
            "Client certificate file."
          ]
        }
      ]
    },
    {
      "name": "--client-key",
      "usage": [
        "--client-key <file>"
      ],
      "tip": [
        "Path to a client key file for TLS."
      ],
      "next": [
        {
          "name": "client.key",
          "tip": [
            "Client key file."
          ]
        }
      ]
    },
    {
      "name": "--cluster",
      "usage": [
        "--cluster <name>"
      ],
      "tip": [
        "The name of the kubeconfig cluster to use."
      ],
      "next": [
        {
          "name": "cluster-name",
          "tip": [
            "Kubeconfig cluster name."
          ]
        }
      ]
    },
    {
      "name": "--command",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --command <resource>"
      ],
      "tip": [
        "Override the default resource to load when the application launches."
      ],
      "next": [
        {
          "name": "deployments",
          "tip": [
            "Load the deployments resource."
          ]
        },
        {
          "name": "pods",
          "tip": [
            "Load the pods resource."
          ]
        },
        {
          "name": "services",
          "tip": [
            "Load the services resource."
          ]
        }
      ]
    },
    {
      "name": "--context",
      "usage": [
        "--context <name>"
      ],
      "tip": [
        "The name of the kubeconfig context to use."
      ],
      "next": [
        {
          "name": "default",
          "tip": [
            "Default kubeconfig context."
          ]
        }
      ]
    },
    {
      "name": "--crumbsless",
      "tip": [
        "Turn K9s crumbs off."
      ]
    },
    {
      "name": "--headless",
      "tip": [
        "Turn K9s header off."
      ]
    },
    {
      "name": "--insecure-skip-tls-verify",
      "tip": [
        "Skip validation of the server's CA certificate."
      ]
    },
    {
      "name": "--invert",
      "tip": [
        "Invert the default color scheme (dark to light, light to dark)."
      ]
    },
    {
      "name": "--kubeconfig",
      "usage": [
        "--kubeconfig <file>"
      ],
      "tip": [
        "Path to the kubeconfig file to use for CLI requests."
      ],
      "next": [
        {
          "name": "~/.kube/config",
          "tip": [
            "Default kubeconfig location."
          ]
        }
      ]
    },
    {
      "name": "--logFile",
      "usage": [
        "--logFile <file>"
      ],
      "tip": [
        "Specify the log file."
      ],
      "next": [
        {
          "name": "k9s.log",
          "tip": [
            "Log file name."
          ]
        }
      ]
    },
    {
      "name": "--logLevel",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --logLevel <level>"
      ],
      "tip": [
        "Specify a log level."
      ],
      "next": [
        {
          "name": "debug",
          "tip": [
            "Log debug messages and above."
          ]
        },
        {
          "name": "error",
          "tip": [
            "Only log errors."
          ]
        },
        {
          "name": "info",
          "tip": [
            "Log informational messages, warnings and errors."
          ]
        },
        {
          "name": "warn",
          "tip": [
            "Log warnings and errors."
          ]
        }
      ]
    },
    {
      "name": "--logoless",
      "tip": [
        "Turn K9s logo off."
      ]
    },
    {
      "name": "--namespace",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --namespace <namespace>"
      ],
      "tip": [
        "Set the namespace scope for this CLI request."
      ],
      "next": [
        {
          "name": "default",
          "tip": [
            "Default namespace."
          ]
        },
        {
          "name": "kube-public",
          "tip": [
            "Publicly readable namespace."
          ]
        },
        {
          "name": "kube-system",
          "tip": [
            "Kubernetes system namespace."
          ]
        }
      ]
    },
    {
      "name": "--readonly",
      "tip": [
        "Set readOnly mode by overriding the readOnly configuration setting."
      ]
    },
    {
      "name": "--refresh",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --refresh <sec>"
      ],
      "tip": [
        "Specify the default refresh rate as a float (sec)."
      ],
      "next": [
        {
          "name": "10",
          "tip": [
            "10 seconds."
          ]
        },
        {
          "name": "2",
          "tip": [
            "Default refresh rate."
          ]
        },
        {
          "name": "5",
          "tip": [
            "5 seconds."
          ]
        }
      ]
    },
    {
      "name": "--request-timeout",
      "usage": [
        "--request-timeout <duration>"
      ],
      "tip": [
        "The length of time to wait before giving up on a single server request."
      ],
      "next": [
        {
          "name": "10s",
          "tip": [
            "10 seconds."
          ]
        },
        {
          "name": "1m",
          "tip": [
            "1 minute."
          ]
        }
      ]
    },
    {
      "name": "--screen-dump-dir",
      "usage": [
        "--screen-dump-dir <dir>"
      ],
      "tip": [
        "Set a path to a dir for screen dumps."
      ],
      "next": [
        {
          "name": "screen-dumps",
          "tip": [
            "Directory for screen dumps."
          ]
        }
      ]
    },
    {
      "name": "--splashless",
      "tip": [
        "Turn K9s splash screen off."
      ]
    },
    {
      "name": "--token",
      "usage": [
        "--token <token>"
      ],
      "tip": [
        "Bearer token for authentication to the API server."
      ],
      "next": [
        {
          "name": "k9s-bearer-token",
          "tip": [
            "Example bearer token."
          ]
        }
      ]
    },
    {
      "name": "--user",
      "usage": [
        "--user <name>"
      ],
      "tip": [
        "The name of the kubeconfig user to use."
      ],
      "next": [
        {
          "name": "user-name",
          "tip": [
            "Kubeconfig user name."
          ]
        }
      ]
    },
    {
      "name": "--write",
      "tip": [
        "Set write mode by overriding the readOnly configuration setting."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show help."
      ]
    }
  ]
}
