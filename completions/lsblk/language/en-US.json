{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "List information about block devices."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Print all devices."
      ]
    },
    {
      "name": "--ascii",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ascii"
      ],
      "tip": [
        "Use ascii characters only."
      ]
    },
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "Print SIZE in bytes instead of a human-readable format."
      ]
    },
    {
      "name": "--ct",
      "usage": [
        "--ct <name>[:<param>[:<func>]]"
      ],
      "tip": [
        "Define a custom counter."
      ],
      "next": []
    },
    {
      "name": "--ct-filter",
      "usage": [
        "--ct-filter <expr>"
      ],
      "tip": [
        "Restrict the next counter."
      ],
      "next": []
    },
    {
      "name": "--dedup",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --dedup <column>"
      ],
      "tip": [
        "De-duplicate output by COLUMN."
      ],
      "next": []
    },
    {
      "name": "--discard",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --discard"
      ],
      "tip": [
        "Print discard capabilities."
      ]
    },
    {
      "name": "--exclude",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exclude <list>"
      ],
      "tip": [
        "Exclude devices by major number (default: RAM disks)."
      ],
      "next": []
    },
    {
      "name": "--filter",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --filter <expr>"
      ],
      "tip": [
        "Print only lines matching the expression."
      ],
      "next": []
    },
    {
      "name": "--fs",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fs"
      ],
      "tip": [
        "Output info about filesystems."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--highlight",
      "usage": [
        "--highlight <expr>"
      ],
      "tip": [
        "Colorize lines matching the expression."
      ],
      "next": []
    },
    {
      "name": "--include",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --include <list>"
      ],
      "tip": [
        "Show only devices with specified major numbers."
      ],
      "next": []
    },
    {
      "name": "--inverse",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --inverse"
      ],
      "tip": [
        "Inverse dependencies."
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "Use JSON output format."
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "Use list format output."
      ]
    },
    {
      "name": "--list-columns",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --list-columns"
      ],
      "tip": [
        "List the available columns."
      ]
    },
    {
      "name": "--merge",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --merge"
      ],
      "tip": [
        "Group parents of sub-trees (RAIDs, Multi-path)."
      ]
    },
    {
      "name": "--nodeps",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --nodeps"
      ],
      "tip": [
        "Don't print slaves or holders."
      ]
    },
    {
      "name": "--noempty",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --noempty"
      ],
      "tip": [
        "Don't print empty devices."
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "Don't print headings."
      ]
    },
    {
      "name": "--nvme",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --nvme"
      ],
      "tip": [
        "Output info about NVMe devices."
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "Output columns (see --list-columns)."
      ],
      "next": []
    },
    {
      "name": "--output-all",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --output-all"
      ],
      "tip": [
        "Output all columns."
      ]
    },
    {
      "name": "--pairs",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pairs"
      ],
      "tip": [
        "Use key=\"value\" output format."
      ]
    },
    {
      "name": "--paths",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --paths"
      ],
      "tip": [
        "Print complete device path."
      ]
    },
    {
      "name": "--perms",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --perms"
      ],
      "tip": [
        "Output info about permissions."
      ]
    },
    {
      "name": "--properties-by",
      "usage": [
        "--properties-by <list>"
      ],
      "tip": [
        "Methods used to gather data (default: file,udev,blkid)."
      ],
      "next": []
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "Use raw output format."
      ]
    },
    {
      "name": "--scsi",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --scsi"
      ],
      "tip": [
        "Output info about SCSI devices."
      ]
    },
    {
      "name": "--shell",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --shell"
      ],
      "tip": [
        "Use column names that can be used as shell variables."
      ]
    },
    {
      "name": "--sort",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --sort <column>"
      ],
      "tip": [
        "Sort output by COLUMN."
      ],
      "next": []
    },
    {
      "name": "--sysroot",
      "usage": [
        "--sysroot <dir>"
      ],
      "tip": [
        "Use specified directory as system root."
      ],
      "next": []
    },
    {
      "name": "--topology",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --topology"
      ],
      "tip": [
        "Output info about topology."
      ]
    },
    {
      "name": "--tree",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --tree[=<column>]"
      ],
      "tip": [
        "Use tree format output."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--virtio",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --virtio"
      ],
      "tip": [
        "Output info about virtio devices."
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <num>"
      ],
      "tip": [
        "Specifies output width as number of characters."
      ],
      "next": []
    },
    {
      "name": "--zoned",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zoned"
      ],
      "tip": [
        "Print zone related information."
      ]
    }
  ]
}
