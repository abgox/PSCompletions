{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "列出块设备信息。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "打印所有设备。"
      ]
    },
    {
      "name": "--ascii",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ascii"
      ],
      "tip": [
        "仅使用 ASCII 字符。"
      ]
    },
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "以字节而不是人类可读格式打印 SIZE。"
      ]
    },
    {
      "name": "--ct",
      "usage": [
        "--ct <name>[:<param>[:<func>]]"
      ],
      "tip": [
        "定义自定义计数器。"
      ],
      "next": []
    },
    {
      "name": "--ct-filter",
      "usage": [
        "--ct-filter <expr>"
      ],
      "tip": [
        "限制下一个计数器。"
      ],
      "next": []
    },
    {
      "name": "--dedup",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --dedup <column>"
      ],
      "tip": [
        "按 COLUMN 去重输出。"
      ],
      "next": []
    },
    {
      "name": "--discard",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --discard"
      ],
      "tip": [
        "打印丢弃能力。"
      ]
    },
    {
      "name": "--exclude",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exclude <list>"
      ],
      "tip": [
        "按主设备号排除设备（默认: RAM 磁盘）。"
      ],
      "next": []
    },
    {
      "name": "--filter",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --filter <expr>"
      ],
      "tip": [
        "仅打印匹配表达式的行。"
      ],
      "next": []
    },
    {
      "name": "--fs",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fs"
      ],
      "tip": [
        "输出文件系统信息。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--highlight",
      "usage": [
        "--highlight <expr>"
      ],
      "tip": [
        "为匹配表达式的行着色。"
      ],
      "next": []
    },
    {
      "name": "--include",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --include <list>"
      ],
      "tip": [
        "仅显示指定主设备号的设备。"
      ],
      "next": []
    },
    {
      "name": "--inverse",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --inverse"
      ],
      "tip": [
        "反转依赖关系。"
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "使用 JSON 输出格式。"
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "使用列表格式输出。"
      ]
    },
    {
      "name": "--list-columns",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --list-columns"
      ],
      "tip": [
        "列出可用列。"
      ]
    },
    {
      "name": "--merge",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --merge"
      ],
      "tip": [
        "对子树的父级进行分组（RAID、多路径）。"
      ]
    },
    {
      "name": "--nodeps",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --nodeps"
      ],
      "tip": [
        "不打印从设备或持有者。"
      ]
    },
    {
      "name": "--noempty",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --noempty"
      ],
      "tip": [
        "不打印空设备。"
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "不打印标题。"
      ]
    },
    {
      "name": "--nvme",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --nvme"
      ],
      "tip": [
        "输出 NVMe 设备信息。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "输出列（参见 --list-columns）。"
      ],
      "next": []
    },
    {
      "name": "--output-all",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --output-all"
      ],
      "tip": [
        "输出所有列。"
      ]
    },
    {
      "name": "--pairs",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pairs"
      ],
      "tip": [
        "使用 key=\"value\" 输出格式。"
      ]
    },
    {
      "name": "--paths",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --paths"
      ],
      "tip": [
        "打印完整的设备路径。"
      ]
    },
    {
      "name": "--perms",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --perms"
      ],
      "tip": [
        "输出权限信息。"
      ]
    },
    {
      "name": "--properties-by",
      "usage": [
        "--properties-by <list>"
      ],
      "tip": [
        "用于收集数据的方法（默认: file,udev,blkid）。"
      ],
      "next": []
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "使用原始输出格式。"
      ]
    },
    {
      "name": "--scsi",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --scsi"
      ],
      "tip": [
        "输出 SCSI 设备信息。"
      ]
    },
    {
      "name": "--shell",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --shell"
      ],
      "tip": [
        "使用可用作 shell 变量的列名。"
      ]
    },
    {
      "name": "--sort",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --sort <column>"
      ],
      "tip": [
        "按 COLUMN 排序输出。"
      ],
      "next": []
    },
    {
      "name": "--sysroot",
      "usage": [
        "--sysroot <dir>"
      ],
      "tip": [
        "使用指定目录作为系统根目录。"
      ],
      "next": []
    },
    {
      "name": "--topology",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --topology"
      ],
      "tip": [
        "输出拓扑信息。"
      ]
    },
    {
      "name": "--tree",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --tree[=<column>]"
      ],
      "tip": [
        "使用树形格式输出。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--virtio",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --virtio"
      ],
      "tip": [
        "输出 virtio 设备信息。"
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <num>"
      ],
      "tip": [
        "以字符数指定输出宽度。"
      ],
      "next": []
    },
    {
      "name": "--zoned",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zoned"
      ],
      "tip": [
        "打印区域相关信息。"
      ]
    }
  ]
}
