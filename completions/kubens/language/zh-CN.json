{
  "meta": {
    "url": "https://github.com/ahmetb/kubens",
    "description": [
      "在不同 Kubernetes 命名空间之间切换。"
    ]
  },
  "option": [
    {
      "name": "--current",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --current"
      ],
      "tip": [
        "显示当前命名空间。"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "强制更改当前上下文的活跃命名空间（即使它不存在）。"
      ]
    },
    {
      "name": "--unset",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unset"
      ],
      "tip": [
        "取消设置命名空间选择（设置为 'default'）。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此消息。"
      ]
    }
  ]
}
