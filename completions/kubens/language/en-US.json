{
  "meta": {
    "url": "https://github.com/ahmetb/kubens",
    "description": [
      "Switch between Kubernetes namespaces."
    ]
  },
  "option": [
    {
      "name": "--current",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --current"
      ],
      "tip": [
        "Show the current namespace."
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "Force change the active namespace of current context (even if it doesn't exist)."
      ]
    },
    {
      "name": "--unset",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unset"
      ],
      "tip": [
        "Unset the namespace choice (set to 'default')."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this message."
      ]
    }
  ]
}
