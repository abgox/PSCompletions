{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "Create a new group."
    ]
  },
  "option": [
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "Exit successfully if the group already exists, and cancel -g if the GID is already used."
      ]
    },
    {
      "name": "--gid",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --gid <GID>"
      ],
      "tip": [
        "Use GID for the new group."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display help message and exit."
      ]
    },
    {
      "name": "--key",
      "alias": [
        "-K"
      ],
      "usage": [
        "-K, --key <KEY=VALUE>"
      ],
      "tip": [
        "Override /etc/login.defs defaults."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--non-unique",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --non-unique"
      ],
      "tip": [
        "Allow to create groups with duplicate (non-unique) GID."
      ]
    },
    {
      "name": "--password",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --password <PASSWORD>"
      ],
      "tip": [
        "Use this encrypted password for the new group."
      ],
      "next": []
    },
    {
      "name": "--prefix",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --prefix <PREFIX_DIR>"
      ],
      "tip": [
        "Apply changes to configuration files under the root filesystem found under PREFIX_DIR.",
        "This option does not chroot and is intended for preparing a cross-compilation target."
      ],
      "next": []
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "Apply changes in the CHROOT_DIR directory and use the configuration files from the CHROOT_DIR directory.",
        "Only absolute paths are supported."
      ],
      "next": []
    },
    {
      "name": "--system",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --system"
      ],
      "tip": [
        "Create a system account."
      ]
    },
    {
      "name": "--users",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --users <USERS>"
      ],
      "tip": [
        "List of user members of this group."
      ],
      "separator": ",",
      "next": []
    }
  ]
}
