{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "创建一个新组。"
    ]
  },
  "option": [
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "如果组已存在则成功退出，并在 GID 已被使用时取消 -g。"
      ]
    },
    {
      "name": "--gid",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --gid <GID>"
      ],
      "tip": [
        "为新组使用 GID。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--key",
      "alias": [
        "-K"
      ],
      "usage": [
        "-K, --key <KEY=VALUE>"
      ],
      "tip": [
        "覆盖 /etc/login.defs 的默认值。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--non-unique",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --non-unique"
      ],
      "tip": [
        "允许创建具有重复（非唯一）GID 的组。"
      ]
    },
    {
      "name": "--password",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --password <PASSWORD>"
      ],
      "tip": [
        "为新组使用此加密密码。"
      ],
      "next": []
    },
    {
      "name": "--prefix",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --prefix <PREFIX_DIR>"
      ],
      "tip": [
        "在 PREFIX_DIR 下的根文件系统中应用对配置文件的更改。",
        "该选项不会 chroot，用于准备交叉编译目标。"
      ],
      "next": []
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--system",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --system"
      ],
      "tip": [
        "创建一个系统账户。"
      ]
    },
    {
      "name": "--users",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --users <USERS>"
      ],
      "tip": [
        "该组的用户成员列表。"
      ],
      "separator": ",",
      "next": []
    }
  ]
}
