{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "创建各种 IPC 资源。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--mode",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --mode <mode>"
      ],
      "tip": [
        "资源的权限（默认 0644）。"
      ],
      "next": []
    },
    {
      "name": "--name",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --name <name>"
      ],
      "tip": [
        "POSIX 资源的名称。"
      ],
      "next": []
    },
    {
      "name": "--posix-mqueue",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --posix-mqueue"
      ],
      "tip": [
        "创建 POSIX 消息队列。"
      ]
    },
    {
      "name": "--posix-semaphore",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --posix-semaphore"
      ],
      "tip": [
        "创建 POSIX 信号量。"
      ]
    },
    {
      "name": "--posix-shmem",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --posix-shmem <size>"
      ],
      "tip": [
        "创建大小为 <size> 的 POSIX 共享内存段。"
      ],
      "next": []
    },
    {
      "name": "--queue",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --queue"
      ],
      "tip": [
        "创建消息队列。"
      ]
    },
    {
      "name": "--semaphore",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --semaphore <number>"
      ],
      "tip": [
        "创建包含 <number> 个元素的信号量数组。"
      ],
      "next": []
    },
    {
      "name": "--shmem",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --shmem <size>"
      ],
      "tip": [
        "创建大小为 <size> 的共享内存段。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
