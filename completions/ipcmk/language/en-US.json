{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Create various IPC resources."
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--mode",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --mode <mode>"
      ],
      "tip": [
        "Permission for the resource (default is 0644)."
      ],
      "next": []
    },
    {
      "name": "--name",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --name <name>"
      ],
      "tip": [
        "Name of the POSIX resource."
      ],
      "next": []
    },
    {
      "name": "--posix-mqueue",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --posix-mqueue"
      ],
      "tip": [
        "Create POSIX message queue."
      ]
    },
    {
      "name": "--posix-semaphore",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --posix-semaphore"
      ],
      "tip": [
        "Create POSIX semaphore."
      ]
    },
    {
      "name": "--posix-shmem",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --posix-shmem <size>"
      ],
      "tip": [
        "Create POSIX shared memory segment of size <size>."
      ],
      "next": []
    },
    {
      "name": "--queue",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --queue"
      ],
      "tip": [
        "Create message queue."
      ]
    },
    {
      "name": "--semaphore",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --semaphore <number>"
      ],
      "tip": [
        "Create semaphore array with <number> elements."
      ],
      "next": []
    },
    {
      "name": "--shmem",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --shmem <size>"
      ],
      "tip": [
        "Create shared memory segment of size <size>."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
