{
  "meta": {
    "url": "https://gitee.com/abgox/scoop-tools",
    "description": [
      "一个 PowerShell 脚本，它允许你临时使用替换之后的代理 url 来下载安装包。"
    ]
  },
  "global_option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "更新所有应用（'*' 的替代方式）"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "强制更新，即使没有新版本"
      ]
    },
    {
      "name": "--global",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --global"
      ],
      "tip": [
        "更新全局安装的应用"
      ]
    },
    {
      "name": "--independent",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --independent"
      ],
      "tip": [
        "不自动安装依赖"
      ]
    },
    {
      "name": "--no-cache",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --no-cache"
      ],
      "tip": [
        "不使用下载缓存"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "隐藏多余的消息"
      ]
    },
    {
      "name": "--skip-hash-check",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --skip-hash-check"
      ],
      "tip": [
        "跳过哈希验证（谨慎使用！）"
      ]
    }
  ]
}
