{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "Show information about the file system on which each FILE resides, or all file systems by default."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "include pseudo, duplicate, inaccessible file systems"
      ]
    },
    {
      "name": "--block-size",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --block-size <SIZE>"
      ],
      "tip": [
        "scale sizes by SIZE before printing them; e.g., '-BM' prints sizes in units of 1,048,576 bytes; see SIZE format below"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "E"
        },
        {
          "name": "EB"
        },
        {
          "name": "G"
        },
        {
          "name": "GB"
        },
        {
          "name": "GiB"
        },
        {
          "name": "K"
        },
        {
          "name": "KB"
        },
        {
          "name": "KiB"
        },
        {
          "name": "M"
        },
        {
          "name": "MB"
        },
        {
          "name": "MiB"
        },
        {
          "name": "P"
        },
        {
          "name": "PB"
        },
        {
          "name": "T"
        },
        {
          "name": "TB"
        },
        {
          "name": "Y"
        },
        {
          "name": "YB"
        },
        {
          "name": "Z"
        },
        {
          "name": "ZB"
        }
      ]
    },
    {
      "name": "--exclude-type",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exclude-type <TYPE>"
      ],
      "tip": [
        "limit listing to file systems not of type TYPE"
      ],
      "next": [
        {
          "name": "devtmpfs"
        },
        {
          "name": "iso9660"
        },
        {
          "name": "overlay"
        },
        {
          "name": "squashfs"
        },
        {
          "name": "tmpfs"
        }
      ]
    },
    {
      "name": "--human-readable",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --human-readable"
      ],
      "tip": [
        "print sizes in powers of 1024 (e.g., 1023M)"
      ]
    },
    {
      "name": "--inodes",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --inodes"
      ],
      "tip": [
        "list inode information instead of block usage"
      ]
    },
    {
      "name": "--local",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --local"
      ],
      "tip": [
        "limit listing to local file systems"
      ]
    },
    {
      "name": "--no-sync",
      "tip": [
        "do not invoke sync before getting usage info (default)"
      ]
    },
    {
      "name": "--output",
      "usage": [
        "--output[=FIELD_LIST]"
      ],
      "tip": [
        "use the output format defined by FIELD_LIST, or print all fields if FIELD_LIST is omitted"
      ],
      "separator": ",",
      "next": [
        {
          "name": "avail"
        },
        {
          "name": "file"
        },
        {
          "name": "fstype"
        },
        {
          "name": "iavail"
        },
        {
          "name": "ipcent"
        },
        {
          "name": "itotal"
        },
        {
          "name": "iused"
        },
        {
          "name": "pcent"
        },
        {
          "name": "size"
        },
        {
          "name": "source"
        },
        {
          "name": "target"
        },
        {
          "name": "used"
        }
      ]
    },
    {
      "name": "--portability",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --portability"
      ],
      "tip": [
        "use the POSIX output format"
      ]
    },
    {
      "name": "--print-type",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --print-type"
      ],
      "tip": [
        "print file system type"
      ]
    },
    {
      "name": "--si",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --si"
      ],
      "tip": [
        "print sizes in powers of 1000 (e.g., 1.1G)"
      ]
    },
    {
      "name": "--sync",
      "tip": [
        "invoke sync before getting usage info"
      ]
    },
    {
      "name": "--total",
      "tip": [
        "elide all entries insignificant to available space, and produce a grand total"
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "limit listing to file systems of type TYPE"
      ],
      "next": [
        {
          "name": "btrfs"
        },
        {
          "name": "ext4"
        },
        {
          "name": "iso9660"
        },
        {
          "name": "nfs"
        },
        {
          "name": "nfs4"
        },
        {
          "name": "ntfs"
        },
        {
          "name": "overlay"
        },
        {
          "name": "squashfs"
        },
        {
          "name": "tmpfs"
        },
        {
          "name": "vfat"
        },
        {
          "name": "xfs"
        },
        {
          "name": "zfs"
        }
      ]
    },
    {
      "name": "-F",
      "usage": [
        "-F <TYPE>"
      ],
      "tip": [
        "like -t <TYPE>, but do not print the file system type (deprecated)"
      ],
      "next": [
        {
          "name": "btrfs"
        },
        {
          "name": "ext4"
        },
        {
          "name": "iso9660"
        },
        {
          "name": "nfs"
        },
        {
          "name": "nfs4"
        },
        {
          "name": "ntfs"
        },
        {
          "name": "overlay"
        },
        {
          "name": "squashfs"
        },
        {
          "name": "tmpfs"
        },
        {
          "name": "vfat"
        },
        {
          "name": "xfs"
        },
        {
          "name": "zfs"
        }
      ]
    },
    {
      "name": "-k",
      "tip": [
        "like --block-size=1K"
      ]
    },
    {
      "name": "-m",
      "tip": [
        "like --block-size=1M, but imply --human-readable when the output is a terminal"
      ]
    },
    {
      "name": "-v",
      "tip": [
        "(ignored)"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "display this help and exit"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "output version information and exit"
      ]
    }
  ]
}
