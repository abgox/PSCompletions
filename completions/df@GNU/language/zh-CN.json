{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "显示每个 FILE 所在文件系统的信息，默认显示所有文件系统的信息。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "包含伪文件系统、重复的文件系统以及无法访问的文件系统"
      ]
    },
    {
      "name": "--block-size",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --block-size <SIZE>"
      ],
      "tip": [
        "打印前按 SIZE 缩放大小；例如 '-BM' 以 1,048,576 字节为单位打印；SIZE 的格式参见下方"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "E"
        },
        {
          "name": "EB"
        },
        {
          "name": "G"
        },
        {
          "name": "GB"
        },
        {
          "name": "GiB"
        },
        {
          "name": "K"
        },
        {
          "name": "KB"
        },
        {
          "name": "KiB"
        },
        {
          "name": "M"
        },
        {
          "name": "MB"
        },
        {
          "name": "MiB"
        },
        {
          "name": "P"
        },
        {
          "name": "PB"
        },
        {
          "name": "T"
        },
        {
          "name": "TB"
        },
        {
          "name": "Y"
        },
        {
          "name": "YB"
        },
        {
          "name": "Z"
        },
        {
          "name": "ZB"
        }
      ]
    },
    {
      "name": "--exclude-type",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exclude-type <TYPE>"
      ],
      "tip": [
        "只列出类型不为 TYPE 的文件系统"
      ],
      "next": [
        {
          "name": "devtmpfs"
        },
        {
          "name": "iso9660"
        },
        {
          "name": "overlay"
        },
        {
          "name": "squashfs"
        },
        {
          "name": "tmpfs"
        }
      ]
    },
    {
      "name": "--human-readable",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --human-readable"
      ],
      "tip": [
        "以 1024 的幂打印大小（例如 1023M）"
      ]
    },
    {
      "name": "--inodes",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --inodes"
      ],
      "tip": [
        "列出 inode 使用信息而不是块使用信息"
      ]
    },
    {
      "name": "--local",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --local"
      ],
      "tip": [
        "只列出本地文件系统"
      ]
    },
    {
      "name": "--no-sync",
      "tip": [
        "获取使用信息前不调用 sync（默认）"
      ]
    },
    {
      "name": "--output",
      "usage": [
        "--output[=FIELD_LIST]"
      ],
      "tip": [
        "使用 FIELD_LIST 定义的输出格式；省略 FIELD_LIST 时打印所有字段"
      ],
      "separator": ",",
      "next": [
        {
          "name": "avail"
        },
        {
          "name": "file"
        },
        {
          "name": "fstype"
        },
        {
          "name": "iavail"
        },
        {
          "name": "ipcent"
        },
        {
          "name": "itotal"
        },
        {
          "name": "iused"
        },
        {
          "name": "pcent"
        },
        {
          "name": "size"
        },
        {
          "name": "source"
        },
        {
          "name": "target"
        },
        {
          "name": "used"
        }
      ]
    },
    {
      "name": "--portability",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --portability"
      ],
      "tip": [
        "使用 POSIX 输出格式"
      ]
    },
    {
      "name": "--print-type",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --print-type"
      ],
      "tip": [
        "打印文件系统类型"
      ]
    },
    {
      "name": "--si",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --si"
      ],
      "tip": [
        "以 1000 的幂打印大小（例如 1.1G）"
      ]
    },
    {
      "name": "--sync",
      "tip": [
        "获取使用信息前调用 sync"
      ]
    },
    {
      "name": "--total",
      "tip": [
        "省略对可用空间无意义的条目，并给出总计"
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "只列出类型为 TYPE 的文件系统"
      ],
      "next": [
        {
          "name": "btrfs"
        },
        {
          "name": "ext4"
        },
        {
          "name": "iso9660"
        },
        {
          "name": "nfs"
        },
        {
          "name": "nfs4"
        },
        {
          "name": "ntfs"
        },
        {
          "name": "overlay"
        },
        {
          "name": "squashfs"
        },
        {
          "name": "tmpfs"
        },
        {
          "name": "vfat"
        },
        {
          "name": "xfs"
        },
        {
          "name": "zfs"
        }
      ]
    },
    {
      "name": "-F",
      "usage": [
        "-F <TYPE>"
      ],
      "tip": [
        "等同于 -t <TYPE>，但不打印文件系统类型（已弃用）"
      ],
      "next": [
        {
          "name": "btrfs"
        },
        {
          "name": "ext4"
        },
        {
          "name": "iso9660"
        },
        {
          "name": "nfs"
        },
        {
          "name": "nfs4"
        },
        {
          "name": "ntfs"
        },
        {
          "name": "overlay"
        },
        {
          "name": "squashfs"
        },
        {
          "name": "tmpfs"
        },
        {
          "name": "vfat"
        },
        {
          "name": "xfs"
        },
        {
          "name": "zfs"
        }
      ]
    },
    {
      "name": "-k",
      "tip": [
        "等同于 --block-size=1K"
      ]
    },
    {
      "name": "-m",
      "tip": [
        "等同于 --block-size=1M，但当输出是终端时隐含 --human-readable"
      ]
    },
    {
      "name": "-v",
      "tip": [
        "（已忽略，不起作用）"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
