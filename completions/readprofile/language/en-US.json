{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Display kernel profiling information."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Print all symbols, even if count is 0."
      ]
    },
    {
      "name": "--counters",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --counters"
      ],
      "tip": [
        "Print individual counters within functions."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--histbin",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --histbin"
      ],
      "tip": [
        "Print individual histogram-bin counts."
      ]
    },
    {
      "name": "--info",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --info"
      ],
      "tip": [
        "Print only info about the sampling step."
      ]
    },
    {
      "name": "--mapfile",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mapfile <mapfile>"
      ],
      "tip": [
        "Kernel map file (defaults to /boot/System.map)."
      ],
      "next": []
    },
    {
      "name": "--multiplier",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --multiplier <mult>"
      ],
      "tip": [
        "Set the profiling multiplier to <mult>."
      ],
      "next": []
    },
    {
      "name": "--no-auto",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-auto"
      ],
      "tip": [
        "Disable byte order auto-detection."
      ]
    },
    {
      "name": "--profile",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --profile <pro-file>"
      ],
      "tip": [
        "Profiling data file (default /proc/profile)."
      ],
      "next": []
    },
    {
      "name": "--reset",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reset"
      ],
      "tip": [
        "Reset all the counters (root only)."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Print verbose data."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
