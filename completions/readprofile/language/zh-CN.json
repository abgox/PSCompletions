{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示内核性能分析信息。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "打印所有符号，即使计数为 0。"
      ]
    },
    {
      "name": "--counters",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --counters"
      ],
      "tip": [
        "打印函数内的各个计数器。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--histbin",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --histbin"
      ],
      "tip": [
        "打印各个直方图桶的计数。"
      ]
    },
    {
      "name": "--info",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --info"
      ],
      "tip": [
        "仅打印采样步长信息。"
      ]
    },
    {
      "name": "--mapfile",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mapfile <mapfile>"
      ],
      "tip": [
        "内核映射文件（默认 /boot/System.map）。"
      ],
      "next": []
    },
    {
      "name": "--multiplier",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --multiplier <mult>"
      ],
      "tip": [
        "将性能分析乘数设置为 <mult>。"
      ],
      "next": []
    },
    {
      "name": "--no-auto",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-auto"
      ],
      "tip": [
        "禁用字节序自动检测。"
      ]
    },
    {
      "name": "--profile",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --profile <pro-file>"
      ],
      "tip": [
        "性能分析数据文件（默认 /proc/profile）。"
      ],
      "next": []
    },
    {
      "name": "--reset",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reset"
      ],
      "tip": [
        "重置所有计数器（仅 root）。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "打印详细数据。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
