{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "批量更新密码。"
    ]
  },
  "option": [
    {
      "name": "--crypt-method",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --crypt-method <METHOD>"
      ],
      "tip": [
        "使用指定的方法加密密码。",
        "可能值: NONE, DES, MD5, SHA256, SHA512, YESCRYPT"
      ],
      "next": [
        {
          "name": "DES"
        },
        {
          "name": "MD5"
        },
        {
          "name": "NONE"
        },
        {
          "name": "SHA256"
        },
        {
          "name": "SHA512"
        },
        {
          "name": "YESCRYPT"
        }
      ]
    },
    {
      "name": "--encrypted",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --encrypted"
      ],
      "tip": [
        "提供的密码已加密。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--md5",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --md5"
      ],
      "tip": [
        "当提供的密码未加密时，使用 MD5 加密代替 DES。"
      ]
    },
    {
      "name": "--prefix",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --prefix <PREFIX_DIR>"
      ],
      "tip": [
        "在 PREFIX_DIR 下的根文件系统中应用对配置文件的更改。",
        "该选项不会 chroot，用于准备交叉编译目标。"
      ],
      "next": []
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--sha-rounds",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sha-rounds <ROUNDS>"
      ],
      "tip": [
        "使用指定的轮数加密密码。",
        "只能与 SHA256、SHA512 或 YESCRYPT 加密方法一起使用。"
      ],
      "next": []
    }
  ]
}
