{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "更改报告的体系结构并设置 personality 标志。"
    ]
  },
  "option": [
    {
      "name": "--32bit",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --32bit"
      ],
      "tip": [
        "启用 ADDR_LIMIT_32BIT。"
      ]
    },
    {
      "name": "--3gb",
      "alias": [
        "-3"
      ],
      "usage": [
        "-3, --3gb"
      ],
      "tip": [
        "将使用的地址空间限制为最多 3 GB。"
      ]
    },
    {
      "name": "--4gb",
      "tip": [
        "被忽略（仅用于向后兼容）。"
      ]
    },
    {
      "name": "--addr-compat-layout",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --addr-compat-layout"
      ],
      "tip": [
        "更改虚拟内存的分配方式。"
      ]
    },
    {
      "name": "--addr-no-randomize",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --addr-no-randomize"
      ],
      "tip": [
        "禁用虚拟地址空间的随机化。"
      ]
    },
    {
      "name": "--fdpic-funcptrs",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --fdpic-funcptrs"
      ],
      "tip": [
        "使函数指针指向描述符。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--list",
      "tip": [
        "列出可设置的体系结构后退出。"
      ]
    },
    {
      "name": "--mmap-page-zero",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --mmap-page-zero"
      ],
      "tip": [
        "启用 MMAP_PAGE_ZERO。"
      ]
    },
    {
      "name": "--read-implies-exec",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --read-implies-exec"
      ],
      "tip": [
        "启用 READ_IMPLIES_EXEC。"
      ]
    },
    {
      "name": "--short-inode",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --short-inode"
      ],
      "tip": [
        "启用 SHORT_INODE。"
      ]
    },
    {
      "name": "--show",
      "usage": [
        "--show[=personality]"
      ],
      "tip": [
        "显示当前或特定的 personality 后退出。"
      ],
      "next": []
    },
    {
      "name": "--sticky-timeouts",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --sticky-timeouts"
      ],
      "tip": [
        "启用 STICKY_TIMEOUTS。"
      ]
    },
    {
      "name": "--uname-2.6",
      "tip": [
        "启用 UNAME26。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "说明正在启用哪些选项。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--whole-seconds",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --whole-seconds"
      ],
      "tip": [
        "启用 WHOLE_SECONDS。"
      ]
    }
  ]
}
