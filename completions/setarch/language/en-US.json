{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Change the reported architecture and set personality flags."
    ]
  },
  "option": [
    {
      "name": "--32bit",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --32bit"
      ],
      "tip": [
        "Turns on ADDR_LIMIT_32BIT."
      ]
    },
    {
      "name": "--3gb",
      "alias": [
        "-3"
      ],
      "usage": [
        "-3, --3gb"
      ],
      "tip": [
        "Limits the used address space to a maximum of 3 GB."
      ]
    },
    {
      "name": "--4gb",
      "tip": [
        "Ignored (for backward compatibility only)."
      ]
    },
    {
      "name": "--addr-compat-layout",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --addr-compat-layout"
      ],
      "tip": [
        "Changes the way virtual memory is allocated."
      ]
    },
    {
      "name": "--addr-no-randomize",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --addr-no-randomize"
      ],
      "tip": [
        "Disables randomization of the virtual address space."
      ]
    },
    {
      "name": "--fdpic-funcptrs",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --fdpic-funcptrs"
      ],
      "tip": [
        "Makes function pointers point to descriptors."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--list",
      "tip": [
        "List settable architectures, and exit."
      ]
    },
    {
      "name": "--mmap-page-zero",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --mmap-page-zero"
      ],
      "tip": [
        "Turns on MMAP_PAGE_ZERO."
      ]
    },
    {
      "name": "--read-implies-exec",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --read-implies-exec"
      ],
      "tip": [
        "Turns on READ_IMPLIES_EXEC."
      ]
    },
    {
      "name": "--short-inode",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --short-inode"
      ],
      "tip": [
        "Turns on SHORT_INODE."
      ]
    },
    {
      "name": "--show",
      "usage": [
        "--show[=personality]"
      ],
      "tip": [
        "Show current or specific personality and exit."
      ],
      "next": []
    },
    {
      "name": "--sticky-timeouts",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --sticky-timeouts"
      ],
      "tip": [
        "Turns on STICKY_TIMEOUTS."
      ]
    },
    {
      "name": "--uname-2.6",
      "tip": [
        "Turns on UNAME26."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Say what options are being switched on."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--whole-seconds",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --whole-seconds"
      ],
      "tip": [
        "Turns on WHOLE_SECONDS."
      ]
    }
  ]
}
