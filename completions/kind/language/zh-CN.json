          "tip": [
            "构建包含 Kubernetes 构建产物和其他 kind 依赖的节点镜像。"
          ],
          "option": [
            {
              "name": "--arch",
              "usage": [
                "--arch <arch>"
              ],
              "tip": [
                "要构建的架构，默认为主机架构。"
              ],
              "next": [
                {
                  "name": "amd64",
                  "tip": [
                    "AMD64 架构。"
                  ]
                },
