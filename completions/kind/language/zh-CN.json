{
  "meta": {
    "url": "https://kind.sigs.k8s.io/",
    "description": [
      "kind 是一个使用 Docker 容器 'nodes' 运行本地 Kubernetes 集群的工具。",
      "kind 最初主要用于测试 Kubernetes 本身，但也可用于本地开发或 CI。"
    ]
  },
  "next": [
    {
      "name": "build",
      "tip": [
        "构建 [node-image] 之一。"
      ],
      "next": [
        {
          "name": "node-image",
          "usage": [
            "node-image [kubernetes-source]"
