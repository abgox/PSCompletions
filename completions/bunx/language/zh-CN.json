{
  "meta": {
    "url": "https://bun.com/docs/cli/bunx",
    "description": [
      "执行一个 npm 包可执行文件 (CLI)，如果未安装在 node_modules 中，会自动安装到全局共享缓存。"
    ]
  },
  "option": [
    {
      "name": "--bun",
      "tip": [
        "强制使用 Bun 而不是 Node.js 运行命令。",
        "必须放在包名之前。"
      ]
    },
    {
      "name": "--no-install",
      "tip": [
        "如果包尚未安装，则跳过安装。"
      ]
    },
    {
      "name": "--package",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --package <package>"
      ],
      "tip": [
        "当二进制名称与包名不同时，指定要安装的包。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--silent",
      "tip": [
        "在安装过程中抑制输出。"
      ]
    },
    {
      "name": "--verbose",
      "tip": [
        "在安装过程中启用详细输出。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "打印版本并退出。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助。"
      ]
    }
  ]
}
