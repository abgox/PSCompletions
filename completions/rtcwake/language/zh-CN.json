{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "进入系统睡眠状态，直到指定的唤醒时间。"
    ]
  },
  "option": [
    {
      "name": "--adjfile",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --adjfile <file>"
      ],
      "tip": [
        "指定 adjust 文件路径（默认 /etc/adjtime）。"
      ],
      "next": []
    },
    {
      "name": "--auto",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --auto"
      ],
      "tip": [
        "从 adjust 文件读取时钟模式（默认）。"
      ]
    },
    {
      "name": "--date",
      "usage": [
        "--date <timestamp>"
      ],
      "tip": [
        "要唤醒的日期时间戳。"
      ],
      "next": []
    },
    {
      "name": "--device",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --device <device>"
      ],
      "tip": [
        "选择 RTC 设备（rtc0|rtc1|...）。"
      ],
      "next": []
    },
    {
      "name": "--dry-run",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --dry-run"
      ],
      "tip": [
        "执行所有操作，但不挂起。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--list-modes",
      "tip": [
        "列出可用模式。"
      ]
    },
    {
      "name": "--local",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --local"
      ],
      "tip": [
        "RTC 使用本地时区。"
      ]
    },
    {
      "name": "--mode",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mode <mode>"
      ],
      "tip": [
        "睡眠模式，例如 standby 或 mem（参见 --list-modes）。"
      ],
      "next": []
    },
    {
      "name": "--seconds",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --seconds <seconds>"
      ],
      "tip": [
        "睡眠秒数。"
      ],
      "next": []
    },
    {
      "name": "--time",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --time <time_t>"
      ],
      "tip": [
        "唤醒时间。"
      ],
      "next": []
    },
    {
      "name": "--utc",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --utc"
      ],
      "tip": [
        "RTC 使用 UTC。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "详细消息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
