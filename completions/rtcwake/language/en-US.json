{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Enter a system sleep state until a specified wakeup time."
    ]
  },
  "option": [
    {
      "name": "--adjfile",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --adjfile <file>"
      ],
      "tip": [
        "Specify the path to the adjust file (default /etc/adjtime)."
      ],
      "next": []
    },
    {
      "name": "--auto",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --auto"
      ],
      "tip": [
        "Read the clock mode from the adjust file (default)."
      ]
    },
    {
      "name": "--date",
      "usage": [
        "--date <timestamp>"
      ],
      "tip": [
        "Date time of timestamp to wake."
      ],
      "next": []
    },
    {
      "name": "--device",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --device <device>"
      ],
      "tip": [
        "Select RTC device (rtc0|rtc1|...)."
      ],
      "next": []
    },
    {
      "name": "--dry-run",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --dry-run"
      ],
      "tip": [
        "Does everything, but suspend."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--list-modes",
      "tip": [
        "List available modes."
      ]
    },
    {
      "name": "--local",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --local"
      ],
      "tip": [
        "RTC uses local timezone."
      ]
    },
    {
      "name": "--mode",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mode <mode>"
      ],
      "tip": [
        "Sleep mode, for example standby or mem (see --list-modes)."
      ],
      "next": []
    },
    {
      "name": "--seconds",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --seconds <seconds>"
      ],
      "tip": [
        "Seconds to sleep."
      ],
      "next": []
    },
    {
      "name": "--time",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --time <time_t>"
      ],
      "tip": [
        "Time to wake."
      ],
      "next": []
    },
    {
      "name": "--utc",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --utc"
      ],
      "tip": [
        "RTC uses UTC."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Verbose messages."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
