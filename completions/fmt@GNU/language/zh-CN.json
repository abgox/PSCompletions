{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "重新格式化这些文件中的每个段落，输出到标准输出。"
    ]
  },
  "option": [
    {
      "name": "--crown-margin",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --crown-margin"
      ],
      "tip": [
        "保留前两行的缩进"
      ]
    },
    {
      "name": "--goal",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --goal <WIDTH>"
      ],
      "tip": [
        "目标宽度（默认为 width 的 93%）"
      ],
      "next": []
    },
    {
      "name": "--prefix",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --prefix <STRING>"
      ],
      "tip": [
        "只重新格式化以 STRING 开头的行，并把前缀重新接到格式化后的行上"
      ],
      "next": []
    },
    {
      "name": "--split-only",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --split-only"
      ],
      "tip": [
        "拆分过长的行，但不重新填充"
      ]
    },
    {
      "name": "--tagged-paragraph",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --tagged-paragraph"
      ],
      "tip": [
        "段落的缩进按前两行是否相同来区分"
      ]
    },
    {
      "name": "--uniform-spacing",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uniform-spacing"
      ],
      "tip": [
        "单词之间一个空格，句子之后两个空格"
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <WIDTH>"
      ],
      "tip": [
        "最大行宽（默认为 75 列）"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
