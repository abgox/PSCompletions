{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "打印每个指定 USER 的用户和组信息；省略 USER 时打印当前进程的信息。"
    ]
  },
  "option": [
    {
      "name": "--context",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --context"
      ],
      "tip": [
        "只打印该进程的安全上下文"
      ]
    },
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group"
      ],
      "tip": [
        "只打印有效组 ID"
      ]
    },
    {
      "name": "--groups",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --groups"
      ],
      "tip": [
        "打印所有组 ID"
      ]
    },
    {
      "name": "--name",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --name"
      ],
      "tip": [
        "对 -u、-g、-G 打印名字而不是数字"
      ]
    },
    {
      "name": "--real",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --real"
      ],
      "tip": [
        "对 -u、-g、-G 打印真实 ID 而不是有效 ID"
      ]
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user"
      ],
      "tip": [
        "只打印有效用户 ID"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "用 NUL 字符而不是空白符分隔各项；默认格式下不允许这样做"
      ]
    },
    {
      "name": "-a",
      "tip": [
        "为兼容其他版本而忽略"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
