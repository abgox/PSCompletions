{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Concatenate FILE(s), or standard input, to standard output"
    ]
  },
  "option": [
    {
      "name": "--number",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --number"
      ],
      "tip": [
        "number all output lines"
      ]
    },
    {
      "name": "--number-nonblank",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --number-nonblank"
      ],
      "tip": [
        "number nonempty output lines, overrides -n"
      ]
    },
    {
      "name": "--show-all",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --show-all"
      ],
      "tip": [
        "equivalent to -vET"
      ]
    },
    {
      "name": "--show-ends",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --show-ends"
      ],
      "tip": [
        "display $ at end of each line"
      ]
    },
    {
      "name": "--show-nonprinting",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --show-nonprinting"
      ],
      "tip": [
        "use ^ and M- notation, except for LF (\\n) and TAB (\\t)"
      ]
    },
    {
      "name": "--show-tabs",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --show-tabs"
      ],
      "tip": [
        "display TAB characters at ^I"
      ]
    },
    {
      "name": "--squeeze-blank",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squeeze-blank"
      ],
      "tip": [
        "suppress repeated empty output lines"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "-e",
      "tip": [
        "equivalent to -vE"
      ]
    },
    {
      "name": "-t",
      "tip": [
        "equivalent to -vT"
      ]
    },
    {
      "name": "-u",
      "tip": [
        "(ignored)"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
