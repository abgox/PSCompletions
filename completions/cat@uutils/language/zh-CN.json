{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将 FILE 或标准输入连接到标准输出"
    ]
  },
  "option": [
    {
      "name": "--number",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --number"
      ],
      "tip": [
        "为所有输出行编号"
      ]
    },
    {
      "name": "--number-nonblank",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --number-nonblank"
      ],
      "tip": [
        "为非空输出行编号，覆盖 -n"
      ]
    },
    {
      "name": "--show-all",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --show-all"
      ],
      "tip": [
        "等同于 -vET"
      ]
    },
    {
      "name": "--show-ends",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --show-ends"
      ],
      "tip": [
        "在每行末尾显示 $"
      ]
    },
    {
      "name": "--show-nonprinting",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --show-nonprinting"
      ],
      "tip": [
        "使用 ^ 和 M- 记号，LF（\\n）和 TAB（\\t）除外"
      ]
    },
    {
      "name": "--show-tabs",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --show-tabs"
      ],
      "tip": [
        "将 TAB 字符显示为 ^I"
      ]
    },
    {
      "name": "--squeeze-blank",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squeeze-blank"
      ],
      "tip": [
        "压缩重复的空输出行"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-e",
      "tip": [
        "等同于 -vE"
      ]
    },
    {
      "name": "-t",
      "tip": [
        "等同于 -vT"
      ]
    },
    {
      "name": "-u",
      "tip": [
        "（被忽略）"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
