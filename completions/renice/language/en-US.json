{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Alter the priority of running processes."
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--pgrp",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --pgrp"
      ],
      "tip": [
        "Interpret arguments as process group ID."
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid"
      ],
      "tip": [
        "Interpret arguments as process ID (default)."
      ]
    },
    {
      "name": "--priority",
      "usage": [
        "--priority <num>"
      ],
      "tip": [
        "Specify the absolute nice value."
      ],
      "next": []
    },
    {
      "name": "--relative",
      "usage": [
        "--relative <num>"
      ],
      "tip": [
        "Specify the relative nice value."
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user"
      ],
      "tip": [
        "Interpret arguments as username or user ID."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "-n",
      "usage": [
        "-n <num>"
      ],
      "tip": [
        "Specify the nice value.",
        "Relative to the current priority when POSIXLY_CORRECT is set, absolute otherwise."
      ],
      "next": []
    }
  ]
}
