{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "更改正在运行的进程的优先级。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--pgrp",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --pgrp"
      ],
      "tip": [
        "将参数解释为进程组 ID。"
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid"
      ],
      "tip": [
        "将参数解释为进程 ID（默认）。"
      ]
    },
    {
      "name": "--priority",
      "usage": [
        "--priority <num>"
      ],
      "tip": [
        "指定绝对 nice 值。"
      ],
      "next": []
    },
    {
      "name": "--relative",
      "usage": [
        "--relative <num>"
      ],
      "tip": [
        "指定相对 nice 值。"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user"
      ],
      "tip": [
        "将参数解释为用户名或用户 ID。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "-n",
      "usage": [
        "-n <num>"
      ],
      "tip": [
        "指定 nice 值。",
        "设置 POSIXLY_CORRECT 时相对于当前优先级，否则为绝对值。"
      ],
      "next": []
    }
  ]
}
