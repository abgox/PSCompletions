{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "打印某些系统信息。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "按以下顺序打印全部信息，但如果未知则省略 -p 和 -i："
      ]
    },
    {
      "name": "--hardware-platform",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --hardware-platform"
      ],
      "tip": [
        "打印硬件平台（不可移植）"
      ]
    },
    {
      "name": "--kernel-name",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --kernel-name"
      ],
      "tip": [
        "打印内核名称"
      ]
    },
    {
      "name": "--kernel-release",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --kernel-release"
      ],
      "tip": [
        "打印内核发布版本"
      ]
    },
    {
      "name": "--kernel-version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --kernel-version"
      ],
      "tip": [
        "打印内核版本"
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --machine"
      ],
      "tip": [
        "打印机器硬件名称"
      ]
    },
    {
      "name": "--nodename",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nodename"
      ],
      "tip": [
        "打印网络节点主机名"
      ]
    },
    {
      "name": "--operating-system",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --operating-system"
      ],
      "tip": [
        "打印操作系统名称"
      ]
    },
    {
      "name": "--processor",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --processor"
      ],
      "tip": [
        "打印处理器类型（不可移植）"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
