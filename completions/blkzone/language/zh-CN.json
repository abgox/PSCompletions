{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "对给定块设备运行区域命令。"
    ]
  },
  "next": [
    {
      "name": "capacity",
      "usage": [
        "capacity <device>"
      ],
      "tip": [
        "报告给定设备的区域容量总和。"
      ]
    },
    {
      "name": "close",
      "usage": [
        "close <device>"
      ],
      "tip": [
        "关闭一个区域范围。"
      ]
    },
    {
      "name": "finish",
      "usage": [
        "finish <device>"
      ],
      "tip": [
        "将一个区域范围设置为 Full。"
      ]
    },
    {
      "name": "open",
      "usage": [
        "open <device>"
      ],
      "tip": [
        "打开一个区域范围。"
      ]
    },
    {
      "name": "report",
      "usage": [
        "report <device>"
      ],
      "tip": [
        "报告给定设备的区域信息。"
      ]
    },
    {
      "name": "reset",
      "usage": [
        "reset <device>"
      ],
      "tip": [
        "重置一个区域范围。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--count",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --count <number>"
      ],
      "tip": [
        "最大区域数。"
      ],
      "next": []
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "对系统正在使用的块设备强制执行。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --length <sectors>"
      ],
      "tip": [
        "要操作的最大扇区数（512 字节扇区）。"
      ],
      "next": []
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <sector>"
      ],
      "tip": [
        "要操作的起始扇区（512 字节扇区）。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "显示更多细节。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
