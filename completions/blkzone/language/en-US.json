{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Run zone command on the given block device."
    ]
  },
  "next": [
    {
      "name": "capacity",
      "usage": [
        "capacity <device>"
      ],
      "tip": [
        "Report sum of zone capacities for the given device."
      ]
    },
    {
      "name": "close",
      "usage": [
        "close <device>"
      ],
      "tip": [
        "Close a range of zones."
      ]
    },
    {
      "name": "finish",
      "usage": [
        "finish <device>"
      ],
      "tip": [
        "Set a range of zones to Full."
      ]
    },
    {
      "name": "open",
      "usage": [
        "open <device>"
      ],
      "tip": [
        "Open a range of zones."
      ]
    },
    {
      "name": "report",
      "usage": [
        "report <device>"
      ],
      "tip": [
        "Report zone information about the given device."
      ]
    },
    {
      "name": "reset",
      "usage": [
        "reset <device>"
      ],
      "tip": [
        "Reset a range of zones."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--count",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --count <number>"
      ],
      "tip": [
        "Maximum number of zones."
      ],
      "next": []
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "Enforce on block devices used by the system."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --length <sectors>"
      ],
      "tip": [
        "Maximum sectors to act (in 512-byte sectors)."
      ],
      "next": []
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <sector>"
      ],
      "tip": [
        "Start sector of zone to act (in 512-byte sectors)."
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Display more details."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
