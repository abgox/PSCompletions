      "next": [
        {
          "name": "1",
          "tip": [
            "Single in-flight probe"
          ]
        },
        {
          "name": "18",
          "tip": [
            "Default concurrency"
          ]
        },
        {
          "name": "6",
          "tip": [
            "6 concurrent probes"
          ]
        }
      ]
    },
    {
      "name": "--port",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --port <integer>"
      ],
      "tip": [
        "Set the destination port to use. Default of 80 for tcp, 33494 for udp."
      ],
      "next": [
        {
          "name": "33494",
          "tip": [
            "Default UDP port"
          ]
        },
        {
          "name": "443",
          "tip": [
            "HTTPS port"
          ]
        },
        {
          "name": "80",
          "tip": [
            "Default TCP port"
          ]
        }
      ]
    },
    {
      "name": "--pow-provider",
      "usage": [
        "--pow-provider <provider>"
      ],
      "tip": [
        "Choose PoW Provider. For China mainland users, please use sakura. Default: api.nxtrace.org."
      ],
      "next": [
        {
          "name": "api.nxtrace.org",
          "tip": [
            "Default PoW provider"
          ]
        },
        {
          "name": "sakura",
          "tip": [
            "Sakura provider for China mainland"
          ]
        }
      ]
    },
    {
      "name": "--psize",
      "usage": [
        "--psize <integer>"
      ],
      "tip": [
        "Probe packet size in bytes, inclusive IP and active probe headers. Negative values randomize each probe."
      ],
      "next": [
        {
          "name": "128",
          "tip": [
            "128-byte probes"
          ]
        },
        {
          "name": "64",
          "tip": [
            "64-byte probes"
          ]
        }
      ]
    },
    {
      "name": "--queries",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --queries <integer>"
      ],
      "tip": [
        "Latency samples per hop. Increase to 5-10 on unstable paths for a steadier view. Default: 3."
      ],
      "next": [
        {
          "name": "10",
          "tip": [
            "10 samples per hop"
          ]
        },
        {
          "name": "3",
          "tip": [
            "Default sample count"
          ]
        },
        {
          "name": "5",
          "tip": [
            "5 samples per hop"
          ]
        }
      ]
    },
    {
      "name": "--raw",
      "tip": [
        "Machine-friendly output. With MTR (--mtr/-r/-w), enables streaming raw event mode"
      ]
    },
    {
      "name": "--report",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --report"
      ],
      "tip": [
        "MTR report mode (non-interactive, implies --mtr); can trigger MTR without --mtr"
      ]
    },
    {
      "name": "--route-path",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --route-path"
      ],
      "tip": [
        "Print traceroute hop path by ASN and location"
      ]
    },
    {
      "name": "--send-time",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --send-time <integer>"
      ],
      "tip": [
        "Advanced: per-packet gap [ms] inside the same TTL group. Default: 50."
      ],
      "next": [
        {
          "name": "100",
          "tip": [
            "100 ms gap"
          ]
        },
        {
          "name": "50",
          "tip": [
            "Default gap in ms"
          ]
        }
      ]
    },
    {
      "name": "--setup-api-v4-token",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --setup-api-v4-token"
      ],
      "tip": [
        "Store a session-only NextTrace API v4 token in a temporary file"
      ]
    },
    {
      "name": "--show-ips",
      "tip": [
        "MTR only: display both PTR hostnames and numeric IPs (PTR first, IP in parentheses)"
      ]
    },
    {
      "name": "--source",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --source <value>"
      ],
      "tip": [
        "Use source address src_addr for outgoing packets"
      ],
      "next": [
        {
          "name": "src_addr",
          "tip": [
            "Source address"
          ]
        }
      ]
    },
    {
      "name": "--source-port",
      "usage": [
        "--source-port <integer>"
      ],
      "tip": [
        "Use source port src_port for outgoing packets"
      ],
      "next": [
        {
          "name": "0",
          "tip": [
            "Auto-assigned source port"
          ]
        }
      ]
    },
    {
      "name": "--speed",
      "tip": [
        "Run CDN speed test mode. See nexttrace --speed --help for details."
      ]
    },
    {
      "name": "--table",
      "tip": [
        "Output trace results as a final summary table (traceroute report mode)"
      ]
    },
    {
      "name": "--tcp",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --tcp"
      ],
      "tip": [
        "Use TCP SYN for tracerouting (default dest-port is 80)"
      ]
    },
    {
      "name": "--timeout",
      "usage": [
        "--timeout <integer>"
      ],
      "tip": [
        "Per-probe timeout [ms]. Raise to 2000-3000 on slow paths. Default: 1000."
      ],
      "next": [
        {
          "name": "1000",
          "tip": [
            "Default timeout in ms"
          ]
        },
        {
          "name": "2000",
          "tip": [
            "2000 ms timeout"
          ]
        },
        {
          "name": "3000",
          "tip": [
            "3000 ms timeout"
          ]
        }
      ]
    },
    {
      "name": "--tos",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --tos <integer>"
      ],
      "tip": [
        "Set the IP type-of-service / traffic class value [0-255]. Default: 0."
      ],
      "next": [
        {
          "name": "0",
          "tip": [
            "Default ToS value"
          ]
        },
        {
          "name": "255",
          "tip": [
            "Maximum ToS value"
          ]
        }
      ]
    },
    {
      "name": "--ttl-time",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ttl-time <integer>"
      ],
      "tip": [
        "Advanced: TTL-group interval [ms] in normal traceroute. In MTR mode becomes per-hop probe interval."
      ],
      "next": [
        {
          "name": "1000",
          "tip": [
            "1000 ms interval"
          ]
        },
        {
          "name": "500",
          "tip": [
            "500 ms interval"
          ]
        }
      ]
    },
    {
      "name": "--udp",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --udp"
      ],
      "tip": [
        "Use UDP SYN for tracerouting (default dest-port is 33494)"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version info and exit"
      ]
    },
    {
      "name": "--wide",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wide"
      ],
      "tip": [
        "MTR wide report mode (implies --mtr --report); alone equals --mtr --report --wide"
      ]
    }
  ]
}
