{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "以十六进制、十进制、八进制或 ASCII 显示文件内容。"
    ]
  },
  "option": [
    {
      "name": "--canonical",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --canonical"
      ],
      "tip": [
        "标准十六进制+ASCII 显示。"
      ]
    },
    {
      "name": "--color",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --color[=<mode>]"
      ],
      "tip": [
        "解释颜色格式说明符。",
        "默认启用颜色。"
      ],
      "next": []
    },
    {
      "name": "--format",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --format <format>"
      ],
      "tip": [
        "用于显示数据的格式字符串。"
      ],
      "next": []
    },
    {
      "name": "--format-file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --format-file <file>"
      ],
      "tip": [
        "包含格式字符串的文件。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --length <length>"
      ],
      "tip": [
        "仅解释输入的 length 个字节。"
      ],
      "next": []
    },
    {
      "name": "--no-squeezing",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --no-squeezing"
      ],
      "tip": [
        "输出相同的行。"
      ]
    },
    {
      "name": "--one-byte-char",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --one-byte-char"
      ],
      "tip": [
        "单字节字符显示。"
      ]
    },
    {
      "name": "--one-byte-hex",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --one-byte-hex"
      ],
      "tip": [
        "单字节十六进制显示。"
      ]
    },
    {
      "name": "--one-byte-octal",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --one-byte-octal"
      ],
      "tip": [
        "单字节八进制显示。"
      ]
    },
    {
      "name": "--skip",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --skip <offset>"
      ],
      "tip": [
        "从开头跳过 offset 个字节。"
      ],
      "next": []
    },
    {
      "name": "--two-bytes-decimal",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --two-bytes-decimal"
      ],
      "tip": [
        "双字节十进制显示。"
      ]
    },
    {
      "name": "--two-bytes-hex",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --two-bytes-hex"
      ],
      "tip": [
        "双字节十六进制显示。"
      ]
    },
    {
      "name": "--two-bytes-octal",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --two-bytes-octal"
      ],
      "tip": [
        "双字节八进制显示。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
