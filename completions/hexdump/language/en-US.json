{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Display file contents in hexadecimal, decimal, octal, or ascii."
    ]
  },
  "option": [
    {
      "name": "--canonical",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --canonical"
      ],
      "tip": [
        "Canonical hex+ASCII display."
      ]
    },
    {
      "name": "--color",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --color[=<mode>]"
      ],
      "tip": [
        "Interpret color formatting specifiers.",
        "Colors are enabled by default."
      ],
      "next": []
    },
    {
      "name": "--format",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --format <format>"
      ],
      "tip": [
        "Format string to be used for displaying data."
      ],
      "next": []
    },
    {
      "name": "--format-file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --format-file <file>"
      ],
      "tip": [
        "File that contains format strings."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --length <length>"
      ],
      "tip": [
        "Interpret only length bytes of input."
      ],
      "next": []
    },
    {
      "name": "--no-squeezing",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --no-squeezing"
      ],
      "tip": [
        "Output identical lines."
      ]
    },
    {
      "name": "--one-byte-char",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --one-byte-char"
      ],
      "tip": [
        "One-byte character display."
      ]
    },
    {
      "name": "--one-byte-hex",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --one-byte-hex"
      ],
      "tip": [
        "One-byte hexadecimal display."
      ]
    },
    {
      "name": "--one-byte-octal",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --one-byte-octal"
      ],
      "tip": [
        "One-byte octal display."
      ]
    },
    {
      "name": "--skip",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --skip <offset>"
      ],
      "tip": [
        "Skip offset bytes from the beginning."
      ],
      "next": []
    },
    {
      "name": "--two-bytes-decimal",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --two-bytes-decimal"
      ],
      "tip": [
        "Two-byte decimal display."
      ]
    },
    {
      "name": "--two-bytes-hex",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --two-bytes-hex"
      ],
      "tip": [
        "Two-byte hexadecimal display."
      ]
    },
    {
      "name": "--two-bytes-octal",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --two-bytes-octal"
      ],
      "tip": [
        "Two-byte octal display."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
