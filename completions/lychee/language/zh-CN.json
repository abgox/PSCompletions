{
  "meta": {
    "url": "https://github.com/lycheeverse/lychee",
    "description": [
      "一个快速、异步的链接检查器。",
      "检测本地文件和网站中的失效 URL 和邮件地址。"
    ]
  },
  "option": [
    {
      "name": "--accept",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --accept <ACCEPT>"
      ],
      "tip": [
        "接受指定的状态码列表作为有效链接。"
      ],
      "next": []
    },
    {
      "name": "--accept-timeouts",
      "tip": [
        "接受超时请求并返回退出码 0。"
      ]
    },
    {
      "name": "--archive",
      "usage": [
        "--archive <ARCHIVE>"
      ],
      "tip": [
        "使用 Web 存档来提供建议。"
      ],
      "next": [
        {
          "name": "wayback",
          "tip": [
            "Wayback Machine "
          ]
        }
      ]
    },
    {
      "name": "--base-url",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --base-url <BASE_URL>"
      ],
      "tip": [
        "用于解析本地文件中相对 URL 的基础 URL。"
      ],
      "next": []
    },
    {
      "name": "--basic-auth",
      "usage": [
        "--basic-auth <BASIC_AUTH>"
      ],
      "tip": [
        "基本身份验证支持。"
      ],
      "next": []
    },
    {
      "name": "--cache",
      "tip": [
        "使用存储在磁盘上的请求缓存。"
      ]
    },
    {
      "name": "--cache-exclude-status",
      "usage": [
        "--cache-exclude-status <STATUS>"
      ],
      "tip": [
        "从缓存中排除的状态码。"
      ],
      "next": []
    },
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config <FILE>"
      ],
      "tip": [
        "要使用的配置文件。"
      ],
      "next": []
    },
    {
      "name": "--cookie-jar",
      "usage": [
        "--cookie-jar <COOKIE_JAR>"
      ],
      "tip": [
        "使用给定文件读取和写入 cookie。"
      ],
      "next": []
    },
    {
      "name": "--dump",
      "tip": [
        "不检查链接，仅转储所有提取的链接。"
      ]
    },
    {
      "name": "--dump-inputs",
      "tip": [
        "不检查链接，仅转储所有输入源。"
      ]
    },
    {
      "name": "--exclude",
      "usage": [
        "--exclude <EXCLUDE>"
      ],
      "tip": [
        "从检查中排除 URL 和邮件地址。"
      ],
      "next": []
    },
    {
      "name": "--exclude-all-private",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --exclude-all-private"
      ],
      "tip": [
        "从检查中排除所有私有 IP。"
      ]
    },
    {
      "name": "--exclude-path",
      "usage": [
        "--exclude-path <PATH>"
      ],
      "tip": [
        "排除不检查的路径。"
      ],
      "next": []
    },
    {
      "name": "--extensions",
      "usage": [
        "--extensions <EXTENSIONS>"
      ],
      "tip": [
        "要检查的文件扩展名列表。"
      ],
      "next": []
    },
    {
      "name": "--files-from",
      "usage": [
        "--files-from <PATH>"
      ],
      "tip": [
        "从给定文件中读取输入文件名。"
      ],
      "next": []
    },
    {
      "name": "--format",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --format <FORMAT>"
      ],
      "tip": [
        "最终状态报告的输出格式。"
      ],
      "next": [
        {
          "name": "compact",
          "tip": [
            "紧凑格式（默认）。"
          ]
        },
        {
          "name": "detailed",
          "tip": [
            "详细格式。"
          ]
        },
        {
          "name": "json",
          "tip": [
            "JSON 格式。"
          ]
        },
        {
          "name": "junit",
          "tip": [
            "JUnit 格式。"
          ]
        },
        {
          "name": "markdown",
          "tip": [
            "Markdown 格式。"
          ]
        }
      ]
    },
    {
      "name": "--generate",
      "usage": [
        "--generate <KIND>"
      ],
      "tip": [
        "生成特殊输出而不是检查链接。"
      ],
      "next": [
        {
          "name": "complete-bash",
          "tip": [
            "生成 Bash 补全。"
          ]
        },
        {
          "name": "complete-elvish",
          "tip": [
            "生成 Elvish 补全。"
          ]
        },
        {
          "name": "complete-fish",
          "tip": [
            "生成 Fish 补全。"
          ]
        },
        {
          "name": "complete-powershell",
          "tip": [
            "生成 PowerShell 补全。"
          ]
        },
        {
          "name": "complete-zsh",
          "tip": [
            "生成 Zsh 补全。"
          ]
        },
        {
          "name": "man",
          "tip": [
            "生成 man 手册页。"
          ]
        }
      ]
    },
    {
      "name": "--github-token",
      "usage": [
        "--github-token <TOKEN>"
      ],
      "tip": [
        "用于检查 GitHub 链接的 GitHub API 令牌。"
      ],
      "next": []
    },
    {
      "name": "--header",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --header <HEADER:VALUE>"
      ],
      "tip": [
        "为请求设置自定义头部。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--hidden",
      "tip": [
        "不跳过隐藏目录和文件。"
      ]
    },
    {
      "name": "--include",
      "usage": [
        "--include <INCLUDE>"
      ],
      "tip": [
        "要检查的 URL（支持正则表达式）。"
      ],
      "next": []
    },
    {
      "name": "--include-mail",
      "tip": [
        "同时检查邮件地址。"
      ]
    },
    {
      "name": "--insecure",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --insecure"
      ],
      "tip": [
        "允许不安全的服务器连接。"
      ]
    },
    {
      "name": "--max-concurrency",
      "usage": [
        "--max-concurrency <NUM>"
      ],
      "tip": [
        "最大并发网络请求数。"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    },
    {
      "name": "--max-redirects",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --max-redirects <MAX>"
      ],
      "tip": [
        "允许的最大重定向次数。"
      ],
      "next": []
    },
    {
      "name": "--max-retries",
      "usage": [
        "--max-retries <NUM>"
      ],
      "tip": [
        "每个请求的最大重试次数。"
      ],
      "next": []
    },
    {
      "name": "--method",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --method <METHOD>"
      ],
      "tip": [
        "请求方法。"
      ],
      "next": [
        {
          "name": "get",
          "tip": [
            "GET 方法（默认）。"
          ]
        },
        {
          "name": "head",
          "tip": [
            "HEAD 方法。"
          ]
        },
        {
          "name": "post",
          "tip": [
            "POST 方法。"
          ]
        }
      ]
    },
    {
      "name": "--min-tls",
      "usage": [
        "--min-tls <VERSION>"
      ],
      "tip": [
        "接受的最低 TLS 版本。"
      ],
      "next": [
        {
          "name": "TLSv1_0",
          "tip": [
            "TLS 1.0 "
          ]
        },
        {
          "name": "TLSv1_1",
          "tip": [
            "TLS 1.1 "
          ]
        },
        {
          "name": "TLSv1_2",
          "tip": [
            "TLS 1.2 "
          ]
        },
        {
          "name": "TLSv1_3",
          "tip": [
            "TLS 1.3 "
          ]
        }
      ]
    },
    {
      "name": "--mode",
      "usage": [
        "--mode <MODE>"
      ],
      "tip": [
        "设置输出显示模式。"
      ],
      "next": [
        {
          "name": "color",
          "tip": [
            "彩色输出（默认）。"
          ]
        },
        {
          "name": "emoji",
          "tip": [
            "Emoji 输出。"
          ]
        },
        {
          "name": "plain",
          "tip": [
            "纯文本。"
          ]
        },
        {
          "name": "task",
          "tip": [
            "任务输出。"
          ]
        }
      ]
    },
    {
      "name": "--no-ignore",
      "tip": [
        "不跳过被 .gitignore 忽略的文件。"
      ]
    },
    {
      "name": "--no-progress",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-progress"
      ],
      "tip": [
        "不显示进度条。"
      ]
    },
    {
      "name": "--offline",
      "tip": [
        "仅检查本地文件并阻止网络请求。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <FILE>"
      ],
      "tip": [
        "状态报告的输出文件。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "减少每次出现的输出。"
      ]
    },
    {
      "name": "--remap",
      "usage": [
        "--remap <REMAP>"
      ],
      "tip": [
        "将 URI 匹配模式重映射到不同的 URI。"
      ],
      "next": []
    },
    {
      "name": "--require-https",
      "tip": [
        "当 HTTPS 可用时，将 HTTP 链接视为错误。"
      ]
    },
    {
      "name": "--retry-wait-time",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --retry-wait-time <SECONDS>"
      ],
      "tip": [
        "重试之间的最小等待时间（秒）。"
      ],
      "next": [
        {
          "name": "30"
        },
        {
          "name": "5"
        },
        {
          "name": "60"
        }
      ]
    },
    {
      "name": "--root-dir",
      "usage": [
        "--root-dir <DIR>"
      ],
      "tip": [
        "用于解析本地文件中绝对链接的根目录。"
      ],
      "next": []
    },
    {
      "name": "--scheme",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --scheme <SCHEME>"
      ],
      "tip": [
        "仅测试使用给定协议的链接。"
      ],
      "next": []
    },
    {
      "name": "--skip-missing",
      "tip": [
        "跳过缺失的输入文件。"
      ]
    },
    {
      "name": "--suggest",
      "tip": [
        "使用 Web 存档为失效链接建议替代链接。"
      ]
    },
    {
      "name": "--threads",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --threads <THREADS>"
      ],
      "tip": [
        "使用的线程数。"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    },
    {
      "name": "--timeout",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --timeout <TIMEOUT>"
      ],
      "tip": [
        "网站超时时间（秒）。"
      ],
      "next": []
    },
    {
      "name": "--user-agent",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user-agent <AGENT>"
      ],
      "tip": [
        "User agent "
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "设置详细级别。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本号。"
      ]
    }
  ]
}
