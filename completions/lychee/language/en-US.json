{
  "meta": {
    "url": "https://github.com/lycheeverse/lychee",
    "description": [
      "A fast, asynchronous link checker",
      "Detects broken URLs and mail addresses in local files and websites"
    ]
  },
  "option": [
    {
      "name": "--accept",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --accept <ACCEPT>"
      ],
      "tip": [
        "A list of accepted status codes for valid links"
      ],
      "next": []
    },
    {
      "name": "--accept-timeouts",
      "tip": [
        "Accept timed out requests and return exit code 0"
      ]
    },
    {
      "name": "--archive",
      "usage": [
        "--archive <ARCHIVE>"
      ],
      "tip": [
        "Web archive to use for suggestions"
      ],
      "next": [
        {
          "name": "wayback",
          "tip": [
            "Wayback Machine"
          ]
        }
      ]
    },
    {
      "name": "--base-url",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --base-url <BASE_URL>"
      ],
      "tip": [
        "Base URL for resolving relative URLs in local files"
      ],
      "next": []
    },
    {
      "name": "--basic-auth",
      "usage": [
        "--basic-auth <BASIC_AUTH>"
      ],
      "tip": [
        "Basic authentication support"
      ],
      "next": []
    },
    {
      "name": "--cache",
      "tip": [
        "Use request cache stored on disk"
      ]
    },
    {
      "name": "--cache-exclude-status",
      "usage": [
        "--cache-exclude-status <STATUS>"
      ],
      "tip": [
        "Status codes to exclude from cache"
      ],
      "next": []
    },
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config <FILE>"
      ],
      "tip": [
        "Configuration file to use"
      ],
      "next": []
    },
    {
      "name": "--cookie-jar",
      "usage": [
        "--cookie-jar <COOKIE_JAR>"
      ],
      "tip": [
        "Read and write cookies using the given file"
      ],
      "next": []
    },
    {
      "name": "--dump",
      "tip": [
        "Don't check links, just dump all extracted links"
      ]
    },
    {
      "name": "--dump-inputs",
      "tip": [
        "Don't check links, just dump all input sources"
      ]
    },
    {
      "name": "--exclude",
      "usage": [
        "--exclude <EXCLUDE>"
      ],
      "tip": [
        "Exclude URLs and mail addresses from checking"
      ],
      "next": []
    },
    {
      "name": "--exclude-all-private",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --exclude-all-private"
      ],
      "tip": [
        "Exclude all private IPs from checking"
      ]
    },
    {
      "name": "--exclude-path",
      "usage": [
        "--exclude-path <PATH>"
      ],
      "tip": [
        "Exclude paths from getting checked"
      ],
      "next": []
    },
    {
      "name": "--extensions",
      "usage": [
        "--extensions <EXTENSIONS>"
      ],
      "tip": [
        "A list of file extensions to check"
      ],
      "next": []
    },
    {
      "name": "--files-from",
      "usage": [
        "--files-from <PATH>"
      ],
      "tip": [
        "Read input filenames from the given file"
      ],
      "next": []
    },
    {
      "name": "--format",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --format <FORMAT>"
      ],
      "tip": [
        "Output format of final status report"
      ],
      "next": [
        {
          "name": "compact",
          "tip": [
            "Compact format (default)"
          ]
        },
        {
          "name": "detailed",
          "tip": [
            "Detailed format"
          ]
        },
        {
          "name": "json",
          "tip": [
            "JSON format"
          ]
        },
        {
          "name": "junit",
          "tip": [
            "JUnit format"
          ]
        },
        {
          "name": "markdown",
          "tip": [
            "Markdown format"
          ]
        }
      ]
    },
    {
      "name": "--generate",
      "usage": [
        "--generate <KIND>"
      ],
      "tip": [
        "Generate special output instead of checking"
      ],
      "next": [
        {
          "name": "complete-bash",
          "tip": [
            "Generate Bash completion"
          ]
        },
        {
          "name": "complete-elvish",
          "tip": [
            "Generate Elvish completion"
          ]
        },
        {
          "name": "complete-fish",
          "tip": [
            "Generate Fish completion"
          ]
        },
        {
          "name": "complete-powershell",
          "tip": [
            "Generate PowerShell completion"
          ]
        },
        {
          "name": "complete-zsh",
          "tip": [
            "Generate Zsh completion"
          ]
        },
        {
          "name": "man",
          "tip": [
            "Generate man page"
          ]
        }
      ]
    },
    {
      "name": "--github-token",
      "usage": [
        "--github-token <TOKEN>"
      ],
      "tip": [
        "GitHub API token for checking github.com links"
      ],
      "next": []
    },
    {
      "name": "--header",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --header <HEADER:VALUE>"
      ],
      "tip": [
        "Set custom header for requests"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    },
    {
      "name": "--hidden",
      "tip": [
        "Do not skip hidden directories and files"
      ]
    },
    {
      "name": "--include",
      "usage": [
        "--include <INCLUDE>"
      ],
      "tip": [
        "URLs to check (supports regex)"
      ],
      "next": []
    },
    {
      "name": "--include-mail",
      "tip": [
        "Also check email addresses"
      ]
    },
    {
      "name": "--insecure",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --insecure"
      ],
      "tip": [
        "Proceed for insecure server connections"
      ]
    },
    {
      "name": "--max-concurrency",
      "usage": [
        "--max-concurrency <NUM>"
      ],
      "tip": [
        "Maximum number of concurrent network requests"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    },
    {
      "name": "--max-redirects",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --max-redirects <MAX>"
      ],
      "tip": [
        "Maximum number of allowed redirects"
      ],
      "next": []
    },
    {
      "name": "--max-retries",
      "usage": [
        "--max-retries <NUM>"
      ],
      "tip": [
        "Maximum number of retries per request"
      ],
      "next": []
    },
    {
      "name": "--method",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --method <METHOD>"
      ],
      "tip": [
        "Request method"
      ],
      "next": [
        {
          "name": "get",
          "tip": [
            "GET method (default)"
          ]
        },
        {
          "name": "head",
          "tip": [
            "HEAD method"
          ]
        },
        {
          "name": "post",
          "tip": [
            "POST method"
          ]
        }
      ]
    },
    {
      "name": "--min-tls",
      "usage": [
        "--min-tls <VERSION>"
      ],
      "tip": [
        "Minimum accepted TLS version"
      ],
      "next": [
        {
          "name": "TLSv1_0",
          "tip": [
            "TLS 1.0"
          ]
        },
        {
          "name": "TLSv1_1",
          "tip": [
            "TLS 1.1"
          ]
        },
        {
          "name": "TLSv1_2",
          "tip": [
            "TLS 1.2"
          ]
        },
        {
          "name": "TLSv1_3",
          "tip": [
            "TLS 1.3"
          ]
        }
      ]
    },
    {
      "name": "--mode",
      "usage": [
        "--mode <MODE>"
      ],
      "tip": [
        "Set the output display mode"
      ],
      "next": [
        {
          "name": "color",
          "tip": [
            "Colored output (default)"
          ]
        },
        {
          "name": "emoji",
          "tip": [
            "Emoji output"
          ]
        },
        {
          "name": "plain",
          "tip": [
            "Plain text"
          ]
        },
        {
          "name": "task",
          "tip": [
            "Task output"
          ]
        }
      ]
    },
    {
      "name": "--no-ignore",
      "tip": [
        "Do not skip files ignored by .gitignore"
      ]
    },
    {
      "name": "--no-progress",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-progress"
      ],
      "tip": [
        "Do not show progress bar"
      ]
    },
    {
      "name": "--offline",
      "tip": [
        "Only check local files and block network requests"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <FILE>"
      ],
      "tip": [
        "Output file of status report"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Less output per occurrence"
      ]
    },
    {
      "name": "--remap",
      "usage": [
        "--remap <REMAP>"
      ],
      "tip": [
        "Remap URI matching pattern to different URI"
      ],
      "next": []
    },
    {
      "name": "--require-https",
      "tip": [
        "When HTTPS is available, treat HTTP links as errors"
      ]
    },
    {
      "name": "--retry-wait-time",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --retry-wait-time <SECONDS>"
      ],
      "tip": [
        "Minimum wait time in seconds between retries"
      ],
      "next": [
        {
          "name": "30"
        },
        {
          "name": "5"
        },
        {
          "name": "60"
        }
      ]
    },
    {
      "name": "--root-dir",
      "usage": [
        "--root-dir <DIR>"
      ],
      "tip": [
        "Root directory for resolving absolute links in local files"
      ],
      "next": []
    },
    {
      "name": "--scheme",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --scheme <SCHEME>"
      ],
      "tip": [
        "Only test links with the given schemes"
      ],
      "next": []
    },
    {
      "name": "--skip-missing",
      "tip": [
        "Skip missing input files"
      ]
    },
    {
      "name": "--suggest",
      "tip": [
        "Suggest link replacements for broken links using a web archive"
      ]
    },
    {
      "name": "--threads",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --threads <THREADS>"
      ],
      "tip": [
        "Number of threads to utilize"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    },
    {
      "name": "--timeout",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --timeout <TIMEOUT>"
      ],
      "tip": [
        "Website timeout in seconds"
      ],
      "next": []
    },
    {
      "name": "--user-agent",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user-agent <AGENT>"
      ],
      "tip": [
        "User agent"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Set verbosity level"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ]
}
