{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "丢弃已挂载文件系统上未使用的块。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "修剪已挂载的文件系统。"
      ]
    },
    {
      "name": "--dry-run",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --dry-run"
      ],
      "tip": [
        "执行所有操作，但不实际修剪。"
      ]
    },
    {
      "name": "--fstab",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --fstab"
      ],
      "tip": [
        "修剪 /etc/fstab 中的文件系统。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --length <num>"
      ],
      "tip": [
        "要丢弃的字节数。"
      ],
      "next": []
    },
    {
      "name": "--listed-in",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --listed-in <list>"
      ],
      "tip": [
        "修剪指定文件中列出的文件系统。"
      ],
      "next": []
    },
    {
      "name": "--minimum",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --minimum <num>"
      ],
      "tip": [
        "要丢弃的最小 extent 长度。"
      ],
      "next": []
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <num>"
      ],
      "tip": [
        "开始丢弃的字节偏移量。"
      ],
      "next": []
    },
    {
      "name": "--quiet-unsupported",
      "tip": [
        "在不支持修剪时抑制错误消息。"
      ]
    },
    {
      "name": "--types",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --types <list>"
      ],
      "tip": [
        "限制文件系统类型。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "打印丢弃的字节数。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
