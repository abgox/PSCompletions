{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Discard unused blocks on a mounted filesystem."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Trim mounted filesystems."
      ]
    },
    {
      "name": "--dry-run",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --dry-run"
      ],
      "tip": [
        "Does everything, but trim."
      ]
    },
    {
      "name": "--fstab",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --fstab"
      ],
      "tip": [
        "Trim filesystems from /etc/fstab."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --length <num>"
      ],
      "tip": [
        "The number of bytes to discard."
      ],
      "next": []
    },
    {
      "name": "--listed-in",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --listed-in <list>"
      ],
      "tip": [
        "Trim filesystems listed in specified files."
      ],
      "next": []
    },
    {
      "name": "--minimum",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --minimum <num>"
      ],
      "tip": [
        "The minimum extent length to discard."
      ],
      "next": []
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <num>"
      ],
      "tip": [
        "The offset in bytes to start discarding from."
      ],
      "next": []
    },
    {
      "name": "--quiet-unsupported",
      "tip": [
        "Suppress error messages if trim is unsupported."
      ]
    },
    {
      "name": "--types",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --types <list>"
      ],
      "tip": [
        "Limit the set of filesystem types."
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Print number of discarded bytes."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
