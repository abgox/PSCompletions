{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "以调整后的优先级运行 COMMAND，该值会影响进程调度。"
    ]
  },
  "option": [
    {
      "name": "--adjustment",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --adjustment <N>"
      ],
      "tip": [
        "在优先级上加上整数 N（默认 10）"
      ],
      "next": [
        {
          "name": "10"
        },
        {
          "name": "19"
        },
        {
          "name": "5"
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
