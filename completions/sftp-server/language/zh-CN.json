{
  "meta": {
    "url": "https://www.openssh.com",
    "description": [
      "OpenSSH 的 SFTP 服务器子系统。"
    ]
  },
  "option": [
    {
      "name": "-d",
      "usage": [
        "-d <start_directory>"
      ],
      "tip": [
        "为用户指定备用的起始目录。",
        "默认使用用户的主目录。",
        "路径可以包含 %d（已认证用户的主目录）、%u（用户名）以及 %%（字面 %）。"
      ],
      "next": []
    },
    {
      "name": "-e",
      "tip": [
        "将日志信息打印到 stderr 而不是 syslog，用于调试。"
      ]
    },
    {
      "name": "-f",
      "usage": [
        "-f <log_facility>"
      ],
      "tip": [
        "指定记录日志时使用的 facility 代码。",
        "可能值: DAEMON, USER, AUTH, LOCAL0, LOCAL1, LOCAL2, LOCAL3, LOCAL4, LOCAL5, LOCAL6, LOCAL7",
        "默认为 AUTH。"
      ],
      "next": [
        {
          "name": "AUTH"
        },
        {
          "name": "DAEMON"
        },
        {
          "name": "LOCAL0"
        },
        {
          "name": "LOCAL1"
        },
        {
          "name": "LOCAL2"
        },
        {
          "name": "LOCAL3"
        },
        {
          "name": "LOCAL4"
        },
        {
          "name": "LOCAL5"
        },
        {
          "name": "LOCAL6"
        },
        {
          "name": "LOCAL7"
        },
        {
          "name": "USER"
        }
      ]
    },
    {
      "name": "-h",
      "tip": [
        "显示用法信息。"
      ]
    },
    {
      "name": "-l",
      "usage": [
        "-l <log_level>"
      ],
      "tip": [
        "指定记录哪些级别的消息。",
        "可能值: QUIET, FATAL, ERROR, INFO, VERBOSE, DEBUG, DEBUG1, DEBUG2, DEBUG3",
        "默认为 ERROR。"
      ],
      "next": [
        {
          "name": "DEBUG"
        },
        {
          "name": "DEBUG1"
        },
        {
          "name": "DEBUG2"
        },
        {
          "name": "DEBUG3"
        },
        {
          "name": "ERROR"
        },
        {
          "name": "FATAL"
        },
        {
          "name": "INFO"
        },
        {
          "name": "QUIET"
        },
        {
          "name": "VERBOSE"
        }
      ]
    },
    {
      "name": "-p",
      "usage": [
        "-p <allowed_requests>"
      ],
      "tip": [
        "指定服务器允许的 SFTP 请求列表，以逗号分隔。",
        "其余请求会被记录并拒绝。",
        "运行 sftp-server -Q requests 可查看支持的请求名。"
      ],
      "next": [
        {
          "name": "close"
        },
        {
          "name": "copy-data"
        },
        {
          "name": "expand-path"
        },
        {
