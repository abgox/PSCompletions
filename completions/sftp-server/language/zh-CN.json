      "name": "-P",
      "usage": [
        "-P <denied_requests>"
      ],
      "tip": [
        "指定服务器必须拒绝的 SFTP 请求列表，以逗号分隔。",
        "运行 sftp-server -Q requests 可查看支持的请求名。"
      ],
