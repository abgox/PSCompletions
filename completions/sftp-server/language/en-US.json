{
  "meta": {
    "url": "https://www.openssh.com",
    "description": [
      "OpenSSH SFTP server subsystem."
    ]
  },
  "option": [
    {
      "name": "-d",
      "usage": [
        "-d <start_directory>"
      ],
      "tip": [
        "Specify an alternate starting directory for users.",
        "The default is the user's home directory.",
        "The path may contain %d (the authenticated user's home directory), %u (user name) and %% (a literal %)."
      ],
      "next": []
    },
    {
      "name": "-e",
      "tip": [
        "Print logging information to stderr instead of syslog for debugging."
      ]
    },
    {
      "name": "-f",
      "usage": [
        "-f <log_facility>"
      ],
      "tip": [
        "Specify the facility code used when logging messages.",
        "Possible values: DAEMON, USER, AUTH, LOCAL0, LOCAL1, LOCAL2, LOCAL3, LOCAL4, LOCAL5, LOCAL6, LOCAL7",
        "The default is AUTH."
      ],
      "next": [
        {
          "name": "AUTH"
        },
        {
          "name": "DAEMON"
        },
        {
          "name": "LOCAL0"
        },
        {
          "name": "LOCAL1"
        },
        {
          "name": "LOCAL2"
        },
        {
          "name": "LOCAL3"
        },
        {
          "name": "LOCAL4"
        },
        {
          "name": "LOCAL5"
        },
        {
          "name": "LOCAL6"
        },
        {
          "name": "LOCAL7"
        },
        {
          "name": "USER"
        }
      ]
    },
    {
      "name": "-h",
      "tip": [
        "Display usage information."
      ]
    },
    {
      "name": "-l",
      "usage": [
        "-l <log_level>"
      ],
      "tip": [
        "Specify which messages will be logged.",
        "Possible values: QUIET, FATAL, ERROR, INFO, VERBOSE, DEBUG, DEBUG1, DEBUG2, DEBUG3",
        "The default is ERROR."
      ],
      "next": [
        {
          "name": "DEBUG"
        },
        {
          "name": "DEBUG1"
        },
        {
          "name": "DEBUG2"
        },
        {
          "name": "DEBUG3"
        },
        {
          "name": "ERROR"
        },
        {
          "name": "FATAL"
        },
        {
          "name": "INFO"
        },
        {
          "name": "QUIET"
        },
        {
          "name": "VERBOSE"
        }
      ]
    },
    {
      "name": "-p",
      "usage": [
        "-p <allowed_requests>"
      ],
      "tip": [
        "Specify a comma-separated list of SFTP requests the server must permit.",
        "All other requests are logged and refused.",
        "Run sftp-server -Q requests for the supported request names."
      ],
      "next": [
