    {
      "name": "-Q",
      "usage": [
        "-Q <protocol_feature>"
      ],
      "tip": [
        "Query protocol features supported by the server.",
        "At present the only feature is requests."
      ],
      "next": [
        {
          "name": "requests"
        }
      ]
    },
    {
      "name": "-R",
      "tip": [
        "Place this instance into read-only mode.",
        "File writes and other operations that change the filesystem are denied."
      ]
    },
    {
      "name": "-u",
      "usage": [
        "-u <umask>"
      ],
      "tip": [
        "Set an explicit umask for newly created files and directories.",
        "The value is octal; the user's default mask is used when omitted."
      ],
