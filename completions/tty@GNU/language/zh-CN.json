{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "打印与标准输入相连的终端的文件名。"
    ]
  },
  "option": [
    {
      "name": "--silent",
      "alias": [
        "--quiet",
        "-s"
      ],
      "usage": [
        "-s, --quiet, --silent"
      ],
      "tip": [
        "不打印任何内容，只返回退出状态"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
