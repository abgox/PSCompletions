{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "设置和控制 zram 设备。"
    ]
  },
  "option": [
    {
      "name": "--algorithm",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --algorithm <alg>"
      ],
      "tip": [
        "要使用的压缩算法。",
        "可能值: lzo, lz4, lz4hc, deflate, 842, zstd"
      ],
      "next": [
        {
          "name": "842"
        },
        {
          "name": "deflate"
        },
        {
          "name": "lz4"
        },
        {
          "name": "lz4hc"
        },
        {
          "name": "lzo"
        },
        {
          "name": "zstd"
        }
      ]
    },
    {
      "name": "--algorithm-params",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --algorithm-params <params>"
      ],
      "tip": [
        "要使用的算法参数。"
      ],
      "next": []
    },
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "以字节而不是人类可读格式打印大小。"
      ]
    },
    {
      "name": "--find",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --find"
      ],
      "tip": [
        "查找一个空闲设备。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "不打印标题。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "用于状态输出的列。"
      ],
      "separator": ",",
      "next": [
        {
          "name": "ALGORITHM",
          "tip": [
            "所选的压缩算法。"
          ]
        },
        {
          "name": "COMP-RATIO",
          "tip": [
            "压缩比: DATA/TOTAL。"
          ]
        },
        {
          "name": "COMPR",
          "tip": [
            "存储数据的压缩后大小。"
          ]
        },
        {
          "name": "DATA",
          "tip": [
            "存储数据的未压缩大小。"
          ]
        },
        {
          "name": "DISKSIZE",
          "tip": [
            "未压缩数据量的上限。"
          ]
        },
        {
          "name": "MEM-LIMIT",
          "tip": [
            "用于存储压缩数据的内存上限。"
          ]
        },
        {
          "name": "MEM-USED",
          "tip": [
            "用于存储压缩数据的峰值内存用量。"
          ]
        },
        {
          "name": "MIGRATED",
          "tip": [
            "由压缩迁移的对象数。"
          ]
        },
        {
          "name": "MOUNTPOINT",
          "tip": [
            "设备挂载的位置。"
          ]
        },
        {
          "name": "NAME",
          "tip": [
            "zram 设备名称。"
          ]
        },
        {
          "name": "STREAMS",
          "tip": [
            "并发压缩操作数。"
          ]
        },
        {
          "name": "TOTAL",
          "tip": [
            "包含分配器碎片和元数据开销的所有内存。"
          ]
        },
        {
          "name": "ZERO-PAGES",
          "tip": [
            "没有分配内存的空页。"
          ]
        }
      ]
    },
    {
      "name": "--output-all",
      "tip": [
        "输出所有列。"
      ]
    },
    {
      "name": "--raw",
      "tip": [
        "使用原始状态输出格式。"
      ]
    },
    {
      "name": "--reset",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reset"
      ],
      "tip": [
        "重置所有指定的设备。"
      ]
    },
    {
      "name": "--size",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --size <size>"
      ],
      "tip": [
        "设备大小。"
      ],
      "next": []
    },
    {
      "name": "--streams",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --streams <number>"
      ],
      "tip": [
        "压缩流数量。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
