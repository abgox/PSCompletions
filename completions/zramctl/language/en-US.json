{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Set up and control zram devices."
    ]
  },
  "option": [
    {
      "name": "--algorithm",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --algorithm <alg>"
      ],
      "tip": [
        "Compression algorithm to use.",
        "Possible values: lzo, lz4, lz4hc, deflate, 842, zstd"
      ],
      "next": [
        {
          "name": "842"
        },
        {
          "name": "deflate"
        },
        {
          "name": "lz4"
        },
        {
          "name": "lz4hc"
        },
        {
          "name": "lzo"
        },
        {
          "name": "zstd"
        }
      ]
    },
    {
      "name": "--algorithm-params",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --algorithm-params <params>"
      ],
      "tip": [
        "Algorithm parameters to use."
      ],
      "next": []
    },
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "Print sizes in bytes rather than in human readable format."
      ]
    },
    {
      "name": "--find",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --find"
      ],
      "tip": [
        "Find a free device."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "Don't print headings."
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "Columns to use for status output."
      ],
      "separator": ",",
      "next": [
        {
          "name": "ALGORITHM",
          "tip": [
            "The selected compression algorithm."
          ]
        },
        {
          "name": "COMP-RATIO",
          "tip": [
            "Compression ratio: DATA/TOTAL."
          ]
        },
        {
          "name": "COMPR",
          "tip": [
            "Compressed size of stored data."
          ]
        },
        {
          "name": "DATA",
          "tip": [
            "Uncompressed size of stored data."
          ]
        },
        {
          "name": "DISKSIZE",
          "tip": [
            "Limit on the uncompressed amount of data."
          ]
        },
        {
          "name": "MEM-LIMIT",
          "tip": [
            "Memory limit used to store compressed data."
          ]
        },
        {
          "name": "MEM-USED",
          "tip": [
            "Peak memory usage to store compressed data."
          ]
        },
        {
          "name": "MIGRATED",
          "tip": [
            "Number of objects migrated by compaction."
          ]
        },
        {
          "name": "MOUNTPOINT",
          "tip": [
            "Where the device is mounted."
          ]
        },
        {
          "name": "NAME",
          "tip": [
            "zram device name."
          ]
        },
        {
          "name": "STREAMS",
          "tip": [
            "Number of concurrent compress operations."
          ]
        },
        {
          "name": "TOTAL",
          "tip": [
            "All memory including allocator fragmentation and metadata overhead."
          ]
        },
        {
          "name": "ZERO-PAGES",
          "tip": [
            "Empty pages with no allocated memory."
          ]
        }
      ]
    },
    {
      "name": "--output-all",
      "tip": [
        "Output all columns."
      ]
    },
    {
      "name": "--raw",
      "tip": [
        "Use raw status output format."
      ]
    },
    {
      "name": "--reset",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reset"
      ],
      "tip": [
        "Reset all specified devices."
      ]
    },
    {
      "name": "--size",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --size <size>"
      ],
      "tip": [
        "Device size."
      ],
      "next": []
    },
    {
      "name": "--streams",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --streams <number>"
      ],
      "tip": [
        "Number of compression streams."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
