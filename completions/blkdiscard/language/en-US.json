{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Discard the content of sectors on a device."
    ]
  },
  "option": [
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "Disable all checking."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --length <num>"
      ],
      "tip": [
        "Length of bytes to discard from the offset."
      ],
      "next": []
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <num>"
      ],
      "tip": [
        "Offset in bytes to discard from."
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Suppress warning messages."
      ]
    },
    {
      "name": "--secure",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --secure"
      ],
      "tip": [
        "Perform secure discard."
      ]
    },
    {
      "name": "--step",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --step <num>"
      ],
      "tip": [
        "Size of the discard iterations within the offset."
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Print aligned length and offset."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--zeroout",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zeroout"
      ],
      "tip": [
        "Zero-fill rather than discard."
      ]
    }
  ]
}
