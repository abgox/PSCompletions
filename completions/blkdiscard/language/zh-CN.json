{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "丢弃设备上扇区的内容。"
    ]
  },
  "option": [
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "禁用所有检查。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --length <num>"
      ],
      "tip": [
        "从偏移处开始丢弃的字节数。"
      ],
      "next": []
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <num>"
      ],
      "tip": [
        "开始丢弃的字节偏移量。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制警告消息。"
      ]
    },
    {
      "name": "--secure",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --secure"
      ],
      "tip": [
        "执行安全丢弃。"
      ]
    },
    {
      "name": "--step",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --step <num>"
      ],
      "tip": [
        "偏移范围内每次丢弃迭代的大小。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "打印对齐后的长度和偏移。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--zeroout",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zeroout"
      ],
      "tip": [
        "使用零填充而不是丢弃。"
      ]
    }
  ]
}
