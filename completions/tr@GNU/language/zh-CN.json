{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "对标准输入中的字符做转换、压缩和/或删除，结果写入标准输出。"
    ]
  },
  "option": [
    {
      "name": "--complement",
      "alias": [
        "-C",
        "-c"
      ],
      "usage": [
        "-C, -c, --complement"
      ],
      "tip": [
        "使用 ARRAY1 的补集"
      ]
    },
    {
      "name": "--delete",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delete"
      ],
      "tip": [
        "删除 ARRAY1 中的字符，不做转换"
      ]
    },
    {
      "name": "--squeeze-repeats",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squeeze-repeats"
      ],
      "tip": [
        "把最后一个指定 ARRAY 中列出的字符的连续重复压缩为该字符的一次出现"
      ]
    },
    {
      "name": "--truncate-set1",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --truncate-set1"
      ],
      "tip": [
        "先把 ARRAY1 截断到与 ARRAY2 相同的长度"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
