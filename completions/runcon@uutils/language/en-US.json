{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Run command with specified security context under SELinux enabled systems."
    ]
  },
  "option": [
    {
      "name": "--compute",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --compute"
      ],
      "tip": [
        "Compute process transition context before modifying"
      ]
    },
    {
      "name": "--range",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --range <RANGE>"
      ],
      "tip": [
        "Set range RANGE in the target security context"
      ],
      "next": []
    },
    {
      "name": "--role",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --role <ROLE>"
      ],
      "tip": [
        "Set role ROLE in the target security context"
      ],
      "next": []
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "Set type TYPE in the target security context"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <USER>"
      ],
      "tip": [
        "Set user USER in the target security context"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
