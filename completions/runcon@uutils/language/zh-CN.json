{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "在启用 SELinux 的系统上以指定的安全上下文运行命令"
    ]
  },
  "option": [
    {
      "name": "--compute",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --compute"
      ],
      "tip": [
        "修改前先计算进程转换上下文"
      ]
    },
    {
      "name": "--range",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --range <RANGE>"
      ],
      "tip": [
        "在目标安全上下文中设置范围 RANGE"
      ],
      "next": []
    },
    {
      "name": "--role",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --role <ROLE>"
      ],
      "tip": [
        "在目标安全上下文中设置角色 ROLE"
      ],
      "next": []
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "在目标安全上下文中设置类型 TYPE"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <USER>"
      ],
      "tip": [
        "在目标安全上下文中设置用户 USER"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
