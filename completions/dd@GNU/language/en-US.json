{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "Copy a file, converting and formatting according to the operands."
    ]
  },
  "option": [
    {
      "name": "bs",
      "usage": [
        "bs=<BYTES>"
      ],
      "tip": [
        "read and write up to BYTES bytes at a time (default: 512); overrides ibs and obs"
      ],
      "next": [
        {
          "name": "1K"
        },
        {
          "name": "1M"
        },
        {
          "name": "512"
        }
      ]
    },
    {
      "name": "cbs",
      "usage": [
        "cbs=<BYTES>"
      ],
      "tip": [
        "convert BYTES bytes at a time"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "1K"
        },
        {
          "name": "512"
        }
      ]
    },
    {
      "name": "conv",
      "usage": [
        "conv=<CONVS>"
      ],
      "tip": [
        "convert the file as per the comma separated symbol list"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "count",
      "usage": [
        "count=<N>"
      ],
      "tip": [
        "copy only N input blocks"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "10"
        },
        {
          "name": "100"
        }
      ]
    },
    {
      "name": "ibs",
      "usage": [
        "ibs=<BYTES>"
      ],
      "tip": [
        "read up to BYTES bytes at a time (default: 512)"
      ],
      "next": [
        {
          "name": "1K"
        },
        {
          "name": "1M"
        },
        {
          "name": "512"
        }
      ]
    },
    {
      "name": "if",
      "usage": [
        "if=<FILE>"
      ],
      "tip": [
        "read from FILE instead of stdin"
      ],
      "next": []
    },
    {
      "name": "iflag",
      "usage": [
        "iflag=<FLAGS>"
      ],
      "tip": [
        "read as per the comma separated symbol list"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "obs",
      "usage": [
        "obs=<BYTES>"
      ],
      "tip": [
        "write BYTES bytes at a time (default: 512)"
      ],
      "next": [
        {
          "name": "1K"
        },
        {
          "name": "1M"
        },
        {
          "name": "512"
        }
      ]
    },
    {
      "name": "of",
      "usage": [
        "of=<FILE>"
      ],
      "tip": [
        "write to FILE instead of stdout"
      ],
      "next": []
    },
    {
      "name": "oflag",
      "usage": [
        "oflag=<FLAGS>"
      ],
      "tip": [
        "write as per the comma separated symbol list"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "seek",
      "usage": [
        "seek=<N>"
      ],
      "tip": [
        "(or oseek=N) skip N obs-sized output blocks"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "10"
        },
        {
          "name": "100"
        }
      ]
    },
    {
      "name": "skip",
      "usage": [
        "skip=<N>"
      ],
      "tip": [
        "(or iseek=N) skip N ibs-sized input blocks"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "10"
        },
        {
          "name": "100"
        }
      ]
    },
    {
      "name": "status",
      "usage": [
        "status=<LEVEL>"
      ],
      "tip": [
        "The LEVEL of information to print to stderr; 'none' suppresses everything but error messages, 'noxfer' suppresses the final transfer statistics, 'progress' shows periodic transfer statistics"
      ],
      "next": [
        {
          "name": "none"
        },
        {
          "name": "noxfer"
        },
        {
          "name": "progress"
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "display this help and exit"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "output version information and exit"
      ]
    }
  ]
}
