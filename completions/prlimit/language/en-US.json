{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Show or change the resource limits of a process.",
      "A resource option used bare prints the limit; set it with --<resource>=<limit>.",
      "The short forms glue the value, e.g. -c<limit>."
    ]
  },
