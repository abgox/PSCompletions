{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "打印或校验校验和。"
    ]
  },
  "option": [
    {
      "name": "--algorithm",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --algorithm <TYPE>"
      ],
      "tip": [
        "选择要使用的摘要类型。参见下方 DIGEST"
      ],
      "next": [
        {
          "name": "blake2b"
        },
        {
          "name": "bsd"
        },
        {
          "name": "crc"
        },
        {
          "name": "crc32b"
        },
        {
          "name": "md5"
        },
        {
          "name": "sha1"
        },
        {
          "name": "sha224"
        },
        {
          "name": "sha256"
        },
        {
          "name": "sha384"
        },
        {
          "name": "sha512"
        },
        {
          "name": "sm3"
        },
        {
          "name": "sysv"
        }
      ]
    },
    {
      "name": "--base64",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --base64"
      ],
      "tip": [
        "输出 base64 编码的摘要，而不是十六进制"
      ]
    },
    {
      "name": "--check",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --check"
      ],
      "tip": [
        "从这些文件中读取校验和并逐一校验"
      ]
    },
    {
      "name": "--debug",
      "tip": [
        "指明所使用的实现"
      ]
    },
    {
      "name": "--ignore-missing",
      "tip": [
        "对缺失的文件不失败，也不报告状态"
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --length <BITS>"
      ],
      "tip": [
        "摘要长度，以位为单位；不得超过 blake2 算法的上限，且必须是 8 的倍数"
      ],
      "next": [
        {
          "name": "128"
        },
        {
          "name": "256"
        },
        {
          "name": "512"
        }
      ]
    },
    {
      "name": "--quiet",
      "tip": [
        "对每个校验成功的文件都不打印 OK"
      ]
    },
    {
      "name": "--raw",
      "tip": [
        "输出原始二进制摘要，而不是十六进制"
      ]
    },
    {
      "name": "--status",
      "tip": [
        "不输出任何内容，通过状态码表示成功"
      ]
    },
    {
      "name": "--strict",
      "tip": [
        "遇到格式不正确的校验行时以非零状态退出"
      ]
    },
    {
      "name": "--tag",
      "tip": [
        "生成 BSD 风格的校验和（默认）"
      ]
    },
    {
      "name": "--text",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --text"
      ],
      "tip": [
        "以文本模式读取（默认）"
      ]
    },
    {
      "name": "--untagged",
      "tip": [
        "生成反转风格的校验和，不含摘要类型"
      ]
    },
    {
      "name": "--warn",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --warn"
      ],
      "tip": [
        "对格式不正确的校验行发出警告"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "每行输出以 NUL 结尾而不是换行符，并禁用文件名转义"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
