{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "Print or verify checksums."
    ]
  },
  "option": [
    {
      "name": "--algorithm",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --algorithm <TYPE>"
      ],
      "tip": [
        "select the digest type to use. See DIGEST below"
      ],
      "next": [
        {
          "name": "blake2b"
        },
        {
          "name": "bsd"
        },
        {
          "name": "crc"
        },
        {
          "name": "crc32b"
        },
        {
          "name": "md5"
        },
        {
          "name": "sha1"
        },
        {
          "name": "sha224"
        },
        {
          "name": "sha256"
        },
        {
          "name": "sha384"
        },
        {
          "name": "sha512"
        },
        {
          "name": "sm3"
        },
        {
          "name": "sysv"
        }
      ]
    },
    {
      "name": "--base64",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --base64"
      ],
      "tip": [
        "emit base64-encoded digests, not hexadecimal"
      ]
    },
    {
      "name": "--check",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --check"
      ],
      "tip": [
        "read checksums from the FILEs and check them"
      ]
    },
    {
      "name": "--debug",
      "tip": [
        "indicate which implementation used"
      ]
    },
    {
      "name": "--ignore-missing",
      "tip": [
        "don't fail or report status for missing files"
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --length <BITS>"
      ],
      "tip": [
        "digest length in bits; must not exceed the max for the blake2 algorithm and must be a multiple of 8"
      ],
      "next": [
        {
          "name": "128"
        },
        {
          "name": "256"
        },
        {
          "name": "512"
        }
      ]
    },
    {
      "name": "--quiet",
      "tip": [
        "don't print OK for each successfully verified file"
      ]
    },
    {
      "name": "--raw",
      "tip": [
        "emit a raw binary digest, not hexadecimal"
      ]
    },
    {
      "name": "--status",
      "tip": [
        "don't output anything, status code shows success"
      ]
    },
    {
      "name": "--strict",
      "tip": [
        "exit non-zero for improperly formatted checksum lines"
      ]
    },
    {
      "name": "--tag",
      "tip": [
        "create a BSD-style checksum (the default)"
      ]
    },
    {
      "name": "--text",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --text"
      ],
      "tip": [
        "read in text mode (default)"
      ]
    },
    {
      "name": "--untagged",
      "tip": [
        "create a reversed style checksum, without digest type"
      ]
    },
    {
      "name": "--warn",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --warn"
      ],
      "tip": [
        "warn about improperly formatted checksum lines"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "end each output line with NUL, not newline, and disable file name escaping"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "display this help and exit"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "output version information and exit"
      ]
    }
  ]
}
