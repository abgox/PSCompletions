{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Generate and print 128-bit identifiers."
    ]
  },
  "next": [
    {
      "name": "boot-id",
      "tip": [
        "Print the ID of the current boot."
      ]
    },
    {
      "name": "help",
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "invocation-id",
      "tip": [
        "Print the ID of the current invocation."
      ]
    },
    {
      "name": "machine-id",
      "tip": [
        "Print the ID of the current machine."
      ]
    },
    {
      "name": "new",
      "tip": [
        "Generate a new ID."
      ]
    },
    {
      "name": "show",
      "usage": [
        "show [NAME|UUID]"
      ],
      "tip": [
        "Print one or more UUIDs."
      ]
    },
    {
      "name": "var-partition-uuid",
      "tip": [
        "Print the UUID for the /var/ partition."
      ]
    }
  ],
  "option": [
    {
      "name": "--app-specific",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --app-specific=ID"
      ],
      "tip": [
        "Generate app-specific IDs."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--json",
      "usage": [
        "--json=FORMAT"
      ],
      "tip": [
        "Output inspection data as JSON.",
        "Possible values: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "Do not show the headers and footers."
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--pretty",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pretty"
      ],
      "tip": [
        "Generate samples of program code."
      ]
    },
    {
      "name": "--uuid",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uuid"
      ],
      "tip": [
        "Output in UUID format."
      ]
    },
    {
      "name": "--value",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --value"
      ],
      "tip": [
        "Only print the value."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    },
    {
      "name": "-j",
      "tip": [
        "Equivalent to --json=pretty on a TTY, --json=short otherwise."
      ]
    }
  ]
}
