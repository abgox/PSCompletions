{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "生成并打印 128 位标识符。"
    ]
  },
  "next": [
    {
      "name": "boot-id",
      "tip": [
        "打印当前启动的 ID。"
      ]
    },
    {
      "name": "help",
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "invocation-id",
      "tip": [
        "打印当前调用的 ID。"
      ]
    },
    {
      "name": "machine-id",
      "tip": [
        "打印当前机器的 ID。"
      ]
    },
    {
      "name": "new",
      "tip": [
        "生成一个新 ID。"
      ]
    },
    {
      "name": "show",
      "usage": [
        "show [NAME|UUID]"
      ],
      "tip": [
        "打印一个或多个 UUID。"
      ]
    },
    {
      "name": "var-partition-uuid",
      "tip": [
        "打印 /var/ 分区的 UUID。"
      ]
    }
  ],
  "option": [
    {
      "name": "--app-specific",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --app-specific=ID"
      ],
      "tip": [
        "生成应用特定的 ID。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--json",
      "usage": [
        "--json=FORMAT"
      ],
      "tip": [
        "以 JSON 输出检查数据。",
        "可能值: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "不显示页眉和页脚。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--pretty",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pretty"
      ],
      "tip": [
        "生成程序代码示例。"
      ]
    },
    {
      "name": "--uuid",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uuid"
      ],
      "tip": [
        "以 UUID 格式输出。"
      ]
    },
    {
      "name": "--value",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --value"
      ],
      "tip": [
        "仅打印值。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "-j",
      "tip": [
        "在 TTY 上等同于 --json=pretty，否则等同于 --json=short。"
      ]
    }
  ]
}
