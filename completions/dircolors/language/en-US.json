{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Output commands to set the LS_COLORS environment variable."
    ]
  },
  "option": [
    {
      "name": "--bourne-shell",
      "alias": [
        "--sh",
        "-b"
      ],
      "usage": [
        "-b, --sh, --bourne-shell"
      ],
      "tip": [
        "output Bourne shell code to set LS_COLORS"
      ]
    },
    {
      "name": "--c-shell",
      "alias": [
        "--csh",
        "-c"
      ],
      "usage": [
        "-c, --csh, --c-shell"
      ],
      "tip": [
        "output C shell code to set LS_COLORS"
      ]
    },
    {
      "name": "--print-database",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --print-database"
      ],
      "tip": [
        "print the byte counts"
      ]
    },
    {
      "name": "--print-ls-colors",
      "tip": [
        "output fully escaped colors for display"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show the help."
      ]
    }
  ]
}
