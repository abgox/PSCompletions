{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把每个 FILE 的前 10 行打印到标准输出。"
    ]
  },
  "option": [
    {
      "name": "--bytes",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --bytes <[-]NUM>"
      ],
      "tip": [
        "打印每个文件的前 NUM 个字节；带前导 '-' 时，打印除每个文件最后 NUM 个字节之外的全部内容"
      ],
      "next": [
        {
          "name": "-10"
        },
        {
          "name": "10"
        },
        {
          "name": "1024"
        }
      ]
    },
    {
      "name": "--lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --lines <[-]NUM>"
      ],
      "tip": [
        "打印前 NUM 行，而不是前 10 行；带前导 '-' 时，打印除每个文件最后 NUM 行之外的全部内容"
      ],
      "next": [
        {
          "name": "-10"
        },
        {
          "name": "10"
        }
      ]
    },
    {
      "name": "--silent",
      "alias": [
        "--quiet",
        "-q"
      ],
      "usage": [
        "-q, --quiet, --silent"
      ],
      "tip": [
        "从不打印给出文件名的表头"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "总是打印给出文件名的表头"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "行分隔符为 NUL，而不是换行符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
