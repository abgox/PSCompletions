{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Time clocks utility."
    ]
  },
  "option": [
    {
      "name": "--adjfile",
      "usage": [
        "--adjfile <file>"
      ],
      "tip": [
        "Use an alternate file to /etc/adjtime."
      ],
      "next": []
    },
    {
      "name": "--adjust",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --adjust"
      ],
      "tip": [
        "Adjust the RTC to account for systematic drift."
      ]
    },
    {
      "name": "--date",
      "usage": [
        "--date <time>"
      ],
      "tip": [
        "Date/time input for --set and --predict."
      ],
      "next": []
    },
    {
      "name": "--delay",
      "usage": [
        "--delay <sec>"
      ],
      "tip": [
        "Delay used when setting new RTC time."
      ],
      "next": []
    },
    {
      "name": "--directisa",
      "tip": [
        "Use the ISA bus instead of /dev/rtc0 access."
      ]
    },
    {
      "name": "--get",
      "tip": [
        "Display drift corrected RTC time."
      ]
    },
    {
      "name": "--hctosys",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --hctosys"
      ],
      "tip": [
        "Set the system time from the RTC."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--localtime",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --localtime"
      ],
      "tip": [
        "The RTC timescale is Local."
      ]
    },
    {
      "name": "--noadjfile",
      "tip": [
        "Do not use /etc/adjtime."
      ]
    },
    {
      "name": "--param-get",
      "usage": [
        "--param-get <param>"
      ],
      "tip": [
        "Display the RTC parameter.",
        "Aliases: features, correction, bsm"
      ],
      "next": [
        {
          "name": "bsm"
        },
        {
          "name": "correction"
        },
        {
          "name": "features"
        }
      ]
    },
    {
      "name": "--param-index",
      "usage": [
        "--param-index <number>"
      ],
      "tip": [
        "Parameter index (default 0)."
      ],
      "next": []
    },
    {
      "name": "--param-set",
      "usage": [
        "--param-set <param>=<value>"
      ],
      "tip": [
        "Set the RTC parameter."
      ],
      "next": []
    },
    {
      "name": "--predict",
      "tip": [
        "Predict the drifted RTC time according to --date."
      ]
    },
    {
      "name": "--rtc",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --rtc <file>"
      ],
      "tip": [
        "Use an alternate file to /dev/rtc0."
      ],
      "next": []
    },
    {
      "name": "--set",
      "tip": [
        "Set the RTC according to --date."
      ]
    },
    {
      "name": "--show",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --show"
      ],
      "tip": [
        "Display the RTC time."
      ]
    },
    {
      "name": "--systohc",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --systohc"
      ],
      "tip": [
        "Set the RTC from the system time."
      ]
    },
    {
      "name": "--systz",
      "tip": [
        "Send timescale configurations to the kernel."
      ]
    },
    {
      "name": "--test",
      "tip": [
        "Dry run; implies --verbose."
      ]
    },
    {
      "name": "--utc",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --utc"
      ],
      "tip": [
        "The RTC timescale is UTC."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Display more details."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--vl-clear",
      "tip": [
        "Clear voltage low information."
      ]
    },
    {
      "name": "--vl-read",
      "tip": [
        "Read voltage low information."
      ]
    }
  ]
}
