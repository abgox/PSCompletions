{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "时钟工具。"
    ]
  },
  "option": [
    {
      "name": "--adjfile",
      "usage": [
        "--adjfile <file>"
      ],
      "tip": [
        "使用替代 /etc/adjtime 的文件。"
      ],
      "next": []
    },
    {
      "name": "--adjust",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --adjust"
      ],
      "tip": [
        "调整 RTC 以补偿系统性漂移。"
      ]
    },
    {
      "name": "--date",
      "usage": [
        "--date <time>"
      ],
      "tip": [
        "用于 --set 和 --predict 的日期/时间输入。"
      ],
      "next": []
    },
    {
      "name": "--delay",
      "usage": [
        "--delay <sec>"
      ],
      "tip": [
        "设置新 RTC 时间时使用的延迟。"
      ],
      "next": []
    },
    {
      "name": "--directisa",
      "tip": [
        "使用 ISA 总线而不是访问 /dev/rtc0。"
      ]
    },
    {
      "name": "--get",
      "tip": [
        "显示经过漂移校正的 RTC 时间。"
      ]
    },
    {
      "name": "--hctosys",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --hctosys"
      ],
      "tip": [
        "从 RTC 设置系统时间。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--localtime",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --localtime"
      ],
      "tip": [
        "RTC 时间基准为本地时间。"
      ]
    },
    {
      "name": "--noadjfile",
      "tip": [
        "不使用 /etc/adjtime。"
      ]
    },
    {
      "name": "--param-get",
      "usage": [
        "--param-get <param>"
      ],
      "tip": [
        "显示 RTC 参数。",
        "别名: features、correction、bsm"
      ],
      "next": [
        {
          "name": "bsm"
        },
        {
          "name": "correction"
        },
        {
          "name": "features"
        }
      ]
    },
    {
      "name": "--param-index",
      "usage": [
        "--param-index <number>"
      ],
      "tip": [
        "参数索引（默认 0）。"
      ],
      "next": []
    },
    {
      "name": "--param-set",
      "usage": [
        "--param-set <param>=<value>"
      ],
      "tip": [
        "设置 RTC 参数。"
      ],
      "next": []
    },
    {
      "name": "--predict",
      "tip": [
        "根据 --date 预测漂移后的 RTC 时间。"
      ]
    },
    {
      "name": "--rtc",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --rtc <file>"
      ],
      "tip": [
        "使用替代 /dev/rtc0 的文件。"
      ],
      "next": []
    },
    {
      "name": "--set",
      "tip": [
        "根据 --date 设置 RTC。"
      ]
    },
    {
      "name": "--show",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --show"
      ],
      "tip": [
        "显示 RTC 时间。"
      ]
    },
    {
      "name": "--systohc",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --systohc"
      ],
      "tip": [
        "从系统时间设置 RTC。"
      ]
    },
    {
      "name": "--systz",
      "tip": [
        "向内核发送时间基准配置。"
      ]
    },
    {
      "name": "--test",
      "tip": [
        "试运行；隐含 --verbose。"
      ]
    },
    {
      "name": "--utc",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --utc"
      ],
      "tip": [
        "RTC 时间基准为 UTC。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "显示更多细节。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--vl-clear",
      "tip": [
        "清除电压低信息。"
      ]
    },
    {
      "name": "--vl-read",
      "tip": [
        "读取电压低信息。"
      ]
    }
  ]
}
