{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "查询或更改系统区域和键盘设置。"
    ]
  },
  "next": [
    {
      "name": "list-keymaps",
      "tip": [
        "显示已知虚拟控制台键盘映射。"
      ]
    },
    {
      "name": "list-locales",
      "tip": [
        "显示已知区域。"
      ]
    },
    {
      "name": "list-x11-keymap-layouts",
      "tip": [
        "显示已知 X11 键盘映射布局。"
      ]
    },
    {
      "name": "list-x11-keymap-models",
      "tip": [
        "显示已知 X11 键盘映射模型。"
      ]
    },
    {
      "name": "list-x11-keymap-options",
      "tip": [
        "显示已知 X11 键盘映射选项。"
      ]
    },
    {
      "name": "list-x11-keymap-variants",
      "usage": [
        "list-x11-keymap-variants [LAYOUT]"
      ],
      "tip": [
        "显示已知 X11 键盘映射变体。"
      ]
    },
    {
      "name": "set-keymap",
      "usage": [
        "set-keymap MAP [MAP]"
      ],
      "tip": [
        "设置控制台和 X11 键盘映射。"
      ]
    },
    {
      "name": "set-locale",
      "usage": [
        "set-locale LOCALE..."
      ],
      "tip": [
        "设置系统区域。"
      ]
    },
    {
      "name": "set-x11-keymap",
      "usage": [
        "set-x11-keymap LAYOUT [MODEL [VARIANT [OPTIONS]]]"
      ],
      "tip": [
        "设置 X11 和控制台键盘映射。"
      ]
    },
    {
      "name": "status",
      "tip": [
        "显示当前区域设置。"
      ]
    }
  ],
  "option": [
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "不省略输出。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "在远程主机上操作。"
      ],
      "next": []
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "对本机容器操作。"
      ],
      "next": []
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "不提示输入密码。"
      ]
    },
    {
      "name": "--no-convert",
      "tip": [
        "不转换键盘映射。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    }
  ]
}
