{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Query or change system locale and keyboard settings."
    ]
  },
  "next": [
    {
      "name": "list-keymaps",
      "tip": [
        "Show known virtual console keyboard mappings."
      ]
    },
    {
      "name": "list-locales",
      "tip": [
        "Show known locales."
      ]
    },
    {
      "name": "list-x11-keymap-layouts",
      "tip": [
        "Show known X11 keyboard mapping layouts."
      ]
    },
    {
      "name": "list-x11-keymap-models",
      "tip": [
        "Show known X11 keyboard mapping models."
      ]
    },
    {
      "name": "list-x11-keymap-options",
      "tip": [
        "Show known X11 keyboard mapping options."
      ]
    },
    {
      "name": "list-x11-keymap-variants",
      "usage": [
        "list-x11-keymap-variants [LAYOUT]"
      ],
      "tip": [
        "Show known X11 keyboard mapping variants."
      ]
    },
    {
      "name": "set-keymap",
      "usage": [
        "set-keymap MAP [MAP]"
      ],
      "tip": [
        "Set console and X11 keyboard mappings."
      ]
    },
    {
      "name": "set-locale",
      "usage": [
        "set-locale LOCALE..."
      ],
      "tip": [
        "Set system locale."
      ]
    },
    {
      "name": "set-x11-keymap",
      "usage": [
        "set-x11-keymap LAYOUT [MODEL [VARIANT [OPTIONS]]]"
      ],
      "tip": [
        "Set X11 and console keyboard mappings."
      ]
    },
    {
      "name": "status",
      "tip": [
        "Show current locale settings."
      ]
    }
  ],
  "option": [
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "Do not ellipsize output."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "Operate on remote host."
      ],
      "next": []
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "Operate on local container."
      ],
      "next": []
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "Do not prompt for password."
      ]
    },
    {
      "name": "--no-convert",
      "tip": [
        "Don't convert keyboard mappings."
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    }
  ]
}
