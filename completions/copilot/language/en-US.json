          "name": "get",
          "usage": [
            "get [options] <name>"
          ],
          "tip": [
            "Show server details."
          ]
        },
        {
          "name": "list",
          "tip": [
            "List configured MCP servers."
          ]
        },
        {
          "name": "remove",
          "usage": [
            "remove [options] <name>"
          ],
          "tip": [
            "Remove an MCP server."
          ]
        }
      ]
    },
    {
      "name": "plugin",
      "tip": [
        "Manage plugins and plugin marketplaces."
      ],
      "next": [
        {
          "name": "install",
          "usage": [
            "install [options] <source>"
          ],
          "tip": [
            "Install a plugin."
          ]
        },
        {
          "name": "list",
          "tip": [
            "List installed plugins."
          ]
        },
        {
          "name": "marketplace",
          "tip": [
            "Manage plugin marketplaces."
          ]
        },
        {
          "name": "uninstall",
          "usage": [
            "uninstall [options] <name>"
          ],
          "tip": [
            "Uninstall a plugin."
          ]
        },
        {
          "name": "update",
          "usage": [
            "update [options] [name]"
          ],
          "tip": [
            "Update a plugin."
          ]
        }
      ]
    },
    {
      "name": "plugins",
      "tip": [
        "Inspect configured plugins across kinds."
      ]
    },
    {
      "name": "skill",
      "tip": [
        "Manage skills available to Copilot."
      ],
      "next": [
        {
          "name": "add",
          "usage": [
            "add [options] <source>"
          ],
          "tip": [
            "Add a skill from a file, URL, or directory."
          ]
        },
        {
          "name": "list",
          "tip": [
            "List available skills."
          ]
        },
        {
          "name": "remove",
          "usage": [
            "remove [options] <name-or-directory>"
          ],
          "tip": [
            "Remove a skill or custom skill directory."
          ]
        }
      ]
