        "Add a tool to enable for the GitHub MCP server.",
        "Use '*' for all tools."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--add-github-mcp-toolset",
      "usage": [
        "--add-github-mcp-toolset <TOOLSET>"
