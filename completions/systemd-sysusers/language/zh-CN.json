{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "创建系统用户账户。"
    ]
  },
  "option": [
    {
      "name": "--cat-config",
      "tip": [
        "显示配置文件。"
      ]
    },
    {
      "name": "--dry-run",
      "tip": [
        "仅打印将要执行的操作。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--image",
      "usage": [
        "--image=PATH"
      ],
      "tip": [
        "将磁盘镜像作为文件系统根目录操作。"
      ],
      "next": []
    },
    {
      "name": "--image-policy",
      "usage": [
        "--image-policy=POLICY"
      ],
      "tip": [
        "指定磁盘镜像解析策略。"
      ],
      "next": []
    },
    {
      "name": "--inline",
      "tip": [
        "将参数视为配置行。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--replace",
      "usage": [
        "--replace=PATH"
      ],
      "tip": [
        "将参数视为 PATH 的替代。"
      ],
      "next": []
    },
    {
      "name": "--root",
      "usage": [
        "--root=PATH"
      ],
      "tip": [
        "在备用文件系统根目录上操作。"
      ],
      "next": []
    },
    {
      "name": "--tldr",
      "tip": [
        "显示配置的非注释部分。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    }
  ]
}
