{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Create system user accounts."
    ]
  },
  "option": [
    {
      "name": "--cat-config",
      "tip": [
        "Show configuration files."
      ]
    },
    {
      "name": "--dry-run",
      "tip": [
        "Just print what would be done."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--image",
      "usage": [
        "--image=PATH"
      ],
      "tip": [
        "Operate on a disk image as the filesystem root."
      ],
      "next": []
    },
    {
      "name": "--image-policy",
      "usage": [
        "--image-policy=POLICY"
      ],
      "tip": [
        "Specify the disk image dissection policy."
      ],
      "next": []
    },
    {
      "name": "--inline",
      "tip": [
        "Treat arguments as configuration lines."
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--replace",
      "usage": [
        "--replace=PATH"
      ],
      "tip": [
        "Treat arguments as a replacement for PATH."
      ],
      "next": []
    },
    {
      "name": "--root",
      "usage": [
        "--root=PATH"
      ],
      "tip": [
        "Operate on an alternate filesystem root."
      ],
      "next": []
    },
    {
      "name": "--tldr",
      "tip": [
        "Show non-comment parts of the configuration."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    }
  ]
}
