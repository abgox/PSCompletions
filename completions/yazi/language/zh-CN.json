{
  "meta": {
    "url": "https://yazi-rs.github.io/",
    "description": [
      "使用 Rust 编写的极速终端文件管理器。"
    ]
  },
  "option": [
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--chooser-file",
      "usage": [
        "--chooser-file <CHOOSER_FILE>"
      ],
      "tip": [
        "在打开事件触发时将选中的文件写入此文件"
      ],
      "next": []
    },
    {
      "name": "--clear-cache",
      "tip": [
        "清除缓存目录"
      ]
    },
    {
      "name": "--client-id",
      "usage": [
        "--client-id <CLIENT_ID>"
      ],
      "tip": [
        "使用指定的客户端 ID，必须是全局唯一的数字"
      ],
      "next": []
    },
    {
      "name": "--cwd-file",
      "usage": [
        "--cwd-file <CWD_FILE>"
      ],
      "tip": [
        "在退出时将当前工作目录写入此文件"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "tip": [
        "打印调试信息"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息"
      ]
    },
    {
      "name": "--local-events",
      "usage": [
        "--local-events <LOCAL_EVENTS>"
      ],
      "tip": [
        "将指定的本地事件报告到标准输出"
      ],
      "next": []
    },
    {
      "name": "--remote-events",
      "usage": [
        "--remote-events <REMOTE_EVENTS>"
      ],
      "tip": [
        "将指定的远程事件报告到标准输出"
      ],
      "next": []
    }
  ]
}
