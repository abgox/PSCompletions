{
  "meta": {
    "url": "https://yazi-rs.github.io/",
    "description": [
      "Blazing fast terminal file manager written in Rust."
    ]
  },
  "option": [
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--chooser-file",
      "usage": [
        "--chooser-file <CHOOSER_FILE>"
      ],
      "tip": [
        "Write the selected files to this file on open fired"
      ],
      "next": []
    },
    {
      "name": "--clear-cache",
      "tip": [
        "Clear the cache directory"
      ]
    },
    {
      "name": "--client-id",
      "usage": [
        "--client-id <CLIENT_ID>"
      ],
      "tip": [
        "Use the specified client ID, must be a globally unique number"
      ],
      "next": []
    },
    {
      "name": "--cwd-file",
      "usage": [
        "--cwd-file <CWD_FILE>"
      ],
      "tip": [
        "Write the cwd on exit to this file"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "tip": [
        "Print debug information"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    },
    {
      "name": "--local-events",
      "usage": [
        "--local-events <LOCAL_EVENTS>"
      ],
      "tip": [
        "Report the specified local events to stdout"
      ],
      "next": []
    },
    {
      "name": "--remote-events",
      "usage": [
        "--remote-events <REMOTE_EVENTS>"
      ],
      "tip": [
        "Report the specified remote events to stdout"
      ],
      "next": []
    }
  ]
}
