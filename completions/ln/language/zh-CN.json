{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "创建文件之间的链接。"
    ]
  },
  "option": [
    {
      "name": "--backup",
      "usage": [
        "--backup[=<CONTROL>]"
      ],
      "tip": [
        "为每个现有目标文件创建备份"
      ],
      "next": []
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "移除现有目标文件"
      ]
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "提示是否移除现有目标文件"
      ]
    },
    {
      "name": "--logical",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --logical"
      ],
      "tip": [
        "跟踪作为符号链接的 TARGET"
      ]
    },
    {
      "name": "--no-dereference",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-dereference"
      ],
      "tip": [
        "如果 LINK_NAME 是指向目录的符号链接，则将其视为普通文件"
      ]
    },
    {
      "name": "--no-target-directory",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --no-target-directory"
      ],
      "tip": [
        "始终将 LINK_NAME 视为普通文件"
      ]
    },
    {
      "name": "--physical",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --physical"
      ],
      "tip": [
        "直接对符号链接创建硬链接"
      ]
    },
    {
      "name": "--relative",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --relative"
      ],
      "tip": [
        "创建相对于链接位置的符号链接"
      ]
    },
    {
      "name": "--suffix",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --suffix <SUFFIX>"
      ],
      "tip": [
        "覆盖通常的备份后缀"
      ],
      "next": []
    },
    {
      "name": "--symbolic",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --symbolic"
      ],
      "tip": [
        "创建符号链接而非硬链接"
      ]
    },
    {
      "name": "--target-directory",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --target-directory <DIRECTORY>"
      ],
      "tip": [
        "指定创建链接的 DIRECTORY"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "打印每个链接文件的名称"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "-b",
      "tip": [
        "类似 --backup 但不接受参数"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
