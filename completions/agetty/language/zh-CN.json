{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "打开终端并设置其模式。"
    ]
  },
  "option": [
    {
      "name": "--8bits",
      "alias": [
        "-8"
      ],
      "usage": [
        "-8, --8bits"
      ],
      "tip": [
        "假定 8 位 tty。"
      ]
    },
    {
      "name": "--autologin",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --autologin <user>"
      ],
      "tip": [
        "自动登录指定用户。"
      ],
      "next": []
    },
    {
      "name": "--chdir",
      "usage": [
        "--chdir <directory>"
      ],
      "tip": [
        "登录前切换目录。"
      ],
      "next": []
    },
    {
      "name": "--chroot",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --chroot <dir>"
      ],
      "tip": [
        "将根目录更改为该目录。"
      ],
      "next": []
    },
    {
      "name": "--delay",
      "usage": [
        "--delay <number>"
      ],
      "tip": [
        "提示前休眠的秒数。"
      ],
      "next": []
    },
    {
      "name": "--detect-case",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --detect-case"
      ],
      "tip": [
        "检测大写终端。"
      ]
    },
    {
      "name": "--erase-chars",
      "usage": [
        "--erase-chars <string>"
      ],
      "tip": [
        "额外的退格字符。"
      ],
      "next": []
    },
    {
      "name": "--extract-baud",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --extract-baud"
      ],
      "tip": [
        "连接期间提取波特率。"
      ]
    },
    {
      "name": "--flow-control",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --flow-control"
      ],
      "tip": [
        "启用硬件流控制。"
      ]
    },
    {
      "name": "--hangup",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --hangup"
      ],
      "tip": [
        "对 tty 执行虚拟挂断。"
      ]
    },
    {
      "name": "--help",
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host <hostname>"
      ],
      "tip": [
        "指定登录主机。"
      ],
      "next": []
    },
    {
      "name": "--init-string",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --init-string <string>"
      ],
      "tip": [
        "设置初始化字符串。"
      ],
      "next": []
    },
    {
      "name": "--issue-file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --issue-file <list>"
      ],
      "tip": [
        "显示 issue 文件或目录。"
      ],
      "next": []
    },
    {
      "name": "--keep-baud",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --keep-baud"
      ],
      "tip": [
        "中断后尽量保持波特率。"
      ]
    },
    {
      "name": "--kill-chars",
      "usage": [
        "--kill-chars <string>"
      ],
      "tip": [
        "额外的终止字符。"
      ],
      "next": []
    },
    {
      "name": "--list-speeds",
      "tip": [
        "显示支持的波特率。"
      ]
    },
    {
      "name": "--local-line",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --local-line[=<mode>]"
      ],
      "tip": [
        "控制本地线路标志。"
      ],
      "next": []
    },
    {
      "name": "--login-options",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --login-options <opts>"
      ],
      "tip": [
        "传递给 login 的选项。"
      ],
      "next": []
    },
    {
      "name": "--login-pause",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --login-pause"
      ],
      "tip": [
        "登录前等待任意键。"
      ]
    },
    {
      "name": "--login-program",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --login-program <file>"
      ],
      "tip": [
        "指定登录程序。"
      ],
      "next": []
    },
    {
      "name": "--long-hostname",
      "tip": [
        "显示完整限定主机名。"
      ]
    },
    {
      "name": "--nice",
      "usage": [
        "--nice <number>"
      ],
      "tip": [
        "以该优先级运行 login。"
      ],
      "next": []
    },
    {
      "name": "--noclear",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --noclear"
      ],
      "tip": [
        "提示前不清屏。"
      ]
    },
    {
      "name": "--nohints",
      "tip": [
        "不打印提示。"
      ]
    },
    {
      "name": "--nohostname",
      "tip": [
        "完全不显示主机名。"
      ]
    },
    {
      "name": "--noissue",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --noissue"
      ],
      "tip": [
        "不显示 issue 文件。"
      ]
    },
    {
      "name": "--nonewline",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --nonewline"
      ],
      "tip": [
        "在 issue 前不打印换行。"
      ]
    },
    {
      "name": "--noreset",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --noreset"
      ],
      "tip": [
        "不重置控制模式。"
      ]
    },
    {
      "name": "--reload",
      "tip": [
        "重新加载运行中的 agetty 实例的提示。"
      ]
    },
    {
      "name": "--remote",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --remote"
      ],
      "tip": [
        "为 login(1) 使用 -r <hostname>。"
      ]
    },
    {
      "name": "--show-issue",
      "tip": [
        "显示 issue 文件后退出。"
      ]
    },
    {
      "name": "--skip-login",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --skip-login"
      ],
      "tip": [
        "不提示登录。"
      ]
    },
    {
      "name": "--timeout",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --timeout <number>"
      ],
      "tip": [
        "登录进程超时。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--wait-cr",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wait-cr"
      ],
      "tip": [
        "等待回车。"
      ]
    }
  ]
}
