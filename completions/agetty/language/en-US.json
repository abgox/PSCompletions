{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Open a terminal and set its mode."
    ]
  },
  "option": [
    {
      "name": "--8bits",
      "alias": [
        "-8"
      ],
      "usage": [
        "-8, --8bits"
      ],
      "tip": [
        "Assume 8-bit tty."
      ]
    },
    {
      "name": "--autologin",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --autologin <user>"
      ],
      "tip": [
        "Login the specified user automatically."
      ],
      "next": []
    },
    {
      "name": "--chdir",
      "usage": [
        "--chdir <directory>"
      ],
      "tip": [
        "Chdir before the login."
      ],
      "next": []
    },
    {
      "name": "--chroot",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --chroot <dir>"
      ],
      "tip": [
        "Change root to the directory."
      ],
      "next": []
    },
    {
      "name": "--delay",
      "usage": [
        "--delay <number>"
      ],
      "tip": [
        "Sleep seconds before prompt."
      ],
      "next": []
    },
    {
      "name": "--detect-case",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --detect-case"
      ],
      "tip": [
        "Detect uppercase terminal."
      ]
    },
    {
      "name": "--erase-chars",
      "usage": [
        "--erase-chars <string>"
      ],
      "tip": [
        "Additional backspace chars."
      ],
      "next": []
    },
    {
      "name": "--extract-baud",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --extract-baud"
      ],
      "tip": [
        "Extract baud rate during connect."
      ]
    },
    {
      "name": "--flow-control",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --flow-control"
      ],
      "tip": [
        "Enable hardware flow control."
      ]
    },
    {
      "name": "--hangup",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --hangup"
      ],
      "tip": [
        "Do virtually hangup on the tty."
      ]
    },
    {
      "name": "--help",
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host <hostname>"
      ],
      "tip": [
        "Specify login host."
      ],
      "next": []
    },
    {
      "name": "--init-string",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --init-string <string>"
      ],
      "tip": [
        "Set init string."
      ],
      "next": []
    },
    {
      "name": "--issue-file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --issue-file <list>"
      ],
      "tip": [
        "Display issue files or directories."
      ],
      "next": []
    },
    {
      "name": "--keep-baud",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --keep-baud"
      ],
      "tip": [
        "Try to keep baud rate after break."
      ]
    },
    {
      "name": "--kill-chars",
      "usage": [
        "--kill-chars <string>"
      ],
      "tip": [
        "Additional kill chars."
      ],
      "next": []
    },
    {
      "name": "--list-speeds",
      "tip": [
        "Display supported baud rates."
      ]
    },
    {
      "name": "--local-line",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --local-line[=<mode>]"
      ],
      "tip": [
        "Control the local line flag."
      ],
      "next": []
    },
    {
      "name": "--login-options",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --login-options <opts>"
      ],
      "tip": [
        "Options that are passed to login."
      ],
      "next": []
    },
    {
      "name": "--login-pause",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --login-pause"
      ],
      "tip": [
        "Wait for any key before the login."
      ]
    },
    {
      "name": "--login-program",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --login-program <file>"
      ],
      "tip": [
        "Specify login program."
      ],
      "next": []
    },
    {
      "name": "--long-hostname",
      "tip": [
        "Show full qualified hostname."
      ]
    },
    {
      "name": "--nice",
      "usage": [
        "--nice <number>"
      ],
      "tip": [
        "Run login with this priority."
      ],
      "next": []
    },
    {
      "name": "--noclear",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --noclear"
      ],
      "tip": [
        "Do not clear the screen before prompt."
      ]
    },
    {
      "name": "--nohints",
      "tip": [
        "Do not print hints."
      ]
    },
    {
      "name": "--nohostname",
      "tip": [
        "No hostname at all will be shown."
      ]
    },
    {
      "name": "--noissue",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --noissue"
      ],
      "tip": [
        "Do not display issue file."
      ]
    },
    {
      "name": "--nonewline",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --nonewline"
      ],
      "tip": [
        "Do not print a newline before issue."
      ]
    },
    {
      "name": "--noreset",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --noreset"
      ],
      "tip": [
        "Do not reset control mode."
      ]
    },
    {
      "name": "--reload",
      "tip": [
        "Reload prompts on running agetty instances."
      ]
    },
    {
      "name": "--remote",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --remote"
      ],
      "tip": [
        "Use -r <hostname> for login(1)."
      ]
    },
    {
      "name": "--show-issue",
      "tip": [
        "Display issue file and exit."
      ]
    },
    {
      "name": "--skip-login",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --skip-login"
      ],
      "tip": [
        "Do not prompt for login."
      ]
    },
    {
      "name": "--timeout",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --timeout <number>"
      ],
      "tip": [
        "Login process timeout."
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--wait-cr",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wait-cr"
      ],
      "tip": [
        "Wait carriage-return."
      ]
    }
  ]
}
