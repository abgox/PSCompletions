      "next": [
        {
          "name": "vcpu"
        },
        {
          "name": "vcpu+"
        }
      ]
    },
    {
      "name": "--namespace",
      "usage": [
        "--namespace[=<VALUE>]"
      ],
      "tip": [
        "打印被跟踪进程进入的命名空间 ID。",
        "唯一值为 new。",
        "值必须使用 '=' 附加。"
      ],
      "repeat": 99,
      "next": [
        {
          "name": "new"
        }
      ]
    },
    {
      "name": "--no-abbrev",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --no-abbrev"
