{
  "meta": {
    "url": "https://yazi-rs.github.io/",
    "description": [
      "Yazi - 使用 Rust 编写的极速终端文件管理器。"
    ]
  },
  "next": [
    {
      "name": "cache",
      "tip": [
        "管理缓存"
      ],
      "next": [
        {
          "name": "clear",
          "tip": [
            "清除缓存目录"
          ]
        },
        {
          "name": "help",
          "tip": [
            "打印此消息或给定子命令的帮助"
          ]
        }
      ]
    },
    {
      "name": "emit",
      "usage": [
        "emit <NAME> [ARGS]..."
      ],
      "tip": [
        "发出一条要由当前实例执行的动作",
        "NAME 是动作名称，ARGS 是其参数"
      ]
    },
    {
      "name": "emit-to",
      "usage": [
        "emit-to <RECEIVER> <NAME> [ARGS]..."
      ],
      "tip": [
        "发出一条要由指定实例执行的动作",
        "RECEIVER 是实例 ID，NAME 是动作名称"
      ]
    },
    {
      "name": "env",
      "tip": [
        "打印环境与配置信息"
      ]
    },
    {
      "name": "exec",
      "usage": [
        "exec <NAME> [ARGS]..."
      ],
      "tip": [
        "在当前实例上执行动作并打印结果",
        "NAME 是动作名称，ARGS 是其参数"
      ]
    },
    {
      "name": "help",
      "tip": [
        "打印此消息或给定子命令的帮助"
      ]
    },
    {
      "name": "pkg",
      "tip": [
        "管理包"
      ],
      "next": [
        {
          "name": "add",
          "usage": [
            "add [IDS]..."
          ],
          "tip": [
            "添加包"
          ]
        },
        {
          "name": "delete",
          "usage": [
            "delete [IDS]..."
          ],
          "tip": [
            "删除包"
          ],
          "option": [
            {
              "name": "--discard",
              "tip": [
                "删除包时丢弃对包所做的本地修改"
              ]
            }
          ]
        },
        {
          "name": "help",
          "tip": [
            "打印此消息或给定子命令的帮助"
          ]
        },
        {
          "name": "install",
          "tip": [
            "安装所有包"
          ],
          "option": [
            {
              "name": "--discard",
              "tip": [
                "安装包时丢弃对包所做的本地修改"
              ]
            }
          ]
        },
        {
          "name": "list",
          "tip": [
            "列出所有包"
          ]
        },
        {
          "name": "upgrade",
          "usage": [
            "upgrade [IDS]..."
          ],
          "tip": [
            "升级所有包",
            "IDS 是要升级的包；省略则升级所有包"
          ],
          "option": [
            {
              "name": "--discard",
              "tip": [
                "升级包时丢弃对包所做的本地修改"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "pub",
      "usage": [
        "pub <KIND>"
      ],
      "tip": [
        "发布一条消息到当前实例",
        "KIND 是消息类型"
      ],
      "option": [
        {
          "name": "--json",
          "usage": [
            "--json <JSON>"
          ],
          "tip": [
            "发送 JSON 格式的消息体"
          ],
          "next": []
        },
        {
          "name": "--list",
          "usage": [
            "--list [<LIST>...]"
          ],
          "tip": [
            "发送字符串列表作为消息体"
          ],
          "next": []
        },
        {
          "name": "--str",
          "usage": [
            "--str <STR>"
          ],
          "tip": [
            "发送字符串作为消息体"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "pub-to",
      "usage": [
        "pub-to <RECEIVER> <KIND>"
      ],
      "tip": [
        "发布一条消息到指定实例",
        "RECEIVER 是实例 ID，KIND 是消息类型"
      ],
      "option": [
        {
          "name": "--json",
          "usage": [
            "--json <JSON>"
          ],
          "tip": [
            "发送 JSON 格式的消息体"
          ],
          "next": []
        },
        {
          "name": "--list",
          "usage": [
            "--list [<LIST>...]"
          ],
          "tip": [
            "发送字符串列表作为消息体"
          ],
          "next": []
        },
        {
          "name": "--str",
          "usage": [
            "--str <STR>"
          ],
          "tip": [
            "发送字符串作为消息体"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "sub",
      "usage": [
        "sub <KINDS>"
      ],
      "tip": [
        "订阅所有远程实例的消息",
        "KINDS 可以有多个，用逗号分隔"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ]
}
