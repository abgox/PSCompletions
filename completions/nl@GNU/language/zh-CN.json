{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把每个 FILE 写入标准输出，并加上行号。"
    ]
  },
  "option": [
    {
      "name": "--body-numbering",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --body-numbering <STYLE>"
      ],
      "tip": [
        "用 STYLE 编号正文行"
      ],
      "next": [
        {
          "name": "a"
        },
        {
          "name": "n"
        },
        {
          "name": "p"
        },
        {
          "name": "t"
        }
      ]
    },
    {
      "name": "--footer-numbering",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --footer-numbering <STYLE>"
      ],
      "tip": [
        "用 STYLE 编号页脚行"
      ],
      "next": [
        {
          "name": "a"
        },
        {
          "name": "n"
        },
        {
          "name": "p"
        },
        {
          "name": "t"
        }
      ]
    },
    {
      "name": "--header-numbering",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --header-numbering <STYLE>"
      ],
      "tip": [
        "用 STYLE 编号页头行"
      ],
      "next": [
        {
          "name": "a"
        },
        {
          "name": "n"
        },
        {
          "name": "p"
        },
        {
          "name": "t"
        }
      ]
    },
    {
      "name": "--join-blank-lines",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --join-blank-lines <NUMBER>"
      ],
      "tip": [
        "把 NUMBER 个空行算作一组"
      ],
      "next": []
    },
    {
      "name": "--line-increment",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --line-increment <NUMBER>"
      ],
      "tip": [
        "每递增一行，行号增加量"
      ],
      "next": []
    },
    {
      "name": "--no-renumber",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --no-renumber"
      ],
      "tip": [
        "每个节都不重置行号"
      ]
    },
    {
      "name": "--number-format",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --number-format <FORMAT>"
      ],
      "tip": [
        "按 FORMAT 插入行号"
      ],
      "next": [
        {
          "name": "ln"
        },
        {
          "name": "rn"
        },
        {
          "name": "rz"
        }
      ]
    },
    {
      "name": "--number-separator",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --number-separator <STRING>"
      ],
      "tip": [
        "在行号之后加上 STRING"
      ],
      "next": []
    },
    {
      "name": "--number-width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --number-width <NUMBER>"
      ],
      "tip": [
        "用 NUMBER 列显示行号"
      ],
      "next": []
    },
    {
      "name": "--section-delimiter",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --section-delimiter <CC>"
      ],
      "tip": [
        "用 CC 作为逻辑页分隔符"
      ],
      "next": []
    },
    {
      "name": "--starting-line-number",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --starting-line-number <NUMBER>"
      ],
      "tip": [
        "每个节的起始行号"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
