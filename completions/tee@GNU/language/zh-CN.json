{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把标准输入复制到每个 FILE，同时也输出到标准输出。"
    ]
  },
  "option": [
    {
      "name": "--append",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --append"
      ],
      "tip": [
        "追加到给定的这些文件，不覆盖"
      ]
    },
    {
      "name": "--ignore-interrupts",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-interrupts"
      ],
      "tip": [
        "忽略中断信号"
      ]
    },
    {
      "name": "--output-error",
      "usage": [
        "--output-error[=MODE]"
      ],
      "tip": [
        "设置写出错误时的行为。MODE 参见下方"
      ],
      "next": [
        {
          "name": "exit"
        },
        {
          "name": "exit-nopipe"
        },
        {
          "name": "warn"
        },
        {
          "name": "warn-nopipe"
        }
      ]
    },
    {
      "name": "-p",
      "tip": [
        "与管道配合时采用更合适的 MODE"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
