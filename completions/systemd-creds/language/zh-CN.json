{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "显示并处理凭据。"
    ]
  },
  "next": [
    {
      "name": "cat",
      "usage": [
        "cat CREDENTIAL..."
      ],
      "tip": [
        "显示指定凭据的内容。"
      ]
    },
    {
      "name": "decrypt",
      "usage": [
        "decrypt INPUT [OUTPUT]"
      ],
      "tip": [
        "将密文凭据文件解密为明文凭据文件。"
      ]
    },
    {
      "name": "encrypt",
      "usage": [
        "encrypt INPUT OUTPUT"
      ],
      "tip": [
        "将明文凭据文件加密为密文凭据文件。"
      ]
    },
    {
      "name": "list",
      "tip": [
        "显示已传递的凭据列表。"
      ]
    },
    {
      "name": "setup",
      "tip": [
        "生成凭据主机密钥（如果尚不存在）。"
      ]
    }
  ],
  "option": [
    {
      "name": "--allow-null",
      "tip": [
        "允许使用空密钥解密凭据。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--json",
      "usage": [
        "--json=pretty|short|off"
      ],
      "tip": [
        "生成 JSON 输出。",
        "可能值: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--name",
      "usage": [
        "--name=NAME"
      ],
      "tip": [
        "覆盖加密凭据中包含的文件名。"
      ],
      "next": []
    },
    {
      "name": "--newline",
      "usage": [
        "--newline=auto|yes|no"
      ],
      "tip": [
        "在输出后添加换行符。",
        "可能值: auto, yes, no"
      ],
      "next": [
        {
          "name": "auto"
        },
        {
          "name": "no"
        },
        {
          "name": "yes"
        }
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "不显示页眉和页脚。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--not-after",
      "usage": [
        "--not-after=TIME"
      ],
      "tip": [
        "在加密凭据中包含指定失效时间。"
      ],
      "next": []
    },
    {
      "name": "--pretty",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pretty"
      ],
      "tip": [
        "以 SetCredentialEncrypted= 行输出。"
      ]
    },
    {
      "name": "--system",
      "tip": [
        "显示传递给系统的凭据。"
      ]
    },
    {
      "name": "--timestamp",
      "usage": [
        "--timestamp=TIME"
      ],
      "tip": [
        "在加密凭据中包含指定时间戳。"
      ],
      "next": []
    },
    {
      "name": "--tpm2-device",
      "usage": [
        "--tpm2-device=PATH"
      ],
      "tip": [
        "选择 TPM2 设备。"
      ],
      "next": []
    },
    {
      "name": "--tpm2-pcrs",
      "usage": [
        "--tpm2-pcrs=PCR1+PCR2+PCR3+…"
      ],
      "tip": [
        "指定用于密封的 TPM2 PCR（固定哈希）。"
      ],
      "next": []
    },
    {
      "name": "--tpm2-public-key",
      "usage": [
        "--tpm2-public-key=PATH"
      ],
      "tip": [
        "指定用于密封的 PEM 证书。"
      ],
      "next": []
    },
    {
      "name": "--tpm2-public-key-pcrs",
      "usage": [
        "--tpm2-public-key-pcrs=PCR1+PCR2+PCR3+…"
      ],
      "tip": [
        "指定用于密封的 TPM2 PCR（公钥）。"
      ],
      "next": []
    },
    {
      "name": "--tpm2-signature",
      "usage": [
        "--tpm2-signature=PATH"
      ],
      "tip": [
        "指定公钥 PCR 策略的签名。"
      ],
      "next": []
    },
    {
      "name": "--transcode",
      "usage": [
        "--transcode=base64|unbase64|hex|unhex"
      ],
      "tip": [
        "转码凭据数据。",
        "可能值: base64, unbase64, hex, unhex"
      ],
      "next": [
        {
          "name": "base64"
        },
        {
          "name": "hex"
        },
        {
          "name": "unbase64"
        },
        {
          "name": "unhex"
        }
      ]
    },
    {
      "name": "--uid",
      "usage": [
        "--uid=UID"
      ],
      "tip": [
        "选择范围凭据的用户。"
      ],
      "next": []
    },
    {
      "name": "--user",
      "tip": [
        "选择用户范围的凭据加密。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "--with-key",
      "usage": [
        "--with-key=host|tpm2|host+tpm2|null|auto|auto-initrd"
      ],
      "tip": [
        "选择用于加密的密钥。",
        "可能值: host, tpm2, host+tpm2, null, auto, auto-initrd"
      ],
      "next": [
        {
          "name": "auto"
        },
        {
          "name": "auto-initrd"
        },
        {
          "name": "host"
        },
        {
          "name": "host+tpm2"
        },
        {
          "name": "null"
        },
        {
          "name": "tpm2"
        }
      ]
    },
    {
      "name": "-H",
      "tip": [
        "--with-key=host 的简写。"
      ]
    },
    {
      "name": "-T",
      "tip": [
        "--with-key=tpm2 的简写。"
      ]
    }
  ]
}
