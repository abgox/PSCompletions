{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "校验文件并计数块数"
    ]
  },
  "option": [
    {
      "name": "--sysv",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sysv"
      ],
      "tip": [
        "使用 System V 求和算法，使用 512 字节块"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-r",
      "tip": [
        "使用 BSD 求和算法，使用 1K 块（默认）"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
