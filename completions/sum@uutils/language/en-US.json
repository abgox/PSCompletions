{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Checksum and count the blocks in a file."
    ]
  },
  "option": [
    {
      "name": "--sysv",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sysv"
      ],
      "tip": [
        "use System V sum algorithm, use 512 bytes blocks"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "-r",
      "tip": [
        "use the BSD sum algorithm, use 1K blocks (default)"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
