{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "打印解析后的绝对文件名；除最后一段外的各段都必须存在"
    ]
  },
  "option": [
    {
      "name": "--canonicalize-existing",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --canonicalize-existing"
      ],
      "tip": [
        "路径的所有部分都必须存在"
      ]
    },
    {
      "name": "--canonicalize-missing",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --canonicalize-missing"
      ],
      "tip": [
        "不要求路径的任何部分存在或是目录"
      ]
    },
    {
      "name": "--logical",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --logical"
      ],
      "tip": [
        "在处理符号链接之前先解析 .. 部分"
      ]
    },
    {
      "name": "--no-symlinks",
      "alias": [
        "--strip",
        "-s"
      ],
      "usage": [
        "-s, --strip, --no-symlinks"
      ],
      "tip": [
        "不展开符号链接"
      ]
    },
    {
      "name": "--physical",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --physical"
      ],
      "tip": [
        "按遇到顺序解析符号链接（默认）"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制大多数错误信息"
      ]
    },
    {
      "name": "--relative-base",
      "usage": [
        "--relative-base <DIR>"
      ],
      "tip": [
        "除 DIR 以下的路径外，打印绝对路径"
      ],
      "next": []
    },
    {
      "name": "--relative-to",
      "usage": [
        "--relative-to <DIR>"
      ],
      "tip": [
        "打印相对于 DIR 的解析后路径"
      ],
      "next": []
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "每行输出以 NUL 结尾，而不是换行符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
