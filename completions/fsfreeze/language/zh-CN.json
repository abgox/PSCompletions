{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "暂停对文件系统的访问。"
    ]
  },
  "option": [
    {
      "name": "--freeze",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --freeze"
      ],
      "tip": [
        "冻结文件系统。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--unfreeze",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unfreeze"
      ],
      "tip": [
        "解冻文件系统。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
