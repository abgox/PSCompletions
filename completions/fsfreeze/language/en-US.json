{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Suspend access to a filesystem."
    ]
  },
  "option": [
    {
      "name": "--freeze",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --freeze"
      ],
      "tip": [
        "Freeze the filesystem."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--unfreeze",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unfreeze"
      ],
      "tip": [
        "Unfreeze the filesystem."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
