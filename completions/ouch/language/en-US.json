{
  "meta": {
    "url": "https://github.com/ouch-org/ouch",
    "description": [
      "A command-line utility for easily compressing and decompressing files and directories",
      "Supported formats: tar, zip, gz, 7z, xz, lzma, bz2, bz3, lz4, zst, rar, br"
    ]
  },
  "next": [
    {
      "name": "compress",
      "alias": [
        "c"
      ],
      "usage": [
        "compress [OPTIONS] <FILES>... <OUTPUT>"
      ],
      "tip": [
        "Compress one or more files into one output file"
      ],
      "option": [
        {
          "name": "--fast",
          "tip": [
            "Fastest compression level possible"
          ]
        },
        {
          "name": "--follow-symlinks",
          "alias": [
            "-S"
          ],
          "usage": [
            "-S, --follow-symlinks"
          ],
          "tip": [
            "Read from target files instead of from symlinks"
          ]
        },
        {
          "name": "--format",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --format <FORMAT>"
          ],
          "tip": [
            "Specify the format of the archive"
          ],
          "next": []
        },
        {
          "name": "--gitignore",
          "alias": [
            "-g"
          ],
          "usage": [
            "-g, --gitignore"
          ],
          "tip": [
            "Ignore files matched by git's ignore files"
          ]
        },
        {
          "name": "--hidden",
          "alias": [
            "-H"
          ],
          "usage": [
            "-H, --hidden"
          ],
          "tip": [
            "Ignore hidden files"
          ]
        },
        {
          "name": "--level",
          "alias": [
            "-l"
          ],
          "usage": [
            "-l, --level <LEVEL>"
          ],
          "tip": [
            "Compression level, applied to all formats"
          ],
          "next": []
        },
        {
          "name": "--password",
          "alias": [
            "-p"
          ],
          "usage": [
            "-p, --password <PASSWORD>"
          ],
          "tip": [
            "Compress with password"
          ],
          "next": []
        },
        {
          "name": "--slow",
          "tip": [
            "Slowest and best compression level possible"
          ]
        },
        {
          "name": "--threads",
          "alias": [
            "-c"
          ],
          "usage": [
            "-c, --threads <THREADS>"
          ],
          "tip": [
            "Concurrent working threads"
          ],
          "next": [
            {
              "name": "1"
            },
            {
              "name": "4"
            },
            {
              "name": "8"
            }
          ]
        }
      ]
    },
    {
      "name": "decompress",
      "alias": [
        "d"
      ],
      "usage": [
        "decompress [OPTIONS] <FILES>..."
      ],
      "tip": [
        "Decompress one or more files, optionally into another folder"
      ],
      "option": [
        {
          "name": "--dir",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --dir <OUTPUT_DIR>"
          ],
          "tip": [
            "Decompress inside OUTPUT_DIR instead of the basename-derived subdirectory"
          ],
          "next": []
        },
        {
          "name": "--format",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --format <FORMAT>"
          ],
          "tip": [
            "Specify the format of the archive"
          ],
          "next": []
        },
        {
          "name": "--gitignore",
          "alias": [
            "-g"
          ],
          "usage": [
            "-g, --gitignore"
          ],
          "tip": [
            "Ignore files matched by git's ignore files"
          ]
        },
        {
          "name": "--here",
          "tip": [
            "Extract directly into the current directory"
          ]
        },
        {
          "name": "--hidden",
          "alias": [
            "-H"
          ],
          "usage": [
            "-H, --hidden"
          ],
          "tip": [
            "Ignore hidden files"
          ]
        },
        {
          "name": "--password",
          "alias": [
            "-p"
          ],
          "usage": [
            "-p, --password <PASSWORD>"
          ],
          "tip": [
            "Decompress with password"
          ],
          "next": []
        },
        {
          "name": "--remove",
          "alias": [
            "-r"
          ],
          "usage": [
            "-r, --remove"
          ],
          "tip": [
            "Remove the source file after successful decompression"
          ]
        },
        {
          "name": "--threads",
          "alias": [
            "-c"
          ],
          "usage": [
            "-c, --threads <THREADS>"
          ],
          "tip": [
            "Concurrent working threads"
          ],
          "next": [
            {
              "name": "1"
            },
            {
              "name": "4"
            },
            {
              "name": "8"
            }
          ]
        }
      ]
    },
    {
      "name": "list",
      "alias": [
        "ls",
        "l"
      ],
      "usage": [
        "list [OPTIONS] <ARCHIVES>..."
      ],
      "tip": [
        "List contents of an archive"
      ],
      "option": [
        {
          "name": "--format",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --format <FORMAT>"
          ],
          "tip": [
            "Specify the format of the archive"
          ],
          "next": []
        },
        {
          "name": "--gitignore",
          "alias": [
            "-g"
          ],
          "usage": [
            "-g, --gitignore"
          ],
          "tip": [
            "Ignore files matched by git's ignore files"
          ]
        },
        {
          "name": "--hidden",
          "alias": [
            "-H"
          ],
          "usage": [
            "-H, --hidden"
          ],
          "tip": [
            "Ignore hidden files"
          ]
        },
        {
          "name": "--password",
          "alias": [
            "-p"
          ],
          "usage": [
            "-p, --password <PASSWORD>"
          ],
          "tip": [
            "List with password"
          ],
          "next": []
        },
        {
          "name": "--tree",
          "alias": [
            "-t"
          ],
          "usage": [
            "-t, --tree"
          ],
          "tip": [
            "Show archive contents as a tree"
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--accessible",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --accessible"
      ],
      "tip": [
        "Activate accessibility mode, reducing visual noise"
      ]
    },
    {
      "name": "--no",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no"
      ],
      "tip": [
        "Skip [Y/n] questions, default to no"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Silence output"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "--yes",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --yes"
      ],
      "tip": [
        "Skip [Y/n] questions, default to yes"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
