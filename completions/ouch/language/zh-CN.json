{
  "meta": {
    "url": "https://github.com/ouch-org/ouch",
    "description": [
      "一个用于轻松压缩和解压文件与目录的命令行工具",
      "支持格式：tar、zip、gz、7z、xz、lzma、bz2、bz3、lz4、zst、rar、br"
    ]
  },
  "next": [
    {
      "name": "compress",
      "alias": [
        "c"
      ],
      "usage": [
        "compress [OPTIONS] <FILES>... <OUTPUT>"
      ],
      "tip": [
        "将一个或多个文件压缩为一个输出文件"
      ],
      "option": [
        {
          "name": "--fast",
          "tip": [
            "最快压缩级别"
          ]
        },
        {
          "name": "--follow-symlinks",
          "alias": [
            "-S"
          ],
          "usage": [
            "-S, --follow-symlinks"
          ],
          "tip": [
            "读取目标文件而非符号链接"
          ]
        },
        {
          "name": "--format",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --format <FORMAT>"
          ],
          "tip": [
            "指定归档文件的格式"
          ],
          "next": []
        },
        {
          "name": "--gitignore",
          "alias": [
            "-g"
          ],
          "usage": [
            "-g, --gitignore"
          ],
          "tip": [
            "忽略 git 忽略文件中匹配的文件"
          ]
        },
        {
          "name": "--hidden",
          "alias": [
            "-H"
          ],
          "usage": [
            "-H, --hidden"
          ],
          "tip": [
            "忽略隐藏文件"
          ]
        },
        {
          "name": "--level",
          "alias": [
            "-l"
          ],
          "usage": [
            "-l, --level <LEVEL>"
          ],
          "tip": [
            "压缩级别，应用于所有格式"
          ],
          "next": []
        },
        {
          "name": "--password",
          "alias": [
            "-p"
          ],
          "usage": [
            "-p, --password <PASSWORD>"
          ],
          "tip": [
            "使用密码压缩"
          ],
          "next": []
        },
        {
          "name": "--slow",
          "tip": [
            "最慢但最佳的压缩级别"
          ]
        },
        {
          "name": "--threads",
          "alias": [
            "-c"
          ],
          "usage": [
            "-c, --threads <THREADS>"
          ],
          "tip": [
            "并发工作线程数"
          ],
          "next": [
            {
              "name": "1"
            },
            {
              "name": "4"
            },
            {
              "name": "8"
            }
          ]
        }
      ]
    },
    {
      "name": "decompress",
      "alias": [
        "d"
      ],
      "usage": [
        "decompress [OPTIONS] <FILES>..."
      ],
      "tip": [
        "解压一个或多个文件，可选输出到其他文件夹"
      ],
      "option": [
        {
          "name": "--dir",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --dir <OUTPUT_DIR>"
          ],
          "tip": [
            "解压到 OUTPUT_DIR 目录而非基于文件名的子目录"
          ],
          "next": []
        },
        {
          "name": "--format",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --format <FORMAT>"
          ],
          "tip": [
            "指定归档文件的格式"
          ],
          "next": []
        },
        {
          "name": "--gitignore",
          "alias": [
            "-g"
          ],
          "usage": [
            "-g, --gitignore"
          ],
          "tip": [
            "忽略 git 忽略文件中匹配的文件"
          ]
        },
        {
          "name": "--here",
          "tip": [
            "直接解压到当前目录"
          ]
        },
        {
          "name": "--hidden",
          "alias": [
            "-H"
          ],
          "usage": [
            "-H, --hidden"
          ],
          "tip": [
            "忽略隐藏文件"
          ]
        },
        {
          "name": "--password",
          "alias": [
            "-p"
          ],
          "usage": [
            "-p, --password <PASSWORD>"
          ],
          "tip": [
            "使用密码解压"
          ],
          "next": []
        },
        {
          "name": "--remove",
          "alias": [
            "-r"
          ],
          "usage": [
            "-r, --remove"
          ],
          "tip": [
            "解压成功后删除源文件"
          ]
        },
        {
          "name": "--threads",
          "alias": [
            "-c"
          ],
          "usage": [
            "-c, --threads <THREADS>"
          ],
          "tip": [
            "并发工作线程数"
          ],
          "next": [
            {
              "name": "1"
            },
            {
              "name": "4"
            },
            {
              "name": "8"
            }
          ]
        }
      ]
    },
    {
      "name": "list",
      "alias": [
        "ls",
        "l"
      ],
      "usage": [
        "list [OPTIONS] <ARCHIVES>..."
      ],
      "tip": [
        "列出归档文件的内容"
      ],
      "option": [
        {
          "name": "--format",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --format <FORMAT>"
          ],
          "tip": [
            "指定归档文件的格式"
          ],
          "next": []
        },
        {
          "name": "--gitignore",
          "alias": [
            "-g"
          ],
          "usage": [
            "-g, --gitignore"
          ],
          "tip": [
            "忽略 git 忽略文件中匹配的文件"
          ]
        },
        {
          "name": "--hidden",
          "alias": [
            "-H"
          ],
          "usage": [
            "-H, --hidden"
          ],
          "tip": [
            "忽略隐藏文件"
          ]
        },
        {
          "name": "--password",
          "alias": [
            "-p"
          ],
          "usage": [
            "-p, --password <PASSWORD>"
          ],
          "tip": [
            "使用密码列出内容"
          ],
          "next": []
        },
        {
          "name": "--tree",
          "alias": [
            "-t"
          ],
          "usage": [
            "-t, --tree"
          ],
          "tip": [
            "以树形结构显示归档内容"
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--accessible",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --accessible"
      ],
      "tip": [
        "启用无障碍模式，减少视觉干扰"
      ]
    },
    {
      "name": "--no",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no"
      ],
      "tip": [
        "跳过 [Y/n] 确认，默认选择否"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "静默输出"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息"
      ]
    },
    {
      "name": "--yes",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --yes"
      ],
      "tip": [
        "跳过 [Y/n] 确认，默认选择是"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息"
      ]
    }
  ]
}
