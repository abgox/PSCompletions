{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示或更改交换区的标签或 UUID。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--label",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --label <label>"
      ],
      "tip": [
        "指定新标签。"
      ],
      "next": []
    },
    {
      "name": "--uuid",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --uuid <uuid>"
      ],
      "tip": [
        "指定新 UUID。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
