{
  "meta": {
    "url": "https://github.com/Pana/nrm",
    "description": [
      "npm 镜像源管理。"
    ]
  },
  "next": [
    {
      "name": "add",
      "usage": [
        "add <name> <url> [home]"
      ],
      "tip": [
        "添加自定义注册表"
      ]
    },
    {
      "name": "current",
      "tip": [
        "显示当前注册表名称或 URL"
      ],
      "option": [
        {
          "name": "-u",
          "tip": [
            "显示注册表 URL 而不是名称"
          ]
        }
      ]
    },
    {
      "name": "del",
      "usage": [
        "del <name>"
      ],
      "tip": [
        "删除自定义注册表"
      ]
    },
    {
      "name": "del-scope",
      "usage": [
        "del-scope <scopeName>"
      ],
      "tip": [
        "删除作用域与注册表的关联"
      ]
    },
    {
      "name": "help",
      "usage": [
        "help [command]"
      ],
      "tip": [
        "显示命令的帮助"
      ]
    },
    {
      "name": "home",
      "usage": [
        "home <name> [browser]"
      ],
      "tip": [
        "使用可选浏览器打开注册表的主页"
      ]
    },
    {
      "name": "login",
      "usage": [
        "login [options] <name> [base64]"
      ],
      "tip": [
        "使用 base64 编码的字符串或用户名和密码设置自定义注册表的授权信息"
      ]
    },
    {
      "name": "ls",
      "tip": [
        "列出所有注册表"
      ]
    },
    {
      "name": "rename",
      "usage": [
        "rename <name> <newName>"
      ],
      "tip": [
        "更改自定义注册表名称"
      ]
    },
    {
      "name": "set",
      "usage": [
        "set [options] <name>"
      ],
      "tip": [
        "设置自定义注册表属性"
      ]
    },
    {
      "name": "set-hosted-repo",
      "usage": [
        "set-hosted-repo <name> <repo>"
      ],
      "tip": [
        "将自定义注册表的托管 npm 存储库设置为要发布包的存储库"
      ]
    },
    {
      "name": "set-scope",
      "usage": [
        "set-scope <scopeName> <url>"
      ],
      "tip": [
        "将作用域与注册表相关联"
      ]
    },
    {
      "name": "test",
      "usage": [
        "test [registry]"
      ],
      "tip": [
        "显示特定或所有注册表的响应时间"
      ]
    },
    {
      "name": "use",
      "usage": [
        "use <name>"
      ],
      "tip": [
        "更改当前注册表"
      ]
    }
  ],
  "option": [
    {
      "name": "-V",
      "tip": [
        "显示 nrm 的版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
