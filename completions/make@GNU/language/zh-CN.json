{
  "meta": {
    "url": "https://www.gnu.org/software/make",
    "description": [
      "维护程序组的 GNU make 工具。"
    ]
  },
  "option": [
    {
      "name": "--always-make",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --always-make"
      ],
      "tip": [
        "无条件构建所有目标。"
      ]
    },
    {
      "name": "--assume-new",
      "alias": [
        "--new-file",
        "--what-if",
        "-W"
      ],
      "usage": [
        "-W FILE, --what-if=FILE, --new-file=FILE, --assume-new=FILE"
      ],
      "tip": [
        "将 FILE 视为无限新。"
      ],
      "next": []
    },
    {
      "name": "--assume-old",
      "alias": [
        "--old-file",
        "-o"
      ],
      "usage": [
        "-o FILE, --old-file=FILE, --assume-old=FILE"
      ],
      "tip": [
        "将 FILE 视为非常旧，不重新构建它。"
      ],
      "next": []
    },
    {
      "name": "--check-symlink-times",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --check-symlink-times"
      ],
      "tip": [
        "使用符号链接和目标之间较新的 mtime。"
      ]
    },
    {
      "name": "--debug",
      "usage": [
        "--debug[=FLAGS]"
      ],
      "tip": [
        "打印各种类型的调试信息。",
        "FLAGS 可为 all、basic、verbose、implicit、jobs、makefile、print、why 或 none。",
        "该值必须使用 = 附加。"
      ],
      "next": []
    },
    {
      "name": "--directory",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C DIRECTORY, --directory=DIRECTORY"
      ],
      "tip": [
        "在做任何事之前切换到 DIRECTORY。"
      ],
      "next": []
    },
    {
      "name": "--environment-overrides",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --environment-overrides"
      ],
      "tip": [
        "环境变量覆盖 makefile。"
      ]
    },
    {
      "name": "--eval",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E STRING, --eval=STRING"
      ],
      "tip": [
        "将 STRING 作为 makefile 语句求值。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印此消息并退出。"
      ]
    },
    {
      "name": "--ignore-errors",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-errors"
      ],
      "tip": [
        "忽略 recipe 中的错误。"
      ]
    },
    {
      "name": "--include-dir",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I DIRECTORY, --include-dir=DIRECTORY"
      ],
      "tip": [
        "在 DIRECTORY 中搜索包含的 makefile。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--jobs",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j [N], --jobs[=N]"
      ],
      "tip": [
        "一次允许 N 个作业；没有参数时作业数不限。",
        "长选项的值必须使用 = 附加。"
      ],
      "next": []
    },
    {
      "name": "--jobserver-style",
      "usage": [
        "--jobserver-style=STYLE"
      ],
      "tip": [
        "选择要使用的 jobserver 风格。",
        "可能值: fifo, pipe, sem.",
        "sem 仅限 Windows。"
      ],
      "next": [
        {
          "name": "fifo"
        },
        {
          "name": "pipe"
        },
        {
          "name": "sem"
        }
      ]
    },
    {
      "name": "--just-print",
      "alias": [
        "--dry-run",
        "--recon",
        "-n"
      ],
      "usage": [
        "-n, --recon, --dry-run, --just-print"
      ],
      "tip": [
        "不实际运行任何 recipe；只打印它们。"
      ]
    },
    {
      "name": "--keep-going",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --keep-going"
      ],
      "tip": [
        "某些目标无法构建时继续。"
      ]
    },
    {
      "name": "--load-average",
      "alias": [
        "--max-load",
        "-l"
      ],
      "usage": [
        "-l [N], --max-load[=N], --load-average[=N]"
      ],
      "tip": [
        "除非负载低于 N，否则不启动多个作业。",
        "长选项的值必须使用 = 附加。"
      ],
      "next": []
    },
    {
      "name": "--makefile",
      "alias": [
        "--file",
        "-f"
      ],
      "usage": [
        "-f FILE, --file=FILE, --makefile=FILE"
      ],
      "tip": [
        "将 FILE 作为 makefile 读取。"
      ],
      "next": []
    },
    {
      "name": "--no-builtin-rules",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --no-builtin-rules"
      ],
      "tip": [
        "禁用内置隐式规则。"
      ]
    },
    {
      "name": "--no-builtin-variables",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --no-builtin-variables"
      ],
      "tip": [
        "禁用内置变量设置。"
      ]
    },
    {
      "name": "--no-keep-going",
      "alias": [
        "--stop",
        "-S"
      ],
      "usage": [
        "-S, --stop, --no-keep-going"
      ],
      "tip": [
        "关闭 --keep-going。"
      ]
    },
    {
      "name": "--no-print-directory",
      "tip": [
        "关闭 --print-directory，即使它是被隐式开启的。"
      ]
    },
    {
      "name": "--no-silent",
      "tip": [
        "回显 recipe（禁用 --silent 模式）。"
      ]
    },
    {
      "name": "--output-sync",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O[TYPE], --output-sync[=TYPE]"
      ],
      "tip": [
        "按 TYPE 同步并行作业的输出。",
        "TYPE 可为 none、line、target 或 recurse。",
        "长选项的值必须使用 = 附加。"
      ],
      "next": []
    },
    {
      "name": "--print-data-base",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --print-data-base"
      ],
      "tip": [
        "打印 make 的内部数据库。"
      ]
    },
    {
      "name": "--print-directory",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --print-directory"
      ],
      "tip": [
        "打印当前目录。"
      ]
    },
    {
      "name": "--question",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --question"
      ],
      "tip": [
        "不运行 recipe；退出状态表示是否已是最新。"
      ]
    },
    {
      "name": "--shuffle",
      "usage": [
        "--shuffle[=MODE]"
      ],
      "tip": [
        "打乱前置条件和目标的顺序。",
        "MODE 可为 none、random、reverse 或整数种子。",
        "该值必须使用 = 附加。"
      ],
      "next": []
    },
    {
      "name": "--silent",
      "alias": [
        "--quiet",
        "-s"
      ],
      "usage": [
        "-s, --quiet, --silent"
      ],
      "tip": [
        "不回显 recipe。"
      ]
    },
    {
      "name": "--touch",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --touch"
      ],
      "tip": [
        "触摸目标，而不是重新构建它们。"
      ]
    },
    {
      "name": "--trace",
      "tip": [
        "打印跟踪信息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "打印 make 的版本号并退出。"
      ]
    },
    {
      "name": "--warn-undefined-variables",
      "tip": [
        "引用未定义变量时发出警告。"
      ]
    },
    {
      "name": "-b",
      "tip": [
        "为兼容性而忽略。"
      ]
    },
    {
      "name": "-d",
      "tip": [
        "打印大量调试信息。"
      ]
    },
    {
      "name": "-m",
      "tip": [
        "为兼容性而忽略。"
      ]
    }
  ]
}
