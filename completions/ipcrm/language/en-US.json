{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Remove certain IPC resources."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all[=shm|pshm|msg|pmsg|sem|psem]"
      ],
      "tip": [
        "Remove all (in the specified category).",
        "Possible values: shm, pshm, msg, pmsg, sem, psem"
      ],
      "next": [
        {
          "name": "msg"
        },
        {
          "name": "pmsg"
        },
        {
          "name": "psem"
        },
        {
          "name": "pshm"
        },
        {
          "name": "sem"
        },
        {
          "name": "shm"
        }
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--posix-mqueue",
      "usage": [
        "--posix-mqueue <name>"
      ],
      "tip": [
        "Remove POSIX message queue by name."
      ],
      "next": []
    },
    {
      "name": "--posix-semaphore",
      "usage": [
        "--posix-semaphore <name>"
      ],
      "tip": [
        "Remove POSIX semaphore by name."
      ],
      "next": []
    },
    {
      "name": "--posix-shmem",
      "usage": [
        "--posix-shmem <name>"
      ],
      "tip": [
        "Remove POSIX shared memory segment by name."
      ],
      "next": []
    },
    {
      "name": "--queue-id",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --queue-id <id>"
      ],
      "tip": [
        "Remove message queue by id."
      ],
      "next": []
    },
    {
      "name": "--queue-key",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --queue-key <key>"
      ],
      "tip": [
        "Remove message queue by key."
      ],
      "next": []
    },
    {
      "name": "--semaphore-id",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --semaphore-id <id>"
      ],
      "tip": [
        "Remove semaphore by id."
      ],
      "next": []
    },
    {
      "name": "--semaphore-key",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --semaphore-key <key>"
      ],
      "tip": [
        "Remove semaphore by key."
      ],
      "next": []
    },
    {
      "name": "--shmem-id",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --shmem-id <id>"
      ],
      "tip": [
        "Remove shared memory segment by id."
      ],
      "next": []
    },
    {
      "name": "--shmem-key",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --shmem-key <key>"
      ],
      "tip": [
        "Remove shared memory segment by key."
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Explain what is being done."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
