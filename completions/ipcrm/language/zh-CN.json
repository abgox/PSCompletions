{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "删除某些 IPC 资源。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all[=shm|pshm|msg|pmsg|sem|psem]"
      ],
      "tip": [
        "删除全部（在指定类别中）。",
        "可能值: shm, pshm, msg, pmsg, sem, psem"
      ],
      "next": [
        {
          "name": "msg"
        },
        {
          "name": "pmsg"
        },
        {
          "name": "psem"
        },
        {
          "name": "pshm"
        },
        {
          "name": "sem"
        },
        {
          "name": "shm"
        }
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--posix-mqueue",
      "usage": [
        "--posix-mqueue <name>"
      ],
      "tip": [
        "按名称删除 POSIX 消息队列。"
      ],
      "next": []
    },
    {
      "name": "--posix-semaphore",
      "usage": [
        "--posix-semaphore <name>"
      ],
      "tip": [
        "按名称删除 POSIX 信号量。"
      ],
      "next": []
    },
    {
      "name": "--posix-shmem",
      "usage": [
        "--posix-shmem <name>"
      ],
      "tip": [
        "按名称删除 POSIX 共享内存段。"
      ],
      "next": []
    },
    {
      "name": "--queue-id",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --queue-id <id>"
      ],
      "tip": [
        "按 id 删除消息队列。"
      ],
      "next": []
    },
    {
      "name": "--queue-key",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --queue-key <key>"
      ],
      "tip": [
        "按键删除消息队列。"
      ],
      "next": []
    },
    {
      "name": "--semaphore-id",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --semaphore-id <id>"
      ],
      "tip": [
        "按 id 删除信号量。"
      ],
      "next": []
    },
    {
      "name": "--semaphore-key",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --semaphore-key <key>"
      ],
      "tip": [
        "按键删除信号量。"
      ],
      "next": []
    },
    {
      "name": "--shmem-id",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --shmem-id <id>"
      ],
      "tip": [
        "按 id 删除共享内存段。"
      ],
      "next": []
    },
    {
      "name": "--shmem-key",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --shmem-key <key>"
      ],
      "tip": [
        "按键删除共享内存段。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "说明正在执行的操作。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
