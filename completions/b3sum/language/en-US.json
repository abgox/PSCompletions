{
  "meta": {
    "url": "https://github.com/BLAKE3-team/BLAKE3",
    "description": [
      "Compute and check BLAKE3 message digests."
    ]
  },
  "option": [
    {
      "name": "--check",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --check"
      ],
      "tip": [
        "Read BLAKE3 sums from the FILEs and check them"
      ]
    },
    {
      "name": "--derive-key",
      "usage": [
        "--derive-key <CONTEXT>"
      ],
      "tip": [
        "Use the key derivation mode, with the given context string",
        "Cannot be used with --keyed."
      ],
      "next": []
    },
    {
      "name": "--keyed",
      "tip": [
        "Use the keyed mode, reading the 32-byte key from stdin"
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --length <LEN>"
      ],
      "tip": [
        "The number of output bytes, before hex encoding",
        "[default: 32]"
      ],
      "next": [
        {
          "name": "32",
          "tip": [
            "Default output length (32 bytes)"
          ]
        },
        {
          "name": "64",
          "tip": [
            "Output 64 bytes"
          ]
        }
      ]
    },
    {
      "name": "--no-mmap",
      "tip": [
        "Disable memory mapping",
        "Currently this also disables multithreading."
      ]
    },
    {
      "name": "--no-names",
      "tip": [
        "Omit filenames in the output"
      ]
    },
    {
      "name": "--num-threads",
      "usage": [
        "--num-threads <NUM>"
      ],
      "tip": [
        "The maximum number of threads to use",
        "By default, this is the number of logical cores. If this flag is omitted, or if its value is 0, RAYON_NUM_THREADS is also respected."
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "tip": [
        "Skip printing OK for each checked file",
        "Must be used with --check."
      ]
    },
    {
      "name": "--raw",
      "tip": [
        "Write raw output bytes to stdout, rather than hex",
        "--no-names is implied. In this case, only a single input is allowed."
      ]
    },
    {
      "name": "--seek",
      "usage": [
        "--seek <SEEK>"
      ],
      "tip": [
        "The starting output byte offset, before hex encoding",
        "[default: 0]"
      ],
      "next": []
    },
    {
      "name": "--tag",
      "tip": [
        "Output BSD-style checksums: BLAKE3 ([FILE]) = [HASH]"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help (see a summary with '-h')"
      ]
    }
  ]
}
