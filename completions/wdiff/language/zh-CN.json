{
  "meta": {
    "url": "https://www.gnu.org/software/wdiff",
    "description": [
      "比较两个文件中的单词并报告差异。"
    ]
  },
  "option": [
    {
      "name": "--auto-pager",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --auto-pager"
      ],
      "tip": [
        "自动调用分页器。"
      ]
    },
    {
      "name": "--avoid-wraps",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --avoid-wraps"
      ],
      "tip": [
        "不跨换行符延续字段。"
      ]
    },
    {
      "name": "--copyright",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --copyright"
      ],
      "tip": [
        "显示版权信息后退出。"
      ]
    },
    {
      "name": "--diff-input",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --diff-input"
      ],
      "tip": [
        "使用单个统一 diff 作为输入。"
      ]
    },
    {
      "name": "--end-delete",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --end-delete=STRING"
      ],
      "tip": [
        "标记删除区域结束的字符串。"
      ],
      "next": []
    },
    {
      "name": "--end-insert",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --end-insert=STRING"
      ],
      "tip": [
        "标记插入区域结束的字符串。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助后退出。"
      ]
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-case"
      ],
      "tip": [
        "比较时忽略字符大小写。"
      ]
    },
    {
      "name": "--less-mode",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --less-mode"
      ],
      "tip": [
        "使用适用于 “less” 的打印机模式变体。"
      ]
    },
    {
      "name": "--no-common",
      "alias": [
        "-3"
      ],
      "usage": [
        "-3, --no-common"
      ],
      "tip": [
        "禁止输出相同的单词。"
      ]
    },
    {
      "name": "--no-deleted",
      "alias": [
        "-1"
      ],
      "usage": [
        "-1, --no-deleted"
      ],
      "tip": [
        "禁止输出被删除的单词。"
      ]
    },
    {
      "name": "--no-init-term",
      "alias": [
        "-K"
      ],
      "usage": [
        "-K, --no-init-term"
      ],
      "tip": [
        "现在与 --terminal 同义，后者从不初始化终端。",
        "（已弃用，请改用 --terminal）"
      ]
    },
    {
      "name": "--no-inserted",
      "alias": [
        "-2"
      ],
      "usage": [
        "-2, --no-inserted"
      ],
      "tip": [
        "禁止输出被插入的单词。"
      ]
    },
    {
      "name": "--printer",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --printer"
      ],
      "tip": [
        "使用适合打印机的叠印方式。"
      ]
    },
    {
      "name": "--start-delete",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --start-delete=STRING"
      ],
      "tip": [
        "标记删除区域开始的字符串。"
      ],
      "next": []
    },
    {
      "name": "--start-insert",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --start-insert=STRING"
      ],
      "tip": [
        "标记插入区域开始的字符串。"
      ],
      "next": []
    },
    {
      "name": "--statistics",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --statistics"
      ],
      "tip": [
        "报告删除、插入等的单词数量。"
      ]
    },
    {
      "name": "--terminal",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --terminal"
      ],
      "tip": [
        "使用适合终端显示的 termcap。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示程序版本后退出。"
      ]
    }
  ]
}
