{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Encode/decode data and print to standard output."
    ]
  },
  "option": [
    {
      "name": "--decode",
      "alias": [
        "-d",
        "-D"
      ],
      "usage": [
        "-d, -D, --decode"
      ],
      "tip": [
        "decode data"
      ]
    },
    {
      "name": "--ignore-garbage",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-garbage"
      ],
      "tip": [
        "when decoding, ignore non-alphabetic characters"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    },
    {
      "name": "--wrap",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wrap <COLS>"
      ],
      "tip": [
        "wrap encoded lines after COLS character (default 76, 0 to disable wrapping)"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show the help."
      ]
    }
  ]
}
