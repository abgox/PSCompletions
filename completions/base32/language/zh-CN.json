{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "编码/解码数据并输出到标准输出。"
    ]
  },
  "option": [
    {
      "name": "--decode",
      "alias": [
        "-d",
        "-D"
      ],
      "usage": [
        "-d, -D, --decode"
      ],
      "tip": [
        "解码数据"
      ]
    },
    {
      "name": "--ignore-garbage",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-garbage"
      ],
      "tip": [
        "解码时忽略非字母字符"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--wrap",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wrap <COLS>"
      ],
      "tip": [
        "在 COLS 个字符后换行（默认 76，0 表示禁用换行）"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
