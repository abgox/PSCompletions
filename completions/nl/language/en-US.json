{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Number lines of files."
    ]
  },
  "option": [
    {
      "name": "--body-numbering",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --body-numbering <STYLE>"
      ],
      "tip": [
        "use STYLE for numbering body lines"
      ],
      "next": [
        {
          "name": "a",
          "tip": [
            "number all lines"
          ]
        },
        {
          "name": "n",
          "tip": [
            "number no lines"
          ]
        },
        {
          "name": "pBRE",
          "tip": [
            "number only lines that contain a match for the basic regular expression, BRE"
          ]
        },
        {
          "name": "t",
          "tip": [
            "number only nonempty lines"
          ]
        }
      ]
    },
    {
      "name": "--footer-numbering",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --footer-numbering <STYLE>"
      ],
      "tip": [
        "use STYLE for numbering footer lines"
      ],
      "next": [
        {
          "name": "a",
          "tip": [
            "number all lines"
          ]
        },
        {
          "name": "n",
          "tip": [
            "number no lines"
          ]
        },
        {
          "name": "pBRE",
          "tip": [
            "number only lines that contain a match for the basic regular expression, BRE"
          ]
        },
        {
          "name": "t",
          "tip": [
            "number only nonempty lines"
          ]
        }
      ]
    },
    {
      "name": "--header-numbering",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --header-numbering <STYLE>"
      ],
      "tip": [
        "use STYLE for numbering header lines"
      ],
      "next": [
        {
          "name": "a",
          "tip": [
            "number all lines"
          ]
        },
        {
          "name": "n",
          "tip": [
            "number no lines"
          ]
        },
        {
          "name": "pBRE",
          "tip": [
            "number only lines that contain a match for the basic regular expression, BRE"
          ]
        },
        {
          "name": "t",
          "tip": [
            "number only nonempty lines"
          ]
        }
      ]
    },
    {
      "name": "--join-blank-lines",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --join-blank-lines <NUMBER>"
      ],
      "tip": [
        "group of NUMBER empty lines counted as one"
      ],
      "next": []
    },
    {
      "name": "--line-increment",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --line-increment <NUMBER>"
      ],
      "tip": [
        "line number increment at each line"
      ],
      "next": []
    },
    {
      "name": "--no-renumber",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --no-renumber"
      ],
      "tip": [
        "do not reset line numbers at logical pages"
      ]
    },
    {
      "name": "--number-format",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --number-format <FORMAT>"
      ],
      "tip": [
        "insert line numbers according to FORMAT"
      ],
      "next": [
        {
          "name": "ln",
          "tip": [
            "left justified, no leading zeros"
          ]
        },
        {
          "name": "rn",
          "tip": [
            "right justified, no leading zeros"
          ]
        },
        {
          "name": "rz",
          "tip": [
            "right justified, leading zeros"
          ]
        }
      ]
    },
    {
      "name": "--number-separator",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --number-separator <STRING>"
      ],
      "tip": [
        "add STRING after (possible) line number"
      ],
      "next": []
    },
    {
      "name": "--number-width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --number-width <NUMBER>"
      ],
      "tip": [
        "use NUMBER columns for line numbers"
      ],
      "next": []
    },
    {
      "name": "--section-delimiter",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --section-delimiter <CC>"
      ],
      "tip": [
        "use CC for separating logical pages"
      ],
      "next": []
    },
    {
      "name": "--starting-line-number",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --starting-line-number <NUMBER>"
      ],
      "tip": [
        "first line number on each logical page"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "Show the help."
      ]
    }
  ]
}
