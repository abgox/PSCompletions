{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "为文件行编号。"
    ]
  },
  "option": [
    {
      "name": "--body-numbering",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --body-numbering <STYLE>"
      ],
      "tip": [
        "使用 STYLE 为正文行编号"
      ],
      "next": [
        {
          "name": "a",
          "tip": [
            "为所有行编号"
          ]
        },
        {
          "name": "n",
          "tip": [
            "不为任何行编号"
          ]
        },
        {
          "name": "pBRE",
          "tip": [
            "仅为包含基本正则表达式 BRE 匹配的行编号"
          ]
        },
        {
          "name": "t",
          "tip": [
            "仅为非空行编号"
          ]
        }
      ]
    },
    {
      "name": "--footer-numbering",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --footer-numbering <STYLE>"
      ],
      "tip": [
        "使用 STYLE 为页脚行编号"
      ],
      "next": [
        {
          "name": "a",
          "tip": [
            "为所有行编号"
          ]
        },
        {
          "name": "n",
          "tip": [
            "不为任何行编号"
          ]
        },
        {
          "name": "pBRE",
          "tip": [
            "仅为包含基本正则表达式 BRE 匹配的行编号"
          ]
        },
        {
          "name": "t",
          "tip": [
            "仅为非空行编号"
          ]
        }
      ]
    },
    {
      "name": "--header-numbering",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --header-numbering <STYLE>"
      ],
      "tip": [
        "使用 STYLE 为页眉行编号"
      ],
      "next": [
        {
          "name": "a",
          "tip": [
            "为所有行编号"
          ]
        },
        {
          "name": "n",
          "tip": [
            "不为任何行编号"
          ]
        },
        {
          "name": "pBRE",
          "tip": [
            "仅为包含基本正则表达式 BRE 匹配的行编号"
          ]
        },
        {
          "name": "t",
          "tip": [
            "仅为非空行编号"
          ]
        }
      ]
    },
    {
      "name": "--join-blank-lines",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --join-blank-lines <NUMBER>"
      ],
      "tip": [
        "NUMBER 个空行视为一组"
      ],
      "next": []
    },
    {
      "name": "--line-increment",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --line-increment <NUMBER>"
      ],
      "tip": [
        "每行的行号增量"
      ],
      "next": []
    },
    {
      "name": "--no-renumber",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --no-renumber"
      ],
      "tip": [
        "不在逻辑页重置行号"
      ]
    },
    {
      "name": "--number-format",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --number-format <FORMAT>"
      ],
      "tip": [
        "根据 FORMAT 插入行号"
      ],
      "next": [
        {
          "name": "ln",
          "tip": [
            "左对齐，无前导零"
          ]
        },
        {
          "name": "rn",
          "tip": [
            "右对齐，无前导零"
          ]
        },
        {
          "name": "rz",
          "tip": [
            "右对齐，有前导零"
          ]
        }
      ]
    },
    {
      "name": "--number-separator",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --number-separator <STRING>"
      ],
      "tip": [
        "在（可能的）行号后添加 STRING"
      ],
      "next": []
    },
    {
      "name": "--number-width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --number-width <NUMBER>"
      ],
      "tip": [
        "使用 NUMBER 列作为行号宽度"
      ],
      "next": []
    },
    {
      "name": "--section-delimiter",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --section-delimiter <CC>"
      ],
      "tip": [
        "使用 CC 分隔逻辑页"
      ],
      "next": []
    },
    {
      "name": "--starting-line-number",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --starting-line-number <NUMBER>"
      ],
      "tip": [
        "每个逻辑页的起始行号"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
