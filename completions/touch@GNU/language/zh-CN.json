{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把每个 FILE 的访问时间和修改时间更新为当前时间。"
    ]
  },
  "option": [
    {
      "name": "--date",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --date <STRING>"
      ],
      "tip": [
        "解析 STRING 并用它代替当前时间"
      ],
      "next": [
        {
          "name": "now"
        }
      ]
    },
    {
      "name": "--no-create",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --no-create"
      ],
      "tip": [
        "不创建任何文件"
      ]
    },
    {
      "name": "--no-dereference",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --no-dereference"
      ],
      "tip": [
        "作用于每个符号链接本身而不是它引用的文件（只有在可以修改符号链接时间戳的系统上才有意义）"
      ]
    },
    {
      "name": "--reference",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reference <FILE>"
      ],
      "tip": [
        "使用这个文件的时间而不是当前时间"
      ],
      "next": []
    },
    {
      "name": "--time",
      "usage": [
        "--time <WORD>"
      ],
      "tip": [
        "指定要修改哪个时间：访问时间（-a）为 'access'、'atime'、'use'；修改时间（-m）为 'modify'、'mtime'"
      ],
      "next": [
        {
          "name": "access"
        },
        {
          "name": "atime"
        },
        {
          "name": "modify"
        },
        {
          "name": "mtime"
        },
        {
          "name": "use"
        }
      ]
    },
    {
      "name": "-a",
      "tip": [
        "只修改访问时间"
      ]
    },
    {
      "name": "-f",
      "tip": [
        "（已忽略，不起作用）"
      ]
    },
    {
      "name": "-m",
      "tip": [
        "只修改修改时间"
      ]
    },
    {
      "name": "-t",
      "usage": [
        "-t <[[CC]YY]MMDDhhmm[.ss]>"
      ],
      "tip": [
        "使用指定的时间代替当前时间，其日期时间格式与 -d 不同"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
