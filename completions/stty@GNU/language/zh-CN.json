{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "打印或修改终端特性。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "以便于阅读的形式打印所有当前设置"
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --file <DEVICE>"
      ],
      "tip": [
        "打开并使用指定的 DEVICE，而不是 stdin"
      ],
      "next": []
    },
    {
      "name": "--save",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --save"
      ],
      "tip": [
        "以 stty 可读的形式打印所有当前设置"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
