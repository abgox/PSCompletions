{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把各 FILE 中依次对应的行用 TAB 分隔后写入标准输出。"
    ]
  },
  "option": [
    {
      "name": "--delimiters",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delimiters <LIST>"
      ],
      "tip": [
        "重复使用 LIST 中的字符，而不是 TAB"
      ],
      "next": []
    },
    {
      "name": "--serial",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --serial"
      ],
      "tip": [
        "逐个处理文件而非并行处理"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "行分隔符为 NUL，而不是换行符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
