{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把每个 FILE 的大小缩小或扩展到指定大小"
    ]
  },
  "option": [
    {
      "name": "--io-blocks",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --io-blocks"
      ],
      "tip": [
        "把 SIZE 当作 IO 块数而不是字节数"
      ]
    },
    {
      "name": "--no-create",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --no-create"
      ],
      "tip": [
        "不创建任何文件"
      ]
    },
    {
      "name": "--reference",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reference <RFILE>"
      ],
      "tip": [
        "以 RFILE 的大小为基准"
      ],
      "next": []
    },
    {
      "name": "--size",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --size <SIZE>"
      ],
      "tip": [
        "把文件大小设为 SIZE 字节或在其基础上增减"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1K"
        },
        {
          "name": "1M"
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
