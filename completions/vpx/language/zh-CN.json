{
  "meta": {
    "url": "https://viteplus.dev/guide/vpx",
    "description": [
      "执行本地或远程 npm 包中的命令。",
      "运行本地可执行文件，或下载并运行远程包。"
    ]
  },
  "option": [
    {
      "name": "--package",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --package <NAME>"
      ],
      "tip": [
        "本地未找到时要安装的包。"
      ],
      "next": []
    },
    {
      "name": "--shell-mode",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --shell-mode"
      ],
      "tip": [
        "在 Shell 环境中执行命令。"
      ]
    },
    {
      "name": "--silent",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --silent"
      ],
      "tip": [
        "抑制除命令输出之外的全部输出。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助。"
      ]
    }
  ]
}
