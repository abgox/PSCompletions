{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "打印解析后的路径"
    ]
  },
  "option": [
    {
      "name": "--canonicalize",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --canonicalize"
      ],
      "tip": [
        "除最后一部分外都必须存在（默认）"
      ]
    },
    {
      "name": "--canonicalize-existing",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --canonicalize-existing"
      ],
      "tip": [
        "递归跟随给定名称每个部分中的每个符号链接进行规范化，所有部分都必须存在"
      ]
    },
    {
      "name": "--canonicalize-missing",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --canonicalize-missing"
      ],
      "tip": [
        "递归跟随给定名称每个部分中的每个符号链接进行规范化，对部分是否存在没有要求"
      ]
    },
    {
      "name": "--logical",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --logical"
      ],
      "tip": [
        "在符号链接之前解析 .. 部分"
      ]
    },
    {
      "name": "--physical",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --physical"
      ],
      "tip": [
        "遇到符号链接即解析（默认）"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "对无效路径不打印警告"
      ]
    },
    {
      "name": "--relative-base",
      "usage": [
        "--relative-base <DIR>"
      ],
      "tip": [
        "打印绝对路径，除非路径在 DIR 之下"
      ],
      "next": []
    },
    {
      "name": "--relative-to",
      "usage": [
        "--relative-to <DIR>"
      ],
      "tip": [
        "打印相对于 DIR 的解析路径"
      ],
      "next": []
    },
    {
      "name": "--strip",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --strip"
      ],
      "tip": [
        "仅去除 . 和 .. 部分，不解析符号链接"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "以 \\0 而非换行分隔输出文件名"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
