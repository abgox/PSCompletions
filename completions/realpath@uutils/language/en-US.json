{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Print the resolved path"
    ]
  },
  "option": [
    {
      "name": "--canonicalize",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --canonicalize"
      ],
      "tip": [
        "all but the last component must exist (default)"
      ]
    },
    {
      "name": "--canonicalize-existing",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --canonicalize-existing"
      ],
      "tip": [
        "canonicalize by following every symlink in every component of the given name recursively, all components must exist"
      ]
    },
    {
      "name": "--canonicalize-missing",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --canonicalize-missing"
      ],
      "tip": [
        "canonicalize by following every symlink in every component of the given name recursively, without requirements on components existence"
      ]
    },
    {
      "name": "--logical",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --logical"
      ],
      "tip": [
        "resolve '..' components before symlinks"
      ]
    },
    {
      "name": "--physical",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --physical"
      ],
      "tip": [
        "resolve symlinks as encountered (default)"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Do not print warnings for invalid paths"
      ]
    },
    {
      "name": "--relative-base",
      "usage": [
        "--relative-base <DIR>"
      ],
      "tip": [
        "print absolute paths unless paths below DIR"
      ],
      "next": []
    },
    {
      "name": "--relative-to",
      "usage": [
        "--relative-to <DIR>"
      ],
      "tip": [
        "print the resolved path relative to DIR"
      ],
      "next": []
    },
    {
      "name": "--strip",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --strip"
      ],
      "tip": [
        "Only strip '.' and '..' components, but don't resolve symbolic links"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "Separate output filenames with \\0 rather than newline"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
