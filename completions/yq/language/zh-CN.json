    {
      "name": "--xml-proc-inst-prefix",
      "usage": [
        "--xml-proc-inst-prefix <string>"
      ],
      "tip": [
        "xml 处理指令的前缀（默认 +p_）"
      ],
      "next": []
    },
    {
      "name": "--xml-raw-token",
      "tip": [
        "使用 RawToken 方法而非 Token（默认 true）"
      ]
    },
    {
      "name": "--xml-skip-directives",
      "tip": [
        "跳过指令（例如 <!DOCTYPE thing cat>）"
      ]
    },
    {
      "name": "--xml-skip-proc-inst",
      "tip": [
        "跳过处理指令（例如 <?xml version=\"1\"?>)）"
      ]
    },
    {
      "name": "--xml-strict-mode",
      "tip": [
        "启用 XML 严格解析"
      ]
    },
    {
      "name": "--yaml-compact-seq-indent",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --yaml-compact-seq-indent"
      ],
      "tip": [
        "使用紧凑序列缩进，'- ' 被视为缩进的一部分"
      ]
    },
    {
      "name": "--yaml-fix-merge-anchor-to-spec",
      "tip": [
        "修复 merge anchor 以符合 YAML 规范"
      ]
    }
