{
  "meta": {
    "url": "https://github.com/mikefarah/yq",
    "description": [
      "一个可移植的命令行数据文件处理器"
    ]
  },
  "next": [
    {
      "name": "eval",
      "alias": [
        "e"
      ],
      "usage": [
        "e|eval [expression] [yaml_file1]..."
      ],
      "tip": [
        "依次对每个 yaml 文件中的每个文档应用表达式（默认）"
      ]
    },
    {
      "name": "eval-all",
      "alias": [
        "ea"
      ],
      "usage": [
        "ea|eval-all [expression] [yaml_file1]..."
      ],
      "tip": [
        "加载所有 yaml 文件的所有文档并仅运行一次表达式"
      ]
    },
    {
      "name": "help",
      "tip": [
        "查看任意命令的帮助"
      ]
    },
    {
      "name": "shell-completion",
      "alias": [
        "completion"
      ],
      "usage": [
        "completion|shell-completion [bash|zsh|fish|powershell]"
      ],
      "tip": [
        "为指定 Shell 生成自动补全脚本"
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "生成 bash 补全脚本"
          ]
        },
        {
          "name": "fish",
          "tip": [
            "生成 fish 补全脚本"
          ]
        },
        {
          "name": "powershell",
          "tip": [
            "生成 powershell 补全脚本"
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "生成 zsh 补全脚本"
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息并退出"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--colors",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --colors"
      ],
      "tip": [
        "强制使用彩色输出"
      ]
    },
    {
      "name": "--csv-auto-parse",
      "tip": [
        "解析 CSV YAML/JSON 值（默认 true）"
      ]
    },
    {
      "name": "--csv-separator",
      "usage": [
        "--csv-separator <char>"
      ],
      "tip": [
        "CSV 分隔符（默认 ,）"
      ],
      "next": []
    },
    {
      "name": "--debug-node-info",
      "tip": [
        "调试节点信息"
      ]
    },
    {
      "name": "--exit-status",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exit-status"
      ],
      "tip": [
        "如果没有匹配或返回 null 或 false，则设置退出状态"
      ]
    },
    {
      "name": "--expression",
      "usage": [
        "--expression <string>"
      ],
      "tip": [
        "强制设置表达式参数"
      ],
      "next": []
    },
    {
      "name": "--from-file",
      "usage": [
        "--from-file <string>"
      ],
      "tip": [
        "从指定文件加载表达式"
      ],
      "next": []
    },
    {
      "name": "--front-matter",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --front-matter <TYPE>"
      ],
      "tip": [
        "将第一个输入提取或处理为 yaml front-matter"
      ],
      "next": [
        {
          "name": "extract",
          "tip": [
            "提取 yaml 内容"
          ]
        },
        {
          "name": "process",
          "tip": [
            "对 yaml 内容运行表达式"
          ]
        }
      ]
    },
    {
      "name": "--header-preprocess",
      "tip": [
        "在处理表达式前合并所有头部注释和分隔符（默认 true）"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "yq 帮助"
      ]
    },
    {
      "name": "--indent",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --indent <int>"
      ],
      "tip": [
        "设置输出的缩进级别（默认 2）"
      ],
      "next": [
        {
          "name": "2",
          "tip": [
            "缩进级别 2（默认）"
