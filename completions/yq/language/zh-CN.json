      "name": "--split-exp",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --split-exp <string>"
      ],
      "tip": [
        "将每个结果（或文档）打印到名为 (exp) 的文件中"
      ],
      "next": []
    },
    {
      "name": "--split-exp-file",
      "usage": [
        "--split-exp-file <string>"
      ],
      "tip": [
        "使用文件指定 split-exp 表达式"
      ],
      "next": []
    },
    {
      "name": "--string-interpolation",
      "tip": [
        "切换 \\(exp\\) 字符串插值（默认 true）"
      ]
    },
    {
      "name": "--tsv-auto-parse",
      "tip": [
        "解析 TSV YAML/JSON 值（默认 true）"
      ]
    },
    {
      "name": "--unwrapScalar",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --unwrapScalar"
      ],
      "tip": [
        "解包标量，不带引号、颜色或注释地打印值（yaml 默认 true）"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "详细模式"
      ]
    },
