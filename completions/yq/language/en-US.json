    {
      "name": "--prettyPrint",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --prettyPrint"
      ],
      "tip": [
        "Pretty print, shorthand for '... style = \"\"'"
      ]
    },
    {
      "name": "--properties-array-brackets",
      "tip": [
        "Use [x] in array paths (e.g. for SpringBoot)"
      ]
    },
    {
      "name": "--properties-separator",
      "usage": [
        "--properties-separator <string>"
      ],
      "tip": [
        "Separator to use between keys and values (default  = )"
      ],
      "next": []
    },
    {
      "name": "--security-disable-env-ops",
      "tip": [
        "Disable env related operations"
      ]
    },
    {
      "name": "--security-disable-file-ops",
      "tip": [
        "Disable file related operations (e.g. load)"
      ]
    },
    {
      "name": "--security-enable-system-operator",
      "tip": [
        "Enable system operator to allow execution of external commands"
      ]
    },
    {
      "name": "--shell-key-separator",
      "usage": [
        "--shell-key-separator <string>"
      ],
      "tip": [
        "Separator for shell variable key paths (default _)"
      ],
      "next": []
    },
    {
      "name": "--split-exp",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --split-exp <string>"
      ],
      "tip": [
        "Print each result (or doc) into a file named (exp)"
      ],
      "next": []
    },
    {
      "name": "--split-exp-file",
      "usage": [
        "--split-exp-file <string>"
      ],
      "tip": [
        "Use a file to specify the split-exp expression"
      ],
      "next": []
    },
    {
      "name": "--string-interpolation",
      "tip": [
        "Toggles strings interpolation of \\(exp\\) (default true)"
      ]
    },
    {
      "name": "--tsv-auto-parse",
      "tip": [
        "Parse TSV YAML/JSON values (default true)"
      ]
    },
    {
      "name": "--unwrapScalar",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --unwrapScalar"
      ],
      "tip": [
        "Unwrap scalar, print the value with no quotes, colours or comments (default true for yaml)"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Verbose mode"
      ]
    },
    {
      "name": "--xml-attribute-prefix",
      "usage": [
        "--xml-attribute-prefix <string>"
      ],
      "tip": [
        "Prefix for xml attributes (default +@)"
      ],
      "next": []
    },
    {
      "name": "--xml-content-name",
      "usage": [
        "--xml-content-name <string>"
      ],
      "tip": [
        "Name for xml content (if no attribute name is present) (default +content)"
      ],
      "next": []
    },
    {
      "name": "--xml-directive-name",
      "usage": [
        "--xml-directive-name <string>"
      ],
      "tip": [
        "Name for xml directives (default +directive)"
      ],
      "next": []
    },
    {
      "name": "--xml-keep-namespace",
      "tip": [
        "Enables keeping namespace after parsing attributes (default true)"
      ]
    },
    {
      "name": "--xml-proc-inst-prefix",
      "usage": [
        "--xml-proc-inst-prefix <string>"
      ],
      "tip": [
        "Prefix for xml processing instructions (default +p_)"
      ],
      "next": []
    },
    {
      "name": "--xml-raw-token",
      "tip": [
        "Enables using RawToken method instead Token (default true)"
      ]
    },
    {
      "name": "--xml-skip-directives",
      "tip": [
        "Skip over directives (e.g. <!DOCTYPE thing cat>)"
      ]
    },
    {
      "name": "--xml-skip-proc-inst",
      "tip": [
        "Skip over process instructions (e.g. <?xml version=\"1\"?>)"
      ]
    },
    {
      "name": "--xml-strict-mode",
      "tip": [
        "Enables strict parsing of XML"
      ]
    },
    {
      "name": "--yaml-compact-seq-indent",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --yaml-compact-seq-indent"
      ],
      "tip": [
        "Use compact sequence indentation where '- ' is considered part of the indentation"
      ]
    },
    {
      "name": "--yaml-fix-merge-anchor-to-spec",
      "tip": [
        "Fix merge anchor to match YAML spec"
      ]
    }
  ]
