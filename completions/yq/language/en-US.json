{
  "meta": {
    "url": "https://github.com/mikefarah/yq",
    "description": [
      "A portable command-line data file processor"
    ]
  },
  "next": [
    {
      "name": "eval",
      "alias": [
        "e"
      ],
      "usage": [
        "e|eval [expression] [yaml_file1]..."
      ],
      "tip": [
        "Apply the expression to each document in each yaml file in sequence (default)"
      ]
    },
    {
      "name": "eval-all",
      "alias": [
        "ea"
      ],
      "usage": [
        "ea|eval-all [expression] [yaml_file1]..."
      ],
      "tip": [
        "Loads _all_ yaml documents of _all_ yaml files and runs expression once"
      ]
    },
    {
      "name": "help",
      "tip": [
        "Help about any command"
      ]
    },
    {
      "name": "shell-completion",
      "alias": [
        "completion"
      ],
      "usage": [
        "completion|shell-completion [bash|zsh|fish|powershell]"
      ],
      "tip": [
        "Generate the autocompletion script for the specified shell"
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "Generate bash completion script"
          ]
        },
        {
          "name": "fish",
          "tip": [
            "Generate fish completion script"
          ]
        },
        {
          "name": "powershell",
          "tip": [
            "Generate powershell completion script"
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "Generate zsh completion script"
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version information and quit"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--colors",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --colors"
      ],
      "tip": [
        "Force print with colors"
      ]
    },
    {
      "name": "--csv-auto-parse",
      "tip": [
        "Parse CSV YAML/JSON values (default true)"
      ]
    },
    {
      "name": "--csv-separator",
      "usage": [
        "--csv-separator <char>"
      ],
      "tip": [
        "CSV Separator character (default ,)"
      ],
      "next": []
    },
    {
      "name": "--debug-node-info",
      "tip": [
        "Debug node info"
      ]
    },
    {
      "name": "--exit-status",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exit-status"
      ],
      "tip": [
        "Set exit status if there are no matches or null or false is returned"
      ]
    },
    {
      "name": "--expression",
      "usage": [
        "--expression <string>"
      ],
      "tip": [
        "Forcibly set the expression argument"
      ],
      "next": []
    },
    {
      "name": "--from-file",
      "usage": [
        "--from-file <string>"
      ],
      "tip": [
        "Load expression from specified file"
      ],
      "next": []
    },
    {
      "name": "--front-matter",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --front-matter <TYPE>"
      ],
      "tip": [
        "Extract or process first input as yaml front-matter"
      ],
      "next": [
        {
          "name": "extract",
          "tip": [
            "Pull out the yaml content"
          ]
        },
        {
          "name": "process",
          "tip": [
            "Run the expression against the yaml content"
          ]
        }
      ]
    },
    {
      "name": "--header-preprocess",
      "tip": [
        "Slurp any header comments and separators before processing expression (default true)"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Help for yq"
      ]
    },
    {
      "name": "--indent",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --indent <int>"
      ],
      "tip": [
        "Sets indent level for output (default 2)"
      ],
      "next": [
        {
          "name": "2",
          "tip": [
            "Indent level 2 (default)"
          ]
        },
        {
          "name": "4",
          "tip": [
            "Indent level 4"
          ]
        }
      ]
    },
    {
      "name": "--ini-preserve-quotes",
      "tip": [
        "Preserve surrounding quotes on INI values during round-trip"
      ]
