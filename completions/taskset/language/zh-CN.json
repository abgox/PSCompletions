{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示或更改进程的 CPU 亲和性。"
    ]
  },
  "option": [
    {
      "name": "--all-tasks",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all-tasks"
      ],
      "tip": [
        "对给定 pid 的所有任务（线程）执行操作。"
      ]
    },
    {
      "name": "--cpu-list",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --cpu-list"
      ],
      "tip": [
        "以列表格式显示和指定 CPU。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid"
      ],
      "tip": [
        "对已存在的给定 pid 执行操作。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
