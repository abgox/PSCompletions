{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Show or change the CPU affinity of a process."
    ]
  },
  "option": [
    {
      "name": "--all-tasks",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all-tasks"
      ],
      "tip": [
        "Operate on all the tasks (threads) for a given pid."
      ]
    },
    {
      "name": "--cpu-list",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --cpu-list"
      ],
      "tip": [
        "Display and specify cpus in list format."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid"
      ],
      "tip": [
        "Operate on existing given pid."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
