{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把 FILE 以明确的表示形式（默认为八进制字节）写入标准输出。"
    ]
  },
  "option": [
    {
      "name": "--address-radix",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --address-radix <RADIX>"
      ],
      "tip": [
        "文件偏移量的输出格式；RADIX 取 [doxn] 之一，分别表示十进制、八进制、十六进制或不输出"
      ],
      "next": [
        {
          "name": "d"
        },
        {
          "name": "n"
        },
        {
          "name": "o"
        },
        {
          "name": "x"
        }
      ]
    },
    {
      "name": "--endian",
      "usage": [
        "--endian <big|little>"
      ],
      "tip": [
        "按指定的顺序交换输入字节"
      ],
      "next": [
        {
          "name": "big"
        },
        {
          "name": "little"
        }
      ]
    },
    {
      "name": "--format",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --format <TYPE>"
      ],
      "tip": [
        "选择一个或多个输出格式"
      ],
      "next": [
        {
          "name": "a"
        },
        {
          "name": "c"
        },
        {
          "name": "d"
        },
        {
          "name": "d2"
        },
        {
          "name": "d4"
        },
        {
          "name": "d8"
        },
        {
          "name": "f"
        },
        {
          "name": "f4"
        },
        {
          "name": "f8"
        },
        {
          "name": "o"
        },
        {
          "name": "o1"
        },
        {
          "name": "o2"
        },
        {
          "name": "o4"
        },
        {
          "name": "o8"
        },
        {
          "name": "u"
        },
        {
          "name": "u1"
        },
        {
          "name": "u2"
        },
        {
          "name": "u4"
        },
        {
          "name": "u8"
        },
        {
          "name": "x"
        },
        {
          "name": "x1"
        },
        {
          "name": "x2"
        },
        {
          "name": "x4"
        },
        {
          "name": "x8"
        }
      ]
    },
    {
      "name": "--output-duplicates",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --output-duplicates"
      ],
      "tip": [
        "不使用 * 标记被抑制的行"
      ]
    },
    {
      "name": "--read-bytes",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --read-bytes <BYTES>"
      ],
      "tip": [
        "把转储限制为输入的前 BYTES 个字节"
      ],
      "next": []
    },
    {
      "name": "--skip-bytes",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --skip-bytes <BYTES>"
      ],
      "tip": [
        "先跳过输入的前 BYTES 个字节"
      ],
      "next": []
    },
    {
      "name": "--strings",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S <BYTES>, --strings[=BYTES]"
      ],
      "tip": [
        "只显示以 NUL 结尾、长度至少为 BYTES（3）个可打印字符的字符串"
      ],
      "next": []
    },
    {
      "name": "--traditional",
      "tip": [
        "接受上文第三种形式的参数"
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w[BYTES], --width[=BYTES]"
      ],
      "tip": [
        "每行输出 BYTES 个字节；未指定 BYTES 时为 32"
      ],
      "next": []
    },
    {
      "name": "-a",
      "tip": [
        "等同于 -t a，选择命名字符，忽略高位比特"
      ]
    },
    {
      "name": "-b",
      "tip": [
        "等同于 -t o1，选择八进制，每单位 1 字节"
      ]
    },
    {
      "name": "-B",
      "tip": [
        "等同于 -t o2，选择八进制，每单位 2 字节"
      ]
    },
    {
      "name": "-c",
      "tip": [
        "等同于 -t c，选择可打印字符或反斜杠转义"
      ]
    },
    {
      "name": "-d",
      "tip": [
        "等同于 -t u2，选择无符号十进制，每单位 2 字节"
      ]
    },
    {
      "name": "-D",
      "tip": [
        "等同于 -t u4，选择无符号十进制，每单位 4 字节"
      ]
    },
    {
      "name": "-e",
      "tip": [
        "等同于 -t f8，选择浮点数，每单位 8 字节"
      ]
    },
    {
      "name": "-f",
      "tip": [
        "等同于 -t fF，选择浮点数"
      ]
    },
    {
      "name": "-F",
      "tip": [
        "等同于 -t f8，选择浮点数，每单位 8 字节"
      ]
    },
    {
      "name": "-H",
      "tip": [
        "等同于 -t x4，选择十六进制，每单位 4 字节"
      ]
    },
    {
      "name": "-i",
      "tip": [
        "等同于 -t dI，选择有符号十进制"
      ]
    },
    {
      "name": "-I",
      "tip": [
        "等同于 -t d8，选择有符号十进制，每单位 8 字节"
      ]
    },
    {
      "name": "-l",
      "tip": [
        "等同于 -t dL，选择有符号十进制"
      ]
    },
    {
      "name": "-L",
      "tip": [
        "等同于 -t d8，选择有符号十进制，每单位 8 字节"
      ]
    },
    {
      "name": "-o",
      "tip": [
        "等同于 -t o2，选择八进制，每单位 2 字节"
      ]
    },
    {
      "name": "-O",
      "tip": [
        "等同于 -t o4，选择八进制，每单位 4 字节"
      ]
    },
    {
      "name": "-s",
      "tip": [
        "等同于 -t d2，选择有符号十进制，每单位 2 字节"
      ]
    },
    {
      "name": "-x",
      "tip": [
        "等同于 -t x2，选择十六进制，每单位 2 字节"
      ]
    },
    {
      "name": "-X",
      "tip": [
        "等同于 -t x4，选择十六进制，每单位 4 字节"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
