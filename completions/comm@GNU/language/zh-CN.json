{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "逐行比较已排序的文件 FILE1 和 FILE2。"
    ]
  },
  "option": [
    {
      "name": "--check-order",
      "tip": [
        "即使所有输入行都能配对，也检查输入是否已正确排序"
      ]
    },
    {
      "name": "--nocheck-order",
      "tip": [
        "不检查输入是否已正确排序"
      ]
    },
    {
      "name": "--output-delimiter",
      "usage": [
        "--output-delimiter <STR>"
      ],
      "tip": [
        "用 STR 分隔各列"
      ],
      "next": []
    },
    {
      "name": "--total",
      "tip": [
        "输出摘要"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "行分隔符为 NUL，而不是换行符"
      ]
    },
    {
      "name": "-1",
      "tip": [
        "不输出第 1 列（仅在 FILE1 中的行）"
      ]
    },
    {
      "name": "-2",
      "tip": [
        "不输出第 2 列（仅在 FILE2 中的行）"
      ]
    },
    {
      "name": "-3",
      "tip": [
        "不输出第 3 列（两个文件中都出现的行）"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
