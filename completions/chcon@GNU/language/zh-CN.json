{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把每个 FILE 的 SELinux 安全上下文改为 CONTEXT。"
    ]
  },
  "option": [
    {
      "name": "--dereference",
      "tip": [
        "作用于每个符号链接指向的对象（这是默认行为），而不是符号链接本身"
      ]
    },
    {
      "name": "--no-dereference",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --no-dereference"
      ],
      "tip": [
        "作用于符号链接而不是它引用的文件"
      ]
    },
    {
      "name": "--no-preserve-root",
      "tip": [
        "不对 '/' 做特殊处理（默认）"
      ]
    },
    {
      "name": "--preserve-root",
      "tip": [
        "不对 '/' 进行递归操作并使其失败"
      ]
    },
    {
      "name": "--range",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --range <RANGE>"
      ],
      "tip": [
        "在目标安全上下文中设置范围 RANGE"
      ],
      "next": []
    },
    {
      "name": "--recursive",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --recursive"
      ],
      "tip": [
        "递归地对文件和目录进行操作"
      ]
    },
    {
      "name": "--reference",
      "usage": [
        "--reference <RFILE>"
      ],
      "tip": [
        "使用 RFILE 的安全上下文而不指定 CONTEXT 值"
      ],
      "next": []
    },
    {
      "name": "--role",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --role <ROLE>"
      ],
      "tip": [
        "在目标安全上下文中设置角色 ROLE"
      ],
      "next": []
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "在目标安全上下文中设置类型 TYPE"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <USER>"
      ],
      "tip": [
        "在目标安全上下文中设置用户 USER"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "为处理的每个文件输出一条诊断信息"
      ]
    },
    {
      "name": "-H",
      "tip": [
        "如果命令行参数是指向目录的符号链接，则遍历它"
      ]
    },
    {
      "name": "-L",
      "tip": [
        "遍历遇到的每一个指向目录的符号链接"
      ]
    },
    {
      "name": "-P",
      "tip": [
        "不遍历任何符号链接（默认）"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
