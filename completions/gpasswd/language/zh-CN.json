{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "管理 /etc/group 和 /etc/gshadow。"
    ]
  },
  "option": [
    {
      "name": "--add",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --add <USER>"
      ],
      "tip": [
        "将 USER 添加到 GROUP。"
      ],
      "next": []
    },
    {
      "name": "--administrators",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --administrators <ADMIN,...>"
      ],
      "tip": [
        "设置 GROUP 的管理员列表。"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--delete",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delete <USER>"
      ],
      "tip": [
        "从 GROUP 中移除 USER。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--members",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --members <USER,...>"
      ],
      "tip": [
        "设置 GROUP 的成员列表。"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--remove-password",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --remove-password"
      ],
      "tip": [
        "移除 GROUP 的密码。"
      ]
    },
    {
      "name": "--restrict",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --restrict"
      ],
      "tip": [
        "限制对 GROUP 的访问，仅允许其成员。"
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    }
  ]
}
