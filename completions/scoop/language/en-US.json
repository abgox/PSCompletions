    {
      "name": "cache",
      "usage": [
        "cache show|rm [<app>] [<app>...]"
      ],
      "tip": [
        "Manage download cache"
      ],
      "example": [
        {
          "cmd": "cache",
          "desc": "Show all download caches"
        },
        {
          "cmd": "cache show 7zip",
          "desc": "Show 7zip download cache"
        },
        {
          "cmd": "cache rm 7zip sudo",
          "desc": "Remove 7zip sudo download cache"
        }
      ],
      "next": [
        {
          "name": "rm",
          "tip": [
            "Remove download cache for specified applications"
          ],
          "example": [
            {
              "cmd": "rm *",
              "desc": "Remove all download caches"
            },
            {
              "cmd": "rm 7zip",
              "desc": "Remove 7zip download cache"
            }
          ],
          "next": [
            {
              "name": "*",
              "tip": [
                "Remove all download caches"
              ]
            }
          ]
        },
        {
          "name": "show",
          "tip": [
            "Show download cache"
          ],
          "example": [
            "show 7zip"
          ]
        }
      ]
    },
    {
      "name": "cat",
      "usage": [
        "cat <app>"
      ],
      "tip": [
        "Display the content of a specified application's manifest",
        "You can change its style: scoop config cat_style <style>"
      ],
      "example": [
        "cat 7zip"
      ]
    },
    {
      "name": "checkup",
      "tip": [
        "Check if Scoop has potential issues"
      ]
    },
    {
      "name": "cleanup",
      "usage": [
        "cleanup [options] <app|*>"
      ],
      "tip": [
        "Clean up applications (Remove old versions)"
      ],
      "example": [
        "cleanup 7zip"
      ],
      "option": [
        {
          "name": "--all",
          "alias": [
            "-a"
          ],
          "usage": [
            "-a, --all"
          ],
          "tip": [
            "Clean up all applications (alternative to *)"
          ]
        },
        {
          "name": "--cache",
          "alias": [
            "-k"
          ],
          "usage": [
            "-k, --cache"
          ],
          "tip": [
            "Remove outdated download cache"
          ]
        },
        {
          "name": "--global",
          "alias": [
            "-g"
          ],
          "usage": [
            "-g, --global"
          ],
          "tip": [
            "Clean up installed applications globally"
          ]
        }
      ],
      "next": [
        {
          "name": "*",
          "tip": [
            "Clean up all applications"
          ]
        }
      ]
    },
    {
