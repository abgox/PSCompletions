{
  "meta": {
    "url": "https://scoop.sh",
    "description": [
      "A command-line installer for Windows."
    ]
  },
  "next": [
    {
      "name": "alias",
      "usage": [
        "alias <list|add|rm> [<args>]"
      ],
      "tip": [
        "Manage Scoop aliases"
      ],
      "next": [
        {
          "name": "add",
          "usage": [
            "add <alias> <command> <description>"
          ],
          "tip": [
            "Add command aliases"
          ],
          "example": [
            {
              "cmd": "add upgrade 'scoop update *' 'Updates all apps'",
              "desc": "Type 'scoop upgrade' to run 'scoop update *'"
            }
          ]
        },
        {
          "name": "list",
          "tip": [
            "List all command aliases"
          ]
        },
        {
          "name": "rm",
          "usage": [
            "rm <alias>"
          ],
          "tip": [
            "Remove command aliases"
          ],
          "example": [
            "rm upgrade"
          ]
        }
      ]
    },
