          "cmd": "config",
          "desc": "Get all configurations"
        },
        {
          "cmd": "config <name>",
          "desc": "Get configuration"
        },
        {
          "cmd": "config <name> <value>",
          "desc": "Set configuration"
        },
        {
          "cmd": "config rm <name>",
          "desc": "Remove configuration"
        }
