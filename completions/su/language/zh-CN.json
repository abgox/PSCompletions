{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "将有效用户 ID 和组 ID 更改为 <user> 的。",
      "单独的 - 等同于 -l。",
      "如果未指定 <user>，则假定为 root。"
    ]
  },
  "option": [
    {
      "name": "--command",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --command <command>"
      ],
      "tip": [
        "通过 -c 向 shell 传递单条命令。"
      ],
      "next": []
    },
    {
      "name": "--fast",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fast"
      ],
      "tip": [
        "将 -f 传递给 shell（用于 csh 或 tcsh）。"
      ]
    },
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group <group>"
      ],
      "tip": [
        "指定主组。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--login",
      "alias": [
        "-l",
        "-"
      ],
      "usage": [
        "-, -l, --login"
      ],
      "tip": [
        "使 shell 成为登录 shell。"
      ]
    },
    {
      "name": "--no-pty",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --no-pty"
      ],
      "tip": [
        "不创建新的伪终端（安全性差！）。"
      ]
    },
    {
      "name": "--preserve-environment",
      "alias": [
        "-m",
        "-p"
      ],
      "usage": [
        "-m, -p, --preserve-environment"
      ],
      "tip": [
        "不重置环境变量。"
      ]
    },
    {
      "name": "--pty",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pty"
      ],
      "tip": [
        "创建新的伪终端。"
      ]
    },
    {
      "name": "--session-command",
      "usage": [
        "--session-command <command>"
      ],
      "tip": [
        "通过 -c 向 shell 传递单条命令，且不创建新会话。"
      ],
      "next": []
    },
    {
      "name": "--shell",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shell <shell>"
      ],
      "tip": [
        "如果 /etc/shells 允许，则运行 <shell>。"
      ],
      "next": []
    },
    {
      "name": "--supp-group",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --supp-group <group>"
      ],
      "tip": [
        "指定一个附加组。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--whitelist-environment",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --whitelist-environment <list>"
      ],
      "tip": [
        "不重置指定的变量。"
      ],
      "next": []
    }
  ]
}
