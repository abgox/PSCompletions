{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "反复覆盖指定的 FILE，使即使非常昂贵的硬件探测也难以恢复数据"
    ]
  },
  "option": [
    {
      "name": "--exact",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exact"
      ],
      "tip": [
        "不将文件大小凑整到下一个完整块；对非普通文件默认为此行为"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "必要时更改权限以允许写入"
      ]
    },
    {
      "name": "--iterations",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --iterations <NUMBER>"
      ],
      "tip": [
        "覆盖 N 次而非默认（3 次）"
      ],
      "next": []
    },
    {
      "name": "--random-source",
      "usage": [
        "--random-source <RANDOM-SOURCE>"
      ],
      "tip": [
        "从 FILE 获取随机字节"
      ],
      "next": []
    },
    {
      "name": "--remove",
      "usage": [
        "--remove[=<HOW>]"
      ],
      "tip": [
        "类似 -u 但可控制如何删除；见下文"
      ],
      "next": [
        {
          "name": "unlink"
        },
        {
          "name": "wipe"
        },
        {
          "name": "wipesync"
        }
      ]
    },
    {
      "name": "--size",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --size <N>"
      ],
      "tip": [
        "粉碎这么多字节（接受 K、M、G 等后缀）"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "显示进度"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "最后再用零覆盖一次以隐藏粉碎痕迹"
      ]
    },
    {
      "name": "-u",
      "tip": [
        "覆盖后释放并删除文件"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
