{
  "meta": {
    "url": "https://github.com/casey/just",
    "description": [
      "A command runner."
    ]
  },
  "option": [
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version."
      ]
    }
  ],
