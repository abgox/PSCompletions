{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "如果给定的 DIRECTORY 不存在则创建"
    ]
  },
  "option": [
    {
      "name": "--context",
      "usage": [
        "--context <CTX>"
      ],
      "tip": [
        "类似 -Z，如果指定了 CTX 则将 SELinux 或 SMACK 安全上下文设为 CTX"
      ],
      "next": []
    },
    {
      "name": "--mode",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mode <MODE>"
      ],
      "tip": [
        "设置文件模式（Windows 上未实现）"
      ],
      "next": []
    },
    {
      "name": "--parents",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --parents"
      ],
      "tip": [
        "按需创建父目录"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "为每个创建的目录打印一条消息"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-Z",
      "tip": [
        "将每个创建目录的 SELinux 安全上下文设为默认类型"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
