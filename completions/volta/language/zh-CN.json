{
  "meta": {
    "url": "https://volta.sh",
    "description": [
      "JavaScript 工具管理器。"
    ]
  },
  "next": [
    {
      "name": "completions",
      "tip": [
        "生成 Volta 补全"
      ]
    },
    {
      "name": "fetch",
      "tip": [
        "将工具获取到本地"
      ],
      "next": [
        {
          "name": "node@lts",
          "alias": [
            "node"
          ],
          "usage": [
            "node|node@lts"
          ],
          "tip": [
            "获取 node 的 LTS 版本",
            "你还可以指定一个特定的版本，如 node@20"
          ]
        },
        {
          "name": "npm",
          "tip": [
            "获取 npm 的最新版本",
            "你还可以指定一个特定的版本，如 npm@10"
          ]
        },
        {
          "name": "pnpm",
          "tip": [
            "获取 pnpm 的最新版本",
            "你还可以指定一个特定的版本，如 pnpm@10"
          ]
        },
        {
          "name": "yarn",
          "tip": [
            "获取 yarn 的最新版本",
            "你还可以指定一个特定的版本，如 yarn@1"
          ]
        },
        {
          "name": "yarn@1",
          "tip": [
            "获取 yarn 的 v1 版本"
          ]
        }
      ]
    },
    {
      "name": "help",
      "usage": [
        "help <command>"
      ],
      "tip": [
        "打印给定子命令的帮助"
      ]
    },
    {
      "name": "install",
      "usage": [
        "install <node|npm|yarn|...>"
      ],
      "tip": [
        "在您的工具链中安装一个工具"
      ],
      "example": [
        "install node@lts",
        "install yarn@1"
      ],
      "next": [
        {
          "name": "node@lts",
          "alias": [
            "node"
          ],
          "usage": [
            "node|node@lts"
          ],
          "tip": [
            "安装 node 的 LTS 版本",
            "你还可以指定一个特定的版本，如 node@20"
          ]
        },
        {
          "name": "npm",
          "tip": [
            "安装 npm 的最新版本",
            "你还可以指定一个特定的版本，如 npm@10"
          ]
        },
        {
          "name": "pnpm",
          "tip": [
            "安装 pnpm 的最新版本",
            "你还可以指定一个特定的版本，如 pnpm@10"
          ]
        },
        {
          "name": "typescript",
          "tip": [
            "安装 TypeScript 的最新版本"
          ]
        },
        {
          "name": "yarn",
          "tip": [
            "安装 yarn 的最新版本",
            "你还可以指定一个特定的版本，如 yarn@1"
          ]
        },
        {
          "name": "yarn@1",
          "tip": [
            "安装 yarn 的 v1 版本"
          ]
        }
      ]
    },
    {
      "name": "list",
      "tip": [
        "显示当前工具链"
      ],
      "option": [
        {
          "name": "--current",
          "alias": [
            "-c"
          ],
          "usage": [
            "-c, --current"
          ],
          "tip": [
            "显示当前激活的工具"
          ]
        },
        {
          "name": "--default",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --default"
          ],
          "tip": [
            "显示您的默认工具"
          ]
        },
        {
          "name": "--format",
          "usage": [
            "--format <format>"
          ],
          "tip": [
            "指定输出格式 [可能的值: human, plain]"
          ],
          "next": [
            {
              "name": "human"
            },
            {
              "name": "plain"
            }
          ]
        }
      ],
      "next": [
        {
          "name": "all",
          "tip": [
            "列出所有已安装的工具(包括不同版本)"
          ]
        }
      ]
    },
    {
      "name": "pin",
      "tip": [
        "锁定项目运行时或包管理器"
      ],
      "example": [
        "pin node@lts"
      ]
    },
    {
      "name": "run",
      "tip": [
        "使用自定义的 node/npm/pnpm/yarn 版本运行命令"
      ],
      "option": [
        {
          "name": "--bundled-npm",
          "tip": [
            "强制 npm 使用与 Node 捆绑的版本"
          ]
        },
        {
          "name": "--env",
          "usage": [
            "--env <NAME=value>"
          ],
          "tip": [
            "设置环境变量(可以多次使用)"
          ],
          "next": []
        },
        {
          "name": "--no-yarn",
          "tip": [
            "禁用 Yarn"
          ]
        },
        {
          "name": "--node",
          "usage": [
            "--node <version> <command>"
          ],
          "tip": [
            "设置自定义 Node 版本"
          ],
          "next": []
        },
        {
          "name": "--npm",
          "usage": [
            "--npm <version> <command>"
          ],
          "tip": [
            "设置自定义 Npm 版本"
          ],
          "next": []
        },
        {
          "name": "--yarn",
          "usage": [
            "--yarn <version> <command>"
          ],
          "tip": [
            "设置自定义 Yarn 版本"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "setup",
      "tip": [
        "为当前用户 / shell 启用 Volta"
      ]
    },
    {
      "name": "uninstall",
      "usage": [
        "uninstall <node|npm|yarn|...>"
      ],
      "tip": [
        "在您的工具链中卸载一个工具"
      ],
      "example": [
        "uninstall node@lts"
      ]
    },
    {
      "name": "which",
      "usage": [
        "which <node|npm|yarn|...>"
      ],
      "tip": [
        "定位 Volta 将调用的实际二进制文件"
      ]
    }
  ],
  "option": [
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "打印 Volta 的版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息"
      ]
    },
    {
      "name": "--quiet",
      "tip": [
        "避免不必要的输出"
      ]
    },
    {
      "name": "--verbose",
      "tip": [
        "启用详细诊断"
      ]
    },
    {
      "name": "--very-verbose",
      "tip": [
        "启用跟踪级诊断"
      ]
    }
  ]
}
