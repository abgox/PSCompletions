{
  "meta": {
    "url": "https://k3d.io/",
    "description": [
      "Lightweight wrapper to run k3s (Rancher Lab's minimal Kubernetes distribution) in docker."
    ]
  },
  "next": [
    {
      "name": "cluster",
      "tip": [
        "Manage cluster(s)."
      ],
      "next": [
        {
          "name": "create",
          "usage": [
            "create <NAME>"
          ],
          "tip": [
            "Create a new k3s cluster with containerized nodes (k3s in docker)."
          ],
          "option": [
            {
              "name": "--agents",
              "alias": [
                "-a"
              ],
              "usage": [
                "-a, --agents <N>"
              ],
              "tip": [
                "Specify how many agents you want to create."
              ],
              "next": [
                {
                  "name": "1"
                },
                {
                  "name": "2"
                },
                {
                  "name": "3"
                }
              ]
            },
            {
              "name": "--agents-memory",
              "usage": [
                "--agents-memory <SIZE>"
              ],
              "tip": [
                "Memory limit imposed on the agents nodes."
              ],
              "next": [
                {
                  "name": "1Gi"
                },
                {
                  "name": "2Gi"
                },
                {
                  "name": "512Mi"
                }
              ]
            },
            {
              "name": "--api-port",
              "usage": [
                "--api-port <[HOST:]HOSTPORT>"
              ],
              "tip": [
                "Specify the Kubernetes API server port exposed on the LoadBalancer."
