                {
                  "name": "6443"
                }
              ]
            },
            {
              "name": "--config",
              "alias": [
                "-c"
              ],
              "usage": [
                "-c, --config <FILE>"
              ],
              "tip": [
                "Path of a config file to use."
              ],
              "next": [
                {
                  "name": "config.yaml"
                },
                {
                  "name": "k3d-default.yaml"
                },
                {
                  "name": "k3d.yaml"
                }
              ]
            },
            {
              "name": "--enforce-registry-port-match",
              "tip": [
                "Make the internal registry port match the external one."
              ]
            },
            {
              "name": "--env",
              "alias": [
                "-e"
              ],
              "usage": [
                "-e, --env <KEY[=VALUE][@NODEFILTER]>"
