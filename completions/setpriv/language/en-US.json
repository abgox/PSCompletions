{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Run a program with different privilege settings."
    ]
  },
  "option": [
    {
      "name": "--ambient-caps",
      "usage": [
        "--ambient-caps <caps>"
      ],
      "tip": [
        "Set ambient capabilities."
      ],
      "next": []
    },
    {
      "name": "--apparmor-profile",
      "usage": [
        "--apparmor-profile <pr>"
      ],
      "tip": [
        "Set AppArmor profile."
      ],
      "next": []
    },
    {
      "name": "--bounding-set",
      "usage": [
        "--bounding-set <caps>"
      ],
      "tip": [
        "Set capability bounding set."
      ],
      "next": []
    },
    {
      "name": "--clear-groups",
      "tip": [
        "Clear supplementary groups."
      ]
    },
    {
      "name": "--dump",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --dump"
      ],
      "tip": [
        "Show current state (and do not exec)."
      ]
    },
    {
      "name": "--egid",
      "usage": [
        "--egid <gid|group>"
      ],
      "tip": [
        "Set effective gid."
      ],
      "next": []
    },
    {
      "name": "--euid",
      "usage": [
        "--euid <uid|user>"
      ],
      "tip": [
        "Set effective uid."
      ],
      "next": []
    },
    {
      "name": "--groups",
      "usage": [
        "--groups <group>[,...]"
      ],
      "tip": [
        "Set supplementary group(s) by GID or name."
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--inh-caps",
      "usage": [
        "--inh-caps <caps>"
      ],
      "tip": [
        "Set inheritable capabilities."
      ],
      "next": []
    },
    {
      "name": "--init-groups",
      "tip": [
        "Initialize supplementary groups."
      ]
    },
    {
      "name": "--keep-groups",
      "tip": [
        "Keep supplementary groups."
      ]
    },
    {
      "name": "--landlock-access",
      "usage": [
        "--landlock-access <access>"
      ],
      "tip": [
        "Add Landlock access."
      ],
      "next": []
    },
    {
      "name": "--landlock-rule",
      "usage": [
        "--landlock-rule <rule>"
      ],
      "tip": [
        "Add Landlock rule."
      ],
      "next": []
    },
    {
      "name": "--no-new-privs",
      "alias": [
        "--nnp"
      ],
      "usage": [
        "--nnp, --no-new-privs"
      ],
      "tip": [
        "Disallow granting new privileges."
      ]
    },
    {
      "name": "--pdeathsig",
      "usage": [
        "--pdeathsig <keep|clear|signame>"
      ],
      "tip": [
        "Set or clear the parent death signal.",
        "Use keep, clear or a signal name."
      ],
      "next": [
        {
          "name": "clear"
        },
        {
          "name": "keep"
        }
      ]
    },
    {
      "name": "--ptracer",
      "usage": [
        "--ptracer <pid|any|none>"
      ],
      "tip": [
        "Allow ptracing from the given process."
      ],
      "next": [
        {
          "name": "any"
        },
        {
          "name": "none"
        }
      ]
    },
    {
      "name": "--regid",
      "usage": [
        "--regid <gid|group>"
      ],
      "tip": [
        "Set real and effective gid."
      ],
      "next": []
    },
    {
      "name": "--reuid",
      "usage": [
        "--reuid <uid|user>"
      ],
      "tip": [
        "Set real and effective uid."
      ],
      "next": []
    },
    {
      "name": "--rgid",
      "usage": [
        "--rgid <gid|group>"
      ],
      "tip": [
        "Set real gid."
      ],
      "next": []
    },
    {
      "name": "--ruid",
      "usage": [
        "--ruid <uid|user>"
      ],
      "tip": [
        "Set real uid."
      ],
      "next": []
    },
    {
      "name": "--seccomp-filter",
      "usage": [
        "--seccomp-filter <file>"
      ],
      "tip": [
        "Load seccomp filter from file."
      ],
      "next": []
    },
    {
      "name": "--securebits",
      "usage": [
        "--securebits <bits>"
      ],
      "tip": [
        "Set securebits."
      ],
      "next": []
    },
    {
      "name": "--selinux-label",
      "usage": [
        "--selinux-label <label>"
      ],
      "tip": [
        "Set SELinux label."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
