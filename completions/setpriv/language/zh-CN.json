{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "以不同的权限设置运行程序。"
    ]
  },
  "option": [
    {
      "name": "--ambient-caps",
      "usage": [
        "--ambient-caps <caps>"
      ],
      "tip": [
        "设置环境能力。"
      ],
      "next": []
    },
    {
      "name": "--apparmor-profile",
      "usage": [
        "--apparmor-profile <pr>"
      ],
      "tip": [
        "设置 AppArmor 配置文件。"
      ],
      "next": []
    },
    {
      "name": "--bounding-set",
      "usage": [
        "--bounding-set <caps>"
      ],
      "tip": [
        "设置能力边界集。"
      ],
      "next": []
    },
    {
      "name": "--clear-groups",
      "tip": [
        "清除附加组。"
      ]
    },
    {
      "name": "--dump",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --dump"
      ],
      "tip": [
        "显示当前状态（且不执行）。"
      ]
    },
    {
      "name": "--egid",
      "usage": [
        "--egid <gid|group>"
      ],
      "tip": [
        "设置有效 gid。"
      ],
      "next": []
    },
    {
      "name": "--euid",
      "usage": [
        "--euid <uid|user>"
      ],
      "tip": [
        "设置有效 uid。"
      ],
      "next": []
    },
    {
      "name": "--groups",
      "usage": [
        "--groups <group>[,...]"
      ],
      "tip": [
        "按 GID 或名称设置附加组。"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--inh-caps",
      "usage": [
        "--inh-caps <caps>"
      ],
      "tip": [
        "设置可继承能力。"
      ],
      "next": []
    },
    {
      "name": "--init-groups",
      "tip": [
        "初始化附加组。"
      ]
    },
    {
      "name": "--keep-groups",
      "tip": [
        "保留附加组。"
      ]
    },
    {
      "name": "--landlock-access",
      "usage": [
        "--landlock-access <access>"
      ],
      "tip": [
        "添加 Landlock 访问权限。"
      ],
      "next": []
    },
    {
      "name": "--landlock-rule",
      "usage": [
        "--landlock-rule <rule>"
      ],
      "tip": [
        "添加 Landlock 规则。"
      ],
      "next": []
    },
    {
      "name": "--no-new-privs",
      "alias": [
        "--nnp"
      ],
      "usage": [
        "--nnp, --no-new-privs"
      ],
      "tip": [
        "禁止授予新权限。"
      ]
    },
    {
      "name": "--pdeathsig",
      "usage": [
        "--pdeathsig <keep|clear|signame>"
      ],
      "tip": [
        "设置或清除父进程死亡信号。",
        "使用 keep、clear 或信号名。"
      ],
      "next": [
        {
          "name": "clear"
        },
        {
          "name": "keep"
        }
      ]
    },
    {
      "name": "--ptracer",
      "usage": [
        "--ptracer <pid|any|none>"
      ],
      "tip": [
        "允许给定进程进行 ptrace。"
      ],
      "next": [
        {
          "name": "any"
        },
        {
          "name": "none"
        }
      ]
    },
    {
      "name": "--regid",
      "usage": [
        "--regid <gid|group>"
      ],
      "tip": [
        "设置真实和有效 gid。"
      ],
      "next": []
    },
    {
      "name": "--reuid",
      "usage": [
        "--reuid <uid|user>"
      ],
      "tip": [
        "设置真实和有效 uid。"
      ],
      "next": []
    },
    {
      "name": "--rgid",
      "usage": [
        "--rgid <gid|group>"
      ],
      "tip": [
        "设置真实 gid。"
      ],
      "next": []
    },
    {
      "name": "--ruid",
      "usage": [
        "--ruid <uid|user>"
      ],
      "tip": [
        "设置真实 uid。"
      ],
      "next": []
    },
    {
      "name": "--seccomp-filter",
      "usage": [
        "--seccomp-filter <file>"
      ],
      "tip": [
        "从文件加载 seccomp 过滤器。"
      ],
      "next": []
    },
    {
      "name": "--securebits",
      "usage": [
        "--securebits <bits>"
      ],
      "tip": [
        "设置 securebits。"
      ],
      "next": []
    },
    {
      "name": "--selinux-label",
      "usage": [
        "--selinux-label <label>"
      ],
      "tip": [
        "设置 SELinux 标签。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
