{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示或控制内核环形缓冲区。"
    ]
  },
  "option": [
    {
      "name": "--buffer-size",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --buffer-size <size>"
      ],
      "tip": [
        "用于查询内核环形缓冲区的缓冲区大小。"
      ],
      "next": []
    },
    {
      "name": "--clear",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --clear"
      ],
      "tip": [
        "清除内核环形缓冲区。"
      ]
    },
    {
      "name": "--color",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --color[=<when>]"
      ],
      "tip": [
        "为消息着色。",
        "默认启用颜色。",
        "可能值: auto, always, never"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--console-level",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --console-level <level>"
      ],
      "tip": [
        "设置打印到控制台的消息级别。"
      ],
      "next": []
    },
    {
      "name": "--console-off",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --console-off"
      ],
      "tip": [
        "禁止将消息打印到控制台。"
      ]
    },
    {
      "name": "--console-on",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --console-on"
      ],
      "tip": [
        "允许将消息打印到控制台。"
      ]
    },
    {
      "name": "--ctime",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --ctime"
      ],
      "tip": [
        "显示人类可读时间戳（可能不准确！）。"
      ]
    },
    {
      "name": "--decode",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --decode"
      ],
      "tip": [
        "将 facility 和 level 解码为可读字符串。"
      ]
    },
    {
      "name": "--facility",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --facility <list>"
      ],
      "tip": [
        "将输出限制为指定设施。"
      ],
      "separator": ",",
      "next": [
        {
          "name": "auth"
        },
        {
          "name": "authpriv"
        },
        {
          "name": "cron"
        },
        {
          "name": "daemon"
        },
        {
          "name": "ftp"
        },
        {
          "name": "kern"
        },
        {
          "name": "local0"
        },
        {
          "name": "local1"
        },
        {
          "name": "local2"
        },
        {
          "name": "local3"
        },
        {
          "name": "local4"
        },
        {
          "name": "local5"
        },
        {
          "name": "local6"
        },
        {
          "name": "local7"
        },
        {
          "name": "lpr"
        },
        {
          "name": "mail"
        },
        {
          "name": "news"
        },
        {
          "name": "res0"
        },
        {
          "name": "res1"
        },
        {
          "name": "res2"
        },
        {
          "name": "res3"
        },
        {
          "name": "syslog"
        },
        {
          "name": "user"
        },
        {
          "name": "uucp"
        }
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --file <file>"
      ],
      "tip": [
        "使用该文件代替内核日志缓冲区。"
      ],
      "next": []
    },
    {
      "name": "--follow",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --follow"
      ],
      "tip": [
        "等待新消息。"
      ]
    },
    {
      "name": "--follow-new",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --follow-new"
      ],
      "tip": [
        "等待并仅打印新消息。"
      ]
    },
    {
      "name": "--force-prefix",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --force-prefix"
      ],
      "tip": [
        "强制在多行消息的每一行输出时间戳。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--human",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --human"
      ],
      "tip": [
        "人类可读输出。"
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "使用 JSON 输出格式。"
      ]
    },
    {
      "name": "--kernel",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --kernel"
      ],
      "tip": [
        "显示内核消息。"
      ]
    },
    {
      "name": "--kmsg-file",
      "alias": [
        "-K"
      ],
      "usage": [
        "-K, --kmsg-file <file>"
      ],
      "tip": [
        "使用 kmsg 格式的文件。"
      ],
      "next": []
    },
    {
      "name": "--level",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --level <list>"
      ],
      "tip": [
        "将输出限制为指定级别。"
      ],
      "separator": ",",
      "next": [
        {
          "name": "alert"
        },
        {
          "name": "crit"
        },
        {
          "name": "debug"
        },
        {
          "name": "emerg"
        },
        {
          "name": "err"
        },
        {
          "name": "info"
        },
        {
          "name": "notice"
        },
        {
          "name": "warn"
        }
      ]
    },
    {
      "name": "--noescape",
      "tip": [
        "不转义不可打印字符。"
      ]
    },
    {
      "name": "--nopager",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --nopager"
      ],
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--notime",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --notime"
      ],
      "tip": [
        "不在消息中显示任何时间戳。"
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "打印原始消息缓冲区。"
      ]
    },
    {
      "name": "--read-clear",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --read-clear"
      ],
      "tip": [
        "读取并清除所有消息。"
      ]
    },
    {
      "name": "--reltime",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --reltime"
      ],
      "tip": [
        "以可读格式显示本地时间和时间差。"
      ]
    },
    {
      "name": "--show-delta",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --show-delta"
      ],
      "tip": [
        "显示打印消息之间的时间差。"
      ]
    },
    {
      "name": "--since",
      "usage": [
        "--since <time>"
      ],
      "tip": [
        "显示指定时间之后的行。"
      ],
      "next": []
    },
    {
      "name": "--syslog",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --syslog"
      ],
      "tip": [
        "强制使用 syslog(2) 而不是 /dev/kmsg。"
      ]
    },
    {
      "name": "--time-format",
      "usage": [
        "--time-format <format>"
      ],
      "tip": [
        "使用给定格式显示时间戳。",
        "可能值: delta, reltime, ctime, notime, iso, raw"
      ],
      "next": [
        {
          "name": "ctime"
        },
        {
          "name": "delta"
        },
        {
          "name": "iso"
        },
        {
          "name": "notime"
        },
        {
          "name": "raw"
        },
        {
          "name": "reltime"
        }
      ]
    },
    {
      "name": "--until",
      "usage": [
        "--until <time>"
      ],
      "tip": [
        "显示指定时间之前的行。"
      ],
      "next": []
    },
    {
      "name": "--userspace",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --userspace"
      ],
      "tip": [
        "显示用户空间消息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
