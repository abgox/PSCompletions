{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "打印每个指定 USER 的用户和组信息，省略 USER 则打印当前用户的"
    ]
  },
  "option": [
    {
      "name": "--context",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --context"
      ],
      "tip": [
        "仅打印进程的安全上下文（未启用）"
      ]
    },
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group"
      ],
      "tip": [
        "仅以数字显示有效组 ID"
      ]
    },
    {
      "name": "--groups",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --groups"
      ],
      "tip": [
        "仅以空白分隔的数字显示不同的组 ID，顺序不定"
      ]
    },
    {
      "name": "--ignore",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --ignore"
      ],
      "tip": [
        "忽略，用于与其他版本兼容"
      ]
    },
    {
      "name": "--name",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --name"
      ],
      "tip": [
        "对 -G、-g 和 -u 选项显示用户或组 ID 的名称而非数字。如果某个 ID 无法映射为名称，则照常显示数字"
      ]
    },
    {
      "name": "--real",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --real"
      ],
      "tip": [
        "对 -G、-g 和 -u 选项显示真实 ID 而非有效 ID"
      ]
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user"
      ],
      "tip": [
        "仅以数字显示有效用户 ID"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "条目以 NUL 字符而非空白分隔；默认格式下不允许"
      ]
    },
    {
      "name": "-A",
      "tip": [
        "显示进程审计用户 ID 及其他进程审计属性，需要特权（Linux 上不可用）"
      ]
    },
    {
      "name": "-p",
      "tip": [
        "使输出人类可读。每个显示项占一行"
      ]
    },
    {
      "name": "-P",
      "tip": [
        "将 id 显示为密码文件条目"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
