{
  "meta": {
    "url": "https://github.com/rbenv/ruby-build",
    "description": [
      "编译并安装 Ruby。"
    ]
  },
  "option": [
    {
      "name": "--definitions",
      "tip": [
        "列出所有本地定义，包括已过时的定义。"
      ]
    },
    {
      "name": "--dir",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --dir"
      ],
      "tip": [
        "将 Ruby 安装到 <prefix>/<definition> 而不是 <prefix>。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--ipv4",
      "alias": [
        "-4"
      ],
      "usage": [
        "-4, --ipv4"
      ],
      "tip": [
        "仅将名称解析为 IPv4 地址。"
      ]
    },
    {
      "name": "--ipv6",
      "alias": [
        "-6"
      ],
      "usage": [
        "-6, --ipv6"
      ],
      "tip": [
        "仅将名称解析为 IPv6 地址。"
      ]
    },
    {
      "name": "--keep",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --keep"
      ],
      "tip": [
        "安装后不删除源码树。"
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "列出各 Ruby 的最新稳定版本。"
      ]
    },
    {
      "name": "--patch",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --patch"
      ],
      "tip": [
        "构建前从 stdin 应用补丁。"
      ]
    },
    {
      "name": "--resolve",
      "usage": [
        "--resolve <VERSION>"
      ],
      "tip": [
        "打印与版本前缀匹配的最新稳定定义名称。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "详细模式：将所有构建输出转发到 stdout/stderr。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示 ruby-build 的版本。"
      ]
    }
  ]
}
