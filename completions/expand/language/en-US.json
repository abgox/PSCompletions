{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "Convert tabs in each FILE to spaces."
    ]
  },
  "option": [
    {
      "name": "--initial",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --initial"
      ],
      "tip": [
        "Do not convert tabs after non blanks."
      ]
    },
    {
      "name": "--tabs",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --tabs=<N or LIST>"
      ],
      "tip": [
        "Have tabs N characters apart, not 8.",
        "Use comma separated list of tab positions."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show the help."
      ]
    }
  ]
}
