{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将 SOURCE 复制到 DEST，或将多个 SOURCE 复制到已存在的目录"
    ]
  },
  "option": [
    {
      "name": "--backup",
      "usage": [
        "--backup[=<CONTROL>]"
      ],
      "tip": [
        "为每个已存在的目标文件创建备份"
      ],
      "next": []
    },
    {
      "name": "--compare",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --compare"
      ],
      "tip": [
        "比较每对源文件和目标文件，某些情况下完全不修改目标"
      ]
    },
    {
      "name": "--context",
      "usage": [
        "--context[=<CONTEXT>]"
      ],
      "tip": [
        "设置文件和目录的安全上下文"
      ],
      "next": []
    },
    {
      "name": "--directory",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --directory"
      ],
      "tip": [
        "将所有参数视为目录名。创建指定目录的所有组成部分"
      ]
    },
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group <GROUP>"
      ],
      "tip": [
        "设置组属主，而非进程当前组"
      ],
      "next": []
    },
    {
      "name": "--mode",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mode <MODE>"
      ],
      "tip": [
        "设置权限模式（如 chmod），而非 rwxr-xr-x"
      ],
      "next": []
    },
    {
      "name": "--no-target-directory",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --no-target-directory"
      ],
      "tip": [
        "将 DEST 视为普通文件"
      ]
    },
    {
      "name": "--owner",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --owner <OWNER>"
      ],
      "tip": [
        "设置属主（仅超级用户）"
      ],
      "next": []
    },
    {
      "name": "--preserve-context",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --preserve-context"
      ],
      "tip": [
        "保留安全上下文"
      ]
    },
    {
      "name": "--preserve-timestamps",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --preserve-timestamps"
      ],
      "tip": [
        "将 SOURCE 文件的访问 / 修改时间应用到对应的目标文件"
      ]
    },
    {
      "name": "--strip",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --strip"
      ],
      "tip": [
        "剥离符号表"
      ]
    },
    {
      "name": "--strip-program",
      "usage": [
        "--strip-program <PROGRAM>"
      ],
      "tip": [
        "用于剥离二进制文件的程序"
      ],
      "next": []
    },
    {
      "name": "--suffix",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --suffix <SUFFIX>"
      ],
      "tip": [
        "覆盖常用的备份后缀"
      ],
      "next": []
    },
    {
      "name": "--target-directory",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --target-directory <DIRECTORY>"
      ],
      "tip": [
        "将所有 SOURCE 参数移动到 DIRECTORY"
      ],
      "next": []
    },
    {
      "name": "--unprivileged",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --unprivileged"
      ],
      "tip": [
        "更改目标的属主、组或文件标志时不需要提升权限"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "解释正在做什么"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-b",
      "tip": [
        "类似 --backup 但不接受参数"
      ]
    },
    {
      "name": "-c",
      "tip": [
        "忽略"
      ]
    },
    {
      "name": "-D",
      "tip": [
        "创建 DEST 除最后一部分外的所有前导部分，然后将 SOURCE 复制到 DEST"
      ]
    },
    {
      "name": "-Z",
      "tip": [
        "将目标文件及每个创建目录的 SELinux 安全上下文设为默认类型"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
