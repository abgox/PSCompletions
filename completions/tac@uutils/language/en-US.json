{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Write each file to standard output, last line first."
    ]
  },
  "option": [
    {
      "name": "--before",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --before"
      ],
      "tip": [
        "attach the separator before instead of after"
      ]
    },
    {
      "name": "--regex",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --regex"
      ],
      "tip": [
        "interpret the sequence as a regular expression"
      ]
    },
    {
      "name": "--separator",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --separator <STRING>"
      ],
      "tip": [
        "use STRING as the separator instead of newline"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
