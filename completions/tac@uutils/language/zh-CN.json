{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将每个文件写到标准输出，最后一行在前"
    ]
  },
  "option": [
    {
      "name": "--before",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --before"
      ],
      "tip": [
        "将分隔符附在前面而非后面"
      ]
    },
    {
      "name": "--regex",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --regex"
      ],
      "tip": [
        "将序列解释为正则表达式"
      ]
    },
    {
      "name": "--separator",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --separator <STRING>"
      ],
      "tip": [
        "使用 STRING 作为分隔符而非换行"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
