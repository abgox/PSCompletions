{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "递归显示控制组内容。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "显示所有控制组，包括空组。"
      ]
    },
    {
      "name": "--cgroup-id",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --cgroup-id=BOOL"
      ],
      "tip": [
        "显示控制组 ID。"
      ],
      "next": []
    },
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "不省略输出。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=NAME"
      ],
      "tip": [
        "显示指定名称的容器。"
      ],
      "next": []
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--unit",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unit"
      ],
      "tip": [
        "显示指定系统单元的子树。"
      ]
    },
    {
      "name": "--user-unit",
      "tip": [
        "显示指定用户单元的子树。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "--xattr",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --xattr=BOOL"
      ],
      "tip": [
        "显示控制组扩展属性。"
      ],
      "next": []
    },
    {
      "name": "-k",
      "tip": [
        "在输出中包含内核线程。"
      ]
    }
  ]
}
