{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Recursively show control group contents."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Show all groups, including empty ones."
      ]
    },
    {
      "name": "--cgroup-id",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --cgroup-id=BOOL"
      ],
      "tip": [
        "Show the cgroup ID."
      ],
      "next": []
    },
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "Do not ellipsize output."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=NAME"
      ],
      "tip": [
        "Show the container with this name."
      ],
      "next": []
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--unit",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unit"
      ],
      "tip": [
        "Show the subtrees of the specified system units."
      ]
    },
    {
      "name": "--user-unit",
      "tip": [
        "Show the subtrees of the specified user units."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    },
    {
      "name": "--xattr",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --xattr=BOOL"
      ],
      "tip": [
        "Show cgroup extended attributes."
      ],
      "next": []
    },
    {
      "name": "-k",
      "tip": [
        "Include kernel threads in the output."
      ]
    }
  ]
}
