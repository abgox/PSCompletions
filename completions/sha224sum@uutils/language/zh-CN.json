{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "打印或检查 SHA224 校验和"
    ]
  },
  "option": [
    {
      "name": "--check",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --check"
      ],
      "tip": [
        "从 FILE 读取校验和并检查"
      ]
    },
    {
      "name": "--ignore-missing",
      "tip": [
        "对缺失文件不失败也不报告状态"
      ]
    },
    {
      "name": "--quiet",
      "tip": [
        "对每个成功验证的文件不打印 OK"
      ]
    },
    {
      "name": "--status",
      "tip": [
        "不输出任何内容，状态码表示成功"
      ]
    },
    {
      "name": "--strict",
      "tip": [
        "对格式不正确的校验和行退出非零状态"
      ]
    },
    {
      "name": "--tag",
      "tip": [
        "创建 BSD 风格的校验和"
      ]
    },
    {
      "name": "--text",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --text"
      ],
      "tip": [
        "以文本模式读取（默认）"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "--warn",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --warn"
      ],
      "tip": [
        "警告格式不正确的校验和行"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "每行输出以 NUL 而非换行结尾，并禁用文件名转义"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
