{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "在新会话中运行程序。"
    ]
  },
  "option": [
    {
      "name": "--ctty",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --ctty"
      ],
      "tip": [
        "将控制终端设置为当前终端。"
      ]
    },
    {
      "name": "--fork",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fork"
      ],
      "tip": [
        "始终 fork。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--wait",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wait"
      ],
      "tip": [
        "等待程序退出，并使用相同的返回码。"
      ]
    }
  ]
}
