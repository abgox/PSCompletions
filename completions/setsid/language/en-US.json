{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Run a program in a new session."
    ]
  },
  "option": [
    {
      "name": "--ctty",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --ctty"
      ],
      "tip": [
        "Set the controlling terminal to the current one."
      ]
    },
    {
      "name": "--fork",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fork"
      ],
      "tip": [
        "Always fork."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--wait",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wait"
      ],
      "tip": [
        "Wait for the program to exit, and use the same return code."
      ]
    }
  ]
}
