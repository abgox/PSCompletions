{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "Change user password."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Report password status on all accounts."
      ]
    },
    {
      "name": "--delete",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delete"
      ],
      "tip": [
        "Delete the password for the named account."
      ]
    },
    {
      "name": "--expire",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --expire"
      ],
      "tip": [
        "Force expire the password for the named account."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display help message and exit."
      ]
    },
    {
      "name": "--inactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --inactive <INACTIVE>"
      ],
      "tip": [
        "Set password inactive after expiration to INACTIVE."
      ],
      "next": []
    },
    {
      "name": "--keep-tokens",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --keep-tokens"
      ],
      "tip": [
        "Change password only if expired."
      ]
    },
    {
      "name": "--lock",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --lock"
      ],
      "tip": [
        "Lock the password of the named account."
      ]
    },
    {
      "name": "--maxdays",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --maxdays <MAX_DAYS>"
      ],
      "tip": [
        "Set maximum number of days before password change to MAX_DAYS."
      ],
      "next": []
    },
    {
      "name": "--mindays",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --mindays <MIN_DAYS>"
      ],
      "tip": [
        "Set minimum number of days before password change to MIN_DAYS."
      ],
      "next": []
    },
    {
      "name": "--prefix",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --prefix <PREFIX_DIR>"
      ],
      "tip": [
        "Apply changes to configuration files under the root filesystem found under PREFIX_DIR.",
        "This option does not chroot and is intended for preparing a cross-compilation target."
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Quiet mode."
      ]
    },
    {
      "name": "--repository",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --repository <REPOSITORY>"
      ],
      "tip": [
        "Change password in REPOSITORY repository."
      ],
      "next": []
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "Apply changes in the CHROOT_DIR directory and use the configuration files from the CHROOT_DIR directory.",
        "Only absolute paths are supported."
      ],
      "next": []
    },
    {
      "name": "--status",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --status"
      ],
      "tip": [
        "Report password status on the named account."
      ]
    },
    {
      "name": "--stdin",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --stdin"
      ],
      "tip": [
        "Read new token from stdin."
      ]
    },
    {
      "name": "--unlock",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unlock"
      ],
      "tip": [
        "Unlock the password of the named account."
      ]
    },
    {
      "name": "--warndays",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --warndays <WARN_DAYS>"
      ],
      "tip": [
        "Set expiration warning days to WARN_DAYS."
      ],
      "next": []
    }
  ]
}
