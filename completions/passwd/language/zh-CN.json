{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "更改用户密码。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "报告所有账户的密码状态。"
      ]
    },
    {
      "name": "--delete",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delete"
      ],
      "tip": [
        "删除指定账户的密码。"
      ]
    },
    {
      "name": "--expire",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --expire"
      ],
      "tip": [
        "强制指定账户的密码过期。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--inactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --inactive <INACTIVE>"
      ],
      "tip": [
        "设置密码过期后的不活跃天数。"
      ],
      "next": []
    },
    {
      "name": "--keep-tokens",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --keep-tokens"
      ],
      "tip": [
        "仅在密码已过期时更改密码。"
      ]
    },
    {
      "name": "--lock",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --lock"
      ],
      "tip": [
        "锁定指定账户的密码。"
      ]
    },
    {
      "name": "--maxdays",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --maxdays <MAX_DAYS>"
      ],
      "tip": [
        "设置密码更改前的最长天数。"
      ],
      "next": []
    },
    {
      "name": "--mindays",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --mindays <MIN_DAYS>"
      ],
      "tip": [
        "设置密码更改前的最短天数。"
      ],
      "next": []
    },
    {
      "name": "--prefix",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --prefix <PREFIX_DIR>"
      ],
      "tip": [
        "在 PREFIX_DIR 下的根文件系统中应用对配置文件的更改。",
        "该选项不会 chroot，用于准备交叉编译目标。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "静默模式。"
      ]
    },
    {
      "name": "--repository",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --repository <REPOSITORY>"
      ],
      "tip": [
        "在 REPOSITORY 仓库中更改密码。"
      ],
      "next": []
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--status",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --status"
      ],
      "tip": [
        "报告指定账户的密码状态。"
      ]
    },
    {
      "name": "--stdin",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --stdin"
      ],
      "tip": [
        "从标准输入读取新密码。"
      ]
    },
    {
      "name": "--unlock",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unlock"
      ],
      "tip": [
        "解锁指定账户的密码。"
      ]
    },
    {
      "name": "--warndays",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --warndays <WARN_DAYS>"
      ],
      "tip": [
        "设置密码过期前的警告天数。"
      ],
      "next": []
    }
  ]
}
