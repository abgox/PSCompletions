{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把输入行的一个随机排列写入标准输出。"
    ]
  },
  "option": [
    {
      "name": "--echo",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --echo"
      ],
      "tip": [
        "把每个 ARG 当作一行输入"
      ]
    },
    {
      "name": "--head-count",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --head-count <COUNT>"
      ],
      "tip": [
        "最多输出 COUNT 行"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "10"
        },
        {
          "name": "5"
        }
      ]
    },
    {
      "name": "--input-range",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --input-range <LO-HI>"
      ],
      "tip": [
        "把 LO 到 HI 之间的每个数字当作一行输入"
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <FILE>"
      ],
      "tip": [
        "把结果写入 FILE 而不是标准输出"
      ],
      "next": []
    },
    {
      "name": "--random-source",
      "usage": [
        "--random-source <FILE>"
      ],
      "tip": [
        "从 FILE 获取随机字节"
      ],
      "next": []
    },
    {
      "name": "--repeat",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --repeat"
      ],
      "tip": [
        "输出行可以重复"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "行分隔符为 NUL，而不是换行符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
