{
  "meta": {
    "url": "https://github.com/ahmetb/kubectx",
    "description": [
      "在不同 Kubernetes 上下文之间切换（kubectl config use-context）。"
    ]
  },
  "option": [
    {
      "name": "--current",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --current"
      ],
      "tip": [
        "显示当前上下文名称。"
      ]
    },
    {
      "name": "--delete",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delete <NAME> [<NAME>...]"
      ],
      "tip": [
        "删除上下文。",
        "此命令不会删除上下文引用的 user/cluster 条目。"
      ],
      "next": []
    },
    {
      "name": "--readonly",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --readonly [<NAME>]"
      ],
      "tip": [
        "启动一个限定于该上下文的只读 shell（或交互式选择）。"
      ],
      "next": []
    },
    {
      "name": "--shell",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shell [<NAME>]"
      ],
      "tip": [
        "启动一个限定于该上下文的 shell（或交互式选择）。"
      ],
      "next": []
    },
    {
      "name": "--unset",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unset"
      ],
      "tip": [
        "取消设置当前上下文。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此消息。"
      ]
    }
  ]
}
