{
  "meta": {
    "url": "https://github.com/ahmetb/kubectx",
    "description": [
      "Switch between Kubernetes contexts (kubectl config use-context)."
    ]
  },
  "option": [
    {
      "name": "--current",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --current"
      ],
      "tip": [
        "Show the current context name."
      ]
    },
    {
      "name": "--delete",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delete <NAME> [<NAME>...]"
      ],
      "tip": [
        "Delete context(s).",
        "This command won't delete the user/cluster entry referenced by the context entry."
      ],
      "next": []
    },
    {
      "name": "--readonly",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --readonly [<NAME>]"
      ],
      "tip": [
        "Start a read-only shell scoped to the context (or interactively select one)."
      ],
      "next": []
    },
    {
      "name": "--shell",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shell [<NAME>]"
      ],
      "tip": [
        "Start a shell scoped to the context (or interactively select one)."
      ],
      "next": []
    },
    {
      "name": "--unset",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unset"
      ],
      "tip": [
        "Unset the current context."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this message."
      ]
    }
  ]
}
