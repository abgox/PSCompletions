{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Display a line of text"
    ]
  },
  "option": [
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "-e",
      "tip": [
        "enable interpretation of backslash escapes"
      ]
    },
    {
      "name": "-E",
      "tip": [
        "disable interpretation of backslash escapes (default)"
      ]
    },
    {
      "name": "-n",
      "tip": [
        "do not output the trailing newline"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
