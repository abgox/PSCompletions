{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "显示一行文本"
    ]
  },
  "option": [
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-e",
      "tip": [
        "启用反斜杠转义的解释"
      ]
    },
    {
      "name": "-E",
      "tip": [
        "禁用反斜杠转义的解释（默认）"
      ]
    },
    {
      "name": "-n",
      "tip": [
        "不输出末尾换行符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
