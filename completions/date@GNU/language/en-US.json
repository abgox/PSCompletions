{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "Display date and time in the given FORMAT."
    ]
  },
  "option": [
    {
      "name": "--date",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --date <STRING>"
      ],
      "tip": [
        "display time described by STRING, not 'now'"
      ],
      "next": [
        {
          "name": "now"
        }
      ]
    },
    {
      "name": "--debug",
      "tip": [
        "annotate the parsed date, and warn about questionable usage to stderr"
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file <DATEFILE>"
      ],
      "tip": [
        "like --date; once for each line of DATEFILE"
      ],
      "next": []
    },
    {
      "name": "--iso-8601",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I[FMT], --iso-8601[=FMT]"
      ],
      "tip": [
        "output date/time in ISO 8601 format. FMT='date' for date only (the default), 'hours', 'minutes', 'seconds', or 'ns' for date and time to the indicated precision.",
        "Example: 2006-08-14T02:34:56-06:00"
      ],
      "next": [
        {
          "name": "date"
        },
        {
          "name": "hours"
        },
        {
          "name": "minutes"
        },
        {
          "name": "ns"
        },
        {
          "name": "seconds"
        }
      ]
    },
    {
      "name": "--reference",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reference <FILE>"
      ],
      "tip": [
        "display the last modification time of FILE"
      ],
      "next": []
    },
    {
      "name": "--resolution",
      "tip": [
        "output the available resolution of timestamps.",
        "Example: 0.000000001"
      ]
    },
    {
      "name": "--rfc-3339",
      "usage": [
        "--rfc-3339 <FMT>"
      ],
      "tip": [
        "output date/time in RFC 3339 format. FMT='date', 'seconds', or 'ns' for date and time to the indicated precision.",
        "Example: 2006-08-14 02:34:56-06:00"
      ],
      "next": [
        {
          "name": "date"
        },
        {
          "name": "ns"
        },
        {
          "name": "seconds"
        }
      ]
    },
    {
      "name": "--rfc-email",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --rfc-email"
      ],
      "tip": [
        "output date and time in RFC 5322 format.",
        "Example: Mon, 14 Aug 2006 02:34:56 -0600"
      ]
    },
    {
      "name": "--set",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --set <STRING>"
      ],
      "tip": [
        "set time described by STRING"
      ],
      "next": []
    },
    {
      "name": "--universal",
      "alias": [
        "--utc",
        "-u"
      ],
      "usage": [
        "-u, --utc, --universal"
      ],
      "tip": [
        "print or set Coordinated Universal Time (UTC)"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "display this help and exit"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "output version information and exit"
      ]
    }
  ]
}
