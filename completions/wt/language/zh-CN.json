{
  "meta": {
    "url": "https://github.com/microsoft/terminal",
    "description": [
      "Windows Terminal 命令行。"
    ]
  },
  "next": [
    {
      "name": "ft",
      "tip": [
        "focus-tab",
        "聚焦窗口中的特定标签页"
      ],
      "option": [
        {
          "name": "--target",
          "alias": [
            "-t"
          ],
          "usage": [
            "-t, --target <tab-index>"
          ],
          "tip": [
            "根据标签页索引号聚焦特定标签页"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "mf",
      "tip": [
        "move-focus",
        "在窗格之间移动焦点"
      ],
      "next": [
        {
          "name": "down"
        },
        {
          "name": "first"
        },
        {
          "name": "left"
        },
        {
          "name": "nextInOrder"
        },
        {
          "name": "previous"
        },
        {
          "name": "previousInOrder"
        },
        {
          "name": "right"
        },
        {
          "name": "up"
        }
      ]
    },
    {
      "name": "mp",
      "tip": [
        "move-pane",
        "将活动窗格移动到指定的标签页"
      ],
      "option": [
        {
          "name": "--tab",
          "alias": [
            "-t"
          ],
          "usage": [
            "-t, --tab <index>"
          ],
          "tip": [
            "将活动窗格移动到指定的标签页 (从 0 开始)"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "nt",
      "tip": [
        "new-tab",
        "创建一个新的标签页"
      ],
      "option": [
        {
          "name": "--appendCommandLine",
          "tip": [
            "将提供的命令行追加到配置文件的默认命令中"
          ]
        },
        {
          "name": "--colorScheme",
          "usage": [
            "--colorScheme <scheme-name>"
          ],
          "tip": [
            "覆盖配置文件的 colorScheme 设置"
          ],
          "next": []
        },
        {
          "name": "--inheritEnvironment",
          "tip": [
            "创建新会话时继承终端自身的环境变量"
          ]
        },
        {
          "name": "--profile",
          "alias": [
            "-p"
          ],
          "usage": [
            "-p, --profile <profile-name>"
          ],
          "tip": [
            "使用指定的配置文件创建新标签页"
          ],
          "next": []
        },
        {
          "name": "--startingDirectory",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --startingDirectory <starting-directory>"
          ],
          "tip": [
            "使用指定的起始目录路径创建新标签页"
          ],
          "next": []
        },
        {
          "name": "--suppressApplicationTitle",
          "tip": [
            "覆盖配置文件的 suppressApplicationTitle 设置为 true"
          ]
        },
        {
          "name": "--tabColor",
          "usage": [
            "--tabColor <hex-color>"
          ],
          "tip": [
            "使用指定的标签页颜色创建新标签页 (例如 #RGB 或 #RRGGBB)"
          ],
          "next": []
        },
        {
          "name": "--title",
          "usage": [
            "--title <title>"
          ],
          "tip": [
            "使用指定的标题创建新标签页"
          ],
          "next": []
        },
        {
          "name": "--useApplicationTitle",
          "tip": [
            "覆盖配置文件的 suppressApplicationTitle 设置为 false"
          ]
        }
      ]
    },
    {
      "name": "sp",
      "tip": [
        "split-pane",
        "创建一个新的分屏"
      ],
      "option": [
        {
          "name": "--colorScheme",
          "usage": [
            "--colorScheme <scheme-name>"
          ],
          "tip": [
            "覆盖配置文件的 colorScheme 设置"
          ],
          "next": []
        },
        {
          "name": "--duplicate",
          "alias": [
            "-D"
          ],
          "usage": [
            "-D, --duplicate"
          ],
          "tip": [
            "创建当前窗格的副本"
          ]
        },
        {
          "name": "--horizontal",
          "alias": [
            "-H"
          ],
          "usage": [
            "-H, --horizontal"
          ],
          "tip": [
            "水平分割窗格"
          ]
        },
        {
          "name": "--profile",
          "alias": [
            "-p"
          ],
          "usage": [
            "-p, --profile <profile-name>"
          ],
          "tip": [
            "使用指定的配置文件创建分屏"
          ],
          "next": []
        },
        {
          "name": "--size",
          "alias": [
            "-s"
          ],
          "usage": [
            "-s, --size <size>"
          ],
          "tip": [
            "使用指定的大小创建分屏 (浮点数, 例如 .4 表示 40%)"
          ],
          "next": []
        },
        {
          "name": "--startingDirectory",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --startingDirectory <starting-directory>"
          ],
          "tip": [
            "使用指定的起始目录路径创建分屏"
          ],
          "next": []
        },
        {
          "name": "--suppressApplicationTitle",
          "tip": [
            "覆盖配置文件的 suppressApplicationTitle 设置为 true"
          ]
        },
        {
          "name": "--tabColor",
          "usage": [
            "--tabColor <hex-color>"
          ],
          "tip": [
            "使用指定的标签页颜色创建分屏"
          ],
          "next": []
        },
        {
          "name": "--title",
          "usage": [
            "--title <title>"
          ],
          "tip": [
            "使用指定的标题创建分屏"
          ],
          "next": []
        },
        {
          "name": "--useApplicationTitle",
          "tip": [
            "覆盖配置文件的 suppressApplicationTitle 设置为 false"
          ]
        },
        {
          "name": "--vertical",
          "alias": [
            "-V"
          ],
          "usage": [
            "-V, --vertical"
          ],
          "tip": [
            "垂直分割窗格"
          ]
        }
      ]
    },
    {
      "name": "swap-pane",
      "tip": [
        "swap-pane",
        "交换窗口中两个窗格的位置"
      ],
      "next": [
        {
          "name": "down"
        },
        {
          "name": "first"
        },
        {
          "name": "left"
        },
        {
          "name": "nextInOrder"
        },
        {
          "name": "previous"
        },
        {
          "name": "previousInOrder"
        },
        {
          "name": "right"
        },
        {
          "name": "up"
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--colorScheme",
      "usage": [
        "--colorScheme <scheme-name>"
      ],
      "tip": [
        "覆盖配置文件的 colorScheme 设置"
      ],
      "next": []
    },
    {
      "name": "--pos",
      "tip": [
        "指定终端在屏幕上的位置, 格式为 \"x,y\"",
        "(屏幕的左上角是原点: x 是 0, y 是 0)"
      ],
      "example": [
        {
          "cmd": "--pos 100,200",
          "desc": "从 x 100, y 200 开始。"
        }
      ],
      "next": []
    },
    {
      "name": "--size",
      "tip": [
        "指定终端的列数和行数, 格式为 \"column,row\""
      ],
      "example": [
        {
          "cmd": "--size 80,25",
          "desc": "从 80 列和 25 行开始"
        }
      ],
      "next": []
    },
    {
      "name": "--tabColor",
      "usage": [
        "--tabColor <hex-color>"
      ],
      "tip": [
        "设置标签页颜色 (例如 #RGB 或 #RRGGBB)"
      ],
      "next": []
    },
    {
      "name": "--title",
      "usage": [
        "--title <title>"
      ],
      "tip": [
        "设置窗口标题"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示 wt 的版本信息"
      ]
    },
    {
      "name": "--window",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --window <window-id>"
      ],
      "tip": [
        "指定运行给定命令行的终端窗口",
        "可选值: new/-1 (新窗口), last/0 (最近使用的窗口), 或窗口 ID/名称"
      ],
      "example": [
        {
          "cmd": "-w 0",
          "desc": "在当前窗口运行"
        },
        {
          "cmd": "-w 1",
          "desc": "在下一个窗口运行"
        },
        {
          "cmd": "-w new",
          "desc": "在新窗口运行"
        }
      ],
      "next": [
        {
          "name": "0",
          "tip": [
            "在最近使用的窗口运行 (last)"
          ]
        },
        {
          "name": "1",
          "tip": [
            "在下一个窗口运行"
          ]
        },
        {
          "name": "new",
          "tip": [
            "始终在新窗口运行"
          ]
        }
      ]
    },
    {
      "name": "-d",
      "usage": [
        "-d <dir>"
      ],
      "tip": [
        "指定启动目录"
      ],
      "example": [
        {
          "cmd": "-d \"D:\\\"",
          "desc": "从 D 盘根目录启动"
        }
      ],
      "next": []
    },
    {
      "name": "-f",
      "tip": [
        "以聚焦模式启动窗口"
      ]
    },
    {
      "name": "-F",
      "tip": [
        "以全屏模式启动窗口"
      ]
    },
    {
      "name": "-M",
      "tip": [
        "以最大化模式启动窗口"
      ]
    },
    {
      "name": "-p",
      "usage": [
        "-p <profile>"
      ],
      "tip": [
        "使用指定的配置文件启动终端"
      ],
      "example": [
        {
          "cmd": "-p \"PowerShell\"",
          "desc": "使用 PowerShell 启动"
        }
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h",
        "-?",
        "/?"
      ],
      "usage": [
        "-h, -?, /?, --help"
      ],
      "tip": [
        "显示帮助信息"
      ]
    }
  ]
}
