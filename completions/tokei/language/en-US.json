{
  "meta": {
    "url": "https://github.com/XAMPPRocky/tokei",
    "description": [
      "Count your code, quickly"
    ]
  },
  "option": [
    {
      "name": "--columns",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --columns <columns>"
      ],
      "tip": [
        "Sets a strict column width of the output, only available for terminal output"
      ],
      "next": []
    },
    {
      "name": "--compact",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --compact"
      ],
      "tip": [
        "Do not print statistics about embedded languages"
      ]
    },
    {
      "name": "--exclude",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exclude <exclude>..."
      ],
      "tip": [
        "Ignore all files & directories matching the pattern"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--files",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --files"
      ],
      "tip": [
        "Will print out statistics on individual files"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help information"
      ]
    },
    {
      "name": "--hidden",
      "tip": [
        "Count hidden files"
      ]
    },
    {
      "name": "--input",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --input <file_input>"
      ],
      "tip": [
        "Gives statistics from a previous tokei run. Can be given a file path, or stdin"
      ],
      "next": []
    },
    {
      "name": "--languages",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --languages"
      ],
      "tip": [
        "Prints out supported languages and their extensions"
      ]
    },
    {
      "name": "--no-ignore",
      "tip": [
        "Don't respect ignore files (.gitignore, .ignore, etc.)"
      ]
    },
    {
      "name": "--no-ignore-dot",
      "tip": [
        "Don't respect .ignore and .tokeignore files"
      ]
    },
    {
      "name": "--no-ignore-parent",
      "tip": [
        "Don't respect ignore files in parent directories"
      ]
    },
    {
      "name": "--no-ignore-vcs",
      "tip": [
        "Don't respect VCS ignore files (.gitignore, .hgignore, etc.)"
      ]
    },
    {
      "name": "--num-format",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --num-format <num_format_style>"
      ],
      "tip": [
        "Format of printed numbers, i.e., plain, commas, dots, or underscores"
      ],
      "next": [
        {
          "name": "commas",
          "tip": [
            "Use commas (1,234)"
          ]
        },
        {
          "name": "dots",
          "tip": [
            "Use dots (1.234)"
          ]
        },
        {
          "name": "plain",
          "tip": [
            "Use plain numbers (1234, default)"
          ]
        },
        {
          "name": "underscores",
          "tip": [
            "Use underscores (1_234)"
          ]
        }
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <output>"
      ],
      "tip": [
        "Outputs Tokei in a specific format"
      ],
      "next": [
        {
          "name": "cbor",
          "tip": [
            "CBOR format"
          ]
        },
        {
          "name": "json",
          "tip": [
            "JSON format"
          ]
        },
        {
          "name": "yaml",
          "tip": [
            "YAML format"
          ]
        }
      ]
    },
    {
      "name": "--rsort",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --rsort <rsort>"
      ],
      "tip": [
        "Reverse sort languages based on column"
      ],
      "next": [
        {
          "name": "blanks",
          "tip": [
            "Sort by blanks"
          ]
        },
        {
          "name": "code",
          "tip": [
            "Sort by code"
          ]
        },
        {
          "name": "comments",
          "tip": [
            "Sort by comments"
          ]
        },
        {
          "name": "files",
          "tip": [
            "Sort by files"
          ]
        },
        {
          "name": "lines",
          "tip": [
            "Sort by lines"
          ]
        }
      ]
    },
    {
      "name": "--sort",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sort <sort>"
      ],
      "tip": [
        "Sort languages based on column"
      ],
      "next": [
        {
          "name": "blanks",
          "tip": [
            "Sort by blanks"
          ]
        },
        {
          "name": "code",
          "tip": [
            "Sort by code"
          ]
        },
        {
          "name": "comments",
          "tip": [
            "Sort by comments"
          ]
        },
        {
          "name": "files",
          "tip": [
            "Sort by files"
          ]
        },
        {
          "name": "lines",
          "tip": [
            "Sort by lines"
          ]
        }
      ]
    },
    {
      "name": "--streaming",
      "usage": [
        "--streaming <streaming>"
      ],
      "tip": [
        "Prints the records as simple lines or as Json for batch processing"
      ],
      "next": [
        {
          "name": "json",
          "tip": [
            "Json format"
          ]
        },
        {
          "name": "simple",
          "tip": [
            "Simple lines"
          ]
        }
      ]
    },
    {
      "name": "--types",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --types <types>"
      ],
      "tip": [
        "Filters output by language type, separated by a comma"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Set log output level"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version information"
      ]
    }
  ]
}
