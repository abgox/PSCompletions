{
  "meta": {
    "url": "https://github.com/XAMPPRocky/tokei",
    "description": [
      "快速统计你的代码量"
    ]
  },
  "option": [
    {
      "name": "--columns",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --columns <columns>"
      ],
      "tip": [
        "设置输出的严格列宽，仅适用于终端输出"
      ],
      "next": []
    },
    {
      "name": "--compact",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --compact"
      ],
      "tip": [
        "不打印内嵌语言的统计信息"
      ]
    },
    {
      "name": "--exclude",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exclude <exclude>..."
      ],
      "tip": [
        "忽略所有匹配模式的文件和目录"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--files",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --files"
      ],
      "tip": [
        "打印各个文件的统计信息"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息"
      ]
    },
    {
      "name": "--hidden",
      "tip": [
        "统计隐藏文件"
      ]
    },
    {
      "name": "--input",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --input <file_input>"
      ],
      "tip": [
        "从之前 tokei 运行的结果获取统计数据，可为文件路径或 stdin"
      ],
      "next": []
    },
    {
      "name": "--languages",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --languages"
      ],
      "tip": [
        "打印支持的语言及其扩展名"
      ]
    },
    {
      "name": "--no-ignore",
      "tip": [
        "不遵守忽略文件（.gitignore、.ignore 等）"
      ]
    },
    {
      "name": "--no-ignore-dot",
      "tip": [
        "不遵守 .ignore 和 .tokeignore 文件"
      ]
    },
    {
      "name": "--no-ignore-parent",
      "tip": [
        "不遵守父目录中的忽略文件"
      ]
    },
    {
      "name": "--no-ignore-vcs",
      "tip": [
        "不遵守 VCS 忽略文件（.gitignore、.hgignore 等）"
      ]
    },
    {
      "name": "--num-format",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --num-format <num_format_style>"
      ],
      "tip": [
        "打印数字的格式，如 plain、commas、dots 或 underscores"
      ],
      "next": [
        {
          "name": "commas",
          "tip": [
            "使用逗号（1,234）"
          ]
        },
        {
          "name": "dots",
          "tip": [
            "使用点号（1.234）"
          ]
        },
        {
          "name": "plain",
          "tip": [
            "使用纯数字（1234，默认）"
          ]
        },
        {
          "name": "underscores",
          "tip": [
            "使用下划线（1_234）"
          ]
        }
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <output>"
      ],
      "tip": [
        "以特定格式输出 Tokei 统计结果"
      ],
      "next": [
        {
          "name": "cbor",
          "tip": [
            "CBOR 格式"
          ]
        },
        {
          "name": "json",
          "tip": [
            "JSON 格式"
          ]
        },
        {
          "name": "yaml",
          "tip": [
            "YAML 格式"
          ]
        }
      ]
    },
    {
      "name": "--rsort",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --rsort <rsort>"
      ],
      "tip": [
        "按列反向排序语言"
      ],
      "next": [
        {
          "name": "blanks",
          "tip": [
            "按空行排序"
          ]
        },
        {
          "name": "code",
          "tip": [
            "按代码排序"
          ]
        },
        {
          "name": "comments",
          "tip": [
            "按注释排序"
          ]
        },
        {
          "name": "files",
          "tip": [
            "按文件数排序"
          ]
        },
        {
          "name": "lines",
          "tip": [
            "按行数排序"
          ]
        }
      ]
    },
    {
      "name": "--sort",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sort <sort>"
      ],
      "tip": [
        "按列排序语言"
      ],
      "next": [
        {
          "name": "blanks",
          "tip": [
            "按空行排序"
          ]
        },
        {
          "name": "code",
          "tip": [
            "按代码排序"
          ]
        },
        {
          "name": "comments",
          "tip": [
            "按注释排序"
          ]
        },
        {
          "name": "files",
          "tip": [
            "按文件数排序"
          ]
        },
        {
          "name": "lines",
          "tip": [
            "按行数排序"
          ]
        }
      ]
    },
    {
      "name": "--streaming",
      "usage": [
        "--streaming <streaming>"
      ],
      "tip": [
        "以简单行或 Json 形式打印记录，用于批处理"
      ],
      "next": [
        {
          "name": "json",
          "tip": [
            "Json 格式"
          ]
        },
        {
          "name": "simple",
          "tip": [
            "简单行格式"
          ]
        }
      ]
    },
    {
      "name": "--types",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --types <types>"
      ],
      "tip": [
        "按语言类型过滤输出，以逗号分隔"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "设置日志输出级别"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息"
      ]
    }
  ]
}
