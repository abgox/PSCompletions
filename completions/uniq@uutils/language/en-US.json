{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Report or omit repeated lines."
    ]
  },
  "option": [
    {
      "name": "--all-repeated",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --all-repeated[=<DELIMIT-METHOD>]"
      ],
      "tip": [
        "print all duplicate lines. Delimiting is done with blank lines"
      ],
      "next": [
        {
          "name": "none"
        },
        {
          "name": "prepend"
        },
        {
          "name": "separate"
        }
      ]
    },
    {
      "name": "--check-chars",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --check-chars <N>"
      ],
      "tip": [
        "compare no more than N characters in lines"
      ],
      "next": []
    },
    {
      "name": "--count",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --count"
      ],
      "tip": [
        "prefix lines by the number of occurrences"
      ]
    },
    {
      "name": "--group",
      "usage": [
        "--group[=<GROUP-METHOD>]"
      ],
      "tip": [
        "show all items, separating groups with an empty line"
      ],
      "next": [
        {
          "name": "append"
        },
        {
          "name": "both"
        },
        {
          "name": "prepend"
        },
        {
          "name": "separate"
        }
      ]
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-case"
      ],
      "tip": [
        "ignore differences in case when comparing"
      ]
    },
    {
      "name": "--repeated",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --repeated"
      ],
      "tip": [
        "only print duplicate lines"
      ]
    },
    {
      "name": "--skip-chars",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --skip-chars <N>"
      ],
      "tip": [
        "avoid comparing the first N characters"
      ],
      "next": []
    },
    {
      "name": "--skip-fields",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --skip-fields <N>"
      ],
      "tip": [
        "avoid comparing the first N fields"
      ],
      "next": []
    },
    {
      "name": "--unique",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unique"
      ],
      "tip": [
        "only print unique lines"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "end lines with 0 byte, not newline"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
