{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "报告或省略重复的行"
    ]
  },
  "option": [
    {
      "name": "--all-repeated",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --all-repeated[=<DELIMIT-METHOD>]"
      ],
      "tip": [
        "打印所有重复行。用空行分隔"
      ],
      "next": [
        {
          "name": "none"
        },
        {
          "name": "prepend"
        },
        {
          "name": "separate"
        }
      ]
    },
    {
      "name": "--check-chars",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --check-chars <N>"
      ],
      "tip": [
        "比较行时最多比较 N 个字符"
      ],
      "next": []
    },
    {
      "name": "--count",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --count"
      ],
      "tip": [
        "在行前加上出现次数"
      ]
    },
    {
      "name": "--group",
      "usage": [
        "--group[=<GROUP-METHOD>]"
      ],
      "tip": [
        "显示所有项，组之间用空行分隔"
      ],
      "next": [
        {
          "name": "append"
        },
        {
          "name": "both"
        },
        {
          "name": "prepend"
        },
        {
          "name": "separate"
        }
      ]
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-case"
      ],
      "tip": [
        "比较时忽略大小写差异"
      ]
    },
    {
      "name": "--repeated",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --repeated"
      ],
      "tip": [
        "只打印重复行"
      ]
    },
    {
      "name": "--skip-chars",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --skip-chars <N>"
      ],
      "tip": [
        "比较时跳过前 N 个字符"
      ],
      "next": []
    },
    {
      "name": "--skip-fields",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --skip-fields <N>"
      ],
      "tip": [
        "比较时跳过前 N 个字段"
      ],
      "next": []
    },
    {
      "name": "--unique",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unique"
      ],
      "tip": [
        "只打印唯一行"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "行以 0 字节而非换行结尾"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
