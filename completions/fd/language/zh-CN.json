{
  "meta": {
    "url": "https://github.com/sharkdp/fd",
    "description": [
      "在文件系统中查找条目的程序。"
    ]
  },
  "option": [
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--absolute-path",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --absolute-path"
      ],
      "tip": [
        "显示从根目录开始的完整路径。"
      ]
    },
    {
      "name": "--and",
      "usage": [
        "--and <pattern>"
      ],
      "tip": [
        "添加额外的必需搜索模式。"
      ],
      "next": []
    },
    {
      "name": "--base-directory",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --base-directory <path>"
      ],
      "tip": [
        "更改 fd 的当前工作目录。"
      ],
      "next": []
    },
    {
      "name": "--batch-size",
      "usage": [
        "--batch-size <size>"
      ],
      "tip": [
        "--exec-batch 的最大参数数量。"
      ],
      "next": []
    },
    {
      "name": "--case-sensitive",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --case-sensitive"
      ],
      "tip": [
        "执行区分大小写的搜索。"
      ]
    },
    {
      "name": "--changed-before",
      "usage": [
        "--changed-before <date|dur>"
      ],
      "tip": [
        "按修改时间过滤（较旧的）。"
      ],
      "next": [
        {
          "name": "1h"
        },
        {
          "name": "2024-01-01"
        },
        {
          "name": "7d"
        }
      ]
    },
    {
      "name": "--changed-within",
      "usage": [
        "--changed-within <date|dur>"
      ],
      "tip": [
        "按修改时间过滤（较新的）。"
      ],
      "next": [
        {
          "name": "1h"
        },
        {
          "name": "2024-01-01"
        },
        {
          "name": "7d"
        }
      ]
    },
    {
      "name": "--color",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --color <when>"
      ],
      "tip": [
        "何时使用颜色（auto、always、never）。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--exact-depth",
      "usage": [
        "--exact-depth <depth>"
      ],
      "tip": [
        "仅显示精确给定深度的结果。"
      ],
      "next": []
    },
    {
      "name": "--exclude",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --exclude <pattern>"
      ],
      "tip": [
        "排除匹配 glob 模式的文件/目录。"
      ],
      "next": []
    },
    {
      "name": "--exec",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exec <cmd>..."
      ],
      "tip": [
        "为每个搜索结果执行命令。"
      ],
      "next": []
    },
    {
      "name": "--exec-batch",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --exec-batch <cmd>..."
      ],
      "tip": [
        "使用所有搜索结果作为参数执行命令。"
      ],
      "next": []
    },
    {
      "name": "--extension",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --extension <ext>"
      ],
      "tip": [
        "按文件扩展名过滤。"
      ],
      "next": []
    },
    {
      "name": "--fixed-strings",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --fixed-strings"
      ],
      "tip": [
        "将模式视为字面字符串。"
      ]
    },
    {
      "name": "--follow",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --follow"
      ],
      "tip": [
        "跟随符号链接。"
      ]
    },
    {
      "name": "--format",
      "usage": [
        "--format <fmt>"
      ],
      "tip": [
        "根据模板打印结果。"
      ],
      "next": []
    },
    {
      "name": "--full-path",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --full-path"
      ],
      "tip": [
        "对完整路径匹配模式。"
      ]
    },
    {
      "name": "--glob",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --glob"
      ],
      "tip": [
        "执行基于 glob 的搜索而非正则表达式。"
      ]
    },
    {
      "name": "--has-results",
      "tip": [
        "--quiet 的别名。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息。"
      ]
    },
    {
      "name": "--hidden",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --hidden"
      ],
      "tip": [
        "在搜索结果中包含隐藏的目录和文件。"
      ]
    },
    {
      "name": "--hyperlink",
      "usage": [
        "--hyperlink [<when>]"
      ],
      "tip": [
        "为文件路径添加终端超链接。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-case"
      ],
      "tip": [
        "执行不区分大小写的搜索。"
      ]
    },
    {
      "name": "--ignore-contain",
      "usage": [
        "--ignore-contain <name>"
      ],
      "tip": [
        "忽略包含指定条目的目录。"
      ],
      "next": []
    },
    {
      "name": "--ignore-file",
      "usage": [
        "--ignore-file <path>"
      ],
      "tip": [
        "添加 .gitignore 格式的自定义忽略文件。"
      ],
      "next": []
    },
    {
      "name": "--list-details",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list-details"
      ],
      "tip": [
        "使用类似 ls -l 的详细列表格式。"
      ]
    },
    {
      "name": "--max-depth",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --max-depth <depth>"
      ],
      "tip": [
        "限制目录遍历到给定深度。"
      ],
      "next": []
    },
    {
      "name": "--max-results",
      "usage": [
        "--max-results <count>"
      ],
      "tip": [
        "限制搜索结果的数量。"
      ],
      "next": [
        {
          "name": "10"
        },
        {
          "name": "100"
        }
      ]
    },
    {
      "name": "--min-depth",
      "usage": [
        "--min-depth <depth>"
      ],
      "tip": [
        "仅显示从给定深度开始的结果。"
      ],
      "next": []
    },
    {
      "name": "--no-ignore",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --no-ignore"
      ],
      "tip": [
        "显示被 .gitignore、.ignore 等忽略的文件结果。"
      ]
    },
    {
      "name": "--no-ignore-parent",
      "tip": [
        "显示被父目录忽略文件忽略的文件结果。"
      ]
    },
    {
      "name": "--no-ignore-vcs",
      "tip": [
        "显示被 .gitignore 文件忽略的文件结果。"
      ]
    },
    {
      "name": "--no-require-git",
      "tip": [
        "不要求 git 仓库来遵守 gitignore。"
      ]
    },
    {
      "name": "--one-file-system",
      "tip": [
        "不进入不同的文件系统。"
      ]
    },
    {
      "name": "--path-separator",
      "usage": [
        "--path-separator <separator>"
      ],
      "tip": [
        "设置打印文件路径时的路径分隔符。"
      ],
      "next": []
    },
    {
      "name": "--print0",
      "alias": [
        "-0"
      ],
      "usage": [
        "-0, --print0"
      ],
      "tip": [
        "用 NUL 字符分隔结果。"
      ]
    },
    {
      "name": "--prune",
      "tip": [
        "不遍历匹配搜索条件的目录。"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "不打印任何内容，仅返回退出码。"
      ]
    },
    {
      "name": "--regex",
      "tip": [
        "执行基于正则表达式的搜索（默认）。"
      ]
    },
    {
      "name": "--search-path",
      "usage": [
        "--search-path <search-path>"
      ],
      "tip": [
        "提供搜索路径作为位置参数的替代。"
      ],
      "next": []
    },
    {
      "name": "--show-errors",
      "tip": [
        "启用显示文件系统错误。"
      ]
    },
    {
      "name": "--size",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --size <size>"
      ],
      "tip": [
        "按文件大小限制结果（如 +100k、-1M、500b）。"
      ],
      "next": []
    },
    {
      "name": "--strip-cwd-prefix",
      "usage": [
        "--strip-cwd-prefix [<when>]"
      ],
      "tip": [
        "从相对路径中去除 ./ 前缀。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--threads",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --threads <num>"
      ],
      "tip": [
        "设置使用的线程数。"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <filetype>"
      ],
      "tip": [
        "按类型过滤：f/file、d/dir、l/symlink、x/executable、e/empty。"
      ],
      "next": [
        {
          "name": "b",
          "tip": [
            "块设备"
          ]
        },
        {
          "name": "block-device",
          "tip": [
            "块设备"
          ]
        },
        {
          "name": "c",
          "tip": [
            "字符设备"
          ]
        },
        {
          "name": "char-device",
          "tip": [
            "字符设备"
          ]
        },
        {
          "name": "d",
          "tip": [
            "目录"
          ]
        },
        {
          "name": "dir",
          "tip": [
            "目录"
          ]
        },
        {
          "name": "directory",
          "tip": [
            "目录"
          ]
        },
        {
          "name": "e",
          "tip": [
            "空文件或目录"
          ]
        },
        {
          "name": "empty",
          "tip": [
            "空文件或目录"
          ]
        },
        {
          "name": "executable",
          "tip": [
            "可执行文件"
          ]
        },
        {
          "name": "f",
          "tip": [
            "普通文件"
          ]
        },
        {
          "name": "file",
          "tip": [
            "普通文件"
          ]
        },
        {
          "name": "l",
          "tip": [
            "符号链接"
          ]
        },
        {
          "name": "p",
          "tip": [
            "命名管道"
          ]
        },
        {
          "name": "pipe",
          "tip": [
            "命名管道"
          ]
        },
        {
          "name": "s",
          "tip": [
            "套接字"
          ]
        },
        {
          "name": "socket",
          "tip": [
            "套接字"
          ]
        },
        {
          "name": "symlink",
          "tip": [
            "符号链接"
          ]
        },
        {
          "name": "x",
          "tip": [
            "可执行文件"
          ]
        }
      ]
    },
    {
      "name": "--unrestricted",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unrestricted"
      ],
      "tip": [
        "执行无限制搜索，包含被忽略和隐藏的文件。"
      ],
      "repeat": 2
    },
    {
      "name": "-1",
      "tip": [
        "将搜索限制为单个结果。"
      ]
    }
  ]
}
