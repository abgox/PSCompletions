{
  "meta": {
    "url": "https://github.com/sharkdp/fd",
    "description": [
      "Program to find entries in your filesystem."
    ]
  },
  "option": [
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version information."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--absolute-path",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --absolute-path"
      ],
      "tip": [
        "Show the full path starting from the root."
      ]
    },
    {
      "name": "--and",
      "usage": [
        "--and <pattern>"
      ],
      "tip": [
        "Add additional required search patterns."
      ],
      "next": []
    },
    {
      "name": "--base-directory",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --base-directory <path>"
      ],
      "tip": [
        "Change the current working directory of fd."
      ],
      "next": []
    },
    {
      "name": "--batch-size",
      "usage": [
        "--batch-size <size>"
      ],
      "tip": [
        "Maximum number of arguments for --exec-batch."
      ],
      "next": []
    },
    {
      "name": "--case-sensitive",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --case-sensitive"
      ],
      "tip": [
        "Perform a case-sensitive search."
      ]
    },
    {
      "name": "--changed-before",
      "usage": [
        "--changed-before <date|dur>"
      ],
      "tip": [
        "Filter by modification time (older than)."
      ],
      "next": [
        {
          "name": "1h"
        },
        {
          "name": "2024-01-01"
        },
        {
          "name": "7d"
        }
      ]
    },
    {
      "name": "--changed-within",
      "usage": [
        "--changed-within <date|dur>"
      ],
      "tip": [
        "Filter by modification time (newer than)."
      ],
      "next": [
        {
          "name": "1h"
        },
        {
          "name": "2024-01-01"
        },
        {
          "name": "7d"
        }
      ]
    },
    {
      "name": "--color",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --color <when>"
      ],
      "tip": [
        "When to use color (auto, always, never)."
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--exact-depth",
      "usage": [
        "--exact-depth <depth>"
      ],
      "tip": [
        "Only show results at the exact given depth."
      ],
      "next": []
    },
    {
      "name": "--exclude",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --exclude <pattern>"
      ],
      "tip": [
        "Exclude files/directories matching the glob pattern."
      ],
      "next": []
    },
    {
      "name": "--exec",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exec <cmd>..."
      ],
      "tip": [
        "Execute a command for each search result."
      ],
      "next": []
    },
    {
      "name": "--exec-batch",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --exec-batch <cmd>..."
      ],
      "tip": [
        "Execute command with all search results as arguments."
      ],
      "next": []
    },
    {
      "name": "--extension",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --extension <ext>"
      ],
      "tip": [
        "Filter by file extension."
      ],
      "next": []
    },
    {
      "name": "--fixed-strings",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --fixed-strings"
      ],
      "tip": [
        "Treat the pattern as a literal string."
      ]
    },
    {
      "name": "--follow",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --follow"
      ],
      "tip": [
        "Follow symbolic links."
      ]
    },
    {
      "name": "--format",
      "usage": [
        "--format <fmt>"
      ],
      "tip": [
        "Print results according to template."
      ],
      "next": []
    },
    {
      "name": "--full-path",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --full-path"
      ],
      "tip": [
        "Match the pattern against the full path."
      ]
    },
    {
      "name": "--glob",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --glob"
      ],
      "tip": [
        "Perform a glob-based search instead of regex."
      ]
    },
    {
      "name": "--has-results",
      "tip": [
        "Alias for --quiet."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help information."
      ]
    },
    {
      "name": "--hidden",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --hidden"
      ],
      "tip": [
        "Include hidden directories and files in the search results."
      ]
    },
    {
      "name": "--hyperlink",
      "usage": [
        "--hyperlink [<when>]"
      ],
      "tip": [
        "Add terminal hyperlinks to file paths."
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-case"
      ],
      "tip": [
        "Perform a case-insensitive search."
      ]
    },
    {
      "name": "--ignore-contain",
      "usage": [
        "--ignore-contain <name>"
      ],
      "tip": [
        "Ignore directories containing the named entry."
      ],
      "next": []
    },
    {
      "name": "--ignore-file",
      "usage": [
        "--ignore-file <path>"
      ],
      "tip": [
        "Add a custom ignore file in .gitignore format."
      ],
      "next": []
    },
    {
      "name": "--list-details",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list-details"
      ],
      "tip": [
        "Use a detailed listing format like ls -l."
      ]
    },
    {
      "name": "--max-depth",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --max-depth <depth>"
      ],
      "tip": [
        "Limit directory traversal to a given depth."
      ],
      "next": []
    },
    {
      "name": "--max-results",
      "usage": [
        "--max-results <count>"
      ],
      "tip": [
        "Limit the number of search results."
      ],
      "next": [
        {
          "name": "10"
        },
        {
          "name": "100"
        }
      ]
    },
    {
      "name": "--min-depth",
      "usage": [
        "--min-depth <depth>"
      ],
      "tip": [
        "Only show results starting at the given depth."
      ],
      "next": []
    },
    {
      "name": "--no-ignore",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --no-ignore"
      ],
      "tip": [
        "Show results from files ignored by .gitignore, .ignore, etc."
      ]
    },
    {
      "name": "--no-ignore-parent",
      "tip": [
        "Show results from files ignored by parent directory ignore files."
      ]
    },
    {
      "name": "--no-ignore-vcs",
      "tip": [
        "Show results from files ignored by .gitignore files."
      ]
    },
    {
      "name": "--no-require-git",
      "tip": [
        "Do not require a git repository to respect gitignores."
      ]
    },
    {
      "name": "--one-file-system",
      "tip": [
        "Do not descend into a different file system."
      ]
    },
    {
      "name": "--path-separator",
      "usage": [
        "--path-separator <separator>"
      ],
      "tip": [
        "Set the path separator for printing file paths."
      ],
      "next": []
    },
    {
      "name": "--print0",
      "alias": [
        "-0"
      ],
      "usage": [
        "-0, --print0"
      ],
      "tip": [
        "Separate results by NUL character."
      ]
    },
    {
      "name": "--prune",
      "tip": [
        "Do not traverse into directories matching the search criteria."
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Do not print anything, return exit code."
      ]
    },
    {
      "name": "--regex",
      "tip": [
        "Perform a regular-expression based search (default)."
      ]
    },
    {
      "name": "--search-path",
      "usage": [
        "--search-path <search-path>"
      ],
      "tip": [
        "Provide paths to search as an alternative to positional argument."
      ],
      "next": []
    },
    {
      "name": "--show-errors",
      "tip": [
        "Enable display of filesystem errors."
      ]
    },
    {
      "name": "--size",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --size <size>"
      ],
      "tip": [
        "Limit results by file size (e.g., +100k, -1M, 500b)."
      ],
      "next": []
    },
    {
      "name": "--strip-cwd-prefix",
      "usage": [
        "--strip-cwd-prefix [<when>]"
      ],
      "tip": [
        "Strip the ./ prefix from relative paths."
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--threads",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --threads <num>"
      ],
      "tip": [
        "Set number of threads to use."
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <filetype>"
      ],
      "tip": [
        "Filter by type: f/file, d/dir, l/symlink, x/executable, e/empty."
      ],
      "next": [
        {
          "name": "b",
          "tip": [
            "Block devices"
          ]
        },
        {
          "name": "block-device",
          "tip": [
            "Block devices"
          ]
        },
        {
          "name": "c",
          "tip": [
            "Character devices"
          ]
        },
        {
          "name": "char-device",
          "tip": [
            "Character devices"
          ]
        },
        {
          "name": "d",
          "tip": [
            "Directories"
          ]
        },
        {
          "name": "dir",
          "tip": [
            "Directories"
          ]
        },
        {
          "name": "directory",
          "tip": [
            "Directories"
          ]
        },
        {
          "name": "e",
          "tip": [
            "Empty files or directories"
          ]
        },
        {
          "name": "empty",
          "tip": [
            "Empty files or directories"
          ]
        },
        {
          "name": "executable",
          "tip": [
            "Executables"
          ]
        },
        {
          "name": "f",
          "tip": [
            "Regular files"
          ]
        },
        {
          "name": "file",
          "tip": [
            "Regular files"
          ]
        },
        {
          "name": "l",
          "tip": [
            "Symbolic links"
          ]
        },
        {
          "name": "p",
          "tip": [
            "Named pipes"
          ]
        },
        {
          "name": "pipe",
          "tip": [
            "Named pipes"
          ]
        },
        {
          "name": "s",
          "tip": [
            "Sockets"
          ]
        },
        {
          "name": "socket",
          "tip": [
            "Sockets"
          ]
        },
        {
          "name": "symlink",
          "tip": [
            "Symbolic links"
          ]
        },
        {
          "name": "x",
          "tip": [
            "Executables"
          ]
        }
      ]
    },
    {
      "name": "--unrestricted",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unrestricted"
      ],
      "tip": [
        "Perform an unrestricted search, including ignored and hidden files."
      ],
      "repeat": 2
    },
    {
      "name": "-1",
      "tip": [
        "Limit search to a single result."
      ]
    }
  ]
}
