      "tip": [
        "设置模式为 json。"
      ]
    },
    {
      "name": "-line",
      "tip": [
        "设置模式为 line。"
      ]
    },
    {
      "name": "-list",
      "tip": [
        "设置模式为 list。"
      ]
    },
    {
      "name": "-lookaside",
      "usage": [
        "-lookaside <SIZE> <N>"
      ],
      "tip": [
        "使用 N 个大小为 SIZE 字节的 lookaside 内存条目。"
      ],
      "next": []
    },
    {
      "name": "-markdown",
      "tip": [
        "设置模式为 markdown。"
      ]
    },
    {
      "name": "-maxsize",
      "usage": [
        "-maxsize <N>"
      ],
      "tip": [
        "使用 --deserialize 时数据库的最大大小。"
      ],
      "next": []
    },
    {
      "name": "-memtrace",
      "tip": [
        "跟踪所有内存分配和释放。"
      ]
    },
    {
      "name": "-mmap",
      "usage": [
        "-mmap <N>"
      ],
      "tip": [
        "将默认 mmap 大小设置为 N。"
      ],
      "next": []
    },
    {
      "name": "-newline",
      "usage": [
        "-newline SEP"
      ],
      "tip": [
        "设置行分隔符字符串。"
      ],
      "next": []
    },
    {
      "name": "-no-rowid-in-view",
      "tip": [
        "使用 sqlite3_config() 禁用 rowid-in-view。"
      ]
    },
    {
      "name": "-nofollow",
      "tip": [
        "打开数据库时不跟随符号链接。"
      ]
    },
    {
      "name": "-noheader",
      "tip": [
        "关闭表头显示。"
      ]
    },
    {
      "name": "-noinit",
      "tip": [
        "不读取任何初始化命令。"
      ]
    },
    {
      "name": "-nonce",
      "usage": [
        "-nonce <STRING>"
      ],
      "tip": [
        "设置安全模式的转义随机串。"
      ],
      "next": []
    },
    {
      "name": "-nullvalue",
      "usage": [
        "-nullvalue TEXT"
      ],
      "tip": [
        "设置用于 NULL 值的字符串。"
      ],
      "next": []
    },
    {
      "name": "-pagecache",
      "usage": [
        "-pagecache <SIZE> <N>"
      ],
      "tip": [
        "使用 N 个大小为 SIZE 字节的页缓存槽位。"
      ],
      "next": []
    },
    {
      "name": "-pcachetrace",
      "tip": [
        "跟踪所有页缓存操作。"
      ]
    },
    {
      "name": "-quote",
      "tip": [
        "设置模式为 quote。"
      ]
    },
    {
      "name": "-readonly",
      "tip": [
        "以只读模式打开数据库。"
      ]
    },
    {
      "name": "-safe",
      "tip": [
        "启用安全模式。"
      ]
    },
    {
      "name": "-screenwidth",
      "usage": [
        "-screenwidth <N>"
      ],
      "tip": [
        "使用 N 作为默认屏幕宽度。"
      ],
      "next": []
    },
    {
      "name": "-separator",
      "usage": [
        "-separator SEP"
      ],
      "tip": [
        "设置列分隔符字符串。"
      ],
      "next": []
    },
    {
      "name": "-stats",
      "tip": [
        "在每次 finalize 前打印内存统计。"
      ]
    },
    {
      "name": "-table",
      "tip": [
        "设置模式为 table。"
      ]
    },
    {
      "name": "-tabs",
      "tip": [
        "设置模式为 tabs。"
      ]
    },
    {
      "name": "-unsafe-testing",
      "tip": [
        "允许用于测试的不安全命令和模式。"
      ]
    },
    {
      "name": "-version",
      "tip": [
        "显示 SQLite 版本。"
      ]
    },
    {
      "name": "-vfs",
      "usage": [
        "-vfs NAME"
      ],
      "tip": [
        "使用指定名称作为默认 VFS。"
      ],
      "next": []
    },
    {
      "name": "-vfstrace",
      "tip": [
        "启用所有 VFS 调用的跟踪。"
      ]
    },
    {
      "name": "-zip",
      "tip": [
        "将文件作为 ZIP 归档打开。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "-help",
      "tip": [
        "显示帮助。"
      ]
    }
  ]
