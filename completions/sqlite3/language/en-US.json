{
  "meta": {
    "url": "https://www.sqlite.org",
    "description": [
      "SQLite command line interface."
    ]
  },
  "option": [
    {
      "name": "--",
      "tip": [
        "Treat no subsequent arguments as options."
      ]
    },
    {
      "name": "-A",
      "usage": [
        "-A <ARGS>..."
      ],
      "tip": [
        "Run \".archive ARGS\" and exit."
      ],
      "next": []
    },
    {
      "name": "-append",
      "tip": [
        "Append the database to the end of the file."
      ]
    },
    {
      "name": "-ascii",
      "tip": [
        "Set mode to ascii."
      ]
    },
    {
      "name": "-bail",
      "tip": [
