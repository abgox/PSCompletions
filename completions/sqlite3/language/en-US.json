    {
      "name": "-cmdline-edit",
      "usage": [
        "-cmdline-edit <BOOL>"
      ],
      "tip": [
        "Enable or disable command-line editing."
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1"
        },
        {
          "name": "off"
        },
        {
          "name": "on"
        }
      ]
    },
    {
      "name": "-column",
      "tip": [
        "Set mode to column (default)."
      ]
    },
    {
      "name": "-csv",
      "tip": [
        "Set '.mode csv -limits off'."
      ]
    },
    {
      "name": "-deserialize",
      "tip": [
        "Open the database using sqlite3_deserialize()."
      ]
    },
    {
      "name": "-echo",
      "tip": [
        "Echo commands before execution."
      ]
    },
    {
      "name": "-escape",
      "usage": [
        "-escape T"
      ],
      "tip": [
        "Set the string escaping mode."
      ],
      "next": [
        {
          "name": "ascii",
          "tip": [
            "Use ASCII-based escaping."
          ]
        },
        {
          "name": "auto",
          "tip": [
            "Use automatic escaping."
          ]
        },
        {
          "name": "off",
          "tip": [
            "Disable string escaping."
          ]
        },
        {
          "name": "symbol",
          "tip": [
            "Use symbol-based escaping."
          ]
        }
      ]
    },
    {
      "name": "-header",
      "tip": [
        "Turn headers on."
      ]
    },
    {
      "name": "-html",
      "tip": [
        "Set mode to html."
      ]
    },
    {
      "name": "-ifexists",
      "tip": [
        "Don't open a database that doesn't exist."
      ]
    },
    {
      "name": "-init",
      "usage": [
        "-init FILENAME"
      ],
      "tip": [
        "Read and execute commands from FILENAME."
      ],
      "next": []
    },
    {
      "name": "-interactive",
      "tip": [
        "Force interactive I/O mode."
      ]
    },
    {
      "name": "-json",
      "tip": [
        "Set mode to json."
      ]
    },
    {
      "name": "-line",
      "tip": [
        "Set mode to line."
      ]
    },
    {
      "name": "-list",
      "tip": [
        "Set mode to list."
      ]
    },
    {
      "name": "-lookaside",
      "usage": [
        "-lookaside <SIZE> <N>"
      ],
      "tip": [
        "Use N entries of SIZE bytes for lookaside memory."
      ],
      "next": []
    },
    {
      "name": "-markdown",
      "tip": [
        "Set mode to markdown."
      ]
    },
    {
      "name": "-maxsize",
      "usage": [
        "-maxsize <N>"
      ],
      "tip": [
        "Maximum size for a --deserialize database."
      ],
      "next": []
    },
    {
      "name": "-memtrace",
      "tip": [
        "Trace all memory allocations and deallocations."
      ]
    },
    {
      "name": "-mmap",
      "usage": [
        "-mmap <N>"
      ],
      "tip": [
        "Set the default mmap size to N."
      ],
      "next": []
    },
    {
      "name": "-newline",
      "usage": [
        "-newline SEP"
      ],
      "tip": [
        "Set the row separator string."
      ],
      "next": []
    },
    {
      "name": "-no-rowid-in-view",
      "tip": [
        "Disable rowid-in-view using sqlite3_config()."
      ]
    },
    {
      "name": "-nofollow",
      "tip": [
        "Don't follow symlinks when opening a database."
      ]
    },
    {
      "name": "-noheader",
      "tip": [
        "Turn headers off."
      ]
    },
    {
      "name": "-noinit",
      "tip": [
        "Don't read any init commands."
      ]
    },
    {
      "name": "-nonce",
      "usage": [
        "-nonce <STRING>"
      ],
      "tip": [
        "Set the safe-mode escape nonce."
      ],
      "next": []
    },
    {
      "name": "-nullvalue",
      "usage": [
        "-nullvalue TEXT"
      ],
      "tip": [
        "Set the string used for NULL values."
      ],
      "next": []
    },
    {
      "name": "-pagecache",
      "usage": [
        "-pagecache <SIZE> <N>"
      ],
      "tip": [
        "Use N slots of SIZE bytes each for page cache memory."
      ],
      "next": []
    },
    {
      "name": "-pcachetrace",
      "tip": [
        "Trace all page cache operations."
      ]
    },
    {
      "name": "-quote",
      "tip": [
        "Set mode to quote."
      ]
    },
    {
      "name": "-readonly",
      "tip": [
        "Open the database in read-only mode."
      ]
    },
    {
      "name": "-safe",
      "tip": [
        "Enable safe-mode."
      ]
    },
    {
      "name": "-screenwidth",
      "usage": [
        "-screenwidth <N>"
      ],
      "tip": [
        "Use N as the default screenwidth."
      ],
      "next": []
    },
    {
      "name": "-separator",
      "usage": [
        "-separator SEP"
      ],
      "tip": [
        "Set the column separator string."
      ],
      "next": []
    },
    {
      "name": "-stats",
      "tip": [
        "Print memory stats before each finalize."
      ]
    },
    {
      "name": "-table",
      "tip": [
        "Set mode to table."
      ]
    },
    {
      "name": "-tabs",
      "tip": [
        "Set mode to tabs."
      ]
    },
    {
      "name": "-unsafe-testing",
      "tip": [
        "Allow unsafe commands and modes for testing."
      ]
    },
    {
      "name": "-version",
      "tip": [
        "Show SQLite version."
      ]
    },
    {
      "name": "-vfs",
      "usage": [
        "-vfs NAME"
      ],
      "tip": [
        "Use NAME as the default VFS."
      ],
      "next": []
    },
    {
      "name": "-vfstrace",
      "tip": [
        "Enable tracing of all VFS calls."
      ]
    },
    {
      "name": "-zip",
      "tip": [
        "Open the file as a ZIP Archive."
      ]
    }
  ],
  "global_option": [
    {
      "name": "-help",
      "tip": [
        "Show help."
      ]
    }
  ]
}
