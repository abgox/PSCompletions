{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Play back terminal typescripts, using timing information."
    ]
  },
  "option": [
    {
      "name": "--cr-mode",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --cr-mode <type>"
      ],
      "tip": [
        "CR char mode.",
        "Possible values: auto, never, always"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--divisor",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --divisor <num>"
      ],
      "tip": [
        "Speed up or slow down execution with time divisor."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--log-in",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --log-in <file>"
      ],
      "tip": [
        "Script stdin log file."
      ],
      "next": []
    },
    {
      "name": "--log-io",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --log-io <file>"
      ],
      "tip": [
        "Script stdin and stdout log file."
      ],
      "next": []
    },
    {
      "name": "--log-out",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --log-out <file>"
      ],
      "tip": [
        "Script stdout log file (default)."
      ],
      "next": []
    },
    {
      "name": "--log-timing",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --log-timing <file>"
      ],
      "tip": [
        "Alias to -t."
      ],
      "next": []
    },
    {
      "name": "--maxdelay",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --maxdelay <num>"
      ],
      "tip": [
        "Wait at most this many seconds between updates."
      ],
      "next": []
    },
    {
      "name": "--stream",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --stream <name>"
      ],
      "tip": [
        "Stream type.",
        "Possible values: out, in, signal, info"
      ],
      "next": [
        {
          "name": "in"
        },
        {
          "name": "info"
        },
        {
          "name": "out"
        },
        {
          "name": "signal"
        }
      ]
    },
    {
      "name": "--summary",
      "tip": [
        "Display overview about recorded session and exit."
      ]
    },
    {
      "name": "--timing",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --timing <file>"
      ],
      "tip": [
        "Script timing log file."
      ],
      "next": []
    },
    {
      "name": "--typescript",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --typescript <file>"
      ],
      "tip": [
        "Deprecated alias to -O."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
