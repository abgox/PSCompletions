{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "使用计时信息回放终端 typescript。"
    ]
  },
  "option": [
    {
      "name": "--cr-mode",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --cr-mode <type>"
      ],
      "tip": [
        "CR 字符模式。",
        "可能值: auto, never, always"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--divisor",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --divisor <num>"
      ],
      "tip": [
        "使用时间除数加快或减慢执行。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--log-in",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --log-in <file>"
      ],
      "tip": [
        "script 标准输入日志文件。"
      ],
      "next": []
    },
    {
      "name": "--log-io",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --log-io <file>"
      ],
      "tip": [
        "script 标准输入和标准输出日志文件。"
      ],
      "next": []
    },
    {
      "name": "--log-out",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --log-out <file>"
      ],
      "tip": [
        "script 标准输出日志文件（默认）。"
      ],
      "next": []
    },
    {
      "name": "--log-timing",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --log-timing <file>"
      ],
      "tip": [
        "-t 的别名。"
      ],
      "next": []
    },
    {
      "name": "--maxdelay",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --maxdelay <num>"
      ],
      "tip": [
        "两次更新之间最多等待的秒数。"
      ],
      "next": []
    },
    {
      "name": "--stream",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --stream <name>"
      ],
      "tip": [
        "流类型。",
        "可能值: out, in, signal, info"
      ],
      "next": [
        {
          "name": "in"
        },
        {
          "name": "info"
        },
        {
          "name": "out"
        },
        {
          "name": "signal"
        }
      ]
    },
    {
      "name": "--summary",
      "tip": [
        "显示录制会话的概览后退出。"
      ]
    },
    {
      "name": "--timing",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --timing <file>"
      ],
      "tip": [
        "script 计时日志文件。"
      ],
      "next": []
    },
    {
      "name": "--typescript",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --typescript <file>"
      ],
      "tip": [
        "已弃用，是 -O 的别名。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
