{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "打印或校验 BSD（16 位）校验和。"
    ]
  },
  "option": [
    {
      "name": "--sysv",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sysv"
      ],
      "tip": [
        "使用 System V sum 算法，使用 512 字节块"
      ]
    },
    {
      "name": "-r",
      "tip": [
        "使用 BSD sum 算法（默认），使用 1K 块"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
