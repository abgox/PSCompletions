      ],
      "option": [
        {
          "name": "--interval",
          "usage": [
            "--interval <SECONDS>"
          ],
          "tip": [
            "设置以秒为单位的刷新间隔；默认值为 1。"
          ],
          "next": [
            {
              "name": "1",
              "tip": [
                "使用默认刷新间隔。"
              ]
            },
            {
              "name": "10"
            },
            {
              "name": "2"
            },
            {
              "name": "30"
            },
            {
              "name": "5"
            }
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
