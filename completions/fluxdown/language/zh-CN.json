              "tip": [
                "包含匹配的关键词；使用 | 表示或，使用空格表示且。"
              ],
              "next": []
            },
            {
              "name": "--interval",
              "usage": [
                "--interval <MINUTES>"
              ],
              "tip": [
                "设置以分钟为单位的抓取间隔；服务默认值为 30。"
              ],
              "next": [
                {
                  "name": "1440"
                },
                {
                  "name": "15"
                },
                {
                  "name": "30",
                  "tip": [
                    "使用服务默认抓取间隔。"
                  ]
                },
                {
                  "name": "5"
                },
                {
                  "name": "60"
                }
              ]
            },
            {
              "name": "--name",
              "usage": [
                "--name <NAME>"
              ],
              "tip": [
                "设置订阅名；省略时使用源标题。"
              ],
              "next": []
            },
            {
              "name": "--no-auto",
              "tip": [
                "仅收集源条目，不自动创建下载任务。"
              ]
            },
            {
              "name": "--queue",
              "usage": [
                "--queue <ID>"
              ],
              "tip": [
                "选择下载条目的队列；省略时使用默认队列。"
              ],
              "next": []
            }
          ]
        },
        {
          "name": "help",
          "usage": [
            "help [COMMAND]..."
          ],
          "tip": [
            "显示 RSS 命令的帮助。"
          ]
        },
        {
          "name": "items",
          "usage": [
            "items <ID>"
          ],
          "tip": [
            "列出 RSS 订阅收集的条目。"
          ]
        },
        {
          "name": "list",
          "alias": [
            "ls"
          ],
          "usage": [
            "ls|list"
          ],
          "tip": [
            "列出全部 RSS 订阅。"
          ]
        },
        {
          "name": "refresh",
          "usage": [
            "refresh <ID>"
          ],
          "tip": [
            "立即抓取 RSS 订阅。"
          ]
        },
        {
          "name": "rm",
          "usage": [
            "rm <ID>"
          ],
          "tip": [
            "删除 RSS 订阅及其已收集条目。"
          ]
        }
      ]
    },
    {
      "name": "status",
      "alias": [
        "stat"
      ],
      "usage": [
        "stat|status <ID>"
      ],
      "tip": [
        "显示单个任务的详情。"
      ]
    },
    {
      "name": "watch",
      "usage": [
        "watch [ID]"
      ],
      "tip": [
