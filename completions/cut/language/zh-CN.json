{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "输出每行中指定的字节或字段列。"
    ]
  },
  "option": [
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes <LIST>"
      ],
      "tip": [
        "从输入源中筛选字节列"
      ],
      "next": []
    },
    {
      "name": "--characters",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --characters <LIST>"
      ],
      "tip": [
        "字符模式的别名"
      ],
      "next": []
    },
    {
      "name": "--complement",
      "tip": [
        "反转筛选 - 显示除筛选列之外的所有列，而不是仅显示筛选的列"
      ]
    },
    {
      "name": "--delimiter",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delimiter <DELIM>"
      ],
      "tip": [
        "指定分隔输入源中字段的分隔符。",
        "默认为 Tab。"
      ],
      "next": []
    },
    {
      "name": "--fields",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fields <LIST>"
      ],
      "tip": [
        "从输入源中筛选字段列"
      ],
      "next": []
    },
    {
      "name": "--no-partial",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-partial"
      ],
      "tip": [
        "与 -b 一起使用时, 不输出不完整的多字节字符"
      ]
    },
    {
      "name": "--only-delimited",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --only-delimited"
      ],
      "tip": [
        "在字段模式下，仅输出包含分隔符的行"
      ]
    },
    {
      "name": "--output-delimiter",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --output-delimiter <NEW_DELIM>"
      ],
      "tip": [
        "在字段模式下，将输出行中的分隔符替换为此选项的参数"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "按 \\0（NULL 字符）而不是按行来筛选列"
      ]
    },
    {
      "name": "-w",
      "tip": [
        "使用任意数量的空白字符（空格、制表符）来分隔输入源中的字段（FreeBSD 扩展）。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
