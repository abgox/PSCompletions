    {
      "name": "--link-dest",
      "usage": [
        "--link-dest=DIR"
      ],
      "tip": [
        "hardlink to files in DIR when unchanged"
      ],
      "next": []
    },
    {
      "name": "--links",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --links"
      ],
      "tip": [
        "copy symlinks as symlinks"
      ]
    },
    {
      "name": "--list-only",
      "tip": [
        "list the files instead of copying them"
      ]
    },
    {
      "name": "--log-file",
      "usage": [
        "--log-file=FILE"
      ],
      "tip": [
        "log what we're doing to the specified FILE"
      ],
      "next": []
    },
    {
      "name": "--log-file-format",
      "usage": [
        "--log-file-format=FMT"
      ],
      "tip": [
        "log updates using the specified FMT"
      ],
      "next": []
    },
    {
      "name": "--max-alloc",
      "usage": [
        "--max-alloc=SIZE"
      ],
      "tip": [
        "change a limit relating to memory alloc"
      ],
      "next": [
        {
          "name": "1g"
        }
      ]
    },
    {
      "name": "--max-delete",
      "usage": [
        "--max-delete=NUM"
      ],
      "tip": [
        "don't delete more than NUM files"
