{
  "meta": {
    "url": "https://rsync.samba.org",
    "description": [
      "A fast, versatile, remote (and local) file-copying tool."
    ]
  },
  "option": [
    {
      "name": "--8-bit-output",
      "alias": [
        "-8"
      ],
      "usage": [
        "-8, --8-bit-output"
      ],
      "tip": [
        "leave high-bit chars unescaped in output"
      ]
    },
    {
      "name": "--acls",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --acls"
      ],
      "tip": [
        "preserve ACLs (implies --perms)"
      ]
    },
    {
      "name": "--address",
      "usage": [
        "--address=ADDRESS"
      ],
      "tip": [
        "bind address for outgoing socket to daemon"
      ],
      "next": []
    },
    {
      "name": "--append",
      "tip": [
        "append data onto shorter files"
      ]
    },
    {
      "name": "--append-verify",
      "tip": [
        "--append w/old data in file checksum"
      ]
    },
    {
      "name": "--archive",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --archive"
      ],
      "tip": [
        "archive mode is -rlptgoD (no -A,-X,-U,-N,-H)"
      ]
    },
    {
      "name": "--atimes",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --atimes"
      ],
      "tip": [
        "preserve access (use) times"
      ]
    },
    {
      "name": "--backup",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --backup"
      ],
      "tip": [
        "make backups (see --suffix & --backup-dir)"
      ]
    },
    {
      "name": "--backup-dir",
      "usage": [
        "--backup-dir=DIR"
      ],
      "tip": [
        "make backups into hierarchy based in DIR"
      ],
      "next": []
    },
    {
      "name": "--block-size",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --block-size=SIZE"
      ],
      "tip": [
        "force a fixed checksum block-size"
      ],
      "next": [
        {
          "name": "1m"
        }
      ]
    },
    {
      "name": "--blocking-io",
      "tip": [
        "use blocking I/O for the remote shell"
      ]
    },
    {
      "name": "--bwlimit",
      "usage": [
        "--bwlimit=RATE"
      ],
      "tip": [
        "limit socket I/O bandwidth"
      ],
      "next": [
        {
          "name": "1m"
        }
      ]
    },
    {
      "name": "--checksum",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --checksum"
      ],
      "tip": [
        "skip based on checksum, not mod-time & size"
      ]
    },
    {
      "name": "--checksum-choice",
      "alias": [
        "--cc"
      ],
      "usage": [
        "--cc, --checksum-choice=STR[,STR]"
      ],
      "tip": [
        "choose the checksum algorithm"
      ],
      "separator": ",",
      "next": [
        {
          "name": "auto"
        },
        {
          "name": "md4"
        },
        {
          "name": "md5"
        },
        {
          "name": "none"
        },
        {
          "name": "sha1"
        },
        {
          "name": "xxh128"
        },
        {
          "name": "xxh3"
        },
        {
          "name": "xxh64"
        }
      ]
    },
    {
      "name": "--checksum-seed",
      "usage": [
        "--checksum-seed=NUM"
      ],
      "tip": [
        "set block/file checksum seed (advanced)"
      ],
      "next": []
    },
    {
      "name": "--chmod",
      "usage": [
        "--chmod=CHMOD"
      ],
      "tip": [
        "affect file and/or directory permissions"
      ],
      "next": []
    },
    {
      "name": "--chown",
      "usage": [
        "--chown=USER:GROUP"
      ],
      "tip": [
        "simple username/groupname mapping"
      ],
      "next": []
    },
    {
      "name": "--compare-dest",
      "usage": [
        "--compare-dest=DIR"
      ],
      "tip": [
        "also compare destination files relative to DIR"
      ],
      "next": []
    },
    {
      "name": "--compress",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --compress"
      ],
      "tip": [
        "compress file data during the transfer"
      ]
    },
    {
      "name": "--compress-choice",
      "alias": [
        "--zc"
      ],
      "usage": [
        "--zc, --compress-choice=STR"
      ],
      "tip": [
        "choose the compression algorithm"
      ],
      "next": [
        {
          "name": "lz4"
        },
        {
          "name": "none"
        },
        {
          "name": "zlib"
        },
        {
          "name": "zlibx"
        },
        {
          "name": "zstd"
        }
      ]
    },
    {
      "name": "--compress-level",
      "alias": [
        "--zl"
      ],
      "usage": [
        "--zl, --compress-level=NUM"
      ],
      "tip": [
        "explicitly set compression level"
      ],
      "next": []
    },
    {
      "name": "--compress-threads",
      "alias": [
        "--zt"
      ],
      "usage": [
        "--zt, --compress-threads=NUM"
      ],
      "tip": [
        "explicitly set compression threads"
      ],
      "next": []
    },
    {
      "name": "--config",
      "usage": [
        "--config=FILE"
      ],
      "tip": [
        "specify alternate rsyncd.conf file (daemon mode only)"
      ],
      "next": []
    },
    {
      "name": "--confine-root",
      "usage": [
        "--confine-root=DIR"
      ],
      "tip": [
        "refuse operator paths resolving outside DIR"
      ],
      "next": []
    },
    {
      "name": "--contimeout",
      "usage": [
        "--contimeout=SECONDS"
      ],
      "tip": [
        "set daemon connection timeout in seconds"
      ],
      "next": []
    },
    {
      "name": "--copy-as",
      "usage": [
        "--copy-as=USER[:GROUP]"
      ],
      "tip": [
        "specify user & optional group for the copy"
      ],
      "next": []
    },
    {
      "name": "--copy-dest",
      "usage": [
        "--copy-dest=DIR"
      ],
      "tip": [
        "... and include copies of unchanged files"
      ],
      "next": []
    },
    {
      "name": "--copy-devices",
      "tip": [
        "copy device contents as a regular file"
      ]
    },
    {
      "name": "--copy-dirlinks",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --copy-dirlinks"
      ],
      "tip": [
        "transform symlink to directory into referent directory"
      ]
    },
    {
      "name": "--copy-links",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --copy-links"
      ],
      "tip": [
        "transform symlink into referent file/directory"
      ]
    },
    {
      "name": "--copy-unsafe-links",
      "tip": [
        "only \"unsafe\" symlinks are transformed"
      ]
    },
    {
      "name": "--crtimes",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --crtimes"
      ],
      "tip": [
        "preserve create times (newness)"
      ]
    },
    {
      "name": "--cvs-exclude",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --cvs-exclude"
      ],
      "tip": [
        "auto-ignore files in the same way CVS does"
      ]
    },
    {
      "name": "--daemon",
      "tip": [
        "run as an rsync daemon",
        "the daemon-specific options apply only in this mode"
      ]
    },
    {
      "name": "--debug",
      "usage": [
        "--debug=FLAGS[,FLAGS]"
      ],
      "tip": [
        "fine-grained debug verbosity",
        "--debug=help prints every flag and its meaning"
      ],
      "separator": ",",
      "next": [
        {
          "name": "acl",
          "tip": [
            "Debug extra ACL info"
          ]
        },
        {
          "name": "all",
          "tip": [
            "Set all --debug options (e.g. all4)"
          ]
        },
        {
          "name": "backup",
          "tip": [
            "Debug backup actions (levels 1-2)"
          ]
        },
        {
          "name": "bind",
          "tip": [
            "Debug socket bind actions"
          ]
        },
        {
          "name": "chdir",
          "tip": [
            "Debug when the current directory changes"
          ]
        },
        {
          "name": "cmd",
          "tip": [
            "Debug commands+options that are issued (levels 1-2)"
          ]
        },
        {
          "name": "connect",
          "tip": [
            "Debug connection events (levels 1-2)"
          ]
        },
        {
          "name": "del",
          "tip": [
            "Debug delete actions (levels 1-3)"
          ]
        },
        {
          "name": "deltasum",
          "tip": [
            "Debug delta-transfer checksumming (levels 1-4)"
          ]
        },
        {
          "name": "dup",
          "tip": [
            "Debug weeding of duplicate names"
          ]
        },
        {
          "name": "exit",
          "tip": [
            "Debug exit events (levels 1-3)"
          ]
        },
        {
          "name": "filter",
          "tip": [
            "Debug filter actions (levels 1-3)"
          ]
        },
        {
          "name": "flist",
          "tip": [
            "Debug file-list operations (levels 1-4)"
          ]
        },
        {
          "name": "fuzzy",
          "tip": [
            "Debug fuzzy scoring (levels 1-2)"
          ]
        },
        {
          "name": "genr",
          "tip": [
            "Debug generator functions"
          ]
        },
        {
          "name": "hash",
          "tip": [
            "Debug hashtable code"
          ]
        },
        {
          "name": "help",
          "tip": [
            "Output this help message"
          ]
        },
        {
          "name": "hlink",
          "tip": [
            "Debug hard-link actions (levels 1-3)"
          ]
        },
        {
          "name": "iconv",
          "tip": [
            "Debug iconv character conversions (levels 1-2)"
          ]
        },
        {
          "name": "io",
          "tip": [
            "Debug I/O routines (levels 1-4)"
          ]
        },
        {
          "name": "none",
          "tip": [
            "Silence all --debug options (same as all0)"
          ]
        },
        {
          "name": "nstr",
          "tip": [
            "Debug negotiation strings"
          ]
        },
        {
          "name": "own",
          "tip": [
            "Debug ownership changes in users & groups (levels 1-2)"
          ]
        },
        {
          "name": "proto",
          "tip": [
            "Debug protocol information"
          ]
        },
        {
          "name": "recv",
          "tip": [
            "Debug receiver functions"
          ]
        },
        {
          "name": "send",
          "tip": [
            "Debug sender functions"
          ]
        },
        {
          "name": "time",
          "tip": [
            "Debug setting of modified times (levels 1-2)"
          ]
        }
      ]
    },
    {
      "name": "--delay-updates",
      "tip": [
        "put all updated files into place at end"
      ]
    },
    {
      "name": "--delete",
      "tip": [
        "delete extraneous files from dest directories"
      ]
    },
    {
      "name": "--delete-after",
      "tip": [
        "receiver deletes after transfer, not during"
      ]
    },
    {
      "name": "--delete-before",
      "tip": [
        "receiver deletes before xfer, not during"
      ]
    },
    {
      "name": "--delete-delay",
      "tip": [
        "find deletions during, delete after"
      ]
    },
    {
      "name": "--delete-during",
      "alias": [
        "--del"
      ],
      "usage": [
        "--del, --delete-during"
      ],
      "tip": [
        "receiver deletes during the transfer"
      ]
    },
    {
      "name": "--delete-excluded",
      "tip": [
        "also delete excluded files from dest directories"
      ]
    },
    {
      "name": "--delete-missing-args",
      "tip": [
        "delete missing source arguments from destination"
      ]
    },
    {
      "name": "--devices",
      "tip": [
        "preserve device files (super-user only)"
      ]
    },
    {
      "name": "--dirs",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --dirs"
      ],
      "tip": [
        "transfer directories without recursing"
      ]
    },
    {
      "name": "--dparam",
      "usage": [
        "--dparam=OVERRIDE"
      ],
      "tip": [
        "override a global daemon config parameter (daemon mode only)",
        "-M means this in daemon mode and --remote-option in client mode"
      ],
      "next": []
    },
    {
      "name": "--drop-D",
      "tip": [
        "receiver refuses to create devices/specials"
      ]
    },
    {
      "name": "--dry-run",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --dry-run"
      ],
      "tip": [
        "perform a trial run with no changes made"
      ]
    },
    {
      "name": "--early-input",
      "usage": [
        "--early-input=FILE"
      ],
      "tip": [
        "use FILE for daemon's early exec input"
      ],
      "next": []
    },
    {
      "name": "--exclude",
      "usage": [
        "--exclude=PATTERN"
      ],
      "tip": [
        "exclude files matching PATTERN"
      ],
      "next": []
    },
    {
      "name": "--exclude-from",
      "usage": [
        "--exclude-from=FILE"
      ],
      "tip": [
        "read exclude patterns from FILE"
      ],
      "next": []
    },
    {
      "name": "--executability",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --executability"
      ],
      "tip": [
        "preserve executability"
      ]
    },
    {
      "name": "--existing",
      "tip": [
        "skip creating new files on receiver"
      ]
    },
    {
      "name": "--fake-super",
      "tip": [
        "store/recover privileged attrs using xattrs"
      ]
    },
    {
      "name": "--files-from",
      "usage": [
        "--files-from=FILE"
      ],
      "tip": [
        "read list of source-file names from FILE"
      ],
      "next": []
    },
    {
      "name": "--filter",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --filter=RULE"
      ],
      "tip": [
        "add a file-filtering RULE"
      ],
      "next": []
    },
    {
      "name": "--force",
      "tip": [
        "force deletion of directories even if not empty"
      ]
    },
    {
      "name": "--from0",
      "alias": [
        "-0"
      ],
      "usage": [
        "-0, --from0"
      ],
      "tip": [
        "all *-from/filter files are delimited by 0s"
      ]
    },
    {
      "name": "--fsync",
      "tip": [
        "fsync every written file"
      ]
    },
    {
      "name": "--fuzzy",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --fuzzy"
      ],
      "tip": [
        "find similar file for basis if no dest file"
      ]
    },
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group"
      ],
      "tip": [
        "preserve group"
      ]
    },
    {
      "name": "--groupmap",
      "usage": [
        "--groupmap=STRING"
      ],
      "tip": [
        "custom groupname mapping"
      ],
      "next": []
    },
    {
      "name": "--hard-links",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --hard-links"
      ],
      "tip": [
        "preserve hard links"
      ]
    },
    {
      "name": "--human-readable",
      "tip": [
        "output numbers in a human-readable format",
        "-h also selects this option when it appears with other options"
      ]
    },
    {
      "name": "--iconv",
      "usage": [
        "--iconv=CONVERT_SPEC"
      ],
      "tip": [
        "request charset conversion of filenames"
      ],
      "next": []
    },
    {
      "name": "--ignore-errors",
      "tip": [
        "delete even if there are I/O errors"
      ]
    },
    {
      "name": "--ignore-existing",
      "tip": [
        "skip updating files that exist on receiver"
      ]
    },
    {
      "name": "--ignore-missing-args",
      "tip": [
        "ignore missing source arguments without error"
      ]
    },
    {
      "name": "--ignore-non-existing",
      "tip": [
        "skip creating new files on receiver"
      ]
    },
    {
      "name": "--ignore-times",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --ignore-times"
      ],
      "tip": [
        "don't skip files that match size and time"
      ]
    },
    {
      "name": "--inc-recursive",
      "alias": [
        "--i-r"
      ],
      "usage": [
        "--i-r, --inc-recursive"
      ],
      "tip": [
        "enable incremental recursion"
      ]
    },
    {
      "name": "--include",
      "usage": [
        "--include=PATTERN"
      ],
      "tip": [
        "don't exclude files matching PATTERN"
      ],
      "next": []
    },
    {
      "name": "--include-from",
      "usage": [
        "--include-from=FILE"
      ],
      "tip": [
        "read include patterns from FILE"
      ],
      "next": []
    },
    {
      "name": "--info",
      "usage": [
        "--info=FLAGS[,FLAGS]"
      ],
      "tip": [
        "fine-grained informational verbosity",
        "--info=help prints every flag and its meaning"
      ],
      "separator": ",",
      "next": [
        {
          "name": "all",
          "tip": [
            "Set all --info options (e.g. all4)"
          ]
        },
        {
          "name": "backup",
          "tip": [
            "Mention files backed up"
          ]
        },
        {
          "name": "copy",
          "tip": [
            "Mention files copied locally on the receiving side"
          ]
        },
        {
          "name": "del",
          "tip": [
            "Mention deletions on the receiving side"
          ]
        },
        {
          "name": "flist",
          "tip": [
            "Mention file-list receiving/sending (levels 1-2)"
          ]
        },
        {
          "name": "help",
          "tip": [
            "Output this help message"
          ]
        },
        {
          "name": "misc",
          "tip": [
            "Mention miscellaneous information (levels 1-2)"
          ]
        },
        {
          "name": "mount",
          "tip": [
            "Mention mounts that were found or skipped"
          ]
        },
        {
          "name": "name",
          "tip": [
            "Mention 1) updated file/dir names, 2) unchanged names"
          ]
        },
        {
          "name": "none",
          "tip": [
            "Silence all --info options (same as all0)"
          ]
        },
        {
          "name": "nonreg",
          "tip": [
            "Mention skipped non-regular files (default 1, 0 disables)"
          ]
        },
        {
          "name": "progress",
          "tip": [
            "Mention 1) per-file progress or 2) total transfer progress"
          ]
        },
        {
          "name": "remove",
          "tip": [
            "Mention files removed on the sending side"
          ]
        },
        {
          "name": "skip",
          "tip": [
            "Mention files skipped due to transfer overrides (levels 1-2)"
          ]
        },
        {
          "name": "stats",
          "tip": [
            "Mention statistics at end of run (levels 1-3)"
          ]
        },
        {
          "name": "symsafe",
          "tip": [
            "Mention symlinks that are unsafe"
          ]
        }
      ]
    },
    {
      "name": "--inplace",
      "tip": [
        "update destination files in-place"
      ]
    },
    {
      "name": "--insecure-links",
      "tip": [
        "follow attacker-owned symlinks in operator paths"
      ]
    },
    {
      "name": "--ipv4",
      "alias": [
        "-4"
      ],
      "usage": [
        "-4, --ipv4"
      ],
      "tip": [
        "prefer IPv4"
      ]
    },
    {
      "name": "--ipv6",
      "alias": [
        "-6"
      ],
      "usage": [
        "-6, --ipv6"
      ],
      "tip": [
        "prefer IPv6"
      ]
    },
    {
      "name": "--itemize-changes",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --itemize-changes"
      ],
      "tip": [
        "output a change-summary for all updates"
