{
  "meta": {
    "url": "https://github.com/charmbracelet/vhs",
    "description": [
      "你的 CLI 家庭录像机",
      "从 Shell 脚本录制终端 GIF"
    ]
  },
  "next": [
    {
      "name": "new",
      "usage": [
        "new <NAME>"
      ],
      "tip": [
        "创建一个新的 tape 文件，包含示例内容和文档"
      ]
    },
    {
      "name": "publish",
      "usage": [
        "publish <GIF>"
      ],
      "tip": [
        "将 GIF 发布到 vhs.charm.sh 并获取可分享的 URL"
      ]
    },
    {
      "name": "record",
      "usage": [
        "record [OPTIONS]"
      ],
      "tip": [
        "通过录制你的操作创建新的 tape 文件"
      ],
      "option": [
        {
          "name": "--shell",
          "alias": [
            "-s"
          ],
          "usage": [
            "-s, --shell <SHELL>"
          ],
          "tip": [
            "用于录制的 Shell"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "serve",
      "tip": [
        "启动 VHS SSH 服务器"
      ]
    },
    {
      "name": "themes",
      "tip": [
        "列出所有可用的主题，每行一个"
      ]
    },
    {
      "name": "validate",
      "usage": [
        "validate <FILE>..."
      ],
      "tip": [
        "验证 glob 文件路径并解析所有文件以确保有效，但不运行"
      ]
    }
  ],
  "option": [
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <FILE>"
      ],
      "tip": [
        "视频输出的文件名"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--publish",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --publish"
      ],
      "tip": [
        "将 GIF 发布到 vhs.charm.sh 并获取可分享的 URL"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "静默模式，不输出日志消息"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助"
      ]
    }
  ]
}
