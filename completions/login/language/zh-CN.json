{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "在系统上开始一个会话。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "-f",
      "tip": [
        "跳过登录认证。"
      ]
    },
    {
      "name": "-h",
      "usage": [
        "-h <host>"
      ],
      "tip": [
        "用于 utmp 记录的主机名。"
      ],
      "next": []
    },
    {
      "name": "-H",
      "tip": [
        "在登录提示中抑制主机名。"
      ]
    },
    {
      "name": "-p",
      "tip": [
        "不销毁环境。"
      ]
    }
  ]
}
