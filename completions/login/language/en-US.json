{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Begin a session on the system."
    ]
  },
  "option": [
    {
      "name": "--help",
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "-f",
      "tip": [
        "Skip a login authentication."
      ]
    },
    {
      "name": "-h",
      "usage": [
        "-h <host>"
      ],
      "tip": [
        "Hostname to be used for utmp logging."
      ],
      "next": []
    },
    {
      "name": "-H",
      "tip": [
        "Suppress hostname in the login prompt."
      ]
    },
    {
      "name": "-p",
      "tip": [
        "Do not destroy the environment."
      ]
    }
  ]
}
