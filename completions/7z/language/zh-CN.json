{
  "meta": {
    "url": "https://7-zip.org/",
    "description": [
      "7-Zip 的命令行界面。"
    ]
  },
  "next": [
    {
      "name": "a",
      "tip": [
        "将文件添加到归档。"
      ],
      "example": [
        {
          "cmd": "a demo.zip demo\\",
          "desc": "将 demo 目录下的所有文件添加到 demo.zip 中"
        }
      ]
    },
    {
      "name": "b",
      "tip": [
        "测试压缩或解压算法执行时的 CPU 占用。"
      ]
    },
    {
      "name": "d",
      "tip": [
        "从归档中删除文件。"
      ],
      "example": [
        {
          "cmd": "d demo.zip *.bak -r",
          "desc": "删除 demo.zip 中所有扩展名为 bak 的文件"
        }
      ]
    },
    {
      "name": "e",
      "tip": [
        "将归档中的所有文件解压到指定路径。",
        "相比于 x, 所有文件将输出到同一个目录中。"
      ]
    },
    {
      "name": "h",
      "tip": [
        "计算文件的哈希值。"
      ]
    },
    {
      "name": "i",
      "tip": [
        "显示有关支持格式的信息。"
      ]
    },
    {
      "name": "l",
      "tip": [
        "列出归档的内容。"
      ]
    },
    {
      "name": "rn",
      "tip": [
        "重命名归档中的文件。"
      ]
    },
    {
      "name": "t",
      "tip": [
        "测试归档的完整性。"
      ]
    },
    {
      "name": "u",
      "tip": [
        "更新文件以归档。"
      ]
    },
    {
      "name": "x",
      "tip": [
        "提取文件。",
        "需要指定提取文件的完整路径。"
      ],
      "example": [
        "x D:\\demo.7z -oD:\\demo"
      ]
    }
  ],
  "option": [
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示当前版本。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--",
      "tip": [
        "停止开关和 @listfile 解析。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "-ai",
      "tip": [
        "包括归档。"
      ],
      "example": [
        {
          "cmd": "-ai!file1.txt",
          "desc": "包含 file1.txt"
        },
        {
          "cmd": "-air!file1.txt",
          "desc": "包含 file1.txt(包括子目录)"
        },
        {
          "cmd": "-ai!*.txt",
          "desc": "包含所有扩展名为 txt 的文件"
        }
      ]
    },
    {
      "name": "-an",
      "tip": [
        "禁用 archive_name 字段。"
      ]
    },
    {
      "name": "-ao",
      "tip": [
        "设置覆盖模式。"
      ],
      "example": [
        {
          "cmd": "-aoa",
          "desc": "直接覆盖现有文件，而没有任何提示"
        },
        {
          "cmd": "-aos",
          "desc": "跳过现有文件，其不会被覆盖"
        },
        {
          "cmd": "-aot",
          "desc": "如果相同文件名的文件以存在，将自动重命名现有的文件"
        },
        {
          "cmd": "-aou",
          "desc": "如果相同文件名的文件以存在，将自动重命名被释放的文件"
        }
      ]
    },
    {
      "name": "-ax",
      "tip": [
        "指定必须从操作中排除的归档。"
      ],
      "example": [
        {
          "cmd": "-ax!a*.7z",
          "desc": "排除所有扩展名为 7z 的归档"
        }
      ]
    },
    {
      "name": "-bb",
      "usage": [
        "-bb[0|1|2|3]"
      ],
      "tip": [
        "设置输出日志级别。"
      ]
    },
    {
      "name": "-bd",
      "tip": [
        "禁用进度指示器。"
      ]
    },
    {
      "name": "-bs",
      "usage": [
        "-bs[o|e|p]"
      ],
      "tip": [
        "设置 output/error/progress 输出流。"
      ]
    },
    {
      "name": "-bt",
      "tip": [
        "显示执行时间统计信息。"
      ]
    },
    {
      "name": "-i",
      "tip": [
        "包含文件名。"
      ],
      "example": [
        {
          "cmd": "-i!*.txt",
          "desc": "包含所有扩展名为 txt 的文件"
        }
      ]
    },
    {
      "name": "-m",
      "tip": [
        "设置压缩方法。"
      ]
    },
    {
      "name": "-mmt",
      "tip": [
        "设置 CPU 线程数。"
      ]
    },
    {
      "name": "-mx",
      "tip": [
        "设置压缩级别。"
      ]
    },
    {
      "name": "-o",
      "usage": [
        "-oD:\\demo"
      ],
      "tip": [
        "设置输出目录。"
      ]
    },
    {
      "name": "-p",
      "tip": [
        "设置密码。"
      ],
      "example": [
        {
          "cmd": "-p123456",
          "desc": "设置密码为 123456"
        }
      ]
    },
    {
      "name": "-r",
      "tip": [
        "递归子目录(e/l/t/x，默认开启)。"
      ],
      "example": [
        {
          "cmd": "-r-",
          "desc": "关闭递归子目录(a/d/u 等需要扫描磁盘文件的命令，默认使用它)"
        },
        {
          "cmd": "-r0",
          "desc": "开启递归子目录。但只应用于通配符。"
        }
      ]
    },
    {
      "name": "-sa",
      "usage": [
        "-sa[a|e|s]"
      ],
      "tip": [
        "设置归档名称模式。"
      ]
    },
    {
      "name": "-scc",
      "usage": [
        "-scc[UTF-8|WIN|DOS]"
      ],
      "tip": [
        "设置控制台输入/输出字符集。"
      ]
    },
    {
      "name": "-scrc",
      "tip": [
        "为 x、e、h 命令设置哈希函数。"
      ]
    },
    {
      "name": "-scs",
      "usage": [
        "-scs[UTF-8|UTF-16LE|UTF-16BE|WIN|DOS] <value>"
      ],
      "tip": [
        "设置列表文件字符集。"
      ],
      "next": []
    },
    {
      "name": "-sdel",
      "tip": [
        "压缩后删除文件。"
      ]
    },
    {
      "name": "-seml",
      "tip": [
        "通过电子邮件发送归档。"
      ]
    },
    {
      "name": "-sfx",
      "tip": [
        "创建 SFX 归档。"
      ]
    },
    {
      "name": "-si",
      "tip": [
        "从标准输入读取数据。"
      ]
    },
    {
      "name": "-slp",
      "tip": [
        "设置大页面模式。"
      ]
    },
    {
      "name": "-slt",
      "tip": [
        "显示 l(列表)命令的技术信息。"
      ]
    },
    {
      "name": "-snh",
      "tip": [
        "将硬链接存储为链接。"
      ]
    },
    {
      "name": "-sni",
      "tip": [
        "存储 NT 安全信息。"
      ]
    },
    {
      "name": "-snl",
      "tip": [
        "将符号链接存储为链接。"
      ]
    },
    {
      "name": "-sns",
      "tip": [
        "存储 NTFS 备用流。"
      ]
    },
    {
      "name": "-so",
      "tip": [
        "将数据写入标准输出。"
      ]
    },
    {
      "name": "-spd",
      "tip": [
        "禁用文件名的通配符匹配。"
      ]
    },
    {
      "name": "-spe",
      "tip": [
        "消除提取命令的根文件夹重复。"
      ]
    },
    {
      "name": "-spf",
      "tip": [
        "使用完全限定的文件路径。"
      ]
    },
    {
      "name": "-ssc",
      "tip": [
        "设置区分大小写模式。"
      ]
    },
    {
      "name": "-sse",
      "tip": [
        "如果无法打开某些输入文件，则停止创建归档。"
      ]
    },
    {
      "name": "-ssp",
      "tip": [
        "归档时不更改源文件的最后访问时间。"
      ]
    },
    {
      "name": "-ssw",
      "tip": [
        "压缩共享文件。"
      ]
    },
    {
      "name": "-stl",
      "tip": [
        "从最近修改的文件设置归档时间戳。"
      ]
    },
    {
      "name": "-stm",
      "tip": [
        "设置 CPU 线程关联掩码(十六进制数)。"
      ]
    },
    {
      "name": "-stx",
      "tip": [
        "排除归档类型。"
      ]
    },
    {
      "name": "-t",
      "usage": [
        "-t[7z|bzip2|gzip|swfc|tar|wim|xz|zip...]"
      ],
      "tip": [
        "设置归档类型。"
      ],
      "example": [
        {
          "cmd": "-tzip",
          "desc": "设置归档类型为 zip"
        }
      ]
    },
    {
      "name": "-u",
      "usage": [
        "-u<[-][p#][q#][r#][x#][y#][z#][!newArchiveName]>"
      ],
      "tip": [
        "更新选项。"
      ],
      "next": []
    },
    {
      "name": "-v",
      "tip": [
        "创建卷。"
      ],
      "example": [
        {
          "cmd": "-v10m",
          "desc": "创建 10MB 的卷"
        },
        {
          "cmd": "-v10k -v15k",
          "desc": "创建 10KB 和 15KB 的卷"
        }
      ]
    },
    {
      "name": "-w",
      "tip": [
        "分配工作目录。"
      ],
      "example": [
        {
          "cmd": "-wD:\\temp",
          "desc": "设置工作目录为 D:\\temp"
        }
      ]
    },
    {
      "name": "-x",
      "tip": [
        "排除文件名。"
      ],
      "example": [
        {
          "cmd": "-x!*.txt",
          "desc": "排除所有扩展名为 txt 的文件"
        }
      ]
    },
    {
      "name": "-y",
      "tip": [
        "假定所有查询都为 Yes。"
      ]
    }
  ]
}
