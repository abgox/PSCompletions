{
  "meta": {
    "url": "https://7-zip.org/",
    "description": [
      "The command line interface of 7-Zip."
    ]
  },
  "next": [
    {
      "name": "a",
      "tip": [
        "Add files to archive"
      ],
      "example": [
        {
          "cmd": "a demo.zip demo\\",
          "desc": "Add all files under the demo directory to demo.zip"
        }
      ]
    },
    {
      "name": "b",
      "tip": [
        "Benchmark",
        "Test the CPU usage during the execution of compression or decompression algorithms"
      ]
    },
    {
      "name": "d",
      "tip": [
        "Delete files from archive"
      ],
      "example": [
        {
          "cmd": "d demo.zip *.bak -r",
          "desc": "Delete all .bak files from demo.zip"
        }
      ]
    },
    {
      "name": "e",
      "tip": [
        "Extract files from archive (without using directory names)"
      ]
    },
    {
      "name": "h",
      "tip": [
        "Calculate hash values for files"
      ]
    },
    {
      "name": "i",
      "tip": [
        "Show information about supported formats"
      ]
    },
    {
      "name": "l",
      "tip": [
        "List contents of archive"
      ]
    },
    {
      "name": "rn",
      "tip": [
        "Rename files in archive"
      ]
    },
    {
      "name": "t",
      "tip": [
        "Test integrity of archive"
      ]
    },
    {
      "name": "u",
      "tip": [
        "Update files to archive"
      ]
    },
    {
      "name": "x",
      "tip": [
        "extract files with full paths"
      ],
      "example": [
        "x D:\\demo.7z -oD:\\demo"
      ]
    }
  ],
  "option": [
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Show the version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--",
      "tip": [
        "Stop switches and @listfile parsing"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show the help."
      ]
    },
    {
      "name": "-ai",
      "tip": [
        "Include archives"
      ],
      "example": [
        {
          "cmd": "-ai!file1.txt",
          "desc": "Include file1.txt"
        },
        {
          "cmd": "-air!file1.txt",
          "desc": "Include file1.txt(Include subdirectory)"
        },
        {
          "cmd": "-ai!*.txt",
          "desc": "Include all txt files"
        }
      ]
    },
    {
      "name": "-an",
      "tip": [
        "disable archive_name field"
      ]
    },
    {
      "name": "-ao",
      "tip": [
        "set Overwrite mode"
      ],
      "example": [
        {
          "cmd": "-aoa",
          "desc": "Overwrite existing files without any prompting"
        },
        {
          "cmd": "-aos",
          "desc": "Skip existing files, they will not be overwritten"
        },
        {
          "cmd": "-aot",
          "desc": "If a file with the same name exists, the existing file is automatically renamed"
        },
        {
          "cmd": "-aou",
          "desc": "If a file with the same name already exists, the released file is automatically renamed"
        }
      ]
    },
    {
      "name": "-ax",
      "tip": [
        "exclude archives"
      ],
      "example": [
        {
          "cmd": "-ax!a*.7z",
          "desc": "Exclude all archives with 7z extension"
        }
      ]
    },
    {
      "name": "-bb",
      "usage": [
        "-bb[0|1|2|3]"
      ],
      "tip": [
        "set output log level"
      ]
    },
    {
      "name": "-bd",
      "tip": [
        "disable progress indicator"
      ]
    },
    {
      "name": "-bs",
      "usage": [
        "-bs[o|e|p]"
      ],
      "tip": [
        "set output stream for output/error/progress line"
      ]
    },
    {
      "name": "-bt",
      "tip": [
        "show execution time statistics"
      ]
    },
    {
      "name": "-i",
      "tip": [
        "Include filenames"
      ],
      "example": [
        {
          "cmd": "-i!*.txt",
          "desc": "Include all txt files"
        }
      ]
    },
    {
      "name": "-m",
      "tip": [
        "set compression Method"
      ]
    },
    {
      "name": "-mmt",
      "tip": [
        "set number of CPU threads"
      ]
    },
    {
      "name": "-mx",
      "tip": [
        "set compression level"
      ]
    },
    {
      "name": "-o",
      "usage": [
        "-oD:\\demo"
      ],
      "tip": [
        "set Output directory"
      ]
    },
    {
      "name": "-p",
      "tip": [
        "set Password"
      ],
      "example": [
        {
          "cmd": "-p123456",
          "desc": "Set password to 123456"
        }
      ]
    },
    {
      "name": "-r",
      "tip": [
        "Recurse subdirectories"
      ],
      "example": [
        {
          "cmd": "-r-",
          "desc": "Disable"
        },
        {
          "cmd": "-r0",
          "desc": "Enable"
        }
      ]
    },
    {
      "name": "-sa",
      "usage": [
        "-sa[a|e|s]"
      ],
      "tip": [
        "set Archive name mode"
      ]
    },
    {
      "name": "-scc",
      "usage": [
        "-scc[UTF-8|WIN|DOS]"
      ],
      "tip": [
        "set charset for for console input/output"
      ]
    },
    {
      "name": "-scrc",
      "tip": [
        "set hash function for x, e, h commands"
      ]
    },
    {
      "name": "-scs",
      "usage": [
        "-scs[UTF-8|UTF-16LE|UTF-16BE|WIN|DOS] <value>"
      ],
      "tip": [
        "set charset for list files"
      ],
      "next": []
    },
    {
      "name": "-sdel",
      "tip": [
        "delete files after compression"
      ]
    },
    {
      "name": "-seml",
      "tip": [
        "send archive by email"
      ]
    },
    {
      "name": "-sfx",
      "tip": [
        "Create SFX archive"
      ]
    },
    {
      "name": "-si",
      "tip": [
        "read data from stdin"
      ]
    },
    {
      "name": "-slp",
      "tip": [
        "set Large Pages mode"
      ]
    },
    {
      "name": "-slt",
      "tip": [
        "show technical information for l (List) command"
      ]
    },
    {
      "name": "-snh",
      "tip": [
        "store hard links as links"
      ]
    },
    {
      "name": "-sni",
      "tip": [
        "store NT security information"
      ]
    },
    {
      "name": "-snl",
      "tip": [
        "store symbolic links as links"
      ]
    },
    {
      "name": "-sns",
      "tip": [
        "store NTFS alternate streams"
      ]
    },
    {
      "name": "-so",
      "tip": [
        "write data to stdout"
      ]
    },
    {
      "name": "-spd",
      "tip": [
        "disable wildcard matching for file names"
      ]
    },
    {
      "name": "-spe",
      "tip": [
        "eliminate duplication of root folder for extract command"
      ]
    },
    {
      "name": "-spf",
      "tip": [
        "use fully qualified file paths"
      ]
    },
    {
      "name": "-ssc",
      "tip": [
        "set sensitive case mode"
      ]
    },
    {
      "name": "-sse",
      "tip": [
        "stop archive creating, if it can't open some input file"
      ]
    },
    {
      "name": "-ssp",
      "tip": [
        "do not change Last Access Time of source files while archiving"
      ]
    },
    {
      "name": "-ssw",
      "tip": [
        "compress shared files"
      ]
    },
    {
      "name": "-stl",
      "tip": [
        "set archive timestamp from the most recently modified file"
      ]
    },
    {
      "name": "-stm",
      "tip": [
        "set CPU thread affinity mask (hexadecimal number)"
      ]
    },
    {
      "name": "-stx",
      "tip": [
        "exclude archive type"
      ]
    },
    {
      "name": "-t",
      "usage": [
        "-t[7z|bzip2|gzip|swfc|tar|wim|xz|zip...]"
      ],
      "tip": [
        "Set type of archive"
      ],
      "example": [
        {
          "cmd": "-tzip",
          "desc": "Create zip archive"
        }
      ]
    },
    {
      "name": "-u",
      "usage": [
        "-u<[-][p#][q#][r#][x#][y#][z#][!newArchiveName]>"
      ],
      "tip": [
        "Update options"
      ],
      "next": []
    },
    {
      "name": "-v",
      "tip": [
        "Create volumes"
      ],
      "example": [
        {
          "cmd": "-v10m",
          "desc": "Create a volume of 10MB"
        },
        {
          "cmd": "-v10k -v15k",
          "desc": "Create two volumes of 10KB and 15KB"
        }
      ]
    },
    {
      "name": "-w",
      "tip": [
        "assign Work directory"
      ],
      "example": [
        {
          "cmd": "-wD:\\temp",
          "desc": "Set working directory to D:\\temp"
        }
      ]
    },
    {
      "name": "-x",
      "tip": [
        "exclude filenames"
      ],
      "example": [
        {
          "cmd": "-x!*.txt",
          "desc": "Exclude all txt files"
        }
      ]
    },
    {
      "name": "-y",
      "tip": [
        "assume Yes on all queries"
      ]
    }
  ]
}
