{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Attach a line discipline to a serial line."
    ]
  },
  "option": [
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "Print verbose messages to stderr."
      ]
    },
    {
      "name": "--eightbits",
      "alias": [
        "-8"
      ],
      "usage": [
        "-8, --eightbits"
      ],
      "tip": [
        "Set character size to 8 bits."
      ]
    },
    {
      "name": "--evenparity",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --evenparity"
      ],
      "tip": [
        "Set parity to even."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--iflag",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --iflag [-]<iflag>"
      ],
      "tip": [
        "Set input mode flag."
      ],
      "next": [
        {
          "name": "BRKINT"
        },
        {
          "name": "ICRNL"
        },
        {
          "name": "IGNBRK"
        },
        {
          "name": "IGNCR"
        },
        {
          "name": "IGNPAR"
        },
        {
          "name": "IMAXBEL"
        },
        {
          "name": "INLCR"
        },
        {
          "name": "INPCK"
        },
        {
          "name": "ISTRIP"
        },
        {
          "name": "IUCLC"
        },
        {
          "name": "IUTF8"
        },
        {
          "name": "IXANY"
        },
        {
          "name": "IXOFF"
        },
        {
          "name": "IXON"
        },
        {
          "name": "PARMRK"
        }
      ]
    },
    {
      "name": "--intro-command",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --intro-command <string>"
      ],
      "tip": [
        "Intro sent before ldattach."
      ],
      "next": []
    },
    {
      "name": "--noparity",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noparity"
      ],
      "tip": [
        "Set parity to none."
      ]
    },
    {
      "name": "--oddparity",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --oddparity"
      ],
      "tip": [
        "Set parity to odd."
      ]
    },
    {
      "name": "--onestopbit",
      "alias": [
        "-1"
      ],
      "usage": [
        "-1, --onestopbit"
      ],
      "tip": [
        "Set stop bits to one."
      ]
    },
    {
      "name": "--pause",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pause <seconds>"
      ],
      "tip": [
        "Pause between intro and ldattach."
      ],
      "next": []
    },
    {
      "name": "--sevenbits",
      "alias": [
        "-7"
      ],
      "usage": [
        "-7, --sevenbits"
      ],
      "tip": [
        "Set character size to 7 bits."
      ]
    },
    {
      "name": "--speed",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --speed <value>"
      ],
      "tip": [
        "Set serial line speed."
      ],
      "next": []
    },
    {
      "name": "--twostopbits",
      "alias": [
        "-2"
      ],
      "usage": [
        "-2, --twostopbits"
      ],
      "tip": [
        "Set stop bits to two."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
