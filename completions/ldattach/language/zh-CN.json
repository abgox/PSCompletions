{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "将线路规程附加到串行线路。"
    ]
  },
  "option": [
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "向标准错误打印详细消息。"
      ]
    },
    {
      "name": "--eightbits",
      "alias": [
        "-8"
      ],
      "usage": [
        "-8, --eightbits"
      ],
      "tip": [
        "将字符大小设置为 8 位。"
      ]
    },
    {
      "name": "--evenparity",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --evenparity"
      ],
      "tip": [
        "设置偶校验。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--iflag",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --iflag [-]<iflag>"
      ],
      "tip": [
        "设置输入模式标志。"
      ],
      "next": [
        {
          "name": "BRKINT"
        },
        {
          "name": "ICRNL"
        },
        {
          "name": "IGNBRK"
        },
        {
          "name": "IGNCR"
        },
        {
          "name": "IGNPAR"
        },
        {
          "name": "IMAXBEL"
        },
        {
          "name": "INLCR"
        },
        {
          "name": "INPCK"
        },
        {
          "name": "ISTRIP"
        },
        {
          "name": "IUCLC"
        },
        {
          "name": "IUTF8"
        },
        {
          "name": "IXANY"
        },
        {
          "name": "IXOFF"
        },
        {
          "name": "IXON"
        },
        {
          "name": "PARMRK"
        }
      ]
    },
    {
      "name": "--intro-command",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --intro-command <string>"
      ],
      "tip": [
        "在 ldattach 之前发送的介绍字符串。"
      ],
      "next": []
    },
    {
      "name": "--noparity",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noparity"
      ],
      "tip": [
        "设置无校验。"
      ]
    },
    {
      "name": "--oddparity",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --oddparity"
      ],
      "tip": [
        "设置奇校验。"
      ]
    },
    {
      "name": "--onestopbit",
      "alias": [
        "-1"
      ],
      "usage": [
        "-1, --onestopbit"
      ],
      "tip": [
        "将停止位设置为一位。"
      ]
    },
    {
      "name": "--pause",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pause <seconds>"
      ],
      "tip": [
        "介绍字符串和 ldattach 之间的暂停时间。"
      ],
      "next": []
    },
    {
      "name": "--sevenbits",
      "alias": [
        "-7"
      ],
      "usage": [
        "-7, --sevenbits"
      ],
      "tip": [
        "将字符大小设置为 7 位。"
      ]
    },
    {
      "name": "--speed",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --speed <value>"
      ],
      "tip": [
        "设置串行线路速度。"
      ],
      "next": []
    },
    {
      "name": "--twostopbits",
      "alias": [
        "-2"
      ],
      "usage": [
        "-2, --twostopbits"
      ],
      "tip": [
        "将停止位设置为两位。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
