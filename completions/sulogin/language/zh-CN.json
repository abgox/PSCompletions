{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "单用户登录。"
    ]
  },
  "option": [
    {
      "name": "--force",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --force"
      ],
      "tip": [
        "如果 getpwnam(3) 失败，直接检查密码文件。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--login-shell",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --login-shell"
      ],
      "tip": [
        "启动登录 shell。"
      ]
    },
    {
      "name": "--timeout",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --timeout <seconds>"
      ],
      "tip": [
        "等待密码的最长时间（默认: 无限制）。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
