{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Single-user login."
    ]
  },
  "option": [
    {
      "name": "--force",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --force"
      ],
      "tip": [
        "Examine password files directly if getpwnam(3) fails."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--login-shell",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --login-shell"
      ],
      "tip": [
        "Start a login shell."
      ]
    },
    {
      "name": "--timeout",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --timeout <seconds>"
      ],
      "tip": [
        "Max time to wait for a password (default: no limit)."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
