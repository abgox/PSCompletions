{
  "meta": {
    "url": "https://docs.ollama.com/cli",
    "description": [
      "本地大语言模型运行器。"
    ]
  },
  "next": [
    {
      "name": "cp",
      "usage": [
        "cp <SOURCE> <DEST>"
      ],
      "tip": [
        "复制模型。"
      ]
    },
    {
      "name": "create",
      "usage": [
        "create <MODEL> [flags]"
      ],
      "tip": [
        "使用 Modelfile 创建自定义模型。"
      ],
      "option": [
        {
          "name": "--draft-quantize",
          "usage": [
            "--draft-quantize <string>"
          ],
          "tip": [
            "将草稿模型量化到指定级别"
          ],
          "next": []
        },
        {
          "name": "--experimental",
          "tip": [
            "启用实验性 safetensors 模型创建"
          ]
        },
        {
          "name": "--file",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --file <string>"
          ],
          "tip": [
            "Modelfile 的名称（默认：Modelfile）"
          ],
          "next": []
        },
        {
          "name": "--quantize",
          "alias": [
            "-q"
          ],
          "usage": [
            "-q, --quantize <string>"
          ],
          "tip": [
            "将模型量化到指定级别（如 q4_K_M）"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "help",
      "usage": [
        "help [command]"
      ],
      "tip": [
        "任何命令的帮助。"
      ]
    },
    {
      "name": "launch",
      "usage": [
        "launch [flags]"
      ],
      "tip": [
        "配置并启动外部应用程序以使用 Ollama 模型。"
      ],
      "option": [
        {
          "name": "--config",
          "tip": [
            "配置但不启动"
          ]
        },
        {
          "name": "--model",
          "usage": [
            "--model <string>"
          ],
          "tip": [
            "使用指定模型启动"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "list",
      "alias": [
        "ls"
      ],
      "usage": [
        "ls|list"
      ],
      "tip": [
        "列出模型。"
      ]
    },
    {
      "name": "ps",
      "tip": [
        "列出运行中的模型。"
      ]
    },
    {
      "name": "pull",
      "usage": [
        "pull <MODEL> [flags]"
      ],
      "tip": [
        "从注册表下载模型。"
      ],
      "option": [
        {
          "name": "--insecure",
          "tip": [
            "使用不安全的注册表"
          ]
        }
      ]
    },
    {
      "name": "push",
      "usage": [
        "push <MODEL> [flags]"
      ],
      "tip": [
        "将模型推送到注册表。"
      ],
      "option": [
        {
          "name": "--insecure",
          "tip": [
            "使用不安全的注册表"
          ]
        }
      ]
    },
    {
      "name": "rm",
      "usage": [
        "rm <MODEL>"
      ],
      "tip": [
        "删除模型。"
      ]
    },
    {
      "name": "run",
      "usage": [
        "run <MODEL> [PROMPT] [flags]"
      ],
      "tip": [
        "运行模型。"
      ],
      "option": [
        {
          "name": "--dimensions",
          "usage": [
            "--dimensions <int>"
          ],
          "tip": [
            "将输出嵌入截断到指定维度"
          ],
          "next": []
        },
        {
          "name": "--format",
          "usage": [
            "--format <string>"
          ],
          "tip": [
            "响应格式（如 json）"
          ],
          "next": []
        },
        {
          "name": "--height",
          "usage": [
            "--height <int>"
          ],
          "tip": [
            "图像高度（实验性）"
          ],
          "next": []
        },
        {
          "name": "--hidethinking",
          "tip": [
            "隐藏思考输出（如果提供）"
          ]
        },
        {
          "name": "--insecure",
          "tip": [
            "使用不安全的注册表"
          ]
        },
        {
          "name": "--keepalive",
          "usage": [
            "--keepalive <string>"
          ],
          "tip": [
            "保持模型加载的时间（如 5m）"
          ],
          "next": []
        },
        {
          "name": "--negative",
          "usage": [
            "--negative <str>"
          ],
          "tip": [
            "负面提示（实验性）"
          ],
          "next": []
        },
        {
          "name": "--nowordwrap",
          "tip": [
            "不自动将单词换行到下一行"
          ]
        },
        {
          "name": "--seed",
          "usage": [
            "--seed <int>"
          ],
          "tip": [
            "随机种子（实验性）"
          ],
          "next": []
        },
        {
          "name": "--steps",
          "usage": [
            "--steps <int>"
          ],
          "tip": [
            "去噪步数（实验性）"
          ],
          "next": []
        },
        {
          "name": "--think",
          "usage": [
            "--think [=\"true\"]"
          ],
          "tip": [
            "启用思考模式：true/false 或 high/medium/low"
          ],
          "next": []
        },
        {
          "name": "--truncate",
          "tip": [
            "对于嵌入模型：截断超过上下文长度的输入"
          ]
        },
        {
          "name": "--verbose",
          "tip": [
            "显示响应计时"
          ]
        },
        {
          "name": "--width",
          "usage": [
            "--width <int>"
          ],
          "tip": [
            "图像宽度（实验性）"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "serve",
      "alias": [
        "start"
      ],
      "usage": [
        "start|serve"
      ],
      "tip": [
        "启动 Ollama。"
      ]
    },
    {
      "name": "show",
      "usage": [
        "show <MODEL> [flags]"
      ],
      "tip": [
        "显示模型信息。"
      ],
      "option": [
        {
          "name": "--license",
          "tip": [
            "显示模型的许可证"
          ]
        },
        {
          "name": "--modelfile",
          "tip": [
            "显示模型的 Modelfile"
          ]
        },
        {
          "name": "--parameters",
          "tip": [
            "显示模型的参数"
          ]
        },
        {
          "name": "--system",
          "tip": [
            "显示模型的系统消息"
          ]
        },
        {
          "name": "--template",
          "tip": [
            "显示模型的模板"
          ]
        },
        {
          "name": "--verbose",
          "alias": [
            "-v"
          ],
          "usage": [
            "-v, --verbose"
          ],
          "tip": [
            "显示详细的模型信息"
          ]
        }
      ]
    },
    {
      "name": "signin",
      "tip": [
        "登录 ollama.com。"
      ]
    },
    {
      "name": "signout",
      "tip": [
        "从 ollama.com 登出。"
      ]
    },
    {
      "name": "stop",
      "usage": [
        "stop <MODEL>"
      ],
      "tip": [
        "停止运行中的模型。"
      ]
    }
  ],
  "option": [
    {
      "name": "--nowordwrap",
      "tip": [
        "不自动将单词换行到下一行。"
      ]
    },
    {
      "name": "--verbose",
      "tip": [
        "显示响应计时。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "ollama 的帮助。"
      ]
    }
  ]
}
