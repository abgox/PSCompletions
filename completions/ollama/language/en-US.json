{
  "meta": {
    "url": "https://docs.ollama.com/cli",
    "description": [
      "Local large language model runner."
    ]
  },
  "next": [
    {
      "name": "cp",
      "usage": [
        "cp <SOURCE> <DEST>"
      ],
      "tip": [
        "Copy a model."
      ]
    },
    {
      "name": "create",
      "usage": [
        "create <MODEL> [flags]"
      ],
      "tip": [
        "Create a customized model with modelfile."
      ],
      "option": [
        {
          "name": "--draft-quantize",
          "usage": [
            "--draft-quantize <string>"
          ],
          "tip": [
            "Quantize draft model to this level"
          ],
          "next": []
        },
        {
          "name": "--experimental",
          "tip": [
            "Enable experimental safetensors model creation"
          ]
        },
        {
          "name": "--file",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --file <string>"
          ],
          "tip": [
            "Name of the Modelfile (default: Modelfile)"
          ],
          "next": []
        },
        {
          "name": "--quantize",
          "alias": [
            "-q"
          ],
          "usage": [
            "-q, --quantize <string>"
          ],
          "tip": [
            "Quantize model to this level (e.g. q4_K_M)"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "help",
      "usage": [
        "help [command]"
      ],
      "tip": [
        "Help about any command."
      ]
    },
    {
      "name": "launch",
      "usage": [
        "launch [flags]"
      ],
      "tip": [
        "Configure and launch external applications to use Ollama models."
      ],
      "option": [
        {
          "name": "--config",
          "tip": [
            "Configure without launching"
          ]
        },
        {
          "name": "--model",
          "usage": [
            "--model <string>"
          ],
          "tip": [
            "Launch with a specific model"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "list",
      "alias": [
        "ls"
      ],
      "usage": [
        "ls|list"
      ],
      "tip": [
        "List models."
      ]
    },
    {
      "name": "ps",
      "tip": [
        "List running models."
      ]
    },
    {
      "name": "pull",
      "usage": [
        "pull <MODEL> [flags]"
      ],
      "tip": [
        "Download a model from a registry."
      ],
      "option": [
        {
          "name": "--insecure",
          "tip": [
            "Use an insecure registry"
          ]
        }
      ]
    },
    {
      "name": "push",
      "usage": [
        "push <MODEL> [flags]"
      ],
      "tip": [
        "Push a model to a registry."
      ],
      "option": [
        {
          "name": "--insecure",
          "tip": [
            "Use an insecure registry"
          ]
        }
      ]
    },
    {
      "name": "rm",
      "usage": [
        "rm <MODEL>"
      ],
      "tip": [
        "Remove a model."
      ]
    },
    {
      "name": "run",
      "usage": [
        "run <MODEL> [PROMPT] [flags]"
      ],
      "tip": [
        "Run a model."
      ],
      "option": [
        {
          "name": "--dimensions",
          "usage": [
            "--dimensions <int>"
          ],
          "tip": [
            "Truncate output embeddings to specified dimension"
          ],
          "next": []
        },
        {
          "name": "--format",
          "usage": [
            "--format <string>"
          ],
          "tip": [
            "Response format (e.g. json)"
          ],
          "next": []
        },
        {
          "name": "--height",
          "usage": [
            "--height <int>"
          ],
          "tip": [
            "Image height (experimental)"
          ],
          "next": []
        },
        {
          "name": "--hidethinking",
          "tip": [
            "Hide thinking output (if provided)"
          ]
        },
        {
          "name": "--insecure",
          "tip": [
            "Use an insecure registry"
          ]
        },
        {
          "name": "--keepalive",
          "usage": [
            "--keepalive <string>"
          ],
          "tip": [
            "Duration to keep a model loaded (e.g. 5m)"
          ],
          "next": []
        },
        {
          "name": "--negative",
          "usage": [
            "--negative <str>"
          ],
          "tip": [
            "Negative prompt (experimental)"
          ],
          "next": []
        },
        {
          "name": "--nowordwrap",
          "tip": [
            "Don't wrap words to the next line automatically"
          ]
        },
        {
          "name": "--seed",
          "usage": [
            "--seed <int>"
          ],
          "tip": [
            "Random seed (experimental)"
          ],
          "next": []
        },
        {
          "name": "--steps",
          "usage": [
            "--steps <int>"
          ],
          "tip": [
            "Denoising steps (experimental)"
          ],
          "next": []
        },
        {
          "name": "--think",
          "usage": [
            "--think [=\"true\"]"
          ],
          "tip": [
            "Enable thinking mode: true/false or high/medium/low"
          ],
          "next": []
        },
        {
          "name": "--truncate",
          "tip": [
            "For embedding models: truncate inputs exceeding context length"
          ]
        },
        {
          "name": "--verbose",
          "tip": [
            "Show timings for response"
          ]
        },
        {
          "name": "--width",
          "usage": [
            "--width <int>"
          ],
          "tip": [
            "Image width (experimental)"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "serve",
      "alias": [
        "start"
      ],
      "usage": [
        "start|serve"
      ],
      "tip": [
        "Start Ollama."
      ]
    },
    {
      "name": "show",
      "usage": [
        "show <MODEL> [flags]"
      ],
      "tip": [
        "Show information for a model."
      ],
      "option": [
        {
          "name": "--license",
          "tip": [
            "Show license of a model"
          ]
        },
        {
          "name": "--modelfile",
          "tip": [
            "Show Modelfile of a model"
          ]
        },
        {
          "name": "--parameters",
          "tip": [
            "Show parameters of a model"
          ]
        },
        {
          "name": "--system",
          "tip": [
            "Show system message of a model"
          ]
        },
        {
          "name": "--template",
          "tip": [
            "Show template of a model"
          ]
        },
        {
          "name": "--verbose",
          "alias": [
            "-v"
          ],
          "usage": [
            "-v, --verbose"
          ],
          "tip": [
            "Show detailed model information"
          ]
        }
      ]
    },
    {
      "name": "signin",
      "tip": [
        "Sign in to ollama.com."
      ]
    },
    {
      "name": "signout",
      "tip": [
        "Sign out from ollama.com."
      ]
    },
    {
      "name": "stop",
      "usage": [
        "stop <MODEL>"
      ],
      "tip": [
        "Stop a running model."
      ]
    }
  ],
  "option": [
    {
      "name": "--nowordwrap",
      "tip": [
        "Don't wrap words to the next line automatically."
      ]
    },
    {
      "name": "--verbose",
      "tip": [
        "Show timings for response."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Show version information."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Help for ollama."
      ]
    }
  ]
}
