{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "从命令行调用块设备 ioctl。"
    ]
  },
  "option": [
    {
      "name": "--flushbufs",
      "tip": [
        "刷新缓冲区。"
      ]
    },
    {
      "name": "--getalignoff",
      "tip": [
        "获取对齐偏移量（字节）。"
      ]
    },
    {
      "name": "--getbsz",
      "tip": [
        "获取块大小。"
      ]
    },
    {
      "name": "--getdiscardzeroes",
      "tip": [
        "获取丢弃零值支持状态。"
      ]
    },
    {
      "name": "--getdiskseq",
      "tip": [
        "获取磁盘序列号。"
      ]
    },
    {
      "name": "--getfra",
      "tip": [
        "获取文件系统预读。"
      ]
    },
    {
      "name": "--getiomin",
      "tip": [
        "获取最小 I/O 大小。"
      ]
    },
    {
      "name": "--getioopt",
      "tip": [
        "获取最佳 I/O 大小。"
      ]
    },
    {
      "name": "--getmaxsect",
      "tip": [
        "获取每次请求的最大扇区数。"
      ]
    },
    {
      "name": "--getpbsz",
      "tip": [
        "获取物理块（扇区）大小。"
      ]
    },
    {
      "name": "--getra",
      "tip": [
        "获取预读大小。"
      ]
    },
    {
      "name": "--getro",
      "tip": [
        "获取只读状态。"
      ]
    },
    {
      "name": "--getsize",
      "tip": [
        "获取 32 位扇区数（已弃用，请使用 --getsz）。"
      ]
    },
    {
      "name": "--getsize64",
      "tip": [
        "获取大小（字节）。"
      ]
    },
    {
      "name": "--getss",
      "tip": [
        "获取逻辑块（扇区）大小。"
      ]
    },
    {
      "name": "--getsz",
      "tip": [
        "获取大小（512 字节扇区）。"
      ]
    },
    {
      "name": "--getzonesz",
      "tip": [
        "获取区域大小。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--report",
      "tip": [
        "打印指定设备（或所有设备）的报告。"
      ]
    },
    {
      "name": "--rereadpt",
      "tip": [
        "重新读取分区表。"
      ]
    },
    {
      "name": "--setbsz",
      "usage": [
        "--setbsz <bytes>"
      ],
      "tip": [
        "在打开块设备的文件描述符上设置块大小。"
      ],
      "next": []
    },
    {
      "name": "--setfra",
      "usage": [
        "--setfra <sectors>"
      ],
      "tip": [
        "设置文件系统预读。"
      ],
      "next": []
    },
    {
      "name": "--setra",
      "usage": [
        "--setra <sectors>"
      ],
      "tip": [
        "设置预读。"
      ],
      "next": []
    },
    {
      "name": "--setro",
      "tip": [
        "设置为只读。"
      ]
    },
    {
      "name": "--setrw",
      "tip": [
        "设置为读写。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "-q",
      "tip": [
        "静默模式。"
      ]
    },
    {
      "name": "-v",
      "tip": [
        "详细模式。"
      ]
    }
  ]
}
