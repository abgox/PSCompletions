{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Call block device ioctls from the command line."
    ]
  },
  "option": [
    {
      "name": "--flushbufs",
      "tip": [
        "Flush buffers."
      ]
    },
    {
      "name": "--getalignoff",
      "tip": [
        "Get alignment offset in bytes."
      ]
    },
    {
      "name": "--getbsz",
      "tip": [
        "Get blocksize."
      ]
    },
    {
