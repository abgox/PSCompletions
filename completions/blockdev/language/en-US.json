      "tip": [
        "Get size in 512-byte sectors."
      ]
    },
    {
      "name": "--getzonesz",
      "tip": [
        "Get zone size."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--report",
      "tip": [
        "Print report for specified (or all) devices."
      ]
    },
    {
      "name": "--rereadpt",
      "tip": [
