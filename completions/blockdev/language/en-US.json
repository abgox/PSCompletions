      "tip": [
        "Get filesystem readahead."
      ]
    },
    {
      "name": "--getiomin",
      "tip": [
        "Get minimum I/O size."
      ]
    },
    {
      "name": "--getioopt",
      "tip": [
        "Get optimal I/O size."
      ]
    },
    {
