      "tip": [
        "Get physical block (sector) size."
      ]
    },
    {
      "name": "--getra",
      "tip": [
        "Get readahead."
      ]
    },
    {
      "name": "--getro",
      "tip": [
        "Get read-only."
      ]
    },
    {
