{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把这些文件的内容拼接后写入标准输出。"
    ]
  },
  "option": [
    {
      "name": "--number",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --number"
      ],
      "tip": [
        "给所有输出行编号"
      ]
    },
    {
      "name": "--number-nonblank",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --number-nonblank"
      ],
      "tip": [
        "只给非空的输出行编号，覆盖 -n"
      ]
    },
    {
      "name": "--show-all",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --show-all"
      ],
      "tip": [
        "等同于 -vET"
      ]
    },
    {
      "name": "--show-ends",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --show-ends"
      ],
      "tip": [
        "在每行末尾显示 $"
      ]
    },
    {
      "name": "--show-nonprinting",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --show-nonprinting"
      ],
      "tip": [
        "使用 ^ 和 M- 记法，但 LFD 和 TAB 除外"
      ]
    },
    {
      "name": "--show-tabs",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --show-tabs"
      ],
      "tip": [
        "把 TAB 字符显示为 ^I"
      ]
    },
    {
      "name": "--squeeze-blank",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squeeze-blank"
      ],
      "tip": [
        "把重复的空输出行压缩为一行"
      ]
    },
    {
      "name": "-e",
      "tip": [
        "等同于 -vE"
      ]
    },
    {
      "name": "-t",
      "tip": [
        "等同于 -vT"
      ]
    },
    {
      "name": "-u",
      "tip": [
        "（已忽略，不起作用）"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
