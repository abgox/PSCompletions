{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "Concatenate FILE(s) to standard output."
    ]
  },
  "option": [
    {
      "name": "--number",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --number"
      ],
      "tip": [
        "number all output lines"
      ]
    },
    {
      "name": "--number-nonblank",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --number-nonblank"
      ],
      "tip": [
        "number nonempty output lines, overrides -n"
      ]
    },
    {
      "name": "--show-all",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --show-all"
      ],
      "tip": [
        "equivalent to -vET"
      ]
    },
    {
      "name": "--show-ends",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --show-ends"
      ],
      "tip": [
        "display $ at end of each line"
      ]
    },
    {
      "name": "--show-nonprinting",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --show-nonprinting"
      ],
      "tip": [
        "use ^ and M- notation, except for LFD and TAB"
      ]
    },
    {
      "name": "--show-tabs",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --show-tabs"
      ],
      "tip": [
        "display TAB characters as ^I"
      ]
    },
    {
      "name": "--squeeze-blank",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squeeze-blank"
      ],
      "tip": [
        "suppress repeated empty output lines"
      ]
    },
    {
      "name": "-e",
      "tip": [
        "equivalent to -vE"
      ]
    },
    {
      "name": "-t",
      "tip": [
        "equivalent to -vT"
      ]
    },
    {
      "name": "-u",
      "tip": [
        "(ignored)"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "display this help and exit"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "output version information and exit"
      ]
    }
  ]
}
