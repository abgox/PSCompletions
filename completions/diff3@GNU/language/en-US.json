{
  "meta": {
    "url": "https://www.gnu.org/software/diffutils",
    "description": [
      "Compare three files line by line."
    ]
  },
  "option": [
    {
      "name": "--diff-program",
      "usage": [
        "--diff-program=PROGRAM"
      ],
      "tip": [
        "Use PROGRAM to compare files."
      ],
      "next": []
    },
    {
      "name": "--easy-only",
      "alias": [
        "-3"
      ],
      "usage": [
        "-3, --easy-only"
      ],
      "tip": [
        "Like --ed, but incorporate only nonoverlapping changes."
      ]
    },
    {
      "name": "--ed",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --ed"
      ],
      "tip": [
        "Output an ed script incorporating changes from OLDFILE to YOURFILE into MYFILE."
      ]
    },
    {
      "name": "--help",
      "tip": [
        "Display this help and exit."
      ]
    },
    {
      "name": "--initial-tab",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --initial-tab"
      ],
      "tip": [
        "Make tabs line up by prepending a tab."
      ]
    },
    {
      "name": "--label",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --label=LABEL"
      ],
      "tip": [
        "Use LABEL instead of file name.",
        "Can be repeated up to three times."
      ],
      "repeat": 3,
      "next": []
    },
    {
      "name": "--merge",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --merge"
      ],
      "tip": [
        "Output the actual merged file, according to --show-all if no other options are given."
      ]
    },
    {
      "name": "--overlap-only",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --overlap-only"
      ],
      "tip": [
        "Like --ed, but incorporate only overlapping changes."
      ]
    },
    {
      "name": "--show-all",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --show-all"
      ],
      "tip": [
        "Output all changes, bracketing conflicts."
      ]
    },
    {
      "name": "--show-overlap",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --show-overlap"
      ],
      "tip": [
        "Like --ed, but bracket conflicts."
      ]
    },
    {
      "name": "--strip-trailing-cr",
      "tip": [
        "Strip trailing carriage return on input."
      ]
    },
    {
      "name": "--text",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --text"
      ],
      "tip": [
        "Treat all files as text."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Output version information and exit."
      ]
    },
    {
      "name": "-i",
      "tip": [
        "Append 'w' and 'q' commands to ed scripts."
      ]
    },
    {
      "name": "-X",
      "tip": [
        "Like --overlap-only, but bracket conflicts."
      ]
    }
  ]
}
