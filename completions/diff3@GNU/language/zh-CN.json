{
  "meta": {
    "url": "https://www.gnu.org/software/diffutils",
    "description": [
      "逐行比较三个文件。"
    ]
  },
  "option": [
    {
      "name": "--diff-program",
      "usage": [
        "--diff-program=PROGRAM"
      ],
      "tip": [
        "使用 PROGRAM 比较文件。"
      ],
      "next": []
    },
    {
      "name": "--easy-only",
      "alias": [
        "-3"
      ],
      "usage": [
        "-3, --easy-only"
      ],
      "tip": [
        "类似 --ed，但只合并不重叠的更改。"
      ]
    },
    {
      "name": "--ed",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --ed"
      ],
      "tip": [
        "输出一个 ed 脚本，将 OLDFILE 到 YOURFILE 的更改合并到 MYFILE。"
      ]
    },
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出。"
      ]
    },
    {
      "name": "--initial-tab",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --initial-tab"
      ],
      "tip": [
        "通过在行首添加制表符使制表位对齐。"
      ]
    },
    {
      "name": "--label",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --label=LABEL"
      ],
      "tip": [
        "使用 LABEL 代替文件名。",
        "最多可重复三次。"
      ],
      "repeat": 3,
      "next": []
    },
    {
      "name": "--merge",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --merge"
      ],
      "tip": [
        "根据 --show-all（如果未给出其他选项）输出实际合并后的文件。"
      ]
    },
    {
      "name": "--overlap-only",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --overlap-only"
      ],
      "tip": [
        "类似 --ed，但只合并重叠的更改。"
      ]
    },
    {
      "name": "--show-all",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --show-all"
      ],
      "tip": [
        "输出所有更改，并用标记括起冲突。"
      ]
    },
    {
      "name": "--show-overlap",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --show-overlap"
      ],
      "tip": [
        "类似 --ed，但用标记括起冲突。"
      ]
    },
    {
      "name": "--strip-trailing-cr",
      "tip": [
        "去除输入中的行尾回车符。"
      ]
    },
    {
      "name": "--text",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --text"
      ],
      "tip": [
        "将所有文件视为文本。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "输出版本信息并退出。"
      ]
    },
    {
      "name": "-i",
      "tip": [
        "在 ed 脚本末尾追加 'w' 和 'q' 命令。"
      ]
    },
    {
      "name": "-X",
      "tip": [
        "类似 --overlap-only，但用标记括起冲突。"
      ]
    }
  ]
}
