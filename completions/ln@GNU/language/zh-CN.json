{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "创建文件之间的链接。"
    ]
  },
  "option": [
    {
      "name": "--backup",
      "usage": [
        "--backup[=CONTROL]"
      ],
      "tip": [
        "为每个已存在的目标文件创建备份"
      ],
      "next": [
        {
          "name": "existing"
        },
        {
          "name": "never"
        },
        {
          "name": "nil"
        },
        {
          "name": "none"
        },
        {
          "name": "numbered"
        },
        {
          "name": "off"
        },
        {
          "name": "simple"
        },
        {
          "name": "t"
        }
      ]
    },
    {
      "name": "--directory",
      "alias": [
        "-F",
        "-d"
      ],
      "usage": [
        "-F, -d, --directory"
      ],
      "tip": [
        "允许超级用户尝试对目录建立硬链接（即使对超级用户，也很可能因系统限制而失败）"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "移除现有目标文件"
      ]
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "询问是否删除目标文件"
      ]
    },
    {
      "name": "--logical",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --logical"
      ],
      "tip": [
        "把作为符号链接的 TARGET 当作其指向的文件"
      ]
    },
    {
      "name": "--no-dereference",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-dereference"
      ],
      "tip": [
        "如果 LINK_NAME 是指向目录的符号链接，则将其视为普通文件"
      ]
    },
    {
      "name": "--no-target-directory",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --no-target-directory"
      ],
      "tip": [
        "始终将 LINK_NAME 视为普通文件"
      ]
    },
    {
      "name": "--physical",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --physical"
      ],
      "tip": [
        "直接对符号链接创建硬链接"
      ]
    },
    {
      "name": "--relative",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --relative"
      ],
      "tip": [
        "与 -s 一起使用时，创建相对于链接所在位置的链接"
      ]
    },
    {
      "name": "--suffix",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --suffix <SUFFIX>"
      ],
      "tip": [
        "覆盖通常使用的备份后缀"
      ],
      "next": []
    },
    {
      "name": "--symbolic",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --symbolic"
      ],
      "tip": [
        "创建符号链接而非硬链接"
      ]
    },
    {
      "name": "--target-directory",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --target-directory <DIRECTORY>"
      ],
      "tip": [
        "指定在哪个 DIRECTORY 中创建链接"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "打印每个链接文件的名称"
      ]
    },
    {
      "name": "-b",
      "tip": [
        "与 --backup 相同，但不接受参数"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
