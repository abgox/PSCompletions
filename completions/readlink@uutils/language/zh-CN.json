{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "打印符号链接的值或规范文件名"
    ]
  },
  "option": [
    {
      "name": "--canonicalize",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --canonicalize"
      ],
      "tip": [
        "递归跟随给定名称每个部分中的每个符号链接进行规范化；除最后一部分外都必须存在"
      ]
    },
    {
      "name": "--canonicalize-existing",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --canonicalize-existing"
      ],
      "tip": [
        "递归跟随给定名称每个部分中的每个符号链接进行规范化，所有部分都必须存在"
      ]
    },
    {
      "name": "--canonicalize-missing",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --canonicalize-missing"
      ],
      "tip": [
        "递归跟随给定名称每个部分中的每个符号链接进行规范化，对部分是否存在没有要求"
      ]
    },
    {
      "name": "--no-newline",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-newline"
      ],
      "tip": [
        "不输出末尾分隔符"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "隐藏大多数错误消息"
      ]
    },
    {
      "name": "--silent",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --silent"
      ],
      "tip": [
        "隐藏大多数错误消息"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "报告错误消息"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "以 NUL 而非换行分隔输出"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
