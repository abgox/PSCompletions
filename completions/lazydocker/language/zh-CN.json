{
  "meta": {
    "url": "https://github.com/jesseduffield/lazydocker",
    "description": [
      "更轻松地管理 Docker。"
    ]
  },
  "option": [
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config"
      ],
      "tip": [
        "打印当前默认配置。"
      ]
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "以调试模式运行。"
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file <file>"
      ],
      "tip": [
        "指定替代的 compose 文件。"
      ],
      "next": []
    },
    {
      "name": "--project",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --project <name>"
      ],
      "tip": [
        "指定 docker compose 项目名称。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "显示程序版本字符串。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示可用标志、子命令和位置值参数的帮助。"
      ]
    }
  ]
}
