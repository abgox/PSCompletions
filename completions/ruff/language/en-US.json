{
  "meta": {
    "url": "https://github.com/astral-sh/ruff",
    "description": [
      "An extremely fast Python linter and code formatter."
    ]
  },
  "next": [
    {
      "name": "analyze",
      "tip": [
        "Run analysis over Python source code."
      ],
      "next": [
        {
          "name": "graph",
          "tip": [
            "Generate a map of Python file dependencies or dependents."
          ]
        }
      ]
    },
    {
      "name": "check",
      "tip": [
        "Run Ruff on the given files or directories."
      ],
      "option": [
        {
          "name": "--add-ignore",
          "tip": [
            "Enable automatic additions of ruff:ignore comments to failing lines."
          ]
        },
        {
          "name": "--add-noqa",
          "tip": [
            "Enable automatic additions of noqa directives to failing lines."
          ]
        },
        {
          "name": "--cache-dir",
          "usage": [
            "--cache-dir <CACHE_DIR>"
          ],
          "tip": [
            "Path to the cache directory."
          ],
          "next": []
        },
        {
          "name": "--diff",
          "tip": [
            "Output a diff for each changed file to stdout.",
            "Implies --fix-only."
          ]
        },
        {
          "name": "--exclude",
          "usage": [
            "--exclude <FILE_PATTERN>"
          ],
          "tip": [
            "List of paths to omit from analysis."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--exit-non-zero-on-fix",
          "tip": [
            "Exit with a non-zero status code if any files were modified via fix."
          ]
        },
        {
          "name": "--exit-zero",
          "alias": [
            "-e"
          ],
          "usage": [
            "-e, --exit-zero"
          ],
          "tip": [
            "Exit with status code 0, even upon detecting lint violations."
          ]
        },
        {
          "name": "--extend-exclude",
          "usage": [
            "--extend-exclude <FILE_PATTERN>"
          ],
          "tip": [
            "Like --exclude, but adds additional files and directories."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--extend-select",
          "usage": [
            "--extend-select <RULE_CODE>"
          ],
          "tip": [
            "Like --select, but adds additional rule codes on top of those already specified."
          ],
          "next": []
        },
        {
          "name": "--extension",
          "usage": [
            "--extension <EXTENSION>"
          ],
          "tip": [
            "List of mappings from file extension to language."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--fix",
          "tip": [
            "Apply fixes to resolve lint violations.",
            "Use --no-fix to disable or --unsafe-fixes to include unsafe fixes."
          ]
        },
        {
          "name": "--fix-only",
          "tip": [
            "Apply fixes but don't report leftover violations.",
            "Implies --fix."
          ]
        },
        {
          "name": "--fixable",
          "usage": [
            "--fixable <RULE_CODE>"
          ],
          "tip": [
            "List of rule codes to treat as eligible for fix."
          ],
          "next": []
        },
        {
          "name": "--force-exclude",
          "tip": [
            "Enforce exclusions, even for paths passed directly on the command-line."
          ]
        },
        {
          "name": "--ignore",
          "usage": [
            "--ignore <RULE_CODE>"
          ],
          "tip": [
            "Comma-separated list of rule codes to disable."
          ],
          "next": []
        },
        {
          "name": "--ignore-noqa",
          "tip": [
            "Ignore any # noqa comments."
          ]
        },
        {
          "name": "--no-cache",
          "alias": [
            "-n"
          ],
          "usage": [
            "-n, --no-cache"
          ],
          "tip": [
            "Disable cache reads."
          ]
        },
        {
          "name": "--output-file",
          "alias": [
            "-o"
          ],
          "usage": [
            "-o, --output-file <OUTPUT_FILE>"
          ],
          "tip": [
            "Specify file to write the linter output to."
          ],
          "next": []
        },
        {
          "name": "--output-format",
          "usage": [
            "--output-format <OUTPUT_FORMAT>"
          ],
          "tip": [
            "Output serialization format for violations.",
            "Possible values: concise, full, json, json-lines, junit, grouped, github, gitlab, pylint, rdjson, azure, sarif"
          ],
          "next": [
            {
              "name": "azure",
              "tip": [
                "Azure DevOps output format."
              ]
            },
            {
              "name": "concise",
              "tip": [
                "Concise output format."
              ]
            },
            {
              "name": "full",
              "tip": [
                "Full output format (default)."
              ]
            },
            {
              "name": "github",
              "tip": [
                "GitHub Actions output format."
              ]
            },
            {
              "name": "gitlab",
              "tip": [
                "GitLab Code Quality output format."
              ]
            },
            {
              "name": "grouped",
              "tip": [
                "Grouped output format."
              ]
            },
            {
              "name": "json",
              "tip": [
                "JSON output format."
              ]
            },
            {
              "name": "json-lines",
              "tip": [
                "JSON Lines output format."
              ]
            },
            {
              "name": "junit",
              "tip": [
                "JUnit XML output format."
              ]
            },
            {
              "name": "pylint",
              "tip": [
                "Pylint output format."
              ]
            },
            {
              "name": "rdjson",
              "tip": [
                "RDJSON output format."
              ]
            },
            {
              "name": "sarif",
              "tip": [
                "SARIF output format."
              ]
            }
          ]
        },
        {
          "name": "--per-file-ignores",
          "usage": [
            "--per-file-ignores <PER_FILE_IGNORES>"
          ],
          "tip": [
            "List of mappings from file pattern to code to exclude."
          ],
          "next": []
        },
        {
          "name": "--preview",
          "tip": [
            "Enable preview mode; checks will include unstable rules and fixes."
          ]
        },
        {
          "name": "--respect-gitignore",
          "tip": [
            "Respect file exclusions via .gitignore."
          ]
        },
        {
          "name": "--select",
          "usage": [
            "--select <RULE_CODE>"
          ],
          "tip": [
            "Comma-separated list of rule codes to enable (or ALL)."
          ],
          "next": []
        },
        {
          "name": "--show-files",
          "tip": [
            "See the files Ruff will be run against with the current settings."
          ]
        },
        {
          "name": "--show-fixes",
          "tip": [
            "Show an enumeration of all fixed lint violations."
          ]
        },
        {
          "name": "--show-settings",
          "tip": [
            "See the settings Ruff will use to lint a given Python file."
          ]
        },
        {
          "name": "--statistics",
          "tip": [
            "Show counts for every rule with at least one violation."
          ]
        },
        {
          "name": "--stdin-filename",
          "usage": [
            "--stdin-filename <STDIN_FILENAME>"
          ],
          "tip": [
            "The name of the file when passing it through stdin."
          ],
          "next": []
        },
        {
          "name": "--target-version",
          "usage": [
            "--target-version <TARGET_VERSION>"
          ],
          "tip": [
            "The minimum Python version that should be supported.",
            "Possible values: py37, py38, py39, py310, py311, py312, py313, py314, py315"
          ],
          "next": [
            {
              "name": "py310",
              "tip": [
                "Target Python 3.10."
              ]
            },
            {
              "name": "py311",
              "tip": [
                "Target Python 3.11."
              ]
            },
            {
              "name": "py312",
              "tip": [
                "Target Python 3.12."
              ]
            },
            {
              "name": "py313",
              "tip": [
                "Target Python 3.13."
              ]
            },
            {
              "name": "py314",
              "tip": [
                "Target Python 3.14."
              ]
            },
            {
              "name": "py315",
              "tip": [
                "Target Python 3.15."
              ]
            },
            {
              "name": "py37",
              "tip": [
                "Target Python 3.7."
              ]
            },
            {
              "name": "py38",
              "tip": [
                "Target Python 3.8."
              ]
            },
            {
              "name": "py39",
              "tip": [
                "Target Python 3.9."
              ]
            }
          ]
        },
        {
          "name": "--unfixable",
          "usage": [
            "--unfixable <RULE_CODE>"
          ],
          "tip": [
            "List of rule codes to treat as ineligible for fix."
          ],
          "next": []
        },
        {
          "name": "--unsafe-fixes",
          "tip": [
            "Include fixes that may not retain the original intent of the code."
          ]
        },
        {
          "name": "--watch",
          "alias": [
            "-w"
          ],
          "usage": [
            "-w, --watch"
          ],
          "tip": [
            "Run in watch mode by re-running whenever files change."
          ]
        }
      ]
    },
    {
      "name": "clean",
      "tip": [
        "Clear any caches in the current directory and any subdirectories."
      ]
    },
    {
      "name": "config",
      "tip": [
        "List or describe the available configuration options."
      ]
    },
    {
      "name": "format",
      "tip": [
        "Run the Ruff formatter on the given files or directories."
      ],
      "option": [
        {
          "name": "--cache-dir",
          "usage": [
            "--cache-dir <CACHE_DIR>"
          ],
          "tip": [
            "Path to the cache directory."
          ],
          "next": []
        },
        {
          "name": "--check",
          "tip": [
            "Avoid writing any formatted files back.",
            "Exit with non-zero status code if any files would have been modified."
          ]
        },
        {
          "name": "--diff",
          "tip": [
            "Output the difference between current and formatted file."
          ]
        },
        {
          "name": "--exclude",
          "usage": [
            "--exclude <FILE_PATTERN>"
          ],
          "tip": [
            "List of paths to omit from analysis."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--exit-non-zero-on-format",
          "tip": [
            "Exit with a non-zero status code if any files were modified via format."
          ]
        },
        {
          "name": "--extend-exclude",
          "usage": [
            "--extend-exclude <FILE_PATTERN>"
          ],
          "tip": [
            "Like --exclude, but adds additional files and directories."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--extension",
          "usage": [
            "--extension <EXTENSION>"
          ],
          "tip": [
            "List of mappings from file extension to language."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--force-exclude",
          "tip": [
            "Enforce exclusions, even for paths passed directly on the command-line."
          ]
        },
        {
          "name": "--line-length",
          "usage": [
            "--line-length <LINE_LENGTH>"
          ],
          "tip": [
            "Set the line-length."
          ],
          "next": []
        },
        {
          "name": "--no-cache",
          "alias": [
            "-n"
          ],
          "usage": [
            "-n, --no-cache"
          ],
          "tip": [
            "Disable cache reads."
          ]
        },
        {
          "name": "--output-format",
          "usage": [
            "--output-format <OUTPUT_FORMAT>"
          ],
          "tip": [
            "Output serialization format for violations, when used with --check."
          ],
          "next": [
            {
              "name": "concise",
              "tip": [
                "Concise output format."
              ]
            },
            {
              "name": "full",
              "tip": [
                "Full output format."
              ]
            },
            {
              "name": "json",
              "tip": [
                "JSON output format."
              ]
            }
          ]
        },
        {
          "name": "--preview",
          "tip": [
            "Enable preview mode; enables unstable formatting."
          ]
        },
        {
          "name": "--range",
          "usage": [
            "--range <RANGE>"
          ],
          "tip": [
            "Only format the code in the given range.",
            "Format: <start_line>:<start_column>-<end_line>:<end_column>"
          ],
          "next": []
        },
        {
          "name": "--respect-gitignore",
          "tip": [
            "Respect file exclusions via .gitignore."
          ]
        },
        {
          "name": "--stdin-filename",
          "usage": [
            "--stdin-filename <STDIN_FILENAME>"
          ],
          "tip": [
            "The name of the file when passing it through stdin."
          ],
          "next": []
        },
        {
          "name": "--target-version",
          "usage": [
            "--target-version <TARGET_VERSION>"
          ],
          "tip": [
            "The minimum Python version that should be supported."
          ],
          "next": [
            {
              "name": "py310",
              "tip": [
                "Target Python 3.10."
              ]
            },
            {
              "name": "py311",
              "tip": [
                "Target Python 3.11."
              ]
            },
            {
              "name": "py312",
              "tip": [
                "Target Python 3.12."
              ]
            },
            {
              "name": "py313",
              "tip": [
                "Target Python 3.13."
              ]
            },
            {
              "name": "py314",
              "tip": [
                "Target Python 3.14."
              ]
            },
            {
              "name": "py315",
              "tip": [
                "Target Python 3.15."
              ]
            },
            {
              "name": "py37",
              "tip": [
                "Target Python 3.7."
              ]
            },
            {
              "name": "py38",
              "tip": [
                "Target Python 3.8."
              ]
            },
            {
              "name": "py39",
              "tip": [
                "Target Python 3.9."
              ]
            }
