      ]
    },
    {
      "name": "linter",
      "tip": [
        "List all supported upstream linters."
      ]
    },
    {
      "name": "rule",
      "tip": [
        "Explain a rule (or all rules)."
      ],
      "option": [
        {
          "name": "--all",
          "tip": [
            "Explain all rules."
          ]
        },
        {
          "name": "--output-format",
          "usage": [
            "--output-format <OUTPUT_FORMAT>"
          ],
          "tip": [
            "Output format.",
            "Default: text",
            "Possible values: text, json"
          ],
          "next": [
            {
              "name": "json",
              "tip": [
                "JSON output format."
              ]
            },
            {
              "name": "text",
              "tip": [
                "Text output format."
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "server",
      "tip": [
        "Run the language server."
      ]
    },
    {
      "name": "version",
      "tip": [
        "Display Ruff's version."
      ]
    }
  ],
  "option": [
    {
      "name": "--color",
      "usage": [
        "--color <WHEN>"
      ],
      "tip": [
        "Control when colored output is used.",
        "Possible values: auto, always, never"
      ],
      "next": [
        {
          "name": "always",
          "tip": [
            "Always display colors."
          ]
        },
        {
          "name": "auto",
          "tip": [
            "Display colors if the output goes to an interactive terminal."
          ]
        },
        {
          "name": "never",
          "tip": [
            "Never display colors."
          ]
        }
      ]
    },
    {
      "name": "--config",
      "usage": [
        "--config <CONFIG_OPTION>"
      ],
      "tip": [
        "Either a path to a TOML configuration file, or a TOML key-value pair."
      ],
      "example": [
        "--config \"lint.line-length = 100\"",
        "--config \"format.quote-style = 'single'\""
      ],
      "next": []
    },
    {
      "name": "--isolated",
      "tip": [
        "Ignore all configuration files."
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Print diagnostics, but nothing else."
      ]
    },
    {
      "name": "--silent",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --silent"
      ],
      "tip": [
        "Disable all logging."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Enable verbose logging."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--config",
      "usage": [
        "--config <CONFIG_OPTION>"
      ],
      "tip": [
        "Path to a TOML configuration file or a key-value pair."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help."
      ]
    }
  ]
