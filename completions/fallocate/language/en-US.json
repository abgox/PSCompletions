{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Preallocate space to, or deallocate space from a file."
    ]
  },
  "option": [
    {
      "name": "--collapse-range",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --collapse-range"
      ],
      "tip": [
        "Remove a range from the file."
      ]
    },
    {
      "name": "--dig-holes",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --dig-holes"
      ],
      "tip": [
        "Detect zeroes and replace with holes."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--insert-range",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --insert-range"
      ],
      "tip": [
        "Insert a hole at range, shifting existing data."
      ]
    },
    {
      "name": "--keep-size",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --keep-size"
      ],
      "tip": [
        "Maintain the apparent size of the file."
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --length <num>"
      ],
      "tip": [
        "Length for range operations, in bytes."
      ],
      "next": []
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <num>"
      ],
      "tip": [
        "Offset for range operations, in bytes."
      ],
      "next": []
    },
    {
      "name": "--posix",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --posix"
      ],
      "tip": [
        "Use posix_fallocate(3) instead of fallocate(2)."
      ]
    },
    {
      "name": "--punch-hole",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --punch-hole"
      ],
      "tip": [
        "Replace a range with a hole (implies -n)."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Verbose mode."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--zero-range",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-range"
      ],
      "tip": [
        "Zero and ensure allocation of a range."
      ]
    }
  ]
}
