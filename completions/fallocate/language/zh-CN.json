{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "为文件预分配空间或释放文件空间。"
    ]
  },
  "option": [
    {
      "name": "--collapse-range",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --collapse-range"
      ],
      "tip": [
        "从文件中移除一个范围。"
      ]
    },
    {
      "name": "--dig-holes",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --dig-holes"
      ],
      "tip": [
        "检测零值并用空洞替换。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--insert-range",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --insert-range"
      ],
      "tip": [
        "在范围处插入空洞，并移动现有数据。"
      ]
    },
    {
      "name": "--keep-size",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --keep-size"
      ],
      "tip": [
        "保持文件的外观大小。"
      ]
    },
    {
      "name": "--length",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --length <num>"
      ],
      "tip": [
        "范围操作的长度（字节）。"
      ],
      "next": []
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <num>"
      ],
      "tip": [
        "范围操作的偏移量（字节）。"
      ],
      "next": []
    },
    {
      "name": "--posix",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --posix"
      ],
      "tip": [
        "使用 posix_fallocate(3) 而不是 fallocate(2)。"
      ]
    },
    {
      "name": "--punch-hole",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --punch-hole"
      ],
      "tip": [
        "用空洞替换一个范围（隐含 -n）。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "详细模式。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--zero-range",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-range"
      ],
      "tip": [
        "清零并确保范围已分配。"
      ]
    }
  ]
}
