{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "更改用户密码过期信息。"
    ]
  },
  "option": [
    {
      "name": "--expiredate",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --expiredate <EXPIRE_DATE>"
      ],
      "tip": [
        "设置账户失效的日期或自 1970 年 1 月 1 日起的天数。",
        "日期也可以使用 YYYY-MM-DD 格式。",
        "传入 -1 会移除账户失效日期。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--inactive",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --inactive <INACTIVE>"
      ],
      "tip": [
        "设置密码过期后的不活跃天数。"
      ],
      "next": []
    },
    {
      "name": "--iso8601",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --iso8601"
      ],
      "tip": [
        "打印日期时使用 YYYY-MM-DD。"
      ]
    },
    {
      "name": "--lastday",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --lastday <LAST_DAY>"
      ],
      "tip": [
        "设置密码最后更改的日期或自 1970 年 1 月 1 日起的天数。",
        "日期也可以使用 YYYY-MM-DD 格式。",
        "值为 0 会强制用户在下次登录时更改密码。"
      ],
      "next": []
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "显示账户时效信息。"
      ]
    },
    {
      "name": "--maxdays",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --maxdays <MAX_DAYS>"
      ],
      "tip": [
        "设置密码更改前的最长天数。"
      ],
      "next": []
    },
    {
      "name": "--mindays",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mindays <MIN_DAYS>"
      ],
      "tip": [
        "设置密码更改前的最短天数。"
      ],
      "next": []
    },
    {
      "name": "--prefix",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --prefix <PREFIX_DIR>"
      ],
      "tip": [
        "在 PREFIX_DIR 下的根文件系统中应用对配置文件的更改。",
        "该选项不会 chroot，用于准备交叉编译目标。"
      ],
      "next": []
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--warndays",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --warndays <WARN_DAYS>"
      ],
      "tip": [
        "设置密码过期前的警告天数。"
      ],
      "next": []
    }
  ]
}
