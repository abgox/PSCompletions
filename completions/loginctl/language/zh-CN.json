{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "向登录管理器发送控制命令或查询。"
    ]
  },
  "next": [
    {
      "name": "activate",
      "usage": [
        "activate [ID]"
      ],
      "tip": [
        "激活会话。"
      ]
    },
    {
      "name": "attach",
      "usage": [
        "attach NAME DEVICE..."
      ],
      "tip": [
        "将一个或多个设备附加到席位。"
      ]
    },
    {
      "name": "disable-linger",
      "usage": [
        "disable-linger [USER...]"
      ],
      "tip": [
        "禁用一个或多个用户的 linger 状态。"
      ]
    },
    {
      "name": "enable-linger",
      "usage": [
        "enable-linger [USER...]"
      ],
      "tip": [
        "启用一个或多个用户的 linger 状态。"
      ]
    },
    {
      "name": "flush-devices",
      "tip": [
        "清除所有设备关联。"
      ]
    },
    {
      "name": "kill-session",
      "usage": [
        "kill-session ID..."
      ],
      "tip": [
        "向会话的进程发送信号。"
      ]
    },
    {
      "name": "kill-user",
      "usage": [
        "kill-user USER..."
      ],
      "tip": [
        "向用户的进程发送信号。"
      ]
    },
    {
      "name": "list-seats",
      "tip": [
        "列出席位。"
      ]
    },
    {
      "name": "list-sessions",
      "tip": [
        "列出会话。"
      ]
    },
    {
      "name": "list-users",
      "tip": [
        "列出用户。"
      ]
    },
    {
      "name": "lock-session",
      "usage": [
        "lock-session [ID...]"
      ],
      "tip": [
        "锁定一个或多个会话。"
      ]
    },
    {
      "name": "lock-sessions",
      "tip": [
        "锁定所有当前会话。"
      ]
    },
    {
      "name": "seat-status",
      "usage": [
        "seat-status [NAME...]"
      ],
      "tip": [
        "显示席位状态。"
      ]
    },
    {
      "name": "session-status",
      "usage": [
        "session-status [ID...]"
      ],
      "tip": [
        "显示会话状态。"
      ]
    },
    {
      "name": "show-seat",
      "usage": [
        "show-seat [NAME...]"
      ],
      "tip": [
        "显示席位或管理器的属性。"
      ]
    },
    {
      "name": "show-session",
      "usage": [
        "show-session [ID...]"
      ],
      "tip": [
        "显示会话或管理器的属性。"
      ]
    },
    {
      "name": "show-user",
      "usage": [
        "show-user [USER...]"
      ],
      "tip": [
        "显示用户或管理器的属性。"
      ]
    },
    {
      "name": "terminate-seat",
      "usage": [
        "terminate-seat NAME..."
      ],
      "tip": [
        "终止一个或多个席位上的所有会话。"
      ]
    },
    {
      "name": "terminate-session",
      "usage": [
        "terminate-session ID..."
      ],
      "tip": [
        "终止一个或多个会话。"
      ]
    },
    {
      "name": "terminate-user",
      "usage": [
        "terminate-user USER..."
      ],
      "tip": [
        "终止一个或多个用户的所有会话。"
      ]
    },
    {
      "name": "unlock-session",
      "usage": [
        "unlock-session [ID...]"
      ],
      "tip": [
        "解锁一个或多个会话。"
      ]
    },
    {
      "name": "unlock-sessions",
      "tip": [
        "解锁所有当前会话。"
      ]
    },
    {
      "name": "user-status",
      "usage": [
        "user-status [USER...]"
      ],
      "tip": [
        "显示用户状态。"
      ]
    }
  ],
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "显示所有属性，包括空属性。"
      ]
    },
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "不省略输出。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "在远程主机上操作。"
      ],
      "next": []
    },
    {
      "name": "--json",
      "usage": [
        "--json=MODE"
      ],
      "tip": [
        "为 list-sessions/users/seats 生成 JSON 输出。",
        "可能值: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--kill-whom",
      "usage": [
        "--kill-whom=WHOM"
      ],
      "tip": [
        "向谁发送信号。"
      ],
      "next": []
    },
    {
      "name": "--lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --lines=INTEGER"
      ],
      "tip": [
        "要显示的日志条目数。"
      ],
      "next": []
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "对本机容器操作。"
      ],
      "next": []
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "不提示输入密码。"
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "不显示页眉和页脚。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output=MODE"
      ],
      "tip": [
        "更改日志输出模式。",
        "可能值: short, short-precise, short-iso, short-iso-precise, short-full, short-monotonic, short-unix, short-delta, json, json-pretty, json-sse, json-seq, cat, verbose, export, with-unit"
      ],
      "next": [
        {
          "name": "cat"
        },
        {
          "name": "export"
        },
        {
          "name": "json"
        },
        {
          "name": "json-pretty"
        },
        {
          "name": "json-seq"
        },
        {
          "name": "json-sse"
        },
        {
          "name": "short"
        },
        {
          "name": "short-delta"
        },
        {
          "name": "short-full"
        },
        {
          "name": "short-iso"
        },
        {
          "name": "short-iso-precise"
        },
        {
          "name": "short-monotonic"
        },
        {
          "name": "short-precise"
        },
        {
          "name": "short-unix"
        },
        {
          "name": "verbose"
        },
        {
          "name": "with-unit"
        }
      ]
    },
    {
      "name": "--property",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --property=NAME"
      ],
      "tip": [
        "仅显示此名称的属性。"
      ],
      "next": []
    },
    {
      "name": "--signal",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --signal=SIGNAL"
      ],
      "tip": [
        "要发送的信号。"
      ],
      "next": []
    },
    {
      "name": "--value",
      "tip": [
        "显示属性时仅打印值。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "-j",
      "tip": [
        "在 tty 上等同于 --json=pretty，否则等同于 --json=short。"
      ]
    },
    {
      "name": "-P",
      "usage": [
        "-P NAME"
      ],
      "tip": [
        "等同于 --value --property=NAME。"
      ],
      "next": []
    }
  ]
}
