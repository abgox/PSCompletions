{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Send control commands to or query the login manager."
    ]
  },
  "next": [
    {
      "name": "activate",
      "usage": [
        "activate [ID]"
      ],
      "tip": [
        "Activate a session."
      ]
    },
    {
      "name": "attach",
      "usage": [
        "attach NAME DEVICE..."
      ],
      "tip": [
        "Attach one or more devices to a seat."
      ]
    },
    {
      "name": "disable-linger",
      "usage": [
        "disable-linger [USER...]"
      ],
      "tip": [
        "Disable linger state of one or more users."
      ]
    },
    {
      "name": "enable-linger",
      "usage": [
        "enable-linger [USER...]"
      ],
      "tip": [
        "Enable linger state of one or more users."
      ]
    },
    {
      "name": "flush-devices",
      "tip": [
        "Flush all device associations."
      ]
    },
    {
      "name": "kill-session",
      "usage": [
        "kill-session ID..."
      ],
      "tip": [
        "Send signal to processes of a session."
      ]
    },
    {
      "name": "kill-user",
      "usage": [
        "kill-user USER..."
      ],
      "tip": [
        "Send signal to processes of a user."
      ]
    },
    {
      "name": "list-seats",
      "tip": [
        "List seats."
      ]
    },
    {
      "name": "list-sessions",
      "tip": [
        "List sessions."
      ]
    },
    {
      "name": "list-users",
      "tip": [
        "List users."
      ]
    },
    {
      "name": "lock-session",
      "usage": [
        "lock-session [ID...]"
      ],
      "tip": [
        "Screen lock one or more sessions."
      ]
    },
    {
      "name": "lock-sessions",
      "tip": [
        "Screen lock all current sessions."
      ]
    },
    {
      "name": "seat-status",
      "usage": [
        "seat-status [NAME...]"
      ],
      "tip": [
        "Show seat status."
      ]
    },
    {
      "name": "session-status",
      "usage": [
        "session-status [ID...]"
      ],
      "tip": [
        "Show session status."
      ]
    },
    {
      "name": "show-seat",
      "usage": [
        "show-seat [NAME...]"
      ],
      "tip": [
        "Show properties of seats or the manager."
      ]
    },
    {
      "name": "show-session",
      "usage": [
        "show-session [ID...]"
      ],
      "tip": [
        "Show properties of sessions or the manager."
      ]
    },
    {
      "name": "show-user",
      "usage": [
        "show-user [USER...]"
      ],
      "tip": [
        "Show properties of users or the manager."
      ]
    },
    {
      "name": "terminate-seat",
      "usage": [
        "terminate-seat NAME..."
      ],
      "tip": [
        "Terminate all sessions on one or more seats."
      ]
    },
    {
      "name": "terminate-session",
      "usage": [
        "terminate-session ID..."
      ],
      "tip": [
        "Terminate one or more sessions."
      ]
    },
    {
      "name": "terminate-user",
      "usage": [
        "terminate-user USER..."
      ],
      "tip": [
        "Terminate all sessions of one or more users."
      ]
    },
    {
      "name": "unlock-session",
      "usage": [
        "unlock-session [ID...]"
      ],
      "tip": [
        "Screen unlock one or more sessions."
      ]
    },
    {
      "name": "unlock-sessions",
      "tip": [
        "Screen unlock all current sessions."
      ]
    },
    {
      "name": "user-status",
      "usage": [
        "user-status [USER...]"
      ],
      "tip": [
        "Show user status."
      ]
    }
  ],
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Show all properties, including empty ones."
      ]
    },
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "Do not ellipsize output."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "Operate on remote host."
      ],
      "next": []
    },
    {
      "name": "--json",
      "usage": [
        "--json=MODE"
      ],
      "tip": [
        "Generate JSON output for list-sessions/users/seats.",
        "Possible values: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--kill-whom",
      "usage": [
        "--kill-whom=WHOM"
      ],
      "tip": [
        "Whom to send signal to."
      ],
      "next": []
    },
    {
      "name": "--lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --lines=INTEGER"
      ],
      "tip": [
        "Number of journal entries to show."
      ],
      "next": []
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "Operate on local container."
      ],
      "next": []
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "Don't prompt for password."
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "Do not show the headers and footers."
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output=MODE"
      ],
      "tip": [
        "Change journal output mode.",
        "Possible values: short, short-precise, short-iso, short-iso-precise, short-full, short-monotonic, short-unix, short-delta, json, json-pretty, json-sse, json-seq, cat, verbose, export, with-unit"
      ],
      "next": [
        {
          "name": "cat"
        },
        {
          "name": "export"
        },
        {
          "name": "json"
        },
        {
          "name": "json-pretty"
        },
        {
          "name": "json-seq"
        },
        {
          "name": "json-sse"
        },
        {
          "name": "short"
        },
        {
          "name": "short-delta"
        },
        {
          "name": "short-full"
        },
        {
          "name": "short-iso"
        },
        {
          "name": "short-iso-precise"
        },
        {
          "name": "short-monotonic"
        },
        {
          "name": "short-precise"
        },
        {
          "name": "short-unix"
        },
        {
          "name": "verbose"
        },
        {
          "name": "with-unit"
        }
      ]
    },
    {
      "name": "--property",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --property=NAME"
      ],
      "tip": [
        "Show only properties by this name."
      ],
      "next": []
    },
    {
      "name": "--signal",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --signal=SIGNAL"
      ],
      "tip": [
        "Which signal to send."
      ],
      "next": []
    },
    {
      "name": "--value",
      "tip": [
        "When showing properties, only print the value."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    },
    {
      "name": "-j",
      "tip": [
        "Same as --json=pretty on tty, --json=short otherwise."
      ]
    },
    {
      "name": "-P",
      "usage": [
        "-P NAME"
      ],
      "tip": [
        "Equivalent to --value --property=NAME."
      ],
      "next": []
    }
  ]
}
