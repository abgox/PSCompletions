{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "显示当前工作目录的完整文件名"
    ]
  },
  "option": [
    {
      "name": "--logical",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --logical"
      ],
      "tip": [
        "使用环境中的 PWD，即使它包含符号链接"
      ]
    },
    {
      "name": "--physical",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --physical"
      ],
      "tip": [
        "避开所有符号链接"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
