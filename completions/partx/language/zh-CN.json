{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "告知内核分区的存在及其编号。"
    ]
  },
  "option": [
    {
      "name": "--add",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --add"
      ],
      "tip": [
        "添加指定分区或全部分区。"
      ]
    },
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "以字节而不是人类可读格式打印 SIZE。"
      ]
    },
    {
      "name": "--delete",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delete"
      ],
      "tip": [
        "删除指定分区或全部分区。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--list-types",
      "tip": [
        "列出支持的分区类型后退出。"
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --noheadings"
      ],
      "tip": [
        "不为 --show 打印标题。"
      ]
    },
    {
      "name": "--nr",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nr <n:m>"
      ],
      "tip": [
        "指定分区范围（例如 --nr 2:4）。"
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "定义要使用的输出列。"
      ],
      "separator": ",",
      "next": [
        {
          "name": "END",
          "tip": [
            "分区结束扇区。"
          ]
        },
        {
          "name": "FLAGS",
          "tip": [
            "分区标志。"
          ]
        },
        {
          "name": "NAME",
          "tip": [
            "分区名称。"
          ]
        },
        {
          "name": "NR",
          "tip": [
            "分区号。"
          ]
        },
        {
          "name": "SCHEME",
          "tip": [
            "分区表类型（dos、gpt 等）。"
          ]
        },
        {
          "name": "SECTORS",
          "tip": [
            "扇区数。"
          ]
        },
        {
          "name": "SIZE",
          "tip": [
            "人类可读的大小。"
          ]
        },
        {
          "name": "START",
          "tip": [
            "分区起始扇区。"
          ]
        },
        {
          "name": "TYPE",
          "tip": [
            "分区类型（字符串、UUID 或十六进制）。"
          ]
        },
        {
          "name": "UUID",
          "tip": [
            "分区 UUID。"
          ]
        }
      ]
    },
    {
      "name": "--output-all",
      "tip": [
        "输出所有列。"
      ]
    },
    {
      "name": "--pairs",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pairs"
      ],
      "tip": [
        "使用 key=\"value\" 输出格式。"
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "使用原始输出格式。"
      ]
    },
    {
      "name": "--sector-size",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --sector-size <num>"
      ],
      "tip": [
        "覆盖扇区大小。"
      ],
      "next": []
    },
    {
      "name": "--show",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --show"
      ],
      "tip": [
        "列出分区。"
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <type>"
      ],
      "tip": [
        "指定分区类型。"
      ],
      "next": []
    },
    {
      "name": "--update",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --update"
      ],
      "tip": [
        "更新指定分区或全部分区。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "详细模式。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
