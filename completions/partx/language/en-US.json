{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Tell the kernel about the presence and numbering of partitions."
    ]
  },
  "option": [
    {
      "name": "--add",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --add"
      ],
      "tip": [
        "Add specified partitions or all of them."
      ]
    },
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "Print SIZE in bytes rather than in human readable format."
      ]
    },
    {
      "name": "--delete",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delete"
      ],
      "tip": [
        "Delete specified partitions or all of them."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--list-types",
      "tip": [
        "List supported partition types and exit."
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --noheadings"
      ],
      "tip": [
        "Don't print headings for --show."
      ]
    },
    {
      "name": "--nr",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nr <n:m>"
      ],
      "tip": [
        "Specify the range of partitions (e.g. --nr 2:4)."
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "Define which output columns to use."
      ],
      "separator": ",",
      "next": [
        {
          "name": "END",
          "tip": [
            "End of the partition in sectors."
          ]
        },
        {
          "name": "FLAGS",
          "tip": [
            "Partition flags."
          ]
        },
        {
          "name": "NAME",
          "tip": [
            "Partition name."
          ]
        },
        {
          "name": "NR",
          "tip": [
            "Partition number."
          ]
        },
        {
          "name": "SCHEME",
          "tip": [
            "Partition table type (dos, gpt, ...)."
          ]
        },
        {
          "name": "SECTORS",
          "tip": [
            "Number of sectors."
          ]
        },
        {
          "name": "SIZE",
          "tip": [
            "Human readable size."
          ]
        },
        {
          "name": "START",
          "tip": [
            "Start of the partition in sectors."
          ]
        },
        {
          "name": "TYPE",
          "tip": [
            "Partition type (a string, a UUID, or hex)."
          ]
        },
        {
          "name": "UUID",
          "tip": [
            "Partition UUID."
          ]
        }
      ]
    },
    {
      "name": "--output-all",
      "tip": [
        "Output all columns."
      ]
    },
    {
      "name": "--pairs",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pairs"
      ],
      "tip": [
        "Use key=\"value\" output format."
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "Use raw output format."
      ]
    },
    {
      "name": "--sector-size",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --sector-size <num>"
      ],
      "tip": [
        "Overwrite sector size."
      ],
      "next": []
    },
    {
      "name": "--show",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --show"
      ],
      "tip": [
        "List partitions."
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <type>"
      ],
      "tip": [
        "Specify the partition type."
      ],
      "next": []
    },
    {
      "name": "--update",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --update"
      ],
      "tip": [
        "Update specified partitions or all of them."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Verbose mode."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
