{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "检测是否在虚拟化环境中运行。"
    ]
  },
  "option": [
    {
      "name": "--chroot",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --chroot"
      ],
      "tip": [
        "检测是否在 chroot() 环境中运行。"
      ]
    },
    {
      "name": "--container",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --container"
      ],
      "tip": [
        "仅检测是否在容器中运行。"
      ]
    },
    {
      "name": "--cvm",
      "tip": [
        "仅检测是否在机密虚拟机中运行。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--list",
      "tip": [
        "列出所有已知且可检测的虚拟化类型。"
      ]
    },
    {
      "name": "--list-cvm",
      "tip": [
        "列出所有已知且可检测的机密虚拟化类型。"
      ]
    },
    {
      "name": "--private-users",
      "tip": [
        "仅检测是否在用户命名空间中运行。"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "不输出任何内容，仅设置返回值。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "--vm",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --vm"
      ],
      "tip": [
        "仅检测是否在虚拟机中运行。"
      ]
    }
  ]
}
