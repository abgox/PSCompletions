{
  "meta": {
    "url": "https://esbuild.github.io/",
    "description": [
      "Extremely fast JavaScript and CSS bundler and minifier."
    ]
  },
  "option": [
    {
      "name": "--abs-paths",
      "usage": [
        "--abs-paths=<TYPE>"
      ],
      "tip": [
        "Emit absolute instead of relative paths in these situations"
      ],
      "next": [
        {
          "name": "code",
          "tip": [
            "Absolute paths in generated code"
          ]
        },
        {
          "name": "log",
          "tip": [
            "Absolute paths in log messages"
          ]
        },
        {
          "name": "metafile",
          "tip": [
            "Absolute paths in metafile JSON"
          ]
        }
      ]
    },
    {
      "name": "--allow-overwrite",
      "tip": [
        "Allow output files to overwrite input files"
      ]
    },
    {
      "name": "--analyze",
      "tip": [
        "Print a report about the contents of the bundle (use \"--analyze=verbose\" for a detailed report)"
      ]
    },
    {
      "name": "--asset-names",
      "usage": [
        "--asset-names=<TEMPLATE>"
      ],
      "tip": [
        "Path template to use for \"file\" loader files (default \"[name]-[hash]\")"
      ],
      "next": []
    },
    {
      "name": "--banner:T=...",
      "alias": [
        "--banner"
      ],
      "usage": [
        "--banner:<TYPE>=<TEXT>"
      ],
      "tip": [
        "Text to be prepended to each output file of type T (css | js)"
      ],
      "next": []
    },
    {
      "name": "--bundle",
      "tip": [
        "Bundle all dependencies into the output files"
      ]
    },
    {
      "name": "--certfile",
      "usage": [
        "--certfile=<FILE>"
      ],
      "tip": [
        "Certificate for serving HTTPS (see also \"--keyfile\")"
      ],
      "next": []
    },
    {
      "name": "--charset",
      "tip": [
        "Do not escape UTF-8 code points"
      ]
    },
    {
      "name": "--chunk-names",
      "usage": [
        "--chunk-names=<TEMPLATE>"
      ],
      "tip": [
        "Path template to use for code splitting chunks (default \"[name]-[hash]\")"
      ],
      "next": []
    },
    {
      "name": "--color",
      "usage": [
        "--color=<VALUE>"
      ],
      "tip": [
        "Force use of color terminal escapes"
      ],
      "next": [
        {
          "name": "false",
          "tip": [
            "Disable color output"
          ]
        },
        {
          "name": "true",
          "tip": [
            "Force color output"
          ]
        }
      ]
    },
    {
      "name": "--cors-origin",
      "usage": [
        "--cors-origin=<ORIGIN>"
      ],
      "tip": [
        "Allow cross-origin requests from this origin"
      ],
      "next": []
    },
    {
      "name": "--define:K=V",
      "alias": [
        "--define"
      ],
      "usage": [
        "--define=<K=V>"
      ],
      "tip": [
        "Substitute K with V while parsing"
      ],
      "next": []
    },
    {
      "name": "--drop",
      "usage": [
        "--drop:<TYPE>"
      ],
      "tip": [
        "Remove certain constructs"
      ],
      "next": [
        {
          "name": "console",
          "tip": [
            "Remove all console.* calls"
          ]
        },
        {
          "name": "debugger",
          "tip": [
            "Remove all debugger statements"
          ]
        }
      ]
    },
    {
      "name": "--drop-labels",
      "usage": [
        "--drop-labels=<LABELS>"
      ],
      "tip": [
        "Remove labeled statements with these label names"
      ],
      "next": []
    },
    {
      "name": "--entry-names",
      "usage": [
        "--entry-names=<TEMPLATE>"
      ],
      "tip": [
        "Path template to use for entry point output paths (default \"[dir]/[name]\")"
      ],
      "next": []
    },
    {
      "name": "--external:M",
      "alias": [
        "--external"
      ],
      "usage": [
        "--external=<M>"
      ],
      "tip": [
        "Exclude module M from the bundle (can use * wildcards)"
      ],
      "next": []
    },
    {
      "name": "--footer",
      "usage": [
        "--footer:<TYPE>=<TEXT>"
      ],
      "tip": [
        "Text to be appended to each output file of type T (css | js)"
      ],
      "next": []
    },
    {
      "name": "--format",
      "usage": [
        "--format=<FORMAT>"
      ],
      "tip": [
        "Output format"
      ],
      "next": [
        {
          "name": "cjs",
          "tip": [
            "CommonJS module (default for node)"
          ]
        },
        {
          "name": "esm",
          "tip": [
            "ES module"
          ]
        },
        {
          "name": "iife",
          "tip": [
            "Immediately-invoked function expression (default for browser)"
          ]
        }
      ]
    },
    {
      "name": "--global-name",
      "usage": [
        "--global-name=<NAME>"
      ],
      "tip": [
        "The name of the global for the IIFE format"
      ],
      "next": []
    },
    {
      "name": "--ignore-annotations",
      "tip": [
        "Enable this to work with packages that have incorrect tree-shaking annotations"
      ]
    },
    {
      "name": "--inject",
      "usage": [
        "--inject:<FILE>"
      ],
      "tip": [
        "Import the file F into all input files and automatically replace matching globals with imports"
      ],
      "next": []
    },
    {
      "name": "--jsx",
      "usage": [
        "--jsx=<MODE>"
      ],
      "tip": [
        "Set to \"automatic\" to use React's automatic runtime or to \"preserve\" to disable transforming JSX to JS"
      ],
      "next": [
        {
          "name": "automatic",
          "tip": [
            "Use React's automatic runtime"
          ]
        },
        {
          "name": "preserve",
          "tip": [
            "Disable transforming JSX to JS"
          ]
        }
      ]
    },
    {
      "name": "--jsx-dev",
      "tip": [
        "Use React's automatic runtime in development mode"
      ]
    },
    {
      "name": "--jsx-factory",
      "usage": [
        "--jsx-factory=<EXPR>"
      ],
      "tip": [
        "What to use for JSX instead of React.createElement"
      ],
      "next": []
    },
    {
      "name": "--jsx-fragment",
      "usage": [
        "--jsx-fragment=<EXPR>"
      ],
      "tip": [
        "What to use for JSX instead of React.Fragment"
      ],
      "next": []
    },
    {
      "name": "--jsx-import-source",
      "usage": [
        "--jsx-import-source=<PKG>"
      ],
      "tip": [
        "Override the package name for the automatic runtime (default \"react\")"
      ],
      "next": []
    },
    {
      "name": "--jsx-side-effects",
      "tip": [
        "Do not remove unused JSX expressions"
      ]
    },
    {
      "name": "--keep-names",
      "tip": [
        "Preserve \"name\" on functions and classes"
      ]
    },
    {
      "name": "--keyfile",
      "usage": [
        "--keyfile=<FILE>"
      ],
      "tip": [
        "Key for serving HTTPS (see also \"--certfile\")"
      ],
      "next": []
    },
    {
      "name": "--legal-comments",
      "usage": [
        "--legal-comments=<WHERE>"
      ],
      "tip": [
        "Where to place legal comments (default eof when bundling, inline otherwise)"
      ],
      "next": [
        {
          "name": "eof",
          "tip": [
            "Move to the end of the file"
          ]
        },
        {
          "name": "external",
          "tip": [
            "Move to a separate file and link"
          ]
        },
        {
          "name": "inline",
          "tip": [
            "Preserve in the original location"
          ]
        },
        {
          "name": "linked",
          "tip": [
            "Move to a separate file"
          ]
        },
        {
          "name": "none",
          "tip": [
            "Omit all legal comments"
          ]
        }
      ]
    },
    {
      "name": "--line-limit",
      "usage": [
        "--line-limit=<CHARS>"
      ],
      "tip": [
        "Lines longer than this will be wrapped onto a new line"
      ],
      "next": []
    },
    {
      "name": "--loader:X=L",
      "alias": [
        "--loader"
      ],
      "usage": [
        "--loader:<EXT>=<LOADER>"
      ],
      "tip": [
        "Use loader L to load file extension X"
      ],
      "next": [
        {
          "name": "base64",
          "tip": [
            "Data URL with base64 encoding"
          ]
        },
        {
          "name": "binary",
          "tip": [
            "Binary data"
          ]
        },
        {
          "name": "copy",
          "tip": [
            "Copy file to output and return URL"
          ]
        },
        {
          "name": "css",
          "tip": [
            "CSS"
          ]
        },
        {
          "name": "dataurl",
          "tip": [
            "Data URL"
          ]
        },
        {
          "name": "empty",
          "tip": [
            "Empty content"
          ]
        },
        {
          "name": "file",
          "tip": [
            "File loader"
          ]
        },
        {
          "name": "global-css",
          "tip": [
            "Global CSS (no modules)"
          ]
        },
        {
          "name": "js",
          "tip": [
            "JavaScript"
          ]
        },
        {
          "name": "json",
          "tip": [
            "JSON"
          ]
        },
        {
          "name": "jsx",
          "tip": [
            "JSX (React)"
          ]
        },
        {
          "name": "local-css",
          "tip": [
            "CSS Modules"
          ]
        },
        {
          "name": "text",
          "tip": [
            "Text content"
          ]
        },
        {
          "name": "ts",
          "tip": [
            "TypeScript"
          ]
        },
        {
          "name": "tsx",
          "tip": [
            "TypeScript JSX"
          ]
        }
      ]
    },
    {
      "name": "--log-level",
      "usage": [
        "--log-level=<LEVEL>"
      ],
      "tip": [
        "Disable logging (default info)"
      ],
      "next": [
        {
          "name": "debug",
          "tip": [
            "Show debug and above"
          ]
        },
        {
          "name": "error",
          "tip": [
            "Show errors only"
          ]
        },
        {
          "name": "info",
          "tip": [
            "Show info and above (default)"
          ]
        },
        {
          "name": "silent",
          "tip": [
            "Disable all logging"
          ]
        },
        {
          "name": "verbose",
          "tip": [
            "Show all log messages"
          ]
        },
        {
          "name": "warning",
          "tip": [
            "Show warnings and errors only"
          ]
        }
      ]
    },
    {
      "name": "--log-limit",
      "usage": [
        "--log-limit=<N>"
      ],
      "tip": [
        "Maximum message count or 0 to disable (default 6)"
      ],
      "next": []
    },
    {
      "name": "--log-override",
      "usage": [
        "--log-override:<ID>=<LEVEL>"
      ],
      "tip": [
        "Use log level Y for log messages with identifier X"
      ],
      "next": []
    },
    {
      "name": "--main-fields",
      "usage": [
        "--main-fields=<FIELDS>"
      ],
      "tip": [
        "Override the main file order in package.json"
      ],
      "next": []
    },
    {
      "name": "--mangle-cache",
      "usage": [
        "--mangle-cache=<FILE>"
      ],
      "tip": [
        "Save \"mangle props\" decisions to a JSON file"
      ],
      "next": []
    },
    {
      "name": "--mangle-props",
      "usage": [
        "--mangle-props=<REGEX>"
      ],
      "tip": [
        "Rename all properties matching a regular expression"
      ],
      "next": []
    },
    {
      "name": "--mangle-quoted",
      "usage": [
        "--mangle-quoted=<VALUE>"
      ],
      "tip": [
        "Enable renaming of quoted properties"
      ],
      "next": [
        {
          "name": "false",
          "tip": [
            "Disable renaming of quoted properties"
          ]
        },
        {
          "name": "true",
          "tip": [
            "Enable renaming of quoted properties"
          ]
        }
      ]
    },
    {
      "name": "--metafile",
      "usage": [
        "--metafile=<FILE>"
      ],
      "tip": [
        "Write metadata about the build to a JSON file"
      ],
      "next": []
    },
    {
      "name": "--minify",
      "tip": [
        "Minify the output (sets all --minify-* flags)"
      ]
    },
    {
      "name": "--minify-identifiers",
      "tip": [
        "Shorten identifiers in output files"
      ]
    },
    {
      "name": "--minify-syntax",
      "tip": [
        "Use equivalent but shorter syntax in output files"
      ]
    },
    {
      "name": "--minify-whitespace",
      "tip": [
        "Remove whitespace in output files"
      ]
    },
    {
      "name": "--out-extension",
      "usage": [
        "--out-extension:<EXT>=<NEW_EXT>"
      ],
      "tip": [
        "Use a custom output extension instead of the default"
      ],
      "next": []
    },
    {
      "name": "--outbase",
      "usage": [
        "--outbase=<DIR>"
      ],
      "tip": [
        "The base path used to determine entry point output paths"
      ],
      "next": []
    },
    {
      "name": "--outdir",
      "usage": [
        "--outdir=<DIR>"
      ],
      "tip": [
        "The output directory (for multiple entry points)"
      ],
      "next": []
    },
    {
      "name": "--outfile",
      "usage": [
        "--outfile=<FILE>"
      ],
      "tip": [
        "The output file (for one entry point)"
      ],
      "next": []
    },
    {
      "name": "--packages",
      "usage": [
        "--packages=<MODE>"
      ],
      "tip": [
        "Set to \"external\" to avoid bundling any package"
      ],
      "next": [
        {
          "name": "external",
          "tip": [
            "Don't bundle any packages"
          ]
        }
      ]
    },
    {
      "name": "--platform",
      "usage": [
        "--platform=<PLATFORM>"
      ],
      "tip": [
        "Platform target (default browser)"
      ],
      "next": [
        {
          "name": "browser",
          "tip": [
            "Browser target (default)"
          ]
        },
        {
          "name": "neutral",
          "tip": [
            "Platform-neutral target"
          ]
        },
        {
          "name": "node",
          "tip": [
            "Node.js target"
          ]
        }
      ]
    },
    {
      "name": "--preserve-symlinks",
      "tip": [
        "Disable symlink resolution for module lookup"
      ]
    },
    {
      "name": "--public-path",
      "usage": [
        "--public-path=<PATH>"
      ],
      "tip": [
        "Set the base URL for the \"file\" loader"
      ],
      "next": []
    },
    {
      "name": "--pure",
      "usage": [
        "--pure=<NAME>"
      ],
      "tip": [
        "Mark the name N as a pure function for tree shaking"
      ],
      "next": []
    },
    {
      "name": "--reserve-props",
      "usage": [
        "--reserve-props=<PROPS>"
      ],
      "tip": [
        "Do not mangle these properties"
      ],
      "next": []
    },
    {
      "name": "--resolve-extensions",
      "usage": [
        "--resolve-extensions=<EXTS>"
      ],
      "tip": [
        "A comma-separated list of implicit extensions (default \".tsx,.ts,.jsx,.js,.css,.json\")"
      ],
      "next": []
    },
    {
      "name": "--serve",
      "usage": [
        "--serve=<HOST:PORT>"
      ],
      "tip": [
        "Start a local HTTP server on this host:port for outputs"
      ],
      "next": []
    },
    {
      "name": "--serve-fallback",
      "usage": [
        "--serve-fallback=<FILE>"
      ],
      "tip": [
        "Serve this HTML page when the request doesn't match"
      ],
      "next": []
    },
    {
      "name": "--servedir",
      "usage": [
        "--servedir=<DIR>"
      ],
      "tip": [
        "What to serve in addition to generated output files"
      ],
      "next": []
    },
    {
      "name": "--source-root",
      "usage": [
        "--source-root=<DIR>"
      ],
      "tip": [
        "Sets the \"sourceRoot\" field in generated source maps"
      ],
      "next": []
    },
    {
      "name": "--sourcefile",
      "usage": [
        "--sourcefile=<FILE>"
      ],
      "tip": [
        "Set the source file for the source map (for stdin)"
      ],
      "next": []
    },
    {
      "name": "--sourcemap",
      "tip": [
        "Emit a source map"
      ]
    },
    {
      "name": "--sourcemap=external",
      "tip": [
        "Do not link to the source map with a comment"
      ]
    },
    {
      "name": "--sourcemap=inline",
      "tip": [
        "Emit the source map with an inline data URL"
      ]
    },
    {
      "name": "--sources-content",
      "usage": [
        "--sources-content=<VALUE>"
      ],
      "tip": [
        "Whether to include \"sourcesContent\" in generated source maps"
      ],
      "next": [
        {
          "name": "false",
          "tip": [
            "Omit sourcesContent in generated source maps"
          ]
        }
      ]
    },
    {
      "name": "--splitting",
      "tip": [
        "Enable code splitting (currently only for esm)"
      ]
    },
    {
      "name": "--supported",
      "usage": [
        "--supported:<FEATURE>=<VALUE>"
      ],
      "tip": [
        "Consider syntax F to be supported (true | false)"
      ],
      "next": []
    },
    {
      "name": "--target",
      "usage": [
        "--target=<TARGET>"
      ],
      "tip": [
        "Environment target (default esnext)"
      ],
      "next": [
        {
          "name": "chrome58",
          "tip": [
            "Chrome 58"
          ]
        },
        {
          "name": "edge16",
          "tip": [
            "Edge 16"
          ]
        },
        {
          "name": "es2017",
          "tip": [
            "ES2017"
          ]
        },
        {
          "name": "es2020",
          "tip": [
            "ES2020"
          ]
        },
        {
          "name": "esnext",
          "tip": [
            "Latest ECMAScript version (default)"
          ]
        },
        {
          "name": "firefox57",
          "tip": [
            "Firefox 57"
          ]
        },
        {
          "name": "ie9",
          "tip": [
            "Internet Explorer 9"
          ]
        },
        {
          "name": "node10",
          "tip": [
            "Node.js 10"
          ]
        },
        {
          "name": "opera45",
          "tip": [
            "Opera 45"
          ]
        },
        {
          "name": "safari11",
          "tip": [
            "Safari 11"
          ]
        }
      ]
    },
    {
      "name": "--tree-shaking",
      "usage": [
        "--tree-shaking=<VALUE>"
      ],
      "tip": [
        "Force tree shaking on or off"
      ],
      "next": [
        {
          "name": "false",
          "tip": [
            "Disable tree shaking"
          ]
        },
        {
          "name": "true",
          "tip": [
            "Enable tree shaking"
          ]
        }
      ]
    },
    {
      "name": "--tsconfig",
      "usage": [
        "--tsconfig=<FILE>"
      ],
      "tip": [
        "Use this tsconfig.json file instead of other ones"
      ],
      "next": []
    },
    {
      "name": "--tsconfig-raw",
      "usage": [
        "--tsconfig-raw=<JSON>"
      ],
      "tip": [
        "Override all tsconfig.json files with this string"
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "Print the current version and exit"
      ]
    },
    {
      "name": "--watch",
      "tip": [
        "Watch mode: rebuild on file system changes (stops when stdin is closed, use \"--watch=forever\" to ignore stdin)"
      ]
    },
    {
      "name": "--watch-delay",
      "usage": [
        "--watch-delay=<MS>"
      ],
      "tip": [
        "Wait before watch mode rebuilds (in milliseconds)"
      ],
      "next": []
    }
  ]
}
