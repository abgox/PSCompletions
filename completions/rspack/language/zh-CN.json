{
  "meta": {
    "url": "https://rspack.rs",
    "description": [
      "快速的 Rust 网页打包工具，兼容现代 webpack API。"
    ]
  },
  "next": [
    {
      "name": "preview",
      "usage": [
        "preview [dir]"
      ],
      "tip": [
        "为构建产物运行 Rspack 服务器。"
      ],
      "option": [
        {
          "name": "--host",
          "usage": [
            "--host <HOST>"
          ],
          "tip": [
            "预览服务器的主机。"
          ],
          "next": []
        },
        {
          "name": "--open",
          "tip": [
            "打开浏览器。"
          ]
        },
        {
          "name": "--port",
          "usage": [
            "--port <PORT>"
          ],
          "tip": [
            "预览服务器的端口。"
          ],
          "next": [
            {
              "name": "3000"
            },
            {
              "name": "80"
            },
            {
              "name": "8080"
            }
          ]
        },
        {
          "name": "--public-path",
          "usage": [
            "--public-path <PATH>"
          ],
          "tip": [
            "静态资源服务器路径。"
          ],
          "next": []
        },
        {
          "name": "--server",
          "usage": [
            "--server <CONFIG>"
          ],
          "tip": [
            "服务器的配置项。"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "serve",
      "tip": [
        "运行 Rspack 开发服务器。"
      ],
