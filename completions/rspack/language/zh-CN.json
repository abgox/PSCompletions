        {
          "name": "--devtool",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --devtool <VALUE>"
          ],
          "tip": [
            "设置调试用的 source map 风格。",
            "用 false 禁用 source map。"
          ],
          "next": [
            {
              "name": "cheap-module-source-map",
              "tip": [
                "无列信息的廉价 source map。"
              ]
            },
            {
              "name": "eval",
              "tip": [
                "基于 eval 的模块，重新构建更快。"
              ]
            },
            {
              "name": "false",
              "tip": [
                "禁用 source map。"
              ]
            },
            {
              "name": "source-map",
              "tip": [
                "完整的独立 source map。"
              ]
            }
          ]
        },
        {
          "name": "--entry",
          "usage": [
            "--entry <ENTRY>"
          ],
          "tip": [
            "入口文件。"
          ],
          "next": []
        },
        {
          "name": "--host",
          "usage": [
            "--host <HOST>"
          ],
          "tip": [
            "指定要使用的主机名。"
          ],
          "next": []
        },
        {
          "name": "--hot",
