            "构建模式。"
          ],
          "next": [
            {
              "name": "development",
              "tip": [
                "启用开发默认配置。"
              ]
            },
            {
              "name": "none",
              "tip": [
                "禁用所有默认优化。"
              ]
            },
            {
              "name": "production",
              "tip": [
                "启用生产优化。"
              ]
            }
          ]
        },
        {
          "name": "--no-open",
          "tip": [
            "服务器启动时不打开浏览器。"
          ]
        },
        {
          "name": "--open",
          "usage": [
            "--open [<URL>]"
          ],
          "tip": [
            "服务器启动时打开浏览器；传 --no-open 禁用，或 --open <url> 打开指定 URL。"
          ],
          "next": []
        },
        {
          "name": "--output-path",
          "alias": [
            "-o"
          ],
          "usage": [
            "-o, --output-path <DIR>"
          ],
          "tip": [
            "输出目录。"
          ],
          "next": []
        },
        {
          "name": "--port",
          "usage": [
            "--port <PORT>"
          ],
          "tip": [
            "指定要使用的端口。"
          ],
          "next": [
            {
              "name": "3000"
            },
            {
              "name": "80"
            },
            {
              "name": "8080"
            }
          ]
        },
        {
          "name": "--watch",
          "alias": [
            "-w"
          ],
          "usage": [
            "-w, --watch"
          ],
          "tip": [
            "监听文件变化并重新构建。"
          ]
        }
      ]
    }
