{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "输出用于设置 LS_COLORS 环境变量的命令。"
    ]
  },
  "option": [
    {
      "name": "--bourne-shell",
      "alias": [
        "--sh",
        "-b"
      ],
      "usage": [
        "-b, --sh, --bourne-shell"
      ],
      "tip": [
        "输出设置 LS_COLORS 的 Bourne shell 代码"
      ]
    },
    {
      "name": "--c-shell",
      "alias": [
        "--csh",
        "-c"
      ],
      "usage": [
        "-c, --csh, --c-shell"
      ],
      "tip": [
        "输出设置 LS_COLORS 的 C shell 代码"
      ]
    },
    {
      "name": "--print-database",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --print-database"
      ],
      "tip": [
        "输出默认值"
      ]
    },
    {
      "name": "--print-ls-colors",
      "tip": [
        "输出完全转义的颜色以便显示"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
