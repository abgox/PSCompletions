{
  "meta": {
    "url": "https://github.com/sachaos/viddy",
    "description": [
      "现代 watch 命令",
      "时间机器和分页器等"
    ]
  },
  "option": [
    {
      "name": "--bell",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bell"
      ],
      "tip": [
        "更新之间有变化时响铃"
      ]
    },
    {
      "name": "--debug",
      "tip": [
        "启用调试模式"
      ]
    },
    {
      "name": "--deletion-differences",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --deletion-differences"
      ],
      "tip": [
        "高亮删除的变化"
      ]
    },
    {
      "name": "--differences",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --differences"
      ],
      "tip": [
        "高亮更新之间的变化"
      ]
    },
    {
      "name": "--disable-auto-save",
      "tip": [
        "禁用自动保存"
      ]
    },
    {
      "name": "--disable-mouse",
      "tip": [
        "停止处理鼠标事件"
      ]
    },
    {
      "name": "--exec",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exec"
      ],
      "tip": [
        "将命令传递给 exec 而非 Shell"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    },
    {
      "name": "--interval",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --interval <SECONDS>"
      ],
      "tip": [
        "更新间隔秒数（>= 100ms）"
      ],
      "next": [
        {
          "name": "30"
        },
        {
          "name": "5"
        },
        {
          "name": "60"
        }
      ]
    },
    {
      "name": "--load",
      "usage": [
        "--load <FILE>"
      ],
      "tip": [
        "要加载的备份文件路径"
      ],
      "next": []
    },
    {
      "name": "--no-title",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --no-title"
      ],
      "tip": [
        "关闭标题栏"
      ]
    },
    {
      "name": "--precise",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --precise"
      ],
      "tip": [
        "尝试以精确间隔运行命令"
      ]
    },
    {
      "name": "--save",
      "usage": [
        "--save <FILE>"
      ],
      "tip": [
        "备份文件路径"
      ],
      "next": []
    },
    {
      "name": "--shell",
      "usage": [
        "--shell <SHELL>"
      ],
      "tip": [
        "使用的 Shell"
      ],
      "next": []
    },
    {
      "name": "--shell-options",
      "usage": [
        "--shell-options [<OPTIONS>...]"
      ],
      "tip": [
        "额外的 Shell 选项"
      ],
      "next": []
    },
    {
      "name": "--skip-empty-diffs",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --skip-empty-diffs"
      ],
      "tip": [
        "跳过历史中无变化的快照"
      ]
    },
    {
      "name": "--unfold",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --unfold"
      ],
      "tip": [
        "关闭自动换行"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ]
}
