{
  "meta": {
    "url": "https://github.com/sachaos/viddy",
    "description": [
      "A modern watch command",
      "Time machine and pager etc."
    ]
  },
  "option": [
    {
      "name": "--bell",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bell"
      ],
      "tip": [
        "Ring terminal bell on changes between updates"
      ]
    },
    {
      "name": "--debug",
      "tip": [
        "Enable debug mode"
      ]
    },
    {
      "name": "--deletion-differences",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --deletion-differences"
      ],
      "tip": [
        "Highlight deletion changes between updates"
      ]
    },
    {
      "name": "--differences",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --differences"
      ],
      "tip": [
        "Highlight changes between updates"
      ]
    },
    {
      "name": "--disable-auto-save",
      "tip": [
        "Disable automatic save"
      ]
    },
    {
      "name": "--disable-mouse",
      "tip": [
        "Stop handling mouse events"
      ]
    },
    {
      "name": "--exec",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exec"
      ],
      "tip": [
        "Pass command to exec instead of shell"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    },
    {
      "name": "--interval",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --interval <SECONDS>"
      ],
      "tip": [
        "Seconds to wait between updates (>= 100ms)"
      ],
      "next": [
        {
          "name": "30"
        },
        {
          "name": "5"
        },
        {
          "name": "60"
        }
      ]
    },
    {
      "name": "--load",
      "usage": [
        "--load <FILE>"
      ],
      "tip": [
        "Path to the backup file to load"
      ],
      "next": []
    },
    {
      "name": "--no-title",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --no-title"
      ],
      "tip": [
        "Turn off header"
      ]
    },
    {
      "name": "--precise",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --precise"
      ],
      "tip": [
        "Attempt run command in precise intervals"
      ]
    },
    {
      "name": "--save",
      "usage": [
        "--save <FILE>"
      ],
      "tip": [
        "Path to the backup file"
      ],
      "next": []
    },
    {
      "name": "--shell",
      "usage": [
        "--shell <SHELL>"
      ],
      "tip": [
        "Shell to use"
      ],
      "next": []
    },
    {
      "name": "--shell-options",
      "usage": [
        "--shell-options [<OPTIONS>...]"
      ],
      "tip": [
        "Additional shell options"
      ],
      "next": []
    },
    {
      "name": "--skip-empty-diffs",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --skip-empty-diffs"
      ],
      "tip": [
        "Skip snapshots with no changes in history"
      ]
    },
    {
      "name": "--unfold",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --unfold"
      ],
      "tip": [
        "Turn off line wrapping"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ]
}
