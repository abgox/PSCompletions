{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "显示系统和用户路径。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--suffix",
      "usage": [
        "--suffix=SUFFIX"
      ],
      "tip": [
        "追加到路径的后缀。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    }
  ]
}
