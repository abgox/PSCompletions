{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Show system and user paths."
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--suffix",
      "usage": [
        "--suffix=SUFFIX"
      ],
      "tip": [
        "Suffix to append to the paths."
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    }
  ]
}
