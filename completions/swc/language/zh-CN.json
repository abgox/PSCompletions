{
  "meta": {
    "url": "https://swc.rs/",
    "description": [
      "超快的 TypeScript/JavaScript 编译器。"
    ]
  },
  "option": [
    {
      "name": "--cli-config-file",
      "usage": [
        "--cli-config-file <PATH>"
      ],
      "tip": [
        "包含 CLI 选项的 JSON 文件路径"
      ],
      "next": []
    },
    {
      "name": "--config",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --config <CONFIG>"
      ],
      "tip": [
        "覆盖 .swcrc 文件中的配置"
      ],
      "next": []
    },
    {
      "name": "--config-file",
      "usage": [
        "--config-file <PATH>"
      ],
      "tip": [
        "要使用的 .swcrc 文件路径"
      ],
      "next": []
    },
    {
      "name": "--copy-files",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --copy-files"
      ],
      "tip": [
        "编译目录时复制不可编译的文件"
      ]
    },
    {
      "name": "--delete-dir-on-start",
      "tip": [
        "启动时是否删除输出目录"
      ]
    },
    {
      "name": "--env-name",
      "usage": [
        "--env-name <NAME>"
      ],
      "tip": [
        "加载配置和插件时使用的环境名称"
      ],
      "next": []
    },
    {
      "name": "--extensions",
      "usage": [
        "--extensions <LIST>"
      ],
      "tip": [
        "使用特定的扩展名"
      ],
      "next": []
    },
    {
      "name": "--filename",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --filename <FILENAME>"
      ],
      "tip": [
        "从 stdin 读取时使用的文件名"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息"
      ]
    },
    {
      "name": "--ignore",
      "usage": [
        "--ignore <LIST>"
      ],
      "tip": [
        "不需要编译的 glob 路径列表"
      ],
      "next": []
    },
    {
      "name": "--include-dotfiles",
      "tip": [
        "编译和复制不可编译文件时包含点文件"
      ]
    },
    {
      "name": "--log-watch-compilation",
      "tip": [
        "监视的文件成功编译时记录消息"
      ]
    },
    {
      "name": "--no-swcrc",
      "tip": [
        "是否查找 .swcrc 文件"
      ]
    },
    {
      "name": "--only",
      "usage": [
        "--only <LIST>"
      ],
      "tip": [
        "仅编译的 glob 路径列表"
      ],
      "next": []
    },
    {
      "name": "--out-dir",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --out-dir <OUT>"
      ],
      "tip": [
        "将输入模块目录编译到输出目录"
      ],
      "next": []
    },
    {
      "name": "--out-file",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --out-file <OUT>"
      ],
      "tip": [
        "将所有输入文件编译为单个文件"
      ],
      "next": []
    },
    {
      "name": "--out-file-extension",
      "usage": [
        "--out-file-extension <STRING>"
      ],
      "tip": [
        "为输出文件使用特定的扩展名"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制编译输出"
      ]
    },
    {
      "name": "--source-file-name",
      "usage": [
        "--source-file-name <STRING>"
      ],
      "tip": [
        "设置返回 source map 的 `sources[0]` 字段"
      ],
      "next": []
    },
    {
      "name": "--source-map-target",
      "usage": [
        "--source-map-target <STRING>"
      ],
      "tip": [
        "设置返回 source map 的 `file` 字段"
      ],
      "next": []
    },
    {
      "name": "--source-maps",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --source-maps <VALUE>"
      ],
      "tip": [
        "生成 source maps"
      ],
      "next": [
        {
          "name": "both",
          "tip": [
            "同时生成内联和外部 source maps"
          ]
        },
        {
          "name": "false",
          "tip": [
            "禁用 source maps"
          ]
        },
        {
          "name": "inline",
          "tip": [
            "将 source maps 内联为数据 URL"
          ]
        },
        {
          "name": "true",
          "tip": [
            "生成外部 source maps"
          ]
        }
      ]
    },
    {
      "name": "--source-root",
      "usage": [
        "--source-root <FILENAME>"
      ],
      "tip": [
        "所有源文件的相对根路径"
      ],
      "next": []
    },
    {
      "name": "--strip-leading-paths",
      "tip": [
        "构建最终输出路径时移除前导目录"
      ]
    },
    {
      "name": "--sync",
      "tip": [
        "同步调用 swc"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "输出版本号"
      ]
    },
    {
      "name": "--watch",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --watch"
      ],
      "tip": [
        "文件更改时重新编译"
      ]
    },
    {
      "name": "--workers",
      "usage": [
        "--workers <NUMBER>"
      ],
      "tip": [
        "用于并行处理的工作线程数"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    }
  ]
}
