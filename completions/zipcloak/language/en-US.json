{
  "meta": {
    "url": "https://infozip.sourceforge.net/Zip.html",
    "description": [
      "Encrypt and decrypt entries in ZIP archives with Info-ZIP ZipCloak."
    ]
  },
  "option": [
    {
      "name": "--decrypt",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --decrypt"
      ],
      "tip": [
        "decrypt encrypted entries, copying them if the password is wrong"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "show help"
      ]
    },
    {
      "name": "--license",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --license"
      ],
      "tip": [
        "show the software license"
      ]
    },
    {
      "name": "--output-file",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --output-file <zipfile>"
      ],
      "tip": [
        "write the output to a new zip file"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "quiet operation; suppress some informational messages"
      ]
    },
    {
      "name": "--temp-path",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --temp-path <path>"
      ],
      "tip": [
        "use the given path for the temporary zip file"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "show version information"
      ]
    }
  ]
}
