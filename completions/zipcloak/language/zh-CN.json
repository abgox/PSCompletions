{
  "meta": {
    "url": "https://infozip.sourceforge.net/Zip.html",
    "description": [
      "使用 Info-ZIP ZipCloak 加密和解密 ZIP 归档中的条目。"
    ]
  },
  "option": [
    {
      "name": "--decrypt",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --decrypt"
      ],
      "tip": [
        "解密加密条目；密码错误时复制条目"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助"
      ]
    },
    {
      "name": "--license",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --license"
      ],
      "tip": [
        "显示软件许可证"
      ]
    },
    {
      "name": "--output-file",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --output-file <zipfile>"
      ],
      "tip": [
        "将输出写入新的 zip 文件"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "静默操作；抑制部分信息性消息"
      ]
    },
    {
      "name": "--temp-path",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --temp-path <path>"
      ],
      "tip": [
        "使用给定路径存放临时 zip 文件"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示版本信息"
      ]
    }
  ]
}
