{
  "meta": {
    "url": "https://www.sudo.ws/",
    "description": [
      "以另一个用户的身份执行命令。"
    ]
  },
  "option": [
    {
      "name": "--",
      "tip": [
        "停止处理命令行参数。"
      ]
    },
    {
      "name": "--askpass",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --askpass"
      ],
      "tip": [
        "使用辅助程序进行密码提示。"
      ]
    },
    {
      "name": "--background",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --background"
      ],
      "tip": [
        "在后台运行命令。"
      ]
    },
    {
      "name": "--bell",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --bell"
      ],
      "tip": [
        "在提示时响铃。"
      ]
    },
    {
      "name": "--chdir",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --chdir <DIRECTORY>"
      ],
      "tip": [
        "在运行命令之前更改工作目录。"
      ],
      "next": []
    },
    {
      "name": "--chroot",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --chroot <DIRECTORY>"
      ],
      "tip": [
        "在运行命令之前更改根目录。"
      ],
      "next": []
    },
    {
      "name": "--close-from",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --close-from <NUM>"
      ],
      "tip": [
        "关闭所有大于等于 NUM 的文件描述符。"
      ],
      "next": []
    },
    {
      "name": "--command-timeout",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --command-timeout <TIMEOUT>"
      ],
      "tip": [
        "在指定的时间限制后终止命令。"
      ],
      "next": []
    },
    {
      "name": "--edit",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --edit"
      ],
      "tip": [
        "编辑文件而不是运行命令。"
      ]
    },
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group <GROUP>"
      ],
      "tip": [
        "以指定的组名或组 ID 运行命令。"
      ],
      "next": []
    },
    {
      "name": "--host",
      "usage": [
        "--host <HOST>"
      ],
      "tip": [
        "在主机上运行命令（如果插件支持）。"
      ],
      "next": []
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "列出用户的权限或检查特定命令。",
        "使用两次以显示更详细的格式。"
      ],
      "repeat": 2
    },
    {
      "name": "--login",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --login"
      ],
      "tip": [
        "以目标用户的身份运行登录 shell；也可以同时指定命令。"
      ]
    },
    {
      "name": "--non-interactive",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --non-interactive"
      ],
      "tip": [
        "非交互模式，不使用任何提示。"
      ]
    },
    {
      "name": "--other-user",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --other-user <USER>"
      ],
      "tip": [
        "在列表模式下，显示该用户的权限。"
      ],
      "next": []
    },
    {
      "name": "--preserve-env",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --preserve-env[=<LIST>]"
      ],
      "tip": [
        "在运行命令时保留用户环境。",
        "带列表值时，仅保留指定的环境变量。"
      ],
      "next": []
    },
    {
      "name": "--preserve-groups",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --preserve-groups"
      ],
      "tip": [
        "保留组向量，而不是设置为目标用户的组向量。"
      ]
    },
    {
      "name": "--prompt",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --prompt <PROMPT>"
      ],
      "tip": [
        "使用指定的密码提示。"
      ],
      "next": []
    },
    {
      "name": "--remove-timestamp",
      "alias": [
        "-K"
      ],
      "usage": [
        "-K, --remove-timestamp"
      ],
      "tip": [
        "完全删除时间戳文件。"
      ]
    },
    {
      "name": "--reset-timestamp",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --reset-timestamp"
      ],
      "tip": [
        "使时间戳文件失效。"
      ]
    },
    {
      "name": "--role",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --role <ROLE>"
      ],
      "tip": [
        "创建具有指定角色的 SELinux 安全上下文。"
      ],
      "next": []
    },
    {
      "name": "--set-home",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --set-home"
      ],
      "tip": [
        "将 HOME 变量设置为目标用户的主目录。"
      ]
    },
    {
      "name": "--shell",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shell"
      ],
      "tip": [
        "以目标用户的身份运行 shell；也可以同时指定命令。"
      ]
    },
    {
      "name": "--stdin",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --stdin"
      ],
      "tip": [
        "从标准输入读取密码。"
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "创建具有指定类型的 SELinux 安全上下文。"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <USER>"
      ],
      "tip": [
        "以指定的用户名或用户 ID 运行命令（或编辑文件）。"
      ],
      "next": []
    },
    {
      "name": "--validate",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --validate"
      ],
      "tip": [
        "更新用户的时间戳而不运行命令。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息并退出。"
      ]
    }
  ]
}
