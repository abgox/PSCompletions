{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "输出每个 NAME，去掉其末尾的斜杠后只保留最后一段；如果 NAME 中不含 /，则输出 '.'（表示当前目录）。"
    ]
  },
  "option": [
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "每行输出以 NUL 结尾，而不是换行符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
