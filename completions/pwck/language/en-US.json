{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "Verify the integrity of password files."
    ]
  },
  "option": [
    {
      "name": "--badname",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --badname"
      ],
      "tip": [
        "Allow names that do not conform to standards. (deprecated)"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display help message and exit."
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Report errors only."
      ]
    },
    {
      "name": "--read-only",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --read-only"
      ],
      "tip": [
        "Display errors and warnings but do not change files."
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "Apply changes in the CHROOT_DIR directory and use the configuration files from the CHROOT_DIR directory.",
        "Only absolute paths are supported."
      ],
      "next": []
    },
    {
      "name": "--sort",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sort"
      ],
      "tip": [
        "Sort entries in /etc/passwd and /etc/shadow."
      ]
    }
  ]
}
