{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "校验密码文件的完整性。"
    ]
  },
  "option": [
    {
      "name": "--badname",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --badname"
      ],
      "tip": [
        "允许不符合标准的名称。(已弃用)"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "仅报告错误。"
      ]
    },
    {
      "name": "--read-only",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --read-only"
      ],
      "tip": [
        "显示错误和警告，但不修改文件。"
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--sort",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sort"
      ],
      "tip": [
        "对 /etc/passwd 和 /etc/shadow 中的条目排序。"
      ]
    }
  ]
}
