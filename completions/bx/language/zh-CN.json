      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--api-key",
      "usage": [
        "--api-key <KEY>"
      ],
      "tip": [
        "API Key。推荐使用环境变量或配置文件 —— 命令行参数在进程列表中可见。"
      ],
      "next": []
    },
    {
      "name": "--base-url",
      "usage": [
        "--base-url <URL>"
      ],
      "tip": [
        "API 基础 URL（默认：https://api.search.brave.com）。"
      ],
      "next": []
    },
    {
      "name": "--config",
      "usage": [
        "--config <PATH>"
      ],
      "tip": [
        "配置文件路径（例如区分 dev 和 prod 各用一个）。"
      ],
      "next": []
    },
    {
      "name": "--endpoint",
      "usage": [
        "--endpoint <PATH>"
      ],
      "tip": [
        "覆盖 API 路径（例如 /res/v1/web/search）。用于 Brave 内部或 Beta 接口。"
      ],
      "next": []
    },
    {
      "name": "--extra",
      "usage": [
        "--extra <KEY=VALUE>"
      ],
      "tip": [
        "不在命名参数覆盖范围内的额外 API 参数（可重复）。",
        "合并到请求体（POST）或查询字符串（GET）。POST 的值会自动推断类型。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息。"
      ]
    },
    {
      "name": "--timeout",
      "usage": [
        "--timeout <SECONDS>"
      ],
      "tip": [
        "请求超时（秒）（默认：30；--enable-research 下为 300；最大：86400）。"
      ],
      "next": [
        {
          "name": "30"
        },
        {
          "name": "300"
        },
        {
          "name": "60"
        }
      ]
    }
  ]
}
