    {
      "name": "answers",
      "usage": [
        "answers <QUERY|->"
      ],
      "tip": [
        "AI-grounded answers — OpenAI-compatible, streaming by default.",
        "Pass a question directly, or - to read a full JSON request body from stdin."
      ],
      "example": [
        {
          "cmd": "bx answers \"explain Rust lifetimes with examples\"",
          "desc": "Streaming AI answer"
        },
        {
          "cmd": "bx answers \"compare SQLx and Diesel\" --no-stream",
          "desc": "Single JSON response"
        },
        {
          "cmd": "bx answers \"what changed in React 19 vs React 18?\" --enable-research",
          "desc": "Iterative deep research"
        }
      ],
