    {
      "name": "context",
      "usage": [
        "context <QUERY>"
      ],
      "tip": [
        "RAG/LLM grounding — pre-extracted web content, clean text, token-budgeted.",
        "The recommended endpoint for AI agents. One call replaces search + scrape + extract."
      ],
      "example": [
        {
          "cmd": "bx \"tokio spawn async task example\"",
          "desc": "Shorthand for bx context (default subcommand)"
        },
        {
          "cmd": "bx context \"Python TypeError cannot unpack non-iterable NoneType\" --max-tokens 4096",
          "desc": "RAG grounding with a token budget"
        },
        {
          "cmd": "bx context \"axum middleware\" --include-site docs.rs --max-tokens 4096",
          "desc": "Restrict results to specific domains"
