{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "在数字和人类可读字符串之间转换。"
    ]
  },
  "option": [
    {
      "name": "--debug",
      "tip": [
        "打印关于无效输入的警告"
      ]
    },
    {
      "name": "--delimiter",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delimiter <X>"
      ],
      "tip": [
        "使用 X 代替空白字符作为字段分隔符"
      ],
      "next": []
    },
    {
      "name": "--field",
      "usage": [
        "--field <FIELDS>"
      ],
      "tip": [
        "替换这些输入字段中的数字；参见下方 FIELDS [默认值: 1]"
      ],
      "next": []
    },
    {
      "name": "--format",
      "usage": [
        "--format <FORMAT>"
      ],
      "tip": [
        "使用 printf 风格的浮点 FORMAT；详见下方 FORMAT"
      ],
      "next": []
    },
    {
      "name": "--from",
      "usage": [
        "--from <UNIT>"
      ],
      "tip": [
        "自动缩放输入数字到 UNIT；参见下方 UNIT [默认值: none]"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "接受可选的单/双字母后缀：",
            "1K = 1000, 1Ki = 1024, 1M = 1000000, 1Mi = 1048576"
          ]
        },
        {
          "name": "iec",
          "tip": [
            "接受可选的单字母后缀：",
            "1K = 1024, 1M = 1048576, ..."
          ]
        },
        {
          "name": "iec-i",
          "tip": [
            "接受可选的双字母后缀：",
            "1Ki = 1024, 1Mi = 1048576, ..."
          ]
        },
        {
          "name": "none",
          "tip": [
            "不进行自动缩放；后缀将触发错误"
          ]
        },
        {
          "name": "si",
          "tip": [
            "接受可选的单字母后缀：",
            "1K = 1000, 1M = 1000000, ..."
          ]
        }
      ]
    },
    {
      "name": "--from-unit",
      "usage": [
        "--from-unit <N>"
      ],
      "tip": [
        "指定输入单位大小 [默认值: 1]"
      ],
      "next": []
    },
    {
      "name": "--grouping",
      "tip": [
        "使用区域设置定义的数字分组，例如 1,000,000",
        "（这意味着在 C/POSIX 区域设置中没有效果）"
      ]
    },
    {
      "name": "--header",
      "usage": [
        "--header [<N>]"
      ],
      "tip": [
        "打印（不转换）前 N 行标题行；未指定时 N 默认为 1"
      ],
      "next": []
    },
    {
      "name": "--invalid",
      "usage": [
        "--invalid <INVALID>"
      ],
      "tip": [
        "设置无效输入的失败模式 [默认值: abort]",
        "[可能的值: abort, fail, warn, ignore]"
      ],
      "next": [
        {
          "name": "abort"
        },
        {
          "name": "fail"
        },
        {
          "name": "ignore"
        },
        {
          "name": "warn"
        }
      ]
    },
    {
      "name": "--padding",
      "usage": [
        "--padding <N>"
      ],
      "tip": [
        "将输出填充到 N 个字符；",
        "正数 N 右对齐；负数 N 左对齐；",
        "如果输出宽度超过 N 则忽略填充；",
        "默认情况下，如果发现空白字符则自动填充"
      ],
      "next": []
    },
    {
      "name": "--round",
      "usage": [
        "--round <METHOD>"
      ],
      "tip": [
        "缩放时使用 METHOD 进行舍入 [默认值: from-zero]",
        "[可能的值: up, down, from-zero, towards-zero, nearest]"
      ],
      "next": [
        {
          "name": "down"
        },
        {
          "name": "from-zero"
        },
        {
          "name": "nearest"
        },
        {
          "name": "towards-zero"
        },
        {
          "name": "up"
        }
      ]
    },
    {
      "name": "--suffix",
      "usage": [
        "--suffix <SUFFIX>"
      ],
      "tip": [
        "在每个格式化数字后打印 SUFFIX，并接受可选以 SUFFIX 结尾的输入"
      ],
      "next": []
    },
    {
      "name": "--to",
      "usage": [
        "--to <UNIT>"
      ],
      "tip": [
        "自动缩放输出数字到 UNIT；参见下方 UNIT [默认值: none]"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "接受可选的单/双字母后缀：",
            "1K = 1000, 1Ki = 1024, 1M = 1000000, 1Mi = 1048576"
          ]
        },
        {
          "name": "iec",
          "tip": [
            "接受可选的单字母后缀：",
            "1K = 1024, 1M = 1048576, ..."
          ]
        },
        {
          "name": "iec-i",
          "tip": [
            "接受可选的双字母后缀：",
            "1Ki = 1024, 1Mi = 1048576, ..."
          ]
        },
        {
          "name": "none",
          "tip": [
            "不进行自动缩放；后缀将触发错误"
          ]
        },
        {
          "name": "si",
          "tip": [
            "接受可选的单字母后缀：",
            "1K = 1000, 1M = 1000000, ..."
          ]
        }
      ]
    },
    {
      "name": "--to-unit",
      "usage": [
        "--to-unit <N> "
      ],
      "tip": [
        "输出单位大小 [默认值: 1]"
      ],
      "next": []
    },
    {
      "name": "--unit-separator",
      "usage": [
        "--unit-separator <STRING>"
      ],
      "tip": [
        "打印时使用 STRING 将数字与任何单位分隔",
        "默认情况下，不使用分隔符"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "行分隔符是 NUL，而不是换行符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
