{
  "meta": {
    "url": "https://neovim.io/",
    "description": [
      "专注于可扩展性和易用性的 Vim 分支。"
    ]
  },
  "option": [
    {
      "name": "--api-info",
      "tip": [
        "将 msgpack 编码的 API 元数据写入 stdout。"
      ]
    },
    {
      "name": "--clean",
      "tip": [
        "恢复出厂设置（跳过用户配置和插件，shada）。"
      ]
    },
    {
      "name": "--embed",
      "tip": [
        "使用 stdin/stdout 作为 msgpack-rpc 通道。"
      ]
    },
    {
      "name": "--headless",
      "tip": [
        "不启动用户界面。"
      ]
    },
    {
      "name": "--listen",
      "usage": [
        "--listen <address>"
      ],
      "tip": [
        "从此地址提供 RPC API。"
      ],
      "example": [
        "--listen /tmp/nvim.sock"
      ],
      "next": []
    },
    {
      "name": "--remote",
      "tip": [
        "在服务器上远程执行命令。"
      ]
    },
    {
      "name": "--server",
      "usage": [
        "--server <address>"
      ],
      "tip": [
        "连接到此 Nvim 服务器。"
      ],
      "example": [
        "--server /tmp/nvim.sock"
      ],
      "next": []
    },
    {
      "name": "--startuptime",
      "usage": [
        "--startuptime <file>"
      ],
      "tip": [
        "将启动计时信息写入 <file>。"
      ],
      "example": [
        "--startuptime startup.log"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "打印版本信息。"
      ]
    },
    {
      "name": "-c",
      "usage": [
        "-c <cmd>"
      ],
      "tip": [
        "在配置和第一个文件之后执行 <cmd>。"
      ],
      "example": [
        "-c 'set number'"
      ],
      "next": []
    },
    {
      "name": "-d",
      "tip": [
        "差异模式。"
      ]
    },
    {
      "name": "-es",
      "tip": [
        "静默（批处理）模式。"
      ]
    },
    {
      "name": "-i",
      "usage": [
        "-i <shada>"
      ],
      "tip": [
        "使用此 shada 文件。"
      ],
      "example": [
        "-i shada"
      ],
      "next": []
    },
    {
      "name": "-l",
      "usage": [
        "-l <script> [args...]"
      ],
      "tip": [
        "执行 Lua <script>（可选参数）。"
      ],
      "example": [
        "-l init.lua"
      ],
      "next": []
    },
    {
      "name": "-n",
      "tip": [
        "不使用交换文件，仅使用内存。"
      ]
    },
    {
      "name": "-o",
      "usage": [
        "-o[N]"
      ],
      "tip": [
        "打开 N 个窗口（默认：每个文件一个）。"
      ],
      "example": [
        "-o3"
      ],
      "next": []
    },
    {
      "name": "-O",
      "usage": [
        "-O[N]"
      ],
      "tip": [
        "打开 N 个垂直窗口（默认：每个文件一个）。"
      ],
      "example": [
        "-O3"
      ],
      "next": []
    },
    {
      "name": "-p",
      "usage": [
        "-p[N]"
      ],
      "tip": [
        "打开 N 个标签页（默认：每个文件一个）。"
      ],
      "example": [
        "-p3"
      ],
      "next": []
    },
    {
      "name": "-R",
      "tip": [
        "只读（查看）模式。"
      ]
    },
    {
      "name": "-s",
      "usage": [
        "-s <scriptin>"
      ],
      "tip": [
        "从 <scriptin> 读取普通模式命令。"
      ],
      "example": [
        "-s scriptin"
      ],
      "next": []
    },
    {
      "name": "-S",
      "usage": [
        "-S <session>"
      ],
      "tip": [
        "加载第一个文件后源 <session>。"
      ],
      "example": [
        "-S Session.vim"
      ],
      "next": []
    },
    {
      "name": "-u",
      "usage": [
        "-u <config>"
      ],
      "tip": [
        "使用此配置文件。"
      ],
      "example": [
        "-u NONE"
      ],
      "next": []
    },
    {
      "name": "-V",
      "usage": [
        "-V[N][file]"
      ],
      "tip": [
        "详细输出 [级别][文件]。"
      ],
      "example": [
        "-V9mylog.txt"
      ],
      "next": []
    },
    {
      "name": "+",
      "usage": [
        "+<cmd>"
      ],
      "tip": [
        "在配置和第一个文件之后执行 <cmd>。"
      ],
      "example": [
        "+10"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息。"
      ]
    }
  ]
}
