{
  "meta": {
    "url": "https://neovim.io/",
    "description": [
      "Vim-fork focused on extensibility and usability."
    ]
  },
  "option": [
    {
      "name": "--api-info",
      "tip": [
        "Write msgpack-encoded API metadata to stdout."
      ]
    },
    {
      "name": "--clean",
      "tip": [
        "\"Factory defaults\" (skip user config and plugins, shada)."
      ]
    },
    {
      "name": "--embed",
      "tip": [
        "Use stdin/stdout as a msgpack-rpc channel."
      ]
    },
    {
      "name": "--headless",
      "tip": [
        "Don't start a user interface."
      ]
    },
    {
      "name": "--listen",
      "usage": [
        "--listen <address>"
      ],
      "tip": [
        "Serve RPC API from this address."
      ],
      "example": [
        "--listen /tmp/nvim.sock"
      ],
      "next": []
    },
    {
      "name": "--remote",
      "tip": [
        "Execute commands remotely on a server."
      ]
    },
    {
      "name": "--server",
      "usage": [
        "--server <address>"
      ],
      "tip": [
        "Connect to this Nvim server."
      ],
      "example": [
        "--server /tmp/nvim.sock"
      ],
      "next": []
    },
    {
      "name": "--startuptime",
      "usage": [
        "--startuptime <file>"
      ],
      "tip": [
        "Write startup timing messages to <file>."
      ],
      "example": [
        "--startuptime startup.log"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Print version information."
      ]
    },
    {
      "name": "-c",
      "usage": [
        "-c <cmd>"
      ],
      "tip": [
        "Execute <cmd> after config and first file."
      ],
      "example": [
        "-c 'set number'"
      ],
      "next": []
    },
    {
      "name": "-d",
      "tip": [
        "Diff mode."
      ]
    },
    {
      "name": "-es",
      "tip": [
        "Silent (batch) mode."
      ]
    },
    {
      "name": "-i",
      "usage": [
        "-i <shada>"
      ],
      "tip": [
        "Use this shada file."
      ],
      "example": [
        "-i shada"
      ],
      "next": []
    },
    {
      "name": "-l",
      "usage": [
        "-l <script> [args...]"
      ],
      "tip": [
        "Execute Lua <script> with optional args."
      ],
      "example": [
        "-l init.lua"
      ],
      "next": []
    },
    {
      "name": "-n",
      "tip": [
        "No swap file, use memory only."
      ]
    },
    {
      "name": "-o",
      "usage": [
        "-o[N]"
      ],
      "tip": [
        "Open N windows (default: one per file)."
      ],
      "example": [
        "-o3"
      ],
      "next": []
    },
    {
      "name": "-O",
      "usage": [
        "-O[N]"
      ],
      "tip": [
        "Open N vertical windows (default: one per file)."
      ],
      "example": [
        "-O3"
      ],
      "next": []
    },
    {
      "name": "-p",
      "usage": [
        "-p[N]"
      ],
      "tip": [
        "Open N tab pages (default: one per file)."
      ],
      "example": [
        "-p3"
      ],
      "next": []
    },
    {
      "name": "-R",
      "tip": [
        "Read-only (view) mode."
      ]
    },
    {
      "name": "-s",
      "usage": [
        "-s <scriptin>"
      ],
      "tip": [
        "Read Normal mode commands from <scriptin>."
      ],
      "example": [
        "-s scriptin"
      ],
      "next": []
    },
    {
      "name": "-S",
      "usage": [
        "-S <session>"
      ],
      "tip": [
        "Source <session> after loading the first file."
      ],
      "example": [
        "-S Session.vim"
      ],
      "next": []
    },
    {
      "name": "-u",
      "usage": [
        "-u <config>"
      ],
      "tip": [
        "Use this config file."
      ],
      "example": [
        "-u NONE"
      ],
      "next": []
    },
    {
      "name": "-V",
      "usage": [
        "-V[N][file]"
      ],
      "tip": [
        "Verbose [level][file]."
      ],
      "example": [
        "-V9mylog.txt"
      ],
      "next": []
    },
    {
      "name": "+",
      "usage": [
        "+<cmd>"
      ],
      "tip": [
        "Execute <cmd> after config and first file."
      ],
      "example": [
        "+10"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print this help message."
      ]
    }
  ]
}
