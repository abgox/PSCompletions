{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将每个文件中的制表符转换为空格。"
    ]
  },
  "option": [
    {
      "name": "--initial",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --initial"
      ],
      "tip": [
        "不转换非空格字符后的制表符。"
      ]
    },
    {
      "name": "--tabs",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --tabs <N, LIST>"
      ],
      "tip": [
        "设置制表符间隔为 N 个字符，默认为 8。",
        "使用逗号分隔的制表位列表。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--no-utf8",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --no-utf8"
      ],
      "tip": [
        "将输入文件按 8 位 ASCII 而非 UTF-8 解释"
      ],
      "next": []
    }
  ]
}
