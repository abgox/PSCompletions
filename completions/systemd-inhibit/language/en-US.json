{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Execute a process while inhibiting shutdown, sleep or idle."
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--list",
      "tip": [
        "List active inhibitors."
      ]
    },
    {
      "name": "--mode",
      "usage": [
        "--mode=MODE"
      ],
      "tip": [
        "Inhibition mode.",
        "Possible values: block, block-weak, delay"
      ],
      "next": [
        {
          "name": "block"
        },
        {
          "name": "block-weak"
        },
        {
          "name": "delay"
        }
      ]
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "Do not attempt interactive authorization."
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "Do not show the headers and footers."
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    },
    {
      "name": "--what",
      "usage": [
        "--what=WHAT"
      ],
      "tip": [
        "Operations to inhibit, colon separated.",
        "Possible values: shutdown, sleep, idle, handle-power-key, handle-suspend-key, handle-hibernate-key, handle-lid-switch"
      ],
      "separator": ":",
      "next": [
        {
          "name": "handle-hibernate-key"
        },
        {
          "name": "handle-lid-switch"
        },
        {
          "name": "handle-power-key"
        },
        {
          "name": "handle-suspend-key"
        },
        {
          "name": "idle"
        },
        {
          "name": "shutdown"
        },
        {
          "name": "sleep"
        }
      ]
    },
    {
      "name": "--who",
      "usage": [
        "--who=STRING"
      ],
      "tip": [
        "A descriptive string identifying who is inhibiting."
      ],
      "next": []
    },
    {
      "name": "--why",
      "usage": [
        "--why=STRING"
      ],
      "tip": [
        "A descriptive string identifying why the inhibition is held."
      ],
      "next": []
    }
  ]
}
