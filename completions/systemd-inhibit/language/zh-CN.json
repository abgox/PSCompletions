{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "在执行进程时抑制关机、睡眠或空闲。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--list",
      "tip": [
        "列出活动中的抑制器。"
      ]
    },
    {
      "name": "--mode",
      "usage": [
        "--mode=MODE"
      ],
      "tip": [
        "抑制模式。",
        "可能值: block, block-weak, delay"
      ],
      "next": [
        {
          "name": "block"
        },
        {
          "name": "block-weak"
        },
        {
          "name": "delay"
        }
      ]
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "不尝试交互式授权。"
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "不显示页眉和页脚。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "--what",
      "usage": [
        "--what=WHAT"
      ],
      "tip": [
        "要抑制的操作，以冒号分隔。",
        "可能值: shutdown, sleep, idle, handle-power-key, handle-suspend-key, handle-hibernate-key, handle-lid-switch"
      ],
      "separator": ":",
      "next": [
        {
          "name": "handle-hibernate-key"
        },
        {
          "name": "handle-lid-switch"
        },
        {
          "name": "handle-power-key"
        },
        {
          "name": "handle-suspend-key"
        },
        {
          "name": "idle"
        },
        {
          "name": "shutdown"
        },
        {
          "name": "sleep"
        }
      ]
    },
    {
      "name": "--who",
      "usage": [
        "--who=STRING"
      ],
      "tip": [
        "标识抑制者的描述性字符串。"
      ],
      "next": []
    },
    {
      "name": "--why",
      "usage": [
        "--why=STRING"
      ],
      "tip": [
        "标识抑制原因的描述性字符串。"
      ],
      "next": []
    }
  ]
}
