{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "打印连接到标准输入的终端的文件名"
    ]
  },
  "option": [
    {
      "name": "--silent",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --silent"
      ],
      "tip": [
        "不打印任何内容，只返回退出状态"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
