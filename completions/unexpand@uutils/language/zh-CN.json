{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将每个 FILE 中的空白转换为制表符，写到标准输出"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "转换所有空白，而不仅是行首空白"
      ]
    },
    {
      "name": "--first-only",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --first-only"
      ],
      "tip": [
        "仅转换行首的空白序列（覆盖 -a）"
      ]
    },
    {
      "name": "--no-utf8",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --no-utf8"
      ],
      "tip": [
        "将输入文件解释为 8 位 ASCII 而非 UTF-8"
      ]
    },
    {
      "name": "--tabs",
      "alias": [
        "-t"
      ],
      "usage": [
        "--tabs <N, LIST>"
      ],
      "tip": [
        "使用逗号分隔的制表位 LIST，或制表位间隔 N 个字符而非 8 个（启用 -a）"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
