{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Run a program with some namespaces unshared from the parent."
    ]
  },
  "option": [
    {
      "name": "--boottime",
      "usage": [
        "--boottime <offset>"
      ],
      "tip": [
        "Set clock boottime offset (seconds) in time namespaces."
      ],
      "next": []
    },
    {
      "name": "--cgroup",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --cgroup[=<file>]"
      ],
      "tip": [
        "Unshare cgroup namespace."
      ],
      "next": []
    },
    {
      "name": "--fork",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fork"
      ],
      "tip": [
        "Fork before launching <program>."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--ipc",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ipc[=<file>]"
      ],
      "tip": [
        "Unshare System V IPC namespace."
      ],
      "next": []
    },
    {
      "name": "--keep-caps",
      "tip": [
        "Retain capabilities granted in user namespaces."
      ]
    },
    {
      "name": "--kill-child",
      "usage": [
        "--kill-child[=<signame>]"
      ],
      "tip": [
        "When dying, kill the forked child (implies --fork).",
        "Defaults to SIGKILL."
      ],
      "next": []
    },
    {
      "name": "--load-interp",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --load-interp <file>"
      ],
      "tip": [
        "Load binfmt definition in the namespace (implies --mount-binfmt)."
      ],
      "next": []
    },
    {
      "name": "--map-auto",
      "tip": [
        "Map users and groups automatically (implies --user)."
      ]
    },
    {
      "name": "--map-current-user",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --map-current-user"
      ],
      "tip": [
        "Map current user to itself (implies --user)."
      ]
    },
    {
      "name": "--map-group",
      "usage": [
        "--map-group <gid|name>"
      ],
      "tip": [
        "Map current group to gid (implies --user)."
      ],
      "next": []
    },
    {
      "name": "--map-groups",
      "usage": [
        "--map-groups <innergid>:<outergid>:<count>"
      ],
      "tip": [
        "Map count groups from outergid to innergid (implies --user)."
      ],
      "next": []
    },
    {
      "name": "--map-root-user",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --map-root-user"
      ],
      "tip": [
        "Map current user to root (implies --user)."
      ]
    },
    {
      "name": "--map-user",
      "usage": [
        "--map-user <uid|name>"
      ],
      "tip": [
        "Map current user to uid (implies --user)."
      ],
      "next": []
    },
    {
      "name": "--map-users",
      "usage": [
        "--map-users <inneruid>:<outeruid>:<count>"
      ],
      "tip": [
        "Map count users from outeruid to inneruid (implies --user)."
      ],
      "next": []
    },
    {
      "name": "--monotonic",
      "usage": [
        "--monotonic <offset>"
      ],
      "tip": [
        "Set clock monotonic offset (seconds) in time namespaces."
      ],
      "next": []
    },
    {
      "name": "--mount",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mount[=<file>]"
      ],
      "tip": [
        "Unshare mounts namespace."
      ],
      "next": []
    },
    {
      "name": "--mount-binfmt",
      "usage": [
        "--mount-binfmt[=<dir>]"
      ],
      "tip": [
        "Mount binfmt filesystem first (implies --user and --mount)."
      ],
      "next": []
    },
    {
      "name": "--mount-proc",
      "usage": [
        "--mount-proc[=<dir>]"
      ],
      "tip": [
        "Mount proc filesystem first (implies --mount)."
      ],
      "next": []
    },
    {
      "name": "--net",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --net[=<file>]"
      ],
      "tip": [
        "Unshare network namespace."
      ],
      "next": []
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid[=<file>]"
      ],
      "tip": [
        "Unshare pid namespace."
      ],
      "next": []
    },
    {
      "name": "--propagation",
      "usage": [
        "--propagation <slave|shared|private|unchanged>"
      ],
      "tip": [
        "Modify mount propagation in mount namespace.",
        "Possible values: slave, shared, private, unchanged"
      ],
      "next": [
        {
          "name": "private"
        },
        {
          "name": "shared"
        },
        {
          "name": "slave"
        },
        {
          "name": "unchanged"
        }
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <dir>"
      ],
      "tip": [
        "Run the command with root directory set to <dir>."
      ],
      "next": []
    },
    {
      "name": "--setgid",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --setgid <gid>"
      ],
      "tip": [
        "Set gid in entered namespace."
      ],
      "next": []
    },
    {
      "name": "--setgroups",
      "usage": [
        "--setgroups <allow|deny>"
      ],
      "tip": [
        "Control the setgroups syscall in user namespaces.",
        "Possible values: allow, deny"
      ],
      "next": [
        {
          "name": "allow"
        },
        {
          "name": "deny"
        }
      ]
    },
    {
      "name": "--setuid",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --setuid <uid>"
      ],
      "tip": [
        "Set uid in entered namespace."
      ],
      "next": []
    },
    {
      "name": "--time",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --time[=<file>]"
      ],
      "tip": [
        "Unshare time namespace."
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --user[=<file>]"
      ],
      "tip": [
        "Unshare user namespace."
      ],
      "next": []
    },
    {
      "name": "--uts",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uts[=<file>]"
      ],
      "tip": [
        "Unshare UTS namespace (hostname etc)."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--wd",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wd <dir>"
      ],
      "tip": [
        "Change working directory to <dir>."
      ],
      "next": []
    }
  ]
}
