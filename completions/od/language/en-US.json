{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Dump files in octal and other formats."
    ]
  },
  "option": [
    {
      "name": "--address-radix",
      "alias": [
        "-A"
      ],
      "usage": [
        " -A, --address-radix <RADIX>"
      ],
      "tip": [
        "Select the base in which file offsets are printed."
      ],
      "next": [
        {
          "name": "d",
          "tip": [
            "decimal"
          ]
        },
        {
          "name": "n",
          "tip": [
            "none"
          ]
        },
        {
          "name": "o",
          "tip": [
            "octal"
          ]
        },
        {
          "name": "x",
          "tip": [
            "hexadecimal"
          ]
        }
      ]
    },
    {
      "name": "--endian",
      "usage": [
        "--endian <big|little>"
      ],
      "tip": [
        "byte order to use for multi-byte formats",
        "[possible values: big, little]"
      ],
      "next": [
        {
          "name": "big"
        },
        {
          "name": "little"
        }
      ]
    },
    {
      "name": "--format",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --format <TYPE>"
      ],
      "tip": [
        "select output format or formats"
      ],
      "next": [
        {
          "name": "a",
          "tip": [
            "for printable 7-bits ASCII"
          ]
        },
        {
          "name": "c",
          "tip": [
            "for utf-8 characters or octal for undefined characters"
          ]
        },
        {
          "name": "d",
          "usage": [
            "d[SIZE]"
          ],
          "tip": [
            "for signed decimal"
          ]
        },
        {
          "name": "f",
          "usage": [
            "f[SIZE]"
          ],
          "tip": [
            "for floating point"
          ]
        },
        {
          "name": "o",
          "usage": [
            "o[SIZE]"
          ],
          "tip": [
            "for octal"
          ]
        },
        {
          "name": "u",
          "usage": [
            "u[SIZE]"
          ],
          "tip": [
            "for unsigned decimal"
          ]
        },
        {
          "name": "x",
          "usage": [
            "x[SIZE]"
          ],
          "tip": [
            "for hexadecimal"
          ]
        }
      ]
    },
    {
      "name": "--output-duplicates",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --output-duplicates"
      ],
      "tip": [
        "do not use * to mark line suppression"
      ]
    },
    {
      "name": "--read-bytes",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --read-bytes <BYTES>"
      ],
      "tip": [
        "limit dump to BYTES input bytes."
      ],
      "next": []
    },
    {
      "name": "--skip-bytes",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --skip-bytes <BYTES>"
      ],
      "tip": [
        "Skip bytes input bytes before formatting and writing."
      ],
      "next": []
    },
    {
      "name": "--strings",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --strings <BYTES>"
      ],
      "tip": [
        "NotImplemented: output strings of at least BYTES graphic chars.",
        "3 is assumed when BYTES is not specified."
      ],
      "next": []
    },
    {
      "name": "--traditional",
      "tip": [
        "compatibility mode with one input, offset and label."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width [<BYTES>]"
      ],
      "tip": [
        "output BYTES bytes per output line. 32 is implied when BYTES is not specified."
      ],
      "next": []
    },
    {
      "name": "-a",
      "tip": [
        "named characters, ignoring high-order bit"
      ]
    },
    {
      "name": "-b",
      "tip": [
        "octal bytes"
      ]
    },
    {
      "name": "-c",
      "tip": [
        "ASCII characters or backslash escapes"
      ]
    },
    {
      "name": "-d",
      "tip": [
        "unsigned decimal 2-byte units"
      ]
    },
    {
      "name": "-D",
      "tip": [
        "unsigned decimal 4-byte units"
      ]
    },
    {
      "name": "-e",
      "tip": [
        "floating point double precision (64-bit) units"
      ]
    },
    {
      "name": "-f",
      "tip": [
        "floating point double precision (32-bit) units"
      ]
    },
    {
      "name": "-F",
      "tip": [
        "floating point double precision (64-bit) units"
      ]
    },
    {
      "name": "-h",
      "tip": [
        "hexadecimal 2-byte units"
      ]
    },
    {
      "name": "-H",
      "tip": [
        "hexadecimal 4-byte units"
      ]
    },
    {
      "name": "-i",
      "tip": [
        "decimal 4-byte units"
      ]
    },
    {
      "name": "-I",
      "tip": [
        "decimal 8-byte units"
      ]
    },
    {
      "name": "-l",
      "tip": [
        "decimal 8-byte units"
      ]
    },
    {
      "name": "-L",
      "tip": [
        "decimal 8-byte units"
      ]
    },
    {
      "name": "-o",
      "tip": [
        "octal 2-byte units"
      ]
    },
    {
      "name": "-O",
      "tip": [
        "octal 4-byte units"
      ]
    },
    {
      "name": "-s",
      "tip": [
        "decimal 2-byte units"
      ]
    },
    {
      "name": "-x",
      "tip": [
        "hexadecimal 2-byte units"
      ]
    },
    {
      "name": "-X",
      "tip": [
        "hexadecimal 4-byte units"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show the help."
      ]
    }
  ]
}
