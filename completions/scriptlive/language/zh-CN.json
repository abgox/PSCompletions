{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "执行终端 typescript。"
    ]
  },
  "option": [
    {
      "name": "--command",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --command <command>"
      ],
      "tip": [
        "运行命令而不是交互式 shell。"
      ],
      "next": []
    },
    {
      "name": "--divisor",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --divisor <num>"
      ],
      "tip": [
        "使用时间除数加快或减慢执行。"
      ],
      "next": []
    },
    {
      "name": "--echo",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --echo <when>"
      ],
      "tip": [
        "在会话中回显输入。",
        "可能值: auto, always, never"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--log-in",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --log-in <file>"
      ],
      "tip": [
        "script 标准输入日志文件。"
      ],
      "next": []
    },
    {
      "name": "--log-io",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --log-io <file>"
      ],
      "tip": [
        "script 标准输入和标准输出日志文件。"
      ],
      "next": []
    },
    {
      "name": "--log-timing",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --log-timing <file>"
      ],
      "tip": [
        "-t 的别名。"
      ],
      "next": []
    },
    {
      "name": "--maxdelay",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --maxdelay <num>"
      ],
      "tip": [
        "两次更新之间最多等待的秒数。"
      ],
      "next": []
    },
    {
      "name": "--timing",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --timing <file>"
      ],
      "tip": [
        "script 计时日志文件。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
