{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Execute terminal typescript."
    ]
  },
  "option": [
    {
      "name": "--command",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --command <command>"
      ],
      "tip": [
        "Run command rather than interactive shell."
      ],
      "next": []
    },
    {
      "name": "--divisor",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --divisor <num>"
      ],
      "tip": [
        "Speed up or slow down execution with time divisor."
      ],
      "next": []
    },
    {
      "name": "--echo",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --echo <when>"
      ],
      "tip": [
        "Echo input in session.",
        "Possible values: auto, always, never"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--log-in",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --log-in <file>"
      ],
      "tip": [
        "Script stdin log file."
      ],
      "next": []
    },
    {
      "name": "--log-io",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --log-io <file>"
      ],
      "tip": [
        "Script stdin and stdout log file."
      ],
      "next": []
    },
    {
      "name": "--log-timing",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --log-timing <file>"
      ],
      "tip": [
        "Alias to -t."
      ],
      "next": []
    },
    {
      "name": "--maxdelay",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --maxdelay <num>"
      ],
      "tip": [
        "Wait at most this many seconds between updates."
      ],
      "next": []
    },
    {
      "name": "--timing",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --timing <file>"
      ],
      "tip": [
        "Script timing log file."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
