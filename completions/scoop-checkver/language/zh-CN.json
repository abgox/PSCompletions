{
  "meta": {
    "url": "https://scoop.sh",
    "description": [
      "检查 Scoop 清单更新。",
      "使用 .\\bin\\checkver.ps1 去触发补全"
    ]
  },
  "global_option": [
    {
      "name": "-App",
      "tip": [
        "指定要检查更新的清单",
        "默认为 *"
      ],
      "next": [
        {
          "name": "*"
        }
      ]
    },
    {
      "name": "-Dir",
      "tip": [
        "指定清单所在目录",
        "仅目录下的清单被检查"
      ],
      "next": 0
    },
    {
      "name": "-ForceUpdate",
      "tip": [
        "更新给定清单，即使没有新的版本",
        "常用于强制更新 hash"
      ]
    },
    {
      "name": "-MaxConcurrency",
      "tip": [
        "并行更新清单的数量"
      ],
      "next": [
        {
          "name": "100"
        },
        {
          "name": "50"
        }
      ]
    },
    {
      "name": "-Segment",
      "tip": [
        "指定要检查的清单片段"
      ],
      "next": [
        {
          "name": "0-1"
        },
        {
          "name": "2-3"
        },
        {
          "name": "4-5"
        },
        {
          "name": "6-7"
        },
        {
          "name": "8-9"
        },
        {
          "name": "a-b"
        },
        {
          "name": "c-d"
        },
        {
          "name": "e-f"
        },
        {
          "name": "g-h"
        },
        {
          "name": "i-j"
        },
        {
          "name": "k-l"
        },
        {
          "name": "m-n"
        },
        {
          "name": "o-p"
        },
        {
          "name": "q-r"
        },
        {
          "name": "s-t"
        },
        {
          "name": "u-v"
        },
        {
          "name": "w-x"
        },
        {
          "name": "y-z"
        }
      ]
    },
    {
      "name": "-SkipUpdated",
      "tip": [
        "更新后的清单将不会显示"
      ]
    },
    {
      "name": "-TimeoutSec",
      "tip": [
        "单次请求超时时间，单位为秒"
      ],
      "next": [
        {
          "name": "10"
        },
        {
          "name": "20"
        },
        {
          "name": "30"
        }
      ]
    },
    {
      "name": "-Update",
      "tip": [
        "更新给定清单"
      ]
    },
    {
      "name": "-Version",
      "tip": [
        "更新清单至指定版本"
      ],
      "next": 0
    }
  ]
}
