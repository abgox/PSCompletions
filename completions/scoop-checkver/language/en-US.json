{
  "meta": {
    "url": "https://scoop.sh",
    "description": [
      "Check for updates to Scoop manifests.",
      "Use .\\bin\\checkver.ps1 to trigger completions."
    ]
  },
  "global_option": [
    {
      "name": "-App",
      "tip": [
        "Manifest to check for updates.",
        "Default is *"
      ],
      "next": [
        {
          "name": "*"
        }
      ]
    },
    {
      "name": "-Commit",
      "tip": [
        "Automatically commit with the generated commit message after a successful update."
      ]
    },
    {
      "name": "-Dir",
      "tip": [
        "Specify the directory where manifests are located.",
        "Only manifests in this directory will be checked."
      ],
      "next": []
    },
    {
      "name": "-ForceUpdate",
      "tip": [
        "Update given manifest(s) even when there is no new version.",
        "It is useful for hash updates."
      ]
    },
    {
      "name": "-MaxConcurrency",
      "tip": [
        "Number of concurrent manifest updates."
      ],
      "next": [
        {
          "name": "100"
        },
        {
          "name": "50"
        }
      ]
    },
    {
      "name": "-Segment",
      "tip": [
        "Specify the manifest segment to check."
      ],
      "next": [
        {
          "name": "0-1"
        },
        {
          "name": "2-3"
        },
        {
          "name": "4-5"
        },
        {
          "name": "6-7"
        },
        {
          "name": "8-9"
        },
        {
          "name": "a-b"
        },
        {
          "name": "c-d"
        },
        {
          "name": "e-f"
        },
        {
          "name": "g-h"
        },
        {
          "name": "i-j"
        },
        {
          "name": "k-l"
        },
        {
          "name": "m-n"
        },
        {
          "name": "o-p"
        },
        {
          "name": "q-r"
        },
        {
          "name": "s-t"
        },
        {
          "name": "u-v"
        },
        {
          "name": "w-x"
        },
        {
          "name": "y-z"
        }
      ]
    },
    {
      "name": "-SkipUpdated",
      "tip": [
        "Updated manifests will not be shown."
      ]
    },
    {
      "name": "-TimeoutSec",
      "tip": [
        "Per-request timeout, in seconds."
      ],
      "next": [
        {
          "name": "10"
        },
        {
          "name": "20"
        },
        {
          "name": "30"
        }
      ]
    },
    {
      "name": "-Update",
      "tip": [
        "Update given manifest."
      ]
    },
    {
      "name": "-Version",
      "tip": [
        "Update manifest to specific version."
      ],
      "next": []
    }
  ]
}
