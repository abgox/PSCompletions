{
  "meta": {
    "url": "https://www.gnu.org/software/m4",
    "description": [
      "处理 FILEs 中的宏。"
    ]
  },
  "option": [
    {
      "name": "--arglength",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l NUM, --arglength=NUM"
      ],
      "tip": [
        "限制宏跟踪大小。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "100"
        }
      ]
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug[=FLAGS]"
      ],
      "tip": [
        "设置调试级别。",
        "FLAGS 可为 a、c、e、f、i、l、p、q、t、x 或 V；没有 FLAGS 时隐含 aeq。",
        "长选项的值必须使用 = 附加。"
      ],
      "next": []
    },
    {
      "name": "--debugfile",
      "usage": [
        "--debugfile[=FILE]"
      ],
      "tip": [
        "将调试和跟踪输出重定向到 FILE。",
        "默认是标准错误；空值表示丢弃。",
        "该值必须使用 = 附加。"
      ],
      "next": []
    },
    {
      "name": "--define",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D NAME[=VALUE], --define=NAME[=VALUE]"
      ],
      "tip": [
        "将 NAME 定义为 VALUE，或定义为空。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--fatal-warnings",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --fatal-warnings"
      ],
      "tip": [
        "将警告视为错误。",
        "指定两次可在第一个错误处停止执行。"
      ],
      "repeat": 2
    },
    {
      "name": "--freeze-state",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F FILE, --freeze-state=FILE"
      ],
      "tip": [
        "结束时在 FILE 中生成冻结状态。"
      ],
      "next": []
    },
    {
      "name": "--gnu",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --gnu"
      ],
      "tip": [
        "覆盖 --traditional 以重新启用 GNU 扩展。"
      ]
    },
    {
      "name": "--hashsize",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H PRIME, --hashsize=PRIME"
      ],
      "tip": [
        "设置符号查找哈希表大小。",
        "默认值为 65537。"
      ],
      "next": [
        {
          "name": "65537"
        }
      ]
    },
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出。"
      ]
    },
    {
      "name": "--include",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I DIRECTORY, --include=DIRECTORY"
      ],
      "tip": [
        "将 DIRECTORY 追加到包含路径。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "取消输出缓冲并忽略中断。"
      ]
    },
    {
      "name": "--nesting-limit",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L NUMBER, --nesting-limit=NUMBER"
      ],
      "tip": [
        "更改嵌套限制。",
        "0 表示无限制。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "100"
        },
        {
          "name": "1000"
        }
      ]
    },
    {
      "name": "--prefix-builtins",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --prefix-builtins"
      ],
      "tip": [
        "强制所有内建宏使用 m4_ 前缀。"
      ]
    },
    {
      "name": "--reload-state",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R FILE, --reload-state=FILE"
      ],
      "tip": [
        "启动时从 FILE 重新加载冻结状态。"
      ],
      "next": []
    },
    {
      "name": "--silent",
      "alias": [
        "--quiet",
        "-Q"
      ],
      "usage": [
        "-Q, --quiet, --silent"
      ],
      "tip": [
        "抑制内建宏的部分警告。"
      ]
    },
    {
      "name": "--synclines",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --synclines"
      ],
      "tip": [
        "生成 '#line NUM \"FILE\"' 行。"
      ]
    },
    {
      "name": "--trace",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t NAME, --trace=NAME"
      ],
      "tip": [
        "在 NAME 被定义时跟踪它。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--traditional",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --traditional"
      ],
      "tip": [
        "抑制所有 GNU 扩展。"
      ]
    },
    {
      "name": "--undefine",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U NAME, --undefine=NAME"
      ],
      "tip": [
        "取消定义 NAME。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出。"
      ]
    },
    {
      "name": "--warn-macro-sequence",
      "usage": [
        "--warn-macro-sequence[=REGEXP]"
      ],
      "tip": [
        "当宏定义匹配 REGEXP 时发出警告。",
        "该值必须使用 = 附加。"
      ],
      "next": []
    }
  ]
}
