{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将每个 FILE 的访问和修改时间更新为当前时间"
    ]
  },
  "option": [
    {
      "name": "--date",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --date <STRING>"
      ],
      "tip": [
        "解析参数并使用它而非当前时间"
      ],
      "next": []
    },
    {
      "name": "--no-create",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --no-create"
      ],
      "tip": [
        "不创建任何文件"
      ]
    },
    {
      "name": "--no-dereference",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --no-dereference"
      ],
      "tip": [
        "影响每个符号链接而非其指向的文件（仅适用于可更改符号链接时间戳的系统）"
      ]
    },
    {
      "name": "--reference",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reference <FILE>"
      ],
      "tip": [
        "使用此文件的时间而非当前时间"
      ],
      "next": []
    },
    {
      "name": "--time",
      "usage": [
        "--time <WORD>"
      ],
      "tip": [
        "仅更改指定的时间：access、atime 或 use 等同于 -a；modify 或 mtime 等同于 -m"
      ],
      "next": [
        {
          "name": "atime"
        },
        {
          "name": "mtime"
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-a",
      "tip": [
        "仅更改访问时间"
      ]
    },
    {
      "name": "-f",
      "tip": [
        "（被忽略）"
      ]
    },
    {
      "name": "-m",
      "tip": [
        "仅更改修改时间"
      ]
    },
    {
      "name": "-t",
      "usage": [
        "-t <STAMP>"
      ],
      "tip": [
        "使用 YY]MMDDhhmm 而非当前时间"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "打印帮助信息"
      ]
    }
  ]
}
