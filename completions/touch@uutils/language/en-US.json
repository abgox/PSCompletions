{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Update the access and modification times of each FILE to the current time."
    ]
  },
  "option": [
    {
      "name": "--date",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --date <STRING>"
      ],
      "tip": [
        "parse argument and use it instead of current time"
      ],
      "next": []
    },
    {
      "name": "--no-create",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --no-create"
      ],
      "tip": [
        "do not create any files"
      ]
    },
    {
      "name": "--no-dereference",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --no-dereference"
      ],
      "tip": [
        "affect each symbolic link instead of any referenced file (only for systems that can change the timestamps of a symlink)"
      ]
    },
    {
      "name": "--reference",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reference <FILE>"
      ],
      "tip": [
        "use this file's times instead of the current time"
      ],
      "next": []
    },
    {
      "name": "--time",
      "usage": [
        "--time <WORD>"
      ],
      "tip": [
        "change only the specified time: \"access\", \"atime\", or \"use\" are equivalent to -a; \"modify\" or \"mtime\" are equivalent to -m"
      ],
      "next": [
        {
          "name": "atime"
        },
        {
          "name": "mtime"
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "-a",
      "tip": [
        "change only the access time"
      ]
    },
    {
      "name": "-f",
      "tip": [
        "(ignored)"
      ]
    },
    {
      "name": "-m",
      "tip": [
        "change only the modification time"
      ]
    },
    {
      "name": "-t",
      "usage": [
        "-t <STAMP>"
      ],
      "tip": [
        "use YY]MMDDhhmm instead of the current time"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "Print help information"
      ]
    }
  ]
}
