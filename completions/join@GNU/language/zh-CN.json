{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "对每对连接字段相同的输入行，向标准输出写一行。"
    ]
  },
  "option": [
    {
      "name": "--check-order",
      "tip": [
        "即使所有输入行都能配对，也检查输入是否已正确排序"
      ]
    },
    {
      "name": "--header",
      "tip": [
        "把每个文件的第一行当作字段表头，打印它们而不尝试配对"
      ]
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-case"
      ],
      "tip": [
        "比较字段时忽略大小写差异"
      ]
    },
    {
      "name": "--nocheck-order",
      "tip": [
        "不检查输入是否已正确排序"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "行分隔符为 NUL，而不是换行符"
      ]
    },
    {
      "name": "-1",
      "usage": [
        "-1 <FIELD>"
      ],
      "tip": [
        "在文件 1 的该 FIELD 字段上连接"
      ],
      "next": []
    },
    {
      "name": "-2",
      "usage": [
        "-2 <FIELD>"
      ],
      "tip": [
        "在文件 2 的该 FIELD 字段上连接"
      ],
      "next": []
    },
    {
      "name": "-a",
      "usage": [
        "-a <FILENUM>"
      ],
      "tip": [
        "同时打印 FILENUM 中无法配对的行，FILENUM 为 1 或 2，分别对应 FILE1 或 FILE2"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "-e",
      "usage": [
        "-e <STRING>"
      ],
      "tip": [
        "用 STRING 替换缺失（为空）的输入字段，即用 '-12jo' 指定的缺失字段"
      ],
      "next": []
    },
    {
      "name": "-j",
      "usage": [
        "-j <FIELD>"
      ],
      "tip": [
        "等同于 '-1 FIELD -2 FIELD'"
      ],
      "next": []
    },
    {
      "name": "-o",
      "usage": [
        "-o <FORMAT>"
      ],
      "tip": [
        "构造输出行时遵循 FORMAT"
      ],
      "next": []
    },
    {
      "name": "-t",
      "usage": [
        "-t <CHAR>"
      ],
      "tip": [
        "用 CHAR 作为输入和输出字段分隔符"
      ],
      "next": []
    },
    {
      "name": "-v",
      "usage": [
        "-v <FILENUM>"
      ],
      "tip": [
        "与 -a FILENUM 类似，但抑制已连接的输出行"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
