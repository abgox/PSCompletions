{
  "meta": {
    "url": "https://github.com/pyenv/pyenv#readme",
    "description": [
      "简单的 Python 版本管理。"
    ]
  },
  "next": [
    {
      "name": "binary",
      "usage": [
        "binary <COMMAND> [<ARGS>]"
      ],
      "tip": [
        "将已安装 Python 版本打包为可重定位二进制（实验性）。"
      ]
    },
    {
      "name": "commands",
      "tip": [
        "列出全部可用 pyenv 命令。"
      ],
      "option": [
        {
          "name": "--no-sh",
          "tip": [
            "隐藏 sh-* shell 函数。"
          ]
        },
        {
          "name": "--sh",
          "tip": [
            "仅列出 sh-* shell 函数。"
          ]
        }
      ]
    },
    {
      "name": "completions",
      "usage": [
        "completions <COMMAND> [<ARG>...]"
      ],
      "tip": [
        "打印 pyenv 命令的补全。"
      ]
    },
    {
      "name": "exec",
      "usage": [
        "exec <COMMAND> [<ARG>...]"
      ],
      "tip": [
        "用选定的 Python 版本运行可执行文件。"
      ],
      "option": [
        {
          "name": "--environment",
          "alias": [
            "-N"
          ],
          "usage": [
            "-N, --environment"
          ],
          "tip": [
            "为运行的命令设置 PYTHONHOME 与 LD_LIBRARY_PATH（macOS 为 DYLD_LIBRARY_PATH）环境变量。"
          ]
        }
      ]
    },
    {
      "name": "global",
      "usage": [
        "global <VERSION> [<VERSION>...]"
      ],
      "tip": [
        "设置或查看全局 Python 版本。"
      ]
    },
    {
      "name": "help",
      "usage": [
        "help <COMMAND>"
      ],
      "tip": [
        "显示命令的帮助。"
      ],
      "option": [
        {
          "name": "--usage",
          "tip": [
            "仅显示用法说明。"
          ]
        }
      ]
    },
    {
      "name": "hooks",
      "usage": [
        "hooks <COMMAND>"
      ],
      "tip": [
        "列出给定 pyenv 命令的 hook 脚本。"
      ]
    },
    {
      "name": "init",
      "usage": [
        "init [-|--path] [--no-push-path] [--no-rehash] [<SHELL>]",
        "init --install [<SHELL>]",
        "init --detect-shell [<SHELL>]"
      ],
      "tip": [
        "为 pyenv 配置 shell 环境。"
      ],
      "option": [
        {
          "name": "-",
          "tip": [
            "打印 shell 设置到 stdout（默认模式）。"
          ]
        },
        {
          "name": "--detect-shell",
          "tip": [
            "打印检测到的 shell 与 profile 文件。"
          ]
        },
        {
          "name": "--install",
          "tip": [
            "安装 shell 启动文件。"
          ]
        },
        {
          "name": "--no-push-path",
          "tip": [
            "shims 不在 PATH 中时才添加。"
          ]
        },
        {
          "name": "--no-rehash",
          "tip": [
            "不 rehash shims。"
          ]
        },
        {
          "name": "--path",
          "tip": [
            "仅打印 shims 路径设置。"
          ]
        }
      ],
      "next": [
        {
          "name": "bash"
        },
        {
          "name": "fish"
        },
        {
          "name": "ksh"
        },
        {
          "name": "ksh93"
        },
        {
          "name": "mksh"
        },
        {
          "name": "pwsh"
        },
        {
          "name": "zsh"
        }
      ]
    },
    {
      "name": "install",
      "usage": [
        "install <VERSION>[:<ALIAS>]...",
        "install <DEFINITION-FILE>[:<ALIAS>]",
        "install -l|--list [--bare]",
        "install --version"
      ],
      "tip": [
        "用 python-build 安装 Python 版本。"
      ],
      "option": [
        {
          "name": "--bare",
          "tip": [
            "列出版本时省略头部（与 --list 联用）。"
          ]
        },
        {
          "name": "--debug",
          "alias": [
            "-g"
          ],
          "usage": [
            "-g, --debug"
          ],
          "tip": [
            "构建 debug 版本。"
          ]
        },
        {
          "name": "--force",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --force"
          ],
          "tip": [
            "版本看似已安装仍强制安装。"
          ]
        },
        {
          "name": "--keep",
          "alias": [
            "-k"
          ],
          "usage": [
            "-k, --keep"
          ],
          "tip": [
            "安装后保留源码树（$PYENV_BUILD_ROOT，默认为 $PYENV_ROOT/sources）。"
          ]
        },
        {
          "name": "--list",
          "alias": [
            "-l"
          ],
          "usage": [
            "-l, --list"
          ],
          "tip": [
            "列出全部可用版本。"
          ]
        },
        {
          "name": "--patch",
          "alias": [
            "-p"
          ],
          "usage": [
            "-p, --patch"
          ],
          "tip": [
            "构建前从 stdin 应用补丁。"
          ]
        },
        {
          "name": "--skip-existing",
          "alias": [
            "-s"
          ],
          "usage": [
            "-s, --skip-existing"
          ],
          "tip": [
            "版本看似已安装则跳过。"
          ]
        },
        {
          "name": "--verbose",
          "alias": [
            "-v"
          ],
          "usage": [
            "-v, --verbose"
          ],
          "tip": [
            "详细模式：打印编译状态到 stdout。"
          ]
        },
        {
          "name": "--version",
          "tip": [
            "显示 python-build 版本。"
          ]
        }
      ]
    },
    {
      "name": "install-prerequisites",
      "tip": [
        "在 Debian 系系统安装 Python 构建依赖。"
      ],
      "option": [
        {
          "name": "--all",
          "alias": [
            "-a"
          ],
          "usage": [
            "-a, --all"
          ],
          "tip": [
            "同时安装可选依赖（冷门模块用）。"
          ]
        }
      ]
    },
    {
      "name": "latest",
      "usage": [
        "latest <PREFIX>"
      ],
      "tip": [
        "打印给定前缀的最新已安装或已知版本。"
      ],
      "option": [
        {
          "name": "--bypass",
          "alias": [
            "-b"
          ],
          "usage": [
            "-b, --bypass"
          ],
          "tip": [
            "（内部）解析失败不打印错误，原样打印参数。"
          ]
        },
        {
          "name": "--force",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --force"
          ],
          "tip": [
            "（内部）同 -b，且不返回失败退出码。"
          ]
        },
        {
          "name": "--known",
          "alias": [
            "-k"
          ],
          "usage": [
            "-k, --known"
          ],
          "tip": [
            "从全部已知版本而非已安装版本选择。"
          ]
        }
      ]
    },
    {
      "name": "link",
      "usage": [
        "link version <PATH> [<NAME>]"
      ],
      "tip": [
        "将 Python 环境链接为 pyenv 版本。"
      ],
      "next": [
        {
          "name": "version",
          "usage": [
            "version [--dry] [--quiet] <PATH> [<NAME>]"
          ],
          "tip": [
            "将 Python 环境链接为 pyenv 版本。"
          ],
          "option": [
            {
              "name": "--dry",
              "tip": [
                "不实际创建链接。"
              ]
            },
            {
              "name": "--quiet",
              "tip": [
                "不输出信息。"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "link-version",
      "usage": [
        "link-version <PATH> [<NAME>]"
      ],
      "tip": [
        "将 Python 环境链接为 pyenv 版本。"
      ],
      "option": [
        {
          "name": "--dry",
          "tip": [
            "不实际创建链接。"
          ]
        },
        {
          "name": "--quiet",
          "tip": [
            "不输出信息。"
          ]
        }
      ]
    },
    {
      "name": "local",
      "usage": [
        "local [<VERSION>...]",
        "local --unset"
      ],
      "tip": [
        "设置或查看本地应用级 Python 版本。"
      ],
      "option": [
        {
          "name": "--force",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --force"
          ],
          "tip": [
            "不校验设置的版本是否存在。"
          ]
        },
        {
          "name": "--unset",
          "tip": [
            "删除本地版本文件。"
          ]
        }
      ]
    },
    {
      "name": "prefix",
      "usage": [
        "prefix [<VERSION>...]"
      ],
      "tip": [
        "显示 Python 版本的前缀目录。"
      ]
    },
    {
      "name": "rehash",
      "tip": [
        "重建 pyenv shims（安装可执行文件后运行）。"
      ]
    },
    {
      "name": "root",
      "tip": [
        "显示版本与 shims 的根目录。"
      ]
    },
    {
      "name": "shell",
      "usage": [
        "shell <VERSION>...",
        "shell -",
        "shell --unset"
      ],
      "tip": [
        "设置或查看 shell 级 Python 版本。"
      ],
      "option": [
        {
          "name": "--unset",
          "tip": [
            "取消 shell 级版本。"
          ]
        }
      ]
    },
    {
      "name": "shims",
      "tip": [
        "列出现有 pyenv shims。"
      ],
      "option": [
        {
          "name": "--short",
          "tip": [
            "仅列出 shim 名。"
          ]
        }
      ]
    },
    {
      "name": "uninstall",
      "usage": [
        "uninstall <VERSION>..."
      ],
      "tip": [
        "卸载 Python 版本。"
      ],
      "option": [
        {
          "name": "--force",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --force"
          ],
          "tip": [
            "不经确认直接删除指定版本。"
          ]
        }
      ]
    },
    {
      "name": "version",
      "tip": [
        "显示当前 Python 版本及其来源。"
      ],
      "option": [
        {
          "name": "--bare",
          "tip": [
            "仅显示版本名。",
            "等价于 `pyenv version-name'。"
          ]
        }
      ]
    },
    {
      "name": "version-file",
      "usage": [
        "version-file [<DIR>]"
      ],
      "tip": [
        "定位设置当前 pyenv 版本的文件。"
      ]
    },
    {
      "name": "version-file-read",
      "usage": [
        "version-file-read <FILE>"
      ],
      "tip": [
        "从版本文件读取版本。"
      ]
    },
    {
      "name": "version-file-write",
      "usage": [
        "version-file-write <FILE> <VERSION> [...]"
      ],
      "tip": [
        "向版本文件写入版本。"
      ],
      "option": [
        {
          "name": "--force",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --force"
          ],
          "tip": [
            "不校验版本是否存在。"
          ]
        }
      ]
    },
    {
      "name": "version-name",
      "tip": [
        "显示当前 Python 版本。"
      ],
      "option": [
        {
          "name": "--force",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --force"
          ],
          "tip": [
            "（内部）版本不存在则原样打印，不报错。"
          ]
        }
      ]
    },
    {
      "name": "version-origin",
      "tip": [
        "说明当前 Python 版本的设置方式。"
      ]
    },
    {
      "name": "versions",
      "tip": [
        "列出 pyenv 已知的全部 Python 版本。"
      ],
      "option": [
        {
          "name": "--bare",
          "tip": [
            "仅列出名称，省略 `system'。"
          ]
        },
        {
          "name": "--executables",
          "tip": [
            "（内部）为 `pyenv rehash' 取去重的可执行文件名列表。"
          ]
        },
        {
          "name": "--skip-aliases",
          "tip": [
            "跳过指向其他版本与虚拟环境的符号链接。"
          ]
        },
        {
          "name": "--skip-envs",
          "tip": [
            "跳过虚拟环境（<version>/envs 下）。"
          ]
        }
      ]
    },
    {
      "name": "whence",
      "usage": [
        "whence <COMMAND>"
      ],
      "tip": [
        "列出含给定可执行文件的 Python 版本。"
      ],
      "option": [
        {
          "name": "--path",
          "tip": [
            "打印可执行文件路径而非版本名。"
          ]
        }
      ]
    },
    {
      "name": "which",
      "usage": [
        "which <COMMAND>"
      ],
      "tip": [
        "显示 pyenv 将调用的可执行文件完整路径。"
      ],
      "option": [
        {
          "name": "--nosystem",
          "tip": [
            "不在系统环境中搜索。"
          ]
        },
        {
          "name": "--skip-advice",
          "tip": [
            "（内部）搜索失败不打印错误信息。"
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示 pyenv 帮助。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示 pyenv 版本。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示命令的帮助。"
      ]
    }
  ]
}
