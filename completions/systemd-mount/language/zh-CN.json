{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "临时建立挂载或自动挂载点。"
    ]
  },
  "option": [
    {
      "name": "--automount",
      "usage": [
        "--automount=BOOL"
      ],
      "tip": [
        "创建自动挂载点。"
      ],
      "next": []
    },
    {
      "name": "--automount-property",
      "usage": [
        "--automount-property=NAME=VALUE"
      ],
      "tip": [
        "设置自动挂载单元属性。"
      ],
      "next": []
    },
    {
      "name": "--bind-device",
      "tip": [
        "将自动挂载单元绑定到设备。"
      ]
    },
    {
      "name": "--collect",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --collect"
      ],
      "tip": [
        "单元停止后卸载，即使失败。"
      ]
    },
    {
      "name": "--description",
      "usage": [
        "--description=TEXT"
      ],
      "tip": [
        "设置单元描述。"
      ],
      "next": []
    },
    {
      "name": "--discover",
      "tip": [
        "发现挂载设备元数据。"
      ]
    },
    {
      "name": "--fsck",
      "usage": [
        "--fsck=no"
      ],
      "tip": [
        "挂载前不运行文件系统检查。"
      ],
      "next": [
        {
          "name": "no"
        }
      ]
    },
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "不省略输出。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "在远程主机上操作。"
      ],
      "next": []
    },
    {
      "name": "--json",
      "usage": [
        "--json=pretty|short|off"
      ],
      "tip": [
        "生成 JSON 输出。",
        "可能值: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--list",
      "tip": [
        "列出可挂载的块设备。"
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "对本机容器操作。"
      ],
      "next": []
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "不提示输入密码。"
      ]
    },
    {
      "name": "--no-block",
      "tip": [
        "不等待操作完成。"
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "不显示页眉。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--options",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --options=OPTIONS"
      ],
      "tip": [
        "挂载选项。"
      ],
      "next": []
    },
    {
      "name": "--owner",
      "usage": [
        "--owner=USER"
      ],
      "tip": [
        "为此用户添加 uid= 和 gid= 选项。"
      ],
      "next": []
    },
    {
      "name": "--property",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --property=NAME=VALUE"
      ],
      "tip": [
        "设置挂载单元属性。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制运行时的信息性消息。"
      ]
    },
    {
      "name": "--timeout-idle-sec",
      "usage": [
        "--timeout-idle-sec=SEC"
      ],
      "tip": [
        "指定自动挂载空闲超时。"
      ],
      "next": []
    },
    {
      "name": "--tmpfs",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --tmpfs"
      ],
      "tip": [
        "在挂载点上创建新的 tmpfs。"
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type=TYPE"
      ],
      "tip": [
        "文件系统类型。"
      ],
      "next": []
    },
    {
      "name": "--umount",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --umount"
      ],
      "tip": [
        "卸载挂载点。"
      ]
    },
    {
      "name": "--user",
      "tip": [
        "作为用户单元运行。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "-A",
      "tip": [
        "等同于 --automount=yes。"
      ]
    }
  ]
}
