{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Establish a mount or auto-mount point transiently."
    ]
  },
  "option": [
    {
      "name": "--automount",
      "usage": [
        "--automount=BOOL"
      ],
      "tip": [
        "Create an automount point."
      ],
      "next": []
    },
    {
      "name": "--automount-property",
      "usage": [
        "--automount-property=NAME=VALUE"
      ],
      "tip": [
        "Set an automount unit property."
      ],
      "next": []
    },
    {
      "name": "--bind-device",
      "tip": [
        "Bind the automount unit to the device."
      ]
    },
    {
      "name": "--collect",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --collect"
      ],
      "tip": [
        "Unload the unit after it stopped, even when failed."
      ]
    },
    {
      "name": "--description",
      "usage": [
        "--description=TEXT"
      ],
      "tip": [
        "Set the unit description."
      ],
      "next": []
    },
    {
      "name": "--discover",
      "tip": [
        "Discover mount device metadata."
      ]
    },
    {
      "name": "--fsck",
      "usage": [
        "--fsck=no"
      ],
      "tip": [
        "Do not run a file system check before mounting."
      ],
      "next": [
        {
          "name": "no"
        }
      ]
    },
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "Do not ellipsize output."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "Operate on a remote host."
      ],
      "next": []
    },
    {
      "name": "--json",
      "usage": [
        "--json=pretty|short|off"
      ],
      "tip": [
        "Generate JSON output.",
        "Possible values: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--list",
      "tip": [
        "List mountable block devices."
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "Operate on a local container."
      ],
      "next": []
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "Do not prompt for a password."
      ]
    },
    {
      "name": "--no-block",
      "tip": [
        "Do not wait until the operation finishes."
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "Do not show the headers."
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--options",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --options=OPTIONS"
      ],
      "tip": [
        "Mount options."
      ],
      "next": []
    },
    {
      "name": "--owner",
      "usage": [
        "--owner=USER"
      ],
      "tip": [
        "Add uid= and gid= options for this user."
      ],
      "next": []
    },
    {
      "name": "--property",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --property=NAME=VALUE"
      ],
      "tip": [
        "Set a mount unit property."
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Suppress information messages during runtime."
      ]
    },
    {
      "name": "--timeout-idle-sec",
      "usage": [
        "--timeout-idle-sec=SEC"
      ],
      "tip": [
        "Specify the automount idle timeout."
      ],
      "next": []
    },
    {
      "name": "--tmpfs",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --tmpfs"
      ],
      "tip": [
        "Create a new tmpfs on the mount point."
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type=TYPE"
      ],
      "tip": [
        "File system type."
      ],
      "next": []
    },
    {
      "name": "--umount",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --umount"
      ],
      "tip": [
        "Unmount mount points."
      ]
    },
    {
      "name": "--user",
      "tip": [
        "Run as a user unit."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    },
    {
      "name": "-A",
      "tip": [
        "Same as --automount=yes."
      ]
    }
  ]
}
