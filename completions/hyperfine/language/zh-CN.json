{
  "meta": {
    "url": "https://github.com/sharkdp/hyperfine",
    "description": [
      "一个命令行基准测试工具"
    ]
  },
  "option": [
    {
      "name": "--cleanup",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --cleanup <CMD>"
      ],
      "tip": [
        "在所有基准测试运行完成后执行 CMD"
      ],
      "next": []
    },
    {
      "name": "--command-name",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --command-name <NAME>"
      ],
      "tip": [
        "为命令指定一个有意义的名称"
      ],
      "next": []
    },
    {
      "name": "--conclude",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --conclude <CMD>"
      ],
      "tip": [
        "在每次计时运行后执行 CMD"
      ],
      "next": []
    },
    {
      "name": "--export-asciidoc",
      "usage": [
        "--export-asciidoc <FILE>"
      ],
      "tip": [
        "将计时汇总统计导出为 AsciiDoc 表格"
      ],
      "next": []
    },
    {
      "name": "--export-csv",
      "usage": [
        "--export-csv <FILE>"
      ],
      "tip": [
        "将计时汇总统计导出为 CSV 格式"
      ],
      "next": []
    },
    {
      "name": "--export-json",
      "usage": [
        "--export-json <FILE>"
      ],
      "tip": [
        "将计时汇总统计和计时数据导出为 JSON 格式"
      ],
      "next": []
    },
    {
      "name": "--export-markdown",
      "usage": [
        "--export-markdown <FILE>"
      ],
      "tip": [
        "将计时汇总统计导出为 Markdown 表格"
      ],
      "next": []
    },
    {
      "name": "--export-orgmode",
      "usage": [
        "--export-orgmode <FILE>"
      ],
      "tip": [
        "将计时汇总统计导出为 Emacs org-mode 表格"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息"
      ]
    },
    {
      "name": "--ignore-failure",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-failure"
      ],
      "tip": [
        "忽略被测试程序的失败"
      ]
    },
    {
      "name": "--input",
      "usage": [
        "--input <WHERE>"
      ],
      "tip": [
        "控制基准测试的输入来源"
      ],
      "next": [
        {
          "name": "null",
          "tip": [
            "从 /dev/null 读取（默认）"
          ]
        }
      ]
    },
    {
      "name": "--max-runs",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --max-runs <NUM>"
      ],
      "tip": [
        "每个命令最多执行 NUM 次运行"
      ],
      "next": []
    },
    {
      "name": "--min-runs",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --min-runs <NUM>"
      ],
      "tip": [
        "每个命令至少执行 NUM 次运行"
      ],
      "next": []
    },
    {
      "name": "--output",
      "usage": [
        "--output <WHERE>"
      ],
      "tip": [
        "控制基准测试的输出重定向位置"
      ],
      "next": [
        {
          "name": "inherit",
          "tip": [
            "不重定向输出"
          ]
        },
        {
          "name": "null",
          "tip": [
            "将输出重定向到 /dev/null（默认）"
          ]
        },
        {
          "name": "pipe",
          "tip": [
            "通过管道传输输出"
          ]
        }
      ]
    },
    {
      "name": "--parameter-list",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --parameter-list <VAR> <VALUES>"
      ],
      "tip": [
        "为逗号分隔列表中的每个值执行基准测试"
      ],
      "next": []
    },
    {
      "name": "--parameter-scan",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --parameter-scan <VAR> <MIN> <MAX>"
      ],
      "tip": [
        "为 MIN..MAX 范围内的每个值执行基准测试"
      ],
      "next": []
    },
    {
      "name": "--parameter-step-size",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --parameter-step-size <DELTA>"
      ],
      "tip": [
        "以 DELTA 为步长遍历 MIN..MAX 范围"
      ],
      "next": []
    },
    {
      "name": "--prepare",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --prepare <CMD>"
      ],
      "tip": [
        "在每次计时运行前执行 CMD"
      ],
      "next": []
    },
    {
      "name": "--reference",
      "usage": [
        "--reference <CMD>"
      ],
      "tip": [
        "用于相对比较的参考命令"
      ],
      "next": []
    },
    {
      "name": "--reference-name",
      "usage": [
        "--reference-name <NAME>"
      ],
      "tip": [
        "为参考命令指定一个有意义的名称"
      ],
      "next": []
    },
    {
      "name": "--runs",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --runs <NUM>"
      ],
      "tip": [
        "每个命令恰好执行 NUM 次运行"
      ],
      "next": []
    },
    {
      "name": "--setup",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --setup <CMD>"
      ],
      "tip": [
        "在每组计时运行前执行 CMD"
      ],
      "next": []
    },
    {
      "name": "--shell",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --shell <SHELL>"
      ],
      "tip": [
        "设置用于执行基准测试命令的 shell"
      ],
      "next": []
    },
    {
      "name": "--show-output",
      "tip": [
        "打印基准测试的 stdout 和 stderr"
      ]
    },
    {
      "name": "--sort",
      "usage": [
        "--sort <METHOD>"
      ],
      "tip": [
        "指定速度比较摘要的排序方式"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "按时间排序（默认）"
          ]
        },
        {
          "name": "command",
          "tip": [
            "按命令输入顺序排序"
          ]
        },
        {
          "name": "mean-time",
          "tip": [
            "按平均运行时间排序"
          ]
        }
      ]
    },
    {
      "name": "--style",
      "usage": [
        "--style <TYPE>"
      ],
      "tip": [
        "设置输出样式类型"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "自动（默认）"
          ]
        },
        {
          "name": "basic",
          "tip": [
            "基本输出"
          ]
        },
        {
          "name": "color",
          "tip": [
            "带颜色但无交互输出"
          ]
        },
        {
          "name": "full",
          "tip": [
            "带所有效果的完整输出"
          ]
        },
        {
          "name": "nocolor",
          "tip": [
            "交互式但无颜色"
          ]
        },
        {
          "name": "none",
          "tip": [
            "禁用所有输出"
          ]
        }
      ]
    },
    {
      "name": "--time-unit",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --time-unit <UNIT>"
      ],
      "tip": [
        "设置使用的时间单位"
      ],
      "next": [
        {
          "name": "microsecond",
          "tip": [
            "微秒"
          ]
        },
        {
          "name": "millisecond",
          "tip": [
            "毫秒"
          ]
        },
        {
          "name": "second",
          "tip": [
            "秒"
          ]
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息"
      ]
    },
    {
      "name": "--warmup",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --warmup <NUM>"
      ],
      "tip": [
        "在实际基准测试前执行 NUM 次预热运行"
      ],
      "next": []
    },
    {
      "name": "-N",
      "tip": [
        "--shell=none 的别名"
      ]
    }
  ]
}
