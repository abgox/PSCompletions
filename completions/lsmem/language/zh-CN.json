{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "列出可用内存范围及其在线状态。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "列出每个单独的内存块。"
      ]
    },
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "以字节而不是人类可读格式打印 SIZE。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "使用 JSON 输出格式。"
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "不打印标题。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "输出列。"
      ],
      "separator": ",",
      "next": [
        {
          "name": "BLOCK",
          "tip": [
            "内存块编号或块范围。"
          ]
        },
        {
          "name": "NODE",
          "tip": [
            "内存所在的 NUMA 节点。"
          ]
        },
        {
          "name": "RANGE",
          "tip": [
            "内存范围的起始和结束地址。"
          ]
        },
        {
          "name": "REMOVABLE",
          "tip": [
            "内存可移除。"
          ]
        },
        {
          "name": "SIZE",
          "tip": [
            "内存范围的大小。"
          ]
        },
        {
          "name": "STATE",
          "tip": [
            "内存范围的在线状态。"
          ]
        },
        {
          "name": "ZONES",
          "tip": [
            "内存范围的有效区域。"
          ]
        }
      ]
    },
    {
      "name": "--output-all",
      "tip": [
        "输出所有列。"
      ]
    },
    {
      "name": "--pairs",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pairs"
      ],
      "tip": [
        "使用 key=\"value\" 输出格式。"
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "使用原始输出格式。"
      ]
    },
    {
      "name": "--split",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --split <list>"
      ],
      "tip": [
        "按指定列拆分范围。"
      ],
      "next": []
    },
    {
      "name": "--summary",
      "usage": [
        "--summary[=when]"
      ],
      "tip": [
        "打印摘要信息。",
        "可能值: never, always, only"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "never"
        },
        {
          "name": "only"
        }
      ]
    },
    {
      "name": "--sysroot",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sysroot <dir>"
      ],
      "tip": [
        "使用指定目录作为系统根目录。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
