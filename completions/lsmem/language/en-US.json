{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "List the ranges of available memory with their online status."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "List each individual memory block."
      ]
    },
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "Print SIZE in bytes rather than in human readable format."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "Use JSON output format."
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "Don't print headings."
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "Output columns."
      ],
      "separator": ",",
      "next": [
        {
          "name": "BLOCK",
          "tip": [
            "Memory block number or blocks range."
          ]
        },
        {
          "name": "NODE",
          "tip": [
            "NUMA node of memory."
          ]
        },
        {
          "name": "RANGE",
          "tip": [
            "Start and end address of the memory range."
          ]
        },
        {
          "name": "REMOVABLE",
          "tip": [
            "Memory is removable."
          ]
        },
        {
          "name": "SIZE",
          "tip": [
            "Size of the memory range."
          ]
        },
        {
          "name": "STATE",
          "tip": [
            "Online status of the memory range."
          ]
        },
        {
          "name": "ZONES",
          "tip": [
            "Valid zones for the memory range."
          ]
        }
      ]
    },
    {
      "name": "--output-all",
      "tip": [
        "Output all columns."
      ]
    },
    {
      "name": "--pairs",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pairs"
      ],
      "tip": [
        "Use key=\"value\" output format."
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "Use raw output format."
      ]
    },
    {
      "name": "--split",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --split <list>"
      ],
      "tip": [
        "Split ranges by specified columns."
      ],
      "next": []
    },
    {
      "name": "--summary",
      "usage": [
        "--summary[=when]"
      ],
      "tip": [
        "Print summary information.",
        "Possible values: never, always, only"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "never"
        },
        {
          "name": "only"
        }
      ]
    },
    {
      "name": "--sysroot",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sysroot <dir>"
      ],
      "tip": [
        "Use the specified directory as system root."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
