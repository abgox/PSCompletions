{
  "meta": {
    "url": "https://github.com/google-gemini/gemini-cli",
    "description": [
      "Gemini CLI - Google 的终端 AI 编程助手。"
    ]
  },
  "next": [
    {
      "name": "extensions",
      "alias": [
        "extension"
      ],
      "usage": [
        "extension|extensions"
      ],
      "tip": [
        "管理 Gemini CLI 扩展。"
      ],
      "next": [
        {
          "name": "config",
          "usage": [
            "config [name] [setting]"
          ],
          "tip": [
            "配置扩展设置。"
          ]
        },
        {
          "name": "disable",
          "usage": [
            "disable [--scope] <name>"
          ],
          "tip": [
            "禁用扩展。"
          ]
        },
        {
          "name": "enable",
          "usage": [
            "enable [--scope] <name>"
          ],
          "tip": [
            "启用扩展。"
          ]
        },
        {
          "name": "install",
          "usage": [
            "install <source> [--auto-update] [--pre-release]"
          ],
          "tip": [
            "从 git 仓库 URL 或本地路径安装扩展。"
          ]
        },
        {
          "name": "link",
          "usage": [
            "link <path>"
          ],
          "tip": [
            "从本地路径链接扩展。"
          ]
        },
        {
          "name": "list",
          "tip": [
            "列出已安装的扩展。"
          ]
        },
        {
          "name": "new",
          "usage": [
            "new <path> [template]"
          ],
          "tip": [
            "从模板创建新扩展。"
          ]
        },
        {
          "name": "uninstall",
          "usage": [
            "uninstall [names..]"
          ],
          "tip": [
            "卸载一个或多个扩展。"
          ]
        },
        {
          "name": "update",
          "usage": [
            "update [<name>] [--all]"
          ],
          "tip": [
            "更新所有扩展或指定扩展到最新版本。"
          ]
        },
        {
          "name": "validate",
          "usage": [
            "validate <path>"
          ],
          "tip": [
            "验证本地路径的扩展。"
          ]
        }
      ]
    },
    {
      "name": "gemma",
      "tip": [
        "管理本地 Gemma 模型路由。"
      ]
    },
    {
      "name": "hooks",
      "alias": [
        "hook"
      ],
      "usage": [
        "hook|hooks"
      ],
      "tip": [
        "管理 Gemini CLI 钩子。"
      ],
      "next": [
        {
          "name": "migrate",
          "tip": [
            "将钩子从 Claude Code 迁移到 Gemini CLI。"
          ]
        }
      ]
    },
    {
      "name": "mcp",
      "tip": [
        "管理 MCP 服务器。"
      ],
      "next": [
        {
          "name": "add",
          "usage": [
            "add <name> <commandOrUrl> [args...]"
          ],
          "tip": [
            "添加 MCP 服务器。"
          ]
        },
        {
          "name": "disable",
          "usage": [
            "disable <name>"
          ],
          "tip": [
            "禁用 MCP 服务器。"
          ]
        },
        {
          "name": "enable",
          "usage": [
            "enable <name>"
          ],
          "tip": [
            "启用 MCP 服务器。"
          ]
        },
        {
          "name": "list",
          "tip": [
            "列出所有已配置的 MCP 服务器。"
          ]
        },
        {
          "name": "remove",
          "usage": [
            "remove <name>"
          ],
          "tip": [
            "移除 MCP 服务器。"
          ]
        }
      ]
    },
    {
      "name": "skills",
      "alias": [
        "skill"
      ],
      "usage": [
        "skill|skills"
      ],
      "tip": [
        "管理代理技能。"
      ],
      "next": [
        {
          "name": "disable",
          "usage": [
            "disable <name> [--scope]"
          ],
          "tip": [
            "禁用代理技能。"
          ]
        },
        {
          "name": "enable",
          "usage": [
            "enable <name>"
          ],
          "tip": [
            "启用代理技能。"
          ]
        },
        {
          "name": "install",
          "usage": [
            "install <source> [--scope] [--path]"
          ],
          "tip": [
            "从 git 仓库 URL 或本地路径安装代理技能。"
          ]
        },
        {
          "name": "link",
          "usage": [
            "link <path>"
          ],
          "tip": [
            "从本地路径链接代理技能。"
          ]
        },
        {
          "name": "list",
          "usage": [
            "list [--all]"
          ],
          "tip": [
            "列出发现的代理技能。"
          ]
        },
        {
          "name": "uninstall",
          "usage": [
            "uninstall <name> [--scope]"
          ],
          "tip": [
            "按名称卸载代理技能。"
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--accept-raw-output-risk",
      "tip": [
        "使用 --raw-output 时抑制安全警告。"
      ]
    },
    {
      "name": "--acp",
      "tip": [
        "在 ACP 模式下启动代理。"
      ]
    },
    {
      "name": "--admin-policy",
      "usage": [
        "--admin-policy <POLICY>"
      ],
      "tip": [
        "要加载的其他管理员策略文件或目录。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--allowed-mcp-server-names",
      "usage": [
        "--allowed-mcp-server-names <NAMES>"
      ],
      "tip": [
        "允许的 MCP 服务器名称。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--allowed-tools",
      "usage": [
        "--allowed-tools <TOOLS>"
      ],
      "tip": [
        "[已弃用] 允许无需确认即可运行的工具。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--approval-mode",
      "usage": [
        "--approval-mode <MODE>"
      ],
      "tip": [
        "设置批准模式。",
        "可选值: default, auto_edit, yolo, plan"
      ],
      "next": [
        {
          "name": "auto_edit",
          "tip": [
            "自动批准编辑工具。"
          ]
        },
        {
          "name": "default",
          "tip": [
            "请求批准。"
          ]
        },
        {
          "name": "plan",
          "tip": [
            "只读模式。"
          ]
        },
        {
          "name": "yolo",
          "tip": [
            "自动批准所有工具。"
          ]
        }
      ]
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "在调试模式下运行（按 F12 打开调试控制台）。"
      ]
    },
    {
      "name": "--delete-session",
      "usage": [
        "--delete-session <INDEX>"
      ],
      "tip": [
        "按索引号删除会话。"
      ],
      "next": []
    },
    {
      "name": "--extensions",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --extensions <EXTENSIONS>"
      ],
      "tip": [
        "要使用的扩展列表。",
        "如果未提供，将使用所有扩展。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--include-directories",
      "usage": [
        "--include-directories <DIRS>"
      ],
      "tip": [
        "要包含在工作区中的其他目录。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--list-extensions",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list-extensions"
      ],
      "tip": [
        "列出所有可用扩展并退出。"
      ]
    },
    {
      "name": "--list-sessions",
      "tip": [
        "列出当前项目的可用会话并退出。"
      ]
    },
    {
      "name": "--model",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --model <MODEL>"
      ],
      "tip": [
        "指定要使用的模型。"
      ],
      "next": []
    },
    {
      "name": "--output-format",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output-format <FORMAT>"
      ],
      "tip": [
        "CLI 输出的格式。",
        "可选值: text, json, stream-json"
      ],
      "next": [
        {
          "name": "json",
          "tip": [
            "JSON 输出。"
          ]
        },
        {
          "name": "stream-json",
          "tip": [
            "流式 JSON 输出。"
          ]
        },
        {
          "name": "text",
          "tip": [
            "纯文本输出。"
          ]
        }
      ]
    },
    {
      "name": "--policy",
      "usage": [
        "--policy <POLICY>"
      ],
      "tip": [
        "要加载的其他策略文件或目录。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--prompt",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --prompt <PROMPT>"
      ],
      "tip": [
        "以非交互（无头）模式运行给定的提示。",
        "如果 stdin 有输入，会追加到输入中。"
      ],
      "next": []
    },
    {
      "name": "--prompt-interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --prompt-interactive <PROMPT>"
      ],
      "tip": [
        "执行提供的提示并继续在交互模式下运行。"
      ],
      "next": []
    },
    {
      "name": "--raw-output",
      "tip": [
        "禁用模型输出的清理。",
        "警告：如果模型输出不可信，这可能存在安全风险。"
      ]
    },
    {
      "name": "--resume",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --resume [SESSION]"
      ],
      "tip": [
        "恢复之前的会话。",
        "使用 'latest' 恢复最近的会话，或使用索引号。"
      ],
      "next": []
    },
    {
      "name": "--sandbox",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sandbox"
      ],
      "tip": [
        "在沙箱中运行。"
      ]
    },
    {
      "name": "--screen-reader",
      "tip": [
        "启用屏幕阅读器模式以支持无障碍访问。"
      ]
    },
    {
      "name": "--session-file",
      "usage": [
        "--session-file <FILE>"
      ],
      "tip": [
        "从 JSON 文件加载会话。"
      ],
      "next": []
    },
    {
      "name": "--session-id",
      "usage": [
        "--session-id <UUID>"
      ],
      "tip": [
        "使用手动提供的 UUID 启动新会话。"
      ],
      "next": []
    },
    {
      "name": "--skip-trust",
      "tip": [
        "为当前会话信任当前工作区。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示版本号。"
      ]
    },
    {
      "name": "--worktree",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --worktree [NAME]"
      ],
      "tip": [
        "在新的 git worktree 中启动 Gemini。",
        "如果未提供名称，会自动生成。"
      ],
      "next": []
    },
    {
      "name": "--yolo",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --yolo"
      ],
      "tip": [
        "自动接受所有操作（YOLO 模式）。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "在调试模式下运行。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助。"
      ]
    }
  ]
}
