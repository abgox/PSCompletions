{
  "meta": {
    "url": "https://github.com/google-gemini/gemini-cli",
    "description": [
      "Gemini CLI - Google's AI-powered coding assistant in the terminal."
    ]
  },
  "next": [
    {
      "name": "extensions",
      "alias": [
        "extension"
      ],
      "usage": [
        "extension|extensions"
      ],
      "tip": [
        "Manage Gemini CLI extensions."
      ],
      "next": [
        {
          "name": "config",
          "usage": [
            "config [name] [setting]"
          ],
          "tip": [
            "Configure extension settings."
          ]
        },
        {
          "name": "disable",
          "usage": [
            "disable [--scope] <name>"
          ],
          "tip": [
            "Disable an extension."
          ]
        },
        {
          "name": "enable",
          "usage": [
            "enable [--scope] <name>"
          ],
          "tip": [
            "Enable an extension."
          ]
        },
        {
          "name": "install",
          "usage": [
            "install <source> [--auto-update] [--pre-release]"
          ],
          "tip": [
            "Install an extension from a git repository URL or a local path."
          ]
        },
        {
          "name": "link",
          "usage": [
            "link <path>"
          ],
          "tip": [
            "Link an extension from a local path."
          ]
        },
        {
          "name": "list",
          "tip": [
            "List installed extensions."
          ]
        },
        {
          "name": "new",
          "usage": [
            "new <path> [template]"
          ],
          "tip": [
            "Create a new extension from a boilerplate example."
          ]
        },
        {
          "name": "uninstall",
          "usage": [
            "uninstall [names..]"
          ],
          "tip": [
            "Uninstall one or more extensions."
          ]
        },
        {
          "name": "update",
          "usage": [
            "update [<name>] [--all]"
          ],
          "tip": [
            "Update all extensions or a named extension to the latest version."
          ]
        },
        {
          "name": "validate",
          "usage": [
            "validate <path>"
          ],
          "tip": [
            "Validate an extension from a local path."
          ]
        }
      ]
    },
    {
      "name": "gemma",
      "tip": [
        "Manage local Gemma model routing."
      ]
    },
    {
      "name": "hooks",
      "alias": [
        "hook"
      ],
      "usage": [
        "hook|hooks"
      ],
      "tip": [
        "Manage Gemini CLI hooks."
      ],
      "next": [
        {
          "name": "migrate",
          "tip": [
            "Migrate hooks from Claude Code to Gemini CLI."
          ]
        }
      ]
    },
    {
      "name": "mcp",
      "tip": [
        "Manage MCP servers."
      ],
      "next": [
        {
          "name": "add",
          "usage": [
            "add <name> <commandOrUrl> [args...]"
          ],
          "tip": [
            "Add an MCP server."
          ]
        },
        {
          "name": "disable",
          "usage": [
            "disable <name>"
          ],
          "tip": [
            "Disable an MCP server."
          ]
        },
        {
          "name": "enable",
          "usage": [
            "enable <name>"
          ],
          "tip": [
            "Enable an MCP server."
          ]
        },
        {
          "name": "list",
          "tip": [
            "List all configured MCP servers."
          ]
        },
        {
          "name": "remove",
          "usage": [
            "remove <name>"
          ],
          "tip": [
            "Remove an MCP server."
          ]
        }
      ]
    },
    {
      "name": "skills",
      "alias": [
        "skill"
      ],
      "usage": [
        "skill|skills"
      ],
      "tip": [
        "Manage agent skills."
      ],
      "next": [
        {
          "name": "disable",
          "usage": [
            "disable <name> [--scope]"
          ],
          "tip": [
            "Disable an agent skill."
          ]
        },
        {
          "name": "enable",
          "usage": [
            "enable <name>"
          ],
          "tip": [
            "Enable an agent skill."
          ]
        },
        {
          "name": "install",
          "usage": [
            "install <source> [--scope] [--path]"
          ],
          "tip": [
            "Install an agent skill from a git repository URL or a local path."
          ]
        },
        {
          "name": "link",
          "usage": [
            "link <path>"
          ],
          "tip": [
            "Link an agent skill from a local path."
          ]
        },
        {
          "name": "list",
          "usage": [
            "list [--all]"
          ],
          "tip": [
            "List discovered agent skills."
          ]
        },
        {
          "name": "uninstall",
          "usage": [
            "uninstall <name> [--scope]"
          ],
          "tip": [
            "Uninstall an agent skill by name."
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--accept-raw-output-risk",
      "tip": [
        "Suppress the security warning when using --raw-output."
      ]
    },
    {
      "name": "--acp",
      "tip": [
        "Starts the agent in ACP mode."
      ]
    },
    {
      "name": "--admin-policy",
      "usage": [
        "--admin-policy <POLICY>"
      ],
      "tip": [
        "Additional admin policy files or directories to load."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--allowed-mcp-server-names",
      "usage": [
        "--allowed-mcp-server-names <NAMES>"
      ],
      "tip": [
        "Allowed MCP server names."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--allowed-tools",
      "usage": [
        "--allowed-tools <TOOLS>"
      ],
      "tip": [
        "[DEPRECATED] Tools that are allowed to run without confirmation."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--approval-mode",
      "usage": [
        "--approval-mode <MODE>"
      ],
      "tip": [
        "Set the approval mode.",
        "Possible values: default, auto_edit, yolo, plan"
      ],
      "next": [
        {
          "name": "auto_edit",
          "tip": [
            "Auto-approve edit tools."
          ]
        },
        {
          "name": "default",
          "tip": [
            "Prompt for approval."
          ]
        },
        {
          "name": "plan",
          "tip": [
            "Read-only mode."
          ]
        },
        {
          "name": "yolo",
          "tip": [
            "Auto-approve all tools."
          ]
        }
      ]
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "Run in debug mode (open debug console with F12)."
      ]
    },
    {
      "name": "--delete-session",
      "usage": [
        "--delete-session <INDEX>"
      ],
      "tip": [
        "Delete a session by index number."
      ],
      "next": []
    },
    {
      "name": "--extensions",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --extensions <EXTENSIONS>"
      ],
      "tip": [
        "A list of extensions to use.",
        "If not provided, all extensions are used."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--include-directories",
      "usage": [
        "--include-directories <DIRS>"
      ],
      "tip": [
        "Additional directories to include in the workspace."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--list-extensions",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list-extensions"
      ],
      "tip": [
        "List all available extensions and exit."
      ]
    },
    {
      "name": "--list-sessions",
      "tip": [
        "List available sessions for the current project and exit."
      ]
    },
    {
      "name": "--model",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --model <MODEL>"
      ],
      "tip": [
        "Specify the model to use."
      ],
      "next": []
    },
    {
      "name": "--output-format",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output-format <FORMAT>"
      ],
      "tip": [
        "The format of the CLI output.",
        "Possible values: text, json, stream-json"
      ],
      "next": [
        {
          "name": "json",
          "tip": [
            "JSON output."
          ]
        },
        {
          "name": "stream-json",
          "tip": [
            "Streaming JSON output."
          ]
        },
        {
          "name": "text",
          "tip": [
            "Plain text output."
          ]
        }
      ]
    },
    {
      "name": "--policy",
      "usage": [
        "--policy <POLICY>"
      ],
      "tip": [
        "Additional policy files or directories to load."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--prompt",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --prompt <PROMPT>"
      ],
      "tip": [
        "Run in non-interactive (headless) mode with the given prompt.",
        "Appended to input on stdin (if any)."
      ],
      "next": []
    },
    {
      "name": "--prompt-interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --prompt-interactive <PROMPT>"
      ],
      "tip": [
        "Execute the provided prompt and continue in interactive mode."
      ],
      "next": []
    },
    {
      "name": "--raw-output",
      "tip": [
        "Disable sanitization of model output.",
        "WARNING: This can be a security risk if the model output is untrusted."
      ]
    },
    {
      "name": "--resume",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --resume [SESSION]"
      ],
      "tip": [
        "Resume a previous session.",
        "Use 'latest' for most recent or index number."
      ],
      "next": []
    },
    {
      "name": "--sandbox",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sandbox"
      ],
      "tip": [
        "Run in sandbox."
      ]
    },
    {
      "name": "--screen-reader",
      "tip": [
        "Enable screen reader mode for accessibility."
      ]
    },
    {
      "name": "--session-file",
      "usage": [
        "--session-file <FILE>"
      ],
      "tip": [
        "Load a session from a JSON file."
      ],
      "next": []
    },
    {
      "name": "--session-id",
      "usage": [
        "--session-id <UUID>"
      ],
      "tip": [
        "Start a new session with a manually provided UUID."
      ],
      "next": []
    },
    {
      "name": "--skip-trust",
      "tip": [
        "Trust the current workspace for this session."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Show version number."
      ]
    },
    {
      "name": "--worktree",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --worktree [NAME]"
      ],
      "tip": [
        "Start Gemini in a new git worktree.",
        "If no name is provided, one is generated automatically."
      ],
      "next": []
    },
    {
      "name": "--yolo",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --yolo"
      ],
      "tip": [
        "Automatically accept all actions (YOLO mode)."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "Run in debug mode."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show help."
      ]
    }
  ]
}
