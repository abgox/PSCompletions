{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Display or manipulate a disk partition table."
    ]
  },
  "option": [
    {
      "name": "--bytes",
      "tip": [
        "Print SIZE in bytes rather than in human readable format."
      ]
    },
    {
      "name": "--color",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --color[=<when>]"
      ],
      "tip": [
        "Colorize output.",
        "Colors are enabled by default.",
        "Possible values: auto, always, never"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--compatibility",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --compatibility[=<mode>]"
      ],
      "tip": [
        "Compatibility mode.",
        "Possible values: dos, nondos",
        "Default: nondos"
      ],
      "next": [
        {
          "name": "dos"
        },
        {
          "name": "nondos"
        }
      ]
    },
    {
      "name": "--cylinders",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --cylinders <number>"
      ],
      "tip": [
        "Specify the number of cylinders."
      ],
      "next": []
    },
    {
      "name": "--getsz",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --getsz"
      ],
      "tip": [
        "Display device size in 512-byte sectors. (deprecated)"
      ]
    },
    {
      "name": "--heads",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --heads <number>"
      ],
      "tip": [
        "Specify the number of heads."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "Display partitions and exit."
      ]
    },
    {
      "name": "--list-details",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --list-details"
      ],
      "tip": [
        "Like --list but with more details."
      ]
    },
    {
      "name": "--lock",
      "usage": [
        "--lock[=<mode>]"
      ],
      "tip": [
        "Use exclusive device lock.",
        "Possible values: yes, no, nonblock"
      ],
      "next": [
        {
          "name": "no"
        },
        {
          "name": "nonblock"
        },
        {
          "name": "yes"
        }
      ]
    },
    {
      "name": "--noauto-pt",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noauto-pt"
      ],
      "tip": [
        "Don't create a default partition table on empty devices."
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "Output columns."
      ],
      "next": []
    },
    {
      "name": "--protect-boot",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --protect-boot"
      ],
      "tip": [
        "Don't erase bootbits when creating a new label."
      ]
    },
    {
      "name": "--sector-size",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --sector-size <size>"
      ],
      "tip": [
        "Physical and logical sector size."
      ],
      "next": []
    },
    {
      "name": "--sectors",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --sectors <number>"
      ],
      "tip": [
        "Specify the number of sectors per track."
      ],
      "next": []
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <type>"
      ],
      "tip": [
        "Recognize specified partition table type only."
      ],
      "next": []
    },
    {
      "name": "--units",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --units[=<unit>]"
      ],
      "tip": [
        "Display units.",
        "Possible values: cylinders, sectors",
        "Default: sectors"
      ],
      "next": [
        {
          "name": "cylinders"
        },
        {
          "name": "sectors"
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--wipe",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wipe <mode>"
      ],
      "tip": [
        "Wipe signatures.",
        "Possible values: auto, always, never"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--wipe-partitions",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --wipe-partitions <mode>"
      ],
      "tip": [
        "Wipe signatures from new partitions.",
        "Possible values: auto, always, never"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    }
  ]
}
