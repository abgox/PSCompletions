{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示或操作磁盘分区表。"
    ]
  },
  "option": [
    {
      "name": "--bytes",
      "tip": [
        "以字节而不是人类可读格式打印 SIZE。"
      ]
    },
    {
      "name": "--color",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --color[=<when>]"
      ],
      "tip": [
        "为输出着色。",
        "默认启用颜色。",
        "可能值: auto, always, never"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--compatibility",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --compatibility[=<mode>]"
      ],
      "tip": [
        "兼容模式。",
        "可能值: dos, nondos",
        "默认: nondos"
      ],
      "next": [
        {
          "name": "dos"
        },
        {
          "name": "nondos"
        }
      ]
    },
    {
      "name": "--cylinders",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --cylinders <number>"
      ],
      "tip": [
        "指定柱面数。"
      ],
      "next": []
    },
    {
      "name": "--getsz",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --getsz"
      ],
      "tip": [
        "以 512 字节扇区显示设备大小。(已弃用)"
      ]
    },
    {
      "name": "--heads",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --heads <number>"
      ],
      "tip": [
        "指定磁头数。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "显示分区后退出。"
      ]
    },
    {
      "name": "--list-details",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --list-details"
      ],
      "tip": [
        "类似 --list，但包含更多细节。"
      ]
    },
    {
      "name": "--lock",
      "usage": [
        "--lock[=<mode>]"
      ],
      "tip": [
        "使用独占的设备锁。",
        "可能值: yes, no, nonblock"
      ],
      "next": [
        {
          "name": "no"
        },
        {
          "name": "nonblock"
        },
        {
          "name": "yes"
        }
      ]
    },
    {
      "name": "--noauto-pt",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noauto-pt"
      ],
      "tip": [
        "不在空设备上创建默认分区表。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "输出列。"
      ],
      "next": []
    },
    {
      "name": "--protect-boot",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --protect-boot"
      ],
      "tip": [
        "创建新标签时不擦除引导位。"
      ]
    },
    {
      "name": "--sector-size",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --sector-size <size>"
      ],
      "tip": [
        "物理和逻辑扇区大小。"
      ],
      "next": []
    },
    {
      "name": "--sectors",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --sectors <number>"
      ],
      "tip": [
        "指定每磁道扇区数。"
      ],
      "next": []
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <type>"
      ],
      "tip": [
        "仅识别指定的分区表类型。"
      ],
      "next": []
    },
    {
      "name": "--units",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --units[=<unit>]"
      ],
      "tip": [
        "显示单位。",
        "可能值: cylinders, sectors",
        "默认: sectors"
      ],
      "next": [
        {
          "name": "cylinders"
        },
        {
          "name": "sectors"
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--wipe",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wipe <mode>"
      ],
      "tip": [
        "擦除签名。",
        "可能值: auto, always, never"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--wipe-partitions",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --wipe-partitions <mode>"
      ],
      "tip": [
        "擦除新分区的签名。",
        "可能值: auto, always, never"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    }
  ]
}
