{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "创建新用户或更新默认的新用户信息。"
    ]
  },
  "option": [
    {
      "name": "--add-subids-for-system",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --add-subids-for-system"
      ],
      "tip": [
        "即使是添加系统用户，也向 sub[ud]id 添加条目。"
      ]
    },
    {
      "name": "--badname",
      "tip": [
        "不检查不合规的名称。(已弃用)"
      ]
    },
    {
      "name": "--base-dir",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --base-dir <BASE_DIR>"
      ],
      "tip": [
        "新账户主目录的基础目录。"
      ],
      "next": []
    },
    {
      "name": "--btrfs-subvolume-home",
      "tip": [
        "为主目录使用 BTRFS 子卷。"
      ]
    },
    {
      "name": "--comment",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --comment <COMMENT>"
      ],
      "tip": [
        "新账户的 GECOS 字段。"
      ],
      "next": []
    },
    {
      "name": "--create-home",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --create-home"
      ],
      "tip": [
        "创建用户的主目录。"
      ]
    },
    {
      "name": "--defaults",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --defaults"
      ],
      "tip": [
        "打印或更改 useradd 的默认配置。"
      ]
    },
    {
      "name": "--expiredate",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --expiredate <EXPIRE_DATE>"
      ],
      "tip": [
        "新账户的失效日期。"
      ],
      "next": []
    },
    {
      "name": "--gid",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --gid <GROUP>"
      ],
      "tip": [
        "新账户主组的名称或 ID。"
      ],
      "next": []
    },
    {
      "name": "--groups",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --groups <GROUPS>"
      ],
      "tip": [
        "新账户的附加组列表。"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--home-dir",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --home-dir <HOME_DIR>"
      ],
      "tip": [
        "新账户的主目录。"
      ],
      "next": []
    },
    {
      "name": "--inactive",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --inactive <INACTIVE>"
      ],
      "tip": [
        "新账户的密码不活跃期。"
      ],
      "next": []
    },
    {
      "name": "--key",
      "alias": [
        "-K"
      ],
      "usage": [
        "-K, --key <KEY=VALUE>"
      ],
      "tip": [
        "覆盖 /etc/login.defs 的默认值。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--no-create-home",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --no-create-home"
      ],
      "tip": [
        "不创建用户的主目录。"
      ]
    },
    {
      "name": "--no-log-init",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --no-log-init"
      ],
      "tip": [
        "不将用户添加到 lastlog 和 faillog 数据库。"
      ]
    },
    {
      "name": "--no-user-group",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --no-user-group"
      ],
      "tip": [
        "不创建与用户同名的组。"
      ]
    },
    {
      "name": "--non-unique",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --non-unique"
      ],
      "tip": [
        "允许创建具有重复（非唯一）UID 的用户。"
      ]
    },
    {
      "name": "--password",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --password <PASSWORD>"
      ],
      "tip": [
        "新账户的加密密码。"
      ],
      "next": []
    },
    {
      "name": "--prefix",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --prefix <PREFIX_DIR>"
      ],
      "tip": [
        "在 PREFIX_DIR 下的根文件系统中应用对配置文件的更改。",
        "该选项不会 chroot，用于准备交叉编译目标。"
      ],
      "next": []
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--selinux-range",
      "usage": [
        "--selinux-range <SERANGE>"
      ],
      "tip": [
        "为 SELinux 用户映射使用特定的 MLS 范围。"
      ],
      "next": []
    },
    {
      "name": "--selinux-user",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --selinux-user <SEUSER>"
      ],
      "tip": [
        "为 SELinux 用户映射使用特定的 SEUSER。"
      ],
      "next": []
    },
    {
      "name": "--shell",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shell <SHELL>"
      ],
      "tip": [
        "新账户的登录 Shell。"
      ],
      "next": []
    },
    {
      "name": "--skel",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --skel <SKEL_DIR>"
      ],
      "tip": [
        "使用此替代骨架目录。"
      ],
      "next": []
    },
    {
      "name": "--system",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --system"
      ],
      "tip": [
        "创建系统账户。"
      ]
    },
    {
      "name": "--uid",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uid <UID>"
      ],
      "tip": [
        "新账户的用户 ID。"
      ],
      "next": []
    },
    {
      "name": "--user-group",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --user-group"
      ],
      "tip": [
        "创建与用户同名的组。"
      ]
    }
  ]
}
