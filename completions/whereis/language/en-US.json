{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Locate the binary, source, and manual-page files for a command."
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "-b",
      "tip": [
        "Search only for binaries."
      ]
    },
    {
      "name": "-B",
      "usage": [
        "-B <dirs>"
      ],
      "tip": [
        "Define binaries lookup path."
      ],
      "next": []
    },
    {
      "name": "-f",
      "tip": [
        "Terminate <dirs> argument list."
      ]
    },
    {
      "name": "-g",
      "tip": [
        "Interpret name as glob (pathnames pattern)."
      ]
    },
    {
      "name": "-l",
      "tip": [
        "Output effective lookup paths."
      ]
    },
    {
      "name": "-m",
      "tip": [
        "Search only for manuals and infos."
      ]
    },
    {
      "name": "-M",
      "usage": [
        "-M <dirs>"
      ],
      "tip": [
        "Define man and info lookup path."
      ],
      "next": []
    },
    {
      "name": "-s",
      "tip": [
        "Search only for sources."
      ]
    },
    {
      "name": "-S",
      "usage": [
        "-S <dirs>"
      ],
      "tip": [
        "Define sources lookup path."
      ],
      "next": []
    },
    {
      "name": "-u",
      "tip": [
        "Search for unusual entries."
      ]
    }
  ]
}
