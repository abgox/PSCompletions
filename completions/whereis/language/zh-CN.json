{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "定位命令的二进制、源码和手册页文件。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "-b",
      "tip": [
        "仅搜索二进制文件。"
      ]
    },
    {
      "name": "-B",
      "usage": [
        "-B <dirs>"
      ],
      "tip": [
        "定义二进制查找路径。"
      ],
      "next": []
    },
    {
      "name": "-f",
      "tip": [
        "终止 <dirs> 参数列表。"
      ]
    },
    {
      "name": "-g",
      "tip": [
        "将名称解释为 glob（路径名模式）。"
      ]
    },
    {
      "name": "-l",
      "tip": [
        "输出生效的查找路径。"
      ]
    },
    {
      "name": "-m",
      "tip": [
        "仅搜索手册和信息文件。"
      ]
    },
    {
      "name": "-M",
      "usage": [
        "-M <dirs>"
      ],
      "tip": [
        "定义手册和信息查找路径。"
      ],
      "next": []
    },
    {
      "name": "-s",
      "tip": [
        "仅搜索源码。"
      ]
    },
    {
      "name": "-S",
      "usage": [
        "-S <dirs>"
      ],
      "tip": [
        "定义源码查找路径。"
      ],
      "next": []
    },
    {
      "name": "-u",
      "tip": [
        "搜索不寻常的条目。"
      ]
    }
  ]
}
