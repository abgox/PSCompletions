{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "以 NEWROOT 为根目录运行 COMMAND"
    ]
  },
  "option": [
    {
      "name": "--groups",
      "usage": [
        "--groups <GROUP1,GROUP2...>"
      ],
      "tip": [
        "要切换到的组，以逗号分隔的列表"
      ],
      "next": []
    },
    {
      "name": "--skip-chdir",
      "tip": [
        "更改根目录后不将工作目录切换到 /，即停留在 chroot 内"
      ]
    },
    {
      "name": "--userspec",
      "usage": [
        "--userspec <USER:GROUP>"
      ],
      "tip": [
        "要切换到的用户和组，以冒号分隔"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
