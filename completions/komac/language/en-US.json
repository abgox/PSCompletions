    {
      "name": "cleanup",
      "alias": [
        "clean"
      ],
      "usage": [
        "clean|cleanup [OPTIONS]"
      ],
      "tip": [
        "Finds branches from the fork of winget-pkgs that have had a merged or closed pull request, prompting for which ones to delete."
      ],
      "option": [
        {
          "name": "--all",
          "alias": [
            "-a"
          ],
          "usage": [
            "-a, --all"
          ],
          "tip": [
            "Automatically delete all relevant branches."
          ]
        },
        {
          "name": "--only-closed",
          "tip": [
            "Only delete closed branches."
          ]
        },
        {
          "name": "--only-merged",
          "tip": [
            "Only delete merged branches."
          ]
        },
        {
          "name": "--token",
          "alias": [
            "-t"
          ],
          "usage": [
            "-t, --token <TOKEN>"
          ],
          "tip": [
            "GitHub personal access token with the public_repo scope."
          ],
          "next": []
        }
      ]
    },
    {
      "name": "list-versions",
