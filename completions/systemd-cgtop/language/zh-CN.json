{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "按资源使用情况显示排名靠前的控制组。"
    ]
  },
  "option": [
    {
      "name": "--batch",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --batch"
      ],
      "tip": [
        "以批处理模式运行，不接受输入。"
      ]
    },
    {
      "name": "--cpu",
      "usage": [
        "--cpu[=percentage]"
      ],
      "tip": [
        "以百分比显示 CPU 使用率（默认）。",
        "使用 --cpu=time 以时间显示 CPU 使用率。"
      ]
    },
    {
      "name": "--delay",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delay=DELAY"
      ],
      "tip": [
        "更新之间的延迟。"
      ],
      "next": []
    },
    {
      "name": "--depth",
      "usage": [
        "--depth=DEPTH"
      ],
      "tip": [
        "最大遍历深度（默认: 3）。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--iterations",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --iterations=N"
      ],
      "tip": [
        "运行 N 次迭代后退出。"
      ],
      "next": []
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=NAME"
      ],
      "tip": [
        "显示指定名称的容器。"
      ],
      "next": []
    },
    {
      "name": "--order",
      "usage": [
        "--order=path|tasks|cpu|memory|io"
      ],
      "tip": [
        "按指定属性排序。",
        "可能值: path, tasks, cpu, memory, io"
      ],
      "next": [
        {
          "name": "cpu"
        },
        {
          "name": "io"
        },
        {
          "name": "memory"
        },
        {
          "name": "path"
        },
        {
          "name": "tasks"
        }
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "提供原始（非人类可读）数字。"
      ]
    },
    {
      "name": "--recursive",
      "usage": [
        "--recursive=BOOL"
      ],
      "tip": [
        "递归汇总进程数。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "-1",
      "tip": [
        "--iterations=1 的快捷方式。"
      ]
    },
    {
      "name": "-c",
      "tip": [
        "等同于 --order=cpu。"
      ]
    },
    {
      "name": "-i",
      "tip": [
        "等同于 --order=io。"
      ]
    },
    {
      "name": "-k",
      "tip": [
        "统计所有进程而不是任务，包含内核线程。"
      ]
    },
    {
      "name": "-m",
      "tip": [
        "等同于 --order=memory。"
      ]
    },
    {
      "name": "-p",
      "tip": [
        "等同于 --order=path。"
      ]
    },
    {
      "name": "-P",
      "tip": [
        "统计用户空间进程而不是任务，排除内核线程。"
      ]
    },
    {
      "name": "-t",
      "tip": [
        "等同于 --order=tasks。"
      ]
    }
  ]
}
