{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Show top control groups by their resource usage."
    ]
  },
  "option": [
    {
      "name": "--batch",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --batch"
      ],
      "tip": [
        "Run in batch mode, accepting no input."
      ]
    },
    {
      "name": "--cpu",
      "usage": [
        "--cpu[=percentage]"
      ],
      "tip": [
        "Show CPU usage as percentage (the default).",
        "Use --cpu=time to show CPU usage as time."
      ]
    },
    {
      "name": "--delay",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delay=DELAY"
      ],
      "tip": [
        "Delay between updates."
      ],
      "next": []
    },
    {
      "name": "--depth",
      "usage": [
        "--depth=DEPTH"
      ],
      "tip": [
        "Maximum traversal depth (default: 3)."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--iterations",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --iterations=N"
      ],
      "tip": [
        "Run for N iterations before exiting."
      ],
      "next": []
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=NAME"
      ],
      "tip": [
        "Show the container with this name."
      ],
      "next": []
    },
    {
      "name": "--order",
      "usage": [
        "--order=path|tasks|cpu|memory|io"
      ],
      "tip": [
        "Order by the specified property.",
        "Possible values: path, tasks, cpu, memory, io"
      ],
      "next": [
        {
          "name": "cpu"
        },
        {
          "name": "io"
        },
        {
          "name": "memory"
        },
        {
          "name": "path"
        },
        {
          "name": "tasks"
        }
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "Provide raw (not human-readable) numbers."
      ]
    },
    {
      "name": "--recursive",
      "usage": [
        "--recursive=BOOL"
      ],
      "tip": [
        "Sum up the process count recursively."
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    },
    {
      "name": "-1",
      "tip": [
        "Shortcut for --iterations=1."
      ]
    },
    {
      "name": "-c",
      "tip": [
        "Same as --order=cpu."
      ]
    },
    {
      "name": "-i",
      "tip": [
        "Same as --order=io."
      ]
    },
    {
      "name": "-k",
      "tip": [
        "Count all processes instead of tasks, including kernel threads."
      ]
    },
    {
      "name": "-m",
      "tip": [
        "Same as --order=memory."
      ]
    },
    {
      "name": "-p",
      "tip": [
        "Same as --order=path."
      ]
    },
    {
      "name": "-P",
      "tip": [
        "Count userspace processes instead of tasks, excluding kernel threads."
      ]
    },
    {
      "name": "-t",
      "tip": [
        "Same as --order=tasks."
      ]
    }
  ]
}
