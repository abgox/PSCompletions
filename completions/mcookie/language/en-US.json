{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Generate magic cookies for xauth."
    ]
  },
  "option": [
    {
      "name": "--file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file <file>"
      ],
      "tip": [
        "Use file as a cookie seed."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--max-size",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --max-size <num>"
      ],
      "tip": [
        "Limit how much is read from seed files."
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Explain what is being done."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
