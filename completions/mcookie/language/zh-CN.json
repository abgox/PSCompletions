{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "为 xauth 生成 magic cookie。"
    ]
  },
  "option": [
    {
      "name": "--file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file <file>"
      ],
      "tip": [
        "使用文件作为 cookie 种子。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--max-size",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --max-size <num>"
      ],
      "tip": [
        "限制从种子文件读取的量。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "说明正在执行的操作。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
