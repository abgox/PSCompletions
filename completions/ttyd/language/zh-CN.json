{
  "meta": {
    "url": "https://github.com/tsl0922/ttyd",
    "description": [
      "在 Web 上共享终端的工具"
    ]
  },
  "option": [
    {
      "name": "--auth-header",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --auth-header <NAME>"
      ],
      "tip": [
        "认证代理的 HTTP 请求头名称"
      ],
      "next": []
    },
    {
      "name": "--base-path",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --base-path <PATH>"
      ],
      "tip": [
        "反向代理请求的预期基础路径"
      ],
      "next": []
    },
    {
      "name": "--browser",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --browser"
      ],
      "tip": [
        "使用系统默认浏览器打开终端"
      ]
    },
    {
      "name": "--check-origin",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --check-origin"
      ],
      "tip": [
        "不允许来自不同来源的 WebSocket 连接"
      ]
    },
    {
      "name": "--client-option",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --client-option <KEY=VALUE>"
      ],
      "tip": [
        "向客户端发送选项，可重复添加更多选项"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--credential",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --credential <USER:PASS>"
      ],
      "tip": [
        "基本认证的凭据"
      ],
      "next": []
    },
    {
      "name": "--cwd",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --cwd <DIR>"
      ],
      "tip": [
        "为子程序设置的工作目录"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug <LEVEL>"
      ],
      "tip": [
        "设置日志级别（默认：7）"
      ],
      "next": []
    },
    {
      "name": "--exit-no-conn",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --exit-no-conn"
      ],
      "tip": [
        "所有客户端断开连接后退出"
      ]
    },
    {
      "name": "--gid",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --gid <GID>"
      ],
      "tip": [
        "运行时使用的组 ID"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印此文本并退出"
      ]
    },
    {
      "name": "--index",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --index <PATH>"
      ],
      "tip": [
        "自定义 index.html 路径"
      ],
      "next": []
    },
    {
      "name": "--interface",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interface <INTERFACE>"
      ],
      "tip": [
        "绑定的网络接口，或 UNIX 域套接字路径"
      ],
      "next": []
    },
    {
      "name": "--ipv6",
      "alias": [
        "-6"
      ],
      "usage": [
        "-6, --ipv6"
      ],
      "tip": [
        "启用 IPv6 支持"
      ]
    },
    {
      "name": "--max-clients",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --max-clients <NUM>"
      ],
      "tip": [
        "支持的最大客户端数（默认：0，无限制）"
      ],
      "next": []
    },
    {
      "name": "--once",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --once"
      ],
      "tip": [
        "仅接受一个客户端并在断开连接后退出"
      ]
    },
    {
      "name": "--ping-interval",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --ping-interval <SEC>"
      ],
      "tip": [
        "WebSocket 心跳间隔（秒）（默认：5）"
      ],
      "next": []
    },
    {
      "name": "--port",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --port <PORT>"
      ],
      "tip": [
        "监听端口（默认：7681，使用 0 获取随机端口）"
      ],
      "next": []
    },
    {
      "name": "--signal",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --signal <SIGNAL>"
      ],
      "tip": [
        "退出命令时向其发送的信号（默认：1，SIGHUP）"
      ],
      "next": []
    },
    {
      "name": "--socket-owner",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --socket-owner <OWNER>"
      ],
      "tip": [
        "UNIX 域套接字文件的用户所有者"
      ],
      "next": []
    },
    {
      "name": "--ssl",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --ssl"
      ],
      "tip": [
        "启用 SSL"
      ]
    },
    {
      "name": "--ssl-ca",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --ssl-ca <FILE>"
      ],
      "tip": [
        "用于客户端证书验证的 SSL CA 文件路径"
      ],
      "next": []
    },
    {
      "name": "--ssl-cert",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --ssl-cert <FILE>"
      ],
      "tip": [
        "SSL 证书文件路径"
      ],
      "next": []
    },
    {
      "name": "--ssl-key",
      "alias": [
        "-K"
      ],
      "usage": [
        "-K, --ssl-key <FILE>"
      ],
      "tip": [
        "SSL 密钥文件路径"
      ],
      "next": []
    },
    {
      "name": "--terminal-type",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --terminal-type <TYPE>"
      ],
      "tip": [
        "报告的终端类型（默认：xterm-256color）"
      ],
      "next": []
    },
    {
      "name": "--uid",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uid <UID>"
      ],
      "tip": [
        "运行时使用的用户 ID"
      ],
      "next": []
    },
    {
      "name": "--url-arg",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --url-arg"
      ],
      "tip": [
        "允许客户端在 URL 中发送命令行参数"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "打印版本并退出"
      ]
    },
    {
      "name": "--writable",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --writable"
      ],
      "tip": [
        "允许客户端写入 TTY（默认只读）"
      ]
    }
  ]
}
