{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Show or change the real-time scheduling attributes of a process."
    ]
  },
  "option": [
    {
      "name": "--all-tasks",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all-tasks"
      ],
      "tip": [
        "Operate on all the tasks (threads) for a given pid."
      ]
    },
    {
      "name": "--batch",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --batch"
      ],
      "tip": [
        "Set policy to SCHED_BATCH."
      ]
    },
    {
      "name": "--deadline",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --deadline"
      ],
      "tip": [
        "Set policy to SCHED_DEADLINE."
      ]
    },
    {
      "name": "--fifo",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fifo"
      ],
      "tip": [
        "Set policy to SCHED_FIFO."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--idle",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --idle"
      ],
      "tip": [
        "Set policy to SCHED_IDLE."
      ]
    },
    {
      "name": "--max",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --max"
      ],
      "tip": [
        "Show min and max valid priorities."
      ]
    },
    {
      "name": "--other",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --other"
      ],
      "tip": [
        "Set policy to SCHED_OTHER."
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid"
      ],
      "tip": [
        "Operate on existing given pid."
      ]
    },
    {
      "name": "--reset-on-fork",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --reset-on-fork"
      ],
      "tip": [
        "Set reset-on-fork flag."
      ]
    },
    {
      "name": "--rr",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --rr"
      ],
      "tip": [
        "Set policy to SCHED_RR (default)."
      ]
    },
    {
      "name": "--sched-deadline",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --sched-deadline <ns>"
      ],
      "tip": [
        "Deadline parameter for DEADLINE."
      ],
      "next": []
    },
    {
      "name": "--sched-period",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --sched-period <ns>"
      ],
      "tip": [
        "Period parameter for DEADLINE."
      ],
      "next": []
    },
    {
      "name": "--sched-runtime",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --sched-runtime <ns>"
      ],
      "tip": [
        "Runtime parameter for DEADLINE."
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Display status information."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
