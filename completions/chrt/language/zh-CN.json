{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示或更改进程的实时调度属性。"
    ]
  },
  "option": [
    {
      "name": "--all-tasks",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all-tasks"
      ],
      "tip": [
        "对给定 pid 的所有任务（线程）执行操作。"
      ]
    },
    {
      "name": "--batch",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --batch"
      ],
      "tip": [
        "将策略设置为 SCHED_BATCH。"
      ]
    },
    {
      "name": "--deadline",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --deadline"
      ],
      "tip": [
        "将策略设置为 SCHED_DEADLINE。"
      ]
    },
    {
      "name": "--fifo",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fifo"
      ],
      "tip": [
        "将策略设置为 SCHED_FIFO。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--idle",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --idle"
      ],
      "tip": [
        "将策略设置为 SCHED_IDLE。"
      ]
    },
    {
      "name": "--max",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --max"
      ],
      "tip": [
        "显示最小和最大有效优先级。"
      ]
    },
    {
      "name": "--other",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --other"
      ],
      "tip": [
        "将策略设置为 SCHED_OTHER。"
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid"
      ],
      "tip": [
        "对已存在的给定 pid 执行操作。"
      ]
    },
    {
      "name": "--reset-on-fork",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --reset-on-fork"
      ],
      "tip": [
        "设置 reset-on-fork 标志。"
      ]
    },
    {
      "name": "--rr",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --rr"
      ],
      "tip": [
        "将策略设置为 SCHED_RR（默认）。"
      ]
    },
    {
      "name": "--sched-deadline",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --sched-deadline <ns>"
      ],
      "tip": [
        "DEADLINE 的截止时间参数。"
      ],
      "next": []
    },
    {
      "name": "--sched-period",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --sched-period <ns>"
      ],
      "tip": [
        "DEADLINE 的周期参数。"
      ],
      "next": []
    },
    {
      "name": "--sched-runtime",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --sched-runtime <ns>"
      ],
      "tip": [
        "DEADLINE 的运行时间参数。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "显示状态信息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
