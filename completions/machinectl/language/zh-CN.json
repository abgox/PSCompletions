{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "控制 systemd 机器管理器及其容器和镜像。"
    ]
  },
  "next": [
    {
      "name": "bind",
      "usage": [
        "bind NAME PATH [PATH]"
      ],
      "tip": [
        "将主机文件或目录绑定挂载到机器中。"
      ]
    },
    {
      "name": "cat",
      "usage": [
        "cat NAME|FILE"
      ],
      "tip": [
        "显示机器的设置文件。"
      ]
    },
    {
      "name": "clean",
      "tip": [
        "移除隐藏的容器或虚拟机镜像。"
      ]
    },
    {
      "name": "clone",
      "usage": [
        "clone NAME NAME"
      ],
      "tip": [
        "克隆容器或虚拟机镜像。"
      ]
    },
    {
      "name": "copy-from",
      "usage": [
        "copy-from NAME PATH [PATH]"
      ],
      "tip": [
        "将文件从机器复制到主机中。"
      ]
    },
    {
      "name": "copy-to",
      "usage": [
        "copy-to NAME PATH [PATH]"
      ],
      "tip": [
        "将文件从主机复制到机器中。"
      ]
    },
    {
      "name": "disable",
      "usage": [
        "disable NAME…"
      ],
      "tip": [
        "禁止容器镜像在启动时运行。"
      ]
    },
    {
      "name": "edit",
      "usage": [
        "edit NAME|FILE"
      ],
      "tip": [
        "编辑机器的设置文件。"
      ]
    },
    {
      "name": "enable",
      "usage": [
        "enable NAME…"
      ],
      "tip": [
        "启用容器镜像以便在启动时运行。"
      ]
    },
    {
      "name": "image-status",
      "usage": [
        "image-status [NAME…]"
      ],
      "tip": [
        "显示镜像的简要状态信息。"
      ]
    },
    {
      "name": "kill",
      "usage": [
        "kill NAME…"
      ],
      "tip": [
        "向机器的进程发送信号。"
      ]
    },
    {
      "name": "list",
      "tip": [
        "列出当前运行的虚拟机和容器。"
      ]
    },
    {
      "name": "list-images",
      "tip": [
        "列出本地安装的容器和虚拟机镜像。"
      ]
    },
    {
      "name": "login",
      "usage": [
        "login [NAME]"
      ],
      "tip": [
        "打开交互式终端登录会话。"
      ]
    },
    {
      "name": "poweroff",
      "alias": [
        "stop"
      ],
      "usage": [
        "stop|poweroff NAME…"
      ],
      "tip": [
        "干净地关闭机器。",
        "stop 是 poweroff 的别名。"
      ]
    },
    {
      "name": "read-only",
      "usage": [
        "read-only NAME [BOOL]"
      ],
      "tip": [
        "将镜像标记为只读或取消只读。"
      ]
    },
    {
      "name": "remove",
      "usage": [
        "remove NAME…"
      ],
      "tip": [
        "移除容器或虚拟机镜像。"
      ]
    },
    {
      "name": "rename",
      "usage": [
        "rename NAME NAME"
      ],
      "tip": [
        "重命名容器或虚拟机镜像。"
      ]
    },
    {
      "name": "restart",
      "alias": [
        "reboot"
      ],
      "usage": [
        "reboot|restart NAME…"
      ],
      "tip": [
        "重启机器。",
        "restart 是 reboot 的别名。"
      ]
    },
    {
      "name": "set-limit",
      "usage": [
        "set-limit [NAME] BYTES"
      ],
      "tip": [
        "设置镜像可增长到的最大大小。"
      ]
    },
    {
      "name": "shell",
      "usage": [
        "shell [[NAME@]NAME [PATH [ARGUMENTS…]]]"
      ],
      "tip": [
        "打开交互式 shell 会话或运行命令。"
      ]
    },
    {
      "name": "show",
      "usage": [
        "show [NAME…]"
      ],
      "tip": [
        "显示机器或管理器的属性。"
      ]
    },
    {
      "name": "show-image",
      "usage": [
        "show-image [NAME…]"
      ],
      "tip": [
        "显示镜像或管理器的属性。"
      ]
    },
    {
      "name": "start",
      "usage": [
        "start NAME…"
      ],
      "tip": [
        "将容器镜像作为系统服务启动。"
      ]
    },
    {
      "name": "status",
      "usage": [
        "status NAME…"
      ],
      "tip": [
        "显示机器的运行时状态信息。"
      ]
    },
    {
      "name": "terminate",
      "usage": [
        "terminate NAME…"
      ],
      "tip": [
        "立即终止机器。"
      ]
    }
  ],
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "显示所有属性和隐藏镜像。"
      ]
    },
    {
      "name": "--force",
      "tip": [
        "复制文件时替换目标文件。"
      ]
    },
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "不省略输出。",
        "隐含 --max-addresses=full。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "在远程主机上操作。"
      ],
      "next": []
    },
    {
      "name": "--kill-whom",
      "usage": [
        "--kill-whom=WHOM"
      ],
      "tip": [
        "选择要终止哪些进程。",
        "可能值: leader, all"
      ],
      "next": [
        {
          "name": "all"
        },
        {
          "name": "leader"
        }
      ]
    },
    {
      "name": "--lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --lines=INT"
      ],
      "tip": [
        "status 显示的日志行数。"
      ],
      "next": []
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=NAME"
      ],
      "tip": [
        "连接到本机容器中的机器管理器。"
      ],
      "next": []
    },
    {
      "name": "--max-addresses",
      "usage": [
        "--max-addresses=MAX"
      ],
      "tip": [
        "限制每台机器显示的 IP 地址数量。",
        "使用 all 请求所有地址。"
      ],
      "next": []
    },
    {
      "name": "--mkdir",
      "tip": [
        "应用绑定挂载前创建目标。"
      ]
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "不询问系统密码。"
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "不显示页眉和页脚。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--now",
      "tip": [
        "在启用或禁用时同时启动或关闭容器。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output=MODE"
      ],
      "tip": [
        "status 显示的日志条目格式。",
        "可用选项见 journalctl(1)。"
      ],
      "next": []
    },
    {
      "name": "--property",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --property=NAME"
      ],
      "tip": [
        "将输出限制为指定属性。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制额外的信息性输出。"
      ]
    },
    {
      "name": "--read-only",
      "tip": [
        "创建只读绑定挂载或镜像克隆。"
      ]
    },
    {
      "name": "--runner",
      "usage": [
        "--runner=RUNNER"
      ],
      "tip": [
        "选择机器运行器。",
        "可能值: nspawn, vmspawn"
      ],
      "next": [
        {
          "name": "nspawn"
        },
        {
          "name": "vmspawn"
        }
      ]
    },
    {
      "name": "--setenv",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --setenv=NAME[=VALUE]"
      ],
      "tip": [
        "为执行的 shell 设置环境变量。",
        "可以多次使用。"
      ],
      "next": []
    },
    {
      "name": "--signal",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --signal=SIGNAL"
      ],
      "tip": [
        "选择要发送的信号。"
      ],
      "next": []
    },
    {
      "name": "--uid",
      "usage": [
        "--uid=UID"
      ],
      "tip": [
        "选择打开 shell 会话所用的用户 ID。"
      ],
      "next": []
    },
    {
      "name": "--value",
      "tip": [
        "仅打印属性值。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "-P",
      "usage": [
        "-P NAME"
      ],
      "tip": [
        "等同于 --value --property=NAME。"
      ],
      "next": []
    },
    {
      "name": "-V",
      "tip": [
        "--runner=vmspawn 的简写。"
      ]
    }
  ]
}
