{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "沿路径名一直跟踪到终点。"
    ]
  },
  "option": [
    {
      "name": "--context",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --context"
      ],
      "tip": [
        "打印每个文件的安全上下文。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--long",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --long"
      ],
      "tip": [
        "使用长列表格式（-m -o -v）。"
      ]
    },
    {
      "name": "--modes",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --modes"
      ],
      "tip": [
        "显示每个文件的模式位。"
      ]
    },
    {
      "name": "--mountpoints",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --mountpoints"
      ],
      "tip": [
        "用 'D' 显示挂载点目录。"
      ]
    },
    {
      "name": "--nosymlinks",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nosymlinks"
      ],
      "tip": [
        "不跟随符号链接。"
      ]
    },
    {
      "name": "--owners",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --owners"
      ],
      "tip": [
        "显示每个文件的所有者和组名。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--vertical",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --vertical"
      ],
      "tip": [
        "模式位和所有者垂直对齐。"
      ]
    }
  ]
}
