{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Follow a pathname until a terminal point is found."
    ]
  },
  "option": [
    {
      "name": "--context",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --context"
      ],
      "tip": [
        "Print any security context of each file."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--long",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --long"
      ],
      "tip": [
        "Use a long listing format (-m -o -v)."
      ]
    },
    {
      "name": "--modes",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --modes"
      ],
      "tip": [
        "Show the mode bits of each file."
      ]
    },
    {
      "name": "--mountpoints",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --mountpoints"
      ],
      "tip": [
        "Show mount point directories with a 'D'."
      ]
    },
    {
      "name": "--nosymlinks",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nosymlinks"
      ],
      "tip": [
        "Don't follow symlinks."
      ]
    },
    {
      "name": "--owners",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --owners"
      ],
      "tip": [
        "Show owner and group name of each file."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--vertical",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --vertical"
      ],
      "tip": [
        "Vertical align of modes and owners."
      ]
    }
  ]
}
