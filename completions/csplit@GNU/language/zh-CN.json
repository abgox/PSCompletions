{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把 FILE 按一个或多个 PATTERN 切分为 'xx00'、'xx01' 等文件，并把每一部分的字节数输出到标准输出。"
    ]
  },
  "option": [
    {
      "name": "--digits",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --digits <DIGITS>"
      ],
      "tip": [
        "使用指定的位数，而不是 2"
      ],
      "next": []
    },
    {
      "name": "--elide-empty-files",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --elide-empty-files"
      ],
      "tip": [
        "删除空的输出文件"
      ]
    },
    {
      "name": "--keep-files",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --keep-files"
      ],
      "tip": [
        "出错时不删除已生成的输出文件"
      ]
    },
    {
      "name": "--prefix",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --prefix <PREFIX>"
      ],
      "tip": [
        "使用 PREFIX 代替 'xx'"
      ],
      "next": []
    },
    {
      "name": "--silent",
      "alias": [
        "--quiet",
        "-q",
        "-s"
      ],
      "usage": [
        "-q, -s, --quiet, --silent"
      ],
      "tip": [
        "不打印输出文件大小的计数"
      ]
    },
    {
      "name": "--suffix-format",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --suffix-format <FORMAT>"
      ],
      "tip": [
        "使用 sprintf FORMAT，而不是 %02d"
      ],
      "next": []
    },
    {
      "name": "--suppress-matched",
      "tip": [
        "不输出匹配 PATTERN 的行"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
