{
  "meta": {
    "url": "https://www.openssh.com",
    "description": [
      "从服务器收集 SSH 公钥。"
    ]
  },
  "option": [
    {
      "name": "-4",
      "tip": [
        "仅使用 IPv4 地址。"
      ]
    },
    {
      "name": "-6",
      "tip": [
        "仅使用 IPv6 地址。"
      ]
    },
    {
      "name": "-c",
      "tip": [
        "请求目标主机提供证书而不是普通密钥。"
      ]
    },
    {
      "name": "-D",
      "tip": [
        "以 SSHFP DNS 记录格式打印找到的密钥。",
        "默认输出为 known_hosts 格式。"
      ]
    },
    {
      "name": "-f",
      "usage": [
        "-f <file>"
      ],
      "tip": [
        "从文件中读取主机或 \"addrlist namelist\" 对，每行一个。",
        "使用 - 从标准输入读取。"
      ],
      "next": []
    },
    {
      "name": "-H",
      "tip": [
        "对输出中的所有主机名和地址进行哈希。",
        "哈希后的名称仍可被 ssh 和 sshd 正常使用，但不会泄露可识别信息。"
      ]
    },
    {
      "name": "-O",
      "usage": [
        "-O <option>"
      ],
      "tip": [
        "指定 key/value 选项。",
        "目前唯一的选项是 hashalg=sha1 或 hashalg=sha256，用于 -D 输出；默认两者都打印。"
      ],
      "next": [
        {
          "name": "hashalg=sha1"
        },
        {
          "name": "hashalg=sha256"
        }
      ]
    },
    {
      "name": "-p",
      "usage": [
        "-p <port>"
      ],
      "tip": [
        "连接远程主机时使用指定端口。"
      ],
      "next": []
    },
    {
      "name": "-q",
      "tip": [
        "静默模式：注释中不打印服务器主机名和横幅。"
      ]
    },
    {
      "name": "-t",
      "usage": [
        "-t <ecdsa|ed25519|ecdsa-sk|ed25519-sk|rsa>"
      ],
      "tip": [
        "指定从扫描主机获取的密钥类型。",
        "多种类型可以用逗号分隔。",
        "默认获取所有类型。"
      ],
      "separator": ",",
      "next": [
        {
          "name": "ecdsa"
        },
        {
          "name": "ecdsa-sk"
        },
        {
          "name": "ed25519"
        },
        {
          "name": "ed25519-sk"
        },
        {
          "name": "rsa"
        }
      ]
    },
    {
      "name": "-T",
      "usage": [
        "-T <timeout>"
      ],
      "tip": [
        "设置连接尝试的超时时间。",
        "默认为 5 秒。"
      ],
      "next": []
    },
    {
      "name": "-v",
      "tip": [
        "详细模式：打印关于进度的调试信息。"
      ]
    }
  ]
}
