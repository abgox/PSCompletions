{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "打印给定整数 NUMBER 的质因数。"
    ]
  },
  "option": [
    {
      "name": "--exponents",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --exponents"
      ],
      "tip": [
        "以 p^e 的形式打印重复的因子，除非 e 为 1"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
