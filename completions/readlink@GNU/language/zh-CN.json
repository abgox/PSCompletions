{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "打印符号链接的目标值或规范化后的文件名"
    ]
  },
  "option": [
    {
      "name": "--canonicalize",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --canonicalize"
      ],
      "tip": [
        "递归跟随给定名称各部分中的每个符号链接以规范化；除最后一段外各段都必须存在"
      ]
    },
    {
      "name": "--canonicalize-existing",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --canonicalize-existing"
      ],
      "tip": [
        "递归跟随给定名称各部分中的每个符号链接以规范化，所有部分都必须存在"
      ]
    },
    {
      "name": "--canonicalize-missing",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --canonicalize-missing"
      ],
      "tip": [
        "递归跟随给定名称各部分中的每个符号链接以规范化，不要求各部分存在"
      ]
    },
    {
      "name": "--no-newline",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-newline"
      ],
      "tip": [
        "不输出末尾的分隔符"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "不报告错误信息"
      ]
    },
    {
      "name": "--silent",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --silent"
      ],
      "tip": [
        "抑制大多数错误信息（默认开启）"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "报告错误信息"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "每行输出以 NUL 结尾，而不是换行符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
