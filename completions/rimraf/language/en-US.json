{
  "meta": {
    "url": "https://github.com/isaacs/rimraf",
    "description": [
      "A cross-platform `rm -rf` utility for Node.js."
    ]
  },
  "option": [
    {
      "name": "--",
      "tip": [
        "Treat all subsequent arguments as paths."
      ]
    },
    {
      "name": "--backoff",
      "usage": [
        "--backoff=<N>"
      ],
      "tip": [
        "Exponential backoff factor for retries (default: 1.2)."
      ],
      "next": [
        {
          "name": "1.2"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--glob",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --glob"
      ],
      "tip": [
        "Treat arguments as glob patterns."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this usage info."
      ]
    },
    {
      "name": "--impl",
      "usage": [
        "--impl=<TYPE>"
      ],
      "tip": [
        "Specify the implementation to use."
      ],
      "next": [
        {
          "name": "manual",
          "tip": [
            "The platform-specific JS implementation."
          ]
        },
        {
          "name": "move-remove",
          "tip": [
            "A slow reliable Windows fallback."
          ]
        },
        {
          "name": "native",
          "tip": [
            "The built-in implementation in Node.js."
          ]
        },
        {
          "name": "posix",
          "tip": [
            "The Posix JS implementation."
          ]
        },
        {
          "name": "rimraf",
          "tip": [
            "Choose the best option (default)."
          ]
        },
        {
          "name": "windows",
          "tip": [
            "The Windows JS implementation (falls back to move-remove on ENOTEMPTY)."
          ]
        }
      ]
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "Ask for confirmation before deleting anything. Not compatible with --impl=native."
      ]
    },
    {
      "name": "--max-retries",
      "usage": [
        "--max-retries=<N>"
      ],
      "tip": [
        "maxRetries for 'native' and 'windows' implementations."
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "10"
        },
        {
          "name": "5"
        }
      ]
    },
    {
      "name": "--no-glob",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --no-glob"
      ],
      "tip": [
        "Treat arguments as literal paths, not globs (default)."
      ]
    },
    {
      "name": "--no-interactive",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --no-interactive"
      ],
      "tip": [
        "Do not ask for confirmation before deleting."
      ]
    },
    {
      "name": "--no-preserve-root",
      "tip": [
        "Do not treat '/' specially."
      ]
    },
    {
      "name": "--no-verbose",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --no-verbose"
      ],
      "tip": [
        "Be silent when deleting files, showing nothing as they are removed (default)."
      ]
    },
    {
      "name": "--preserve-root",
      "tip": [
        "Do not remove '/' recursively (default)."
      ]
    },
    {
      "name": "--retry-delay",
      "usage": [
        "--retry-delay=<N>"
      ],
      "tip": [
        "retryDelay for 'native' implementation, default 100."
      ],
      "next": [
        {
          "name": "100"
        },
        {
          "name": "1000"
        },
        {
          "name": "500"
        }
      ]
    },
    {
      "name": "--tmp",
      "usage": [
        "--tmp=<PATH>"
      ],
      "tip": [
        "Temp file folder for 'move-remove' implementation."
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Be verbose when deleting files, showing them as they are removed. Not compatible with --impl=native."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Display version."
      ]
    }
  ]
}
