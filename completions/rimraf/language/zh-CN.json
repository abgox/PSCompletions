{
  "meta": {
    "url": "https://github.com/isaacs/rimraf",
    "description": [
      "跨平台的 Node.js `rm -rf` 工具。"
    ]
  },
  "option": [
    {
      "name": "--",
      "tip": [
        "将其后的所有参数都视为路径。"
      ]
    },
    {
      "name": "--backoff",
      "usage": [
        "--backoff=<N>"
      ],
      "tip": [
        "重试的指数退避系数（默认值：1.2）。"
      ],
      "next": [
        {
          "name": "1.2"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--glob",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --glob"
      ],
      "tip": [
        "将参数视为 glob 模式。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此用法信息。"
      ]
    },
    {
      "name": "--impl",
      "usage": [
        "--impl=<TYPE>"
      ],
      "tip": [
        "指定要使用的实现。"
      ],
      "next": [
        {
          "name": "manual",
          "tip": [
            "按平台区分的 JS 实现。"
          ]
        },
        {
          "name": "move-remove",
          "tip": [
            "缓慢但可靠的 Windows 兜底方案。"
          ]
        },
        {
          "name": "native",
          "tip": [
            "Node.js 内置实现。"
          ]
        },
        {
          "name": "posix",
          "tip": [
            "Posix JS 实现。"
          ]
        },
        {
          "name": "rimraf",
          "tip": [
            "自动选择最优方案（默认值）。"
          ]
        },
        {
          "name": "windows",
          "tip": [
            "Windows JS 实现（ENOTEMPTY 时回退到 move-remove）。"
          ]
        }
      ]
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "删除前逐项确认。与 --impl=native 不兼容。"
      ]
    },
    {
      "name": "--max-retries",
      "usage": [
        "--max-retries=<N>"
      ],
      "tip": [
        "'native' 与 'windows' 实现的最大重试次数。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "10"
        },
        {
          "name": "5"
        }
      ]
    },
    {
      "name": "--no-glob",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --no-glob"
      ],
      "tip": [
        "将参数视为字面路径而非 glob（默认值）。"
      ]
    },
    {
      "name": "--no-interactive",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --no-interactive"
      ],
      "tip": [
        "删除前不确认。"
      ]
    },
    {
      "name": "--no-preserve-root",
      "tip": [
        "不对 '/' 做特殊保护。"
      ]
    },
    {
      "name": "--no-verbose",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --no-verbose"
      ],
      "tip": [
        "删除文件时保持安静，不显示任何信息（默认值）。"
      ]
    },
    {
      "name": "--preserve-root",
      "tip": [
        "禁止递归删除 '/'（默认值）。"
      ]
    },
    {
      "name": "--retry-delay",
      "usage": [
        "--retry-delay=<N>"
      ],
      "tip": [
        "'native' 实现的重试间隔，默认 100。"
      ],
      "next": [
        {
          "name": "100"
        },
        {
          "name": "1000"
        },
        {
          "name": "500"
        }
      ]
    },
    {
      "name": "--tmp",
      "usage": [
        "--tmp=<PATH>"
      ],
      "tip": [
        "'move-remove' 实现使用的临时文件夹。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "删除文件时显示详细信息。与 --impl=native 不兼容。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示版本号。"
      ]
    }
  ]
}
