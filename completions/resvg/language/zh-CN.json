{
  "meta": {
    "url": "https://github.com/linebender/resvg",
    "description": [
      "一个 SVG 渲染应用程序。"
    ]
  },
  "option": [
    {
      "name": "--background",
      "usage": [
        "--background <COLOR>"
      ],
      "tip": [
        "设置背景颜色。",
        "示例: red, #fff, #fff000。"
      ],
      "next": []
    },
    {
      "name": "--cursive-family",
      "usage": [
        "--cursive-family <FAMILY>"
      ],
      "tip": [
        "设置 'cursive' 字体系列。",
        "默认值: Comic Sans MS。"
      ],
      "next": []
    },
    {
      "name": "--dpi",
      "usage": [
        "--dpi <DPI>"
      ],
      "tip": [
        "设置分辨率。",
        "默认值: 96。可选值: 10..4000。"
      ],
      "next": []
    },
    {
      "name": "--export-area-drawing",
      "tip": [
        "使用绘图的紧凑边界框而非图像大小。"
      ]
    },
    {
      "name": "--export-area-page",
      "tip": [
        "在 ID 导出期间使用图像大小而非对象大小。"
      ]
    },
    {
      "name": "--export-id",
      "usage": [
        "--export-id <ID>"
      ],
      "tip": [
        "仅渲染指定 ID 的对象。"
      ],
      "next": []
    },
    {
      "name": "--fantasy-family",
      "usage": [
        "--fantasy-family <FAMILY>"
      ],
      "tip": [
        "设置 'fantasy' 字体系列。",
        "默认值: Impact。"
      ],
      "next": []
    },
    {
      "name": "--font-family",
      "usage": [
        "--font-family <FAMILY>"
      ],
      "tip": [
        "设置默认字体系列。",
        "默认值: Times New Roman。"
      ],
      "next": []
    },
    {
      "name": "--font-size",
      "usage": [
        "--font-size <SIZE>"
      ],
      "tip": [
        "设置默认字体大小。",
        "默认值: 12。可选值: 1..192。"
      ],
      "next": []
    },
    {
      "name": "--height",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --height <LENGTH>"
      ],
      "tip": [
        "设置高度（像素）。"
      ],
      "next": []
    },
    {
      "name": "--image-rendering",
      "usage": [
        "--image-rendering <HINT>"
      ],
      "tip": [
        "选择默认的图像渲染方法。",
        "默认值: optimizeQuality。"
      ],
      "next": [
        {
          "name": "crisp-edges",
          "tip": [
            "清晰边缘。"
          ]
        },
        {
          "name": "high-quality",
          "tip": [
            "高质量渲染。"
          ]
        },
        {
          "name": "optimizeQuality",
          "tip": [
            "优化质量。"
          ]
        },
        {
          "name": "optimizeSpeed",
          "tip": [
            "优化速度。"
          ]
        },
        {
          "name": "pixelated",
          "tip": [
            "像素化渲染。"
          ]
        },
        {
          "name": "smooth",
          "tip": [
            "平滑渲染。"
          ]
        }
      ]
    },
    {
      "name": "--languages",
      "usage": [
        "--languages <LANG>"
      ],
      "tip": [
        "设置用于 'systemLanguage' 属性解析的逗号分隔语言列表。",
        "默认值: en。"
      ],
      "next": []
    },
    {
      "name": "--list-fonts",
      "tip": [
        "列出已成功加载的字体。"
      ]
    },
    {
      "name": "--monospace-family",
      "usage": [
        "--monospace-family <FAMILY>"
      ],
      "tip": [
        "设置 'monospace' 字体系列。",
        "默认值: Courier New。"
      ],
      "next": []
    },
    {
      "name": "--perf",
      "tip": [
        "打印性能统计。"
      ]
    },
    {
      "name": "--query-all",
      "tip": [
        "查询所有有效的 SVG ID 及其边界框。"
      ]
    },
    {
      "name": "--quiet",
      "tip": [
        "禁用警告。"
      ]
    },
    {
      "name": "--resources-dir",
      "usage": [
        "--resources-dir <DIR>"
      ],
      "tip": [
        "设置用于相对路径解析的目录。",
        "默认值: 输入文件目录。"
      ],
      "next": []
    },
    {
      "name": "--sans-serif-family",
      "usage": [
        "--sans-serif-family <FAMILY>"
      ],
      "tip": [
        "设置 'sans-serif' 字体系列。",
        "默认值: Arial。"
      ],
      "next": []
    },
    {
      "name": "--serif-family",
      "usage": [
        "--serif-family <FAMILY>"
      ],
      "tip": [
        "设置 'serif' 字体系列。",
        "默认值: Times New Roman。"
      ],
      "next": []
    },
    {
      "name": "--shape-rendering",
      "usage": [
        "--shape-rendering <HINT>"
      ],
      "tip": [
        "选择默认的形状渲染方法。",
        "默认值: geometricPrecision。"
      ],
      "next": [
        {
          "name": "crispEdges",
          "tip": [
            "清晰边缘。"
          ]
        },
        {
          "name": "geometricPrecision",
          "tip": [
            "几何精度。"
          ]
        },
        {
          "name": "optimizeSpeed",
          "tip": [
            "优化速度。"
          ]
        }
      ]
    },
    {
      "name": "--skip-system-fonts",
      "tip": [
        "禁用系统字体加载。"
      ]
    },
    {
      "name": "--stylesheet",
      "usage": [
        "--stylesheet <PATH>"
      ],
      "tip": [
        "注入用于解析 CSS 属性的样式表。"
      ],
      "next": []
    },
    {
      "name": "--text-rendering",
      "usage": [
        "--text-rendering <HINT>"
      ],
      "tip": [
        "选择默认的文本渲染方法。",
        "默认值: optimizeLegibility。"
      ],
      "next": [
        {
          "name": "geometricPrecision",
          "tip": [
            "几何精度。"
          ]
        },
        {
          "name": "optimizeLegibility",
          "tip": [
            "优化可读性。"
          ]
        },
        {
          "name": "optimizeSpeed",
          "tip": [
            "优化速度。"
          ]
        }
      ]
    },
    {
      "name": "--use-font-file",
      "usage": [
        "--use-font-file <PATH>"
      ],
      "tip": [
        "将指定的字体文件加载到字体数据库中。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--use-fonts-dir",
      "usage": [
        "--use-fonts-dir <PATH>"
      ],
      "tip": [
        "从指定目录加载所有字体。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <LENGTH>"
      ],
      "tip": [
        "设置宽度（像素）。"
      ],
      "next": []
    },
    {
      "name": "--zoom",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zoom <FACTOR>"
      ],
      "tip": [
        "按因子缩放图像。"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "打印帮助信息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息。"
      ]
    }
  ]
}
