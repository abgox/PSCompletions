{
  "meta": {
    "url": "https://github.com/linebender/resvg",
    "description": [
      "An SVG rendering application."
    ]
  },
  "option": [
    {
      "name": "--background",
      "usage": [
        "--background <COLOR>"
      ],
      "tip": [
        "Sets the background color.",
        "Examples: red, #fff, #fff000."
      ],
      "next": []
    },
    {
      "name": "--cursive-family",
      "usage": [
        "--cursive-family <FAMILY>"
      ],
      "tip": [
        "Sets the 'cursive' font family.",
        "Default: Comic Sans MS."
      ],
      "next": []
    },
    {
      "name": "--dpi",
      "usage": [
        "--dpi <DPI>"
      ],
      "tip": [
        "Sets the resolution.",
        "Default: 96. Possible values: 10..4000."
      ],
      "next": []
    },
    {
      "name": "--export-area-drawing",
      "tip": [
        "Use drawing's tight bounding box instead of image size."
      ]
    },
    {
      "name": "--export-area-page",
      "tip": [
        "Use an image size instead of an object size during ID exporting."
      ]
    },
    {
      "name": "--export-id",
      "usage": [
        "--export-id <ID>"
      ],
      "tip": [
        "Renders an object only with a specified ID."
      ],
      "next": []
    },
    {
      "name": "--fantasy-family",
      "usage": [
        "--fantasy-family <FAMILY>"
      ],
      "tip": [
        "Sets the 'fantasy' font family.",
        "Default: Impact."
      ],
      "next": []
    },
    {
      "name": "--font-family",
      "usage": [
        "--font-family <FAMILY>"
      ],
      "tip": [
        "Sets the default font family.",
        "Default: Times New Roman."
      ],
      "next": []
    },
    {
      "name": "--font-size",
      "usage": [
        "--font-size <SIZE>"
      ],
      "tip": [
        "Sets the default font size.",
        "Default: 12. Possible values: 1..192."
      ],
      "next": []
    },
    {
      "name": "--height",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --height <LENGTH>"
      ],
      "tip": [
        "Sets the height in pixels."
      ],
      "next": []
    },
    {
      "name": "--image-rendering",
      "usage": [
        "--image-rendering <HINT>"
      ],
      "tip": [
        "Selects the default image rendering method.",
        "Default: optimizeQuality."
      ],
      "next": [
        {
          "name": "crisp-edges",
          "tip": [
            "Crisp edges."
          ]
        },
        {
          "name": "high-quality",
          "tip": [
            "High quality rendering."
          ]
        },
        {
          "name": "optimizeQuality",
          "tip": [
            "Optimize for quality."
          ]
        },
        {
          "name": "optimizeSpeed",
          "tip": [
            "Optimize for speed."
          ]
        },
        {
          "name": "pixelated",
          "tip": [
            "Pixelated rendering."
          ]
        },
        {
          "name": "smooth",
          "tip": [
            "Smooth rendering."
          ]
        }
      ]
    },
    {
      "name": "--languages",
      "usage": [
        "--languages <LANG>"
      ],
      "tip": [
        "Sets a comma-separated list of languages for 'systemLanguage' attribute resolving.",
        "Default: en."
      ],
      "next": []
    },
    {
      "name": "--list-fonts",
      "tip": [
        "Lists successfully loaded font faces."
      ]
    },
    {
      "name": "--monospace-family",
      "usage": [
        "--monospace-family <FAMILY>"
      ],
      "tip": [
        "Sets the 'monospace' font family.",
        "Default: Courier New."
      ],
      "next": []
    },
    {
      "name": "--perf",
      "tip": [
        "Prints performance stats."
      ]
    },
    {
      "name": "--query-all",
      "tip": [
        "Queries all valid SVG ids with bounding boxes."
      ]
    },
    {
      "name": "--quiet",
      "tip": [
        "Disables warnings."
      ]
    },
    {
      "name": "--resources-dir",
      "usage": [
        "--resources-dir <DIR>"
      ],
      "tip": [
        "Sets a directory for relative paths resolving.",
        "Default: input file directory."
      ],
      "next": []
    },
    {
      "name": "--sans-serif-family",
      "usage": [
        "--sans-serif-family <FAMILY>"
      ],
      "tip": [
        "Sets the 'sans-serif' font family.",
        "Default: Arial."
      ],
      "next": []
    },
    {
      "name": "--serif-family",
      "usage": [
        "--serif-family <FAMILY>"
      ],
      "tip": [
        "Sets the 'serif' font family.",
        "Default: Times New Roman."
      ],
      "next": []
    },
    {
      "name": "--shape-rendering",
      "usage": [
        "--shape-rendering <HINT>"
      ],
      "tip": [
        "Selects the default shape rendering method.",
        "Default: geometricPrecision."
      ],
      "next": [
        {
          "name": "crispEdges",
          "tip": [
            "Crisp edges."
          ]
        },
        {
          "name": "geometricPrecision",
          "tip": [
            "Geometric precision."
          ]
        },
        {
          "name": "optimizeSpeed",
          "tip": [
            "Optimize for speed."
          ]
        }
      ]
    },
    {
      "name": "--skip-system-fonts",
      "tip": [
        "Disables system fonts loading."
      ]
    },
    {
      "name": "--stylesheet",
      "usage": [
        "--stylesheet <PATH>"
      ],
      "tip": [
        "Inject a stylesheet for resolving CSS attributes."
      ],
      "next": []
    },
    {
      "name": "--text-rendering",
      "usage": [
        "--text-rendering <HINT>"
      ],
      "tip": [
        "Selects the default text rendering method.",
        "Default: optimizeLegibility."
      ],
      "next": [
        {
          "name": "geometricPrecision",
          "tip": [
            "Geometric precision."
          ]
        },
        {
          "name": "optimizeLegibility",
          "tip": [
            "Optimize for legibility."
          ]
        },
        {
          "name": "optimizeSpeed",
          "tip": [
            "Optimize for speed."
          ]
        }
      ]
    },
    {
      "name": "--use-font-file",
      "usage": [
        "--use-font-file <PATH>"
      ],
      "tip": [
        "Load a specified font file into the fonts database."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--use-fonts-dir",
      "usage": [
        "--use-fonts-dir <PATH>"
      ],
      "tip": [
        "Loads all fonts from the specified directory."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <LENGTH>"
      ],
      "tip": [
        "Sets the width in pixels."
      ],
      "next": []
    },
    {
      "name": "--zoom",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zoom <FACTOR>"
      ],
      "tip": [
        "Zooms the image by a factor."
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "Prints help information."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Prints version information."
      ]
    }
  ]
}
