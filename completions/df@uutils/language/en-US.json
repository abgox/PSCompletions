{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Show information about the file system on which each FILE resides, or all file systems by default."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "include dummy file systems"
      ]
    },
    {
      "name": "--block-size",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --block-size <SIZE>"
      ],
      "tip": [
        "scale sizes by SIZE before printing them; e.g. '-BM' prints sizes in units of 1,048,576 bytes"
      ],
      "next": []
    },
    {
      "name": "--exclude-type",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exclude-type <TYPE>"
      ],
      "tip": [
        "limit listing to file systems not of type TYPE"
      ],
      "next": []
    },
    {
      "name": "--human-readable",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --human-readable"
      ],
      "tip": [
        "print sizes in human readable format (e.g., 1K 234M 2G)"
      ]
    },
    {
      "name": "--inodes",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --inodes"
      ],
      "tip": [
        "list inode information instead of block usage"
      ]
    },
    {
      "name": "--local",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --local"
      ],
      "tip": [
        "limit listing to local file systems"
      ]
    },
    {
      "name": "--no-sync",
      "tip": [
        "do not invoke sync before getting usage info (default)"
      ]
    },
    {
      "name": "--output",
      "usage": [
        "--output[=<FIELD_LIST>]"
      ],
      "tip": [
        "use output format defined by FIELD_LIST, or print all fields if FIELD_LIST is omitted"
      ],
      "next": [
        {
          "name": "avail"
        },
        {
          "name": "file"
        },
        {
          "name": "fstype"
        },
        {
          "name": "iavail"
        },
        {
          "name": "ipcent"
        },
        {
          "name": "itotal"
        },
        {
          "name": "iused"
        },
        {
          "name": "pcent"
        },
        {
          "name": "size"
        },
        {
          "name": "source"
        },
        {
          "name": "target"
        },
        {
          "name": "used"
        }
      ]
    },
    {
      "name": "--portability",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --portability"
      ],
      "tip": [
        "use the POSIX output format"
      ]
    },
    {
      "name": "--print-type",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --print-type"
      ],
      "tip": [
        "print file system type"
      ]
    },
    {
      "name": "--si",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --si"
      ],
      "tip": [
        "likewise, but use powers of 1000 not 1024"
      ]
    },
    {
      "name": "--sync",
      "tip": [
        "invoke sync before getting usage info (non-windows only)"
      ]
    },
    {
      "name": "--total",
      "tip": [
        "produce a grand total"
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "limit listing to file systems of type TYPE"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "-k",
      "tip": [
        "like --block-size=1K"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "Print help information"
      ]
    }
  ]
}
