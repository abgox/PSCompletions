{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "显示每个 FILE 所在文件系统的信息，默认显示所有文件系统"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "包含虚拟文件系统"
      ]
    },
    {
      "name": "--block-size",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --block-size <SIZE>"
      ],
      "tip": [
        "打印前按 SIZE 缩放大小，例如 -BM 以 1,048,576 字节为单位打印"
      ],
      "next": []
    },
    {
      "name": "--exclude-type",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exclude-type <TYPE>"
      ],
      "tip": [
        "仅列出非 TYPE 类型的文件系统"
      ],
      "next": []
    },
    {
      "name": "--human-readable",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --human-readable"
      ],
      "tip": [
        "以人类可读格式打印大小（例如 1K 234M 2G）"
      ]
    },
    {
      "name": "--inodes",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --inodes"
      ],
      "tip": [
        "列出 inode 信息而非块使用情况"
      ]
    },
    {
      "name": "--local",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --local"
      ],
      "tip": [
        "仅列出本地文件系统"
      ]
    },
    {
      "name": "--no-sync",
      "tip": [
        "获取使用信息前不调用 sync（默认）"
      ]
    },
    {
      "name": "--output",
      "usage": [
        "--output[=<FIELD_LIST>]"
      ],
      "tip": [
        "使用 FIELD_LIST 定义的输出格式，省略 FIELD_LIST 则打印所有字段"
      ],
      "next": [
        {
          "name": "avail"
        },
        {
          "name": "file"
        },
        {
          "name": "fstype"
        },
        {
          "name": "iavail"
        },
        {
          "name": "ipcent"
        },
        {
          "name": "itotal"
        },
        {
          "name": "iused"
        },
        {
          "name": "pcent"
        },
        {
          "name": "size"
        },
        {
          "name": "source"
        },
        {
          "name": "target"
        },
        {
          "name": "used"
        }
      ]
    },
    {
      "name": "--portability",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --portability"
      ],
      "tip": [
        "使用 POSIX 输出格式"
      ]
    },
    {
      "name": "--print-type",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --print-type"
      ],
      "tip": [
        "打印文件系统类型"
      ]
    },
    {
      "name": "--si",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --si"
      ],
      "tip": [
        "同上，但使用 1000 而非 1024 的幂"
      ]
    },
    {
      "name": "--sync",
      "tip": [
        "获取使用信息前调用 sync（仅非 Windows）"
      ]
    },
    {
      "name": "--total",
      "tip": [
        "生成总计行"
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "仅列出 TYPE 类型的文件系统"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-k",
      "tip": [
        "类似 --block-size=1K"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "打印帮助信息"
      ]
    }
  ]
}
