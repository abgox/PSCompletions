    {
      "name": "install",
      "usage": [
        "install [<servicename>] [<app> [<args> ...]]"
      ],
      "tip": [
        "Install a Windows service",
        "Without arguments, opens the GUI installer"
      ],
      "example": [
        {
          "cmd": "install MyService",
          "desc": "Open GUI installer"
        },
        {
          "cmd": "install MyService C:\\app\\myapp.exe",
          "desc": "Install directly from command line"
        }
      ]
    },
