    {
      "name": "remove",
      "usage": [
        "remove [<servicename>] [confirm]"
      ],
      "tip": [
        "Remove a Windows service",
        "Without arguments, opens the GUI removal dialog",
        "With 'confirm' argument, removes without confirmation"
      ],
      "example": [
        {
          "cmd": "remove MyService",
          "desc": "Open GUI removal dialog"
        },
        {
          "cmd": "remove MyService confirm",
          "desc": "Remove service directly"
        }
      ],
      "next": [
        {
          "name": "confirm",
          "tip": [
            "Remove the service without confirmation dialog"
