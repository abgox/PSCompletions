{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "更改用户真实姓名和信息。"
    ]
  },
  "option": [
    {
      "name": "--full-name",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --full-name <FULL_NAME>"
      ],
      "tip": [
        "更改用户的全名。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--home-phone",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --home-phone <HOME_PHONE>"
      ],
      "tip": [
        "更改用户的家庭电话号码。"
      ],
      "next": []
    },
    {
      "name": "--other",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --other <OTHER_INFO>"
      ],
      "tip": [
        "更改用户的其他 GECOS 信息。"
      ],
      "next": []
    },
    {
      "name": "--room",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --room <ROOM_NUMBER>"
      ],
      "tip": [
        "更改用户的房间号。"
      ],
      "next": []
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--work-phone",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --work-phone <WORK_PHONE>"
      ],
      "tip": [
        "更改用户的办公电话号码。"
      ],
      "next": []
    }
  ]
}
