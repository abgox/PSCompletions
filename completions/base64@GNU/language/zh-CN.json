{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "将 FILE（未指定时为标准输入）做 Base64 编码或解码，输出到标准输出。"
    ]
  },
  "option": [
    {
      "name": "--decode",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --decode"
      ],
      "tip": [
        "解码数据"
      ]
    },
    {
      "name": "--ignore-garbage",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-garbage"
      ],
      "tip": [
        "解码时忽略字母表以外的字符"
      ]
    },
    {
      "name": "--wrap",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wrap <COLS>"
      ],
      "tip": [
        "每编码 COLS 个字符后换行（默认 76）。设为 0 可禁用换行"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "60"
        },
        {
          "name": "76"
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
