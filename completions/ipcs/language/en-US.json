{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Show information on IPC facilities."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "All (default)."
      ]
    },
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "Show sizes in bytes."
      ]
    },
    {
      "name": "--creator",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --creator"
      ],
      "tip": [
        "Show creator and owner."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--human",
      "tip": [
        "Show sizes in human-readable format."
      ]
    },
    {
      "name": "--id",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --id <id>"
      ],
      "tip": [
        "Print details on resource identified by <id>."
      ],
      "next": []
    },
    {
      "name": "--limits",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --limits"
      ],
      "tip": [
        "Show resource limits."
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid"
      ],
      "tip": [
        "Show PIDs of creator and last operator."
      ]
    },
    {
      "name": "--queues",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --queues"
      ],
      "tip": [
        "Message queues."
      ]
    },
    {
      "name": "--semaphores",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --semaphores"
      ],
      "tip": [
        "Semaphores."
      ]
    },
    {
      "name": "--shmems",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --shmems"
      ],
      "tip": [
        "Shared memory segments."
      ]
    },
    {
      "name": "--summary",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --summary"
      ],
      "tip": [
        "Show status summary."
      ]
    },
    {
      "name": "--time",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --time"
      ],
      "tip": [
        "Show attach, detach and change times."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
