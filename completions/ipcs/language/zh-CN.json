{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示 IPC 设施信息。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "全部（默认）。"
      ]
    },
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "以字节显示大小。"
      ]
    },
    {
      "name": "--creator",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --creator"
      ],
      "tip": [
        "显示创建者和所有者。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--human",
      "tip": [
        "以人类可读格式显示大小。"
      ]
    },
    {
      "name": "--id",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --id <id>"
      ],
      "tip": [
        "打印由 <id> 标识的资源的详细信息。"
      ],
      "next": []
    },
    {
      "name": "--limits",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --limits"
      ],
      "tip": [
        "显示资源限制。"
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid"
      ],
      "tip": [
        "显示创建者和最后操作者的 PID。"
      ]
    },
    {
      "name": "--queues",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --queues"
      ],
      "tip": [
        "消息队列。"
      ]
    },
    {
      "name": "--semaphores",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --semaphores"
      ],
      "tip": [
        "信号量。"
      ]
    },
    {
      "name": "--shmems",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --shmems"
      ],
      "tip": [
        "共享内存段。"
      ]
    },
    {
      "name": "--summary",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --summary"
      ],
      "tip": [
        "显示状态摘要。"
      ]
    },
    {
      "name": "--time",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --time"
      ],
      "tip": [
        "显示附加、分离和更改时间。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
