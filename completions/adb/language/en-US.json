{
  "meta": {
    "url": "https://developer.android.com/tools/adb",
    "description": [
      "Android Debug Bridge command-line tool."
    ]
  },
  "next": [
    {
      "name": "attach",
      "tip": [
        "Attach a detached USB device"
      ]
    },
    {
      "name": "bugreport",
      "usage": [
        "bugreport [PATH]"
      ],
      "tip": [
        "write bugreport to given PATH"
      ]
    },
    {
      "name": "connect",
      "usage": [
        "connect HOST[:PORT]"
      ],
      "tip": [
        "connect to a device via TCP/IP [default port=5555]"
      ]
    },
    {
      "name": "detach",
      "tip": [
        "Detach from a USB device to allow use by other processes"
      ]
    },
    {
      "name": "devices",
      "tip": [
        "list connected devices (-l for long output)"
      ],
      "option": [
        {
          "name": "-l",
          "tip": [
            "long output"
          ]
        }
      ]
    },
    {
      "name": "disable-verity",
      "tip": [
        "disable dm-verity checking on userdebug builds"
      ]
    },
    {
      "name": "disconnect",
      "usage": [
        "disconnect [HOST[:PORT]]"
      ],
      "tip": [
        "disconnect from given TCP/IP device [default port=5555], or all"
      ]
    },
    {
      "name": "emu",
      "usage": [
        "emu COMMAND"
      ],
      "tip": [
        "run emulator console command"
      ]
    },
    {
      "name": "enable-verity",
      "tip": [
        "re-enable dm-verity checking on userdebug builds"
      ]
    },
    {
      "name": "forward",
      "usage": [
        "forward LOCAL REMOTE"
      ],
      "tip": [
        "forward socket connection using"
      ],
      "option": [
        {
          "name": "--list",
          "tip": [
            "list all forward socket connections"
          ]
        },
        {
          "name": "--no-rebind",
          "tip": [
            "don't replace existing connection"
          ]
        },
        {
          "name": "--remove",
          "usage": [
            "--remove LOCAL"
          ],
          "tip": [
            "remove specific forward socket connection"
          ]
        },
        {
          "name": "--remove-all",
          "tip": [
            "remove all forward socket connections"
          ]
        }
      ]
    },
    {
      "name": "get-devpath",
      "tip": [
        "print <device-path>"
      ]
    },
    {
      "name": "get-serialno",
      "tip": [
        "print <serial-number>"
      ]
    },
    {
      "name": "get-state",
      "tip": [
        "print offline | bootloader | device"
      ]
    },
    {
      "name": "help",
      "tip": [
        "show this help message"
      ]
    },
    {
      "name": "install",
      "usage": [
        "install PACKAGE"
      ],
      "tip": [
        "push a single package to the device and install it"
      ],
      "option": [
        {
          "name": "--abi",
          "usage": [
            "--abi ABI"
          ],
          "tip": [
            "Override platform's default ABI"
          ],
          "next": []
        },
        {
          "name": "--date-check-agent",
          "tip": [
            "Update deployment agent when local version is newer and using fast deploy"
          ]
        },
        {
          "name": "--fastdeploy",
          "tip": [
            "Use fast deploy"
          ]
        },
        {
          "name": "--force-agent",
          "tip": [
            "Force update of deployment agent when using fast deploy"
          ]
        },
        {
          "name": "--instant",
          "tip": [
            "Cause the app to be installed as an ephemeral install app"
          ]
        },
        {
          "name": "--no-fastdeploy",
          "tip": [
            "Prevent use of fast deploy"
          ]
        },
        {
          "name": "--no-streaming",
          "tip": [
            "Always push APK to device and invoke Package Manager as separate steps"
          ]
        },
        {
          "name": "--streaming",
          "tip": [
            "Force streaming APK directly into Package Manager"
          ]
        },
        {
          "name": "--version-check-agent",
          "tip": [
            "Update deployment agent when local version has different version code and using fast deploy"
          ]
        },
        {
          "name": "-d",
          "tip": [
            "Allow version code downgrade (debuggable packages only)"
          ]
        },
        {
          "name": "-g",
          "tip": [
            "Grant all runtime permissions"
          ]
        },
        {
          "name": "-r",
          "tip": [
            "Replace existing application"
          ]
        },
        {
          "name": "-t",
          "tip": [
            "Allow test packages"
          ]
        }
      ]
    },
    {
      "name": "install-multi-package",
      "tip": [
        "push one or more packages to the device and install them atomically"
      ],
      "option": [
        {
          "name": "--instant",
          "tip": [
            "Cause the app to be installed as an ephemeral install app"
          ]
        },
        {
          "name": "-d",
          "tip": [
            "Allow version code downgrade (debuggable packages only)"
          ]
        },
        {
          "name": "-g",
          "tip": [
            "Grant all runtime permissions"
          ]
        },
        {
          "name": "-r",
          "tip": [
            "Replace existing application"
          ]
        },
        {
          "name": "-t",
          "tip": [
            "Allow test packages"
          ]
        }
