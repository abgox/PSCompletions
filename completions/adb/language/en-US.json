        {
          "name": "-q",
          "tip": [
            "Suppress progress messages"
          ]
        },
        {
          "name": "-z",
          "usage": [
            "-z ALGORITHM"
          ],
          "tip": [
            "Enable compression with a specified algorithm (any/none/brotli/lz4/zstd)"
          ],
          "next": [
            {
              "name": "any",
              "tip": [
                "Any algorithm"
              ]
            },
            {
              "name": "brotli",
              "tip": [
                "Brotli algorithm"
              ]
            },
            {
              "name": "lz4",
              "tip": [
                "LZ4 algorithm"
              ]
            },
            {
              "name": "none",
              "tip": [
                "No compression"
              ]
            },
            {
              "name": "zstd",
              "tip": [
                "Zstd algorithm"
              ]
            }
          ]
        },
        {
          "name": "-Z",
          "tip": [
            "Disable compression"
          ]
        }
      ]
    },
    {
      "name": "push",
      "tip": [
        "copy local files/directories to device"
