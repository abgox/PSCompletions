        },
        {
          "name": "-q",
          "tip": [
            "Suppress progress messages"
          ]
        },
        {
          "name": "-z",
          "usage": [
            "-z ALGORITHM"
          ],
          "tip": [
            "Enable compression with a specified algorithm (any/none/brotli/lz4/zstd)"
