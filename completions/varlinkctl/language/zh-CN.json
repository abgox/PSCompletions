{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "内省 Varlink 服务。"
    ]
  },
  "next": [
    {
      "name": "call",
      "usage": [
        "call ADDRESS METHOD [PARAMS]"
      ],
      "tip": [
        "调用方法。"
      ]
    },
    {
      "name": "help",
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "info",
      "usage": [
        "info ADDRESS"
      ],
      "tip": [
        "显示服务信息。"
      ]
    },
    {
      "name": "introspect",
      "usage": [
        "introspect ADDRESS [INTERFACE…]"
      ],
      "tip": [
        "显示接口定义。"
      ]
    },
    {
      "name": "list-interfaces",
      "usage": [
        "list-interfaces ADDRESS"
      ],
      "tip": [
        "列出服务实现的接口。"
      ]
    },
    {
      "name": "list-methods",
      "usage": [
        "list-methods ADDRESS [INTERFACE…]"
      ],
      "tip": [
        "列出服务或特定接口实现的方法。"
      ]
    },
    {
      "name": "validate-idl",
      "usage": [
        "validate-idl [FILE]"
      ],
      "tip": [
        "校验接口描述。"
      ]
    }
  ],
  "option": [
    {
      "name": "--collect",
      "tip": [
        "将多个响应收集到 JSON 数组中。"
      ]
    },
    {
      "name": "--graceful",
      "usage": [
        "--graceful=ERROR"
      ],
      "tip": [
        "将指定的 Varlink 错误视为成功。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--json",
      "usage": [
        "--json=MODE"
      ],
      "tip": [
        "以 JSON 输出。",
        "可能值: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--more",
      "tip": [
        "请求多个响应。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--oneway",
      "tip": [
        "不请求响应。"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "不输出方法回复。"
      ]
    },
    {
      "name": "--timeout",
      "usage": [
        "--timeout=SECS"
      ],
      "tip": [
        "等待方法调用完成的最长时间。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "-E",
      "tip": [
        "--more --timeout=infinity 的简写。"
      ]
    },
    {
      "name": "-j",
      "tip": [
        "在 tty 上等同于 --json=pretty，否则等同于 --json=short。"
      ]
    }
  ]
}
