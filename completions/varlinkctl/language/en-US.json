{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Introspect Varlink services."
    ]
  },
  "next": [
    {
      "name": "call",
      "usage": [
        "call ADDRESS METHOD [PARAMS]"
      ],
      "tip": [
        "Invoke method."
      ]
    },
    {
      "name": "help",
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "info",
      "usage": [
        "info ADDRESS"
      ],
      "tip": [
        "Show service information."
      ]
    },
    {
      "name": "introspect",
      "usage": [
        "introspect ADDRESS [INTERFACE…]"
      ],
      "tip": [
        "Show interface definition."
      ]
    },
    {
      "name": "list-interfaces",
      "usage": [
        "list-interfaces ADDRESS"
      ],
      "tip": [
        "List interfaces implemented by service."
      ]
    },
    {
      "name": "list-methods",
      "usage": [
        "list-methods ADDRESS [INTERFACE…]"
      ],
      "tip": [
        "List methods implemented by services or specific interfaces."
      ]
    },
    {
      "name": "validate-idl",
      "usage": [
        "validate-idl [FILE]"
      ],
      "tip": [
        "Validate interface description."
      ]
    }
  ],
  "option": [
    {
      "name": "--collect",
      "tip": [
        "Collect multiple responses in a JSON array."
      ]
    },
    {
      "name": "--graceful",
      "usage": [
        "--graceful=ERROR"
      ],
      "tip": [
        "Treat specified Varlink error as success."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--json",
      "usage": [
        "--json=MODE"
      ],
      "tip": [
        "Output as JSON.",
        "Possible values: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--more",
      "tip": [
        "Request multiple responses."
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--oneway",
      "tip": [
        "Do not request response."
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Do not output method reply."
      ]
    },
    {
      "name": "--timeout",
      "usage": [
        "--timeout=SECS"
      ],
      "tip": [
        "Maximum time to wait for method call completion."
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    },
    {
      "name": "-E",
      "tip": [
        "Short for --more --timeout=infinity."
      ]
    },
    {
      "name": "-j",
      "tip": [
        "Same as --json=pretty on tty, --json=short otherwise."
      ]
    }
  ]
}
