{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "转换或删除字符"
    ]
  },
  "option": [
    {
      "name": "--complement",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --complement"
      ],
      "tip": [
        "使用 SET1 的补集"
      ]
    },
    {
      "name": "--delete",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delete"
      ],
      "tip": [
        "删除 SET1 中的字符，不转换"
      ]
    },
    {
      "name": "--squeeze-repeats",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squeeze-repeats"
      ],
      "tip": [
        "将在最后一个指定的 SET 中列出的重复字符的每个序列替换为该字符的单次出现"
      ]
    },
    {
      "name": "--truncate-set1",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --truncate-set1"
      ],
      "tip": [
        "先将 SET1 截断为 SET2 的长度"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
