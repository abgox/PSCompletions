{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Translate or delete characters"
    ]
  },
  "option": [
    {
      "name": "--complement",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --complement"
      ],
      "tip": [
        "use the complement of SET1"
      ]
    },
    {
      "name": "--delete",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delete"
      ],
      "tip": [
        "delete characters in SET1, do not translate"
      ]
    },
    {
      "name": "--squeeze-repeats",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squeeze-repeats"
      ],
      "tip": [
        "replace each sequence of a repeated character that is listed in the last specified SET, with a single occurrence of that character"
      ]
    },
    {
      "name": "--truncate-set1",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --truncate-set1"
      ],
      "tip": [
        "first truncate SET1 to length of SET2"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
