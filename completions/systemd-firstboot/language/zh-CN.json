{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "配置系统的基本设置。"
    ]
  },
  "option": [
    {
      "name": "--copy",
      "tip": [
        "从主机复制区域、键盘映射、时区、root 密码和 root shell。"
      ]
    },
    {
      "name": "--copy-keymap",
      "tip": [
        "从主机复制键盘映射。"
      ]
    },
    {
      "name": "--copy-locale",
      "tip": [
        "从主机复制区域设置。"
      ]
    },
    {
      "name": "--copy-root-password",
      "tip": [
        "从主机复制 root 密码。"
      ]
    },
    {
      "name": "--copy-root-shell",
      "tip": [
        "从主机复制 root shell。"
      ]
    },
    {
      "name": "--copy-timezone",
      "tip": [
        "从主机复制时区。"
      ]
    },
    {
      "name": "--delete-root-password",
      "tip": [
        "删除 root 密码。"
      ]
    },
    {
      "name": "--force",
      "tip": [
        "覆盖现有文件。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--hostname",
      "usage": [
        "--hostname=NAME"
      ],
      "tip": [
        "设置主机名。"
      ],
      "next": []
    },
    {
      "name": "--image",
      "usage": [
        "--image=PATH"
      ],
      "tip": [
        "将磁盘镜像作为文件系统根目录操作。"
      ],
      "next": []
    },
    {
      "name": "--image-policy",
      "usage": [
        "--image-policy=POLICY"
      ],
      "tip": [
        "指定磁盘镜像解析策略。"
      ],
      "next": []
    },
    {
      "name": "--kernel-command-line",
      "usage": [
        "--kernel-command-line=CMDLINE"
      ],
      "tip": [
        "设置内核命令行。"
      ],
      "next": []
    },
    {
      "name": "--keymap",
      "usage": [
        "--keymap=KEYMAP"
      ],
      "tip": [
        "设置键盘映射。"
      ],
      "next": []
    },
    {
      "name": "--locale",
      "usage": [
        "--locale=LOCALE"
      ],
      "tip": [
        "设置主区域（LANG=）。"
      ],
      "next": []
    },
    {
      "name": "--locale-messages",
      "usage": [
        "--locale-messages=LOCALE"
      ],
      "tip": [
        "设置消息区域（LC_MESSAGES=）。"
      ],
      "next": []
    },
    {
      "name": "--machine-id",
      "usage": [
        "--machine-id=ID"
      ],
      "tip": [
        "设置指定的机器 ID。"
      ],
      "next": []
    },
    {
      "name": "--prompt",
      "tip": [
        "提示输入上述所有内容。"
      ]
    },
    {
      "name": "--prompt-hostname",
      "tip": [
        "提示用户输入主机名。"
      ]
    },
    {
      "name": "--prompt-keymap",
      "tip": [
        "提示用户输入键盘映射设置。"
      ]
    },
    {
      "name": "--prompt-locale",
      "tip": [
        "提示用户输入区域设置。"
      ]
    },
    {
      "name": "--prompt-root-password",
      "tip": [
        "提示用户输入 root 密码。"
      ]
    },
    {
      "name": "--prompt-root-shell",
      "tip": [
        "提示用户输入 root shell。"
      ]
    },
    {
      "name": "--prompt-timezone",
      "tip": [
        "提示用户输入时区。"
      ]
    },
    {
      "name": "--reset",
      "tip": [
        "移除现有文件。"
      ]
    },
    {
      "name": "--root",
      "usage": [
        "--root=PATH"
      ],
      "tip": [
        "在备用文件系统根目录上操作。"
      ],
      "next": []
    },
    {
      "name": "--root-password",
      "usage": [
        "--root-password=PASSWORD"
      ],
      "tip": [
        "从明文密码设置 root 密码。"
      ],
      "next": []
    },
    {
      "name": "--root-password-file",
      "usage": [
        "--root-password-file=FILE"
      ],
      "tip": [
        "从文件设置 root 密码。"
      ],
      "next": []
    },
    {
      "name": "--root-password-hashed",
      "usage": [
        "--root-password-hashed=HASH"
      ],
      "tip": [
        "从哈希密码设置 root 密码。"
      ],
      "next": []
    },
    {
      "name": "--root-shell",
      "usage": [
        "--root-shell=SHELL"
      ],
      "tip": [
        "设置 root shell。"
      ],
      "next": []
    },
    {
      "name": "--setup-machine-id",
      "tip": [
        "设置随机机器 ID。"
      ]
    },
    {
      "name": "--timezone",
      "usage": [
        "--timezone=TIMEZONE"
      ],
      "tip": [
        "设置时区。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "--welcome",
      "usage": [
        "--welcome=no"
      ],
      "tip": [
        "禁用欢迎文本。"
      ],
      "next": [
        {
          "name": "no"
        }
      ]
    }
  ]
}
