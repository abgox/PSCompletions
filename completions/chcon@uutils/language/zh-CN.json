{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将每个 FILE 的 SELinux 安全上下文更改为 CONTEXT"
    ]
  },
  "option": [
    {
      "name": "--dereference",
      "tip": [
        "影响每个符号链接的指向目标（默认），而不是符号链接本身"
      ]
    },
    {
      "name": "--no-dereference",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --no-dereference"
      ],
      "tip": [
        "影响符号链接，而不是其指向的文件"
      ]
    },
    {
      "name": "--no-preserve-root",
      "tip": [
        "不特殊对待 /（默认）"
      ]
    },
    {
      "name": "--preserve-root",
      "tip": [
        "拒绝在 / 上递归操作"
      ]
    },
    {
      "name": "--range",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --range <RANGE>"
      ],
      "tip": [
        "在目标安全上下文中设置 rang RANGE"
      ],
      "next": []
    },
    {
      "name": "--recursive",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --recursive"
      ],
      "tip": [
        "递归操作文件和目录"
      ]
    },
    {
      "name": "--reference",
      "usage": [
        "--reference <RFILE>"
      ],
      "tip": [
        "使用 RFILE 的安全上下文，而不指定 CONTEXT 值"
      ],
      "next": []
    },
    {
      "name": "--role",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --role <ROLE>"
      ],
      "tip": [
        "在目标安全上下文中设置角色 ROLE"
      ],
      "next": []
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "在目标安全上下文中设置类型 TYPE"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <USER>"
      ],
      "tip": [
        "在目标安全上下文中设置用户 USER"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "为每个处理过的文件输出诊断信息"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-H",
      "tip": [
        "如果命令行参数是指向目录的符号链接，则遍历它。仅在指定 -R 时有效"
      ]
    },
    {
      "name": "-L",
      "tip": [
        "遍历遇到的每个指向目录的符号链接。仅在指定 -R 时有效"
      ]
    },
    {
      "name": "-P",
      "tip": [
        "不遍历任何符号链接（默认）。仅在指定 -R 时有效"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
