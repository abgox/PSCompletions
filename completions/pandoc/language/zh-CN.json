      "usage": [
        "-D, --print-default-template"
      ],
      "tip": [
        "打印指定格式的默认模板。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "tip": [
        "抑制警告输出。"
      ]
    },
    {
      "name": "--resource-path",
      "usage": [
        "--resource-path SEARCHPATH"
      ],
      "tip": [
        "设置资源搜索路径。"
      ],
      "next": []
    },
    {
      "name": "--standalone",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --standalone"
      ],
      "tip": [
        "生成独立文档。"
      ]
    },
    {
      "name": "--template",
      "usage": [
        "--template FILE"
      ],
      "tip": [
        "使用自定义模板。"
      ],
      "next": []
