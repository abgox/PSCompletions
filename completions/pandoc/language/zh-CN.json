    {
      "name": "--include-before-body",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --include-before-body"
      ],
      "tip": [
        "在正文开头包含 FILE 的内容"
      ],
      "next": []
    },
    {
      "name": "--include-in-header",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --include-in-header"
      ],
      "tip": [
        "在页眉中包含 FILE 的内容"
      ],
      "next": []
