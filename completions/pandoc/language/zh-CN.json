      "tip": [
        "指定 STRING 作为标题开头的前缀"
      ],
      "next": []
    },
    {
      "name": "--to",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --to FORMAT"
      ],
      "tip": [
        "指定输出格式。"
      ],
      "next": []
    },
    {
      "name": "--toc",
      "tip": [
        "包含目录。"
      ]
    },
    {
      "name": "--toc-depth",
      "usage": [
        "--toc-depth NUMBER"
      ],
      "tip": [
        "目录中包含的标题级别数。"
      ],
      "next": []
    },
    {
      "name": "--variable",
      "usage": [
        "--variable KEY=VALUE"
      ],
      "tip": [
        "设置模板变量。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "tip": [
        "提供更详细的输出。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "打印版本信息。"
      ]
