{
  "meta": {
    "url": "https://pandoc.org",
    "description": [
      "通用文档转换器。"
    ]
  },
  "option": [
    {
      "name": "--bibliography",
      "usage": [
        "--bibliography FILE"
      ],
      "tip": [
        "设置参考文献文件。"
      ],
      "next": []
    },
    {
      "name": "--citeproc",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --citeproc"
      ],
      "tip": [
        "启用引用处理。"
      ]
    },
    {
      "name": "--columns",
      "usage": [
        "--columns NUMBER"
      ],
      "tip": [
        "设置换行的行长度。"
      ],
      "next": []
    },
    {
      "name": "--csl",
      "usage": [
        "--csl FILE"
      ],
      "tip": [
        "设置引用样式 CSL 文件。"
      ],
      "next": []
    },
    {
      "name": "--css",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --css"
      ],
      "tip": [
        "链接到 CSS 样式表"
      ],
      "next": []
    },
    {
      "name": "--data-dir",
      "usage": [
        "--data-dir DIRECTORY"
      ],
      "tip": [
        "设置用户数据目录。"
      ],
      "next": []
    },
    {
      "name": "--defaults",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --defaults"
      ],
      "tip": [
        "从文件读取默认设置。"
      ],
      "next": []
    },
    {
      "name": "--fail-if-warnings",
      "tip": [
        "如果有警告则以错误退出。"
      ]
    },
    {
      "name": "--filter",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --filter PROGRAM"
      ],
      "tip": [
        "使用外部过滤器。"
      ],
      "next": []
    },
    {
      "name": "--from",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --from FORMAT"
      ],
      "tip": [
        "指定输入格式。"
      ],
      "next": []
    },
