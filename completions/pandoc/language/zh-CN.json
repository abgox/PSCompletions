    {
      "name": "--wrap",
      "usage": [
        "--wrap auto|none|preserve"
      ],
      "tip": [
        "设置换行模式。"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "自动换行。"
          ]
        },
        {
          "name": "none",
          "tip": [
            "不换行。"
          ]
        },
        {
          "name": "preserve",
          "tip": [
            "保持原始换行。"
          ]
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助。"
      ]
    }
  ]
}
