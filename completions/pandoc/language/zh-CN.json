    {
      "name": "--list-output-formats",
      "tip": [
        "列出可用的输出格式。"
      ]
    },
    {
      "name": "--log",
      "usage": [
        "--log FILE"
      ],
      "tip": [
        "将日志消息写入文件。"
      ],
      "next": []
    },
    {
      "name": "--lua-filter",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --lua-filter SCRIPTPATH"
      ],
      "tip": [
        "使用 Lua 过滤器进行处理。"
      ],
      "next": []
    },
    {
      "name": "--mathjax",
      "tip": [
        "使用 MathJax 渲染数学公式。"
      ]
    },
    {
      "name": "--mathml",
      "tip": [
        "使用 MathML 渲染数学公式。"
      ]
    },
    {
      "name": "--metadata",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --metadata"
      ],
      "tip": [
        "设置元数据字段。"
      ],
      "next": []
    },
    {
      "name": "--number-sections",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --number-sections"
      ],
      "tip": [
        "为章节标题编号。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output FILE"
      ],
      "tip": [
        "将输出写入文件。"
      ],
      "next": []
    },
    {
      "name": "--pdf-engine",
      "usage": [
        "--pdf-engine PROGRAM"
      ],
      "tip": [
        "使用指定程序生成 PDF。"
      ],
      "next": []
    },
    {
      "name": "--print-default-template",
      "alias": [
        "-D"
