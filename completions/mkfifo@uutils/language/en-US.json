{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Create a FIFO with the given name."
    ]
  },
  "option": [
    {
      "name": "--context",
      "usage": [
        "--context[=<CTX>]"
      ],
      "tip": [
        "like -Z, or if CTX is specified then set the SELinux or SMACK security context to CTX"
      ],
      "next": []
    },
    {
      "name": "--mode",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mode <MODE>"
      ],
      "tip": [
        "file permissions for the fifo"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "-Z",
      "tip": [
        "set the SELinux security context to default type"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
