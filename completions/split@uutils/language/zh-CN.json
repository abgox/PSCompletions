{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "创建包含输入连续或交错部分的输出文件"
    ]
  },
  "option": [
    {
      "name": "--additional-suffix",
      "usage": [
        "--additional-suffix <SUFFIX>"
      ],
      "tip": [
        "向输出文件名追加额外的 SUFFIX"
      ],
      "next": []
    },
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes <SIZE>"
      ],
      "tip": [
        "每个输出文件放 SIZE 字节"
      ],
      "next": []
    },
    {
      "name": "--elide-empty-files",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --elide-empty-files"
      ],
      "tip": [
        "与 -n 合用时不生成空输出文件"
      ]
    },
    {
      "name": "--filter",
      "usage": [
        "--filter <COMMAND>"
      ],
      "tip": [
        "写入 shell COMMAND；文件名为 $FILE（Windows 上暂未实现）"
      ],
      "next": []
    },
    {
      "name": "--hex-suffixes",
      "usage": [
        "--hex-suffixes[=<FROM>]"
      ],
      "tip": [
        "等同于 -x，但允许设置起始值"
      ],
      "next": []
    },
    {
      "name": "--line-bytes",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --line-bytes <SIZE>"
      ],
      "tip": [
        "每个输出文件最多放 SIZE 字节的行"
      ],
      "next": []
    },
    {
      "name": "--lines",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --lines <NUMBER>"
      ],
      "tip": [
        "每个输出文件放 NUMBER 行 / 记录"
      ],
      "next": []
    },
    {
      "name": "--number",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --number <CHUNKS>"
      ],
      "tip": [
        "生成 CHUNKS 个输出文件；见下文解释"
      ],
      "next": []
    },
    {
      "name": "--numeric-suffixes",
      "usage": [
        "--numeric-suffixes[=<FROM>]"
      ],
      "tip": [
        "等同于 -d，但允许设置起始值"
      ],
      "next": []
    },
    {
      "name": "--separator",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --separator <SEP>"
      ],
      "tip": [
        "用 SEP 而非换行作为记录分隔符；\\0 表示 NUL 字符"
      ],
      "next": []
    },
    {
      "name": "--suffix-length",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --suffix-length <N>"
      ],
      "tip": [
        "生成长度为 N 的后缀（默认 2）"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "tip": [
        "在打开每个输出文件前打印诊断信息"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-d",
      "tip": [
        "使用从 0 开始的数字后缀，而非字母"
      ]
    },
    {
      "name": "-x",
      "tip": [
        "使用从 0 开始的十六进制后缀，而非字母"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
