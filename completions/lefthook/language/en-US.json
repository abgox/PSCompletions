{
  "meta": {
    "url": "https://github.com/evilmartians/lefthook",
    "description": [
      "Git hooks manager."
    ]
  },
  "next": [
    {
      "name": "add",
      "usage": [
        "add <hook_name>"
      ],
      "tip": [
        "Add a new hook to the configuration."
      ]
    },
    {
      "name": "check-install",
      "tip": [
        "Check if lefthook is installed."
      ]
    },
    {
      "name": "dump",
      "tip": [
        "Dump lefthook configuration."
      ]
    },
    {
      "name": "install",
      "alias": [
        "i"
      ],
      "usage": [
        "i|install"
      ],
      "tip": [
        "Install hook scripts to the git repository."
      ],
      "option": [
        {
          "name": "--force",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --force"
          ],
          "tip": [
            "Force install even if hooks exist."
          ]
        },
        {
          "name": "--reset-hooks-path",
          "alias": [
            "-r"
          ],
          "usage": [
            "-r, --reset-hooks-path"
          ],
          "tip": [
            "Reset hooks path to default."
          ]
        },
        {
          "name": "--verbose",
          "alias": [
            "-v"
          ],
          "usage": [
            "-v, --verbose"
          ],
          "tip": [
            "Verbose output."
          ]
        }
      ]
    },
    {
      "name": "run",
      "alias": [
        "r"
      ],
      "usage": [
        "r|run [group_names]"
      ],
      "tip": [
        "Execute hook scripts."
      ],
      "option": [
        {
          "name": "--all-files",
          "tip": [
            "Run on all files."
          ]
        },
        {
          "name": "--colors",
          "usage": [
            "--colors <on|off|auto>"
          ],
          "tip": [
            "Force colored output."
          ],
          "next": [
            {
              "name": "auto"
            },
            {
              "name": "off"
            },
            {
              "name": "on"
            }
          ]
        },
        {
          "name": "--command",
          "usage": [
            "--command <NAME>"
          ],
          "tip": [
            "Run specific command."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--exclude",
          "usage": [
            "--exclude <PATTERN>"
          ],
          "tip": [
            "Exclude files by pattern."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--fail-on-changes",
          "tip": [
            "Fail if there are staged changes."
          ]
        },
        {
          "name": "--file",
          "usage": [
            "--file <FILE>"
          ],
          "tip": [
            "Run specific file."
          ],
          "next": []
        },
        {
          "name": "--files-from-stdin",
          "tip": [
            "Read files from stdin."
          ]
        },
        {
          "name": "--force",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --force"
          ],
          "tip": [
            "Force run even if not in a git repository."
          ]
        },
        {
          "name": "--job",
          "usage": [
            "--job <NAME>"
          ],
          "tip": [
            "Run specific job."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--no-auto-install",
          "tip": [
            "Disable auto-install."
          ]
        },
        {
          "name": "--no-fail-on-changes",
          "tip": [
            "Don't fail on staged changes."
          ]
        },
        {
          "name": "--no-stage-fixed",
          "tip": [
            "Don't stage fixed files."
          ]
        },
        {
          "name": "--no-tty",
          "tip": [
            "Don't use TTY."
          ]
        },
        {
          "name": "--skip-lfs",
          "tip": [
            "Skip LFS hooks."
          ]
        },
        {
          "name": "--tag",
          "usage": [
            "--tag <NAME>"
          ],
          "tip": [
            "Run jobs by tag."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--verbose",
          "alias": [
            "-v"
          ],
          "usage": [
            "-v, --verbose"
          ],
          "tip": [
            "Verbose output."
          ]
        }
      ]
    },
    {
      "name": "self-update",
      "tip": [
        "Update lefthook to the latest version."
      ]
    },
    {
      "name": "uninstall",
      "alias": [
        "u"
      ],
      "usage": [
        "u|uninstall"
      ],
      "tip": [
        "Uninstall hook scripts from the git repository."
      ]
    },
    {
      "name": "validate",
      "tip": [
        "Validate lefthook configuration."
      ]
    },
    {
      "name": "version",
      "tip": [
        "Show version information."
      ]
    }
  ],
  "option": [
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Show version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show help."
      ]
    }
  ]
}
