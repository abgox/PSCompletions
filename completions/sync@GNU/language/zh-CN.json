{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把缓存中的写操作同步到持久存储"
    ]
  },
  "option": [
    {
      "name": "--data",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --data"
      ],
      "tip": [
        "只同步文件数据，不同步多余的元数据"
      ]
    },
    {
      "name": "--file-system",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file-system"
      ],
      "tip": [
        "同步包含这些文件的文件系统"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
