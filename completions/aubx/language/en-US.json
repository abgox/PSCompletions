{
  "meta": {
    "url": "https://aube.jdx.dev",
    "description": [
      "Fetch a package into a throwaway environment and run its binary (aube dlx standalone)"
    ]
  },
  "option": [
    {
      "name": "--allow-build",
      "usage": [
        "--allow-build=<PKG>"
      ],
      "tip": [
        "Allow named packages to run lifecycle scripts during transient install"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--color",
      "tip": [
        "Force colored output even when stderr is not a TTY"
      ]
    },
    {
      "name": "--diag",
      "usage": [
        "--diag [<MODE>]"
      ],
      "tip": [
        "Enable cold-install diagnostics"
      ],
      "next": [
        {
          "name": "full",
          "tip": [
            "Full diagnostics mode"
          ]
        },
        {
          "name": "live",
          "tip": [
            "Live diagnostics mode"
          ]
        },
        {
          "name": "summary",
          "tip": [
            "Summary diagnostics mode"
          ]
        },
        {
          "name": "trace",
          "tip": [
            "Trace diagnostics mode"
          ]
        }
      ]
    },
    {
      "name": "--diag-file",
      "usage": [
        "--diag-file <PATH>"
      ],
      "tip": [
        "Path for diag JSONL trace"
      ],
      "next": []
    },
    {
      "name": "--diag-threshold-ms",
      "usage": [
        "--diag-threshold-ms <MS>"
      ],
      "tip": [
        "Live mode threshold ms"
      ],
      "next": []
    },
    {
      "name": "--disable-global-virtual-store",
      "alias": [
        "--disable-gvs"
      ],
      "usage": [
        "--disable-gvs, --disable-global-virtual-store"
      ],
      "tip": [
        "Force shared global virtual store off"
      ]
    },
    {
      "name": "--enable-global-virtual-store",
      "alias": [
        "--enable-gvs"
      ],
      "usage": [
        "--enable-gvs, --enable-global-virtual-store"
      ],
      "tip": [
        "Force shared global virtual store on"
      ]
    },
    {
      "name": "--fail-if-no-match",
      "tip": [
        "Error when workspace selector matches nothing"
      ]
    },
    {
      "name": "--fetch-retries",
      "usage": [
        "--fetch-retries <N>"
      ],
      "tip": [
        "Number of retry attempts"
      ],
      "next": []
    },
    {
      "name": "--fetch-retry-factor",
      "usage": [
        "--fetch-retry-factor <N>"
      ],
      "tip": [
        "Exponential backoff factor"
      ],
      "next": []
    },
    {
      "name": "--fetch-retry-maxtimeout",
      "usage": [
        "--fetch-retry-maxtimeout <MS>"
      ],
      "tip": [
        "Upper bound ms"
      ],
      "next": [
        {
          "name": "1000"
        },
        {
          "name": "5000"
        }
      ]
    },
    {
      "name": "--fetch-retry-mintimeout",
      "usage": [
        "--fetch-retry-mintimeout <MS>"
      ],
      "tip": [
        "Lower bound ms"
      ],
      "next": [
        {
          "name": "1000"
        },
        {
          "name": "5000"
        }
      ]
    },
    {
      "name": "--fetch-timeout",
      "usage": [
        "--fetch-timeout <MS>"
      ],
      "tip": [
        "Per-request HTTP timeout"
      ],
      "next": [
        {
          "name": "1000"
        },
        {
          "name": "5000"
        }
      ]
    },
    {
      "name": "--filter",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --filter <WORKSPACE>"
      ],
      "tip": [
        "Scope to workspace packages"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--filter-prod",
      "usage": [
        "--filter-prod <PATTERN>"
      ],
      "tip": [
        "Production-only filter"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--frozen-lockfile",
      "tip": [
        "Error if lockfile drifts"
      ]
    },
    {
      "name": "--loglevel",
      "usage": [
        "--loglevel <LEVEL>"
      ],
      "tip": [
        "Set log level"
      ],
      "next": [
        {
          "name": "debug",
          "tip": [
            "Debug log level"
          ]
        },
        {
          "name": "error",
          "tip": [
            "Error log level"
          ]
        },
        {
          "name": "info",
          "tip": [
            "Info log level"
          ]
        },
        {
          "name": "silent",
          "tip": [
            "Silent log level"
          ]
        },
        {
          "name": "trace",
          "tip": [
            "Trace log level"
          ]
        },
        {
          "name": "warn",
          "tip": [
            "Warning log level"
          ]
        }
      ]
    },
    {
      "name": "--no-color",
      "tip": [
        "Disable colored output"
      ]
    },
    {
      "name": "--no-frozen-lockfile",
      "tip": [
        "Always re-resolve"
      ]
    },
    {
      "name": "--package",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --package <PACKAGE>"
      ],
      "tip": [
        "Install a specific package"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--prefer-frozen-lockfile",
      "tip": [
        "Use when fresh, re-resolve when stale"
      ]
    },
    {
      "name": "--prefix",
      "alias": [
        "--dir",
        "--cd",
        "-C"
      ],
      "usage": [
        "-C, --prefix <DIR>"
      ],
      "tip": [
        "Change to directory before running"
      ],
      "next": []
    },
    {
      "name": "--recursive",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --recursive"
      ],
      "tip": [
        "Run across every workspace package"
      ]
    },
    {
      "name": "--registry",
      "usage": [
        "--registry <URL>"
      ],
      "tip": [
        "Override default registry URL"
      ],
      "next": []
    },
    {
      "name": "--reporter",
      "usage": [
        "--reporter <NAME>"
      ],
      "tip": [
        "Output format"
      ],
      "next": [
        {
          "name": "append-only",
          "tip": [
            "Append-only output format"
          ]
        },
        {
          "name": "default",
          "tip": [
            "Default output format"
          ]
        },
        {
          "name": "ndjson",
          "tip": [
            "NDJSON output format"
          ]
        },
        {
          "name": "silent",
          "tip": [
            "Silent output format"
          ]
        }
      ]
    },
    {
      "name": "--shell-mode",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --shell-mode"
      ],
      "tip": [
        "Run assembled command line through sh -c"
      ]
    },
    {
      "name": "--silent",
      "tip": [
        "Suppress all non-error output"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Enable verbose/debug logging (shortcut for --loglevel debug)"
      ]
    },
    {
      "name": "--workspace-root",
      "tip": [
        "Run from workspace root"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version and check for updates"
      ]
    }
  ]
}
