{
  "meta": {
    "url": "https://aube.jdx.dev",
    "description": [
      "将包下载到临时环境并运行其二进制文件 (aube dlx 独立版)"
    ]
  },
  "option": [
    {
      "name": "--allow-build",
      "usage": [
        "--allow-build=<PKG>"
      ],
      "tip": [
        "允许指定包在临时安装期间运行生命周期脚本"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--color",
      "tip": [
        "强制启用彩色输出，即使 stderr 不是 TTY"
      ]
    },
    {
      "name": "--diag",
      "usage": [
        "--diag [<MODE>]"
      ],
      "tip": [
        "启用冷安装诊断"
      ],
      "next": [
        {
          "name": "full",
          "tip": [
            "Full 诊断模式"
          ]
        },
        {
          "name": "live",
          "tip": [
            "Live 诊断模式"
          ]
        },
        {
          "name": "summary",
          "tip": [
            "Summary 诊断模式"
          ]
        },
        {
          "name": "trace",
          "tip": [
            "Trace 诊断模式"
          ]
        }
      ]
    },
    {
      "name": "--diag-file",
      "usage": [
        "--diag-file <PATH>"
      ],
      "tip": [
        "诊断 JSONL 跟踪文件路径"
      ],
      "next": []
    },
    {
      "name": "--diag-threshold-ms",
      "usage": [
        "--diag-threshold-ms <MS>"
      ],
      "tip": [
        "Live 模式阈值毫秒数"
      ],
      "next": []
    },
    {
      "name": "--disable-global-virtual-store",
      "alias": [
        "--disable-gvs"
      ],
      "usage": [
        "--disable-gvs, --disable-global-virtual-store"
      ],
      "tip": [
        "强制关闭共享全局虚拟存储"
      ]
    },
    {
      "name": "--enable-global-virtual-store",
      "alias": [
        "--enable-gvs"
      ],
      "usage": [
        "--enable-gvs, --enable-global-virtual-store"
      ],
      "tip": [
        "强制开启共享全局虚拟存储"
      ]
    },
    {
      "name": "--fail-if-no-match",
      "tip": [
        "当工作区选择器未匹配任何内容时报错"
      ]
    },
    {
      "name": "--fetch-retries",
      "usage": [
        "--fetch-retries <N>"
      ],
      "tip": [
        "重试次数"
      ],
      "next": []
    },
    {
      "name": "--fetch-retry-factor",
      "usage": [
        "--fetch-retry-factor <N>"
      ],
      "tip": [
        "指数退避因子"
      ],
      "next": []
    },
    {
      "name": "--fetch-retry-maxtimeout",
      "usage": [
        "--fetch-retry-maxtimeout <MS>"
      ],
      "tip": [
        "超时上限毫秒数"
      ],
      "next": [
        {
          "name": "1000"
        },
        {
          "name": "5000"
        }
      ]
    },
    {
      "name": "--fetch-retry-mintimeout",
      "usage": [
        "--fetch-retry-mintimeout <MS>"
      ],
      "tip": [
        "超时下限毫秒数"
      ],
      "next": [
        {
          "name": "1000"
        },
        {
          "name": "5000"
        }
      ]
    },
    {
      "name": "--fetch-timeout",
      "usage": [
        "--fetch-timeout <MS>"
      ],
      "tip": [
        "每次请求的 HTTP 超时"
      ],
      "next": [
        {
          "name": "1000"
        },
        {
          "name": "5000"
        }
      ]
    },
    {
      "name": "--filter",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --filter <WORKSPACE>"
      ],
      "tip": [
        "限定作用域到指定工作区包"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--filter-prod",
      "usage": [
        "--filter-prod <PATTERN>"
      ],
      "tip": [
        "仅生产环境过滤器"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--frozen-lockfile",
      "tip": [
        "如果锁文件发生漂移则报错"
      ]
    },
    {
      "name": "--loglevel",
      "usage": [
        "--loglevel <LEVEL>"
      ],
      "tip": [
        "设置日志级别"
      ],
      "next": [
        {
          "name": "debug",
          "tip": [
            "Debug 日志级别"
          ]
        },
        {
          "name": "error",
          "tip": [
            "Error 日志级别"
          ]
        },
        {
          "name": "info",
          "tip": [
            "Info 日志级别"
          ]
        },
        {
          "name": "silent",
          "tip": [
            "Silent 日志级别"
          ]
        },
        {
          "name": "trace",
          "tip": [
            "Trace 日志级别"
          ]
        },
        {
          "name": "warn",
          "tip": [
            "Warning 日志级别"
          ]
        }
      ]
    },
    {
      "name": "--no-color",
      "tip": [
        "禁用彩色输出"
      ]
    },
    {
      "name": "--no-frozen-lockfile",
      "tip": [
        "始终重新解析"
      ]
    },
    {
      "name": "--package",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --package <PACKAGE>"
      ],
      "tip": [
        "安装指定的包"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--prefer-frozen-lockfile",
      "tip": [
        "新鲜时使用，过期时重新解析"
      ]
    },
    {
      "name": "--prefix",
      "alias": [
        "--dir",
        "--cd",
        "-C"
      ],
      "usage": [
        "-C, --prefix <DIR>"
      ],
      "tip": [
        "运行前切换到指定目录"
      ],
      "next": []
    },
    {
      "name": "--recursive",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --recursive"
      ],
      "tip": [
        "在所有工作区包上运行"
      ]
    },
    {
      "name": "--registry",
      "usage": [
        "--registry <URL>"
      ],
      "tip": [
        "覆盖默认注册表 URL"
      ],
      "next": []
    },
    {
      "name": "--reporter",
      "usage": [
        "--reporter <NAME>"
      ],
      "tip": [
        "输出格式"
      ],
      "next": [
        {
          "name": "append-only",
          "tip": [
            "Append-only 输出格式"
          ]
        },
        {
          "name": "default",
          "tip": [
            "默认输出格式"
          ]
        },
        {
          "name": "ndjson",
          "tip": [
            "NDJSON 输出格式"
          ]
        },
        {
          "name": "silent",
          "tip": [
            "Silent 输出格式"
          ]
        }
      ]
    },
    {
      "name": "--shell-mode",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --shell-mode"
      ],
      "tip": [
        "通过 sh -c 运行组合后的命令行"
      ]
    },
    {
      "name": "--silent",
      "tip": [
        "抑制所有非错误输出"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "启用详细/调试日志记录 (--loglevel debug 的快捷方式)"
      ]
    },
    {
      "name": "--workspace-root",
      "tip": [
        "从工作区根目录运行"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本并检查更新"
      ]
    }
  ]
}
