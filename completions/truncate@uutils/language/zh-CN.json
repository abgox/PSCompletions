{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将每个文件的大小收缩或扩展到指定大小"
    ]
  },
  "option": [
    {
      "name": "--io-blocks",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --io-blocks"
      ],
      "tip": [
        "将 SIZE 视为文件的 I/O 块数而非字节数（未实现）"
      ]
    },
    {
      "name": "--no-create",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --no-create"
      ],
      "tip": [
        "不创建不存在的文件"
      ]
    },
    {
      "name": "--reference",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reference <RFILE>"
      ],
      "tip": [
        "以 RFILE 的大小为基准确定每个文件的大小"
      ],
      "next": []
    },
    {
      "name": "--size",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --size <SIZE>"
      ],
      "tip": [
        "按 SIZE 设置或调整每个文件的大小，SIZE 以字节为单位，除非指定了 --io-blocks"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
