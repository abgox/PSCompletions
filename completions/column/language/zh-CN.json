{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "将列表分列显示。"
    ]
  },
  "option": [
    {
      "name": "--fillrows",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --fillrows"
      ],
      "tip": [
        "先填充行，再填充列。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "为表格使用 JSON 输出格式。"
      ]
    },
    {
      "name": "--keep-empty-lines",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --keep-empty-lines"
      ],
      "tip": [
        "不忽略空行。"
      ]
    },
    {
      "name": "--output-separator",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output-separator <string>"
      ],
      "tip": [
        "表格输出的列分隔符（默认为两个空格）。"
      ],
      "next": []
    },
    {
      "name": "--output-width",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --output-width <width>"
      ],
      "tip": [
        "输出宽度（字符数）。"
      ],
      "next": []
    },
    {
      "name": "--separator",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --separator <string>"
      ],
      "tip": [
        "可能的表格分隔符。"
      ],
      "next": []
    },
    {
      "name": "--table",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --table"
      ],
      "tip": [
        "创建表格。"
      ]
    },
    {
      "name": "--table-column",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --table-column <properties>"
      ],
      "tip": [
        "定义列。"
      ],
      "next": []
    },
    {
      "name": "--table-columns",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --table-columns <names>"
      ],
      "tip": [
        "逗号分隔的列名。"
      ],
      "next": []
    },
    {
      "name": "--table-columns-limit",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --table-columns-limit <num>"
      ],
      "tip": [
        "输入列的最大数量。"
      ],
      "next": []
    },
    {
      "name": "--table-header-repeat",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --table-header-repeat"
      ],
      "tip": [
        "每页重复表头。"
      ]
    },
    {
      "name": "--table-hide",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --table-hide <columns>"
      ],
      "tip": [
        "不打印这些列。"
      ],
      "next": []
    },
    {
      "name": "--table-maxout",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --table-maxout"
      ],
      "tip": [
        "填满所有可用空间。"
      ]
    },
    {
      "name": "--table-name",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --table-name <name>"
      ],
      "tip": [
        "JSON 输出的表名。"
      ],
      "next": []
    },
    {
      "name": "--table-noextreme",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --table-noextreme <columns>"
      ],
      "tip": [
        "计算列宽时不考虑这些列中的长文本。"
      ],
      "next": []
    },
    {
      "name": "--table-noheadings",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --table-noheadings"
      ],
      "tip": [
        "不打印表头。"
      ]
    },
    {
      "name": "--table-order",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --table-order <columns>"
      ],
      "tip": [
        "指定输出列的顺序。"
      ],
      "next": []
    },
    {
      "name": "--table-right",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --table-right <columns>"
      ],
      "tip": [
        "将这些列中的文本右对齐。"
      ],
      "next": []
    },
    {
      "name": "--table-truncate",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --table-truncate <columns>"
      ],
      "tip": [
        "必要时截断这些列中的文本。"
      ],
      "next": []
    },
    {
      "name": "--table-wrap",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --table-wrap <columns>"
      ],
      "tip": [
        "必要时在列中换行。"
      ],
      "next": []
    },
    {
      "name": "--tree",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --tree <column>"
      ],
      "tip": [
        "用于树形输出表格的列。"
      ],
      "next": []
    },
    {
      "name": "--tree-id",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --tree-id <column>"
      ],
      "tip": [
        "用于指定父子关系的行 ID。"
      ],
      "next": []
    },
    {
      "name": "--tree-parent",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --tree-parent <column>"
      ],
      "tip": [
        "用于指定父子关系的父级。"
      ],
      "next": []
    },
    {
      "name": "--use-spaces",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --use-spaces <number>"
      ],
      "tip": [
        "列之间的最小空白数（不使用制表符）。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
