{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Columnate lists."
    ]
  },
  "option": [
    {
      "name": "--fillrows",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --fillrows"
      ],
      "tip": [
        "Fill rows before columns."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "Use JSON output format for table."
      ]
    },
    {
      "name": "--keep-empty-lines",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --keep-empty-lines"
      ],
      "tip": [
        "Don't ignore empty lines."
      ]
    },
    {
      "name": "--output-separator",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output-separator <string>"
      ],
      "tip": [
        "Columns separator for table output (default is two spaces)."
      ],
      "next": []
    },
    {
      "name": "--output-width",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --output-width <width>"
      ],
      "tip": [
        "Width of output in number of characters."
      ],
      "next": []
    },
    {
      "name": "--separator",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --separator <string>"
      ],
      "tip": [
        "Possible table delimiters."
      ],
      "next": []
    },
    {
      "name": "--table",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --table"
      ],
      "tip": [
        "Create a table."
      ]
    },
    {
      "name": "--table-column",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --table-column <properties>"
      ],
      "tip": [
        "Define column."
      ],
      "next": []
    },
    {
      "name": "--table-columns",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --table-columns <names>"
      ],
      "tip": [
        "Comma separated column names."
      ],
      "next": []
    },
    {
      "name": "--table-columns-limit",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --table-columns-limit <num>"
      ],
      "tip": [
        "Maximal number of input columns."
      ],
      "next": []
    },
    {
      "name": "--table-header-repeat",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --table-header-repeat"
      ],
      "tip": [
        "Repeat header for each page."
      ]
    },
    {
      "name": "--table-hide",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --table-hide <columns>"
      ],
      "tip": [
        "Don't print the columns."
      ],
      "next": []
    },
    {
      "name": "--table-maxout",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --table-maxout"
      ],
      "tip": [
        "Fill all available space."
      ]
    },
    {
      "name": "--table-name",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --table-name <name>"
      ],
      "tip": [
        "Table name for JSON output."
      ],
      "next": []
    },
    {
      "name": "--table-noextreme",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --table-noextreme <columns>"
      ],
      "tip": [
        "Don't count long text from the columns to column width."
      ],
      "next": []
    },
    {
      "name": "--table-noheadings",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --table-noheadings"
      ],
      "tip": [
        "Don't print header."
      ]
    },
    {
      "name": "--table-order",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --table-order <columns>"
      ],
      "tip": [
        "Specify order of output columns."
      ],
      "next": []
    },
    {
      "name": "--table-right",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --table-right <columns>"
      ],
      "tip": [
        "Right align text in these columns."
      ],
      "next": []
    },
    {
      "name": "--table-truncate",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --table-truncate <columns>"
      ],
      "tip": [
        "Truncate text in the columns when necessary."
      ],
      "next": []
    },
    {
      "name": "--table-wrap",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --table-wrap <columns>"
      ],
      "tip": [
        "Wrap text in the columns when necessary."
      ],
      "next": []
    },
    {
      "name": "--tree",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --tree <column>"
      ],
      "tip": [
        "Column to use tree-like output for the table."
      ],
      "next": []
    },
    {
      "name": "--tree-id",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --tree-id <column>"
      ],
      "tip": [
        "Line ID to specify child-parent relation."
      ],
      "next": []
    },
    {
      "name": "--tree-parent",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --tree-parent <column>"
      ],
      "tip": [
        "Parent to specify child-parent relation."
      ],
      "next": []
    },
    {
      "name": "--use-spaces",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --use-spaces <number>"
      ],
      "tip": [
        "Minimal whitespaces between columns (no tabs)."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
