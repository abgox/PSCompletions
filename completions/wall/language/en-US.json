{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Write a message to all users."
    ]
  },
  "option": [
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group <group>"
      ],
      "tip": [
        "Only send message to group."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--nobanner",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nobanner"
      ],
      "tip": [
        "Do not print banner, works only for root."
      ]
    },
    {
      "name": "--timeout",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --timeout <timeout>"
      ],
      "tip": [
        "Write timeout in seconds."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
