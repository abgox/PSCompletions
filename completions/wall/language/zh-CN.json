{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "向所有用户写入消息。"
    ]
  },
  "option": [
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group <group>"
      ],
      "tip": [
        "仅向该组发送消息。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--nobanner",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nobanner"
      ],
      "tip": [
        "不打印横幅，仅 root 有效。"
      ]
    },
    {
      "name": "--timeout",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --timeout <timeout>"
      ],
      "tip": [
        "写入超时（秒）。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
