{
  "meta": {
    "url": "https://github.com/watchexec/watchexec",
    "description": [
      "Execute commands when watched files change",
      "Recursively monitors for changes and runs commands"
    ]
  },
  "option": [
    {
      "name": "--bell",
      "tip": [
        "Ring the terminal bell on command completion"
      ]
    },
    {
      "name": "--clear",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --clear"
      ],
      "tip": [
        "Clear screen before running command"
      ]
    },
    {
      "name": "--color",
      "usage": [
        "--color <MODE>"
      ],
      "tip": [
        "When to use terminal colours"
      ],
      "next": [
        {
          "name": "always",
          "tip": [
            "Always use colors"
          ]
        },
        {
          "name": "auto",
          "tip": [
            "Automatic (default)"
          ]
        },
        {
          "name": "never",
          "tip": [
            "Never use colors"
          ]
        }
      ]
    },
    {
      "name": "--completions",
      "usage": [
        "--completions <SHELL>"
      ],
      "tip": [
        "Generate a shell completions script"
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "Bash completion"
          ]
        },
        {
          "name": "elvish",
          "tip": [
            "Elvish completion"
          ]
        },
        {
          "name": "fish",
          "tip": [
            "Fish completion"
          ]
        },
        {
          "name": "nu",
          "tip": [
            "Nushell completion"
          ]
        },
        {
          "name": "powershell",
          "tip": [
            "PowerShell completion"
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "Zsh completion"
          ]
        }
      ]
    },
    {
      "name": "--debounce",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debounce <TIMEOUT>"
      ],
      "tip": [
        "Time to wait for new events before taking action"
      ],
      "next": []
    },
    {
      "name": "--delay-run",
      "usage": [
        "--delay-run <DURATION>"
      ],
      "tip": [
        "Sleep before running the command"
      ],
      "next": []
    },
    {
      "name": "--emit-events-to",
      "usage": [
        "--emit-events-to <MODE>"
      ],
      "tip": [
        "Configure event emission"
      ],
      "next": [
        {
          "name": "file",
          "tip": [
            "Emit to file"
          ]
        },
        {
          "name": "json-file",
          "tip": [
            "Emit JSON to file"
          ]
        },
        {
          "name": "json-stdio",
          "tip": [
            "Emit JSON to stdio"
          ]
        },
        {
          "name": "none",
          "tip": [
            "No event emission (default)"
          ]
        },
        {
          "name": "stdio",
          "tip": [
            "Emit to stdio"
          ]
        }
      ]
    },
    {
      "name": "--env",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --env <KEY=VALUE>"
      ],
      "tip": [
        "Add env vars to the command"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--exit-on-error",
      "tip": [
        "Exit when the command has an error"
      ]
    },
    {
      "name": "--exts",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exts <EXTENSIONS>"
      ],
      "tip": [
        "Filename extensions to filter to"
      ],
      "next": []
    },
    {
      "name": "--filter",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --filter <PATTERN>"
      ],
      "tip": [
        "Filename patterns to filter to"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--filter-prog",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --filter-prog <EXPRESSION>"
      ],
      "tip": [
        "Filter programs in jaq syntax"
      ],
      "next": []
    },
    {
      "name": "--fs-events",
      "usage": [
        "--fs-events <EVENTS>"
      ],
      "tip": [
        "Filesystem events to filter to"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    },
    {
      "name": "--ignore",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore <PATTERN>"
      ],
      "tip": [
        "Filename patterns to filter out"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--ignore-nothing",
      "tip": [
        "Don't ignore anything at all"
      ]
    },
    {
      "name": "--interactive",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --interactive"
      ],
      "tip": [
        "Respond to keypresses to quit, restart, or pause"
      ]
    },
    {
      "name": "--log-file",
      "usage": [
        "--log-file [<PATH>]"
      ],
      "tip": [
        "Write diagnostic logs to a file"
      ],
      "next": []
    },
    {
      "name": "--map-signal",
      "usage": [
        "--map-signal <SIGNAL:SIGNAL>"
      ],
      "tip": [
        "Translate signals from the OS to signals for the command"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--no-default-ignore",
      "tip": [
        "Don't use internal default ignores"
      ]
    },
    {
      "name": "--no-project-ignore",
      "tip": [
        "Don't load project-local ignores"
      ]
    },
    {
      "name": "--no-vcs-ignore",
      "tip": [
        "Don't load gitignores"
      ]
    },
    {
      "name": "--notify",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --notify"
      ],
      "tip": [
        "Alert when commands start and end"
      ]
    },
    {
      "name": "--on-busy-update",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --on-busy-update <MODE>"
      ],
      "tip": [
        "What to do when receiving events while the command is running"
      ],
      "next": [
        {
          "name": "do-nothing",
          "tip": [
            "Ignore events while running (default)"
          ]
        },
        {
          "name": "queue",
          "tip": [
            "Run again when current run finishes"
          ]
        },
        {
          "name": "restart",
          "tip": [
            "Terminate and restart"
          ]
        },
        {
          "name": "signal",
          "tip": [
            "Send a signal"
          ]
        }
      ]
    },
    {
      "name": "--only-emit-events",
      "tip": [
        "Only emit events to stdout, run no commands"
      ]
    },
    {
      "name": "--poll",
      "usage": [
        "--poll [<INTERVAL>]"
      ],
      "tip": [
        "Poll for filesystem changes"
      ],
      "next": []
    },
    {
      "name": "--postpone",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --postpone"
      ],
      "tip": [
        "Wait until first change before running command"
      ]
    },
    {
      "name": "--print-events",
      "tip": [
        "Print events that trigger actions"
      ]
    },
    {
      "name": "--project-origin",
      "usage": [
        "--project-origin <DIR>"
      ],
      "tip": [
        "Set the project origin"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Don't print starting and stopping messages"
      ]
    },
    {
      "name": "--restart",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --restart"
      ],
      "tip": [
        "Restart the process if it's still running"
      ]
    },
    {
      "name": "--shell",
      "usage": [
        "--shell <SHELL>"
      ],
      "tip": [
        "Use a different shell"
      ],
      "next": []
    },
    {
      "name": "--signal",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --signal <SIGNAL>"
      ],
      "tip": [
        "Send a signal to the process when it's still running"
      ],
      "next": []
    },
    {
      "name": "--stdin-quit",
      "tip": [
        "Exit when stdin closes"
      ]
    },
    {
      "name": "--stop-signal",
      "usage": [
        "--stop-signal <SIGNAL>"
      ],
      "tip": [
        "Signal to send to stop the command"
      ],
      "next": []
    },
    {
      "name": "--stop-timeout",
      "usage": [
        "--stop-timeout <TIMEOUT>"
      ],
      "tip": [
        "Time to wait for the command to exit gracefully"
      ],
      "next": []
    },
    {
      "name": "--timeout",
      "usage": [
        "--timeout <TIMEOUT>"
      ],
      "tip": [
        "Kill the command if it runs longer than this duration"
      ],
      "next": []
    },
    {
      "name": "--timings",
      "tip": [
        "Print how long the command took to run"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Set diagnostic log level"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "--watch",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --watch <PATH>"
      ],
      "tip": [
        "Watch a specific file or directory"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--watch-file",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --watch-file <PATH>"
      ],
      "tip": [
        "Watch files and directories from a file"
      ],
      "next": []
    },
    {
      "name": "--watch-non-recursive",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --watch-non-recursive <PATH>"
      ],
      "tip": [
        "Watch a specific directory, non-recursively"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--workdir",
      "usage": [
        "--workdir <DIR>"
      ],
      "tip": [
        "Set the working directory"
      ],
      "next": []
    },
    {
      "name": "--wrap-process",
      "usage": [
        "--wrap-process <MODE>"
      ],
      "tip": [
        "Configure how the process is wrapped"
      ],
      "next": [
        {
          "name": "group",
          "tip": [
            "Use a process group (default)"
          ]
        },
        {
          "name": "none",
          "tip": [
            "Run command directly"
          ]
        },
        {
          "name": "session",
          "tip": [
            "Use a process session"
          ]
        }
      ]
    },
    {
      "name": "-n",
      "tip": [
        "Shorthand for --shell=none"
      ]
    }
  ]
}
