{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "创建给定 TYPE 的特殊文件 NAME"
    ]
  },
  "option": [
    {
      "name": "--context",
      "usage": [
        "--context[=<CTX>]"
      ],
      "tip": [
        "类似 -Z，如果指定了 CTX 则将 SELinux 或 SMACK 安全上下文设为 CTX"
      ],
      "next": []
    },
    {
      "name": "--mode",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mode <MODE>"
      ],
      "tip": [
        "将文件权限位设为 MODE，而非 a=rw - umask"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-Z",
      "tip": [
        "将每个创建目录的 SELinux 安全上下文设为默认类型"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
