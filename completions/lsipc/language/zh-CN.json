{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示 IPC 设施信息。"
    ]
  },
  "option": [
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "以字节打印 SIZE。"
      ]
    },
    {
      "name": "--creator",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --creator"
      ],
      "tip": [
        "显示创建者和所有者。"
      ]
    },
    {
      "name": "--export",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --export"
      ],
      "tip": [
        "以可导出的输出格式显示。"
      ]
    },
    {
      "name": "--global",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --global"
      ],
      "tip": [
        "系统范围使用情况信息（可与 -m、-q 和 -s 一起使用）。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--id",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --id <id>"
      ],
      "tip": [
        "由 <id> 标识的 System V 资源。"
      ],
      "next": []
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "使用 JSON 输出格式。"
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "强制使用列表输出格式（例如与 --id 一起使用）。"
      ]
    },
    {
      "name": "--name",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --name <name>"
      ],
      "tip": [
        "由 <name> 标识的 POSIX 资源。"
      ],
      "next": []
    },
    {
      "name": "--newline",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --newline"
      ],
      "tip": [
        "每项信息显示在新的一行。"
      ]
    },
    {
      "name": "--noheadings",
      "tip": [
        "不打印标题。"
      ]
    },
    {
      "name": "--notruncate",
      "tip": [
        "不截断输出。"
      ]
    },
    {
      "name": "--numeric-perms",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --numeric-perms"
      ],
      "tip": [
        "打印数字权限（PERMS 列）。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output[=<list>]"
      ],
      "tip": [
        "定义要输出的列。"
      ],
      "next": []
    },
    {
      "name": "--posix-mqueues",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --posix-mqueues"
      ],
      "tip": [
        "POSIX 消息队列。"
      ]
    },
    {
      "name": "--posix-semaphores",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --posix-semaphores"
      ],
      "tip": [
        "POSIX 信号量。"
      ]
    },
    {
      "name": "--posix-shmems",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --posix-shmems"
      ],
      "tip": [
        "POSIX 共享内存段。"
      ]
    },
    {
      "name": "--queues",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --queues"
      ],
      "tip": [
        "消息队列。"
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "以原始模式显示。"
      ]
    },
    {
      "name": "--semaphores",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --semaphores"
      ],
      "tip": [
        "信号量。"
      ]
    },
    {
      "name": "--shell",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --shell"
      ],
      "tip": [
        "使用可用作 shell 变量的列名。"
      ]
    },
    {
      "name": "--shmems",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --shmems"
      ],
      "tip": [
        "共享内存段。"
      ]
    },
    {
      "name": "--time",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --time"
      ],
      "tip": [
        "显示附加、分离和更改时间。"
      ]
    },
    {
      "name": "--time-format",
      "usage": [
        "--time-format=<type>"
      ],
      "tip": [
        "以 short、full 或 iso 格式显示日期。",
        "可能值: short, full, iso"
      ],
      "next": [
        {
          "name": "full"
        },
        {
          "name": "iso"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
