{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Show information on IPC facilities."
    ]
  },
  "option": [
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "Print SIZE in bytes."
      ]
    },
    {
      "name": "--creator",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --creator"
      ],
      "tip": [
        "Show creator and owner."
      ]
    },
    {
      "name": "--export",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --export"
      ],
      "tip": [
        "Display in an export-able output format."
      ]
    },
    {
      "name": "--global",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --global"
      ],
      "tip": [
        "Info about system-wide usage (may be used with -m, -q and -s)."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--id",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --id <id>"
      ],
      "tip": [
        "System V resource identified by <id>."
      ],
      "next": []
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "Use the JSON output format."
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "Force list output format (for example with --id)."
      ]
    },
    {
      "name": "--name",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --name <name>"
      ],
      "tip": [
        "POSIX resource identified by <name>."
      ],
      "next": []
    },
    {
      "name": "--newline",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --newline"
      ],
      "tip": [
        "Display each piece of information on a new line."
      ]
    },
    {
      "name": "--noheadings",
      "tip": [
        "Don't print headings."
      ]
    },
    {
      "name": "--notruncate",
      "tip": [
        "Don't truncate output."
      ]
    },
    {
      "name": "--numeric-perms",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --numeric-perms"
      ],
      "tip": [
        "Print numeric permissions (PERMS column)."
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output[=<list>]"
      ],
      "tip": [
        "Define the columns to output."
      ],
      "next": []
    },
    {
      "name": "--posix-mqueues",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --posix-mqueues"
      ],
      "tip": [
        "POSIX message queues."
      ]
    },
    {
      "name": "--posix-semaphores",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --posix-semaphores"
      ],
      "tip": [
        "POSIX semaphores."
      ]
    },
    {
      "name": "--posix-shmems",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --posix-shmems"
      ],
      "tip": [
        "POSIX shared memory segments."
      ]
    },
    {
      "name": "--queues",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --queues"
      ],
      "tip": [
        "Message queues."
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "Display in raw mode."
      ]
    },
    {
      "name": "--semaphores",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --semaphores"
      ],
      "tip": [
        "Semaphores."
      ]
    },
    {
      "name": "--shell",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --shell"
      ],
      "tip": [
        "Use column names to be usable as shell variables."
      ]
    },
    {
      "name": "--shmems",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --shmems"
      ],
      "tip": [
        "Shared memory segments."
      ]
    },
    {
      "name": "--time",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --time"
      ],
      "tip": [
        "Show attach, detach and change times."
      ]
    },
    {
      "name": "--time-format",
      "usage": [
        "--time-format=<type>"
      ],
      "tip": [
        "Display dates in short, full or iso format.",
        "Possible values: short, full, iso"
      ],
      "next": [
        {
          "name": "full"
        },
        {
          "name": "iso"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
