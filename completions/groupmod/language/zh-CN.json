{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "修改系统中的组定义。"
    ]
  },
  "option": [
    {
      "name": "--append",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --append"
      ],
      "tip": [
        "将 -U 提到的用户追加到组中，而不移除已有成员。"
      ]
    },
    {
      "name": "--gid",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --gid <GID>"
      ],
      "tip": [
        "将组 ID 更改为 GID。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--new-name",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --new-name <NEW_GROUP>"
      ],
      "tip": [
        "将名称更改为 NEW_GROUP。"
      ],
      "next": []
    },
    {
      "name": "--non-unique",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --non-unique"
      ],
      "tip": [
        "允许使用重复（非唯一）的 GID。"
      ]
    },
    {
      "name": "--password",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --password <PASSWORD>"
      ],
      "tip": [
        "将密码更改为此（加密）PASSWORD。"
      ],
      "next": []
    },
    {
      "name": "--prefix",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --prefix <PREFIX_DIR>"
      ],
      "tip": [
        "在 PREFIX_DIR 下的根文件系统中应用对配置文件的更改。",
        "该选项不会 chroot，用于准备交叉编译目标。"
      ],
      "next": []
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--users",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --users <USERS>"
      ],
      "tip": [
        "该组的用户成员列表。"
      ],
      "separator": ",",
      "next": []
    }
  ]
}
