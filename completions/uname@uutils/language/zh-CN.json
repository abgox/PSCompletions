{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "打印特定的系统信息"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "表现得如同指定了所有 -mnrsvo 选项"
      ]
    },
    {
      "name": "--kernel-name",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --kernel-name"
      ],
      "tip": [
        "打印内核名称"
      ]
    },
    {
      "name": "--kernel-release",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --kernel-release"
      ],
      "tip": [
        "打印操作系统发行版"
      ]
    },
    {
      "name": "--kernel-version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --kernel-version"
      ],
      "tip": [
        "打印操作系统版本"
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --machine"
      ],
      "tip": [
        "打印机器硬件名称"
      ]
    },
    {
      "name": "--nodename",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nodename"
      ],
      "tip": [
        "打印节点名（节点名可能是系统在通信网络中的名称）"
      ]
    },
    {
      "name": "--operating-system",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --operating-system"
      ],
      "tip": [
        "打印操作系统名称"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
