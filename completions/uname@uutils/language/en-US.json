{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Print certain system information."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Behave as though all of the options -mnrsvo were specified"
      ]
    },
    {
      "name": "--kernel-name",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --kernel-name"
      ],
      "tip": [
        "print the kernel name"
      ]
    },
    {
      "name": "--kernel-release",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --kernel-release"
      ],
      "tip": [
        "print the operating system release"
      ]
    },
    {
      "name": "--kernel-version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --kernel-version"
      ],
      "tip": [
        "print the operating system version"
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --machine"
      ],
      "tip": [
        "print the machine hardware name"
      ]
    },
    {
      "name": "--nodename",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nodename"
      ],
      "tip": [
        "print the nodename (the nodename may be a name that the system is known by to a communications network)"
      ]
    },
    {
      "name": "--operating-system",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --operating-system"
      ],
      "tip": [
        "print the operating system name"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
