{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "禁用用于分页和交换的设备和文件。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "禁用 /proc/swaps 中的所有交换区。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "详细模式。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
