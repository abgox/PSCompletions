{
  "meta": {
    "url": "https://github.com/pranshuparmar/witr",
    "description": [
      "Why Is This Running - A tool that traces any process, port, container, or file back to the exact chain that started it"
    ]
  },
  "option": [
    {
      "name": "--container",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --container <NAME>"
      ],
      "tip": [
        "Container(s) to look up. Repeatable."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--env",
      "tip": [
        "Show environment variables for the process."
      ]
    },
    {
      "name": "--exact",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exact"
      ],
      "tip": [
        "Use exact name matching (no substring search)."
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file <PATH>"
      ],
      "tip": [
        "File(s) held open by a process. Repeatable."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "Interactive mode (TUI)."
      ]
    },
    {
      "name": "--json",
      "tip": [
        "Show result as JSON."
      ]
    },
    {
      "name": "--no-color",
      "tip": [
        "Disable colorized output."
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid <PID>"
      ],
      "tip": [
        "PID(s) to look up. Repeatable."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--port",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --port <PORT>"
      ],
      "tip": [
        "Port(s) to look up. Repeatable."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--short",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --short"
      ],
      "tip": [
        "Show only ancestry."
      ]
    },
    {
      "name": "--tree",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --tree"
      ],
      "tip": [
        "Show only ancestry as a tree."
      ]
    },
    {
      "name": "--verbose",
      "tip": [
        "Show extended process information."
      ]
    },
    {
      "name": "--warnings",
      "tip": [
        "Show only warnings."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show help for witr."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Show version for witr."
      ]
    }
  ]
}
