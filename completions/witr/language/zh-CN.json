{
  "meta": {
    "url": "https://github.com/pranshuparmar/witr",
    "description": [
      "Why Is This Running - 一款可将任意进程、端口、容器或文件追溯至其确切启动链路的工具"
    ]
  },
  "option": [
    {
      "name": "--container",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --container <NAME>"
      ],
      "tip": [
        "要查找的容器（可重复使用）。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--env",
      "tip": [
        "显示进程的环境变量。"
      ]
    },
    {
      "name": "--exact",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exact"
      ],
      "tip": [
        "使用精确名称匹配（不模糊搜索）。"
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file <PATH>"
      ],
      "tip": [
        "进程持有的文件（可重复使用）。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "交互模式（TUI）。"
      ]
    },
    {
      "name": "--json",
      "tip": [
        "以 JSON 格式显示结果。"
      ]
    },
    {
      "name": "--no-color",
      "tip": [
        "禁用彩色输出。"
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid <PID>"
      ],
      "tip": [
        "要查找的 PID（可重复使用）。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--port",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --port <PORT>"
      ],
      "tip": [
        "要查找的端口（可重复使用）。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--short",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --short"
      ],
      "tip": [
        "仅显示祖先关系。"
      ]
    },
    {
      "name": "--tree",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --tree"
      ],
      "tip": [
        "以树形结构显示祖先关系。"
      ]
    },
    {
      "name": "--verbose",
      "tip": [
        "显示扩展进程信息。"
      ]
    },
    {
      "name": "--warnings",
      "tip": [
        "仅显示警告。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示 witr 帮助信息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示 witr 版本信息。"
      ]
    }
  ]
}
