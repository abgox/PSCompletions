{
  "meta": {
    "url": "https://docs.pytest.org",
    "description": [
      "Python testing framework."
    ]
  },
  "option": [
    {
      "name": "--assert",
      "usage": [
        "--assert <MODE>"
      ],
      "tip": [
        "Control assertion debugging tools."
      ],
      "next": [
        {
          "name": "plain",
          "tip": [
            "Perform no assertion debugging."
          ]
        },
        {
          "name": "rewrite",
          "tip": [
            "Rewrite assert statements in test modules on import.",
            "Default."
          ]
        }
      ]
    },
    {
      "name": "--basetemp",
      "usage": [
        "--basetemp <DIR>"
      ],
      "tip": [
        "Base temporary directory for this test run."
      ],
      "next": []
    },
    {
      "name": "--cache-clear",
      "tip": [
        "Remove all cache contents at start of test run."
      ]
    },
    {
      "name": "--cache-show",
      "usage": [
        "--cache-show [<GLOB>]"
      ],
      "tip": [
        "Show cache contents, don't perform collection or tests."
      ],
      "next": []
    },
    {
      "name": "--capture",
      "usage": [
        "--capture <METHOD>"
      ],
      "tip": [
        "Per-test capturing method."
      ],
      "next": [
        {
          "name": "fd",
          "tip": [
            "File descriptor capturing."
          ]
        },
        {
          "name": "no",
          "tip": [
            "Disable capturing."
          ]
        },
        {
          "name": "sys",
          "tip": [
            "Sys-level capturing."
          ]
        },
        {
          "name": "tee-sys",
          "tip": [
            "Tee sys capturing."
          ]
        }
      ]
    },
    {
      "name": "--code-highlight",
      "usage": [
        "--code-highlight <YES-NO>"
      ],
      "tip": [
        "Whether code should be highlighted (only if --color is also enabled).",
        "Default: yes."
      ],
      "next": [
        {
          "name": "no",
          "tip": [
            "Disable code highlighting."
          ]
        },
        {
          "name": "yes",
          "tip": [
            "Enable code highlighting.",
            "Default."
          ]
        }
      ]
    },
    {
      "name": "--collect-in-virtualenv",
      "tip": [
        "Don't ignore tests in a local virtualenv directory."
      ]
    },
    {
      "name": "--collect-only",
      "alias": [
        "--co"
      ],
      "usage": [
        "--co, --collect-only"
      ],
      "tip": [
        "Only collect tests, don't execute them."
      ]
    },
    {
      "name": "--color",
      "usage": [
        "--color <COLOR>"
      ],
      "tip": [
        "Color terminal output."
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "Automatic color."
          ]
        },
        {
          "name": "no",
          "tip": [
            "Disable color."
          ]
        },
        {
          "name": "yes",
          "tip": [
            "Force color."
          ]
        }
      ]
    },
    {
      "name": "--confcutdir",
      "usage": [
        "--confcutdir <DIR>"
      ],
      "tip": [
        "Only load conftest.py's relative to specified dir."
      ],
      "next": []
    },
    {
      "name": "--config-file",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config-file <FILE>"
      ],
      "tip": [
        "Load configuration from FILE instead of trying to locate one of the implicit configuration files."
      ],
      "next": []
    },
    {
      "name": "--continue-on-collection-errors",
      "tip": [
        "Force test execution even if collection errors occur."
      ]
    },
    {
      "name": "--debug",
      "usage": [
        "--debug [<FILE>]"
      ],
      "tip": [
        "Store internal tracing debug information in this log file.",
        "Default: pytestdebug.log."
      ],
      "next": []
    },
    {
      "name": "--deselect",
      "usage": [
        "--deselect <NODEID>"
      ],
      "tip": [
        "Deselect item (via node id prefix) during collection.",
        "Repeatable."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--disable-plugin-autoload",
      "tip": [
        "Disable plugin auto-loading through entry point packaging metadata."
      ]
    },
    {
      "name": "--disable-pytest-warnings",
      "alias": [
        "--disable-warnings"
      ],
      "usage": [
        "--disable-warnings, --disable-pytest-warnings"
      ],
      "tip": [
        "Disable warnings summary."
      ]
    },
    {
      "name": "--doctest-continue-on-failure",
      "tip": [
        "For a given doctest, continue to run after the first failure."
      ]
    },
    {
      "name": "--doctest-glob",
      "usage": [
        "--doctest-glob <PAT>"
      ],
      "tip": [
        "Doctests file matching pattern.",
        "Default: test*.txt."
      ],
      "next": []
    },
    {
      "name": "--doctest-ignore-import-errors",
      "tip": [
        "Ignore doctest collection errors."
      ]
    },
    {
      "name": "--doctest-modules",
      "tip": [
        "Run doctests in all .py modules."
      ]
    },
    {
      "name": "--doctest-report",
      "usage": [
        "--doctest-report <FORMAT>"
      ],
      "tip": [
        "Choose another output format for diffs on doctest failure."
      ],
      "next": [
        {
          "name": "cdiff",
          "tip": [
            "Compact diff format."
          ]
        },
        {
          "name": "ndiff",
          "tip": [
            "Ndiff format."
          ]
        },
        {
          "name": "none",
          "tip": [
            "No diff output."
          ]
        },
        {
          "name": "only_first_failure",
          "tip": [
            "Only the first failure."
          ]
        },
        {
          "name": "udiff",
          "tip": [
            "Unified diff format."
          ]
        }
      ]
    },
    {
      "name": "--durations",
      "usage": [
        "--durations <N>"
      ],
      "tip": [
        "Show N slowest setup/test durations (N=0 for all)."
      ],
      "next": []
    },
    {
      "name": "--durations-min",
      "usage": [
        "--durations-min <N>"
      ],
      "tip": [
        "Minimal duration in seconds for inclusion in slowest list.",
        "Default: 0.005."
      ],
      "next": []
    },
    {
      "name": "--exitfirst",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exitfirst"
      ],
      "tip": [
        "Exit instantly on first error or failed test."
      ]
    },
    {
      "name": "--failed-first",
      "alias": [
        "--ff"
      ],
      "usage": [
        "--ff, --failed-first"
      ],
      "tip": [
        "Run all tests, but run the last failures first."
      ]
    },
    {
      "name": "--fixtures",
      "alias": [
        "--funcargs"
      ],
      "usage": [
        "--fixtures, --funcargs"
      ],
      "tip": [
        "Show available fixtures, sorted by plugin appearance."
      ]
    },
    {
      "name": "--fixtures-per-test",
      "tip": [
        "Show fixtures per test."
      ]
    },
    {
      "name": "--force-short-summary",
      "tip": [
        "Force condensed summary output regardless of verbosity level."
      ]
    },
    {
      "name": "--full-trace",
      "tip": [
        "Don't cut any tracebacks (default is to cut)."
      ]
    },
    {
      "name": "--ignore",
      "usage": [
        "--ignore <PATH>"
      ],
      "tip": [
        "Ignore path during collection.",
        "Repeatable."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--ignore-glob",
      "usage": [
        "--ignore-glob <PATH>"
      ],
      "tip": [
        "Ignore path pattern during collection.",
        "Repeatable."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--import-mode",
      "usage": [
        "--import-mode <MODE>"
      ],
      "tip": [
        "Prepend/append to sys.path when importing test modules and conftest files.",
        "Default: prepend."
      ],
      "next": [
        {
          "name": "append",
          "tip": [
            "Append to sys.path."
          ]
        },
        {
          "name": "importlib",
          "tip": [
            "Import using importlib."
          ]
        },
        {
          "name": "prepend",
          "tip": [
            "Prepend to sys.path.",
            "Default."
          ]
        }
      ]
    },
    {
      "name": "--junit-prefix",
      "alias": [
        "--junitprefix"
      ],
      "usage": [
        "--junitprefix, --junit-prefix <STR>"
      ],
      "tip": [
        "Prepend prefix to classnames in junit-xml output."
      ],
      "next": []
    },
    {
      "name": "--junit-xml",
      "alias": [
        "--junitxml"
      ],
      "usage": [
        "--junitxml, --junit-xml <PATH>"
      ],
      "tip": [
        "Create junit-xml style report file at given path."
      ],
      "next": []
    },
    {
      "name": "--keep-duplicates",
      "tip": [
        "Keep duplicate tests."
      ]
    },
    {
      "name": "--last-failed",
      "alias": [
        "--lf"
      ],
      "usage": [
        "--lf, --last-failed"
      ],
      "tip": [
        "Rerun only the tests that failed at the last run (or all if none failed)."
      ]
    },
    {
      "name": "--last-failed-no-failures",
      "alias": [
        "--lfnf"
      ],
      "usage": [
        "--lfnf, --last-failed-no-failures <ALL-NONE>"
      ],
      "tip": [
        "With --lf, determines whether to execute tests when there are no previously known failures.",
        "Default: all."
      ],
      "next": [
        {
          "name": "all",
          "tip": [
            "Run the full test suite again.",
            "Default."
          ]
        },
        {
          "name": "none",
          "tip": [
            "Emit a message about no known failures and exit successfully."
          ]
        }
      ]
    },
    {
      "name": "--log-auto-indent",
      "usage": [
        "--log-auto-indent <VALUE>"
      ],
      "tip": [
        "Auto-indent multiline messages passed to the logging module. Accepts true|on, false|off or an integer."
      ],
      "next": []
    },
    {
      "name": "--log-cli-date-format",
      "usage": [
        "--log-cli-date-format <FORMAT>"
      ],
      "tip": [
        "Log date format used by the logging module."
      ],
      "next": []
    },
    {
      "name": "--log-cli-format",
      "usage": [
        "--log-cli-format <FORMAT>"
      ],
      "tip": [
        "Log format used by the logging module."
      ],
      "next": []
    },
    {
      "name": "--log-cli-level",
      "usage": [
        "--log-cli-level <LEVEL>"
      ],
      "tip": [
        "CLI logging level."
      ],
      "next": []
    },
    {
      "name": "--log-date-format",
      "usage": [
        "--log-date-format <FORMAT>"
      ],
      "tip": [
        "Log date format used by the logging module."
      ],
      "next": []
    },
    {
      "name": "--log-disable",
      "usage": [
        "--log-disable <LOGGER>"
      ],
      "tip": [
        "Disable a logger by name.",
        "Repeatable."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--log-file",
      "usage": [
        "--log-file <FILE>"
      ],
      "tip": [
        "Path to a file when logging will be written to."
      ],
      "next": []
    },
    {
      "name": "--log-file-date-format",
      "usage": [
        "--log-file-date-format <FORMAT>"
      ],
      "tip": [
        "Log date format used by the logging module."
      ],
      "next": []
    },
    {
      "name": "--log-file-format",
      "usage": [
        "--log-file-format <FORMAT>"
      ],
      "tip": [
        "Log format used by the logging module."
      ],
      "next": []
    },
    {
      "name": "--log-file-level",
      "usage": [
        "--log-file-level <LEVEL>"
      ],
      "tip": [
        "Log file logging level."
      ],
      "next": []
    },
    {
      "name": "--log-file-mode",
      "usage": [
        "--log-file-mode <MODE>"
      ],
      "tip": [
        "Log file open mode."
      ],
      "next": [
        {
          "name": "a",
          "tip": [
            "Append mode."
          ]
        },
        {
          "name": "w",
          "tip": [
            "Write mode."
          ]
        }
      ]
    },
    {
      "name": "--log-format",
      "usage": [
        "--log-format <FORMAT>"
      ],
      "tip": [
        "Log format used by the logging module."
      ],
      "next": []
    },
    {
      "name": "--log-level",
      "usage": [
        "--log-level <LEVEL>"
      ],
      "tip": [
        "Level of messages to catch/display."
      ],
      "next": []
    },
    {
      "name": "--markers",
      "tip": [
        "Show markers (builtin, plugin and per-project ones)."
      ]
    },
    {
      "name": "--max-warnings",
      "usage": [
        "--max-warnings <NUM>"
      ],
      "tip": [
        "Exit with error if all tests pass but the number of warnings exceeds this threshold."
      ],
      "next": []
    },
    {
      "name": "--maxfail",
      "usage": [
        "--maxfail <NUM>"
      ],
      "tip": [
        "Exit after first num failures or errors."
      ],
      "next": []
    },
    {
      "name": "--new-first",
      "alias": [
        "--nf"
      ],
      "usage": [
        "--nf, --new-first"
      ],
      "tip": [
        "Run tests from new files first, then the rest of the tests sorted by file mtime."
      ]
    },
    {
      "name": "--no-fold-skipped",
      "tip": [
        "Do not fold skipped tests in short summary."
      ]
    },
    {
      "name": "--no-header",
      "tip": [
        "Disable header."
      ]
    },
    {
      "name": "--no-showlocals",
      "tip": [
        "Hide locals in tracebacks."
      ]
    },
    {
      "name": "--no-summary",
      "tip": [
        "Disable summary."
      ]
    },
    {
      "name": "--noconftest",
      "tip": [
        "Don't load any conftest.py files."
      ]
    },
    {
      "name": "--override-ini",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --override-ini <OPTION>"
      ],
      "tip": [
        "Override configuration option with option=value style.",
        "Repeatable."
      ],
      "example": [
        "-o strict_xfail=True"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--pastebin",
      "usage": [
        "--pastebin <MODE>"
      ],
      "tip": [
        "Send info to bpaste.net pastebin service."
      ],
      "next": [
        {
          "name": "all",
          "tip": [
            "Send all info."
          ]
        },
        {
          "name": "failed",
          "tip": [
            "Send failed info."
          ]
        }
      ]
    },
    {
      "name": "--pdb",
      "tip": [
        "Start the interactive Python debugger on errors or KeyboardInterrupt."
      ]
    },
    {
      "name": "--pdbcls",
      "usage": [
        "--pdbcls <MODULE:CLASS>"
      ],
      "tip": [
        "Specify a custom interactive Python debugger for use with --pdb."
      ],
      "next": []
    },
    {
      "name": "--pyargs",
      "tip": [
        "Try to interpret all arguments as Python packages."
      ]
    },
    {
      "name": "--pythonwarnings",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --pythonwarnings <WARNINGS>"
      ],
      "tip": [
        "Set which warnings to report, see -W option of Python itself."
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Decrease verbosity."
      ]
    },
    {
      "name": "--report-chars",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --report-chars <CHARS>"
      ],
      "tip": [
        "Show extra test summary info as specified by chars.",
        "Default: fE."
      ],
      "next": []
    },
    {
      "name": "--rootdir",
      "usage": [
        "--rootdir <ROOTDIR>"
      ],
      "tip": [
        "Define root directory for tests."
      ],
      "next": []
    },
    {
      "name": "--runxfail",
      "tip": [
        "Report the results of xfail tests as if they were not marked."
      ]
    },
    {
      "name": "--setup-only",
      "tip": [
        "Only setup fixtures, do not execute tests."
      ]
    },
    {
      "name": "--setup-plan",
      "tip": [
        "Show what fixtures and tests would be executed but don't execute anything."
      ]
    },
    {
      "name": "--setup-show",
      "tip": [
        "Show setup of fixtures while executing tests."
      ]
    },
    {
      "name": "--show-capture",
      "usage": [
        "--show-capture <SHOW>"
      ],
      "tip": [
        "Controls how captured stdout/stderr/log is shown on failed tests.",
        "Default: all."
      ],
      "next": [
        {
          "name": "all",
          "tip": [
            "Show all captured output.",
            "Default."
          ]
        },
        {
          "name": "log",
          "tip": [
            "Show captured log."
          ]
        },
        {
          "name": "no",
          "tip": [
            "Show no captured output."
          ]
        },
        {
          "name": "stderr",
          "tip": [
            "Show captured stderr."
          ]
        },
        {
          "name": "stdout",
          "tip": [
            "Show captured stdout."
          ]
        }
      ]
    },
    {
      "name": "--showlocals",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --showlocals"
      ],
      "tip": [
        "Show locals in tracebacks (disabled by default)."
      ]
    },
    {
      "name": "--stepwise",
      "alias": [
        "--sw"
      ],
      "usage": [
        "--sw, --stepwise"
      ],
      "tip": [
        "Exit on test failure and continue from last failing test next time."
      ]
    },
    {
      "name": "--stepwise-reset",
      "alias": [
        "--sw-reset"
      ],
      "usage": [
        "--sw-reset, --stepwise-reset"
      ],
      "tip": [
        "Resets stepwise state, restarting the stepwise workflow."
      ]
    },
    {
      "name": "--stepwise-skip",
      "alias": [
        "--sw-skip"
      ],
      "usage": [
        "--sw-skip, --stepwise-skip"
      ],
      "tip": [
        "Ignore the first failing test but stop on the next failing test."
      ]
    },
    {
      "name": "--strict",
      "tip": [
        "Enables the strict option."
      ]
    },
    {
      "name": "--strict-config",
      "tip": [
        "Enables the strict_config option."
      ]
    },
    {
      "name": "--strict-markers",
      "tip": [
        "Enables the strict_markers option."
      ]
    },
    {
      "name": "--tb",
      "usage": [
        "--tb <STYLE>"
      ],
      "tip": [
        "Traceback print mode."
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "Automatic traceback mode."
          ]
        },
        {
          "name": "line",
          "tip": [
            "Single-line traceback format."
          ]
        },
        {
          "name": "long",
          "tip": [
            "Long traceback format."
          ]
        },
        {
          "name": "native",
          "tip": [
            "Native traceback format."
          ]
        },
        {
          "name": "no",
          "tip": [
            "Disable tracebacks."
          ]
        },
        {
          "name": "short",
          "tip": [
            "Short traceback format."
          ]
        }
      ]
    },
    {
      "name": "--trace",
      "tip": [
        "Immediately break when running each test."
      ]
    },
    {
      "name": "--trace-config",
      "tip": [
        "Trace considerations of conftest.py files."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Increase verbosity."
      ]
    },
    {
      "name": "--verbosity",
      "usage": [
        "--verbosity <VERBOSE>"
      ],
      "tip": [
        "Set verbosity.",
        "Default: 0."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display pytest version and information about plugins."
      ]
    },
    {
      "name": "--xfail-tb",
      "tip": [
        "Show tracebacks for xfail (as long as --tb != no)."
      ]
    },
    {
      "name": "-k",
      "usage": [
        "-k <EXPRESSION>"
      ],
      "tip": [
        "Only run tests which match the given substring expression."
      ],
      "next": []
    },
    {
      "name": "-m",
      "usage": [
        "-m <MARKEXPR>"
      ],
      "tip": [
        "Only run tests matching given mark expression."
      ],
      "next": []
    },
    {
      "name": "-p",
      "usage": [
        "-p <NAME>"
      ],
      "tip": [
        "Early-load given plugin module name or entry point.",
        "Repeatable."
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "-s",
      "tip": [
        "Shortcut for --capture=no."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show help message and configuration info."
      ]
    }
  ]
}
