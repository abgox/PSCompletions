{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Politely refuse a login."
    ]
  },
  "option": [
    {
      "name": "--command",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --command <command>"
      ],
      "tip": [
        "Does nothing (for compatibility with su -c)."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
