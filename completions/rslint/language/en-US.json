{
  "meta": {
    "url": "https://rslint.rs",
    "description": [
      "A high-performance, ESLint-compatible linter for JavaScript and TypeScript."
    ]
  },
  "option": [
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config <PATH>"
      ],
      "tip": [
        "Specify which JS/TS module config file to use."
      ],
      "next": []
    },
    {
      "name": "--fix",
      "tip": [
        "Automatically fix problems."
      ]
    },
    {
      "name": "--force-color",
      "tip": [
        "Force colored output."
      ]
    },
    {
      "name": "--format",
      "usage": [
        "--format <FORMAT>"
      ],
      "tip": [
        "Output format."
      ],
      "next": [
        {
          "name": "default",
          "tip": [
            "Human-readable terminal output with colored code snippets and diagnostic highlighting."
          ]
        },
        {
          "name": "github",
          "tip": [
            "GitHub Actions workflow command format."
          ]
        },
        {
          "name": "gitlab",
          "tip": [
            "GitLab Code Quality report format."
          ]
        },
        {
          "name": "jsonline",
          "tip": [
            "One diagnostic per line as compact JSON."
          ]
        }
      ]
    },
    {
      "name": "--init",
      "tip": [
        "Generate a default config file, or migrate an existing JSON config to JS/TS."
      ]
    },
    {
      "name": "--max-warnings",
      "usage": [
        "--max-warnings <N>"
      ],
      "tip": [
        "Exit with error if warning count exceeds this number."
      ],
      "next": []
    },
    {
      "name": "--no-color",
      "tip": [
        "Disable colored output."
      ]
    },
    {
      "name": "--quiet",
      "tip": [
        "Report errors only, suppress warnings."
      ]
    },
    {
      "name": "--rule",
      "usage": [
        "--rule <RULE>"
      ],
      "tip": [
        "Override a rule's severity or options.",
        "Repeatable."
      ],
      "example": [
        "--rule 'no-console: off'"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--timing",
      "usage": [
        "--timing [<ALL|N>]"
      ],
      "tip": [
        "Print a per-rule timing table after the run."
      ],
      "next": [
        {
          "name": "all",
          "tip": [
            "Print a timing row for every rule.",
            "Default."
          ]
        }
      ]
    },
    {
      "name": "--type-check",
      "tip": [
        "Enable TypeScript semantic type checking."
      ]
    },
    {
      "name": "--type-check-only",
      "tip": [
        "Run TypeScript semantic type checking without lint rules."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show help information."
      ]
    }
  ]
}
