{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "打印 NAME，并去掉其所有开头的目录部分。"
    ]
  },
  "option": [
    {
      "name": "--multiple",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --multiple"
      ],
      "tip": [
        "支持多个参数并将每个参数视为一个 NAME"
      ]
    },
    {
      "name": "--suffix",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --suffix <SUFFIX>"
      ],
      "tip": [
        "移除末尾的 SUFFIX；隐含 -a"
      ],
      "next": []
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "每行输出以 NUL 结尾，而不是换行符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
