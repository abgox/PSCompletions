{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "Verify integrity of group files."
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display help message and exit."
      ]
    },
    {
      "name": "--read-only",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --read-only"
      ],
      "tip": [
        "Display errors and warnings but do not change files."
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "Apply changes in the CHROOT_DIR directory and use the configuration files from the CHROOT_DIR directory.",
        "Only absolute paths are supported."
      ],
      "next": []
    },
    {
      "name": "--silence-warnings",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --silence-warnings"
      ],
      "tip": [
        "Silence controversial/paranoid warnings."
      ]
    },
    {
      "name": "--sort",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sort"
      ],
      "tip": [
        "Sort entries in /etc/group and /etc/gshadow."
      ]
    }
  ]
}
