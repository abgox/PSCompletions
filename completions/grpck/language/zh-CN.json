{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "校验组文件的完整性。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--read-only",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --read-only"
      ],
      "tip": [
        "显示错误和警告，但不修改文件。"
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--silence-warnings",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --silence-warnings"
      ],
      "tip": [
        "抑制有争议或偏执的警告。"
      ]
    },
    {
      "name": "--sort",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sort"
      ],
      "tip": [
        "对 /etc/group 和 /etc/gshadow 中的条目排序。"
      ]
    }
  ]
}
