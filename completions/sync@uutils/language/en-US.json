{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Synchronize cached writes to persistent storage"
    ]
  },
  "option": [
    {
      "name": "--data",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --data"
      ],
      "tip": [
        "sync only file data, no unneeded metadata (Linux only)"
      ]
    },
    {
      "name": "--file-system",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file-system"
      ],
      "tip": [
        "sync the file systems that contain the files (Linux and Windows only)"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
