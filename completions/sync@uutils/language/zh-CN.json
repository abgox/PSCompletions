{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将缓存的写入同步到持久存储"
    ]
  },
  "option": [
    {
      "name": "--data",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --data"
      ],
      "tip": [
        "仅同步文件数据，不同步多余的元数据（仅 Linux）"
      ]
    },
    {
      "name": "--file-system",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file-system"
      ],
      "tip": [
        "同步包含这些文件的文件系统（仅 Linux 和 Windows）"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
