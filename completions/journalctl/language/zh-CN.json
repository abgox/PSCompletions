{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "查询日志。"
    ]
  },
  "option": [
    {
      "name": "--after-cursor",
      "usage": [
        "--after-cursor=CURSOR"
      ],
      "tip": [
        "显示指定游标之后的条目。"
      ],
      "next": []
    },
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "显示所有字段，包括长字段和不可打印字段。"
      ]
    },
    {
      "name": "--boot",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --boot[=ID]"
      ],
      "tip": [
        "显示当前启动或指定启动。"
      ],
      "next": []
    },
    {
      "name": "--case-sensitive",
      "usage": [
        "--case-sensitive[=BOOL]"
      ],
      "tip": [
        "强制区分或不区分大小写匹配。"
      ],
      "next": []
    },
    {
      "name": "--catalog",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --catalog"
      ],
      "tip": [
        "在可用时添加消息说明。"
      ]
    },
    {
      "name": "--cursor",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --cursor=CURSOR"
      ],
      "tip": [
        "从指定游标开始显示条目。"
      ],
      "next": []
    },
    {
      "name": "--cursor-file",
      "usage": [
        "--cursor-file=FILE"
      ],
      "tip": [
        "显示 FILE 中游标之后的条目并更新 FILE。"
      ],
      "next": []
    },
    {
      "name": "--directory",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --directory=PATH"
      ],
      "tip": [
        "显示目录中的日志文件。"
      ],
      "next": []
    },
    {
      "name": "--disk-usage",
      "tip": [
        "显示所有日志文件的总磁盘用量。"
      ]
    },
    {
      "name": "--dmesg",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --dmesg"
      ],
      "tip": [
        "显示当前启动的内核消息日志。"
      ]
    },
    {
      "name": "--dump-catalog",
      "tip": [
        "显示消息目录中的条目。"
      ]
    },
    {
      "name": "--exclude-identifier",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --exclude-identifier=STRING"
      ],
      "tip": [
        "隐藏具有指定 syslog 标识符的条目。"
      ],
      "next": []
    },
    {
      "name": "--facility",
      "usage": [
        "--facility=FACILITY..."
      ],
      "tip": [
        "显示具有指定设施的条目。"
      ],
      "next": []
    },
    {
      "name": "--field",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --field=FIELD"
      ],
      "tip": [
        "列出指定字段的所有取值。"
      ],
      "next": []
    },
    {
      "name": "--fields",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --fields"
      ],
      "tip": [
        "列出当前使用的所有字段名。"
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --file=PATH"
      ],
      "tip": [
        "显示日志文件。"
      ],
      "next": []
    },
    {
      "name": "--flush",
      "tip": [
        "将所有日志数据从 /run 刷新到 /var。"
      ]
    },
    {
      "name": "--follow",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --follow"
      ],
      "tip": [
        "跟踪日志。"
      ]
    },
    {
      "name": "--force",
      "tip": [
        "配合 --setup-keys 覆盖 FSS 密钥对。"
      ]
    },
    {
      "name": "--grep",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --grep=PATTERN"
      ],
      "tip": [
        "显示 MESSAGE 匹配 PATTERN 的条目。"
      ],
      "next": []
    },
    {
      "name": "--header",
      "tip": [
        "显示日志头信息。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助文本。"
      ]
    },
    {
      "name": "--identifier",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --identifier=STRING"
      ],
      "tip": [
        "显示具有指定 syslog 标识符的条目。"
      ],
      "next": []
    },
    {
      "name": "--image",
      "usage": [
        "--image=PATH"
      ],
      "tip": [
        "将磁盘镜像作为文件系统根操作。"
      ],
      "next": []
    },
    {
      "name": "--image-policy",
      "usage": [
        "--image-policy=POLICY"
      ],
      "tip": [
        "指定磁盘镜像解析策略。"
      ],
      "next": []
    },
    {
      "name": "--interval",
      "usage": [
        "--interval=TIME"
      ],
      "tip": [
        "更改 FSS 密封密钥的时间间隔。"
      ],
      "next": []
    },
    {
      "name": "--invocation",
      "usage": [
        "--invocation=ID"
      ],
      "tip": [
        "显示匹配调用 ID 的日志。"
      ],
      "next": []
    },
    {
      "name": "--lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --lines[=[+]INTEGER]"
      ],
      "tip": [
        "要显示的日志条目数。"
      ],
      "next": []
    },
    {
      "name": "--list-boots",
      "tip": [
        "显示已记录启动的简要信息。"
      ]
    },
    {
      "name": "--list-catalog",
      "tip": [
        "显示目录中的所有消息 ID。"
      ]
    },
    {
      "name": "--list-invocations",
      "tip": [
        "显示指定单元的调用 ID。"
      ]
    },
    {
      "name": "--list-namespaces",
      "tip": [
        "显示日志命名空间列表。"
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "对本机容器操作。"
      ],
      "next": []
    },
    {
      "name": "--merge",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --merge"
      ],
      "tip": [
        "显示所有可用日志中的条目。"
      ]
    },
    {
      "name": "--namespace",
      "usage": [
        "--namespace=NAMESPACE"
      ],
      "tip": [
        "显示指定日志命名空间的日志数据。"
      ],
      "next": []
    },
    {
      "name": "--no-full",
      "tip": [
        "省略字段。"
      ]
    },
    {
      "name": "--no-hostname",
      "tip": [
        "不输出主机名字段。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--no-tail",
      "tip": [
        "显示所有行，即使在跟踪模式下。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output=STRING"
      ],
      "tip": [
        "更改日志输出模式。",
        "可能值: short, short-precise, short-iso, short-iso-precise, short-full, short-monotonic, short-unix, verbose, export, json, json-pretty, json-sse, json-seq, cat, with-unit"
      ],
      "next": [
        {
          "name": "cat"
        },
        {
          "name": "export"
        },
        {
          "name": "json"
        },
        {
          "name": "json-pretty"
        },
        {
          "name": "json-seq"
        },
        {
          "name": "json-sse"
        },
        {
          "name": "short"
        },
        {
          "name": "short-full"
        },
        {
          "name": "short-iso"
        },
        {
          "name": "short-iso-precise"
        },
        {
          "name": "short-monotonic"
        },
        {
          "name": "short-precise"
        },
        {
          "name": "short-unix"
        },
        {
          "name": "verbose"
        },
        {
          "name": "with-unit"
        }
      ]
    },
    {
      "name": "--output-fields",
      "usage": [
        "--output-fields=LIST"
      ],
      "tip": [
        "选择在 verbose/export/json 模式下打印的字段。"
      ],
      "next": []
    },
    {
      "name": "--pager-end",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --pager-end"
      ],
      "tip": [
        "立即跳转到分页器末尾。"
      ]
    },
    {
      "name": "--priority",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --priority=RANGE"
      ],
      "tip": [
        "显示指定优先级范围内的条目。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "不显示信息消息和权限警告。"
      ]
    },
    {
      "name": "--relinquish-var",
      "tip": [
        "停止记录到磁盘，改为记录到临时文件系统。"
      ]
    },
    {
      "name": "--reverse",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reverse"
      ],
      "tip": [
        "最先显示最新条目。"
      ]
    },
    {
      "name": "--root",
      "usage": [
        "--root=PATH"
      ],
      "tip": [
        "在替代文件系统根上操作。"
      ],
      "next": []
    },
    {
      "name": "--rotate",
      "tip": [
        "请求立即轮转日志文件。"
      ]
    },
    {
      "name": "--setup-keys",
      "tip": [
        "生成新的 FSS 密钥对。"
      ]
    },
    {
      "name": "--show-cursor",
      "tip": [
        "在所有条目之后打印游标。"
      ]
    },
    {
      "name": "--since",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --since=DATE"
      ],
      "tip": [
        "显示不早于指定日期的条目。"
      ],
      "next": []
    },
    {
      "name": "--smart-relinquish-var",
      "tip": [
        "类似，但日志目录位于根挂载时不做操作。"
      ]
    },
    {
      "name": "--sync",
      "tip": [
        "将未写入的日志消息同步到磁盘。"
      ]
    },
    {
      "name": "--system",
      "tip": [
        "显示系统日志。"
      ]
    },
    {
      "name": "--truncate-newline",
      "tip": [
        "在第一个换行符处截断条目。"
      ]
    },
    {
      "name": "--unit",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unit=UNIT"
      ],
      "tip": [
        "显示指定单元的日志。"
      ],
      "next": []
    },
    {
      "name": "--until",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --until=DATE"
      ],
      "tip": [
        "显示不晚于指定日期的条目。"
      ],
      "next": []
    },
    {
      "name": "--update-catalog",
      "tip": [
        "更新消息目录数据库。"
      ]
    },
    {
      "name": "--user",
      "tip": [
        "显示当前用户的用户日志。"
      ]
    },
    {
      "name": "--user-unit",
      "usage": [
        "--user-unit=UNIT"
      ],
      "tip": [
        "显示指定用户单元的日志。"
      ],
      "next": []
    },
    {
      "name": "--utc",
      "tip": [
        "以协调世界时（UTC）表示时间。"
      ]
    },
    {
      "name": "--vacuum-files",
      "usage": [
        "--vacuum-files=INT"
      ],
      "tip": [
        "仅保留指定数量的日志文件。"
      ],
      "next": []
    },
    {
      "name": "--vacuum-size",
      "usage": [
        "--vacuum-size=BYTES"
      ],
      "tip": [
        "将磁盘用量降到指定大小以下。"
      ],
      "next": []
    },
    {
      "name": "--vacuum-time",
      "usage": [
        "--vacuum-time=TIME"
      ],
      "tip": [
        "删除早于指定时间的日志文件。"
      ],
      "next": []
    },
    {
      "name": "--verify",
      "tip": [
        "校验日志文件一致性。"
      ]
    },
    {
      "name": "--verify-key",
      "usage": [
        "--verify-key=KEY"
      ],
      "tip": [
        "指定 FSS 验证密钥。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "-I",
      "tip": [
        "显示单元最近一次调用的日志。"
      ]
    }
  ]
}
