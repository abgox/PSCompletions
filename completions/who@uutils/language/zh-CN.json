{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "打印当前登录用户的信息"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "等同于 -b -d --login -p -r -t -T -u"
      ]
    },
    {
      "name": "--boot",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --boot"
      ],
      "tip": [
        "上次系统启动时间"
      ]
    },
    {
      "name": "--count",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --count"
      ],
      "tip": [
        "所有登录名及已登录用户数"
      ]
    },
    {
      "name": "--dead",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --dead"
      ],
      "tip": [
        "打印已死进程"
      ]
    },
    {
      "name": "--heading",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --heading"
      ],
      "tip": [
        "打印列标题行"
      ]
    },
    {
      "name": "--login",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --login"
      ],
      "tip": [
        "打印系统登录进程"
      ]
    },
    {
      "name": "--lookup",
      "tip": [
        "尝试通过 DNS 规范化主机名"
      ]
    },
    {
      "name": "--mesg",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --mesg"
      ],
      "tip": [
        "以 +、- 或 ? 附加用户消息状态"
      ]
    },
    {
      "name": "--process",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --process"
      ],
      "tip": [
        "打印 init 派生的活动进程"
      ]
    },
    {
      "name": "--runlevel",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --runlevel"
      ],
      "tip": [
        "打印当前运行级别"
      ]
    },
    {
      "name": "--short",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --short"
      ],
      "tip": [
        "只打印名称、线路和时间（默认）"
      ]
    },
    {
      "name": "--time",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --time"
      ],
      "tip": [
        "打印上次系统时钟更改"
      ]
    },
    {
      "name": "--users",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --users"
      ],
      "tip": [
        "列出已登录用户"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-m",
      "tip": [
        "仅显示与 stdin 关联的主机名和用户"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
