{
  "meta": {
    "url": "https://github.com/microsoft/sudo",
    "description": [
      "Windows 版 Sudo，以管理员身份运行命令。"
    ]
  },
  "next": [
    {
      "name": "config",
      "tip": [
        "获取 Sudo 的当前配置信息。"
      ],
      "option": [
        {
          "name": "--enable",
          "usage": [
            "--enable [<ENABLE>]"
          ],
          "tip": [
            "设置 Sudo 模式。",
            "可能值：disable, enable, forceNewWindow, disableInput, normal, default"
          ],
          "next": [
            {
              "name": "default"
            },
            {
              "name": "disable"
            },
            {
              "name": "disableInput"
            },
            {
              "name": "enable"
            },
            {
              "name": "forceNewWindow"
            },
            {
              "name": "normal"
            }
          ]
        }
      ]
    },
    {
      "name": "help",
      "tip": [
        "打印此消息或给定子命令的帮助。"
      ]
    },
    {
      "name": "run",
      "usage": [
        "run [COMMANDLINE]..."
      ],
      "tip": [
        "以管理员身份运行命令。"
      ]
    }
  ],
  "option": [
    {
      "name": "--chdir",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --chdir <CHDIR>"
      ],
      "tip": [
        "在运行命令之前更改工作目录。"
      ],
      "next": []
    },
    {
      "name": "--disable-input",
      "tip": [
        "在当前终端中运行，已禁用对目标应用程序的输入。"
      ]
    },
    {
      "name": "--inline",
      "tip": [
        "在当前终端中运行。"
      ]
    },
    {
      "name": "--new-window",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --new-window"
      ],
      "tip": [
        "使用命令的新窗口。"
      ]
    },
    {
      "name": "--preserve-env",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --preserve-env"
      ],
      "tip": [
        "将当前环境变量传递给命令。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本。"
      ]
    }
  ]
}
