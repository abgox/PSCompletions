{
  "meta": {
    "url": "https://github.com/microsoft/sudo",
    "description": [
      "Sudo for Windows, run a command as admin."
    ]
  },
  "next": [
    {
      "name": "config",
      "tip": [
        "Get current configuration information of sudo."
      ],
      "option": [
        {
          "name": "--enable",
          "usage": [
            "--enable [<ENABLE>]"
          ],
          "tip": [
            "Set the sudo mode.",
            "Possible values: disable, enable, forceNewWindow, disableInput, normal, default"
          ],
          "next": [
            {
              "name": "default"
            },
            {
              "name": "disable"
            },
            {
              "name": "disableInput"
            },
            {
              "name": "enable"
            },
            {
              "name": "forceNewWindow"
            },
            {
              "name": "normal"
            }
          ]
        }
      ]
    },
    {
      "name": "help",
      "tip": [
        "Print this message or the help of the given subcommand(s)."
      ]
    },
    {
      "name": "run",
      "usage": [
        "run [COMMANDLINE]..."
      ],
      "tip": [
        "Run a command as admin."
      ]
    }
  ],
  "option": [
    {
      "name": "--chdir",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --chdir <CHDIR>"
      ],
      "tip": [
        "Change the working directory before running the command."
      ],
      "next": []
    },
    {
      "name": "--disable-input",
      "tip": [
        "Run in the current terminal, with input to the target application disabled."
      ]
    },
    {
      "name": "--inline",
      "tip": [
        "Run in the current terminal."
      ]
    },
    {
      "name": "--new-window",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --new-window"
      ],
      "tip": [
        "Use a new window for the command."
      ]
    },
    {
      "name": "--preserve-env",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --preserve-env"
      ],
      "tip": [
        "Pass the current environment variables to the command."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version."
      ]
    }
  ]
}
