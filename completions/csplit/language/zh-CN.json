{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "按上下文行将文件分割为多个部分。"
    ]
  },
  "option": [
    {
      "name": "--digits",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --digits <DIGITS>"
      ],
      "tip": [
        "使用指定的位数而不是 2"
      ],
      "next": []
    },
    {
      "name": "--elide-empty-files",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --elide-empty-files"
      ],
      "tip": [
        "删除空的输出文件"
      ]
    },
    {
      "name": "--keep-files",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --keep-files"
      ],
      "tip": [
        "出错时不删除输出文件"
      ]
    },
    {
      "name": "--prefix",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --prefix <PREFIX>"
      ],
      "tip": [
        "使用 PREFIX 而不是 'xx'"
      ],
      "next": []
    },
    {
      "name": "--silent",
      "alias": [
        "--quiet",
        "-q",
        "-s"
      ],
      "usage": [
        "-q, -s, --quiet, --silent"
      ],
      "tip": [
        "不打印输出文件大小的计数"
      ]
    },
    {
      "name": "--suffix-format",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --suffix-format <FORMAT>"
      ],
      "tip": [
        "使用 sprintf FORMAT 而不是 %02d"
      ],
      "next": []
    },
    {
      "name": "--suppress-matched",
      "tip": [
        "不输出匹配 PATTERN 的行"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
