{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Split a file into sections determined by context lines."
    ]
  },
  "option": [
    {
      "name": "--digits",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --digits <DIGITS>"
      ],
      "tip": [
        "use specified number of digits instead of 2"
      ],
      "next": []
    },
    {
      "name": "--elide-empty-files",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --elide-empty-files"
      ],
      "tip": [
        "remove empty output files"
      ]
    },
    {
      "name": "--keep-files",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --keep-files"
      ],
      "tip": [
        "do not remove output files on errors"
      ]
    },
    {
      "name": "--prefix",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --prefix <PREFIX>"
      ],
      "tip": [
        "use PREFIX instead of 'xx'"
      ],
      "next": []
    },
    {
      "name": "--silent",
      "alias": [
        "--quiet",
        "-s"
      ],
      "usage": [
        "-s, --quiet, --silent"
      ],
      "tip": [
        "do not print counts of output file sizes"
      ]
    },
    {
      "name": "--suffix-format",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --suffix-format <FORMAT>"
      ],
      "tip": [
        "use sprintf FORMAT instead of %02d"
      ],
      "next": []
    },
    {
      "name": "--suppress-matched",
      "tip": [
        "suppress the lines matching PATTERN"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show the help."
      ]
    }
  ]
}
