{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "启用用于分页和交换的设备和文件。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "启用 /etc/fstab 中的所有交换区。"
      ]
    },
    {
      "name": "--bytes",
      "tip": [
        "在 --show 输出中以字节显示交换区大小。"
      ]
    },
    {
      "name": "--discard",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --discard[=<policy>]"
      ],
      "tip": [
        "如果设备支持，启用交换区丢弃。",
        "可能值: once, pages",
        "默认启用两种丢弃类型。"
      ],
      "next": [
        {
          "name": "once"
        },
        {
          "name": "pages"
        }
      ]
    },
    {
      "name": "--fixpgsz",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fixpgsz"
      ],
      "tip": [
        "如有必要，重新初始化交换空间。"
      ]
    },
    {
      "name": "--fstab",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --fstab <path>"
      ],
      "tip": [
        "使用替代 /etc/fstab 的文件。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--ifexists",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --ifexists"
      ],
      "tip": [
        "静默跳过不存在的设备。"
      ]
    },
    {
      "name": "--noheadings",
      "tip": [
        "不打印表头（与 --show 一起使用）。"
      ]
    },
    {
      "name": "--options",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --options <list>"
      ],
      "tip": [
        "逗号分隔的交换选项列表。"
      ],
      "next": []
    },
    {
      "name": "--priority",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --priority <prio>"
      ],
      "tip": [
        "指定交换设备的优先级。"
      ],
      "next": []
    },
    {
      "name": "--raw",
      "tip": [
        "使用原始输出格式（与 --show 一起使用）。"
      ]
    },
    {
      "name": "--show",
      "usage": [
        "--show[=<columns>]"
      ],
      "tip": [
        "以可定义的表格显示摘要。"
      ],
      "separator": ",",
      "next": [
        {
          "name": "LABEL",
          "tip": [
            "交换区标签。"
          ]
        },
        {
          "name": "NAME",
          "tip": [
            "设备文件或分区路径。"
          ]
        },
        {
          "name": "PRIO",
          "tip": [
            "交换优先级。"
          ]
        },
        {
          "name": "SIZE",
          "tip": [
            "交换区大小。"
          ]
        },
        {
          "name": "TYPE",
          "tip": [
            "设备类型。"
          ]
        },
        {
          "name": "USED",
          "tip": [
            "已使用字节数。"
          ]
        },
        {
          "name": "UUID",
          "tip": [
            "交换区 UUID。"
          ]
        }
      ]
    },
    {
      "name": "--summary",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --summary"
      ],
      "tip": [
        "显示已使用交换设备的摘要。(已弃用)"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "详细模式。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
