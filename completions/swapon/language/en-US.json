{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Enable devices and files for paging and swapping."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Enable all swaps from /etc/fstab."
      ]
    },
    {
      "name": "--bytes",
      "tip": [
        "Display swap size in bytes in --show output."
      ]
    },
    {
      "name": "--discard",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --discard[=<policy>]"
      ],
      "tip": [
        "Enable swap discards, if supported by device.",
        "Possible values: once, pages",
        "Both discard types are enabled by default."
      ],
      "next": [
        {
          "name": "once"
        },
        {
          "name": "pages"
        }
      ]
    },
    {
      "name": "--fixpgsz",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fixpgsz"
      ],
      "tip": [
        "Reinitialize the swap space if necessary."
      ]
    },
    {
      "name": "--fstab",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --fstab <path>"
      ],
      "tip": [
        "Alternative file to /etc/fstab."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--ifexists",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --ifexists"
      ],
      "tip": [
        "Silently skip devices that do not exist."
      ]
    },
    {
      "name": "--noheadings",
      "tip": [
        "Don't print table heading (with --show)."
      ]
    },
    {
      "name": "--options",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --options <list>"
      ],
      "tip": [
        "Comma-separated list of swap options."
      ],
      "next": []
    },
    {
      "name": "--priority",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --priority <prio>"
      ],
      "tip": [
        "Specify the priority of the swap device."
      ],
      "next": []
    },
    {
      "name": "--raw",
      "tip": [
        "Use the raw output format (with --show)."
      ]
    },
    {
      "name": "--show",
      "usage": [
        "--show[=<columns>]"
      ],
      "tip": [
        "Display summary in definable table."
      ],
      "separator": ",",
      "next": [
        {
          "name": "LABEL",
          "tip": [
            "Swap label."
          ]
        },
        {
          "name": "NAME",
          "tip": [
            "Device file or partition path."
          ]
        },
        {
          "name": "PRIO",
          "tip": [
            "Swap priority."
          ]
        },
        {
          "name": "SIZE",
          "tip": [
            "Size of the swap area."
          ]
        },
        {
          "name": "TYPE",
          "tip": [
            "Type of the device."
          ]
        },
        {
          "name": "USED",
          "tip": [
            "Bytes in use."
          ]
        },
        {
          "name": "UUID",
          "tip": [
            "Swap UUID."
          ]
        }
      ]
    },
    {
      "name": "--summary",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --summary"
      ],
      "tip": [
        "Display summary about used swap devices. (deprecated)"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Verbose mode."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
