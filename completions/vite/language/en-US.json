{
  "meta": {
    "url": "https://github.com/vitejs/vite",
    "description": [
      "Next generation frontend tooling."
    ]
  },
  "next": [
    {
      "name": "build",
      "tip": [
        "Build for production."
      ],
      "option": [
        {
          "name": "--app",
          "tip": [
            "Same as `builder: {}`."
          ]
        },
        {
          "name": "--assetsDir",
          "usage": [
            "--assetsDir <dir>"
          ],
          "tip": [
            "Directory under outDir to place assets in.",
            "Default: assets"
          ],
          "next": []
        },
        {
          "name": "--assetsInlineLimit",
          "usage": [
            "--assetsInlineLimit <number>"
          ],
          "tip": [
            "Static asset base64 inline threshold in bytes.",
            "Default: 4096"
          ],
          "next": []
        },
        {
          "name": "--emptyOutDir",
          "tip": [
            "Force empty outDir when it's outside of root."
          ]
        },
        {
          "name": "--manifest",
          "usage": [
            "--manifest [name]"
          ],
          "tip": [
            "Emit build manifest json."
          ],
          "next": []
        },
        {
          "name": "--minify",
          "usage": [
            "--minify [minifier]"
          ],
          "tip": [
            "Enable/disable minification, or specify minifier to use.",
            "Possible values: true, false, 'oxc', 'terser', 'esbuild'",
            "Default: oxc"
          ],
          "next": [
            {
              "name": "esbuild",
              "tip": [
                "Use esbuild minifier."
              ]
            },
            {
              "name": "false",
              "tip": [
                "Disable minification."
              ]
            },
            {
              "name": "oxc",
              "tip": [
                "Use oxc minifier."
              ]
            },
            {
              "name": "terser",
              "tip": [
                "Use terser minifier."
              ]
            },
            {
              "name": "true",
              "tip": [
                "Enable minification."
              ]
            }
          ]
        },
        {
          "name": "--outDir",
          "usage": [
            "--outDir <dir>"
          ],
          "tip": [
            "Output directory.",
            "Default: dist"
          ],
          "next": []
        },
        {
          "name": "--sourcemap",
          "usage": [
            "--sourcemap [output]"
          ],
          "tip": [
            "Output source maps for build.",
            "Possible values: true, false, 'inline', 'hidden'",
            "Default: false"
          ],
          "next": [
            {
              "name": "false",
              "tip": [
                "Disable source maps."
              ]
            },
            {
              "name": "hidden",
              "tip": [
                "Generate separate source maps."
              ]
            },
            {
              "name": "inline",
              "tip": [
                "Inline source maps."
              ]
            },
            {
              "name": "true",
              "tip": [
                "Enable source maps."
              ]
            }
          ]
        },
        {
          "name": "--ssr",
          "usage": [
            "--ssr [entry]"
          ],
          "tip": [
            "Build specified entry for server-side rendering."
          ],
          "next": []
        },
        {
          "name": "--ssrManifest",
          "usage": [
            "--ssrManifest [name]"
          ],
          "tip": [
            "Emit ssr manifest json."
          ],
          "next": []
        },
        {
          "name": "--target",
          "usage": [
            "--target <target>"
          ],
          "tip": [
            "Transpile target.",
            "Default: 'baseline-widely-available'"
          ],
          "next": []
        },
        {
          "name": "--watch",
          "alias": [
            "-w"
          ],
          "usage": [
            "-w, --watch"
          ],
          "tip": [
            "Rebuilds when modules have changed on disk."
          ]
        }
      ]
    },
    {
      "name": "optimize",
      "tip": [
        "Pre-bundle dependencies (deprecated, runs automatically)."
      ]
    },
    {
      "name": "preview",
      "tip": [
        "Locally preview production build."
      ],
      "option": [
        {
          "name": "--host",
          "usage": [
            "--host [host]"
          ],
          "tip": [
            "Specify hostname."
          ],
          "next": []
        },
        {
          "name": "--open",
          "usage": [
            "--open [path]"
          ],
          "tip": [
            "Open browser on startup."
          ],
          "next": []
        },
        {
          "name": "--outDir",
          "usage": [
            "--outDir <dir>"
          ],
          "tip": [
            "Output directory.",
            "Default: dist"
          ],
          "next": []
        },
        {
          "name": "--port",
          "usage": [
            "--port <port>"
          ],
          "tip": [
            "Specify port."
          ],
          "next": [
            {
              "name": "443"
            },
            {
              "name": "80"
            },
            {
              "name": "8080"
            }
          ]
        },
        {
          "name": "--strictPort",
          "tip": [
            "Exit if specified port is already in use."
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--base",
      "usage": [
        "--base <path>"
      ],
      "tip": [
        "Public base path.",
        "Default: /"
      ],
      "next": []
    },
    {
      "name": "--clearScreen",
      "tip": [
        "Allow/disable clear screen when logging."
      ]
    },
    {
      "name": "--configLoader",
      "usage": [
        "--configLoader <loader>"
      ],
      "tip": [
        "Use 'bundle' to bundle the config with Rolldown, or 'runner' (experimental) to process it on the fly, or 'native' (experimental) to load using the native runtime.",
        "Default: bundle"
      ],
      "next": [
        {
          "name": "bundle",
          "tip": [
            "Bundle config with Rolldown."
          ]
        },
        {
          "name": "native",
          "tip": [
            "Load using native runtime (experimental)."
          ]
        },
        {
          "name": "runner",
          "tip": [
            "Process config on the fly (experimental)."
          ]
        }
      ]
    },
    {
      "name": "--cors",
      "tip": [
        "Enable CORS."
      ]
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug [feat]"
      ],
      "tip": [
        "Show debug logs."
      ],
      "next": []
    },
    {
      "name": "--filter",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --filter <filter>"
      ],
      "tip": [
        "Filter debug logs."
      ],
      "next": []
    },
    {
      "name": "--force",
      "tip": [
        "Force the optimizer to ignore the cache and re-bundle."
      ]
    },
    {
      "name": "--host",
      "usage": [
        "--host [host]"
      ],
      "tip": [
        "Specify hostname."
      ],
      "next": []
    },
    {
      "name": "--logLevel",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --logLevel <level>"
      ],
      "tip": [
        "Log level.",
        "Possible values: info, warn, error, silent"
      ],
      "next": [
        {
          "name": "error",
          "tip": [
            "Error level logging."
          ]
        },
        {
          "name": "info",
          "tip": [
            "Info level logging."
          ]
        },
        {
          "name": "silent",
          "tip": [
            "Silent logging."
          ]
        },
        {
          "name": "warn",
          "tip": [
            "Warning level logging."
          ]
        }
      ]
    },
    {
      "name": "--open",
      "usage": [
        "--open [path]"
      ],
      "tip": [
        "Open browser on startup."
      ],
      "next": []
    },
    {
      "name": "--port",
      "usage": [
        "--port <port>"
      ],
      "tip": [
        "Specify port."
      ],
      "next": [
        {
          "name": "443"
        },
        {
          "name": "80"
        },
        {
          "name": "8080"
        }
      ]
    },
    {
      "name": "--strictPort",
      "tip": [
        "Exit if specified port is already in use."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Display version number."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config <file>"
      ],
      "tip": [
        "Use specified config file."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this message."
      ]
    },
    {
      "name": "--mode",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mode <mode>"
      ],
      "tip": [
        "Set env mode."
      ],
      "next": []
    }
  ]
}
