{
  "meta": {
    "url": "https://github.com/bootandy/dust",
    "description": [
      "Like du but more intuitive."
    ]
  },
  "option": [
    {
      "name": "--apparent-size",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --apparent-size"
      ],
      "tip": [
        "Use file length instead of blocks"
      ]
    },
    {
      "name": "--atime",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --atime <ATIME>"
      ],
      "tip": [
        "Like --mtime, but based on file access time"
      ],
      "next": []
    },
    {
      "name": "--bars-on-right",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --bars-on-right"
      ],
      "tip": [
        "Percent bars moved to right side of screen"
      ]
    },
    {
      "name": "--collapse",
      "usage": [
        "--collapse <COLLAPSE>"
      ],
      "tip": [
        "Keep these directories collapsed"
      ],
      "next": []
    },
    {
      "name": "--config",
      "usage": [
        "--config <FILE>"
      ],
      "tip": [
        "Specify a config file to use"
      ],
      "next": []
    },
    {
      "name": "--ctime",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --ctime <CTIME>"
      ],
      "tip": [
        "Like --mtime, but based on file change time"
      ],
      "next": []
    },
    {
      "name": "--depth",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --depth <DEPTH>"
      ],
      "tip": [
        "Depth to show"
      ],
      "next": []
    },
    {
      "name": "--dereference-links",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --dereference-links"
      ],
      "tip": [
        "Dereference sym links, treat sym links as directories and go into them"
      ]
    },
    {
      "name": "--file-types",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --file-types"
      ],
      "tip": [
        "Show only these file types"
      ]
    },
    {
      "name": "--filecount",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --filecount"
      ],
      "tip": [
        "Directory size is number of child files instead of disk size"
      ]
    },
    {
      "name": "--files-from",
      "usage": [
        "--files-from <FILES_FROM>"
      ],
      "tip": [
        "Read newline-terminated paths from FILE (use - for stdin)"
      ],
      "next": []
    },
    {
      "name": "--files0-from",
      "usage": [
        "--files0-from <FILES0_FROM>"
      ],
      "tip": [
        "Read NUL-terminated paths from FILE (use - for stdin)"
      ],
      "next": []
    },
    {
      "name": "--filetime",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --filetime <FILETIME>"
      ],
      "tip": [
        "Directory size is max filetime of child files instead of disk size"
      ],
      "next": [
        {
          "name": "a",
          "tip": [
            "Last accessed time"
          ]
        },
        {
          "name": "c",
          "tip": [
            "Last changed time"
          ]
        },
        {
          "name": "m",
          "tip": [
            "Last modified time"
          ]
        }
      ]
    },
    {
      "name": "--filter",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --filter <REGEX>"
      ],
      "tip": [
        "Only include filepaths matching this regex"
      ],
      "next": []
    },
    {
      "name": "--force-colors",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --force-colors"
      ],
      "tip": [
        "Force colors print"
      ]
    },
    {
      "name": "--full-paths",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --full-paths"
      ],
      "tip": [
        "Subdirectories will not have their path shortened"
      ]
    },
    {
      "name": "--ignore-all-in-file",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --ignore-all-in-file <FILE>"
      ],
      "tip": [
        "Exclude file or directory with a regex matching that listed in this file"
      ],
      "next": []
    },
    {
      "name": "--ignore-directory",
      "alias": [
        "-X"
      ],
      "usage": [
        "-X, --ignore-directory <PATH>"
      ],
      "tip": [
        "Exclude any file or directory with this path"
      ],
      "next": []
    },
    {
      "name": "--ignore-hidden",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-hidden"
      ],
      "tip": [
        "Do not display hidden files"
      ]
    },
    {
      "name": "--invert-filter",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --invert-filter <REGEX>"
      ],
      "tip": [
        "Exclude filepaths matching this regex"
      ],
      "next": []
    },
    {
      "name": "--limit-filesystem",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --limit-filesystem"
      ],
      "tip": [
        "Only count the files and directories on the same filesystem as the supplied directory"
      ]
    },
    {
      "name": "--min-size",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --min-size <MIN_SIZE>"
      ],
      "tip": [
        "Minimum size file to include in output"
      ],
      "next": []
    },
    {
      "name": "--mtime",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --mtime <MTIME>"
      ],
      "tip": [
        "+/-n matches files modified more/less than n days ago"
      ],
      "next": []
    },
    {
      "name": "--no-colors",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --no-colors"
      ],
      "tip": [
        "No colors will be printed (useful for commands like watch)"
      ]
    },
    {
      "name": "--no-percent-bars",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --no-percent-bars"
      ],
      "tip": [
        "No percent bars or percentages will be displayed"
      ]
    },
    {
      "name": "--no-progress",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --no-progress"
      ],
      "tip": [
        "Disable the progress indication"
      ]
    },
    {
      "name": "--number-of-lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --number-of-lines <NUMBER>"
      ],
      "tip": [
        "Display the n largest entries (default is terminal height)"
      ],
      "next": []
    },
    {
      "name": "--only-dir",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --only-dir"
      ],
      "tip": [
        "Only directories will be displayed"
      ]
    },
    {
      "name": "--only-file",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --only-file"
      ],
      "tip": [
        "Only files will be displayed (finds your largest files)"
      ]
    },
    {
      "name": "--output-format",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output-format <FORMAT>"
      ],
      "tip": [
        "Changes output display size"
      ],
      "next": [
        {
          "name": "b",
          "tip": [
            "Byte (B)"
          ]
        },
        {
          "name": "g",
          "tip": [
            "Gibibyte (GiB)"
          ]
        },
        {
          "name": "gb",
          "tip": [
            "Gigabyte (GB)"
          ]
        },
        {
          "name": "k",
          "tip": [
            "Kibibyte (KiB)"
          ]
        },
        {
          "name": "kb",
          "tip": [
            "Kilobyte (kB)"
          ]
        },
        {
          "name": "m",
          "tip": [
            "Mebibyte (MiB)"
          ]
        },
        {
          "name": "mb",
          "tip": [
            "Megabyte (MB)"
          ]
        },
        {
          "name": "si",
          "tip": [
            "SI prefix (powers of 1000)"
          ]
        },
        {
          "name": "t",
          "tip": [
            "Tebibyte (TiB)"
          ]
        },
        {
          "name": "tb",
          "tip": [
            "Terabyte (TB)"
          ]
        }
      ]
    },
    {
      "name": "--output-json",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --output-json"
      ],
      "tip": [
        "Output the directory tree as json to the current directory"
      ]
    },
    {
      "name": "--print-errors",
      "tip": [
        "Print path with errors"
      ]
    },
    {
      "name": "--reverse",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reverse"
      ],
      "tip": [
        "Print tree upside down (biggest highest)"
      ]
    },
    {
      "name": "--screen-reader",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --screen-reader"
      ],
      "tip": [
        "For screen readers, removes bars and adds depth level column"
      ]
    },
    {
      "name": "--skip-total",
      "tip": [
        "No total row will be displayed"
      ]
    },
    {
      "name": "--stack-size",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --stack-size <STACK_SIZE>"
      ],
      "tip": [
        "Specify memory to use as stack size"
      ],
      "next": []
    },
    {
      "name": "--terminal-width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --terminal-width <WIDTH>"
      ],
      "tip": [
        "Specify width of output overriding the auto detection of terminal width"
      ],
      "next": []
    },
    {
      "name": "--threads",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --threads <THREADS>"
      ],
      "tip": [
        "Number of threads to use"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
