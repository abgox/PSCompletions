{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "List system namespaces."
    ]
  },
  "option": [
    {
      "name": "--filter",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --filter <expr>"
      ],
      "tip": [
        "Apply display filter."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "Use JSON output format."
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "Use list format output."
      ]
    },
    {
      "name": "--list-columns",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --list-columns"
      ],
      "tip": [
        "List the available columns."
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "Don't print headings."
      ]
    },
    {
      "name": "--notruncate",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --notruncate"
      ],
      "tip": [
        "Don't truncate text in columns."
      ]
    },
    {
      "name": "--nowrap",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --nowrap"
      ],
      "tip": [
        "Don't use multi-line representation."
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "Define which output columns to use."
      ],
      "next": []
    },
    {
      "name": "--output-all",
      "tip": [
        "Output all columns."
      ]
    },
    {
      "name": "--persistent",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --persistent"
      ],
      "tip": [
        "Namespaces without processes."
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "Use the raw output format."
      ]
    },
    {
      "name": "--task",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --task <pid>"
      ],
      "tip": [
        "Print process namespaces."
      ],
      "next": []
    },
    {
      "name": "--tree",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --tree[=<rel>]"
      ],
      "tip": [
        "Use tree format.",
        "Possible values: parent, owner, process"
      ],
      "next": [
        {
          "name": "owner"
        },
        {
          "name": "parent"
        },
        {
          "name": "process"
        }
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <name>"
      ],
      "tip": [
        "Namespace type.",
        "Possible values: mnt, net, ipc, user, pid, uts, cgroup, time"
      ],
      "next": [
        {
          "name": "cgroup"
        },
        {
          "name": "ipc"
        },
        {
          "name": "mnt"
        },
        {
          "name": "net"
        },
        {
          "name": "pid"
        },
        {
          "name": "time"
        },
        {
          "name": "user"
        },
        {
          "name": "uts"
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
