{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "列出系统命名空间。"
    ]
  },
  "option": [
    {
      "name": "--filter",
      "alias": [
        "-Q"
      ],
      "usage": [
        "-Q, --filter <expr>"
      ],
      "tip": [
        "应用显示过滤器。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "使用 JSON 输出格式。"
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "使用列表格式输出。"
      ]
    },
    {
      "name": "--list-columns",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --list-columns"
      ],
      "tip": [
        "列出可用列。"
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "不打印标题。"
      ]
    },
    {
      "name": "--notruncate",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --notruncate"
      ],
      "tip": [
        "不截断列中的文本。"
      ]
    },
    {
      "name": "--nowrap",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --nowrap"
      ],
      "tip": [
        "不使用多行表示。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "定义要使用的输出列。"
      ],
      "next": []
    },
    {
      "name": "--output-all",
      "tip": [
        "输出所有列。"
      ]
    },
    {
      "name": "--persistent",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --persistent"
      ],
      "tip": [
        "没有进程的命名空间。"
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "使用原始输出格式。"
      ]
    },
    {
      "name": "--task",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --task <pid>"
      ],
      "tip": [
        "打印进程命名空间。"
      ],
      "next": []
    },
    {
      "name": "--tree",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --tree[=<rel>]"
      ],
      "tip": [
        "使用树形格式。",
        "可能值: parent, owner, process"
      ],
      "next": [
        {
          "name": "owner"
        },
        {
          "name": "parent"
        },
        {
          "name": "process"
        }
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <name>"
      ],
      "tip": [
        "命名空间类型。",
        "可能值: mnt, net, ipc, user, pid, uts, cgroup, time"
      ],
      "next": [
        {
          "name": "cgroup"
        },
        {
          "name": "ipc"
        },
        {
          "name": "mnt"
        },
        {
          "name": "net"
        },
        {
          "name": "pid"
        },
        {
          "name": "time"
        },
        {
          "name": "user"
        },
        {
          "name": "uts"
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
