{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "按公共字段连接两个文件的行。"
    ]
  },
  "option": [
    {
      "name": "--check-order",
      "tip": [
        "检查输入是否正确排序，即使所有输入行都可配对"
      ]
    },
    {
      "name": "--header",
      "tip": [
        "将每个文件的第一行视为字段标题，打印它们而不尝试配对"
      ]
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-case"
      ],
      "tip": [
        "比较字段时忽略大小写差异"
      ]
    },
    {
      "name": "--nocheck-order",
      "tip": [
        "不检查输入是否正确排序"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "行分隔符是 NUL 而非换行符"
      ]
    },
    {
      "name": "-1",
      "usage": [
        "-1 <FIELD>"
      ],
      "tip": [
        "在文件 1 的此 FIELD 上连接"
      ],
      "next": []
    },
    {
      "name": "-2",
      "usage": [
        "-2 <FIELD>"
      ],
      "tip": [
        "在文件 2 的此 FIELD 上连接"
      ],
      "next": []
    },
    {
      "name": "-a",
      "usage": [
        "-a <FILENUM>"
      ],
      "tip": [
        "同时打印文件 FILENUM 中无法配对的行，其中 FILENUM 为 1 或 2，对应 FILE1 或 FILE2",
        "[possible values: 1, 2]"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "-e",
      "usage": [
        "-e <EMPTY>"
      ],
      "tip": [
        "用 EMPTY 替换缺失的输入字段"
      ],
      "next": []
    },
    {
      "name": "-j",
      "usage": [
        "-j <FIELD>"
      ],
      "tip": [
        "等同于 '-1 FIELD -2 FIELD'"
      ],
      "next": []
    },
    {
      "name": "-o",
      "usage": [
        "-o <FORMAT>"
      ],
      "tip": [
        "构建输出行时遵循 FORMAT"
      ],
      "next": []
    },
    {
      "name": "-t",
      "usage": [
        "-t <CHAR>"
      ],
      "tip": [
        "使用 CHAR 作为输入和输出字段分隔符"
      ],
      "next": []
    },
    {
      "name": "-v",
      "usage": [
        "-v <FILENUM>"
      ],
      "tip": [
        "类似 -a FILENUM，但抑制已连接的输出行",
        "[possible values: 1, 2]"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
