{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把每个 FILE 写入标准输出，最后一行在最前。"
    ]
  },
  "option": [
    {
      "name": "--before",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --before"
      ],
      "tip": [
        "把分隔符放在前面而不是后面"
      ]
    },
    {
      "name": "--regex",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --regex"
      ],
      "tip": [
        "把分隔符解释为正则表达式"
      ]
    },
    {
      "name": "--separator",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --separator <STRING>"
      ],
      "tip": [
        "用 STRING 而不是换行符作为分隔符"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
