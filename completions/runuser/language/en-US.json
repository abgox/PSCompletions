{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Run a command with the effective user ID and group ID of <user>.",
      "Without -u, fall back to su(1)-compatible semantics."
    ]
  },
  "option": [
    {
      "name": "--command",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --command <command>"
      ],
      "tip": [
        "Pass a single command to the shell with -c."
      ],
      "next": []
    },
    {
      "name": "--fast",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fast"
      ],
      "tip": [
        "Pass -f to the shell (for csh or tcsh)."
      ]
    },
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group <group>"
      ],
      "tip": [
        "Specify the primary group."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--login",
      "alias": [
        "-l",
        "-"
      ],
      "usage": [
        "-, -l, --login"
      ],
      "tip": [
        "Make the shell a login shell."
      ]
    },
    {
      "name": "--no-pty",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --no-pty"
      ],
      "tip": [
        "Do not create a new pseudo-terminal (bad security!)."
      ]
    },
    {
      "name": "--preserve-environment",
      "alias": [
        "-m",
        "-p"
      ],
      "usage": [
        "-m, -p, --preserve-environment"
      ],
      "tip": [
        "Do not reset environment variables."
      ]
    },
    {
      "name": "--pty",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pty"
      ],
      "tip": [
        "Create a new pseudo-terminal."
      ]
    },
    {
      "name": "--session-command",
      "usage": [
        "--session-command <command>"
      ],
      "tip": [
        "Pass a single command to the shell with -c and do not create a new session."
      ],
      "next": []
    },
    {
      "name": "--shell",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shell <shell>"
      ],
      "tip": [
        "Run <shell> if /etc/shells allows it."
      ],
      "next": []
    },
    {
      "name": "--supp-group",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --supp-group <group>"
      ],
      "tip": [
        "Specify a supplemental group."
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <user>"
      ],
      "tip": [
        "Username."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--whitelist-environment",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --whitelist-environment <list>"
      ],
      "tip": [
        "Don't reset specified variables."
      ],
      "next": []
    }
  ]
}
