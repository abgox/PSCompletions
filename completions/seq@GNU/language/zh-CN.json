{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "从 FIRST 到 LAST 按 INCREMENT 为步长打印数字。"
    ]
  },
  "option": [
    {
      "name": "--equal-width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --equal-width"
      ],
      "tip": [
        "用前导零补齐，使各行宽度一致"
      ]
    },
    {
      "name": "--format",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --format <FORMAT>"
      ],
      "tip": [
        "使用 printf 风格的浮点 FORMAT"
      ],
      "next": []
    },
    {
      "name": "--separator",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --separator <STRING>"
      ],
      "tip": [
        "用 STRING 分隔各个数字（默认：\\n）"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
