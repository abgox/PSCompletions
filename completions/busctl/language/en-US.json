{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Introspect the D-Bus IPC bus."
    ]
  },
  "next": [
    {
      "name": "call",
      "usage": [
        "call SERVICE OBJECT INTERFACE METHOD [SIGNATURE [ARGUMENT...]]"
      ],
      "tip": [
        "Call a method."
      ]
    },
    {
      "name": "capture",
      "usage": [
        "capture [SERVICE...]"
      ],
      "tip": [
        "Capture bus traffic as pcap."
      ]
    },
    {
      "name": "emit",
      "usage": [
        "emit OBJECT INTERFACE SIGNAL [SIGNATURE [ARGUMENT...]]"
      ],
      "tip": [
        "Emit a signal."
      ]
    },
    {
      "name": "get-property",
      "usage": [
        "get-property SERVICE OBJECT INTERFACE PROPERTY..."
      ],
      "tip": [
        "Get property value."
      ]
    },
    {
      "name": "help",
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "introspect",
      "usage": [
        "introspect SERVICE OBJECT [INTERFACE]"
      ],
      "tip": [
        "Introspect a service object."
      ]
    },
    {
      "name": "list",
      "tip": [
        "List bus names."
      ]
    },
    {
      "name": "monitor",
      "usage": [
        "monitor [SERVICE...]"
      ],
      "tip": [
        "Show bus traffic."
      ]
    },
    {
      "name": "set-property",
      "usage": [
        "set-property SERVICE OBJECT INTERFACE PROPERTY SIGNATURE ARGUMENT..."
      ],
      "tip": [
        "Set property value."
      ]
    },
    {
      "name": "status",
      "usage": [
        "status [SERVICE]"
      ],
      "tip": [
        "Show bus service, process or bus owner credentials."
      ]
    },
    {
      "name": "tree",
      "usage": [
        "tree [SERVICE...]"
      ],
      "tip": [
        "Show object tree of service."
      ]
    },
    {
      "name": "wait",
      "usage": [
        "wait OBJECT INTERFACE SIGNAL"
      ],
      "tip": [
        "Wait for a signal."
      ]
    }
  ],
  "option": [
    {
      "name": "--acquired",
      "tip": [
        "Only show acquired names."
      ]
    },
    {
      "name": "--activatable",
      "tip": [
        "Only show activatable names."
      ]
    },
    {
      "name": "--address",
      "usage": [
        "--address=ADDRESS"
      ],
      "tip": [
        "Connect to bus specified by address."
      ],
      "next": []
    },
    {
      "name": "--allow-interactive-authorization",
      "usage": [
        "--allow-interactive-authorization=BOOL"
      ],
      "tip": [
        "Allow interactive authorization for operation."
      ],
      "next": []
    },
    {
      "name": "--augment-creds",
      "usage": [
        "--augment-creds=BOOL"
      ],
      "tip": [
        "Extend credential data with data read from /proc/$PID."
      ],
      "next": []
    },
    {
      "name": "--auto-start",
      "usage": [
        "--auto-start=BOOL"
      ],
      "tip": [
        "Auto-start destination service."
      ],
      "next": []
    },
    {
      "name": "--destination",
      "usage": [
        "--destination=SERVICE"
      ],
      "tip": [
        "Destination service of a signal."
      ],
      "next": []
    },
    {
      "name": "--expect-reply",
      "usage": [
        "--expect-reply=BOOL"
      ],
      "tip": [
        "Expect a method call reply."
      ],
      "next": []
    },
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "Do not ellipsize output."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "Operate on remote host."
      ],
      "next": []
    },
    {
      "name": "--json",
      "usage": [
        "--json=MODE"
      ],
      "tip": [
        "Output as JSON.",
        "Possible values: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--limit-messages",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --limit-messages=NUMBER"
      ],
      "tip": [
        "Stop monitoring after receiving the specified number of messages."
      ],
      "next": []
    },
    {
      "name": "--list",
      "tip": [
        "Don't show tree, but simple object path list."
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "Operate on local container."
      ],
      "next": []
    },
    {
      "name": "--match",
      "usage": [
        "--match=MATCH"
      ],
      "tip": [
        "Only show matching messages."
      ],
      "next": []
    },
    {
      "name": "--no-legend",
      "tip": [
        "Do not show the headers and footers."
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Don't show method call reply."
      ]
    },
    {
      "name": "--show-machine",
      "tip": [
        "Show machine ID column in list."
      ]
    },
    {
      "name": "--size",
      "usage": [
        "--size=SIZE"
      ],
      "tip": [
        "Maximum length of captured packet."
      ],
      "next": []
    },
    {
      "name": "--system",
      "tip": [
        "Connect to system bus."
      ]
    },
    {
      "name": "--timeout",
      "usage": [
        "--timeout=SECS"
      ],
      "tip": [
        "Maximum time to wait for method call completion."
      ],
      "next": []
    },
    {
      "name": "--unique",
      "tip": [
        "Only show unique names."
      ]
    },
    {
      "name": "--user",
      "tip": [
        "Connect to user bus."
      ]
    },
    {
      "name": "--verbose",
      "tip": [
        "Show result values in long format."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    },
    {
      "name": "--watch-bind",
      "usage": [
        "--watch-bind=BOOL"
      ],
      "tip": [
        "Wait for bus AF_UNIX socket to be bound in the file system."
      ],
      "next": []
    },
    {
      "name": "--xml-interface",
      "tip": [
        "Dump the XML description in introspect command."
      ]
    },
    {
      "name": "-j",
      "tip": [
        "Same as --json=pretty on tty, --json=short otherwise."
      ]
    }
  ]
}
