{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "内省 D-Bus IPC 总线。"
    ]
  },
  "next": [
    {
      "name": "call",
      "usage": [
        "call SERVICE OBJECT INTERFACE METHOD [SIGNATURE [ARGUMENT...]]"
      ],
      "tip": [
        "调用方法。"
      ]
    },
    {
      "name": "capture",
      "usage": [
        "capture [SERVICE...]"
      ],
      "tip": [
        "以 pcap 捕获总线流量。"
      ]
    },
    {
      "name": "emit",
      "usage": [
        "emit OBJECT INTERFACE SIGNAL [SIGNATURE [ARGUMENT...]]"
      ],
      "tip": [
        "发送信号。"
      ]
    },
    {
      "name": "get-property",
      "usage": [
        "get-property SERVICE OBJECT INTERFACE PROPERTY..."
      ],
      "tip": [
        "获取属性值。"
      ]
    },
    {
      "name": "help",
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "introspect",
      "usage": [
        "introspect SERVICE OBJECT [INTERFACE]"
      ],
      "tip": [
        "内省服务对象。"
      ]
    },
    {
      "name": "list",
      "tip": [
        "列出总线名称。"
      ]
    },
    {
      "name": "monitor",
      "usage": [
        "monitor [SERVICE...]"
      ],
      "tip": [
        "显示总线流量。"
      ]
    },
    {
      "name": "set-property",
      "usage": [
        "set-property SERVICE OBJECT INTERFACE PROPERTY SIGNATURE ARGUMENT..."
      ],
      "tip": [
        "设置属性值。"
      ]
    },
    {
      "name": "status",
      "usage": [
        "status [SERVICE]"
      ],
      "tip": [
        "显示总线服务、进程或总线所有者的凭据。"
      ]
    },
    {
      "name": "tree",
      "usage": [
        "tree [SERVICE...]"
      ],
      "tip": [
        "显示服务的对象树。"
      ]
    },
    {
      "name": "wait",
      "usage": [
        "wait OBJECT INTERFACE SIGNAL"
      ],
      "tip": [
        "等待信号。"
      ]
    }
  ],
  "option": [
    {
      "name": "--acquired",
      "tip": [
        "仅显示已获取的名称。"
      ]
    },
    {
      "name": "--activatable",
      "tip": [
        "仅显示可激活的名称。"
      ]
    },
    {
      "name": "--address",
      "usage": [
        "--address=ADDRESS"
      ],
      "tip": [
        "连接到指定地址的总线。"
      ],
      "next": []
    },
    {
      "name": "--allow-interactive-authorization",
      "usage": [
        "--allow-interactive-authorization=BOOL"
      ],
      "tip": [
        "允许对操作进行交互式授权。"
      ],
      "next": []
    },
    {
      "name": "--augment-creds",
      "usage": [
        "--augment-creds=BOOL"
      ],
      "tip": [
        "使用从 /proc/$PID 读取的数据扩展凭据数据。"
      ],
      "next": []
    },
    {
      "name": "--auto-start",
      "usage": [
        "--auto-start=BOOL"
      ],
      "tip": [
        "自动启动目标服务。"
      ],
      "next": []
    },
    {
      "name": "--destination",
      "usage": [
        "--destination=SERVICE"
      ],
      "tip": [
        "信号的目标服务。"
      ],
      "next": []
    },
    {
      "name": "--expect-reply",
      "usage": [
        "--expect-reply=BOOL"
      ],
      "tip": [
        "期望方法调用回复。"
      ],
      "next": []
    },
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "不省略输出。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "在远程主机上操作。"
      ],
      "next": []
    },
    {
      "name": "--json",
      "usage": [
        "--json=MODE"
      ],
      "tip": [
        "以 JSON 输出。",
        "可能值: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--limit-messages",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --limit-messages=NUMBER"
      ],
      "tip": [
        "收到指定数量的消息后停止监视。"
      ],
      "next": []
    },
    {
      "name": "--list",
      "tip": [
        "不显示树，而显示简单的对象路径列表。"
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "对本机容器操作。"
      ],
      "next": []
    },
    {
      "name": "--match",
      "usage": [
        "--match=MATCH"
      ],
      "tip": [
        "仅显示匹配的消息。"
      ],
      "next": []
    },
    {
      "name": "--no-legend",
      "tip": [
        "不显示页眉和页脚。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "不显示方法调用回复。"
      ]
    },
    {
      "name": "--show-machine",
      "tip": [
        "在列表中显示机器 ID 列。"
      ]
    },
    {
      "name": "--size",
      "usage": [
        "--size=SIZE"
      ],
      "tip": [
        "捕获数据包的最大长度。"
      ],
      "next": []
    },
    {
      "name": "--system",
      "tip": [
        "连接到系统总线。"
      ]
    },
    {
      "name": "--timeout",
      "usage": [
        "--timeout=SECS"
      ],
      "tip": [
        "等待方法调用完成的最长时间。"
      ],
      "next": []
    },
    {
      "name": "--unique",
      "tip": [
        "仅显示唯一名称。"
      ]
    },
    {
      "name": "--user",
      "tip": [
        "连接到用户总线。"
      ]
    },
    {
      "name": "--verbose",
      "tip": [
        "以长格式显示结果值。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "--watch-bind",
      "usage": [
        "--watch-bind=BOOL"
      ],
      "tip": [
        "等待总线 AF_UNIX 套接字在文件系统中绑定。"
      ],
      "next": []
    },
    {
      "name": "--xml-interface",
      "tip": [
        "在 introspect 命令中输出 XML 描述。"
      ]
    },
    {
      "name": "-j",
      "tip": [
        "在 tty 上等同于 --json=pretty，否则等同于 --json=short。"
      ]
    }
  ]
}
