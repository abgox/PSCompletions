{
  "meta": {
    "url": "https://github.com/microsoft/WSL",
    "description": [
      "适用于 Linux 的 Windows 子系统。"
    ]
  },
  "option": [
    {
      "name": "--cd",
      "usage": [
        "--cd <Directory>"
      ],
      "tip": [
        "将指定的目录设置为当前工作目录",
        "如果使用 ~, 它将使用 Linux 用户的 home 路径",
        "如果路径以 / 字符开头, 它将被解释为绝对的 Linux 路径",
        "否则, 值必须是绝对的 Windows 路径"
      ],
      "next": []
    },
    {
      "name": "--debug-shell",
      "tip": [
        "打开 WSL2 调试 shell 以进行诊断"
      ]
    },
    {
      "name": "--distribution",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --distribution <Distro>"
      ],
      "tip": [
        "运行指定的分发"
      ],
      "next": []
    },
    {
      "name": "--distribution-id",
      "usage": [
        "--distribution-id <DistroGuid>"
      ],
      "tip": [
        "通过 ID 运行指定的分发"
      ],
      "next": []
    },
    {
      "name": "--event-viewer",
      "tip": [
        "打开 Windows 事件查看器的应用程序视图"
      ]
    },
    {
      "name": "--exec",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exec <command>"
      ],
      "tip": [
        "不使用默认的 Linux shell 执行指定的命令"
      ],
      "next": []
    },
    {
      "name": "--export",
      "usage": [
        "--export <distribution> <file_name> [options]"
      ],
      "tip": [
        "将发行版导出为 tar 文件; 对于标准输出, 文件名可以是 \"-\""
      ],
      "example": [
        "wsl --export ubuntu \"$env:UserProfile\\Desktop\\export.tar\""
      ],
      "option": [
        {
          "name": "--format",
          "usage": [
            "--format <Format>"
          ],
          "tip": [
            "指定导出格式: tar, tar.gz, tar.xz, vhd"
          ],
          "next": [
            {
              "name": "tar"
            },
            {
              "name": "tar.gz"
            },
            {
              "name": "tar.xz"
            },
            {
              "name": "vhd"
            }
          ]
        },
        {
          "name": "--vhd",
          "usage": [
            "--vhd <file_name>"
          ],
          "tip": [
            "指定将发行版导出为 .vhdx 文件"
          ],
          "next": []
        }
      ],
      "next": []
    },
    {
      "name": "--import",
      "usage": [
        "--import <distribution> <Install_location> <file_name> [options]"
      ],
      "tip": [
        "将指定的 tar 文件作为新发行版导入; 对于标准输入, 文件名可以是 \"-\""
      ],
      "example": [
        "wsl --import ubuntu \"$env:UserProfile\\Desktop\" \"$env:UserProfile\\Desktop\\export.tar\""
      ],
      "option": [
        {
          "name": "--version",
          "usage": [
            "--version <version>"
          ],
          "tip": [
            "指定新发行版要使用的版本"
          ],
          "next": []
        },
        {
          "name": "--vhd",
          "usage": [
            "--vhd <file_name>"
          ],
          "tip": [
            "将提供的文件作为 .vhdx 文件而不是 tar 文件导入, ",
            "此操作将在指定的安装位置创建 .vhdx 文件的副本"
          ],
          "next": []
        }
      ],
      "next": []
    },
    {
      "name": "--import-in-place",
      "usage": [
        "--import-in-place <Distro> <FileName>"
      ],
      "tip": [
        "将指定的 .vhdx 文件作为新发行版导入。",
        "此虚拟硬盘必须使用 ext4 文件系统类型格式化"
      ],
      "next": []
    },
    {
      "name": "--install",
      "usage": [
        "--install [Options] [<distribution>]"
      ],
      "tip": [
        "为 Linux 安装 Windows Subsystem for Linux (WSL) 发行版",
        "要查看可安装的发行版的列表, 请使用 wsl --list --online"
      ],
      "option": [
        {
          "name": "--enable-wsl1",
          "tip": [
            "使用 WSL 1 安装发行版"
          ]
        },
        {
          "name": "--fixed-vhd",
          "tip": [
            "使用固定大小的 VHD 安装, 而不是动态扩展"
          ]
        },
        {
          "name": "--from-file",
          "usage": [
            "--from-file <Path>"
          ],
          "tip": [
            "从本地文件安装发行版"
          ],
          "next": []
        },
        {
          "name": "--legacy",
          "tip": [
            "安装旧版发行版"
          ]
        },
        {
          "name": "--location",
          "usage": [
            "--location <Location>"
          ],
          "tip": [
            "设置发行版的安装位置"
          ],
          "next": []
        },
        {
          "name": "--name",
          "usage": [
            "--name <Name>"
          ],
          "tip": [
            "设置发行版的名称"
          ],
          "next": []
        },
        {
          "name": "--no-distribution",
          "tip": [
            "不安装发行版, 仅安装可选组件"
          ]
        },
        {
          "name": "--no-launch",
          "alias": [
            "-n"
          ],
          "usage": [
            "-n, --no-launch"
          ],
          "tip": [
            "安装发行版后不启动它"
          ]
        },
        {
          "name": "--version",
          "usage": [
            "--version <Version>"
          ],
          "tip": [
            "指定新发行版要使用的版本"
          ],
          "next": []
        },
        {
          "name": "--vhd-size",
          "usage": [
            "--vhd-size <MemoryString>"
          ],
          "tip": [
            "设置新发行版的虚拟硬盘大小"
          ],
          "next": []
        },
        {
          "name": "--web-download",
          "tip": [
            "从互联网下载发行版而不是从 Microsoft Store 下载"
          ]
        }
      ],
      "next": []
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list [options]"
      ],
      "tip": [
        "列出发行版"
      ],
      "next": [
        {
          "name": "--all",
          "tip": [
            "列出所有发行版, 包括那些当前正在安装或卸载的"
          ]
        },
        {
          "name": "--online",
          "alias": [
            "-o"
          ],
          "usage": [
            "-o, --online"
          ],
          "tip": [
            "显示可以安装的发行版的列表"
          ]
        },
        {
          "name": "--quiet",
          "alias": [
            "-q"
          ],
          "usage": [
            "-q, --quiet"
          ],
          "tip": [
            "只显示发行版名称"
          ]
        },
        {
          "name": "--running",
          "tip": [
            "只列出当前正在运行的发行版"
          ]
        },
        {
          "name": "--verbose",
          "alias": [
            "-v"
          ],
          "usage": [
            "-v, --verbose"
          ],
          "tip": [
            "显示所有发行版的详细信息"
          ]
        }
      ]
    },
    {
      "name": "--manage",
      "usage": [
        "--manage <Distro> <Options...>"
      ],
      "tip": [
        "管理发行版设置"
      ],
      "option": [
        {
          "name": "--move",
          "usage": [
            "--move <Location>"
          ],
          "tip": [
            "将发行版移动到新位置"
          ],
          "next": []
        },
        {
          "name": "--resize",
          "usage": [
            "--resize <MemoryString>"
          ],
          "tip": [
            "调整发行版的虚拟硬盘大小"
          ],
          "next": []
        },
        {
          "name": "--set-default-user",
          "usage": [
            "--set-default-user <Username>"
          ],
          "tip": [
            "设置发行版的默认用户"
          ],
          "next": []
        },
        {
          "name": "--set-sparse",
          "alias": [
            "-s"
          ],
          "usage": [
            "-s, --set-sparse <true|false>"
          ],
          "tip": [
            "设置发行版的 vhdx 是否为稀疏"
          ],
          "next": []
        }
      ],
      "next": []
    },
    {
      "name": "--mount",
      "usage": [
        "--mount [Options] <Disk>"
      ],
      "tip": [
        "在所有 WSL 2 发行版中附加和挂载物理或虚拟磁盘"
      ],
      "option": [
        {
          "name": "--bare",
          "tip": [
            "将磁盘附加到 WSL2 而不挂载它"
          ]
        },
        {
          "name": "--name",
          "usage": [
            "--name <Name>"
          ],
          "tip": [
            "使用自定义名称作为挂载点"
          ],
          "next": []
        },
        {
          "name": "--options",
          "usage": [
            "--options <Options>"
          ],
          "tip": [
            "传递挂载选项"
          ],
          "next": []
        },
        {
          "name": "--partition",
          "usage": [
            "--partition <Index>"
          ],
          "tip": [
            "挂载的分区索引, 如果未指定, 则默认为整个磁盘"
          ],
          "next": []
        },
        {
          "name": "--type",
          "usage": [
            "--type <Type>"
          ],
          "tip": [
            "挂载磁盘时使用的文件系统, 如果未指定, 则默认为 ext4"
          ],
          "next": []
        },
        {
          "name": "--vhd",
          "usage": [
            "--vhd <Disk>"
          ],
          "tip": [
            "指定 <Disk> 代表一个虚拟硬盘"
          ],
          "next": []
        }
      ],
      "next": []
    },
    {
      "name": "--release-notes",
      "tip": [
        "打开网页浏览器查看 WSL 的发布说明页面"
      ]
    },
    {
      "name": "--set-default",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --set-default <Distribution>"
      ],
      "tip": [
        "将指定分发设置为默认分发"
      ],
      "next": []
    },
    {
      "name": "--set-default-version",
      "usage": [
        "--set-default-version <Version>"
      ],
      "tip": [
        "更改新发行版的默认安装版本"
      ],
      "next": []
    },
    {
      "name": "--set-version",
      "usage": [
        "--set-version <Distribution> <Version>"
      ],
      "tip": [
        "更改指定分发的版本"
      ],
      "next": []
    },
    {
      "name": "--shell-type",
      "usage": [
        "--shell-type <shell-type>"
      ],
      "tip": [
        "使用提供的 shell 类型执行指定的命令"
      ],
      "example": [
        {
          "cmd": "-shell-type standard",
          "desc": "使用默认的 Linux shell 执行指定的命令"
        }
      ],
      "next": [
        {
          "name": "login",
          "tip": [
            "使用默认的 Linux shell 作为登录 shell 执行指定的命令"
          ]
        },
        {
          "name": "none",
          "tip": [
            "不使用默认的 Linux shell 执行指定的命令"
          ]
        },
        {
          "name": "standard",
          "tip": [
            "使用默认的 Linux shell 执行指定的命令"
          ]
        }
      ]
    },
    {
      "name": "--shutdown",
      "tip": [
        "立即终止所有运行的发行版和 WSL 2 轻量级虚拟机"
      ],
      "next": [
        {
          "name": "--force",
          "tip": [
            "即使有活动会话也强制关闭"
          ]
        }
      ]
    },
    {
      "name": "--status",
      "tip": [
        "显示 Windows Subsystem for Linux 的状态"
      ]
    },
    {
      "name": "--system",
      "tip": [
        "以系统发行版启动 shell"
      ]
    },
    {
      "name": "--terminate",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --terminate <Distribution>"
      ],
      "tip": [
        "终止指定的分发"
      ],
      "next": []
    },
    {
      "name": "--uninstall",
      "tip": [
        "从 Windows 中卸载 Windows Subsystem for Linux"
      ]
    },
    {
      "name": "--unmount",
      "usage": [
        "--unmount [Disk]"
      ],
      "tip": [
        "从所有 WSL2 发行版中卸载并分离磁盘",
        "如果未提供参数, 则卸载并分离所有磁盘"
      ],
      "next": []
    },
    {
      "name": "--unregister",
      "usage": [
        "--unregister <Distribution>"
      ],
      "tip": [
        "注销分发并删除根文件系统"
      ],
      "next": []
    },
    {
      "name": "--update",
      "tip": [
        "更新 Windows Subsystem for Linux (WSL) 包"
      ],
      "next": [
        {
          "name": "--pre-release",
          "tip": [
            "如果可用, 下载预发行版本(隐含 --web-download)"
          ]
        },
        {
          "name": "--web-download",
          "tip": [
            "从互联网下载更新而不是从 Microsoft Store 下载"
          ]
        }
      ]
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <user>"
      ],
      "tip": [
        "以指定用户身份运行"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "检查有关 WSL 及其组件的版本信息"
      ]
    },
    {
      "name": "~",
      "tip": [
        "在用户的 home 目录中开始"
      ],
      "option": [
        {
          "name": "--distribution",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --distribution <Distro>"
          ],
          "tip": [
            "运行指定的发行版"
          ],
          "next": []
        },
        {
          "name": "--exec",
          "alias": [
            "-e"
          ],
          "usage": [
            "-e, --exec <command>"
          ],
          "tip": [
            "不使用默认的 Linux shell 执行指定的命令"
          ],
          "next": []
        },
        {
          "name": "--system",
          "tip": [
            "以系统发行版启动 shell"
          ]
        },
        {
          "name": "--user",
          "alias": [
            "-u"
          ],
          "usage": [
            "-u, --user <user>"
          ],
          "tip": [
            "以指定的用户身份运行"
          ],
          "next": []
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "查看 WSL 中可用选项和命令的列表"
      ]
    }
  ]
}
