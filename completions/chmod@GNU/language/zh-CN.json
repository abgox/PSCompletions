{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把每个 FILE 的权限模式改为 MODE。"
    ]
  },
  "option": [
    {
      "name": "--changes",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --changes"
      ],
      "tip": [
        "与 verbose 类似，但只在实际发生更改时报告"
      ]
    },
    {
      "name": "--dereference",
      "tip": [
        "作用于每个符号链接指向的对象，而不是符号链接本身"
      ]
    },
    {
      "name": "--no-dereference",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --no-dereference"
      ],
      "tip": [
        "作用于每个符号链接本身，而不是它指向的对象"
      ]
    },
    {
      "name": "--no-preserve-root",
      "tip": [
        "不对 '/' 做特殊处理（默认）"
      ]
    },
    {
      "name": "--preserve-root",
      "tip": [
        "不对 '/' 进行递归操作并使其失败"
      ]
    },
    {
      "name": "--recursive",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --recursive"
      ],
      "tip": [
        "递归地修改文件和目录"
      ]
    },
    {
      "name": "--reference",
      "usage": [
        "--reference <RFILE>"
      ],
      "tip": [
        "使用 RFILE 的模式而不指定 MODE 值。如果 RFILE 是符号链接，总会被跟随。"
      ],
      "next": []
    },
    {
      "name": "--silent",
      "alias": [
        "--quiet",
        "-f"
      ],
      "usage": [
        "-f, --quiet, --silent"
      ],
      "tip": [
        "抑制大多数错误信息"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "为处理的每个文件输出一条诊断信息"
      ]
    },
    {
      "name": "-H",
      "tip": [
        "如果命令行参数是指向目录的符号链接，则遍历它"
      ]
    },
    {
      "name": "-L",
      "tip": [
        "遍历遇到的每一个指向目录的符号链接"
      ]
    },
    {
      "name": "-P",
      "tip": [
        "不遍历任何符号链接"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
