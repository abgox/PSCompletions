{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "输出去除前导目录组件后的名称。"
    ]
  },
  "option": [
    {
      "name": "--multiple",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --multiple"
      ],
      "tip": [
        "支持多个参数并将每个参数视为一个 NAME"
      ]
    },
    {
      "name": "--suffix",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --suffix <SUFFIX>"
      ],
      "tip": [
        "移除尾部的 SUFFIX；隐含 -a"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "以 NUL 而非换行符结束每行输出"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
