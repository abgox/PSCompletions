{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "在临时作用域或服务中运行指定命令。"
    ]
  },
  "option": [
    {
      "name": "--background",
      "usage": [
        "--background=COLOR"
      ],
      "tip": [
        "设置背景的 ANSI 颜色。"
      ],
      "next": []
    },
    {
      "name": "--collect",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --collect"
      ],
      "tip": [
        "单元运行后卸载，即使失败。"
      ]
    },
    {
      "name": "--description",
      "usage": [
        "--description=TEXT"
      ],
      "tip": [
        "设置单元描述。"
      ],
      "next": []
    },
    {
      "name": "--expand-environment",
      "usage": [
        "--expand-environment=BOOL"
      ],
      "tip": [
        "控制环境变量的展开。"
      ],
      "next": []
    },
    {
      "name": "--gid",
      "usage": [
        "--gid=GROUP"
      ],
      "tip": [
        "以指定的系统组运行。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "在远程主机上操作。"
      ],
      "next": []
    },
    {
      "name": "--ignore-failure",
      "tip": [
        "忽略被调用进程的退出状态。"
      ]
    },
    {
      "name": "--json",
      "usage": [
        "--json=pretty|short|off"
      ],
      "tip": [
        "以 JSON 打印单元名和调用 ID。",
        "可能值: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "对本机容器操作。"
      ],
      "next": []
    },
    {
      "name": "--nice",
      "usage": [
        "--nice=NICE"
      ],
      "tip": [
        "设置 nice 级别。"
      ],
      "next": []
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "不提示输入密码。"
      ]
    },
    {
      "name": "--no-block",
      "tip": [
        "不等待操作完成。"
      ]
    },
    {
      "name": "--on-active",
      "usage": [
        "--on-active=SECONDS"
      ],
      "tip": [
        "在指定延迟后运行。"
      ],
      "next": []
    },
    {
      "name": "--on-boot",
      "usage": [
        "--on-boot=SECONDS"
      ],
      "tip": [
        "在机器启动后指定时间运行。"
      ],
      "next": []
    },
    {
      "name": "--on-calendar",
      "usage": [
        "--on-calendar=SPEC"
      ],
      "tip": [
        "在指定的实时日历事件上运行。"
      ],
      "next": []
    },
    {
      "name": "--on-clock-change",
      "tip": [
        "实时时钟跳变时运行。"
      ]
    },
    {
      "name": "--on-startup",
      "usage": [
        "--on-startup=SECONDS"
      ],
      "tip": [
        "在 systemd 激活后指定时间运行。"
      ],
      "next": []
    },
    {
      "name": "--on-timezone-change",
      "tip": [
        "时区变化时运行。"
      ]
    },
    {
      "name": "--on-unit-active",
      "usage": [
        "--on-unit-active=SECONDS"
      ],
      "tip": [
        "在最后一次激活后指定时间运行。"
      ],
      "next": []
    },
    {
      "name": "--on-unit-inactive",
      "usage": [
        "--on-unit-inactive=SECONDS"
      ],
      "tip": [
        "在最后一次停用后指定时间运行。"
      ],
      "next": []
    },
    {
      "name": "--path-property",
      "usage": [
        "--path-property=NAME=VALUE"
      ],
      "tip": [
        "设置路径单元属性。"
      ],
      "next": []
    },
    {
      "name": "--pipe",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pipe"
      ],
      "tip": [
        "将标准输入/输出/错误直接传递给服务。"
      ]
    },
    {
      "name": "--property",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --property=NAME=VALUE"
      ],
      "tip": [
        "设置服务或作用域单元属性。"
      ],
      "next": []
    },
    {
      "name": "--pty",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --pty"
      ],
      "tip": [
        "在伪终端上运行服务。"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制运行时的信息性消息。"
      ]
    },
    {
      "name": "--remain-after-exit",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --remain-after-exit"
      ],
      "tip": [
        "保留服务直到显式停止。"
      ]
    },
    {
      "name": "--same-dir",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --same-dir"
      ],
      "tip": [
        "从调用者继承工作目录。"
      ]
    },
    {
      "name": "--scope",
      "tip": [
        "作为作用域而不是服务运行。"
      ]
    },
    {
      "name": "--send-sighup",
      "tip": [
        "终止时发送 SIGHUP。"
      ]
    },
    {
      "name": "--service-type",
      "usage": [
        "--service-type=TYPE"
      ],
      "tip": [
        "设置服务类型。",
        "可用值见 systemd.service(5) 的 Type=。"
      ],
      "next": []
    },
    {
      "name": "--setenv",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --setenv=NAME[=VALUE]"
      ],
      "tip": [
        "设置环境变量。"
      ],
      "next": []
    },
    {
      "name": "--shell",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --shell"
      ],
      "tip": [
        "交互式调用 $SHELL。"
      ]
    },
    {
      "name": "--slice",
      "usage": [
        "--slice=SLICE"
      ],
      "tip": [
        "在指定切片中运行。"
      ],
      "next": []
    },
    {
      "name": "--slice-inherit",
      "tip": [
        "从调用者继承切片。"
      ]
    },
    {
      "name": "--socket-property",
      "usage": [
        "--socket-property=NAME=VALUE"
      ],
      "tip": [
        "设置套接字单元属性。"
      ],
      "next": []
    },
    {
      "name": "--timer-property",
      "usage": [
        "--timer-property=NAME=VALUE"
      ],
      "tip": [
        "设置定时器单元属性。"
      ],
      "next": []
    },
    {
      "name": "--uid",
      "usage": [
        "--uid=USER"
      ],
      "tip": [
        "以指定的系统用户运行。"
      ],
      "next": []
    },
    {
      "name": "--unit",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unit=UNIT"
      ],
      "tip": [
        "在指定单元名下运行。"
      ],
      "next": []
    },
    {
      "name": "--user",
      "tip": [
        "作为用户单元运行。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "--wait",
      "tip": [
        "等待服务再次停止。"
      ]
    },
    {
      "name": "--working-directory",
      "usage": [
        "--working-directory=PATH"
      ],
      "tip": [
        "设置工作目录。"
      ],
      "next": []
    }
  ]
}
