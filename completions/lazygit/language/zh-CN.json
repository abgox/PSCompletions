{
  "meta": {
    "url": "https://github.com/jesseduffield/lazygit",
    "description": [
      "一个简单的 git 命令终端 UI。"
    ]
  },
  "next": [
    {
      "name": "completion",
      "usage": [
        "completion [bash|zsh|fish|powershell]"
      ],
      "tip": [
        "生成 shell 补全脚本。"
      ],
      "next": [
        {
          "name": "bash"
        },
        {
          "name": "fish"
        },
        {
          "name": "powershell"
        },
        {
          "name": "zsh"
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config"
      ],
      "tip": [
        "打印默认配置。"
      ]
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "以调试模式运行并记录日志。"
      ]
    },
    {
      "name": "--filter",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --filter <path>"
      ],
      "tip": [
        "在 `git log -- <path>` 中过滤的路径。"
      ],
      "next": []
    },
    {
      "name": "--git-dir",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --git-dir <path>"
      ],
      "tip": [
        "等同于 git 的 --git-dir 参数。"
      ],
      "next": []
    },
    {
      "name": "--logs",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --logs"
      ],
      "tip": [
        "跟踪 lazygit 日志。"
      ]
    },
    {
      "name": "--path",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --path <path>"
      ],
      "tip": [
        "git 仓库路径。（等同于 --work-tree=<path> --git-dir=<path>/.git/）"
      ],
      "next": []
    },
    {
      "name": "--print-config-dir",
      "alias": [
        "-cd"
      ],
      "usage": [
        "-cd, --print-config-dir"
      ],
      "tip": [
        "打印配置目录。"
      ]
    },
    {
      "name": "--profile",
      "tip": [
        "启动分析器并在 http 端口 6060 上提供服务。"
      ]
    },
    {
      "name": "--screen-mode",
      "alias": [
        "-sm"
      ],
      "usage": [
        "-sm, --screen-mode <mode>"
      ],
      "tip": [
        "初始屏幕模式。"
      ],
      "next": [
        {
          "name": "full"
        },
        {
          "name": "half"
        },
        {
          "name": "normal"
        }
      ]
    },
    {
      "name": "--use-config-dir",
      "alias": [
        "-ucd"
      ],
      "usage": [
        "-ucd, --use-config-dir <dir>"
      ],
      "tip": [
        "使用提供的目录覆盖默认配置目录。"
      ],
      "next": []
    },
    {
      "name": "--use-config-file",
      "alias": [
        "-ucf"
      ],
      "usage": [
        "-ucf, --use-config-file <files>"
      ],
      "tip": [
        "自定义配置文件的逗号分隔列表。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "打印当前版本。"
      ]
    },
    {
      "name": "--work-tree",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --work-tree <path>"
      ],
      "tip": [
        "等同于 git 的 --work-tree 参数。"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示可用标志、子命令和位置值参数的帮助。"
      ]
    }
  ]
}
