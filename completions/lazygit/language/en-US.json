{
  "meta": {
    "url": "https://github.com/jesseduffield/lazygit",
    "description": [
      "A simple terminal UI for git commands."
    ]
  },
  "next": [
    {
      "name": "completion",
      "usage": [
        "completion [bash|zsh|fish|powershell]"
      ],
      "tip": [
        "Generate shell completion script."
      ],
      "next": [
        {
          "name": "bash"
        },
        {
          "name": "fish"
        },
        {
          "name": "powershell"
        },
        {
          "name": "zsh"
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config"
      ],
      "tip": [
        "Print the default config."
      ]
    },
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "Run in debug mode with logging."
      ]
    },
    {
      "name": "--filter",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --filter <path>"
      ],
      "tip": [
        "Path to filter on in `git log -- <path>`."
      ],
      "next": []
    },
    {
      "name": "--git-dir",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --git-dir <path>"
      ],
      "tip": [
        "Equivalent of the --git-dir git argument."
      ],
      "next": []
    },
    {
      "name": "--logs",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --logs"
      ],
      "tip": [
        "Tail lazygit logs."
      ]
    },
    {
      "name": "--path",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --path <path>"
      ],
      "tip": [
        "Path of git repo. (equivalent to --work-tree=<path> --git-dir=<path>/.git/)"
      ],
      "next": []
    },
    {
      "name": "--print-config-dir",
      "alias": [
        "-cd"
      ],
      "usage": [
        "-cd, --print-config-dir"
      ],
      "tip": [
        "Print the config directory."
      ]
    },
    {
      "name": "--profile",
      "tip": [
        "Start the profiler and serve it on http port 6060."
      ]
    },
    {
      "name": "--screen-mode",
      "alias": [
        "-sm"
      ],
      "usage": [
        "-sm, --screen-mode <mode>"
      ],
      "tip": [
        "The initial screen-mode."
      ],
      "next": [
        {
          "name": "full"
        },
        {
          "name": "half"
        },
        {
          "name": "normal"
        }
      ]
    },
    {
      "name": "--use-config-dir",
      "alias": [
        "-ucd"
      ],
      "usage": [
        "-ucd, --use-config-dir <dir>"
      ],
      "tip": [
        "Override default config directory with provided directory."
      ],
      "next": []
    },
    {
      "name": "--use-config-file",
      "alias": [
        "-ucf"
      ],
      "usage": [
        "-ucf, --use-config-file <files>"
      ],
      "tip": [
        "Comma separated list to custom config file(s)."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Print the current version."
      ]
    },
    {
      "name": "--work-tree",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --work-tree <path>"
      ],
      "tip": [
        "Equivalent of the --work-tree git argument."
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Displays help with available flag, subcommand, and positional value parameters."
      ]
    }
  ]
}
