{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将 SOURCE 移动到 DEST，或将多个 SOURCE 移动到 DIRECTORY"
    ]
  },
  "option": [
    {
      "name": "--backup",
      "usage": [
        "--backup[=<CONTROL>]"
      ],
      "tip": [
        "为每个已存在的目标文件创建备份"
      ],
      "next": []
    },
    {
      "name": "--context",
      "usage": [
        "--context[=<CTX>]"
      ],
      "tip": [
        "类似 -Z，如果指定了 CTX 则将 SELinux 或 SMACK 安全上下文设为 CTX"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "tip": [
        "解释文件是如何复制的。隐含 -v"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "覆盖前不提示"
      ]
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "覆盖前提示"
      ]
    },
    {
      "name": "--no-clobber",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-clobber"
      ],
      "tip": [
        "不覆盖已存在的文件"
      ]
    },
    {
      "name": "--no-target-directory",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --no-target-directory"
      ],
      "tip": [
        "将 DEST 视为普通文件"
      ]
    },
    {
      "name": "--progress",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --progress"
      ],
      "tip": [
        "显示进度条。注意：GNU coreutils 不支持此功能"
      ]
    },
    {
      "name": "--strip-trailing-slashes",
      "tip": [
        "删除每个 SOURCE 参数末尾的斜杠"
      ]
    },
    {
      "name": "--suffix",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --suffix <SUFFIX>"
      ],
      "tip": [
        "覆盖常用的备份后缀"
      ],
      "next": []
    },
    {
      "name": "--target-directory",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --target-directory <DIRECTORY>"
      ],
      "tip": [
        "将所有 SOURCE 参数移动到 DIRECTORY"
      ],
      "next": []
    },
    {
      "name": "--update",
      "usage": [
        "--update[=<UPDATE>]"
      ],
      "tip": [
        "仅在 SOURCE 文件比目标文件新或目标文件缺失时移动"
      ],
      "next": [
        {
          "name": "all"
        },
        {
          "name": "none"
        },
        {
          "name": "none-fail"
        },
        {
          "name": "older"
        }
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "解释正在做什么"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-b",
      "tip": [
        "类似 --backup 但不接受参数"
      ]
    },
    {
      "name": "-u",
      "tip": [
        "类似 --update 但不接受参数"
      ]
    },
    {
      "name": "-Z",
      "tip": [
        "将目标文件的 SELinux 安全上下文设为默认类型"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
