{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Move SOURCE to DEST, or multiple SOURCE(s) to DIRECTORY."
    ]
  },
  "option": [
    {
      "name": "--backup",
      "usage": [
        "--backup[=<CONTROL>]"
      ],
      "tip": [
        "make a backup of each existing destination file"
      ],
      "next": []
    },
    {
      "name": "--context",
      "usage": [
        "--context[=<CTX>]"
      ],
      "tip": [
        "like -Z, or if CTX is specified then set the SELinux security context to CTX"
      ],
      "next": []
    },
    {
      "name": "--debug",
      "tip": [
        "explain how a file is copied. Implies -v"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "do not prompt before overwriting"
      ]
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "prompt before override"
      ]
    },
    {
      "name": "--no-clobber",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-clobber"
      ],
      "tip": [
        "do not overwrite an existing file"
      ]
    },
    {
      "name": "--no-target-directory",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --no-target-directory"
      ],
      "tip": [
        "treat DEST as a normal file"
      ]
    },
    {
      "name": "--progress",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --progress"
      ],
      "tip": [
        "Display a progress bar. Note: this feature is not supported by GNU coreutils"
      ]
    },
    {
      "name": "--strip-trailing-slashes",
      "tip": [
        "remove any trailing slashes from each SOURCE argument"
      ]
    },
    {
      "name": "--suffix",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --suffix <SUFFIX>"
      ],
      "tip": [
        "override the usual backup suffix"
      ],
      "next": []
    },
    {
      "name": "--target-directory",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --target-directory <DIRECTORY>"
      ],
      "tip": [
        "move all SOURCE arguments into DIRECTORY"
      ],
      "next": []
    },
    {
      "name": "--update",
      "usage": [
        "--update[=<UPDATE>]"
      ],
      "tip": [
        "move only when the SOURCE file is newer than the destination file or when the destination file is missing"
      ],
      "next": [
        {
          "name": "all"
        },
        {
          "name": "none"
        },
        {
          "name": "none-fail"
        },
        {
          "name": "older"
        }
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "explain what is being done"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    },
    {
      "name": "-b",
      "tip": [
        "like --backup but does not accept an argument"
      ]
    },
    {
      "name": "-u",
      "tip": [
        "like --update but does not accept an argument"
      ]
    },
    {
      "name": "-Z",
      "tip": [
        "set SELinux security context of destination file to default type"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
