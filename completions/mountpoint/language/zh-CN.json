{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "检查目录或文件是否为挂载点。"
    ]
  },
  "option": [
    {
      "name": "--devno",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --devno"
      ],
      "tip": [
        "打印块设备的 maj:min 设备号。"
      ]
    },
    {
      "name": "--fs-devno",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --fs-devno"
      ],
      "tip": [
        "打印文件系统的 maj:min 设备号。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--nofollow",
      "tip": [
        "不跟随符号链接。"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "静默模式 - 不打印任何内容。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
