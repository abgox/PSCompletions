{
  "meta": {
    "url": "https://github.com/cantino/mcfly",
    "description": [
      "在 Shell 历史记录中快速穿梭"
    ]
  },
  "next": [
    {
      "name": "add",
      "usage": [
        "add [OPTIONS] [COMMAND]..."
      ],
      "tip": [
        "将命令添加到历史记录"
      ],
      "option": [
        {
          "name": "--append-to-histfile",
          "alias": [
            "-a"
          ],
          "usage": [
            "-a, --append-to-histfile <HISTFILE>"
          ],
          "tip": [
            "同时将命令追加到指定文件"
          ],
          "next": []
        },
        {
          "name": "--dir",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --dir <PATH>"
          ],
          "tip": [
            "命令执行时的目录（默认 $PWD）"
          ],
          "next": []
        },
        {
          "name": "--exit",
          "alias": [
            "-e"
          ],
          "usage": [
            "-e, --exit <EXIT_CODE>"
          ],
          "tip": [
            "命令的退出码"
          ],
          "next": []
        },
        {
          "name": "--old-dir",
          "alias": [
            "-o"
          ],
          "usage": [
            "-o, --old-dir <PATH>"
          ],
          "tip": [
            "执行命令前用户所在的目录（默认 $OLDPWD）"
          ],
          "next": []
        },
        {
          "name": "--when",
          "alias": [
            "-w"
          ],
          "usage": [
            "-w, --when <UNIX_EPOCH>"
          ],
          "tip": [
            "命令执行的时间（默认为当前时间）"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "dump",
      "usage": [
        "dump [OPTIONS]"
      ],
      "tip": [
        "将历史记录输出到标准输出；结果按时间戳排序"
      ],
      "option": [
        {
          "name": "--before",
          "usage": [
            "--before <BEFORE>"
          ],
          "tip": [
            "选择在此时间点之前运行的所有命令"
          ],
          "next": []
        },
        {
          "name": "--format",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --format <FORMAT>"
          ],
          "tip": [
            "输出格式（默认 json）"
          ],
          "next": [
            {
              "name": "csv",
              "tip": [
                "CSV 格式"
              ]
            },
            {
              "name": "json",
              "tip": [
                "JSON 格式"
              ]
            }
          ]
        },
        {
          "name": "--regex",
          "alias": [
            "-r"
          ],
          "usage": [
            "-r, --regex <REGEX>"
          ],
          "tip": [
            "要求命令匹配指定的正则表达式"
          ],
          "next": []
        },
        {
          "name": "--since",
          "usage": [
            "--since <SINCE>"
          ],
          "tip": [
            "选择在此时间点之后运行的所有命令"
          ],
          "next": []
        },
        {
          "name": "--sort",
          "alias": [
            "-s"
          ],
          "usage": [
            "-s, --sort <ORDER>"
          ],
          "tip": [
            "排序方式（默认 ASC）"
          ],
          "next": [
            {
              "name": "ASC",
              "tip": [
                "升序"
              ]
            },
            {
              "name": "DESC",
              "tip": [
                "降序"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "init",
      "usage": [
        "init <SHELL>"
      ],
      "tip": [
        "输出用于执行 mcfly 的 shell 代码"
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "为 bash 初始化"
          ]
        },
        {
          "name": "fish",
          "tip": [
            "为 fish 初始化"
          ]
        },
        {
          "name": "powershell",
          "tip": [
            "为 powershell 初始化"
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "为 zsh 初始化"
          ]
        }
      ]
    },
    {
      "name": "move",
      "usage": [
        "move <OLD_DIR_PATH> <NEW_DIR_PATH>"
      ],
      "tip": [
        "记录目录移动；将命令记录从旧路径迁移到新路径"
      ]
    },
    {
      "name": "search",
      "usage": [
        "search [OPTIONS] [COMMAND]..."
      ],
      "tip": [
        "搜索历史记录"
      ],
      "option": [
        {
          "name": "--delete_without_confirm",
          "tip": [
            "无需确认直接删除条目"
          ]
        },
        {
          "name": "--dir",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --dir <PATH>"
          ],
          "tip": [
            "命令执行时的目录（默认 $PWD）"
          ],
          "next": []
        },
        {
          "name": "--fuzzy",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --fuzzy <FUZZY>"
          ],
          "tip": [
            "模糊搜索结果。0 为关闭；数值越高，越倾向于匹配较短或较早的记录"
          ],
          "next": []
        },
        {
          "name": "--output-selection",
          "alias": [
            "-o"
          ],
          "usage": [
            "-o, --output-selection <PATH>"
          ],
          "tip": [
            "将结果写入文件，包含选择模式、新命令行以及特定 shell 的请求"
          ],
          "next": []
        },
        {
          "name": "--results",
          "alias": [
            "-r"
          ],
          "usage": [
            "-r, --results <NUMBER>"
          ],
          "tip": [
            "返回的结果数量"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "stats",
      "usage": [
        "stats [OPTIONS]"
      ],
      "tip": [
        "输出统计信息"
      ],
      "option": [
        {
          "name": "--cmds",
          "alias": [
            "-c"
          ],
          "usage": [
            "-c, --cmds <cmds>"
          ],
          "tip": [
            "\"top-n\"命令的数量（默认: 10）"
          ],
          "next": []
        },
        {
          "name": "--dirs",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --dirs <dirs>"
          ],
          "tip": [
            "按顶级目录分类显示（默认: 0，即不限制目录）"
          ],
          "next": []
        },
        {
          "name": "--global-commands-to-ignore",
          "alias": [
            "-g"
          ],
          "usage": [
            "-g, --global-commands-to-ignore <global_cmds_to_ignore>"
          ],
          "tip": [
            "全局忽略的命令数量（默认: 10）"
          ],
          "next": []
        },
        {
          "name": "--min-cmd-length",
          "alias": [
            "-m"
          ],
          "usage": [
            "-m, --min-cmd-length <min_cmd_length>"
          ],
          "tip": [
            "列入\"top-n\"命令的最小命令长度（默认: 0）"
          ],
          "next": []
        },
        {
          "name": "--only-dir",
          "alias": [
            "-o"
          ],
          "usage": [
            "-o, --only-dir <ONLY_DIR>"
          ],
          "tip": [
            "仅显示来自指定目录的命令"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "train",
      "usage": [
        "train [OPTIONS]"
      ],
      "tip": [
        "训练建议引擎（开发者工具）"
      ],
      "option": [
        {
          "name": "--refresh_cache",
          "alias": [
            "-r"
          ],
          "usage": [
            "-r, --refresh_cache"
          ],
          "tip": [
            "刷新建议缓存"
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "调试模式"
      ]
    },
    {
      "name": "--history_format",
      "usage": [
        "--history_format <FORMAT>"
      ],
      "tip": [
        "Shell 历史文件格式（默认: bash）"
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "Bash 历史格式"
          ]
        },
        {
          "name": "fish",
          "tip": [
            "Fish 历史格式"
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "Zsh 历史格式"
          ]
        },
        {
          "name": "zsh-extended",
          "tip": [
            "Zsh 扩展历史格式"
          ]
        }
      ]
    },
    {
      "name": "--mcfly_history",
      "usage": [
        "--mcfly_history <MCFLY_HISTORY>"
      ],
      "tip": [
        "添加或搜索时读取的 shell 历史文件（默认 $MCFLY_HISTORY）"
      ],
      "next": []
    },
    {
      "name": "--session_id",
      "usage": [
        "--session_id <SESSION_ID>"
      ],
      "tip": [
        "记录或搜索时使用的会话 ID（默认 $MCFLY_SESSION_ID）"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息"
      ]
    }
  ]
}
