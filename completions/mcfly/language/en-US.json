{
  "meta": {
    "url": "https://github.com/cantino/mcfly",
    "description": [
      "Fly through your shell history"
    ]
  },
  "next": [
    {
      "name": "add",
      "usage": [
        "add [OPTIONS] [COMMAND]..."
      ],
      "tip": [
        "Add commands to the history"
      ],
      "option": [
        {
          "name": "--append-to-histfile",
          "alias": [
            "-a"
          ],
          "usage": [
            "-a, --append-to-histfile <HISTFILE>"
          ],
          "tip": [
            "Also append command to the given file"
          ],
          "next": []
        },
        {
          "name": "--dir",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --dir <PATH>"
          ],
          "tip": [
            "Directory where command was run (default $PWD)"
          ],
          "next": []
        },
        {
          "name": "--exit",
          "alias": [
            "-e"
          ],
          "usage": [
            "-e, --exit <EXIT_CODE>"
          ],
          "tip": [
            "Exit code of command"
          ],
          "next": []
        },
        {
          "name": "--old-dir",
          "alias": [
            "-o"
          ],
          "usage": [
            "-o, --old-dir <PATH>"
          ],
          "tip": [
            "The previous directory the user was in before running the command (default $OLDPWD)"
          ],
          "next": []
        },
        {
          "name": "--when",
          "alias": [
            "-w"
          ],
          "usage": [
            "-w, --when <UNIX_EPOCH>"
          ],
          "tip": [
            "The time that the command was run (default now)"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "dump",
      "usage": [
        "dump [OPTIONS]"
      ],
      "tip": [
        "Dump history into stdout; the results are sorted by timestamp"
      ],
      "option": [
        {
          "name": "--before",
          "usage": [
            "--before <BEFORE>"
          ],
          "tip": [
            "Select all commands ran before the point"
          ],
          "next": []
        },
        {
          "name": "--format",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --format <FORMAT>"
          ],
          "tip": [
            "The format to dump in (default json)"
          ],
          "next": [
            {
              "name": "csv",
              "tip": [
                "CSV format"
              ]
            },
            {
              "name": "json",
              "tip": [
                "JSON format"
              ]
            }
          ]
        },
        {
          "name": "--regex",
          "alias": [
            "-r"
          ],
          "usage": [
            "-r, --regex <REGEX>"
          ],
          "tip": [
            "Require commands to match the pattern"
          ],
          "next": []
        },
        {
          "name": "--since",
          "usage": [
            "--since <SINCE>"
          ],
          "tip": [
            "Select all commands ran since the point"
          ],
          "next": []
        },
        {
          "name": "--sort",
          "alias": [
            "-s"
          ],
          "usage": [
            "-s, --sort <ORDER>"
          ],
          "tip": [
            "Sort order (default ASC)"
          ],
          "next": [
            {
              "name": "ASC",
              "tip": [
                "Ascending order"
              ]
            },
            {
              "name": "DESC",
              "tip": [
                "Descending order"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "init",
      "usage": [
        "init <SHELL>"
      ],
      "tip": [
        "Prints the shell code used to execute mcfly"
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "Initialize for bash"
          ]
        },
        {
          "name": "fish",
          "tip": [
            "Initialize for fish"
          ]
        },
        {
          "name": "powershell",
          "tip": [
            "Initialize for powershell"
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "Initialize for zsh"
          ]
        }
      ]
    },
    {
      "name": "move",
      "usage": [
        "move <OLD_DIR_PATH> <NEW_DIR_PATH>"
      ],
      "tip": [
        "Record a directory having been moved; moves command records from the old path to the new one"
      ]
    },
    {
      "name": "search",
      "usage": [
        "search [OPTIONS] [COMMAND]..."
      ],
      "tip": [
        "Search the history"
      ],
      "option": [
        {
          "name": "--delete_without_confirm",
          "tip": [
            "Delete entry without confirm"
          ]
        },
        {
          "name": "--dir",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --dir <PATH>"
          ],
          "tip": [
            "Directory where command was run (default $PWD)"
          ],
          "next": []
        },
        {
          "name": "--fuzzy",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --fuzzy <FUZZY>"
          ],
          "tip": [
            "Fuzzy-find results. 0 is off; higher numbers weight shorter/earlier matches more"
          ],
          "next": []
        },
        {
          "name": "--output-selection",
          "alias": [
            "-o"
          ],
          "usage": [
            "-o, --output-selection <PATH>"
          ],
          "tip": [
            "Write results to file, including selection mode, new commandline, and any shell-specific requests"
          ],
          "next": []
        },
        {
          "name": "--results",
          "alias": [
            "-r"
          ],
          "usage": [
            "-r, --results <NUMBER>"
          ],
          "tip": [
            "Number of results to return"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "stats",
      "usage": [
        "stats [OPTIONS]"
      ],
      "tip": [
        "Prints stats"
      ],
      "option": [
        {
          "name": "--cmds",
          "alias": [
            "-c"
          ],
          "usage": [
            "-c, --cmds <cmds>"
          ],
          "tip": [
            "The number of \"top-n\" commands (default: 10)"
          ],
          "next": []
        },
        {
          "name": "--dirs",
          "alias": [
            "-d"
          ],
          "usage": [
            "-d, --dirs <dirs>"
          ],
          "tip": [
            "Break down by top directories (default: 0, which doesn't limit by directory)"
          ],
          "next": []
        },
        {
          "name": "--global-commands-to-ignore",
          "alias": [
            "-g"
          ],
          "usage": [
            "-g, --global-commands-to-ignore <global_cmds_to_ignore>"
          ],
          "tip": [
            "Global commands to ignore (default: 10)"
          ],
          "next": []
        },
        {
          "name": "--min-cmd-length",
          "alias": [
            "-m"
          ],
          "usage": [
            "-m, --min-cmd-length <min_cmd_length>"
          ],
          "tip": [
            "The minimum command length to be listed in the \"top-n\" commands (default: 0)"
          ],
          "next": []
        },
        {
          "name": "--only-dir",
          "alias": [
            "-o"
          ],
          "usage": [
            "-o, --only-dir <ONLY_DIR>"
          ],
          "tip": [
            "Only show commands from a given directory"
          ],
          "next": []
        }
      ]
    },
    {
      "name": "train",
      "usage": [
        "train [OPTIONS]"
      ],
      "tip": [
        "Train the suggestion engine (developer tool)"
      ],
      "option": [
        {
          "name": "--refresh_cache",
          "alias": [
            "-r"
          ],
          "usage": [
            "-r, --refresh_cache"
          ],
          "tip": [
            "Refresh the suggestion cache"
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--debug",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --debug"
      ],
      "tip": [
        "Debug"
      ]
    },
    {
      "name": "--history_format",
      "usage": [
        "--history_format <FORMAT>"
      ],
      "tip": [
        "Shell history file format (default: bash)"
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "Bash history format"
          ]
        },
        {
          "name": "fish",
          "tip": [
            "Fish history format"
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "Zsh history format"
          ]
        },
        {
          "name": "zsh-extended",
          "tip": [
            "Zsh extended history format"
          ]
        }
      ]
    },
    {
      "name": "--mcfly_history",
      "usage": [
        "--mcfly_history <MCFLY_HISTORY>"
      ],
      "tip": [
        "Shell history file to read from when adding or searching (defaults to $MCFLY_HISTORY)"
      ],
      "next": []
    },
    {
      "name": "--session_id",
      "usage": [
        "--session_id <SESSION_ID>"
      ],
      "tip": [
        "Session ID to record or search under (defaults to $MCFLY_SESSION_ID)"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
