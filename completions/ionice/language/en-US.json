{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Show or change the I/O-scheduling class and priority of a process."
    ]
  },
  "option": [
    {
      "name": "--class",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --class <class>"
      ],
      "tip": [
        "Name or number of the scheduling class.",
        "Possible values: none, realtime, best-effort, idle",
        "Numbers: 0 none, 1 realtime, 2 best-effort, 3 idle"
      ],
      "next": [
        {
          "name": "best-effort"
        },
        {
          "name": "idle"
        },
        {
          "name": "none"
        },
        {
          "name": "realtime"
        }
      ]
    },
    {
      "name": "--classdata",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --classdata <num>"
      ],
      "tip": [
        "Priority (0..7) in the specified scheduling class.",
        "Only for the realtime and best-effort classes."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--ignore",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --ignore"
      ],
      "tip": [
        "Ignore failures."
      ]
    },
    {
      "name": "--pgid",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pgid <pgrp>..."
      ],
      "tip": [
        "Act on already running processes in these groups."
      ],
      "next": []
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid <pid>..."
      ],
      "tip": [
        "Act on these already running processes."
      ],
      "next": []
    },
    {
      "name": "--uid",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uid <uid>..."
      ],
      "tip": [
        "Act on already running processes owned by these users."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
