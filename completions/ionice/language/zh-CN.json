{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示或更改进程的 I/O 调度类和优先级。"
    ]
  },
  "option": [
    {
      "name": "--class",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --class <class>"
      ],
      "tip": [
        "调度类的名称或编号。",
        "可能值: none, realtime, best-effort, idle",
        "编号: 0 none，1 realtime，2 best-effort，3 idle"
      ],
      "next": [
        {
          "name": "best-effort"
        },
        {
          "name": "idle"
        },
        {
          "name": "none"
        },
        {
          "name": "realtime"
        }
      ]
    },
    {
      "name": "--classdata",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --classdata <num>"
      ],
      "tip": [
        "指定调度类中的优先级（0..7）。",
        "仅适用于 realtime 和 best-effort 类。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--ignore",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --ignore"
      ],
      "tip": [
        "忽略失败。"
      ]
    },
    {
      "name": "--pgid",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --pgid <pgrp>..."
      ],
      "tip": [
        "对已在这些组中运行的进程执行操作。"
      ],
      "next": []
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid <pid>..."
      ],
      "tip": [
        "对这些已运行的进程执行操作。"
      ],
      "next": []
    },
    {
      "name": "--uid",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uid <uid>..."
      ],
      "tip": [
        "对由这些用户拥有的已运行进程执行操作。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
