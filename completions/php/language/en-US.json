{
  "meta": {
    "url": "https://www.php.net",
    "description": [
      "PHP Command Line Interface (CLI)."
    ]
  },
  "option": [
    {
      "name": "--define",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --define <foo[=bar]>"
      ],
      "tip": [
        "Define INI entry foo with value 'bar'."
      ],
      "next": []
    },
    {
      "name": "--docroot",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --docroot <docroot>"
      ],
      "tip": [
        "Specify the document root for the built-in web server."
      ],
      "next": []
    },
    {
      "name": "--file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file <file>"
      ],
      "tip": [
        "Parse and execute <file>."
      ],
      "next": []
    },
    {
      "name": "--hide-args",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --hide-args"
      ],
      "tip": [
        "Hide script name and parameters from external tools.",
        "Use it when the command line contains sensitive data such as passwords."
      ]
    },
    {
      "name": "--info",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --info"
      ],
      "tip": [
        "Display PHP information and configuration."
      ]
    },
    {
      "name": "--ini",
      "usage": [
        "--ini[=diff]"
      ],
      "tip": [
        "Show configuration file names.",
        "Use --ini=diff to show INI entries that differ from the built-in default."
      ]
    },
    {
      "name": "--interactive",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --interactive"
      ],
      "tip": [
        "Run as interactive shell (requires the readline extension)."
      ]
    },
    {
      "name": "--modules",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --modules"
      ],
      "tip": [
        "Show compiled-in modules."
      ]
    },
    {
      "name": "--no-chdir",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --no-chdir"
      ],
      "tip": [
        "(CGI only) Do not chdir to the script's directory."
      ]
    },
    {
      "name": "--no-header",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --no-header"
      ],
      "tip": [
        "(CGI only) Quiet-mode.",
        "Suppress HTTP header output."
      ]
    },
    {
      "name": "--no-php-ini",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-php-ini"
      ],
      "tip": [
        "Do not use any configuration (ini) files."
      ]
    },
    {
      "name": "--php-ini",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --php-ini <path>|<file>"
      ],
      "tip": [
        "Look for php.ini file in the given directory, or use the given file."
      ],
      "next": []
    },
    {
      "name": "--process-begin",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --process-begin <code>"
      ],
      "tip": [
        "Run PHP <code> before processing input lines."
      ],
      "next": []
    },
    {
      "name": "--process-code",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --process-code <code>"
      ],
      "tip": [
        "Run PHP <code> for every input line."
      ],
      "next": []
    },
    {
      "name": "--process-end",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --process-end <code>"
      ],
      "tip": [
        "Run PHP <code> after processing all input lines."
      ],
      "next": []
    },
    {
      "name": "--process-file",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --process-file <file>"
      ],
      "tip": [
        "Parse and execute <file> for every input line."
      ],
      "next": []
    },
    {
      "name": "--rclass",
      "alias": [
        "--rc"
      ],
      "usage": [
        "--rc, --rclass <name>"
      ],
      "tip": [
        "Show information about class <name>."
      ],
      "next": []
    },
    {
      "name": "--repeat",
      "usage": [
        "--repeat <count>"
      ],
      "tip": [
        "Repeat script execution <count> times.",
        "For internal purposes only."
      ],
      "next": []
    },
    {
      "name": "--rextension",
      "alias": [
        "--re"
      ],
      "usage": [
        "--re, --rextension <name>"
      ],
      "tip": [
        "Show information about extension <name>."
      ],
      "next": []
    },
    {
      "name": "--rextinfo",
      "alias": [
        "--ri"
      ],
      "usage": [
        "--ri, --rextinfo <name>"
      ],
      "tip": [
        "Show configuration for extension <name>."
      ],
      "next": []
    },
    {
      "name": "--rfunction",
      "alias": [
        "--rf"
      ],
      "usage": [
        "--rf, --rfunction <name>"
      ],
      "tip": [
        "Show information about function <name>."
      ],
      "next": []
    },
    {
      "name": "--run",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --run <code>"
      ],
      "tip": [
        "Run PHP <code> without using script tags <?..?>."
      ],
      "next": []
    },
    {
      "name": "--rzendextension",
      "alias": [
        "--rz"
      ],
      "usage": [
        "--rz, --rzendextension <name>"
      ],
      "tip": [
        "Show information about Zend extension <name>."
      ],
      "next": []
    },
    {
      "name": "--server",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --server <addr>:<port>"
      ],
      "tip": [
        "Run the built-in web server on the given local address and port."
      ],
      "next": []
    },
    {
      "name": "--strip",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --strip"
      ],
      "tip": [
        "Output source with stripped comments and whitespace."
      ]
    },
    {
      "name": "--syntax-check",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --syntax-check"
      ],
      "tip": [
        "Syntax check only (lint)."
      ]
    },
    {
      "name": "--syntax-highlight",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --syntax-highlight"
      ],
      "tip": [
        "Output HTML syntax highlighted source."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Display the PHP version."
      ]
    },
    {
      "name": "-e",
      "tip": [
        "Generate extended information for debugger/profiler."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help and exit."
      ]
    }
  ]
}
