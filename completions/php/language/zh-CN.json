{
  "meta": {
    "url": "https://www.php.net",
    "description": [
      "PHP 命令行界面 (CLI)。"
    ]
  },
  "option": [
    {
      "name": "--define",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --define <foo[=bar]>"
      ],
      "tip": [
        "定义 INI 条目 foo，值为 'bar'。"
      ],
      "next": []
    },
    {
      "name": "--docroot",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --docroot <docroot>"
      ],
      "tip": [
        "指定内置 Web 服务器的文档根目录。"
      ],
      "next": []
    },
    {
      "name": "--file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file <file>"
      ],
      "tip": [
        "解析并执行 <file>。"
      ],
      "next": []
    },
    {
      "name": "--hide-args",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --hide-args"
      ],
      "tip": [
        "对外部工具隐藏脚本名和参数。",
        "当命令行包含密码等敏感数据时使用。"
      ]
    },
    {
      "name": "--info",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --info"
      ],
      "tip": [
        "显示 PHP 信息和配置。"
      ]
    },
    {
      "name": "--ini",
      "usage": [
        "--ini[=diff]"
      ],
      "tip": [
        "显示配置文件名。",
        "使用 --ini=diff 显示与内置默认值不同的 INI 条目。"
      ]
    },
    {
      "name": "--interactive",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --interactive"
      ],
      "tip": [
        "以交互式 shell 方式运行 (需要 readline 扩展)。"
      ]
    },
    {
      "name": "--modules",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --modules"
      ],
      "tip": [
        "显示已编译的模块。"
      ]
    },
    {
      "name": "--no-chdir",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --no-chdir"
      ],
      "tip": [
        "(仅 CGI) 不切换到脚本所在目录。"
      ]
    },
    {
      "name": "--no-header",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --no-header"
      ],
      "tip": [
        "(仅 CGI) 安静模式。",
        "抑制 HTTP 头部输出。"
      ]
    },
    {
      "name": "--no-php-ini",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-php-ini"
      ],
      "tip": [
        "不使用任何配置 (ini) 文件。"
      ]
    },
    {
      "name": "--php-ini",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --php-ini <path>|<file>"
      ],
      "tip": [
        "在给定目录中查找 php.ini 文件，或使用给定的文件。"
      ],
      "next": []
    },
    {
      "name": "--process-begin",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --process-begin <code>"
      ],
      "tip": [
        "在处理输入行之前运行 PHP <code>。"
      ],
      "next": []
    },
    {
      "name": "--process-code",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --process-code <code>"
      ],
      "tip": [
        "对每个输入行运行 PHP <code>。"
      ],
      "next": []
    },
    {
      "name": "--process-end",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --process-end <code>"
      ],
      "tip": [
        "处理完所有输入行后运行 PHP <code>。"
      ],
      "next": []
    },
    {
      "name": "--process-file",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --process-file <file>"
      ],
      "tip": [
        "对每个输入行解析并执行 <file>。"
      ],
      "next": []
    },
    {
      "name": "--rclass",
      "alias": [
        "--rc"
      ],
      "usage": [
        "--rc, --rclass <name>"
      ],
      "tip": [
        "显示类 <name> 的信息。"
      ],
      "next": []
    },
    {
      "name": "--repeat",
      "usage": [
        "--repeat <count>"
      ],
      "tip": [
        "重复执行脚本 <count> 次。",
        "仅供内部使用。"
      ],
      "next": []
    },
    {
      "name": "--rextension",
      "alias": [
        "--re"
      ],
      "usage": [
        "--re, --rextension <name>"
      ],
      "tip": [
        "显示扩展 <name> 的信息。"
      ],
      "next": []
    },
    {
      "name": "--rextinfo",
      "alias": [
        "--ri"
      ],
      "usage": [
        "--ri, --rextinfo <name>"
      ],
      "tip": [
        "显示扩展 <name> 的配置。"
      ],
      "next": []
    },
    {
      "name": "--rfunction",
      "alias": [
        "--rf"
      ],
      "usage": [
        "--rf, --rfunction <name>"
      ],
      "tip": [
        "显示函数 <name> 的信息。"
      ],
      "next": []
    },
    {
      "name": "--run",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --run <code>"
      ],
      "tip": [
        "运行 PHP <code>，无需使用脚本标签 <?..?>。"
      ],
      "next": []
    },
    {
      "name": "--rzendextension",
      "alias": [
        "--rz"
      ],
      "usage": [
        "--rz, --rzendextension <name>"
      ],
      "tip": [
        "显示 Zend 扩展 <name> 的信息。"
      ],
      "next": []
    },
    {
      "name": "--server",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --server <addr>:<port>"
      ],
      "tip": [
        "在给定的本地地址和端口上运行内置 Web 服务器。"
      ],
      "next": []
    },
    {
      "name": "--strip",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --strip"
      ],
      "tip": [
        "输出去除注释和空白后的源代码。"
      ]
    },
    {
      "name": "--syntax-check",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --syntax-check"
      ],
      "tip": [
        "仅做语法检查 (lint)。"
      ]
    },
    {
      "name": "--syntax-highlight",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --syntax-highlight"
      ],
      "tip": [
        "输出 HTML 语法高亮的源代码。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示 PHP 版本。"
      ]
    },
    {
      "name": "-e",
      "tip": [
        "为调试器/分析器生成扩展信息。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助并退出。"
      ]
    }
  ]
}
