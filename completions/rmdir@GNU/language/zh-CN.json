{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "删除这些目录（如果它们为空）。"
    ]
  },
  "option": [
    {
      "name": "--ignore-fail-on-non-empty",
      "tip": [
        "忽略每一次删除非空目录的失败"
      ]
    },
    {
      "name": "--parents",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --parents"
      ],
      "tip": [
        "删除 DIRECTORY 及其各级父目录；例如 rmdir -p a/b 类似于 rmdir a/b a"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "为处理的每个目录输出一条诊断信息"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
