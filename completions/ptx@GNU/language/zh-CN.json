{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "输出输入文件中各词（含上下文）的置换索引。"
    ]
  },
  "option": [
    {
      "name": "--auto-reference",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --auto-reference"
      ],
      "tip": [
        "输出自动生成的引用"
      ]
    },
    {
      "name": "--break-file",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --break-file <FILE>"
      ],
      "tip": [
        "该 FILE 中的分词字符"
      ],
      "next": []
    },
    {
      "name": "--flag-truncation",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --flag-truncation <STRING>"
      ],
      "tip": [
        "用 STRING 标记行截断处，默认是 '/'"
      ],
      "next": []
    },
    {
      "name": "--format",
      "alias": [
        "-O",
        "-T"
      ],
      "usage": [
        "-O, --format=roff",
        "-T, --format=tex"
      ],
      "tip": [
        "以 roff 指令的形式生成输出",
        "以 TeX 指令的形式生成输出"
      ],
      "next": [
        {
          "name": "roff"
        },
        {
          "name": "tex"
        }
      ]
    },
    {
      "name": "--gap-size",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --gap-size <NUMBER>"
      ],
      "tip": [
        "输出各字段之间的列间距"
      ],
      "next": []
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --ignore-case"
      ],
      "tip": [
        "排序时把字母折叠为小写转大写"
      ]
    },
    {
      "name": "--ignore-file",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-file <FILE>"
      ],
      "tip": [
        "从 FILE 读取忽略词表"
      ],
      "next": []
    },
    {
      "name": "--macro-name",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --macro-name <STRING>"
      ],
      "tip": [
        "宏名，代替 'xx'"
      ],
      "next": []
    },
    {
      "name": "--only-file",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --only-file <FILE>"
      ],
      "tip": [
        "只从该 FILE 读取词表"
      ],
      "next": []
    },
    {
      "name": "--references",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --references"
      ],
      "tip": [
        "每行的第一个字段是一个引用"
      ]
    },
    {
      "name": "--right-side-refs",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --right-side-refs"
      ],
      "tip": [
        "将引用放在右侧，不计入 -w 宽度"
      ]
    },
    {
      "name": "--sentence-regexp",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --sentence-regexp <REGEXP>"
      ],
      "tip": [
        "用于行尾或句尾"
      ],
      "next": []
    },
    {
      "name": "--traditional",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --traditional"
      ],
      "tip": [
        "行为更接近 System V 的 'ptx'"
      ]
    },
    {
      "name": "--typeset-mode",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --typeset-mode"
      ],
      "tip": [
        "未实现"
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <NUMBER>"
      ],
      "tip": [
        "输出列宽，不含引用部分"
      ],
      "next": []
    },
    {
      "name": "--word-regexp",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --word-regexp <REGEXP>"
      ],
      "tip": [
        "用 REGEXP 匹配每个关键字"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
