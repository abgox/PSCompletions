{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Find overridden configuration files."
    ]
  },
  "option": [
    {
      "name": "--diff",
      "usage": [
        "--diff[=1|0]"
      ],
      "tip": [
        "Show a diff when overridden files differ."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type=LIST..."
      ],
      "tip": [
        "Only display the selected override types, comma separated.",
        "Possible values: masked, equivalent, redirected, overridden, extended, unchanged"
      ],
      "separator": ",",
      "next": [
        {
          "name": "equivalent"
        },
        {
          "name": "extended"
        },
        {
          "name": "masked"
        },
        {
          "name": "overridden"
        },
        {
          "name": "redirected"
        },
        {
          "name": "unchanged"
        }
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    }
  ]
}
