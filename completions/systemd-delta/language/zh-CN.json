{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "查找被覆盖的配置文件。"
    ]
  },
  "option": [
    {
      "name": "--diff",
      "usage": [
        "--diff[=1|0]"
      ],
      "tip": [
        "被覆盖文件不同时显示差异。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type=LIST..."
      ],
      "tip": [
        "仅显示选定的覆盖类型，以逗号分隔。",
        "可能值: masked, equivalent, redirected, overridden, extended, unchanged"
      ],
      "separator": ",",
      "next": [
        {
          "name": "equivalent"
        },
        {
          "name": "extended"
        },
        {
          "name": "masked"
        },
        {
          "name": "overridden"
        },
        {
          "name": "redirected"
        },
        {
          "name": "unchanged"
        }
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    }
  ]
}
