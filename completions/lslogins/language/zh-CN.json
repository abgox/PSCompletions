{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示系统中已知用户的信息。"
    ]
  },
  "option": [
    {
      "name": "--acc-expiration",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --acc-expiration"
      ],
      "tip": [
        "显示密码过期信息。"
      ]
    },
    {
      "name": "--btmp-file",
      "usage": [
        "--btmp-file <path>"
      ],
      "tip": [
        "为 btmp 设置替代路径。"
      ],
      "next": []
    },
    {
      "name": "--colon-separate",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --colon-separate"
      ],
      "tip": [
        "以类似 /etc/passwd 的格式显示数据。"
      ]
    },
    {
      "name": "--context",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --context"
      ],
      "tip": [
        "显示 SELinux 上下文。"
      ]
    },
    {
      "name": "--export",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --export"
      ],
      "tip": [
        "以可导出的输出格式显示。"
      ]
    },
    {
      "name": "--failed",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --failed"
      ],
      "tip": [
        "显示用户最近失败登录的信息。"
      ]
    },
    {
      "name": "--groups",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --groups=<groups>"
      ],
      "tip": [
        "显示属于 <groups> 中某组的用户。"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--last",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --last"
      ],
      "tip": [
        "显示用户最近登录会话的信息。"
      ]
    },
    {
      "name": "--lastlog",
      "usage": [
        "--lastlog <path>"
      ],
      "tip": [
        "为 lastlog 设置替代路径。"
      ],
      "next": []
    },
    {
      "name": "--lastlog2",
      "usage": [
        "--lastlog2 <path>"
      ],
      "tip": [
        "为 lastlog2 设置替代路径。"
      ],
      "next": []
    },
    {
      "name": "--logins",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --logins=<logins>"
      ],
      "tip": [
        "仅显示 <logins> 中的用户。"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--newline",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --newline"
      ],
      "tip": [
        "每项信息显示在新的一行。"
      ]
    },
    {
      "name": "--noheadings",
      "tip": [
        "不打印标题。"
      ]
    },
    {
      "name": "--notruncate",
      "tip": [
        "不截断输出。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output[=<list>]"
      ],
      "tip": [
        "定义要输出的列。"
      ],
      "next": []
    },
    {
      "name": "--output-all",
      "tip": [
        "输出所有列。"
      ]
    },
    {
      "name": "--print0",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --print0"
      ],
      "tip": [
        "用 nul 字符分隔用户条目。"
      ]
    },
    {
      "name": "--pwd",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pwd"
      ],
      "tip": [
        "显示与密码登录相关的信息。"
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "以原始模式显示。"
      ]
    },
    {
      "name": "--shell",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --shell"
      ],
      "tip": [
        "使用可用作 shell 变量标识符的列名。"
      ]
    },
    {
      "name": "--supp-groups",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --supp-groups"
      ],
      "tip": [
        "显示组信息。"
      ]
    },
    {
      "name": "--system-accs",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --system-accs"
      ],
      "tip": [
        "显示系统账户。"
      ]
    },
    {
      "name": "--time-format",
      "usage": [
        "--time-format=<type>"
      ],
      "tip": [
        "以 short、full 或 iso 格式显示日期。",
        "可能值: short, full, iso"
      ],
      "next": [
        {
          "name": "full"
        },
        {
          "name": "iso"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--user-accs",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user-accs"
      ],
      "tip": [
        "显示用户账户。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--wtmp-file",
      "usage": [
        "--wtmp-file <path>"
      ],
      "tip": [
        "为 wtmp 设置替代路径。"
      ],
      "next": []
    }
  ]
}
