{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "用给定的 NAME 创建具名管道（FIFO）。"
    ]
  },
  "option": [
    {
      "name": "--context",
      "usage": [
        "--context[=CTX]"
      ],
      "tip": [
        "与 -Z 相同；如果指定了 CTX，则把 SELinux 或 SMACK 安全上下文设为 CTX"
      ],
      "next": []
    },
    {
      "name": "--mode",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mode <MODE>"
      ],
      "tip": [
        "把文件权限位设为 MODE，而不是 a=rw 减去 umask"
      ],
      "next": []
    },
    {
      "name": "-Z",
      "tip": [
        "把 SELinux 安全上下文设为默认类型"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
