{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "配置多处理器系统中的 CPU。"
    ]
  },
  "option": [
    {
      "name": "--configure",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --configure <cpu-list>"
      ],
      "tip": [
        "配置 CPU。"
      ],
      "next": []
    },
    {
      "name": "--deconfigure",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --deconfigure <cpu-list>"
      ],
      "tip": [
        "取消配置 CPU。"
      ],
      "next": []
    },
    {
      "name": "--disable",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --disable <cpu-list>"
      ],
      "tip": [
        "禁用 CPU。"
      ],
      "next": []
    },
    {
      "name": "--dispatch",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --dispatch <mode>"
      ],
      "tip": [
        "设置调度模式。"
      ],
      "next": []
    },
    {
      "name": "--enable",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --enable <cpu-list>"
      ],
      "tip": [
        "启用 CPU。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--rescan",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --rescan"
      ],
      "tip": [
        "触发 CPU 重新扫描。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
