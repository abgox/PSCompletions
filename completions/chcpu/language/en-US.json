{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Configure CPUs in a multi-processor system."
    ]
  },
  "option": [
    {
      "name": "--configure",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --configure <cpu-list>"
      ],
      "tip": [
        "Configure cpus."
      ],
      "next": []
    },
    {
      "name": "--deconfigure",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --deconfigure <cpu-list>"
      ],
      "tip": [
        "Deconfigure cpus."
      ],
      "next": []
    },
    {
      "name": "--disable",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --disable <cpu-list>"
      ],
      "tip": [
        "Disable cpus."
      ],
      "next": []
    },
    {
      "name": "--dispatch",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --dispatch <mode>"
      ],
      "tip": [
        "Set dispatching mode."
      ],
      "next": []
    },
    {
      "name": "--enable",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --enable <cpu-list>"
      ],
      "tip": [
        "Enable cpus."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--rescan",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --rescan"
      ],
      "tip": [
        "Trigger rescan of cpus."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
