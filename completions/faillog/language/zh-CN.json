{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "显示 faillog 记录或设置登录失败限制。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "显示（或操作）faillog 数据库中有条目的所有用户的记录。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--lock-secs",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --lock-secs <SEC>"
      ],
      "tip": [
        "登录失败后锁定账户 SEC 秒。"
      ],
      "next": []
    },
    {
      "name": "--maximum",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --maximum <MAX>"
      ],
      "tip": [
        "设置账户被禁用前的最大登录失败次数。",
        "值为 0 表示不限制失败登录次数。"
      ],
      "next": []
    },
    {
      "name": "--reset",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --reset"
      ],
      "tip": [
        "重置登录失败计数器。"
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--time",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --time <DAYS>"
      ],
      "tip": [
        "显示比 DAYS 更近的 faillog 记录。"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <LOGIN|RANGE>"
      ],
      "tip": [
        "仅显示或维护指定用户的记录。",
        "可以使用登录名、数字用户 ID 或 UID 范围。"
      ],
      "next": []
    }
  ]
}
