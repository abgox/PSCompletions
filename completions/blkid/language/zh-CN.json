{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "查找或打印块设备属性。"
    ]
  },
  "option": [
    {
      "name": "--cache-file",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --cache-file <file>"
      ],
      "tip": [
        "从 FILE 而不是默认缓存文件读取。",
        "-c /dev/null 表示不使用缓存。"
      ],
      "next": []
    },
    {
      "name": "--garbage-collect",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --garbage-collect"
      ],
      "tip": [
        "清理 blkid 缓存。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--hint",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --hint <value>"
      ],
      "tip": [
        "为探测函数设置提示。"
      ],
      "next": []
    },
    {
      "name": "--info",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --info"
      ],
      "tip": [
        "收集 I/O 限制信息。"
      ]
    },
    {
      "name": "--label",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --label <label>"
      ],
      "tip": [
        "将 LABEL 转换为设备名。"
      ],
      "next": []
    },
    {
      "name": "--list-filesystems",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --list-filesystems"
      ],
      "tip": [
        "列出所有已知文件系统/RAID 后退出。"
      ]
    },
    {
      "name": "--list-one",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list-one"
      ],
      "tip": [
        "仅查找由 -t 指定令牌的第一个设备。"
      ]
    },
    {
      "name": "--match-tag",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --match-tag <tag>"
      ],
      "tip": [
        "显示指定的标签（默认: 显示所有标签）。"
      ],
      "next": []
    },
    {
      "name": "--match-token",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --match-token <token>"
      ],
      "tip": [
        "查找具有特定令牌（NAME=value 对）的设备。"
      ],
      "next": []
    },
    {
      "name": "--match-types",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --match-types <list>"
      ],
      "tip": [
        "按文件系统类型过滤（例如 -n vfat,ext3）。"
      ],
      "next": []
    },
    {
      "name": "--no-encoding",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --no-encoding"
      ],
      "tip": [
        "不编码不可打印字符。"
      ]
    },
    {
      "name": "--no-part-details",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --no-part-details"
      ],
      "tip": [
        "不打印分区表信息。"
      ]
    },
    {
      "name": "--offset",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --offset <offset>"
      ],
      "tip": [
        "在给定偏移处探测。"
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <format>"
      ],
      "tip": [
        "输出格式。",
        "可能值: value, device, export, json, full",
        "默认: full"
      ],
      "next": [
        {
          "name": "device"
        },
        {
          "name": "export"
        },
        {
          "name": "full"
        },
        {
          "name": "json"
        },
        {
          "name": "value"
        }
      ]
    },
    {
      "name": "--probe",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --probe"
      ],
      "tip": [
        "低级超级块探测（绕过缓存）。"
      ]
    },
    {
      "name": "--size",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --size <size>"
      ],
      "tip": [
        "覆盖设备大小。"
      ],
      "next": []
    },
    {
      "name": "--usages",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --usages <list>"
      ],
      "tip": [
        "按用途过滤。",
        "可能值: filesystem, raid, crypto, other",
        "在值前加 no 可排除该用途。"
      ],
      "separator": ",",
      "next": [
        {
          "name": "crypto"
        },
        {
          "name": "filesystem"
        },
        {
          "name": "other"
        },
        {
          "name": "raid"
        }
      ]
    },
    {
      "name": "--uuid",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --uuid <uuid>"
      ],
      "tip": [
        "将 UUID 转换为设备名。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
