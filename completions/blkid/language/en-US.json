{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Locate or print block device attributes."
    ]
  },
  "option": [
    {
      "name": "--cache-file",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --cache-file <file>"
      ],
      "tip": [
        "Read from FILE instead of the default cache file.",
        "-c /dev/null means no cache."
      ],
      "next": []
    },
    {
      "name": "--garbage-collect",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --garbage-collect"
      ],
      "tip": [
        "Garbage collect the blkid cache."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--hint",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --hint <value>"
      ],
      "tip": [
        "Set hint for probing function."
      ],
      "next": []
    },
    {
      "name": "--info",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --info"
      ],
      "tip": [
        "Gather information about I/O limits."
      ]
    },
    {
      "name": "--label",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --label <label>"
      ],
      "tip": [
        "Convert LABEL to device name."
      ],
      "next": []
    },
    {
      "name": "--list-filesystems",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --list-filesystems"
      ],
      "tip": [
        "List all known filesystems/RAIDs and exit."
      ]
    },
    {
      "name": "--list-one",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list-one"
      ],
      "tip": [
        "Look up only first device with token specified by -t."
      ]
    },
    {
      "name": "--match-tag",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --match-tag <tag>"
      ],
      "tip": [
        "Show specified tag(s) (default: show all tags)."
      ],
      "next": []
    },
    {
      "name": "--match-token",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --match-token <token>"
      ],
      "tip": [
        "Find device with a specific token (NAME=value pair)."
      ],
      "next": []
    },
    {
      "name": "--match-types",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --match-types <list>"
      ],
      "tip": [
        "Filter by filesystem type (e.g. -n vfat,ext3)."
      ],
      "next": []
    },
    {
      "name": "--no-encoding",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --no-encoding"
      ],
      "tip": [
        "Don't encode non-printing characters."
      ]
    },
    {
      "name": "--no-part-details",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --no-part-details"
      ],
      "tip": [
        "Don't print info from partition table."
      ]
    },
    {
      "name": "--offset",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --offset <offset>"
      ],
      "tip": [
        "Probe at the given offset."
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <format>"
      ],
      "tip": [
        "Output format.",
        "Possible values: value, device, export, json, full",
        "Default: full"
      ],
      "next": [
        {
          "name": "device"
        },
        {
          "name": "export"
        },
        {
          "name": "full"
        },
        {
          "name": "json"
        },
        {
          "name": "value"
        }
      ]
    },
    {
      "name": "--probe",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --probe"
      ],
      "tip": [
        "Low-level superblocks probing (bypass cache)."
      ]
    },
    {
      "name": "--size",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --size <size>"
      ],
      "tip": [
        "Override device size."
      ],
      "next": []
    },
    {
      "name": "--usages",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --usages <list>"
      ],
      "tip": [
        "Filter by usage.",
        "Possible values: filesystem, raid, crypto, other",
        "Prefix a value with no to exclude it."
      ],
      "separator": ",",
      "next": [
        {
          "name": "crypto"
        },
        {
          "name": "filesystem"
        },
        {
          "name": "other"
        },
        {
          "name": "raid"
        }
      ]
    },
    {
      "name": "--uuid",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --uuid <uuid>"
      ],
      "tip": [
        "Convert UUID to device name."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
