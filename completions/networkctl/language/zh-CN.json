{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "查询和控制网络子系统。"
    ]
  },
  "next": [
    {
      "name": "cat",
      "usage": [
        "cat [FILE|@DEVICE...]"
      ],
      "tip": [
        "显示网络配置文件。"
      ]
    },
    {
      "name": "delete",
      "usage": [
        "delete DEVICES..."
      ],
      "tip": [
        "删除虚拟网络设备。"
      ]
    },
    {
      "name": "down",
      "usage": [
        "down DEVICES..."
      ],
      "tip": [
        "禁用设备。"
      ]
    },
    {
      "name": "edit",
      "usage": [
        "edit FILE|@DEVICE..."
      ],
      "tip": [
        "编辑网络配置文件。"
      ]
    },
    {
      "name": "forcerenew",
      "usage": [
        "forcerenew DEVICES..."
      ],
      "tip": [
        "触发所有已连接客户端的 DHCP 重新配置。"
      ]
    },
    {
      "name": "label",
      "tip": [
        "显示内核中的当前地址标签条目。"
      ]
    },
    {
      "name": "list",
      "usage": [
        "list [PATTERN...]"
      ],
      "tip": [
        "列出链路。"
      ]
    },
    {
      "name": "lldp",
      "usage": [
        "lldp [PATTERN...]"
      ],
      "tip": [
        "显示 LLDP 邻居。"
      ]
    },
    {
      "name": "mask",
      "usage": [
        "mask FILES..."
      ],
      "tip": [
        "屏蔽网络配置文件。"
      ]
    },
    {
      "name": "persistent-storage",
      "usage": [
        "persistent-storage BOOL"
      ],
      "tip": [
        "通知 systemd-networkd 持久存储是否就绪。"
      ]
    },
    {
      "name": "reconfigure",
      "usage": [
        "reconfigure DEVICES..."
      ],
      "tip": [
        "重新配置接口。"
      ]
    },
    {
      "name": "reload",
      "tip": [
        "重新加载 .network 和 .netdev 文件。"
      ]
    },
    {
      "name": "renew",
      "usage": [
        "renew DEVICES..."
      ],
      "tip": [
        "续订动态配置。"
      ]
    },
    {
      "name": "status",
      "usage": [
        "status [PATTERN...]"
      ],
      "tip": [
        "显示链路状态。"
      ]
    },
    {
      "name": "unmask",
      "usage": [
        "unmask FILES..."
      ],
      "tip": [
        "取消屏蔽网络配置文件。"
      ]
    },
    {
      "name": "up",
      "usage": [
        "up DEVICES..."
      ],
      "tip": [
        "启用设备。"
      ]
    }
  ],
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "显示所有链路的状态。"
      ]
    },
    {
      "name": "--drop-in",
      "usage": [
        "--drop-in=NAME"
      ],
      "tip": [
        "编辑指定的 drop-in 而不是主配置文件。"
      ],
      "next": []
    },
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "不省略输出。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--json",
      "usage": [
        "--json=pretty|short|off"
      ],
      "tip": [
        "生成 JSON 输出。",
        "可能值: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --lines=INTEGER"
      ],
      "tip": [
        "要显示的日志条目数。"
      ],
      "next": []
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "不提示输入密码。"
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "不显示页眉和页脚。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--no-reload",
      "tip": [
        "编辑网络配置后不重新加载 systemd-networkd 或 systemd-udevd。"
      ]
    },
    {
      "name": "--runtime",
      "tip": [
        "编辑运行时配置文件。"
      ]
    },
    {
      "name": "--stats",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --stats"
      ],
      "tip": [
        "显示详细的链路统计信息。"
      ]
    },
    {
      "name": "--stdin",
      "tip": [
        "从标准输入读取编辑文件的新内容。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    }
  ]
}
