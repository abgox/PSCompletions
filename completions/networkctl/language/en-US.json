{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Query and control the networking subsystem."
    ]
  },
  "next": [
    {
      "name": "cat",
      "usage": [
        "cat [FILE|@DEVICE...]"
      ],
      "tip": [
        "Show network configuration files."
      ]
    },
    {
      "name": "delete",
      "usage": [
        "delete DEVICES..."
      ],
      "tip": [
        "Delete virtual netdevs."
      ]
    },
    {
      "name": "down",
      "usage": [
        "down DEVICES..."
      ],
      "tip": [
        "Bring devices down."
      ]
    },
    {
      "name": "edit",
      "usage": [
        "edit FILE|@DEVICE..."
      ],
      "tip": [
        "Edit network configuration files."
      ]
    },
    {
      "name": "forcerenew",
      "usage": [
        "forcerenew DEVICES..."
      ],
      "tip": [
        "Trigger DHCP reconfiguration of all connected clients."
      ]
    },
    {
      "name": "label",
      "tip": [
        "Show current address label entries in the kernel."
      ]
    },
    {
      "name": "list",
      "usage": [
        "list [PATTERN...]"
      ],
      "tip": [
        "List links."
      ]
    },
    {
      "name": "lldp",
      "usage": [
        "lldp [PATTERN...]"
      ],
      "tip": [
        "Show LLDP neighbors."
      ]
    },
    {
      "name": "mask",
      "usage": [
        "mask FILES..."
      ],
      "tip": [
        "Mask network configuration files."
      ]
    },
    {
      "name": "persistent-storage",
      "usage": [
        "persistent-storage BOOL"
      ],
      "tip": [
        "Notify systemd-networkd if persistent storage is ready."
      ]
    },
    {
      "name": "reconfigure",
      "usage": [
        "reconfigure DEVICES..."
      ],
      "tip": [
        "Reconfigure interfaces."
      ]
    },
    {
      "name": "reload",
      "tip": [
        "Reload .network and .netdev files."
      ]
    },
    {
      "name": "renew",
      "usage": [
        "renew DEVICES..."
      ],
      "tip": [
        "Renew dynamic configurations."
      ]
    },
    {
      "name": "status",
      "usage": [
        "status [PATTERN...]"
      ],
      "tip": [
        "Show link status."
      ]
    },
    {
      "name": "unmask",
      "usage": [
        "unmask FILES..."
      ],
      "tip": [
        "Unmask network configuration files."
      ]
    },
    {
      "name": "up",
      "usage": [
        "up DEVICES..."
      ],
      "tip": [
        "Bring devices up."
      ]
    }
  ],
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Show status for all links."
      ]
    },
    {
      "name": "--drop-in",
      "usage": [
        "--drop-in=NAME"
      ],
      "tip": [
        "Edit specified drop-in instead of main config file."
      ],
      "next": []
    },
    {
      "name": "--full",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --full"
      ],
      "tip": [
        "Do not ellipsize output."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--json",
      "usage": [
        "--json=pretty|short|off"
      ],
      "tip": [
        "Generate JSON output.",
        "Possible values: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --lines=INTEGER"
      ],
      "tip": [
        "Number of journal entries to show."
      ],
      "next": []
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "Do not prompt for password."
      ]
    },
    {
      "name": "--no-legend",
      "tip": [
        "Do not show the headers and footers."
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--no-reload",
      "tip": [
        "Do not reload systemd-networkd or systemd-udevd after editing network config."
      ]
    },
    {
      "name": "--runtime",
      "tip": [
        "Edit runtime config files."
      ]
    },
    {
      "name": "--stats",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --stats"
      ],
      "tip": [
        "Show detailed link statistics."
      ]
    },
    {
      "name": "--stdin",
      "tip": [
        "Read new contents of edited file from stdin."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    }
  ]
}
