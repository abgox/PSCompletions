{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Make a typescript of a terminal session."
    ]
  },
  "option": [
    {
      "name": "--append",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --append"
      ],
      "tip": [
        "Append to the log file."
      ]
    },
    {
      "name": "--command",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --command <command>"
      ],
      "tip": [
        "Run command rather than interactive shell."
      ],
      "next": []
    },
    {
      "name": "--echo",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --echo <when>"
      ],
      "tip": [
        "Echo input in session.",
        "Possible values: auto, always, never"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--flush",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --flush"
      ],
      "tip": [
        "Run flush after each write."
      ]
    },
    {
      "name": "--force",
      "tip": [
        "Use output file even when it is a link."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--log-in",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --log-in <file>"
      ],
      "tip": [
        "Log stdin to file."
      ],
      "next": []
    },
    {
      "name": "--log-io",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --log-io <file>"
      ],
      "tip": [
        "Log stdin and stdout to file."
      ],
      "next": []
    },
    {
      "name": "--log-out",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --log-out <file>"
      ],
      "tip": [
        "Log stdout to file (default)."
      ],
      "next": []
    },
    {
      "name": "--log-timing",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --log-timing <file>"
      ],
      "tip": [
        "Log timing information to file."
      ],
      "next": []
    },
    {
      "name": "--logging-format",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --logging-format <name>"
      ],
      "tip": [
        "Force to 'classic' or 'advanced' format.",
        "Possible values: classic, advanced"
      ],
      "next": [
        {
          "name": "advanced"
        },
        {
          "name": "classic"
        }
      ]
    },
    {
      "name": "--output-limit",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output-limit <size>"
      ],
      "tip": [
        "Terminate if output files exceed size."
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Be quiet."
      ]
    },
    {
      "name": "--return",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --return"
      ],
      "tip": [
        "Return exit code of the child process."
      ]
    },
    {
      "name": "--timing",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t[<file>], --timing[=<file>]"
      ],
      "tip": [
        "Deprecated alias to -T (default file is stderr)."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
