{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "记录终端会话的 typescript。"
    ]
  },
  "option": [
    {
      "name": "--append",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --append"
      ],
      "tip": [
        "追加到日志文件。"
      ]
    },
    {
      "name": "--command",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --command <command>"
      ],
      "tip": [
        "运行命令而不是交互式 shell。"
      ],
      "next": []
    },
    {
      "name": "--echo",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --echo <when>"
      ],
      "tip": [
        "在会话中回显输入。",
        "可能值: auto, always, never"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--flush",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --flush"
      ],
      "tip": [
        "每次写入后刷新。"
      ]
    },
    {
      "name": "--force",
      "tip": [
        "即使输出文件是链接也使用它。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--log-in",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --log-in <file>"
      ],
      "tip": [
        "将标准输入记录到文件。"
      ],
      "next": []
    },
    {
      "name": "--log-io",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --log-io <file>"
      ],
      "tip": [
        "将标准输入和标准输出记录到文件。"
      ],
      "next": []
    },
    {
      "name": "--log-out",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --log-out <file>"
      ],
      "tip": [
        "将标准输出记录到文件（默认）。"
      ],
      "next": []
    },
    {
      "name": "--log-timing",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --log-timing <file>"
      ],
      "tip": [
        "将计时信息记录到文件。"
      ],
      "next": []
    },
    {
      "name": "--logging-format",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --logging-format <name>"
      ],
      "tip": [
        "强制使用 'classic' 或 'advanced' 格式。",
        "可能值: classic, advanced"
      ],
      "next": [
        {
          "name": "advanced"
        },
        {
          "name": "classic"
        }
      ]
    },
    {
      "name": "--output-limit",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output-limit <size>"
      ],
      "tip": [
        "输出文件超过大小时终止。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "静默运行。"
      ]
    },
    {
      "name": "--return",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --return"
      ],
      "tip": [
        "返回子进程的退出码。"
      ]
    },
    {
      "name": "--timing",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t[<file>], --timing[=<file>]"
      ],
      "tip": [
        "已弃用，是 -T 的别名（默认文件为 stderr）。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
