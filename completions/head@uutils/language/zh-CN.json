{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "输出每个文件的前 10 行到标准输出。"
    ]
  },
  "option": [
    {
      "name": "--bytes",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --bytes <[-]NUM>"
      ],
      "tip": [
        "打印每个文件的前 NUM 个字节；",
        "使用前导 '-'，打印除每个文件最后 NUM 个字节外的所有内容"
      ],
      "next": []
    },
    {
      "name": "--lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --lines <[-]NUM>"
      ],
      "tip": [
        "打印前 NUM 行而非前 10 行；",
        "使用前导 '-'，打印除每个文件最后 NUM 行外的所有内容"
      ],
      "next": []
    },
    {
      "name": "--silent",
      "alias": [
        "--quiet",
        "-q"
      ],
      "usage": [
        "-q, --quiet, --silent"
      ],
      "tip": [
        "从不打印显示文件名的标题"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "始终打印显示文件名的标题"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "行分隔符是 NUL 而非换行符"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
