{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "运行 COMMAND，并修改其标准流的缓冲方式。"
    ]
  },
  "option": [
    {
      "name": "--error",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --error <MODE>"
      ],
      "tip": [
        "调整标准错误流的缓冲方式"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "4K"
        },
        {
          "name": "64K"
        },
        {
          "name": "L"
        }
      ]
    },
    {
      "name": "--input",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --input <MODE>"
      ],
      "tip": [
        "调整标准输入流的缓冲方式"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "4K"
        },
        {
          "name": "64K"
        },
        {
          "name": "L"
        }
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <MODE>"
      ],
      "tip": [
        "调整标准输出流的缓冲方式"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "4K"
        },
        {
          "name": "64K"
        },
        {
          "name": "L"
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
