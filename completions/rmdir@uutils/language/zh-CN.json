{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "删除 DIRECTORY（如果为空）"
    ]
  },
  "option": [
    {
      "name": "--ignore-fail-on-non-empty",
      "tip": [
        "忽略仅因目录非空导致的每次失败"
      ]
    },
    {
      "name": "--parents",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --parents"
      ],
      "tip": [
        "删除 DIRECTORY 及其祖先；例如 rmdir -p a/b/c 类似于 rmdir a/b/c a/b a"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "为每个处理的目录输出诊断信息"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
