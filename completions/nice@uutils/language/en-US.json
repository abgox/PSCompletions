{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Run COMMAND with an adjusted niceness, which affects process scheduling."
    ]
  },
  "option": [
    {
      "name": "--adjustment",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --adjustment <ADJUSTMENT>"
      ],
      "tip": [
        "add N to the niceness (default is 10)"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
