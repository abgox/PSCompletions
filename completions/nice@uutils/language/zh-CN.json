{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "以调整后的 niceness 运行 COMMAND，影响进程调度"
    ]
  },
  "option": [
    {
      "name": "--adjustment",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --adjustment <ADJUSTMENT>"
      ],
      "tip": [
        "将 niceness 增加 N（默认为 10）"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
