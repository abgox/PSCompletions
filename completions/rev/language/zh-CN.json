{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "按字符反转每一行。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-0"
      ],
      "usage": [
        "-0, --zero"
      ],
      "tip": [
        "使用 NUL 字节作为行分隔符。"
      ]
    }
  ]
}
