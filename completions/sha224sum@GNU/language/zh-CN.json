{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "打印或校验 SHA224（224 位）校验和。"
    ]
  },
  "option": [
    {
      "name": "--binary",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --binary"
      ],
      "tip": [
        "以二进制模式读取"
      ]
    },
    {
      "name": "--check",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --check"
      ],
      "tip": [
        "从这些文件中读取校验和并逐一校验"
      ]
    },
    {
      "name": "--ignore-missing",
      "tip": [
        "对缺失的文件不失败，也不报告状态"
      ]
    },
    {
      "name": "--quiet",
      "tip": [
        "对每个校验成功的文件都不打印 OK"
      ]
    },
    {
      "name": "--status",
      "tip": [
        "不输出任何内容，通过状态码表示成功"
      ]
    },
    {
      "name": "--strict",
      "tip": [
        "遇到格式不正确的校验行时以非零状态退出"
      ]
    },
    {
      "name": "--tag",
      "tip": [
        "生成 BSD 风格的校验和"
      ]
    },
    {
      "name": "--text",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --text"
      ],
      "tip": [
        "以文本模式读取（默认）"
      ]
    },
    {
      "name": "--warn",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --warn"
      ],
      "tip": [
        "对格式不正确的校验行发出警告"
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "每行输出以 NUL 结尾而不是换行符，并禁用文件名转义"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
