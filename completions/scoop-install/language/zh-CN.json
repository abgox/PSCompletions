{
  "meta": {
    "url": "https://gitee.com/abgox/scoop-tools",
    "description": [
      "一个 PowerShell 脚本，它允许你临时使用替换之后的代理 url 来下载安装包。"
    ]
  },
  "global_option": [
    {
      "name": "--arch",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --arch <32bit|64bit|arm64>"
      ],
      "tip": [
        "使用指定的架构（如果应用支持）"
      ],
      "next": [
        {
          "name": "32bit"
        },
        {
          "name": "64bit"
        },
        {
          "name": "arm64"
        }
      ]
    },
    {
      "name": "--global",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --global"
      ],
      "tip": [
        "全局安装应用"
      ]
    },
    {
      "name": "--independent",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --independent"
      ],
      "tip": [
        "不自动安装依赖"
      ]
    },
    {
      "name": "--no-cache",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --no-cache"
      ],
      "tip": [
        "不使用下载缓存"
      ]
    },
    {
      "name": "--no-update-scoop",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --no-update-scoop"
      ],
      "tip": [
        "安装前不更新过时的 Scoop"
      ]
    },
    {
      "name": "--skip-hash-check",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --skip-hash-check"
      ],
      "tip": [
        "跳过哈希验证（谨慎使用！）"
      ]
    }
  ]
}
