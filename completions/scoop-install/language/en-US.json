{
  "meta": {
    "url": "https://github.com/abgox/scoop-tools",
    "description": [
      "A PowerShell script that allows you to temporarily use the replaced proxy URL to download app packages."
    ]
  },
  "global_option": [
    {
      "name": "--arch",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --arch <32bit|64bit|arm64>"
      ],
      "tip": [
        "Use the specified architecture, if the app supports it"
      ],
      "next": [
        {
          "name": "32bit"
        },
        {
          "name": "64bit"
        },
        {
          "name": "arm64"
        }
      ]
    },
    {
      "name": "--global",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --global"
      ],
      "tip": [
        "Install the app globally"
      ]
    },
    {
      "name": "--independent",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --independent"
      ],
      "tip": [
        "Don't install dependencies automatically"
      ]
    },
    {
      "name": "--no-cache",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --no-cache"
      ],
      "tip": [
        "Don't use the download cache"
      ]
    },
    {
      "name": "--no-update-scoop",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --no-update-scoop"
      ],
      "tip": [
        "Don't update Scoop before installing if it's outdated"
      ]
    },
    {
      "name": "--skip-hash-check",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --skip-hash-check"
      ],
      "tip": [
        "Skip hash validation (use with caution!)"
      ]
    }
  ],
  "config": [
    {
      "name": "exclude_buckets",
      "value": "",
      "values": [
        "\"main\"",
        "\"main|extras\""
      ],
      "tip": [
        "Buckets to be excluded when dynamically generating completions.",
        "Multiple buckets are separated by |, for example \"main|extras\""
      ]
    }
  ]
}
