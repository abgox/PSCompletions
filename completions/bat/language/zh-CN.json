{
  "meta": {
    "url": "https://github.com/sharkdp/bat",
    "description": [
      "带语法高亮和 Git 集成的 cat 替代品。"
    ]
  },
  "next": [
    {
      "name": "cache",
      "usage": [
        "cache [OPTIONS] <--build|--clear>"
      ],
      "tip": [
        "修改语法定义和主题缓存。"
      ],
      "option": [
        {
          "name": "--acknowledgements",
          "tip": [
            "构建 acknowledgements.bin。",
            "需要 --build。"
          ]
        },
        {
          "name": "--blank",
          "tip": [
            "创建全新的语法和主题集合（而不是追加到默认集合）。",
            "需要 --build。"
          ]
        },
        {
          "name": "--build",
          "alias": [
            "-b"
          ],
          "usage": [
            "-b, --build"
          ],
          "tip": [
            "初始化（或更新）语法 / 主题缓存。",
            "从源目录加载（默认为配置目录）。"
          ]
        },
        {
          "name": "--clear",
          "alias": [
            "-c"
          ],
          "usage": [
            "-c, --clear"
          ],
          "tip": [
            "删除缓存的语法定义和主题。"
          ]
        },
        {
          "name": "--source",
          "usage": [
            "--source <dir>"
          ],
          "tip": [
            "使用其他目录加载语法和主题。",
            "需要 --build。"
          ],
          "next": []
        },
        {
          "name": "--target",
          "usage": [
            "--target <dir>"
          ],
          "tip": [
            "使用其他目录存储缓存的语法和主题集。",
            "需要 --build。"
          ],
          "next": []
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--acknowledgements",
      "tip": [
        "显示致谢信息。"
      ]
    },
    {
      "name": "--binary",
      "usage": [
        "--binary <behavior>"
      ],
      "tip": [
        "如何处理二进制内容（默认为 no-printing）。"
      ],
      "next": [
        {
          "name": "as-text"
        },
        {
          "name": "no-printing"
        }
      ]
    },
    {
      "name": "--cache-dir",
      "tip": [
        "显示 bat 的缓存目录。"
      ]
    },
    {
      "name": "--chop-long-lines",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --chop-long-lines"
      ],
      "tip": [
        "截断所有超过屏幕宽度的行。",
        "'--wrap=never' 的别名。"
      ]
    },
    {
      "name": "--color",
      "usage": [
        "--color <when>"
      ],
      "tip": [
        "指定何时使用彩色输出。",
        "自动模式仅在检测到交互式终端时启用颜色 - 如果输出进入管道会自动禁用颜色。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--completion",
      "usage": [
        "--completion <SHELL>"
      ],
      "tip": [
        "显示指定 Shell 的补全脚本。",
        "可能值: bash, fish, ps1, zsh"
      ],
      "next": [
        {
          "name": "bash"
        },
        {
          "name": "fish"
        },
        {
          "name": "ps1"
        },
        {
          "name": "zsh"
        }
      ]
    },
    {
      "name": "--config-dir",
      "tip": [
        "显示 bat 的配置目录。"
      ]
    },
    {
      "name": "--config-file",
      "tip": [
        "显示配置文件的路径。"
      ]
    },
    {
      "name": "--decorations",
      "usage": [
        "--decorations <when>"
      ],
      "tip": [
        "指定何时使用通过 --style 指定的装饰。",
        "自动模式仅在检测到交互式终端时启用装饰。",
        "always 模式在管道输出时也会显示装饰。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--diagnostics",
      "alias": [
        "--diagnostic"
      ],
      "usage": [
        "--diagnostic, --diagnostics"
      ],
      "tip": [
        "显示用于错误报告的诊断信息。"
      ]
    },
    {
      "name": "--diff",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --diff"
      ],
      "tip": [
        "仅显示相对于 Git 索引添加 / 删除 / 修改的行。",
        "使用 --diff-context=N 控制要查看的上下文行数。"
      ]
    },
    {
      "name": "--diff-context",
      "usage": [
        "--diff-context <N>"
      ],
      "tip": [
        "在添加 / 删除 / 修改行周围包含 N 行上下文（需配合 --diff 使用）。"
      ],
      "next": []
    },
    {
      "name": "--file-name",
      "usage": [
        "--file-name <name>"
      ],
      "tip": [
        "指定要显示的文件名。",
        "当从 STDIN 向 bat 输送数据且 bat 无法获知文件名时很有用。",
        "注意，所提供的文件名也会用于语法检测。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--force-colorization",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force-colorization"
      ],
      "tip": [
        "'--decorations=always --color=always' 的别名。",
        "当 bat 的输出被管道输送到另一个程序，但又想保留颜色和装饰时很有用。"
      ]
    },
    {
      "name": "--generate-config-file",
      "tip": [
        "生成默认配置文件。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息。"
      ]
    },
    {
      "name": "--highlight-line",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --highlight-line <N:M>"
      ],
      "tip": [
        "用不同的背景色高亮指定的行范围。"
      ],
      "example": [
        "--highlight-line 40",
        "--highlight-line 30:40"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--ignored-suffix",
      "usage": [
        "--ignored-suffix <suffix>"
      ],
      "tip": [
        "忽略扩展名。"
      ],
      "example": [
        {
          "cmd": "--ignored-suffix \".dev\" my_file.json.dev",
          "desc": "使用 JSON 语法，并忽略 '.dev'"
        }
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--italic-text",
      "usage": [
        "--italic-text <when>"
      ],
      "tip": [
        "指定何时在输出中使用 ANSI 序列显示斜体文本。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--language",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --language <language>"
      ],
      "tip": [
        "显式设置语法高亮的语言。",
        "语言可以指定为名称（如 'C++' 或 'LaTeX'）或可能的文件扩展名（如 'cpp'、'hpp' 或 'md'）。",
        "使用 '--list-languages' 查看所有支持的语言名称和文件扩展名。"
      ],
      "next": []
    },
    {
      "name": "--line-range",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --line-range <N:M>"
      ],
      "tip": [
        "仅打印每个文件中指定范围的行。"
      ],
      "example": [
        {
          "cmd": "--line-range 30:40",
          "desc": "打印第 30 到 40 行"
        },
        {
          "cmd": "--line-range :40",
          "desc": "打印第 1 到 40 行"
        },
        {
          "cmd": "--line-range 40:",
          "desc": "打印从第 40 行到文件末尾"
        }
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--list-languages",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --list-languages"
      ],
      "tip": [
        "显示支持的语法高亮语言列表。"
      ]
    },
    {
      "name": "--list-themes",
      "tip": [
        "显示支持的语法高亮主题列表。"
      ]
    },
    {
      "name": "--map-syntax",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --map-syntax <glob:syntax>"
      ],
      "tip": [
        "将 glob 模式映射到现有语法名称。",
        "glob 模式会同时匹配完整路径和文件名。",
        "注意，等号右侧是语法的 *名称*，而不是文件扩展名。"
      ],
      "example": [
        {
          "cmd": "-m '*.build:Python'",
          "desc": "用 Python 语法高亮 *.build 文件"
        },
        {
          "cmd": "-m '.myignore:Git Ignore'",
          "desc": "用 Git Ignore 语法高亮名为 '.myignore' 的文件"
        }
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--no-config",
      "tip": [
        "不使用配置文件。"
      ]
    },
    {
      "name": "--no-custom-assets",
      "tip": [
        "不加载自定义资源。"
      ]
    },
    {
      "name": "--no-paging",
      "alias": [
        "--no-pager",
        "-P"
      ],
      "usage": [
        "-P, --no-pager, --no-paging"
      ],
      "tip": [
        "'--paging=never' 的别名。"
      ]
    },
    {
      "name": "--nonprintable-notation",
      "usage": [
        "--nonprintable-notation <notation>"
      ],
      "tip": [
        "设置不可打印字符的表示法。"
      ],
      "next": [
        {
          "name": "caret"
        },
        {
          "name": "unicode"
        }
      ]
    },
    {
      "name": "--number",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --number"
      ],
      "tip": [
        "仅显示行号，无其他装饰。",
        "这是 '--style=numbers' 的别名。"
      ]
    },
    {
      "name": "--pager",
      "usage": [
        "--pager <command>"
      ],
      "tip": [
        "确定使用哪个分页器。",
        "该选项将覆盖 PAGER 和 BAT_PAGER 环境变量。",
        "默认分页器是 'less'。"
      ],
      "example": [
        "--pager \"less -RF\""
      ],
      "next": []
    },
    {
      "name": "--paging",
      "usage": [
        "--paging <when>"
      ],
      "tip": [
        "指定何时使用分页器。",
        "要禁用分页器，请使用 '--paging=never' 或其别名 '-P'。",
        "要永久禁用分页器，请将 BAT_PAGING 设为 'never'。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--plain",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --plain"
      ],
      "tip": [
        "仅显示纯文本样式，无装饰。",
        "使用两次 '-p'（即 '-pp'）还会禁用自动分页。"
      ],
      "repeat": 2
    },
    {
      "name": "--set-terminal-title",
      "tip": [
        "使用分页器时将终端标题设置为文件名。"
      ]
    },
    {
      "name": "--show-nonprintable",
      "alias": [
        "--show-all",
        "-A"
      ],
      "usage": [
        "-A, --show-all, --show-nonprintable"
      ],
      "tip": [
        "显示不可打印字符，如空格、制表符或换行符。",
        "该选项也可用于打印二进制文件。",
        "使用 '--tabs' 控制制表符占位符的宽度。"
      ]
    },
    {
      "name": "--squeeze-blank",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squeeze-blank"
      ],
      "tip": [
        "将连续空行压缩为单个空行。"
      ]
    },
    {
      "name": "--squeeze-limit",
      "usage": [
        "--squeeze-limit <limit>"
      ],
      "tip": [
        "设置要打印的连续空行的最大数量。"
      ],
      "next": []
    },
    {
      "name": "--strip-ansi",
      "usage": [
        "--strip-ansi <when>"
      ],
      "tip": [
        "指定何时从输入中剥离 ANSI 转义序列。",
        "自动模式会删除转义序列，除非语法高亮语言是纯文本。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--style",
      "usage": [
        "--style <components,...>"
      ],
      "tip": [
        "配置除文件内容外要显示的元素。",
        "参数是以逗号分隔的要显示的组件列表（如 'numbers,changes,grid'）或预定义样式（如 'full'）。"
      ],
      "repeat": 99,
      "separator": ",",
      "next": [
        {
          "name": "auto"
        },
        {
          "name": "changes"
        },
        {
          "name": "default"
        },
        {
          "name": "full"
        },
        {
          "name": "grid"
        },
        {
          "name": "header"
        },
        {
          "name": "header-filename"
        },
        {
          "name": "header-filesize"
        },
        {
          "name": "numbers"
        },
        {
          "name": "plain"
        },
        {
          "name": "rule"
        },
        {
          "name": "snip"
        }
      ]
    },
    {
      "name": "--tabs",
      "usage": [
        "--tabs <T>"
      ],
      "tip": [
        "将制表符宽度设置为 T 个空格。",
        "宽度设为 0 则直接透传制表符。"
      ],
      "next": []
    },
    {
      "name": "--terminal-width",
      "usage": [
        "--terminal-width <width>"
      ],
      "tip": [
        "显式设置终端宽度，而不是自动检测。",
        "如果以 '+' 或 '-' 开头，该值将被视为相对实际终端宽度的偏移量。"
      ],
      "next": []
    },
    {
      "name": "--theme",
      "usage": [
        "--theme <theme>"
      ],
      "tip": [
        "设置语法高亮的主题。",
        "使用 '--list-themes' 查看所有可用主题。"
      ],
      "next": [
        {
          "name": "auto"
        },
        {
          "name": "auto:always"
        },
        {
          "name": "auto:system"
        },
        {
          "name": "dark"
        },
        {
          "name": "light"
        }
      ]
    },
    {
      "name": "--theme-dark",
      "usage": [
        "--theme-dark <theme>"
      ],
      "tip": [
        "设置终端使用深色背景时用于语法高亮的主题名称。"
      ],
      "next": []
    },
    {
      "name": "--theme-light",
      "usage": [
        "--theme-light <theme>"
      ],
      "tip": [
        "设置终端使用浅色背景时用于语法高亮的主题名称。"
      ],
      "next": []
    },
    {
      "name": "--unbuffered",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unbuffered"
      ],
      "tip": [
        "为了 POSIX 兼容性而存在（'u' 即 'unbuffered'）。",
        "输出始终是无缓冲的，该选项会被直接忽略。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本。"
      ]
    },
    {
      "name": "--wrap",
      "usage": [
        "--wrap <mode>"
      ],
      "tip": [
        "指定文本换行模式（*auto*、never、character）。",
        "可配合 '--terminal-width' 选项控制输出宽度。"
      ],
      "next": [
        {
          "name": "auto"
        },
        {
          "name": "character"
        },
        {
          "name": "never"
        }
      ]
    }
  ]
}
