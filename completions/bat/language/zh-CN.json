{
  "meta": {
    "url": "https://github.com/sharkdp/bat",
    "description": [
      "带语法高亮和 Git 集成的 cat 替代品。"
    ]
  },
  "next": [
    {
      "name": "cache",
      "usage": [
        "cache [OPTIONS]"
      ],
      "tip": [
        "自定义语法和主题。"
      ],
      "option": [
        {
          "name": "--acknowledgements",
          "tip": [
            "显示致谢信息。"
          ]
        },
        {
          "name": "--build",
          "tip": [
            "从头构建缓存。"
          ]
        },
        {
          "name": "--clear",
          "tip": [
            "删除生成的缓存文件。"
          ]
        },
        {
          "name": "--config-dir",
          "tip": [
            "显示配置目录。"
          ]
        },
        {
          "name": "--data-dir",
          "tip": [
            "显示数据目录。"
          ]
        },
        {
          "name": "--init",
          "tip": [
            "从 bat 的默认语法和主题初始化缓存。"
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--acknowledgements",
      "tip": [
        "显示致谢信息。"
      ]
    },
    {
      "name": "--diagnostic",
      "tip": [
        "显示用于错误报告的诊断信息。"
      ]
    },
    {
      "name": "--list-languages",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --list-languages"
      ],
      "tip": [
        "显示支持的语言列表。"
      ]
    },
    {
      "name": "--list-themes",
      "tip": [
        "显示支持的主题列表。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--binary",
      "usage": [
        "--binary <behavior>"
      ],
      "tip": [
        "如何处理二进制内容。"
      ],
      "next": [
        {
          "name": "as-text"
        },
        {
          "name": "no-printing"
        }
      ]
    },
    {
      "name": "--chop-long-lines",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --chop-long-lines"
      ],
      "tip": [
        "截断所有超过屏幕宽度的行。"
      ]
    },
    {
      "name": "--color",
      "usage": [
        "--color <when>"
      ],
      "tip": [
        "何时使用彩色输出。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--decorations",
      "usage": [
        "--decorations <when>"
      ],
      "tip": [
        "何时使用通过 --style 指定的装饰。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--diff",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --diff"
      ],
      "tip": [
        "仅显示相对于 Git 索引添加/删除/修改的行。"
      ]
    },
    {
      "name": "--diff-context",
      "usage": [
        "--diff-context <N>"
      ],
      "tip": [
        "在添加/删除/修改行周围包含 N 行上下文。"
      ],
      "next": []
    },
    {
      "name": "--file-name",
      "usage": [
        "--file-name <name>"
      ],
      "tip": [
        "指定要显示的文件名。"
      ],
      "next": []
    },
    {
      "name": "--force-colorization",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force-colorization"
      ],
      "tip": [
        "--decorations=always --color=always 的别名。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息。"
      ]
    },
    {
      "name": "--highlight-line",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --highlight-line <N:M>"
      ],
      "tip": [
        "高亮指定的行范围。"
      ],
      "next": []
    },
    {
      "name": "--ignored-suffix",
      "usage": [
        "--ignored-suffix <suffix>"
      ],
      "tip": [
        "忽略扩展名进行语法检测。"
      ],
      "next": []
    },
    {
      "name": "--italic-text",
      "usage": [
        "--italic-text <when>"
      ],
      "tip": [
        "何时使用 ANSI 序列显示斜体文本。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--language",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --language <language>"
      ],
      "tip": [
        "显式设置语法高亮的语言。"
      ],
      "next": []
    },
    {
      "name": "--line-range",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --line-range <N:M>"
      ],
      "tip": [
        "仅打印指定范围的行。"
      ],
      "next": []
    },
    {
      "name": "--map-syntax",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --map-syntax <glob:syntax>"
      ],
      "tip": [
        "将 glob 模式映射到现有语法名称。"
      ],
      "next": []
    },
    {
      "name": "--nonprintable-notation",
      "usage": [
        "--nonprintable-notation <notation>"
      ],
      "tip": [
        "设置不可打印字符的表示法。"
      ],
      "next": [
        {
          "name": "caret"
        },
        {
          "name": "unicode"
        }
      ]
    },
    {
      "name": "--number",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --number"
      ],
      "tip": [
        "仅显示行号，无其他装饰。"
      ]
    },
    {
      "name": "--pager",
      "usage": [
        "--pager <command>"
      ],
      "tip": [
        "确定使用哪个分页器。"
      ],
      "next": []
    },
    {
      "name": "--paging",
      "usage": [
        "--paging <when>"
      ],
      "tip": [
        "何时使用分页器。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--plain",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --plain"
      ],
      "tip": [
        "仅显示纯文本样式，无装饰。"
      ],
      "repeat": 2
    },
    {
      "name": "--set-terminal-title",
      "tip": [
        "使用分页器时将终端标题设置为文件名。"
      ]
    },
    {
      "name": "--show-all",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --show-all"
      ],
      "tip": [
        "显示不可打印字符，如空格、制表符或换行符。"
      ]
    },
    {
      "name": "--squeeze-blank",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squeeze-blank"
      ],
      "tip": [
        "将连续空行压缩为一行。"
      ]
    },
    {
      "name": "--squeeze-limit",
      "usage": [
        "--squeeze-limit <limit>"
      ],
      "tip": [
        "要打印的连续空行最大数量。"
      ],
      "next": []
    },
    {
      "name": "--strip-ansi",
      "usage": [
        "--strip-ansi <when>"
      ],
      "tip": [
        "何时剥离 ANSI 转义序列。"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--style",
      "usage": [
        "--style <components>"
      ],
      "tip": [
        "配置要显示的元素。"
      ],
      "next": [
        {
          "name": "auto"
        },
        {
          "name": "changes"
        },
        {
          "name": "default"
        },
        {
          "name": "full"
        },
        {
          "name": "grid"
        },
        {
          "name": "header"
        },
        {
          "name": "header-filename"
        },
        {
          "name": "header-filesize"
        },
        {
          "name": "numbers"
        },
        {
          "name": "plain"
        },
        {
          "name": "rule"
        },
        {
          "name": "snip"
        }
      ]
    },
    {
      "name": "--tabs",
      "usage": [
        "--tabs <T>"
      ],
      "tip": [
        "将制表符宽度设置为 T 个空格。"
      ],
      "next": []
    },
    {
      "name": "--terminal-width",
      "usage": [
        "--terminal-width <width>"
      ],
      "tip": [
        "显式设置终端宽度。"
      ],
      "next": []
    },
    {
      "name": "--theme",
      "usage": [
        "--theme <theme>"
      ],
      "tip": [
        "设置语法高亮的主题。"
      ],
      "next": []
    },
    {
      "name": "--theme-dark",
      "usage": [
        "--theme-dark <theme>"
      ],
      "tip": [
        "深色背景终端的主题。"
      ],
      "next": []
    },
    {
      "name": "--theme-light",
      "usage": [
        "--theme-light <theme>"
      ],
      "tip": [
        "浅色背景终端的主题。"
      ],
      "next": []
    },
    {
      "name": "--wrap",
      "usage": [
        "--wrap <mode>"
      ],
      "tip": [
        "指定文本换行模式。"
      ],
      "next": [
        {
          "name": "auto"
        },
        {
          "name": "character"
        },
        {
          "name": "never"
        }
      ]
    }
  ]
}
