{
  "meta": {
    "url": "https://github.com/fcsonline/drill",
    "description": [
      "HTTP load testing application written in Rust."
    ]
  },
  "option": [
    {
      "name": "--benchmark",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --benchmark <benchmark>"
      ],
      "tip": [
        "Sets the benchmark file.",
        "Required."
      ],
      "next": []
    },
    {
      "name": "--compare",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --compare <compare>"
      ],
      "tip": [
        "Sets a compare file.",
        "Requires --threshold."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help."
      ]
    },
    {
      "name": "--list-tags",
      "tip": [
        "List all benchmark tags.",
        "Cannot be combined with --tags or --skip-tags."
      ]
    },
    {
      "name": "--list-tasks",
      "tip": [
        "List benchmark tasks (executes --tags/--skip-tags filter)."
      ]
    },
    {
      "name": "--nanosec",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nanosec"
      ],
      "tip": [
        "Shows statistics in nanoseconds."
      ]
    },
    {
      "name": "--no-check-certificate",
      "tip": [
        "Disables SSL certification check. (Not recommended)"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Disables output."
      ]
    },
    {
      "name": "--relaxed-interpolations",
      "tip": [
        "Do not panic if an interpolation is not present. (Not recommended)"
      ]
    },
    {
      "name": "--report",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --report <report>"
      ],
      "tip": [
        "Sets a report file.",
        "Cannot be combined with --compare."
      ],
      "next": []
    },
    {
      "name": "--skip-tags",
      "usage": [
        "--skip-tags <skip-tags,...>"
      ],
      "tip": [
        "Tags to exclude.",
        "Comma-separated."
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--stats",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --stats"
      ],
      "tip": [
        "Shows request statistics.",
        "Cannot be combined with --compare."
      ]
    },
    {
      "name": "--tags",
      "usage": [
        "--tags <tags,...>"
      ],
      "tip": [
        "Tags to include.",
        "Comma-separated."
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--threshold",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --threshold <threshold>"
      ],
      "tip": [
        "Sets a threshold value in ms amongst the compared file.",
        "Only used with --compare."
      ],
      "next": []
    },
    {
      "name": "--timeout",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --timeout <timeout>"
      ],
      "tip": [
        "Set timeout in seconds for all requests."
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Toggle verbose output."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version."
      ]
    }
  ]
}
