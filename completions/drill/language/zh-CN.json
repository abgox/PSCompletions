{
  "meta": {
    "url": "https://github.com/fcsonline/drill",
    "description": [
      "用 Rust 编写的 HTTP 负载测试应用。"
    ]
  },
  "option": [
    {
      "name": "--benchmark",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --benchmark <benchmark>"
      ],
      "tip": [
        "设置压测定义文件。",
        "必需。"
      ],
      "next": []
    },
    {
      "name": "--compare",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --compare <compare>"
      ],
      "tip": [
        "设置用于对比的报告文件。",
        "需要同时指定 --threshold。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--list-tags",
      "tip": [
        "列出压测定义文件中的全部标签。",
        "不能与 --tags 或 --skip-tags 同时使用。"
      ]
    },
    {
      "name": "--list-tasks",
      "tip": [
        "列出压测任务（按 --tags/--skip-tags 过滤）。"
      ]
    },
    {
      "name": "--nanosec",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nanosec"
      ],
      "tip": [
        "以纳秒为单位显示统计信息。"
      ]
    },
    {
      "name": "--no-check-certificate",
      "tip": [
        "禁用 SSL 证书检查。（不推荐）"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "禁用输出。"
      ]
    },
    {
      "name": "--relaxed-interpolations",
      "tip": [
        "插值变量不存在时不触发 panic。（不推荐）"
      ]
    },
    {
      "name": "--report",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --report <report>"
      ],
      "tip": [
        "设置报告输出文件。",
        "不能与 --compare 同时使用。"
      ],
      "next": []
    },
    {
      "name": "--skip-tags",
      "usage": [
        "--skip-tags <skip-tags,...>"
      ],
      "tip": [
        "要排除的标签。",
        "多个标签用逗号分隔。"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--stats",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --stats"
      ],
      "tip": [
        "显示请求统计信息。",
        "不能与 --compare 同时使用。"
      ]
    },
    {
      "name": "--tags",
      "usage": [
        "--tags <tags,...>"
      ],
      "tip": [
        "要包含的标签。",
        "多个标签用逗号分隔。"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--threshold",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --threshold <threshold>"
      ],
      "tip": [
        "设置对比报告允许的阈值（毫秒）。",
        "仅在指定 --compare 时生效。"
      ],
      "next": []
    },
    {
      "name": "--timeout",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --timeout <timeout>"
      ],
      "tip": [
        "设置所有请求的超时时间（秒）。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "切换详细输出。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
