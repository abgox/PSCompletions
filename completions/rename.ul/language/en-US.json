{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Rename files."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Replace all occurrences."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "Prompt before overwrite."
      ]
    },
    {
      "name": "--last",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --last"
      ],
      "tip": [
        "Replace only the last occurrence."
      ]
    },
    {
      "name": "--no-act",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-act"
      ],
      "tip": [
        "Do not make any changes."
      ]
    },
    {
      "name": "--no-overwrite",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --no-overwrite"
      ],
      "tip": [
        "Don't overwrite existing files."
      ]
    },
    {
      "name": "--symlink",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --symlink"
      ],
      "tip": [
        "Act on the target of symlinks."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Explain what is being done."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
