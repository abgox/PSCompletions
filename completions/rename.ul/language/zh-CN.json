{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "重命名文件。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "替换所有出现。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "覆盖前提示。"
      ]
    },
    {
      "name": "--last",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --last"
      ],
      "tip": [
        "仅替换最后一次出现。"
      ]
    },
    {
      "name": "--no-act",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-act"
      ],
      "tip": [
        "不做任何更改。"
      ]
    },
    {
      "name": "--no-overwrite",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --no-overwrite"
      ],
      "tip": [
        "不覆盖现有文件。"
      ]
    },
    {
      "name": "--symlink",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --symlink"
      ],
      "tip": [
        "作用于符号链接的目标。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "说明正在执行的操作。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
