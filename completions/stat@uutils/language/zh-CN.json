{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "显示文件或文件系统状态"
    ]
  },
  "option": [
    {
      "name": "--dereference",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --dereference"
      ],
      "tip": [
        "跟随链接"
      ]
    },
    {
      "name": "--file-system",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file-system"
      ],
      "tip": [
        "显示文件系统状态而非文件状态"
      ]
    },
    {
      "name": "--format",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --format <FORMAT>"
      ],
      "tip": [
        "使用指定的 FORMAT 而非默认；每次使用 FORMAT 后输出一个换行"
      ],
      "next": []
    },
    {
      "name": "--printf",
      "usage": [
        "--printf <FORMAT>"
      ],
      "tip": [
        "类似 --format，但解释反斜杠转义，且不输出强制的末尾换行；想要换行请在 FORMAT 中包含 \\n"
      ],
      "next": []
    },
    {
      "name": "--terse",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --terse"
      ],
      "tip": [
        "以简洁形式打印信息"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
