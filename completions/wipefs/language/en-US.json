{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Wipe signatures from a device."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Wipe all magic strings (be careful)."
      ]
    },
    {
      "name": "--backup",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --backup[=<dir>]"
      ],
      "tip": [
        "Create a signature backup in DIR or $HOME."
      ],
      "next": []
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "Force erasure."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "Use JSON output format."
      ]
    },
    {
      "name": "--lock",
      "usage": [
        "--lock[=<mode>]"
      ],
      "tip": [
        "Use exclusive device lock.",
        "Possible values: yes, no, nonblock"
      ],
      "next": [
        {
          "name": "no"
        },
        {
          "name": "nonblock"
        },
        {
          "name": "yes"
        }
      ]
    },
    {
      "name": "--no-act",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-act"
      ],
      "tip": [
        "Do everything except the actual write() call."
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --noheadings"
      ],
      "tip": [
        "Don't print headings."
      ]
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <num>"
      ],
      "tip": [
        "Offset to erase, in bytes."
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --output <list>"
      ],
      "tip": [
        "Columns to display."
      ],
      "separator": ",",
      "next": [
        {
          "name": "DEVICE",
          "tip": [
            "Block device name."
          ]
        },
        {
          "name": "LABEL",
          "tip": [
            "Filesystem LABEL."
          ]
        },
        {
          "name": "LENGTH",
          "tip": [
            "Magic string length."
          ]
        },
        {
          "name": "OFFSET",
          "tip": [
            "Magic string offset."
          ]
        },
        {
          "name": "TYPE",
          "tip": [
            "Superblock type."
          ]
        },
        {
          "name": "USAGE",
          "tip": [
            "Type description."
          ]
        },
        {
          "name": "UUID",
          "tip": [
            "Partition/filesystem UUID."
          ]
        }
      ]
    },
    {
      "name": "--parsable",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --parsable"
      ],
      "tip": [
        "Print out in parsable instead of printable format."
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Suppress output messages."
      ]
    },
    {
      "name": "--types",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --types <list>"
      ],
      "tip": [
        "Limit the set of filesystem, RAIDs or partition tables."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
