{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "擦除设备上的签名。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "擦除所有 magic 字符串（请小心）。"
      ]
    },
    {
      "name": "--backup",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --backup[=<dir>]"
      ],
      "tip": [
        "在 DIR 或 $HOME 中创建签名备份。"
      ],
      "next": []
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "强制擦除。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "使用 JSON 输出格式。"
      ]
    },
    {
      "name": "--lock",
      "usage": [
        "--lock[=<mode>]"
      ],
      "tip": [
        "使用独占的设备锁。",
        "可能值: yes, no, nonblock"
      ],
      "next": [
        {
          "name": "no"
        },
        {
          "name": "nonblock"
        },
        {
          "name": "yes"
        }
      ]
    },
    {
      "name": "--no-act",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-act"
      ],
      "tip": [
        "执行所有操作，但不实际调用 write()。"
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --noheadings"
      ],
      "tip": [
        "不打印标题。"
      ]
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <num>"
      ],
      "tip": [
        "要擦除的偏移量（字节）。"
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --output <list>"
      ],
      "tip": [
        "要显示的列。"
      ],
      "separator": ",",
      "next": [
        {
          "name": "DEVICE",
          "tip": [
            "块设备名称。"
          ]
        },
        {
          "name": "LABEL",
          "tip": [
            "文件系统 LABEL。"
          ]
        },
        {
          "name": "LENGTH",
          "tip": [
            "magic 字符串长度。"
          ]
        },
        {
          "name": "OFFSET",
          "tip": [
            "magic 字符串偏移量。"
          ]
        },
        {
          "name": "TYPE",
          "tip": [
            "超级块类型。"
          ]
        },
        {
          "name": "USAGE",
          "tip": [
            "类型描述。"
          ]
        },
        {
          "name": "UUID",
          "tip": [
            "分区/文件系统 UUID。"
          ]
        }
      ]
    },
    {
      "name": "--parsable",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --parsable"
      ],
      "tip": [
        "以可解析格式而不是可打印格式输出。"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制输出消息。"
      ]
    },
    {
      "name": "--types",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --types <list>"
      ],
      "tip": [
        "限制文件系统、RAID 或分区表的集合。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
