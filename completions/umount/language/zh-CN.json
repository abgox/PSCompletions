{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "卸载文件系统。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "卸载所有文件系统。"
      ]
    },
    {
      "name": "--all-targets",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --all-targets"
      ],
      "tip": [
        "卸载当前命名空间中给定设备的所有挂载点。"
      ]
    },
    {
      "name": "--detach-loop",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --detach-loop"
      ],
      "tip": [
        "如果挂载的是 loop 设备，同时释放该 loop 设备。"
      ]
    },
    {
      "name": "--fake",
      "tip": [
        "试运行；跳过 umount(2) 系统调用。"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "强制卸载（用于无法访问的 NFS 系统）。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--internal-only",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --internal-only"
      ],
      "tip": [
        "不调用 umount.<type> 辅助程序。"
      ]
    },
    {
      "name": "--lazy",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --lazy"
      ],
      "tip": [
        "立即分离文件系统，稍后清理。"
      ]
    },
    {
      "name": "--namespace",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --namespace <ns>"
      ],
      "tip": [
        "在另一个命名空间中执行卸载。"
      ],
      "next": []
    },
    {
      "name": "--no-canonicalize",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --no-canonicalize"
      ],
      "tip": [
        "不规范化路径。"
      ]
    },
    {
      "name": "--no-mtab",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-mtab"
      ],
      "tip": [
        "不写入 /etc/mtab。"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制“未挂载”错误消息。"
      ]
    },
    {
      "name": "--read-only",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --read-only"
      ],
      "tip": [
        "如果卸载失败，尝试重新以只读方式挂载。"
      ]
    },
    {
      "name": "--recursive",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --recursive"
      ],
      "tip": [
        "递归卸载目标及其所有子挂载。"
      ]
    },
    {
      "name": "--test-opts",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --test-opts <list>"
      ],
      "tip": [
        "限制文件系统集合（与 -a 一起使用）。"
      ],
      "next": []
    },
    {
      "name": "--types",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --types <list>"
      ],
      "tip": [
        "限制文件系统类型集合。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "显示正在执行的操作。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
