{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Unmount filesystems."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Unmount all filesystems."
      ]
    },
    {
      "name": "--all-targets",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --all-targets"
      ],
      "tip": [
        "Unmount all mountpoints for the given device in the current namespace."
      ]
    },
    {
      "name": "--detach-loop",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --detach-loop"
      ],
      "tip": [
        "If mounted loop device, also free this loop device."
      ]
    },
    {
      "name": "--fake",
      "tip": [
        "Dry run; skip the umount(2) syscall."
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "Force unmount (in case of an unreachable NFS system)."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--internal-only",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --internal-only"
      ],
      "tip": [
        "Don't call the umount.<type> helpers."
      ]
    },
    {
      "name": "--lazy",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --lazy"
      ],
      "tip": [
        "Detach the filesystem now, clean up things later."
      ]
    },
    {
      "name": "--namespace",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --namespace <ns>"
      ],
      "tip": [
        "Perform umount in another namespace."
      ],
      "next": []
    },
    {
      "name": "--no-canonicalize",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --no-canonicalize"
      ],
      "tip": [
        "Don't canonicalize paths."
      ]
    },
    {
      "name": "--no-mtab",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-mtab"
      ],
      "tip": [
        "Don't write to /etc/mtab."
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Suppress 'not mounted' error messages."
      ]
    },
    {
      "name": "--read-only",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --read-only"
      ],
      "tip": [
        "In case unmounting fails, try to remount read-only."
      ]
    },
    {
      "name": "--recursive",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --recursive"
      ],
      "tip": [
        "Recursively unmount a target with all its children."
      ]
    },
    {
      "name": "--test-opts",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --test-opts <list>"
      ],
      "tip": [
        "Limit the set of filesystems (use with -a)."
      ],
      "next": []
    },
    {
      "name": "--types",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --types <list>"
      ],
      "tip": [
        "Limit the set of filesystem types."
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Say what is being done."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
