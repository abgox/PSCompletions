{
  "meta": {
    "url": "https://idursun.github.io/jjui/",
    "description": [
      "Jujutsu 版本控制系统的文本用户界面。"
    ]
  },
  "global_option": [
    {
      "name": "-config",
      "tip": [
        "在 $EDITOR 中打开配置文件"
      ]
    },
    {
      "name": "-help",
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "-install-lua-types",
      "tip": [
        "将 Lua 类型定义写入配置目录以用于 LuaLS 自动补全"
      ]
    },
    {
      "name": "-limit",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, -limit <int>"
      ],
      "tip": [
        "显示的修订版本数 (默认: 0)"
      ],
      "next": []
    },
    {
      "name": "-period",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, -period <int>"
      ],
      "tip": [
        "覆盖自动刷新间隔 (秒, 设置为 0 禁用) (默认 -1)"
      ],
      "next": []
    },
    {
      "name": "-revset",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, -revset <string>"
      ],
      "tip": [
        "设置默认修订版本集"
      ],
      "next": []
    },
    {
      "name": "-version",
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
