{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Convert numbers from/to human-readable strings."
    ]
  },
  "option": [
    {
      "name": "--debug",
      "tip": [
        "print warnings about invalid input"
      ]
    },
    {
      "name": "--delimiter",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delimiter <X>"
      ],
      "tip": [
        "use X instead of whitespace for field delimiter"
      ],
      "next": []
    },
    {
      "name": "--field",
      "usage": [
        "--field <FIELDS>"
      ],
      "tip": [
        "replace the numbers in these input fields; see FIELDS below [default: 1]"
      ],
      "next": []
    },
    {
      "name": "--format",
      "usage": [
        "--format <FORMAT>"
      ],
      "tip": [
        "use printf style floating-point FORMAT; see FORMAT below for details"
      ],
      "next": []
    },
    {
      "name": "--from",
      "usage": [
        "--from <UNIT>"
      ],
      "tip": [
        "auto-scale input numbers to UNITs; see UNIT below [default: none]"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "accept optional single/two letter suffix:",
            "1K = 1000, 1Ki = 1024, 1M = 1000000, 1Mi = 1048576"
          ]
        },
        {
          "name": "iec",
          "tip": [
            "accept optional single letter suffix:",
            "1K = 1024, 1M = 1048576, ..."
          ]
        },
        {
          "name": "iec-i",
          "tip": [
            "accept optional two-letter suffix:",
            "1Ki = 1024, 1Mi = 1048576, ..."
          ]
        },
        {
          "name": "none",
          "tip": [
            "no auto-scaling is done; suffixes will trigger an error"
          ]
        },
        {
          "name": "si",
          "tip": [
            "accept optional single letter suffix:",
            "1K = 1000, 1M = 1000000, ..."
          ]
        }
      ]
    },
    {
      "name": "--from-unit",
      "usage": [
        "--from-unit <N>"
      ],
      "tip": [
        "specify the input unit size [default: 1]"
      ],
      "next": []
    },
    {
      "name": "--grouping",
      "tip": [
        "use locale-defined grouping of digits, for example 1,000,000",
        "(which means it has no effect in the C/POSIX locale)"
      ]
    },
    {
      "name": "--header",
      "usage": [
        "--header [<N>]"
      ],
      "tip": [
        "print (without converting) the first N header lines; N defaults to 1 if not specified"
      ],
      "next": []
    },
    {
      "name": "--invalid",
      "usage": [
        "--invalid <INVALID>"
      ],
      "tip": [
        "set the failure mode for invalid input [default: abort]",
        "[possible values: abort, fail, warn, ignore]"
      ],
      "next": [
        {
          "name": "abort"
        },
        {
          "name": "fail"
        },
        {
          "name": "ignore"
        },
        {
          "name": "warn"
        }
      ]
    },
    {
      "name": "--padding",
      "usage": [
        "--padding <N>"
      ],
      "tip": [
        "pad the output to N characters;",
        "positive N will right-align; negative N will left-align;",
        "padding is ignored if the output is wider than N;",
        "the default is to automatically pad if a whitespace is found"
      ],
      "next": []
    },
    {
      "name": "--round",
      "usage": [
        "--round <METHOD>"
      ],
      "tip": [
        "use METHOD for rounding when scaling [default: from-zero]",
        "[possible values: up, down, from-zero, towards-zero, nearest]"
      ],
      "next": [
        {
          "name": "down"
        },
        {
          "name": "from-zero"
        },
        {
          "name": "nearest"
        },
        {
          "name": "towards-zero"
        },
        {
          "name": "up"
        }
      ]
    },
    {
      "name": "--suffix",
      "usage": [
        "--suffix <SUFFIX>"
      ],
      "tip": [
        "print SUFFIX after each formatted number, and accept inputs optionally ending with SUFFIX"
      ],
      "next": []
    },
    {
      "name": "--to",
      "usage": [
        "--to <UNIT>"
      ],
      "tip": [
        "auto-scale output numbers to UNITs; see UNIT below [default: none]"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "accept optional single/two letter suffix:",
            "1K = 1000, 1Ki = 1024, 1M = 1000000, 1Mi = 1048576"
          ]
        },
        {
          "name": "iec",
          "tip": [
            "accept optional single letter suffix:",
            "1K = 1024, 1M = 1048576, ..."
          ]
        },
        {
          "name": "iec-i",
          "tip": [
            "accept optional two-letter suffix:",
            "1Ki = 1024, 1Mi = 1048576, ..."
          ]
        },
        {
          "name": "none",
          "tip": [
            "no auto-scaling is done; suffixes will trigger an error"
          ]
        },
        {
          "name": "si",
          "tip": [
            "accept optional single letter suffix:",
            "1K = 1000, 1M = 1000000, ..."
          ]
        }
      ]
    },
    {
      "name": "--to-unit",
      "usage": [
        "--to-unit <N> "
      ],
      "tip": [
        "the output unit size [default: 1]"
      ],
      "next": []
    },
    {
      "name": "--unit-separator",
      "usage": [
        "--unit-separator <STRING>"
      ],
      "tip": [
        "use STRING to separate the number from any unit when printing",
        "by default, no separator is used"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "line delimiter is NUL, not newline"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show the help."
      ]
    }
  ]
}
