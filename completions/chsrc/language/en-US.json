{
  "meta": {
    "url": "https://chsrc.run",
    "description": [
      "Change Source everywhere for every software."
    ]
  },
  "next": [
    {
      "name": "get",
      "alias": [
        "g"
      ],
      "usage": [
        "g|get <target>"
      ],
      "tip": [
        "Show current source usage for the target."
      ]
    },
    {
      "name": "help",
      "alias": [
        "h"
      ],
      "usage": [
        "h|help"
      ],
      "tip": [
        "Print this help message."
      ]
    },
    {
      "name": "issue",
      "alias": [
        "i"
      ],
      "usage": [
        "i|issue"
      ],
      "tip": [
        "View related issues."
      ]
    },
    {
      "name": "list",
      "alias": [
        "ls",
        "l"
      ],
      "usage": [
        "l|ls|list [target]"
      ],
      "tip": [
        "List available mirrors and changeable targets."
      ],
      "next": [
        {
          "name": "lang",
          "tip": [
            "List supported programming languages."
          ]
        },
        {
          "name": "mirror",
          "tip": [
            "List supported mirrors."
          ]
        },
        {
          "name": "os",
          "tip": [
            "List supported operating systems."
          ]
        },
        {
          "name": "target",
          "tip": [
            "List supported changeable targets."
          ]
        },
        {
          "name": "ware",
          "tip": [
            "List supported software."
          ]
        }
      ]
    },
    {
      "name": "measure",
      "alias": [
        "cesu",
        "m"
      ],
      "usage": [
        "m|cesu|measure <target>"
      ],
      "tip": [
        "Measure speed for all mirrors of the target."
      ]
    },
    {
      "name": "reset",
      "usage": [
        "reset <target>"
      ],
      "tip": [
        "Reset to the default source used upstream."
      ]
    },
    {
      "name": "set",
      "alias": [
        "s"
      ],
      "usage": [
        "s|set <target> [mirror]"
      ],
      "tip": [
        "Change source, auto-measure and pick the fastest mirror."
      ],
      "next": [
        {
          "name": "first",
          "tip": [
            "Use the first mirror ranked by the maintenance team."
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "-dry",
      "tip": [
        "Dry Run, simulate the source changing process without executing."
      ]
    },
    {
      "name": "-en",
      "tip": [
        "Use English output."
      ]
    },
    {
      "name": "-ipv6",
      "tip": [
        "Use IPv6 for speed measurement."
      ]
    },
    {
      "name": "-no-color",
      "tip": [
        "No color output."
      ]
    },
    {
      "name": "-scope",
      "usage": [
        "-scope=<SCOPE>"
      ],
      "tip": [
        "Scope of source changing."
      ],
      "next": [
        {
          "name": "project",
          "tip": [
            "Change source for this project only."
          ]
        },
        {
          "name": "system",
          "tip": [
            "Change source at system level."
          ]
        },
        {
          "name": "user",
          "tip": [
            "Change source at user level."
          ]
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show help."
      ]
    }
  ]
}
