{
  "meta": {
    "url": "https://chsrc.run",
    "description": [
      "全平台通用换源工具与框架。"
    ]
  },
  "next": [
    {
      "name": "get",
      "alias": [
        "g"
      ],
      "tip": [
        "U: get|g <target>",
        "查看该目标当前源的使用情况。"
      ]
    },
    {
      "name": "help",
      "alias": [
        "h"
      ],
      "tip": [
        "U: h|help",
        "打印此帮助信息。"
      ]
    },
    {
      "name": "issue",
      "alias": [
        "i"
      ],
      "tip": [
        "U: issue|i",
        "查看相关 issue。"
      ]
    },
    {
      "name": "list",
      "alias": [
        "ls",
        "l"
      ],
      "tip": [
        "U: list|ls|l [target]",
        "列出可用的镜像站和可换源目标。"
      ],
      "next": [
        {
          "name": "lang",
          "tip": [
            "列出支持的编程语言。"
          ]
        },
        {
          "name": "mirror",
          "tip": [
            "列出支持的镜像站。"
          ]
        },
        {
          "name": "os",
          "tip": [
            "列出支持的操作系统。"
          ]
        },
        {
          "name": "target",
          "tip": [
            "列出支持的可换源目标。"
          ]
        },
        {
          "name": "ware",
          "tip": [
            "列出支持的软件。"
          ]
        }
      ]
    },
    {
      "name": "measure",
      "alias": [
        "cesu",
        "m"
      ],
      "tip": [
        "U: measure|m|cesu <target>",
        "对该目标所有源进行测速。"
      ]
    },
    {
      "name": "reset",
      "tip": [
        "U: reset <target>",
        "重置，使用上游默认使用的源。"
      ]
    },
    {
      "name": "set",
      "alias": [
        "s"
      ],
      "tip": [
        "U: set|s <target> [mirror]",
        "换源，自动测速后挑选最快源。"
      ],
      "next": [
        {
          "name": "first",
          "tip": [
            "使用维护团队测速第一的源。"
          ]
        }
      ]
    }
  ],
  "option": [
    {
      "name": "-dry",
      "tip": [
        "Dry Run，模拟换源过程，命令仅打印并不运行。"
      ]
    },
    {
      "name": "-en",
      "tip": [
        "使用英文输出。"
      ]
    },
    {
      "name": "-ipv6",
      "tip": [
        "使用 IPv6 测速。"
      ]
    },
    {
      "name": "-no-color",
      "tip": [
        "无颜色输出。"
      ]
    },
    {
      "name": "-scope",
      "tip": [
        "U: -scope=<SCOPE>",
        "换源范围。"
      ],
      "next": [
        {
          "name": "project",
          "tip": [
            "仅对本项目换源。"
          ]
        },
        {
          "name": "system",
          "tip": [
            "系统级换源。"
          ]
        },
        {
          "name": "user",
          "tip": [
            "用户级换源。"
          ]
        }
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "tip": [
        "U: -h, --help",
        "显示帮助。"
      ]
    }
  ]
}
