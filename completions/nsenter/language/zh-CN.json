{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "使用其他进程的命名空间运行程序。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "进入所有命名空间。"
      ]
    },
    {
      "name": "--cgroup",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --cgroup[=<file>]"
      ],
      "tip": [
        "进入 cgroup 命名空间。"
      ],
      "next": []
    },
    {
      "name": "--env",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --env"
      ],
      "tip": [
        "从目标进程继承环境变量。"
      ]
    },
    {
      "name": "--follow-context",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --follow-context"
      ],
      "tip": [
        "根据 --target PID 设置 SELinux 上下文。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--ipc",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ipc[=<file>]"
      ],
      "tip": [
        "进入 System V IPC 命名空间。"
      ],
      "next": []
    },
    {
      "name": "--join-cgroup",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --join-cgroup"
      ],
      "tip": [
        "加入目标进程的 cgroup。"
      ]
    },
    {
      "name": "--keep-caps",
      "tip": [
        "保留在用户命名空间中授予的能力。"
      ]
    },
    {
      "name": "--mount",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mount[=<file>]"
      ],
      "tip": [
        "进入挂载命名空间。"
      ],
      "next": []
    },
    {
      "name": "--net",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --net[=<file>]"
      ],
      "tip": [
        "进入网络命名空间。"
      ],
      "next": []
    },
    {
      "name": "--net-socket",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --net-socket <fd>"
      ],
      "tip": [
        "进入套接字的网络命名空间（与 --target 一起使用）。"
      ],
      "next": []
    },
    {
      "name": "--no-fork",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --no-fork"
      ],
      "tip": [
        "执行 <program> 前不 fork。"
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid[=<file>]"
      ],
      "tip": [
        "进入 pid 命名空间。"
      ],
      "next": []
    },
    {
      "name": "--preserve-credentials",
      "tip": [
        "不更改 uid 或 gid。"
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --root[=<dir>]"
      ],
      "tip": [
        "设置根目录。"
      ],
      "next": []
    },
    {
      "name": "--setgid",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --setgid[=<gid>]"
      ],
      "tip": [
        "在进入的命名空间中设置 gid。"
      ],
      "next": []
    },
    {
      "name": "--setuid",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --setuid[=<uid>]"
      ],
      "tip": [
        "在进入的命名空间中设置 uid。"
      ],
      "next": []
    },
    {
      "name": "--target",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --target <pid>"
      ],
      "tip": [
        "从中获取命名空间的目标进程。"
      ],
      "next": []
    },
    {
      "name": "--time",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --time[=<file>]"
      ],
      "tip": [
        "进入时间命名空间。"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --user[=<file>]"
      ],
      "tip": [
        "进入用户命名空间。"
      ],
      "next": []
    },
    {
      "name": "--user-parent",
      "tip": [
        "进入父用户命名空间。"
      ]
    },
    {
      "name": "--uts",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uts[=<file>]"
      ],
      "tip": [
        "进入 UTS 命名空间（主机名等）。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--wd",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wd[=<dir>]"
      ],
      "tip": [
        "设置工作目录。"
      ],
      "next": []
    },
    {
      "name": "--wdns",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --wdns <dir>"
      ],
      "tip": [
        "在命名空间中设置工作目录。"
      ],
      "next": []
    }
  ]
}
