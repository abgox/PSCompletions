{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Run a program with namespaces of other processes."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Enter all namespaces."
      ]
    },
    {
      "name": "--cgroup",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --cgroup[=<file>]"
      ],
      "tip": [
        "Enter cgroup namespace."
      ],
      "next": []
    },
    {
      "name": "--env",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --env"
      ],
      "tip": [
        "Inherit environment variables from target process."
      ]
    },
    {
      "name": "--follow-context",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --follow-context"
      ],
      "tip": [
        "Set SELinux context according to --target PID."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--ipc",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ipc[=<file>]"
      ],
      "tip": [
        "Enter System V IPC namespace."
      ],
      "next": []
    },
    {
      "name": "--join-cgroup",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --join-cgroup"
      ],
      "tip": [
        "Join the cgroup of the target process."
      ]
    },
    {
      "name": "--keep-caps",
      "tip": [
        "Retain capabilities granted in user namespaces."
      ]
    },
    {
      "name": "--mount",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mount[=<file>]"
      ],
      "tip": [
        "Enter mount namespace."
      ],
      "next": []
    },
    {
      "name": "--net",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --net[=<file>]"
      ],
      "tip": [
        "Enter network namespace."
      ],
      "next": []
    },
    {
      "name": "--net-socket",
      "alias": [
        "-N"
      ],
      "usage": [
        "-N, --net-socket <fd>"
      ],
      "tip": [
        "Enter socket's network namespace (use with --target)."
      ],
      "next": []
    },
    {
      "name": "--no-fork",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --no-fork"
      ],
      "tip": [
        "Do not fork before exec'ing <program>."
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid[=<file>]"
      ],
      "tip": [
        "Enter pid namespace."
      ],
      "next": []
    },
    {
      "name": "--preserve-credentials",
      "tip": [
        "Do not touch uids or gids."
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --root[=<dir>]"
      ],
      "tip": [
        "Set the root directory."
      ],
      "next": []
    },
    {
      "name": "--setgid",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --setgid[=<gid>]"
      ],
      "tip": [
        "Set gid in entered namespace."
      ],
      "next": []
    },
    {
      "name": "--setuid",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --setuid[=<uid>]"
      ],
      "tip": [
        "Set uid in entered namespace."
      ],
      "next": []
    },
    {
      "name": "--target",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --target <pid>"
      ],
      "tip": [
        "Target process to get namespaces from."
      ],
      "next": []
    },
    {
      "name": "--time",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --time[=<file>]"
      ],
      "tip": [
        "Enter time namespace."
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --user[=<file>]"
      ],
      "tip": [
        "Enter user namespace."
      ],
      "next": []
    },
    {
      "name": "--user-parent",
      "tip": [
        "Enter parent user namespace."
      ]
    },
    {
      "name": "--uts",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uts[=<file>]"
      ],
      "tip": [
        "Enter UTS namespace (hostname etc)."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--wd",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --wd[=<dir>]"
      ],
      "tip": [
        "Set the working directory."
      ],
      "next": []
    },
    {
      "name": "--wdns",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --wdns <dir>"
      ],
      "tip": [
        "Set the working directory in namespace."
      ],
      "next": []
    }
  ]
}
