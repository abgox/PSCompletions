{
  "meta": {
    "url": "https://github.com/charmbracelet/glow",
    "description": [
      "在终端中渲染 Markdown 文件！"
    ]
  },
  "next": [
    {
      "name": "completion",
      "alias": [
        "c"
      ],
      "usage": [
        "completion [COMMAND]"
      ],
      "tip": [
        "生成指定 shell 的自动补全脚本"
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "生成 bash 的自动补全脚本"
          ],
          "option": [
            {
              "name": "--no-descriptions",
              "tip": [
                "禁用补全描述"
              ]
            }
          ]
        },
        {
          "name": "fish",
          "tip": [
            "生成 fish 的自动补全脚本"
          ],
          "option": [
            {
              "name": "--no-descriptions",
              "tip": [
                "禁用补全描述"
              ]
            }
          ]
        },
        {
          "name": "powershell",
          "tip": [
            "生成 powershell 的自动补全脚本"
          ],
          "option": [
            {
              "name": "--no-descriptions",
              "tip": [
                "禁用补全描述"
              ]
            }
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "生成 zsh 的自动补全脚本"
          ],
          "option": [
            {
              "name": "--no-descriptions",
              "tip": [
                "禁用补全描述"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "config",
      "tip": [
        "编辑 glow 配置文件"
      ]
    },
    {
      "name": "help",
      "alias": [
        "h"
      ],
      "usage": [
        "help [COMMAND]"
      ],
      "tip": [
        "帮助信息"
      ]
    }
  ],
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "显示系统文件和目录 (仅 TUI 模式)"
      ]
    },
    {
      "name": "--line-numbers",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --line-numbers"
      ],
      "tip": [
        "显示行号 (仅 TUI 模式)"
      ]
    },
    {
      "name": "--pager",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pager"
      ],
      "tip": [
        "使用分页器显示"
      ]
    },
    {
      "name": "--preserve-new-lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --preserve-new-lines"
      ],
      "tip": [
        "保留输出中的换行符"
      ]
    },
    {
      "name": "--style",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --style <STYLE>"
      ],
      "tip": [
        "样式名称或 JSON 路径 (默认 \"auto\")"
      ],
      "next": []
    },
    {
      "name": "--tui",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --tui"
      ],
      "tip": [
        "使用 TUI 显示"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示版本信息"
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <WIDTH>"
      ],
      "tip": [
        "自动换行宽度 (设置为 0 禁用)"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--config",
      "usage": [
        "--config <FILE>"
      ],
      "tip": [
        "配置文件 (默认 C:\\Users\\<UserName>\\AppData\\Local\\glow\\Config\\glow.yml)"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息"
      ]
    }
  ]
}
