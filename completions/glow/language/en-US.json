{
  "meta": {
    "url": "https://github.com/charmbracelet/glow",
    "description": [
      "Render markdown on the CLI, with pizzazz!"
    ]
  },
  "next": [
    {
      "name": "completion",
      "alias": [
        "c"
      ],
      "usage": [
        "completion [COMMAND]"
      ],
      "tip": [
        "Generate the autocompletion script for the specified shell"
      ],
      "next": [
        {
          "name": "bash",
          "tip": [
            "Generate the autocompletion script for bash"
          ],
          "option": [
            {
              "name": "--no-descriptions",
              "tip": [
                "Disable completion descriptions"
              ]
            }
          ]
        },
        {
          "name": "fish",
          "tip": [
            "Generate the autocompletion script for fish"
          ],
          "option": [
            {
              "name": "--no-descriptions",
              "tip": [
                "Disable completion descriptions"
              ]
            }
          ]
        },
        {
          "name": "powershell",
          "tip": [
            "Generate the autocompletion script for powershell"
          ],
          "option": [
            {
              "name": "--no-descriptions",
              "tip": [
                "Disable completion descriptions"
              ]
            }
          ]
        },
        {
          "name": "zsh",
          "tip": [
            "Generate the autocompletion script for zsh"
          ],
          "option": [
            {
              "name": "--no-descriptions",
              "tip": [
                "Disable completion descriptions"
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "config",
      "tip": [
        "Edit the glow config file"
      ]
    },
    {
      "name": "help",
      "alias": [
        "h"
      ],
      "usage": [
        "help [COMMAND]"
      ],
      "tip": [
        "Help about any command"
      ]
    }
  ],
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Show system files and directories (TUI-mode only)"
      ]
    },
    {
      "name": "--line-numbers",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --line-numbers"
      ],
      "tip": [
        "Show line numbers (TUI-mode only)"
      ]
    },
    {
      "name": "--pager",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pager"
      ],
      "tip": [
        "Display with pager"
      ]
    },
    {
      "name": "--preserve-new-lines",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --preserve-new-lines"
      ],
      "tip": [
        "Preserve newlines in the output"
      ]
    },
    {
      "name": "--style",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --style <STYLE>"
      ],
      "tip": [
        "Style name or JSON path (default \"auto\")"
      ],
      "next": []
    },
    {
      "name": "--tui",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --tui"
      ],
      "tip": [
        "Display with tui"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Version for glow"
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <WIDTH>"
      ],
      "tip": [
        "Word-wrap at width (set to 0 to disable)"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--config",
      "usage": [
        "--config <FILE>"
      ],
      "tip": [
        "Config file (default C:\\Users\\<UserName>\\AppData\\Local\\glow\\Config\\glow.yml)"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Help for glow"
      ]
    }
  ]
}
