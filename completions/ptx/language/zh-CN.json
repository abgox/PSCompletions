{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "输出输入文件中单词的排列索引。"
    ]
  },
  "option": [
    {
      "name": "--auto-reference",
      "alias": [
        "-A"
      ],
      "usage": [
        "-A, --auto-reference"
      ],
      "tip": [
        "输出自动生成的引用"
      ]
    },
    {
      "name": "--break-file",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --break-file=FILE"
      ],
      "tip": [
        "单词分隔符在此 FILE 中"
      ],
      "next": []
    },
    {
      "name": "--flag-truncation",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --flag-truncation=STRING"
      ],
      "tip": [
        "使用 STRING 标记行截断，默认为 '/'"
      ],
      "next": []
    },
    {
      "name": "--format=roff",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --format=roff"
      ],
      "tip": [
        "生成 roff 指令格式的输出"
      ]
    },
    {
      "name": "--format=tex",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --format=tex"
      ],
      "tip": [
        "生成 TeX 指令格式的输出"
      ]
    },
    {
      "name": "--gap-size",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --gap-size=NUMBER"
      ],
      "tip": [
        "输出字段之间的间隔列数"
      ],
      "next": []
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --ignore-case"
      ],
      "tip": [
        "排序时忽略大小写"
      ]
    },
    {
      "name": "--ignore-file",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-file=FILE"
      ],
      "tip": [
        "从此 FILE 读取忽略词列表"
      ],
      "next": []
    },
    {
      "name": "--macro-name",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --macro-name=STRING"
      ],
      "tip": [
        "使用 STRING 作为宏名，而不是 'xx'"
      ],
      "next": []
    },
    {
      "name": "--only-file",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --only-file=FILE"
      ],
      "tip": [
        "从此 FILE 读取仅包含词列表"
      ],
      "next": []
    },
    {
      "name": "--references",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --references"
      ],
      "tip": [
        "每行的第一个字段是引用"
      ]
    },
    {
      "name": "--right-side-refs",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --right-side-refs"
      ],
      "tip": [
        "将引用放在右侧，不计入 -w 宽度"
      ]
    },
    {
      "name": "--sentence-regexp",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --sentence-regexp=REGEXP"
      ],
      "tip": [
        "用于行尾或句子结尾的正则表达式"
      ],
      "next": []
    },
    {
      "name": "--traditional",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --traditional"
      ],
      "tip": [
        "行为更像 System V 'ptx'"
      ]
    },
    {
      "name": "--typeset-mode",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --typeset-mode"
      ],
      "tip": [
        "未实现"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width=NUMBER"
      ],
      "tip": [
        "输出宽度（列数），不包括引用"
      ],
      "next": []
    },
    {
      "name": "--word-regexp",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --word-regexp=REGEXP"
      ],
      "tip": [
        "使用 REGEXP 匹配每个关键词"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助信息并退出"
      ]
    }
  ]
}
