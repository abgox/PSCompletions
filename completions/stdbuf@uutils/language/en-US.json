{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Run COMMAND, with modified buffering operations for its standard streams."
    ]
  },
  "option": [
    {
      "name": "--error",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --error <MODE>"
      ],
      "tip": [
        "adjust standard error stream buffering"
      ],
      "next": []
    },
    {
      "name": "--input",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --input <MODE>"
      ],
      "tip": [
        "adjust standard input stream buffering"
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <MODE>"
      ],
      "tip": [
        "adjust standard output stream buffering"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
