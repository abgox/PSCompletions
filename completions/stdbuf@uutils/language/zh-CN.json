{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "以修改后的缓冲操作运行 COMMAND，作用于其标准流"
    ]
  },
  "option": [
    {
      "name": "--error",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --error <MODE>"
      ],
      "tip": [
        "调整标准错误流缓冲"
      ],
      "next": []
    },
    {
      "name": "--input",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --input <MODE>"
      ],
      "tip": [
        "调整标准输入流缓冲"
      ],
      "next": []
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <MODE>"
      ],
      "tip": [
        "调整标准输出流缓冲"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
