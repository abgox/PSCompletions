{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "编辑密码、组、shadow 或 gshadow 文件。"
    ]
  },
  "option": [
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group"
      ],
      "tip": [
        "编辑组数据库。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--passwd",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --passwd"
      ],
      "tip": [
        "编辑 passwd 数据库。"
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "静默模式。"
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--shadow",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shadow"
      ],
      "tip": [
        "编辑 shadow 或 gshadow 数据库。"
      ]
    }
  ]
}
