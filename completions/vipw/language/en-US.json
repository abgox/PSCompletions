{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "Edit the password, group, shadow or gshadow file."
    ]
  },
  "option": [
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group"
      ],
      "tip": [
        "Edit the group database."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display help message and exit."
      ]
    },
    {
      "name": "--passwd",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --passwd"
      ],
      "tip": [
        "Edit the passwd database."
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Quiet mode."
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "Apply changes in the CHROOT_DIR directory and use the configuration files from the CHROOT_DIR directory.",
        "Only absolute paths are supported."
      ],
      "next": []
    },
    {
      "name": "--shadow",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shadow"
      ],
      "tip": [
        "Edit the shadow or gshadow database."
      ]
    }
  ]
}
