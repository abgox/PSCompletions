{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "删除（取消链接）FILE"
    ]
  },
  "option": [
    {
      "name": "--dir",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --dir"
      ],
      "tip": [
        "删除空目录"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "忽略不存在的文件和参数，从不提示"
      ]
    },
    {
      "name": "--interactive",
      "usage": [
        "--interactive[=<WHEN>]"
      ],
      "tip": [
        "按 WHEN 提示：never、once（-I）或 always（-i）。不带 WHEN 则始终提示"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "never"
        },
        {
          "name": "once"
        }
      ]
    },
    {
      "name": "--no-preserve-root",
      "tip": [
        "不特殊对待 /"
      ]
    },
    {
      "name": "--one-file-system",
      "tip": [
        "递归删除层级时，跳过与对应命令行参数不在同一文件系统上的目录（未实现）"
      ]
    },
    {
      "name": "--preserve-root",
      "tip": [
        "不删除 /（默认）"
      ]
    },
    {
      "name": "--progress",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --progress"
      ],
      "tip": [
        "显示进度条。注意：GNU coreutils 不支持此功能"
      ]
    },
    {
      "name": "--recursive",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --recursive"
      ],
      "tip": [
        "递归删除目录及其内容"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "解释正在做什么"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "-i",
      "tip": [
        "每次删除前都提示"
      ]
    },
    {
      "name": "-I",
      "tip": [
        "删除超过三个文件前或递归删除时提示一次。比 -i 侵入性小，但仍能防范大多数误操作"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
