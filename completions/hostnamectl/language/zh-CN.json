{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "查询或更改系统主机名。"
    ]
  },
  "next": [
    {
      "name": "chassis",
      "usage": [
        "chassis [NAME]"
      ],
      "tip": [
        "获取/设置主机的机箱类型。"
      ]
    },
    {
      "name": "deployment",
      "usage": [
        "deployment [NAME]"
      ],
      "tip": [
        "获取/设置主机的部署环境。"
      ]
    },
    {
      "name": "hostname",
      "usage": [
        "hostname [NAME]"
      ],
      "tip": [
        "获取/设置系统主机名。"
      ]
    },
    {
      "name": "icon-name",
      "usage": [
        "icon-name [NAME]"
      ],
      "tip": [
        "获取/设置主机的图标名称。"
      ]
    },
    {
      "name": "location",
      "usage": [
        "location [NAME]"
      ],
      "tip": [
        "获取/设置主机的位置。"
      ]
    },
    {
      "name": "status",
      "tip": [
        "显示当前主机名设置。"
      ]
    }
  ],
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "在远程主机上操作。"
      ],
      "next": []
    },
    {
      "name": "--json",
      "usage": [
        "--json=pretty|short|off"
      ],
      "tip": [
        "生成 JSON 输出。",
        "可能值: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "对本机容器操作。"
      ],
      "next": []
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "不提示输入密码。"
      ]
    },
    {
      "name": "--pretty",
      "tip": [
        "仅设置友好主机名。"
      ]
    },
    {
      "name": "--static",
      "tip": [
        "仅设置静态主机名。"
      ]
    },
    {
      "name": "--transient",
      "tip": [
        "仅设置临时主机名。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "-j",
      "tip": [
        "在 tty 上等同于 --json=pretty，否则等同于 --json=short。"
      ]
    }
  ]
}
