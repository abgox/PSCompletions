{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Query or change system hostname."
    ]
  },
  "next": [
    {
      "name": "chassis",
      "usage": [
        "chassis [NAME]"
      ],
      "tip": [
        "Get/set chassis type for host."
      ]
    },
    {
      "name": "deployment",
      "usage": [
        "deployment [NAME]"
      ],
      "tip": [
        "Get/set deployment environment for host."
      ]
    },
    {
      "name": "hostname",
      "usage": [
        "hostname [NAME]"
      ],
      "tip": [
        "Get/set system hostname."
      ]
    },
    {
      "name": "icon-name",
      "usage": [
        "icon-name [NAME]"
      ],
      "tip": [
        "Get/set icon name for host."
      ]
    },
    {
      "name": "location",
      "usage": [
        "location [NAME]"
      ],
      "tip": [
        "Get/set location for host."
      ]
    },
    {
      "name": "status",
      "tip": [
        "Show current hostname settings."
      ]
    }
  ],
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "Operate on remote host."
      ],
      "next": []
    },
    {
      "name": "--json",
      "usage": [
        "--json=pretty|short|off"
      ],
      "tip": [
        "Generate JSON output.",
        "Possible values: pretty, short, off"
      ],
      "next": [
        {
          "name": "off"
        },
        {
          "name": "pretty"
        },
        {
          "name": "short"
        }
      ]
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "Operate on local container."
      ],
      "next": []
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "Do not prompt for password."
      ]
    },
    {
      "name": "--pretty",
      "tip": [
        "Only set pretty hostname."
      ]
    },
    {
      "name": "--static",
      "tip": [
        "Only set static hostname."
      ]
    },
    {
      "name": "--transient",
      "tip": [
        "Only set transient hostname."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    },
    {
      "name": "-j",
      "tip": [
        "Same as --json=pretty on tty, --json=short otherwise."
      ]
    }
  ]
}
