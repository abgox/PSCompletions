{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Escape strings for usage in systemd unit names."
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--instance",
      "tip": [
        "With --unescape, show just the instance part."
      ]
    },
    {
      "name": "--mangle",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mangle"
      ],
      "tip": [
        "Mangle strings."
      ]
    },
    {
      "name": "--path",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --path"
      ],
      "tip": [
        "Assume the string is a path when escaping or unescaping."
      ]
    },
    {
      "name": "--suffix",
      "usage": [
        "--suffix=SUFFIX"
      ],
      "tip": [
        "Unit suffix to append to escaped strings."
      ],
      "next": []
    },
    {
      "name": "--template",
      "usage": [
        "--template=TEMPLATE"
      ],
      "tip": [
        "Insert strings as the instance into the template."
      ],
      "next": []
    },
    {
      "name": "--unescape",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unescape"
      ],
      "tip": [
        "Unescape strings."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    }
  ]
}
