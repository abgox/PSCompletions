{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "转义用于 systemd 单元名的字符串。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--instance",
      "tip": [
        "与 --unescape 一起使用时仅显示实例部分。"
      ]
    },
    {
      "name": "--mangle",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --mangle"
      ],
      "tip": [
        "改写字符串。"
      ]
    },
    {
      "name": "--path",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --path"
      ],
      "tip": [
        "转义或反转义时假定字符串是路径。"
      ]
    },
    {
      "name": "--suffix",
      "usage": [
        "--suffix=SUFFIX"
      ],
      "tip": [
        "追加到转义字符串的单元后缀。"
      ],
      "next": []
    },
    {
      "name": "--template",
      "usage": [
        "--template=TEMPLATE"
      ],
      "tip": [
        "将字符串作为实例插入模板。"
      ],
      "next": []
    },
    {
      "name": "--unescape",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unescape"
      ],
      "tip": [
        "反转义字符串。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    }
  ]
}
