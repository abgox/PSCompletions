{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "List local system locks."
    ]
  },
  "option": [
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "Print SIZE in bytes rather than in human readable format."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "Use JSON output format."
      ]
    },
    {
      "name": "--list-columns",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --list-columns"
      ],
      "tip": [
        "List the available columns."
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "Don't print headings."
      ]
    },
    {
      "name": "--noinaccessible",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --noinaccessible"
      ],
      "tip": [
        "Ignore locks without read permissions."
      ]
    },
    {
      "name": "--notruncate",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --notruncate"
      ],
      "tip": [
        "Don't truncate text in columns."
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "Output columns (see --list-columns)."
      ],
      "next": []
    },
    {
      "name": "--output-all",
      "tip": [
        "Output all columns."
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid <pid>"
      ],
      "tip": [
        "Display only locks held by this process."
      ],
      "next": []
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "Use the raw output format."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
