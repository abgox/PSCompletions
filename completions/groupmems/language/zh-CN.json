{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "管理用户主组的成员。"
    ]
  },
  "option": [
    {
      "name": "--add",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --add <user_name>"
      ],
      "tip": [
        "将用户添加到组成员列表。"
      ],
      "next": []
    },
    {
      "name": "--delete",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delete <user_name>"
      ],
      "tip": [
        "从组成员列表中删除用户。"
      ],
      "next": []
    },
    {
      "name": "--group",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --group <group_name>"
      ],
      "tip": [
        "超级用户可以指定要修改的组成员列表。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--list",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --list"
      ],
      "tip": [
        "列出组成员列表。"
      ]
    },
    {
      "name": "--purge",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --purge"
      ],
      "tip": [
        "从组成员列表中清除所有用户。"
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    }
  ]
}
