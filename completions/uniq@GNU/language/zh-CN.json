{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "从 INPUT（或标准输入）中过滤出相邻的重复行，写入 OUTPUT（或标准输出）。"
    ]
  },
  "option": [
    {
      "name": "--all-repeated",
      "usage": [
        "--all-repeated[=METHOD]"
      ],
      "tip": [
        "与 -D 类似，但允许用空行分隔各组；METHOD 取值为 {none(默认), prepend, separate}"
      ],
      "next": [
        {
          "name": "none"
        },
        {
          "name": "prepend"
        },
        {
          "name": "separate"
        }
      ]
    },
    {
      "name": "--check-chars",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --check-chars <N>"
      ],
      "tip": [
        "每行最多比较 N 个字符"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    },
    {
      "name": "--count",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --count"
      ],
      "tip": [
        "在每行前加上其出现次数"
      ]
    },
    {
      "name": "--group",
      "usage": [
        "--group[=METHOD]"
      ],
      "tip": [
        "显示全部条目，用空行分隔各组；METHOD 取值为 {separate(默认), prepend, append, both}"
      ],
      "next": [
        {
          "name": "append"
        },
        {
          "name": "both"
        },
        {
          "name": "prepend"
        },
        {
          "name": "separate"
        }
      ]
    },
    {
      "name": "--ignore-case",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore-case"
      ],
      "tip": [
        "比较时忽略大小写差异"
      ]
    },
    {
      "name": "--repeated",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --repeated"
      ],
      "tip": [
        "只输出重复行，每组输出一行"
      ]
    },
    {
      "name": "--skip-chars",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --skip-chars <N>"
      ],
      "tip": [
        "比较时跳过开头 N 个字符"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    },
    {
      "name": "--skip-fields",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --skip-fields <N>"
      ],
      "tip": [
        "比较时跳过开头 N 个字段"
      ],
      "next": [
        {
          "name": "1"
        },
        {
          "name": "2"
        }
      ]
    },
    {
      "name": "--unique",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unique"
      ],
      "tip": [
        "只输出唯一的行"
      ]
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "行分隔符为 NUL，而不是换行符"
      ]
    },
    {
      "name": "-D",
      "tip": [
        "打印所有重复行"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
