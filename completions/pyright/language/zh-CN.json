{
  "meta": {
    "url": "https://microsoft.github.io/pyright",
    "description": [
      "Python 的静态类型检查器。"
    ]
  },
  "option": [
    {
      "name": "--createstub",
      "usage": [
        "--createstub <IMPORT>"
      ],
      "tip": [
        "为导入创建类型存根文件。"
      ],
      "next": []
    },
    {
      "name": "--dependencies",
      "tip": [
        "输出导入依赖信息。"
      ]
    },
    {
      "name": "--ignoreexternal",
      "tip": [
        "在 --verifytypes 中忽略外部导入。"
      ]
    },
    {
      "name": "--level",
      "usage": [
        "--level <LEVEL>"
      ],
      "tip": [
        "最低诊断级别（error 或 warning）。",
        "可能值: error, warning"
      ],
      "next": [
        {
          "name": "error"
        },
        {
          "name": "warning"
        }
      ]
    },
    {
      "name": "--outputjson",
      "tip": [
        "以 JSON 格式输出结果。"
      ]
    },
    {
      "name": "--project",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --project <FILE OR DIRECTORY>"
      ],
      "tip": [
        "使用此位置的配置文件。"
      ],
      "next": []
    },
    {
      "name": "--pythonpath",
      "usage": [
        "--pythonpath <FILE>"
      ],
      "tip": [
        "Python 解释器的路径。"
      ],
      "next": []
    },
    {
      "name": "--pythonplatform",
      "usage": [
        "--pythonplatform <PLATFORM>"
      ],
      "tip": [
        "针对特定平台进行分析（Darwin、Linux、Windows、iOS、Android）。",
        "可能值: Darwin, Linux, Windows, iOS, Android"
      ],
      "next": [
        {
          "name": "Android"
        },
        {
          "name": "Darwin"
        },
        {
          "name": "iOS"
        },
        {
          "name": "Linux"
        },
        {
          "name": "Windows"
        }
      ]
    },
    {
      "name": "--pythonversion",
      "usage": [
        "--pythonversion <VERSION>"
      ],
      "tip": [
        "针对特定版本进行分析（3.3、3.4 等）。"
      ],
      "next": [
        {
          "name": "3.10"
        },
        {
          "name": "3.11"
        },
        {
          "name": "3.12"
        },
        {
          "name": "3.13"
        },
        {
          "name": "3.9"
        }
      ]
    },
    {
      "name": "--skipunannotated",
      "tip": [
        "跳过对没有类型注解的函数进行分析。"
      ]
    },
    {
      "name": "--stats",
      "tip": [
        "打印详细的性能统计信息。"
      ]
    },
    {
      "name": "--threads",
      "usage": [
        "--threads [<COUNT>]"
      ],
      "tip": [
        "使用独立线程并行进行类型检查。"
      ],
      "next": [
        {
          "name": "2"
        },
        {
          "name": "4"
        },
        {
          "name": "8"
        }
      ]
    },
    {
      "name": "--typeshedpath",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --typeshedpath <DIRECTORY>"
      ],
      "tip": [
        "使用此位置的 typeshed 类型存根。"
      ],
      "next": []
    },
    {
      "name": "--venvpath",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --venvpath <DIRECTORY>"
      ],
      "tip": [
        "包含虚拟环境的目录。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "tip": [
        "输出详细的诊断信息。"
      ]
    },
    {
      "name": "--verifytypes",
      "usage": [
        "--verifytypes <PACKAGE>"
      ],
      "tip": [
        "验证 py.typed 包的类型完整性。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "打印 Pyright 版本并退出。"
      ]
    },
    {
      "name": "--warnings",
      "tip": [
        "如果有警告被报告，则使用退出码 1。"
      ]
    },
    {
      "name": "--watch",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --watch"
      ],
      "tip": [
        "持续运行并监视更改。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助信息。"
      ]
    }
  ]
}
