{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示硬件看门狗的状态。"
    ]
  },
  "option": [
    {
      "name": "--flags",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --flags <list>"
      ],
      "tip": [
        "仅打印选定的标志。"
      ],
      "next": []
    },
    {
      "name": "--flags-only",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --flags-only"
      ],
      "tip": [
        "仅打印标志表（等同于 -I -T）。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--noflags",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --noflags"
      ],
      "tip": [
        "不打印标志信息。"
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "不打印标志表的标题。"
      ]
    },
    {
      "name": "--noident",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --noident"
      ],
      "tip": [
        "不打印看门狗标识信息。"
      ]
    },
    {
      "name": "--notimeouts",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --notimeouts"
      ],
      "tip": [
        "不打印看门狗超时。"
      ]
    },
    {
      "name": "--oneline",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --oneline"
      ],
      "tip": [
        "将所有信息打印在一行。"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "标志的输出列。"
      ],
      "separator": ",",
      "next": [
        {
          "name": "BOOT-STATUS",
          "tip": [
            "标志启动状态。"
          ]
        },
        {
          "name": "DESCRIPTION",
          "tip": [
            "标志描述。"
          ]
        },
        {
          "name": "DEVICE",
          "tip": [
            "看门狗设备名称。"
          ]
        },
        {
          "name": "FLAG",
          "tip": [
            "标志名称。"
          ]
        },
        {
          "name": "STATUS",
          "tip": [
            "标志状态。"
          ]
        }
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "为标志表使用原始输出格式。"
      ]
    },
    {
      "name": "--setpregovernor",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --setpregovernor <name>"
      ],
      "tip": [
        "设置看门狗预超时调控器。",
        "可用的调控器由 wdctl 的默认输出显示。"
      ],
      "next": []
    },
    {
      "name": "--setpretimeout",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --setpretimeout <sec>"
      ],
      "tip": [
        "设置看门狗预超时。"
      ],
      "next": []
    },
    {
      "name": "--settimeout",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --settimeout <sec>"
      ],
      "tip": [
        "设置看门狗超时。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
