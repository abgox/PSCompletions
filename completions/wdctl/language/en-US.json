{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Show the status of the hardware watchdog."
    ]
  },
  "option": [
    {
      "name": "--flags",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --flags <list>"
      ],
      "tip": [
        "Print selected flags only."
      ],
      "next": []
    },
    {
      "name": "--flags-only",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --flags-only"
      ],
      "tip": [
        "Print only flags table (same as -I -T)."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--noflags",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --noflags"
      ],
      "tip": [
        "Don't print information about flags."
      ]
    },
    {
      "name": "--noheadings",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --noheadings"
      ],
      "tip": [
        "Don't print headings for flags table."
      ]
    },
    {
      "name": "--noident",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --noident"
      ],
      "tip": [
        "Don't print watchdog identity information."
      ]
    },
    {
      "name": "--notimeouts",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --notimeouts"
      ],
      "tip": [
        "Don't print watchdog timeouts."
      ]
    },
    {
      "name": "--oneline",
      "alias": [
        "-O"
      ],
      "usage": [
        "-O, --oneline"
      ],
      "tip": [
        "Print all information on one line."
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <list>"
      ],
      "tip": [
        "Output columns of the flags."
      ],
      "separator": ",",
      "next": [
        {
          "name": "BOOT-STATUS",
          "tip": [
            "Flag boot status."
          ]
        },
        {
          "name": "DESCRIPTION",
          "tip": [
            "Flag description."
          ]
        },
        {
          "name": "DEVICE",
          "tip": [
            "Watchdog device name."
          ]
        },
        {
          "name": "FLAG",
          "tip": [
            "Flag name."
          ]
        },
        {
          "name": "STATUS",
          "tip": [
            "Flag status."
          ]
        }
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "Use raw output format for flags table."
      ]
    },
    {
      "name": "--setpregovernor",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --setpregovernor <name>"
      ],
      "tip": [
        "Set watchdog pre-timeout governor.",
        "Available governors are shown by the default wdctl output."
      ],
      "next": []
    },
    {
      "name": "--setpretimeout",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --setpretimeout <sec>"
      ],
      "tip": [
        "Set watchdog pre-timeout."
      ],
      "next": []
    },
    {
      "name": "--settimeout",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --settimeout <sec>"
      ],
      "tip": [
        "Set watchdog timeout."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
