{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Manage file locks from shell scripts."
    ]
  },
  "option": [
    {
      "name": "--close",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --close"
      ],
      "tip": [
        "Close file descriptor before running command."
      ]
    },
    {
      "name": "--command",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --command <command>"
      ],
      "tip": [
        "Run a single command string through the shell."
      ],
      "next": []
    },
    {
      "name": "--conflict-exit-code",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --conflict-exit-code <number>"
      ],
      "tip": [
        "Exit code after conflict or timeout."
      ],
      "next": []
    },
    {
      "name": "--exclusive",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exclusive"
      ],
      "tip": [
        "Get an exclusive lock (default)."
      ]
    },
    {
      "name": "--fcntl",
      "tip": [
        "Use fcntl(F_OFD_SETLK) rather than flock()."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--no-fork",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --no-fork"
      ],
      "tip": [
        "Execute command without forking."
      ]
    },
    {
      "name": "--nonblock",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nonblock"
      ],
      "tip": [
        "Fail rather than wait."
      ]
    },
    {
      "name": "--shared",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shared"
      ],
      "tip": [
        "Get a shared lock."
      ]
    },
    {
      "name": "--timeout",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --timeout <secs>"
      ],
      "tip": [
        "Wait for a limited amount of time."
      ],
      "next": []
    },
    {
      "name": "--unlock",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unlock"
      ],
      "tip": [
        "Remove a lock."
      ]
    },
    {
      "name": "--verbose",
      "tip": [
        "Increase verbosity."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
