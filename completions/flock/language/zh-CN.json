{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "在 shell 脚本中管理文件锁。"
    ]
  },
  "option": [
    {
      "name": "--close",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --close"
      ],
      "tip": [
        "运行命令前关闭文件描述符。"
      ]
    },
    {
      "name": "--command",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --command <command>"
      ],
      "tip": [
        "通过 shell 运行单条命令字符串。"
      ],
      "next": []
    },
    {
      "name": "--conflict-exit-code",
      "alias": [
        "-E"
      ],
      "usage": [
        "-E, --conflict-exit-code <number>"
      ],
      "tip": [
        "冲突或超时后的退出码。"
      ],
      "next": []
    },
    {
      "name": "--exclusive",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exclusive"
      ],
      "tip": [
        "获取独占锁（默认）。"
      ]
    },
    {
      "name": "--fcntl",
      "tip": [
        "使用 fcntl(F_OFD_SETLK) 而不是 flock()。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--no-fork",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --no-fork"
      ],
      "tip": [
        "不 fork 直接执行命令。"
      ]
    },
    {
      "name": "--nonblock",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --nonblock"
      ],
      "tip": [
        "失败而不是等待。"
      ]
    },
    {
      "name": "--shared",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shared"
      ],
      "tip": [
        "获取共享锁。"
      ]
    },
    {
      "name": "--timeout",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --timeout <secs>"
      ],
      "tip": [
        "等待有限的时间。"
      ],
      "next": []
    },
    {
      "name": "--unlock",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --unlock"
      ],
      "tip": [
        "移除锁。"
      ]
    },
    {
      "name": "--verbose",
      "tip": [
        "提高详细程度。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
