  "global_option": [
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config <CONFIG>"
      ],
      "tip": [
        "Specify the configuration file, can be a relative or absolute path."
      ],
      "next": []
    },
    {
      "name": "--config-loader",
      "usage": [
        "--config-loader <LOADER>"
      ],
      "tip": [
        "Set the config file loader.",
        "Default: auto."
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "Automatically choose how to load the config file.",
            "Default."
          ]
        },
        {
          "name": "jiti",
          "tip": [
            "Load the config file with jiti."
          ]
        },
        {
          "name": "native",
          "tip": [
            "Load the config file with the native runtime loader."
          ]
        }
      ]
    },
    {
      "name": "--env-dir",
      "usage": [
        "--env-dir <DIR>"
      ],
      "tip": [
        "Specify the directory to load .env files."
      ],
      "next": []
    },
    {
      "name": "--env-mode",
      "usage": [
        "--env-mode <MODE>"
      ],
      "tip": [
        "Specify the env mode to load the .env.[mode] file."
      ],
      "next": []
