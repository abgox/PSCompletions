              ]
            },
            {
              "name": "mf",
              "tip": [
                "Module Federation format output."
              ]
            },
            {
              "name": "umd",
              "tip": [
                "Universal Module Definition output."
              ]
            }
          ]
        },
        {
          "name": "--minify",
          "tip": [
            "Minify output (use --no-minify to disable)."
          ]
        },
        {
          "name": "--no-auto-extension",
          "tip": [
            "Disable automatic extension redirect."
          ]
        },
        {
          "name": "--no-auto-external",
          "tip": [
            "Disable automatic dependency externalization."
          ]
        },
        {
          "name": "--no-bundle",
          "tip": [
            "Disable bundle mode."
          ]
        },
        {
          "name": "--no-clean",
          "tip": [
            "Do not clean the output directory before build."
          ]
        },
        {
          "name": "--no-dts",
          "tip": [
            "Do not emit declaration files."
          ]
        },
        {
          "name": "--no-minify",
          "tip": [
            "Disable output minification."
          ]
        },
        {
          "name": "--syntax",
          "usage": [
            "--syntax <SYNTAX>"
          ],
          "tip": [
            "Set build syntax target.",
            "Repeatable."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--target",
          "usage": [
            "--target <TARGET>"
          ],
          "tip": [
            "Set runtime target."
          ],
