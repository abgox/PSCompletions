          "next": []
        },
        {
          "name": "--version",
          "alias": [
            "-v"
          ],
          "usage": [
            "-v, --version"
          ],
          "tip": [
            "Display version number."
          ]
        },
        {
          "name": "--watch",
          "alias": [
            "-w"
          ],
          "usage": [
            "-w, --watch"
          ],
          "tip": [
            "Turn on watch mode, watch for changes and rebuild."
          ]
        }
      ]
    },
    {
      "name": "inspect",
