          "usage": [
            "--entry <ENTRY>"
          ],
          "tip": [
            "Set entry file or pattern.",
            "Repeatable."
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--externals",
          "usage": [
            "--externals <PKG>"
          ],
          "tip": [
