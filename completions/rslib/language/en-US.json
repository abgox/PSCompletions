              ]
            }
          ]
        },
        {
          "name": "--output",
          "usage": [
            "--output <OUTPUT>"
          ],
          "tip": [
            "Set the output path for inspection results.",
            "Default: .rsbuild."
          ],
          "next": []
        },
        {
          "name": "--verbose",
          "tip": [
            "Show complete function definitions in output."
          ]
        }
      ]
    },
    {
      "name": "mf-dev",
      "tip": [
        "Start Rsbuild dev server of Module Federation format."
      ]
    }
