{
  "meta": {
    "url": "https://rslib.rs",
    "description": [
      "An Rsbuild-based library development tool for creating libraries and UI components."
    ]
  },
  "next": [
    {
      "name": "build",
      "tip": [
        "Build the library for production.",
        "Default if no command is given."
      ],
      "option": [
        {
          "name": "--auto-extension",
          "tip": [
            "Control automatic extension redirect (use --no-auto-extension to disable)."
          ]
        },
        {
          "name": "--auto-external",
          "tip": [
            "Control automatic dependency externalization (use --no-auto-external to disable)."
          ]
        },
        {
          "name": "--bundle",
          "tip": [
            "Enable bundle mode (use --no-bundle to disable)."
          ]
        },
        {
          "name": "--clean",
          "tip": [
            "Clean output directory before build (use --no-clean to disable)."
          ]
        },
        {
          "name": "--dist-path",
