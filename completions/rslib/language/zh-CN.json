  "global_option": [
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config <CONFIG>"
      ],
      "tip": [
        "指定配置文件，可为相对或绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--config-loader",
      "usage": [
        "--config-loader <LOADER>"
      ],
      "tip": [
        "设置配置文件的加载器。",
        "默认: auto。"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "自动选择加载配置文件的方式。",
            "默认。"
          ]
        },
        {
          "name": "jiti",
          "tip": [
            "用 jiti 加载配置文件。"
          ]
        },
        {
          "name": "native",
          "tip": [
            "用原生运行时加载器加载配置文件。"
          ]
        }
      ]
    },
    {
      "name": "--env-dir",
      "usage": [
        "--env-dir <DIR>"
      ],
      "tip": [
        "设置加载 .env 文件的目录。"
      ],
      "next": []
    },
    {
      "name": "--env-mode",
      "usage": [
        "--env-mode <MODE>"
      ],
      "tip": [
        "设置 env 模式，用于加载 .env.[mode] 文件。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此消息。"
      ]
    },
    {
      "name": "--lib",
      "usage": [
        "--lib <ID>"
      ],
      "tip": [
        "指定库。",
        "可重复，如 --lib esm --lib cjs。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--log-level",
      "usage": [
        "--log-level <LEVEL>"
      ],
      "tip": [
        "设置日志级别。"
      ],
      "next": [
        {
          "name": "error",
          "tip": [
            "错误级别日志。"
          ]
        },
        {
          "name": "info",
          "tip": [
            "信息级别日志。"
          ]
        },
        {
          "name": "silent",
          "tip": [
            "静默模式: 无进度输出。"
