{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示或更改利用率钳制属性。"
    ]
  },
  "option": [
    {
      "name": "--all-tasks",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all-tasks"
      ],
      "tip": [
        "对给定 pid 的所有任务（线程）执行操作。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid <pid>"
      ],
      "tip": [
        "对已存在的给定 pid 执行操作。"
      ],
      "next": []
    },
    {
      "name": "--reset-on-fork",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --reset-on-fork"
      ],
      "tip": [
        "设置 reset-on-fork 标志。"
      ]
    },
    {
      "name": "--system",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --system"
      ],
      "tip": [
        "对系统执行操作。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "显示状态信息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "-m",
      "usage": [
        "-m <value>"
      ],
      "tip": [
        "要设置的 util_min 值。"
      ],
      "next": []
    },
    {
      "name": "-M",
      "usage": [
        "-M <value>"
      ],
      "tip": [
        "要设置的 util_max 值。"
      ],
      "next": []
    }
  ]
}
