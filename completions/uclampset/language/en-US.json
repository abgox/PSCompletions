{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Show or change the utilization clamping attributes."
    ]
  },
  "option": [
    {
      "name": "--all-tasks",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all-tasks"
      ],
      "tip": [
        "Operate on all the tasks (threads) for a given pid."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid <pid>"
      ],
      "tip": [
        "Operate on existing given pid."
      ],
      "next": []
    },
    {
      "name": "--reset-on-fork",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --reset-on-fork"
      ],
      "tip": [
        "Set reset-on-fork flag."
      ]
    },
    {
      "name": "--system",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --system"
      ],
      "tip": [
        "Operate on system."
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Display status information."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "-m",
      "usage": [
        "-m <value>"
      ],
      "tip": [
        "Util_min value to set."
      ],
      "next": []
    },
    {
      "name": "-M",
      "usage": [
        "-M <value>"
      ],
      "tip": [
        "Util_max value to set."
      ],
      "next": []
    }
  ]
}
