{
  "meta": {
    "url": "https://github.com/nushell/nushell",
    "description": [
      "Nushell 语言与 Shell"
    ]
  },
  "option": [
    {
      "name": "--commands",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --commands <string>"
      ],
      "tip": [
        "运行给定的命令然后退出"
      ],
      "next": []
    },
    {
      "name": "--config",
      "usage": [
        "--config <path>"
      ],
      "tip": [
        "使用备用配置文件启动"
      ],
      "next": []
    },
    {
      "name": "--config-home",
      "usage": [
        "--config-home <path>"
      ],
      "tip": [
        "使用备用配置目录启动"
      ],
      "next": []
    },
    {
      "name": "--env-config",
      "usage": [
        "--env-config <path>"
      ],
      "tip": [
        "使用备用的环境配置文件启动"
      ],
      "next": []
    },
    {
      "name": "--error-style",
      "usage": [
        "--error-style <string>"
      ],
      "tip": [
        "使用的错误样式（fancy 或 plain）。默认：fancy"
      ],
      "next": [
        {
          "name": "fancy",
          "tip": [
            "精美错误样式（默认）"
          ]
        },
        {
          "name": "plain",
          "tip": [
            "简洁错误样式"
          ]
        }
      ]
    },
    {
      "name": "--execute",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --execute <string>"
      ],
      "tip": [
        "运行给定的命令后进入交互式 Shell"
      ],
      "next": []
    },
    {
      "name": "--experimental-options",
      "usage": [
        "--experimental-options <string...>"
      ],
      "tip": [
        "启用或禁用实验性选项，使用 all 启用所有活动选项"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助信息"
      ]
    },
    {
      "name": "--ide-ast",
      "usage": [
        "--ide-ast <path>"
      ],
      "tip": [
        "在给定源上生成 AST"
      ],
      "next": []
    },
    {
      "name": "--ide-check",
      "usage": [
        "--ide-check <int>"
      ],
      "tip": [
        "在给定源上运行诊断检查并限制返回的错误数量"
      ],
      "next": []
    },
    {
      "name": "--ide-complete",
      "usage": [
        "--ide-complete <int>"
      ],
      "tip": [
        "列出给定光标位置和文件处项目的补全"
      ],
      "next": []
    },
    {
      "name": "--ide-goto-def",
      "usage": [
        "--ide-goto-def <int>"
      ],
      "tip": [
        "跳转到给定光标位置和文件处项目的定义"
      ],
      "next": []
    },
    {
      "name": "--ide-hover",
      "usage": [
        "--ide-hover <int>"
      ],
      "tip": [
        "提供给定光标位置和文件处项目的信息"
      ],
      "next": []
    },
    {
      "name": "--include-path",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --include-path <string>"
      ],
      "tip": [
        "为给定脚本设置 NU_LIB_DIRS"
      ],
      "next": []
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "以交互式 Shell 启动"
      ]
    },
    {
      "name": "--log-exclude",
      "usage": [
        "--log-exclude <string...>"
      ],
      "tip": [
        "设置要从日志输出中排除的 Rust 模块前缀"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--log-file",
      "usage": [
        "--log-file <path>"
      ],
      "tip": [
        "指定自定义日志文件路径"
      ],
      "next": []
    },
    {
      "name": "--log-include",
      "usage": [
        "--log-include <string...>"
      ],
      "tip": [
        "设置要从日志输出中包含的 Rust 模块前缀"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--log-level",
      "usage": [
        "--log-level <string>"
      ],
      "tip": [
        "诊断日志的日志级别。默认关闭"
      ],
      "next": [
        {
          "name": "debug",
          "tip": [
            "调试级别"
          ]
        },
        {
          "name": "error",
          "tip": [
            "错误级别"
          ]
        },
        {
          "name": "info",
          "tip": [
            "信息级别"
          ]
        },
        {
          "name": "perf",
          "tip": [
            "性能级别"
          ]
        },
        {
          "name": "trace",
          "tip": [
            "跟踪级别"
          ]
        },
        {
          "name": "warn",
          "tip": [
            "警告级别"
          ]
        }
      ]
    },
    {
      "name": "--log-target",
      "usage": [
        "--log-target <string>"
      ],
      "tip": [
        "设置日志输出的目标"
      ],
      "next": [
        {
          "name": "file",
          "tip": [
            "输出到文件（需要 --log-file）"
          ]
        },
        {
          "name": "mixed",
          "tip": [
            "输出到混合目标"
          ]
        },
        {
          "name": "stderr",
          "tip": [
            "输出到 stderr（默认）"
          ]
        },
        {
          "name": "stdout",
          "tip": [
            "输出到 stdout"
          ]
        }
      ]
    },
    {
      "name": "--login",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --login"
      ],
      "tip": [
        "以登录 Shell 启动"
      ]
    },
    {
      "name": "--lsp",
      "tip": [
        "启动 nu 的语言服务器协议"
      ]
    },
    {
      "name": "--mcp",
      "tip": [
        "启动 nu 的模型上下文协议服务器"
      ]
    },
    {
      "name": "--mcp-port",
      "usage": [
        "--mcp-port <int>"
      ],
      "tip": [
        "MCP HTTP 传输的端口（默认 8080）"
      ],
      "next": [
        {
          "name": "3000"
        },
        {
          "name": "8080"
        }
      ]
    },
    {
      "name": "--mcp-transport",
      "usage": [
        "--mcp-transport <string>"
      ],
      "tip": [
        "MCP 服务器使用的传输方式"
      ],
      "next": [
        {
          "name": "http",
          "tip": [
            "HTTP 传输"
          ]
        },
        {
          "name": "stdio",
          "tip": [
            "Stdio 传输"
          ]
        }
      ]
    },
    {
      "name": "--no-config-file",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-config-file"
      ],
      "tip": [
        "不加载配置文件和环境文件启动"
      ]
    },
    {
      "name": "--no-history",
      "tip": [
        "禁用命令历史记录的读写"
      ]
    },
    {
      "name": "--no-newline",
      "tip": [
        "为 --commands（-c）的结果打印时不添加换行"
      ]
    },
    {
      "name": "--no-std-lib",
      "tip": [
        "不加载标准库启动"
      ]
    },
    {
      "name": "--plugin-config",
      "usage": [
        "--plugin-config <path>"
      ],
      "tip": [
        "使用备用的插件注册表文件启动"
      ],
      "next": []
    },
    {
      "name": "--plugins",
      "usage": [
        "--plugins <path>"
      ],
      "tip": [
        "要加载的插件可执行文件列表（完整路径）"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--stdin",
      "tip": [
        "将标准输入重定向到命令（配合 -c）或脚本文件"
      ]
    },
    {
      "name": "--table-mode",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --table-mode <string>"
      ],
      "tip": [
        "使用的表格模式。默认为 rounded"
      ],
      "next": [
        {
          "name": "basic",
          "tip": [
            "基础表格模式"
          ]
        },
        {
          "name": "compact",
          "tip": [
            "紧凑表格模式"
          ]
        },
        {
          "name": "rounded",
          "tip": [
            "圆角表格模式（默认）"
          ]
        },
        {
          "name": "thin",
          "tip": [
            "细线表格模式"
          ]
        },
        {
          "name": "with_love",
          "tip": [
            "with_love 表格模式"
          ]
        }
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "打印版本"
      ]
    }
  ]
}
