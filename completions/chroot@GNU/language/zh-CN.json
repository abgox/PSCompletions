{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "以 NEWROOT 作为根目录运行 COMMAND。"
    ]
  },
  "option": [
    {
      "name": "--groups",
      "usage": [
        "--groups <G_LIST>"
      ],
      "tip": [
        "以 g1,g2,...,gN 的形式指定附加组"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--skip-chdir",
      "tip": [
        "不把工作目录切换到 '/'"
      ]
    },
    {
      "name": "--userspec",
      "usage": [
        "--userspec <USER:GROUP>"
      ],
      "tip": [
        "指定要使用的用户和组（ID 或名字）"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
