{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把 SOURCE 重命名为 DEST，或把多个 SOURCE 移动到 DIRECTORY 中。"
    ]
  },
  "option": [
    {
      "name": "--backup",
      "usage": [
        "--backup[=CONTROL]"
      ],
      "tip": [
        "为每个已存在的目标文件创建备份"
      ],
      "next": []
    },
    {
      "name": "--context",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --context"
      ],
      "tip": [
        "把目标文件的 SELinux 安全上下文设为默认类型"
      ]
    },
    {
      "name": "--debug",
      "tip": [
        "解释文件是如何被复制的。隐含 -v"
      ]
    },
    {
      "name": "--exchange",
      "tip": [
        "交换源和目标"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "覆盖前不询问"
      ]
    },
    {
      "name": "--interactive",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --interactive"
      ],
      "tip": [
        "覆盖前询问"
      ]
    },
    {
      "name": "--no-clobber",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-clobber"
      ],
      "tip": [
        "不覆盖已存在的文件"
      ]
    },
    {
      "name": "--no-copy",
      "tip": [
        "重命名失败时不退回到复制"
      ]
    },
    {
      "name": "--no-target-directory",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --no-target-directory"
      ],
      "tip": [
        "把 DEST 当作普通文件处理"
      ]
    },
    {
      "name": "--strip-trailing-slashes",
      "tip": [
        "去掉每个 SOURCE 参数末尾的斜杠"
      ]
    },
    {
      "name": "--suffix",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --suffix <SUFFIX>"
      ],
      "tip": [
        "覆盖通常使用的备份后缀"
      ],
      "next": []
    },
    {
      "name": "--target-directory",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --target-directory <DIRECTORY>"
      ],
      "tip": [
        "把所有 SOURCE 参数移动进 DIRECTORY"
      ],
      "next": []
    },
    {
      "name": "--update",
      "usage": [
        "--update[=UPDATE]"
      ],
      "tip": [
        "控制更新哪些已存在的文件；UPDATE 取值为 {all, none, none-fail, older(默认)}"
      ],
      "next": [
        {
          "name": "all"
        },
        {
          "name": "none"
        },
        {
          "name": "none-fail"
        },
        {
          "name": "older"
        }
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "解释正在做什么"
      ]
    },
    {
      "name": "-b",
      "tip": [
        "与 --backup 相同，但不接受参数"
      ]
    },
    {
      "name": "-u",
      "tip": [
        "等同于 --update[=older]。详见下方"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
