{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Print NAME with leading directory components removed."
    ]
  },
  "option": [
    {
      "name": "--multiple",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --multiple"
      ],
      "tip": [
        "support multiple arguments and treat each as a NAME"
      ]
    },
    {
      "name": "--suffix",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --suffix <SUFFIX>"
      ],
      "tip": [
        "remove a trailing SUFFIX; implies -a"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "end each output line with NUL, not newline"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show the help."
      ]
    }
  ]
}
