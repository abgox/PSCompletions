{
  "meta": {
    "url": "https://viteplus.dev/guide/run",
    "description": [
      "独立任务运行器（等同于 `vp run`）。",
      "在工作区包中运行任务。"
    ]
  },
  "option": [
    {
      "name": "--cache",
      "tip": [
        "为全部任务与脚本强制启用缓存。"
      ]
    },
    {
      "name": "--concurrency-limit",
      "usage": [
        "--concurrency-limit <N>"
      ],
      "tip": [
        "并发运行的最大任务数（默认：4）。"
      ],
      "next": []
    },
    {
      "name": "--fail-if-no-match",
      "tip": [
        "过滤器未匹配到包时以非零状态退出。"
      ]
    },
    {
      "name": "--filter",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --filter <FILTERS>"
      ],
      "tip": [
        "按名称、目录或 glob 模式匹配包。"
      ],
      "next": []
    },
    {
      "name": "--ignore-depends-on",
      "tip": [
        "不运行 `dependsOn` 字段中指定的依赖。"
      ]
    },
    {
      "name": "--last-details",
      "tip": [
        "显示上次运行的详细摘要。"
      ]
    },
    {
      "name": "--log",
      "usage": [
        "--log <MODE>"
      ],
      "tip": [
        "设置输出模式：interleaved（默认）、labeled 或 grouped。"
      ],
      "next": [
        {
          "name": "grouped",
          "tip": [
            "分组输出。"
          ]
        },
        {
          "name": "interleaved",
          "tip": [
            "交错输出（默认）。"
          ]
        },
        {
          "name": "labeled",
          "tip": [
            "带标签输出。"
          ]
        }
      ]
    },
    {
      "name": "--no-cache",
      "tip": [
        "为全部任务与脚本强制禁用缓存。"
      ]
    },
    {
      "name": "--parallel",
      "tip": [
        "忽略依赖顺序运行任务；除非指定 `--concurrency-limit`，否则并发无上限。"
      ]
    },
    {
      "name": "--recursive",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --recursive"
      ],
      "tip": [
        "选择工作区中的全部包。"
      ]
    },
    {
      "name": "--transitive",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --transitive"
      ],
      "tip": [
        "选择当前包及其传递依赖。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "执行后显示完整详细摘要。"
      ]
    },
    {
      "name": "--workspace-root",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --workspace-root"
      ],
      "tip": [
        "选择工作区根包。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助。"
      ]
    }
  ]
}
