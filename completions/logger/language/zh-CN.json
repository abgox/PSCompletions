{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "将消息写入系统日志。"
    ]
  },
  "option": [
    {
      "name": "--file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --file <file>"
      ],
      "tip": [
        "记录此文件的内容。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--id",
      "usage": [
        "--id[=<id>]"
      ],
      "tip": [
        "记录给定的 <id>，否则记录 PID。"
      ],
      "next": []
    },
    {
      "name": "--journald",
      "usage": [
        "--journald[=<file>]"
      ],
      "tip": [
        "写入 journald 条目。"
      ],
      "next": []
    },
    {
      "name": "--msgid",
      "usage": [
        "--msgid <msgid>"
      ],
      "tip": [
        "设置 rfc5424 消息 ID 字段。"
      ],
      "next": []
    },
    {
      "name": "--no-act",
      "tip": [
        "执行所有操作，但不写入日志。"
      ]
    },
    {
      "name": "--octet-count",
      "tip": [
        "使用 rfc6587 八位组计数。"
      ]
    },
    {
      "name": "--port",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --port <port>"
      ],
      "tip": [
        "为此 UDP 或 TCP 连接使用该端口。"
      ],
      "next": []
    },
    {
      "name": "--prio-prefix",
      "tip": [
        "在从标准输入读取的每一行中查找前缀。"
      ]
    },
    {
      "name": "--priority",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --priority <prio>"
      ],
      "tip": [
        "用此优先级标记给定消息。",
        "例如 user.info。"
      ],
      "next": []
    },
    {
      "name": "--rfc3164",
      "tip": [
        "使用过时的 BSD syslog 协议。"
      ]
    },
    {
      "name": "--rfc5424",
      "usage": [
        "--rfc5424[=<snip>]"
      ],
      "tip": [
        "使用 syslog 协议（远程的默认值）。",
        "<snip> 可以是 notime、notq 和/或 nohost。"
      ],
      "next": []
    },
    {
      "name": "--sd-id",
      "usage": [
        "--sd-id <id>"
      ],
      "tip": [
        "RFC 5424 结构化数据 ID。"
      ],
      "next": []
    },
    {
      "name": "--sd-param",
      "usage": [
        "--sd-param <data>"
      ],
      "tip": [
        "RFC 5424 结构化数据 name=value。"
      ],
      "next": []
    },
    {
      "name": "--server",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --server <name>"
      ],
      "tip": [
        "写入此远程 syslog 服务器。"
      ],
      "next": []
    },
    {
      "name": "--size",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --size <size>"
      ],
      "tip": [
        "单条消息的最大大小。"
      ],
      "next": []
    },
    {
      "name": "--socket",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --socket <socket>"
      ],
      "tip": [
        "写入此 Unix 套接字。"
      ],
      "next": []
    },
    {
      "name": "--socket-errors",
      "usage": [
        "--socket-errors <on|off|auto>"
      ],
      "tip": [
        "使用 Unix 套接字时打印连接错误。",
        "可能值: on, off, auto"
      ],
      "next": [
        {
          "name": "auto"
        },
        {
          "name": "off"
        },
        {
          "name": "on"
        }
      ]
    },
    {
      "name": "--stderr",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --stderr"
      ],
      "tip": [
        "同时将消息输出到标准错误。"
      ]
    },
    {
      "name": "--tag",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --tag <tag>"
      ],
      "tip": [
        "为每一行标记此标签。"
      ],
      "next": []
    },
    {
      "name": "--tcp",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --tcp"
      ],
      "tip": [
        "仅使用 TCP。"
      ]
    },
    {
      "name": "--udp",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --udp"
      ],
      "tip": [
        "仅使用 UDP。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "-i",
      "tip": [
        "记录 logger 命令的 PID。"
      ]
    }
  ]
}
