{
  "meta": {
    "url": "https://chezmoi.io",
    "description": [
      "Manage your dotfiles across multiple diverse machines, securely"
    ]
  },
  "next": [
    {
      "name": "add",
      "usage": [
        "add [TARGET]..."
      ],
      "tip": [
        "Add an existing file, directory, or symlink to the source state"
      ]
    },
    {
      "name": "age",
      "tip": [
        "Interact with age"
      ]
    },
    {
      "name": "age-keygen",
      "tip": [
        "Generate an age identity"
      ]
    },
    {
      "name": "apply",
      "usage": [
        "apply [TARGET]..."
      ],
      "tip": [
        "Update the destination directory to match the target state"
      ],
      "option": [
        {
          "name": "--dry-run",
          "alias": [
            "-n"
          ],
          "usage": [
            "-n, --dry-run"
          ],
          "tip": [
            "Do not make any modifications"
          ]
        },
        {
          "name": "--init",
          "tip": [
            "Recreate config file from template"
          ]
        },
        {
          "name": "--recursive",
          "alias": [
            "-r"
          ],
          "usage": [
            "-r, --recursive"
          ],
          "tip": [
            "Recurse into subdirectories (default true)"
          ]
        },
        {
          "name": "--verbose",
          "alias": [
            "-v"
          ],
          "usage": [
            "-v, --verbose"
          ],
          "tip": [
            "Make output more verbose"
          ]
        }
      ]
    },
    {
      "name": "archive",
      "tip": [
        "Generate a tar archive of the target state"
      ]
    },
    {
      "name": "cat",
      "usage": [
        "cat [TARGET]..."
      ],
      "tip": [
        "Print the target contents of a file"
      ]
    },
    {
      "name": "cat-config",
      "tip": [
        "Print the configuration file"
      ]
    },
    {
      "name": "cd",
      "tip": [
        "Launch a shell in the source directory"
      ]
    },
    {
      "name": "chattr",
      "usage": [
        "chattr <ATTRIBUTE>=<VALUE> <TARGET>"
      ],
      "tip": [
        "Change the attributes of a target in the source state"
      ]
    },
    {
      "name": "completion",
      "usage": [
        "completion [SHELL]"
      ],
      "tip": [
        "Generate shell completion code"
      ]
    },
    {
      "name": "data",
      "tip": [
        "Print the template data"
      ]
    },
    {
      "name": "decrypt",
      "usage": [
        "decrypt [FILE]"
      ],
      "tip": [
        "Decrypt file or standard input"
      ]
    },
    {
      "name": "destroy",
      "usage": [
        "destroy [TARGET]..."
      ],
      "tip": [
        "Permanently delete an entry"
      ]
    },
    {
      "name": "diff",
      "usage": [
        "diff [TARGET]..."
      ],
      "tip": [
        "Print the diff between the target state and the destination state"
      ]
    },
    {
      "name": "docker",
      "tip": [
        "Use your dotfiles in a Docker container"
      ]
    },
    {
      "name": "doctor",
      "tip": [
        "Check your system for potential problems"
      ]
    },
    {
      "name": "dump",
      "usage": [
        "dump [TARGET]..."
      ],
      "tip": [
        "Generate a dump of the target state"
      ]
    },
    {
      "name": "dump-config",
      "tip": [
        "Dump the configuration values"
      ]
    },
    {
      "name": "edit",
      "usage": [
        "edit [TARGET]..."
      ],
      "tip": [
        "Edit the source state of a target"
      ]
    },
    {
      "name": "edit-config",
      "tip": [
        "Edit the configuration file"
      ]
    },
    {
      "name": "encrypt",
      "usage": [
        "encrypt [FILE]"
      ],
      "tip": [
        "Encrypt file or standard input"
      ]
    },
    {
      "name": "execute-template",
      "usage": [
        "execute-template [TEMPLATE]..."
      ],
      "tip": [
        "Execute the given template(s)"
      ]
    },
    {
      "name": "forget",
      "usage": [
        "forget [TARGET]..."
      ],
      "tip": [
        "Remove a target from the source state"
      ]
    },
    {
      "name": "git",
      "usage": [
        "git [ARG]..."
      ],
      "tip": [
        "Run git in the source directory"
      ]
    },
    {
      "name": "ignored",
      "tip": [
        "Print ignored targets"
      ]
    },
    {
      "name": "import",
      "usage": [
        "import [FILE]"
      ],
      "tip": [
        "Import an archive into the source state"
      ]
    },
    {
      "name": "init",
      "usage": [
        "init [REPO] [FLAGS]"
      ],
      "tip": [
        "Setup the source directory and update the destination directory"
      ],
      "option": [
        {
          "name": "--apply",
          "alias": [
            "-a"
          ],
          "usage": [
            "-a, --apply"
          ],
          "tip": [
            "Update destination directory"
          ]
        },
        {
          "name": "--guess-repo-url",
          "alias": [
            "-g"
          ],
          "usage": [
            "-g, --guess-repo-url"
          ],
          "tip": [
            "Guess the repo URL (default true)"
          ]
        },
        {
          "name": "--purge",
          "alias": [
            "-p"
          ],
          "usage": [
            "-p, --purge"
          ],
          "tip": [
            "Purge config and source directories after running"
          ]
        },
        {
          "name": "--purge-binary",
          "alias": [
            "-P"
          ],
          "usage": [
            "-P, --purge-binary"
          ],
          "tip": [
            "Purge chezmoi binary after running"
          ]
        },
        {
          "name": "--ssh",
          "tip": [
            "Use SSH instead of HTTPS for guessing repo URL"
          ]
        }
      ]
    },
    {
      "name": "managed",
      "tip": [
        "List the managed entries"
      ]
    },
    {
      "name": "merge",
      "usage": [
        "merge [TARGET]..."
      ],
      "tip": [
        "Perform a three-way merge between destination, source, and target state"
      ]
    },
    {
      "name": "merge-all",
      "tip": [
        "Perform a three-way merge for each modified file"
      ]
    },
    {
      "name": "purge",
      "tip": [
        "Purge chezmoi's configuration and data"
      ]
    },
    {
      "name": "re-add",
      "tip": [
        "Re-add modified files"
      ]
    },
    {
      "name": "secret",
      "usage": [
        "secret [ARG]..."
      ],
      "tip": [
        "Interact with a secret manager"
      ]
    },
    {
      "name": "source-path",
      "usage": [
        "source-path [TARGET]..."
      ],
      "tip": [
        "Print the source path of a target"
      ]
    },
    {
      "name": "ssh",
      "usage": [
        "ssh [HOST]"
      ],
      "tip": [
        "SSH to a host and initialize dotfiles"
      ]
    },
    {
      "name": "state",
      "usage": [
        "state [ARG]..."
      ],
      "tip": [
        "Manipulate the persistent state"
      ]
    },
    {
      "name": "status",
      "usage": [
        "status [TARGET]..."
      ],
      "tip": [
        "Show the status of targets"
      ]
    },
    {
      "name": "target-path",
      "usage": [
        "target-path [SOURCE]"
      ],
      "tip": [
        "Print the target path of a source path"
      ]
    },
    {
      "name": "unmanaged",
      "tip": [
        "List the unmanaged files"
      ]
    },
    {
      "name": "update",
      "tip": [
        "Pull and apply any changes"
      ]
    },
    {
      "name": "upgrade",
      "tip": [
        "Upgrade chezmoi to the latest released version"
      ]
    },
    {
      "name": "verify",
      "tip": [
        "Exit with success if the destination state matches the target state"
      ]
    }
  ],
  "option": [
    {
      "name": "--color",
      "usage": [
        "--color <BOOL>"
      ],
      "tip": [
        "Colorize output"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "Automatic (default)"
          ]
        },
        {
          "name": "false",
          "tip": [
            "Disable color"
          ]
        },
        {
          "name": "true",
          "tip": [
            "Enable color"
          ]
        }
      ]
    },
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config <PATH>"
      ],
      "tip": [
        "Set config file"
      ],
      "next": []
    },
    {
      "name": "--config-format",
      "usage": [
        "--config-format <FORMAT>"
      ],
      "tip": [
        "Set config file format"
      ],
      "next": [
        {
          "name": "json",
          "tip": [
            "JSON format"
          ]
        },
        {
          "name": "toml",
          "tip": [
            "TOML format"
          ]
        },
        {
          "name": "yaml",
          "tip": [
            "YAML format"
          ]
        }
      ]
    },
    {
      "name": "--debug",
      "tip": [
        "Include debug information in output"
      ]
    },
    {
      "name": "--destination",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --destination <PATH>"
      ],
      "tip": [
        "Set destination directory"
      ],
      "next": []
    },
    {
      "name": "--dry-run",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --dry-run"
      ],
      "tip": [
        "Do not make any modifications"
      ]
    },
    {
      "name": "--force",
      "tip": [
        "Make all changes without prompting"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Help for chezmoi"
      ]
    },
    {
      "name": "--keep-going",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --keep-going"
      ],
      "tip": [
        "Keep going after an error"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not use the pager"
      ]
    },
    {
      "name": "--output",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output <PATH>"
      ],
      "tip": [
        "Write output to path instead of stdout"
      ],
      "next": []
    },
    {
      "name": "--progress",
      "usage": [
        "--progress <BOOL>"
      ],
      "tip": [
        "Display progress bars"
      ],
      "next": [
        {
          "name": "auto",
          "tip": [
            "Automatic (default)"
          ]
        },
        {
          "name": "false",
          "tip": [
            "Disable progress bars"
          ]
        },
        {
          "name": "true",
          "tip": [
            "Enable progress bars"
          ]
        }
      ]
    },
    {
      "name": "--refresh-externals",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --refresh-externals <VALUE>"
      ],
      "tip": [
        "Refresh external cache"
      ],
      "next": [
        {
          "name": "always",
          "tip": [
            "Always refresh"
          ]
        },
        {
          "name": "auto",
          "tip": [
            "Automatic (default)"
          ]
        },
        {
          "name": "never",
          "tip": [
            "Never refresh"
          ]
        }
      ]
    },
    {
      "name": "--source",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --source <PATH>"
      ],
      "tip": [
        "Set source directory"
      ],
      "next": []
    },
    {
      "name": "--source-path",
      "tip": [
        "Specify targets by source path"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "Make output more verbose"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Print version"
      ]
    }
  ]
}
