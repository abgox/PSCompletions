{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Show information about file system space usage."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "include dummy file systems"
      ]
    },
    {
      "name": "--block-size",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --block-size <SIZE>"
      ],
      "tip": [
        "scale sizes by SIZE before printing them;"
      ],
      "example": [
        {
          "cmd": "-B M",
          "desc": "prints sizes in units of 1,048,576 bytes"
        }
      ],
      "next": [
        {
          "name": "E",
          "tip": [
            "powers of 1024"
          ]
        },
        {
          "name": "EB",
          "tip": [
            "powers of 1000"
          ]
        },
        {
          "name": "G",
          "tip": [
            "powers of 1024"
          ]
        },
        {
          "name": "GB",
          "tip": [
            "powers of 1000"
          ]
        },
        {
          "name": "K",
          "tip": [
            "powers of 1024"
          ]
        },
        {
          "name": "KB",
          "tip": [
            "powers of 1000"
          ]
        },
        {
          "name": "M",
          "tip": [
            "powers of 1024"
          ]
        },
        {
          "name": "MB",
          "tip": [
            "powers of 1000"
          ]
        },
        {
          "name": "P",
          "tip": [
            "powers of 1024"
          ]
        },
        {
          "name": "PB",
          "tip": [
            "powers of 1000"
          ]
        },
        {
          "name": "T",
          "tip": [
            "powers of 1024"
          ]
        },
        {
          "name": "TB",
          "tip": [
            "powers of 1000"
          ]
        },
        {
          "name": "Y",
          "tip": [
            "powers of 1024"
          ]
        },
        {
          "name": "YB",
          "tip": [
            "powers of 1000"
          ]
        },
        {
          "name": "Z",
          "tip": [
            "powers of 1024"
          ]
        },
        {
          "name": "ZB",
          "tip": [
            "powers of 1000"
          ]
        }
      ]
    },
    {
      "name": "--exclude-type",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exclude-type <TYPE>"
      ],
      "tip": [
        "limit listing to file systems not of type TYPE"
      ],
      "next": []
    },
    {
      "name": "--human-readable",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --human-readable"
      ],
      "tip": [
        "print sizes in human readable format (e.g. 1K 234M 2G)"
      ]
    },
    {
      "name": "--inodes",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --inodes"
      ],
      "tip": [
        "list inode information instead of block usage"
      ]
    },
    {
      "name": "--local",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --local"
      ],
      "tip": [
        "limit listing to local file systems"
      ]
    },
    {
      "name": "--no-sync",
      "tip": [
        "do not invoke sync before getting usage info (default)"
      ]
    },
    {
      "name": "--output",
      "usage": [
        "--output[=<FIELD_LIST>...]"
      ],
      "tip": [
        "use the output format defined by FIELD_LIST, or print all fields if FIELD_LIST is omitted.",
        "[default: source size used avail pcent target]",
        "[possible values: source, fstype, itotal, iused, iavail, ipcent, size, used, avail, pcent, file, target]"
      ],
      "next": []
    },
    {
      "name": "--portability",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --portability"
      ],
      "tip": [
        "use the POSIX output format"
      ]
    },
    {
      "name": "--print-type",
      "alias": [
        "-T"
      ],
      "usage": [
        "-T, --print-type"
      ],
      "tip": [
        "print file system type"
      ]
    },
    {
      "name": "--si",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --si"
      ],
      "tip": [
        "likewise, but use powers of 1000 not 1024"
      ]
    },
    {
      "name": "--sync",
      "tip": [
        "invoke sync before getting usage info (non-windows only)"
      ]
    },
    {
      "name": "--total",
      "tip": [
        "produce a grand total"
      ]
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "limit listing to file systems of type TYPE"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    },
    {
      "name": "-k",
      "tip": [
        "like --block-size=1K"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show the help."
      ]
    }
  ]
}
