{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "检查并执行密码过期策略。"
    ]
  },
  "option": [
    {
      "name": "--check",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --check"
      ],
      "tip": [
        "检查用户的密码过期情况。"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "如果用户的密码已过期，则强制更改密码。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    }
  ]
}
