{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "打印每个 FILE 的换行数、词数和字节数，指定多个 FILE 时再加总计行"
    ]
  },
  "option": [
    {
      "name": "--bytes",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --bytes"
      ],
      "tip": [
        "打印字节数"
      ]
    },
    {
      "name": "--chars",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --chars"
      ],
      "tip": [
        "打印字符数"
      ]
    },
    {
      "name": "--files0-from",
      "usage": [
        "--files0-from <F>"
      ],
      "tip": [
        "从文件 F 中以 NUL 结尾的名称指定的文件读取输入；F 为 - 则从标准输入读取名称"
      ],
      "next": []
    },
    {
      "name": "--lines",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --lines"
      ],
      "tip": [
        "打印换行数"
      ]
    },
    {
      "name": "--max-line-length",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --max-line-length"
      ],
      "tip": [
        "打印最长行的长度"
      ]
    },
    {
      "name": "--total",
      "usage": [
        "--total <WHEN>"
      ],
      "tip": [
        "何时打印总计行；WHEN 可为：auto、always、only、never"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本"
      ]
    },
    {
      "name": "--words",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --words"
      ],
      "tip": [
        "打印词数"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助"
      ]
    }
  ]
}
