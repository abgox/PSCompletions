{
  "meta": {
    "url": "https://restic.net",
    "description": [
      "A backup program",
      "Save multiple revisions of files and directories in an encrypted repository"
    ]
  },
  "next": [
    {
      "name": "backup",
      "usage": [
        "backup [FLAGS] [FILE/DIR]..."
      ],
      "tip": [
        "Create a new backup of files and/or directories"
      ],
      "option": [
        {
          "name": "--dry-run",
          "alias": [
            "-n"
          ],
          "usage": [
            "-n, --dry-run"
          ],
          "tip": [
            "Do not upload or write any data"
          ]
        },
        {
          "name": "--exclude",
          "alias": [
            "-e"
          ],
          "usage": [
            "-e, --exclude <PATTERN>"
          ],
          "tip": [
            "Exclude a pattern"
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--exclude-caches",
          "tip": [
            "Exclude cache directories marked with CACHEDIR.TAG"
          ]
        },
        {
          "name": "--exclude-file",
          "usage": [
            "--exclude-file <FILE>"
          ],
          "tip": [
            "Read exclude patterns from a file"
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--exclude-larger-than",
          "usage": [
            "--exclude-larger-than <SIZE>"
          ],
          "tip": [
            "Max size of files to back up"
          ],
          "next": []
        },
        {
          "name": "--files-from",
          "usage": [
            "--files-from <FILE>"
          ],
          "tip": [
            "Read files to backup from file"
          ],
          "repeat": 99,
          "next": []
        },
        {
          "name": "--force",
          "alias": [
            "-f"
          ],
          "usage": [
            "-f, --force"
          ],
          "tip": [
            "Force re-reading source files"
          ]
        },
        {
          "name": "--group-by",
          "alias": [
            "-g"
          ],
          "usage": [
            "-g, --group-by <GROUP>"
          ],
          "tip": [
            "Group snapshots by host, paths and/or tags"
          ],
          "next": []
        },
        {
          "name": "--host",
          "alias": [
            "-H"
          ],
          "usage": [
            "-H, --host <HOSTNAME>"
          ],
          "tip": [
            "Set the hostname for the snapshot"
          ],
          "next": []
