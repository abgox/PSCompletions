          "next": []
        },
        {
          "name": "--no-size",
          "tip": [
            "Do not output the size of the cache directories"
          ]
        }
      ]
    },
    {
      "name": "cat",
      "usage": [
        "cat [masterkey|config|pack ID|blob ID|snapshot ID|index ID|key ID|lock ID|tree snapshot:subfolder]"
