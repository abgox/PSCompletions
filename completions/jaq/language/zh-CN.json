{
  "meta": {
    "url": "https://github.com/01mf02/jaq",
    "description": [
      "Just Another Query Tool ",
      "专注于正确性和性能的 jq 克隆"
    ]
  },
  "option": [
    {
      "name": "--arg",
      "usage": [
        "--arg <A> <V>"
      ],
      "tip": [
        "将变量 $A 设置为字符串 V"
      ],
      "next": []
    },
    {
      "name": "--argjson",
      "usage": [
        "--argjson <A> <V>"
      ],
      "tip": [
        "将变量 $A 设置为 JSON 值 V"
      ],
      "next": []
    },
    {
      "name": "--args",
      "tip": [
        "将剩余的位置参数收集到 $ARGS.positional 中"
      ]
    },
    {
      "name": "--color-output",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --color-output"
      ],
      "tip": [
        "始终为输出着色"
      ]
    },
    {
      "name": "--compact-output",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --compact-output"
      ],
      "tip": [
        "紧凑打印 JSON，省略空白"
      ]
    },
    {
      "name": "--exit-status",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --exit-status"
      ],
      "tip": [
        "将最后一个输出值用作退出状态码"
      ]
    },
    {
      "name": "--from",
      "usage": [
        "--from <FORMAT>"
      ],
      "tip": [
        "以指定格式读取输入"
      ],
      "next": []
    },
    {
      "name": "--from-file",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --from-file"
      ],
      "tip": [
        "从文件读取过滤器"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息"
      ]
    },
    {
      "name": "--in-place",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --in-place"
      ],
      "tip": [
        "用输出覆盖输入文件"
      ]
    },
    {
      "name": "--indent",
      "usage": [
        "--indent <N>"
      ],
      "tip": [
        "使用 N 个空格进行缩进"
      ],
      "next": []
    },
    {
      "name": "--join-output",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --join-output"
      ],
      "tip": [
        "不在每个值后打印换行符"
      ]
    },
    {
      "name": "--library-path",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --library-path <DIR>"
      ],
      "tip": [
        "在指定目录中搜索模块"
      ],
      "next": []
    },
    {
      "name": "--monochrome-output",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --monochrome-output"
      ],
      "tip": [
        "不为输出着色"
      ]
    },
    {
      "name": "--null-input",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --null-input"
      ],
      "tip": [
        "使用 null 作为唯一的输入值"
      ]
    },
    {
      "name": "--raw-input",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --raw-input"
      ],
      "tip": [
        "将输入的每一行读取为字符串序列"
      ]
    },
    {
      "name": "--raw-input0",
      "tip": [
        "类似 -R 读取输入，但按 NUL 而非换行符分割"
      ]
    },
    {
      "name": "--raw-output",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw-output"
      ],
      "tip": [
        "写入字符串时不使用引号转义"
      ]
    },
    {
      "name": "--raw-output0",
      "tip": [
        "类似 -r 写入输出，但每次输出后打印 NUL"
      ]
    },
    {
      "name": "--rawfile",
      "usage": [
        "--rawfile <A> <F>"
      ],
      "tip": [
        "将变量 $A 设置为文件 F 中的字符串"
      ],
      "next": []
    },
    {
      "name": "--run-tests",
      "usage": [
        "--run-tests <FILE>"
      ],
      "tip": [
        "从文件运行测试"
      ],
      "next": []
    },
    {
      "name": "--slurp",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --slurp"
      ],
      "tip": [
        "将所有输入值读取到一个数组中"
      ]
    },
    {
      "name": "--slurpfile",
      "usage": [
        "--slurpfile <A> <F>"
      ],
      "tip": [
        "将变量 $A 设置为 JSON 文件 F 中的数组"
      ],
      "next": []
    },
    {
      "name": "--sort-keys",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --sort-keys"
      ],
      "tip": [
        "按键排序打印对象"
      ]
    },
    {
      "name": "--tab",
      "tip": [
        "使用制表符而非空格进行缩进"
      ]
    },
    {
      "name": "--to",
      "usage": [
        "--to <FORMAT>"
      ],
      "tip": [
        "以指定格式写入输出"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本号"
      ]
    }
  ]
}
