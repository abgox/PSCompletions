{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Display and adjust the OOM-killer score."
    ]
  },
  "option": [
    {
      "name": "--adjust",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --adjust <num>"
      ],
      "tip": [
        "Specify the adjust score value."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid <num>"
      ],
      "tip": [
        "Process ID."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
