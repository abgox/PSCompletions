{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示和调整 OOM killer 分数。"
    ]
  },
  "option": [
    {
      "name": "--adjust",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --adjust <num>"
      ],
      "tip": [
        "指定调整分数值。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--pid",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pid <num>"
      ],
      "tip": [
        "进程 ID。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
