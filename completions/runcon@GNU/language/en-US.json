{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "Run a program in a different SELinux security context."
    ]
  },
  "option": [
    {
      "name": "--compute",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --compute"
      ],
      "tip": [
        "compute process transition context before modifying"
      ]
    },
    {
      "name": "--range",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --range <RANGE>"
      ],
      "tip": [
        "levelrange"
      ],
      "next": []
    },
    {
      "name": "--role",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --role <ROLE>"
      ],
      "tip": [
        "role"
      ],
      "next": []
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "type (for same role as parent)"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <USER>"
      ],
      "tip": [
        "user identity"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "display this help and exit"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "output version information and exit"
      ]
    }
  ]
}
