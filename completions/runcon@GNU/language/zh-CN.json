{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "在不同的 SELinux 安全上下文中运行程序。"
    ]
  },
  "option": [
    {
      "name": "--compute",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --compute"
      ],
      "tip": [
        "在修改之前计算进程转换上下文"
      ]
    },
    {
      "name": "--range",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --range <RANGE>"
      ],
      "tip": [
        "MLS 级别范围"
      ],
      "next": []
    },
    {
      "name": "--role",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --role <ROLE>"
      ],
      "tip": [
        "角色"
      ],
      "next": []
    },
    {
      "name": "--type",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --type <TYPE>"
      ],
      "tip": [
        "类型（角色与父进程相同）"
      ],
      "next": []
    },
    {
      "name": "--user",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --user <USER>"
      ],
      "tip": [
        "用户身份"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
