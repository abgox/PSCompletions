{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "显示或设置系统主机名。"
    ]
  },
  "option": [
    {
      "name": "--domain",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --domain"
      ],
      "tip": [
        "如果可能，显示 DNS 域名"
      ]
    },
    {
      "name": "--fqdn",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fqdn"
      ],
      "tip": [
        "显示 FQDN（完全限定域名）（默认）"
      ]
    },
    {
      "name": "--ip-address",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ip-address"
      ],
      "tip": [
        "显示主机的网络地址"
      ]
    },
    {
      "name": "--short",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --short"
      ],
      "tip": [
        "如果可能，显示短主机名（第一个点之前的部分）"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息"
      ]
    }
  ]
}
