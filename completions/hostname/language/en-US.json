{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Display or set the system's host name."
    ]
  },
  "option": [
    {
      "name": "--domain",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --domain"
      ],
      "tip": [
        "display the name of the DNS domain if possible"
      ]
    },
    {
      "name": "--fqdn",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fqdn"
      ],
      "tip": [
        "display the FQDN (Fully Qualified Domain Name) (default)"
      ]
    },
    {
      "name": "--ip-address",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ip-address"
      ],
      "tip": [
        "display the network address(es) of the host"
      ]
    },
    {
      "name": "--short",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --short"
      ],
      "tip": [
        "display the short hostname (the portion before the first dot) if possible"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Print version"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Print help"
      ]
    }
  ]
}
