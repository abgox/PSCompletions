{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Display or manipulate a disk partition table."
    ]
  },
  "option": [
    {
      "name": "--color",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --color[=<when>]"
      ],
      "tip": [
        "Colorize output.",
        "Colors are enabled by default.",
        "Possible values: auto, always, never"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--lock",
      "usage": [
        "--lock[=<mode>]"
      ],
      "tip": [
        "Use exclusive device lock.",
        "Possible values: yes, no, nonblock"
      ],
      "next": [
        {
          "name": "no"
        },
        {
          "name": "nonblock"
        },
        {
          "name": "yes"
        }
      ]
    },
    {
      "name": "--read-only",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --read-only"
      ],
      "tip": [
        "Force open cfdisk in read-only mode."
      ]
    },
    {
      "name": "--sector-size",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --sector-size <size>"
      ],
      "tip": [
        "Physical and logical sector size."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    },
    {
      "name": "--zero",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero"
      ],
      "tip": [
        "Start with a zeroed partition table."
      ]
    }
  ]
}
