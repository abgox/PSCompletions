{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "输出当前进程可用的核心数。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "tip": [
        "打印系统可用的 CPU 核心数"
      ]
    },
    {
      "name": "--ignore",
      "usage": [
        "--ignore <N>"
      ],
      "tip": [
        "忽略最多 N 个核心"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
