{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "Print the number of cores available to the current process."
    ]
  },
  "option": [
    {
      "name": "--all",
      "tip": [
        "print the number of cores available to the system"
      ]
    },
    {
      "name": "--ignore",
      "usage": [
        "--ignore <N>"
      ],
      "tip": [
        "ignore up to N cores"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Show the version."
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show the help."
      ]
    }
  ]
}
