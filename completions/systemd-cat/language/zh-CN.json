{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "执行进程并将其标准输出/标准错误连接到日志。"
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助。"
      ]
    },
    {
      "name": "--identifier",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --identifier=STRING"
      ],
      "tip": [
        "设置 syslog 标识符。"
      ],
      "next": []
    },
    {
      "name": "--level-prefix",
      "usage": [
        "--level-prefix=BOOL"
      ],
      "tip": [
        "控制是否解析级别前缀。"
      ],
      "next": []
    },
    {
      "name": "--namespace",
      "usage": [
        "--namespace=NAMESPACE"
      ],
      "tip": [
        "连接到指定的日志命名空间。"
      ],
      "next": []
    },
    {
      "name": "--priority",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --priority=PRIORITY"
      ],
      "tip": [
        "设置优先级值（0..7）。"
      ],
      "next": []
    },
    {
      "name": "--stderr-priority",
      "usage": [
        "--stderr-priority=PRIORITY"
      ],
      "tip": [
        "设置用于标准错误的优先级值（0..7）。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    }
  ]
}
