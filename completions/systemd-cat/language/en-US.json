{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Execute a process with stdout/stderr connected to the journal."
    ]
  },
  "option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help."
      ]
    },
    {
      "name": "--identifier",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --identifier=STRING"
      ],
      "tip": [
        "Set the syslog identifier."
      ],
      "next": []
    },
    {
      "name": "--level-prefix",
      "usage": [
        "--level-prefix=BOOL"
      ],
      "tip": [
        "Control whether the level prefix shall be parsed."
      ],
      "next": []
    },
    {
      "name": "--namespace",
      "usage": [
        "--namespace=NAMESPACE"
      ],
      "tip": [
        "Connect to the specified journal namespace."
      ],
      "next": []
    },
    {
      "name": "--priority",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --priority=PRIORITY"
      ],
      "tip": [
        "Set the priority value (0..7)."
      ],
      "next": []
    },
    {
      "name": "--stderr-priority",
      "usage": [
        "--stderr-priority=PRIORITY"
      ],
      "tip": [
        "Set the priority value (0..7) used for stderr."
      ],
      "next": []
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    }
  ]
}
