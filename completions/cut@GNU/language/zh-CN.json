{
  "meta": {
    "url": "https://www.gnu.org/software/coreutils/",
    "description": [
      "把每个 FILE 中各行的选定部分打印到标准输出。"
    ]
  },
  "option": [
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes <LIST>"
      ],
      "tip": [
        "只选择这些字节"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--characters",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --characters <LIST>"
      ],
      "tip": [
        "只选择这些字符"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--complement",
      "tip": [
        "取所选字节、字符或字段的补集"
      ]
    },
    {
      "name": "--delimiter",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delimiter <DELIM>"
      ],
      "tip": [
        "用 DELIM 而不是 TAB 作为字段分隔符"
      ],
      "next": []
    },
    {
      "name": "--fields",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --fields <LIST>"
      ],
      "tip": [
        "只选择这些字段；含分隔符的行一律输出，不含分隔符的行仅在未指定 -s 时输出"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--only-delimited",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --only-delimited"
      ],
      "tip": [
        "不输出不含分隔符的行"
      ]
    },
    {
      "name": "--output-delimiter",
      "usage": [
        "--output-delimiter <STRING>"
      ],
      "tip": [
        "用 STRING 作为输出分隔符，默认与输入分隔符相同"
      ],
      "next": []
    },
    {
      "name": "--zero-terminated",
      "alias": [
        "-z"
      ],
      "usage": [
        "-z, --zero-terminated"
      ],
      "tip": [
        "行分隔符为 NUL，而不是换行符"
      ]
    },
    {
      "name": "-n",
      "tip": [
        "（已忽略，不起作用）"
      ]
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "tip": [
        "显示此帮助并退出"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "输出版本信息并退出"
      ]
    }
  ]
}
