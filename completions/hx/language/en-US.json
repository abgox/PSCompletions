{
  "meta": {
    "url": "https://github.com/helix-editor/helix",
    "description": [
      "A post-modern text editor"
    ]
  },
  "option": [
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config <file>"
      ],
      "tip": [
        "Specifies a file to use for configuration"
      ],
      "next": []
    },
    {
      "name": "--grammar",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --grammar <ACTION>"
      ],
      "tip": [
        "Fetches or builds tree-sitter grammars listed in languages.toml"
      ],
      "next": [
        {
          "name": "build",
          "tip": [
            "Build tree-sitter grammars"
          ]
        },
        {
          "name": "fetch",
          "tip": [
            "Fetch tree-sitter grammars"
          ]
        }
      ]
    },
    {
      "name": "--health",
      "usage": [
        "--health [CATEGORY]"
      ],
      "tip": [
        "Checks for potential errors in editor setup"
      ],
      "next": [
        {
          "name": "all",
          "tip": [
            "Check everything (default)"
          ]
        },
        {
          "name": "clipboard",
          "tip": [
            "Check clipboard support"
          ]
        },
        {
          "name": "languages",
          "tip": [
            "Check language support"
          ]
        }
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Prints help information"
      ]
    },
    {
      "name": "--hsplit",
      "tip": [
        "Splits all given files horizontally into different windows"
      ]
    },
    {
      "name": "--log",
      "usage": [
        "--log <file>"
      ],
      "tip": [
        "Specifies a file to use for logging"
      ],
      "next": []
    },
    {
      "name": "--tutor",
      "tip": [
        "Loads the tutorial"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Prints version information"
      ]
    },
    {
      "name": "--vsplit",
      "tip": [
        "Splits all given files vertically into different windows"
      ]
    },
    {
      "name": "--working-dir",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --working-dir <path>"
      ],
      "tip": [
        "Specify an initial working directory"
      ],
      "next": []
    },
    {
      "name": "-v",
      "tip": [
        "Increases logging verbosity each use for up to 3 times"
      ],
      "repeat": 3
    },
    {
      "name": "+N",
      "tip": [
        "Open the first given file at line number N"
      ]
    }
  ]
}
