{
  "meta": {
    "url": "https://github.com/helix-editor/helix",
    "description": [
      "一种后现代文本编辑器"
    ]
  },
  "option": [
    {
      "name": "--config",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --config <file>"
      ],
      "tip": [
        "指定用于配置的文件"
      ],
      "next": []
    },
    {
      "name": "--grammar",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --grammar <ACTION>"
      ],
      "tip": [
        "获取或构建 languages.toml 中列出的 tree-sitter 语法"
      ],
      "next": [
        {
          "name": "build",
          "tip": [
            "构建 tree-sitter 语法"
          ]
        },
        {
          "name": "fetch",
          "tip": [
            "获取 tree-sitter 语法"
          ]
        }
      ]
    },
    {
      "name": "--health",
      "usage": [
        "--health [CATEGORY]"
      ],
      "tip": [
        "检查编辑器设置中的潜在错误"
      ],
      "next": [
        {
          "name": "all",
          "tip": [
            "检查所有项（默认）"
          ]
        },
        {
          "name": "clipboard",
          "tip": [
            "检查剪贴板支持"
          ]
        },
        {
          "name": "languages",
          "tip": [
            "检查语言支持"
          ]
        }
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "打印帮助信息"
      ]
    },
    {
      "name": "--hsplit",
      "tip": [
        "将所有给定文件水平拆分到不同的窗口"
      ]
    },
    {
      "name": "--log",
      "usage": [
        "--log <file>"
      ],
      "tip": [
        "指定用于日志记录的文件"
      ],
      "next": []
    },
    {
      "name": "--tutor",
      "tip": [
        "加载教程"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "打印版本信息"
      ]
    },
    {
      "name": "--vsplit",
      "tip": [
        "将所有给定文件垂直拆分到不同的窗口"
      ]
    },
    {
      "name": "--working-dir",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --working-dir <path>"
      ],
      "tip": [
        "指定初始工作目录"
      ],
      "next": []
    },
    {
      "name": "-v",
      "tip": [
        "每次使用增加日志详细程度，最多 3 次"
      ],
      "repeat": 3
    },
    {
      "name": "+N",
      "tip": [
        "在指定行号 N 打开第一个文件"
      ]
    }
  ]
}
