{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "显示 CPU 体系结构信息。"
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "同时打印在线和离线 CPU（-e 的默认值）。"
      ]
    },
    {
      "name": "--bytes",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --bytes"
      ],
      "tip": [
        "以字节而不是人类可读格式打印大小。"
      ]
    },
    {
      "name": "--caches",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --caches[=<list>]"
      ],
      "tip": [
        "以扩展可读格式显示缓存信息。"
      ],
      "next": []
    },
    {
      "name": "--extended",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --extended[=<list>]"
      ],
      "tip": [
        "打印扩展可读格式。"
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--hex",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --hex"
      ],
      "tip": [
        "打印十六进制掩码而不是 CPU 列表。"
      ]
    },
    {
      "name": "--hierarchic",
      "usage": [
        "--hierarchic[=when]"
      ],
      "tip": [
        "在摘要中使用子节。",
        "可能值: auto, never, always"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "为默认或扩展格式使用 JSON。"
      ]
    },
    {
      "name": "--offline",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --offline"
      ],
      "tip": [
        "仅打印离线 CPU。"
      ]
    },
    {
      "name": "--online",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --online"
      ],
      "tip": [
        "仅打印在线 CPU（-p 的默认值）。"
      ]
    },
    {
      "name": "--output-all",
      "tip": [
        "打印 -e、-p 或 -C 的所有可用列。"
      ]
    },
    {
      "name": "--parse",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --parse[=<list>]"
      ],
      "tip": [
        "打印可解析格式。"
      ],
      "next": []
    },
    {
      "name": "--physical",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --physical"
      ],
      "tip": [
        "打印物理 ID 而不是逻辑 ID。"
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "使用原始输出格式（用于 -e、-p 和 -C）。"
      ]
    },
    {
      "name": "--sysroot",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sysroot <dir>"
      ],
      "tip": [
        "使用指定目录作为系统根目录。"
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
