{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Display information about the CPU architecture."
    ]
  },
  "option": [
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Print both online and offline CPUs (default for -e)."
      ]
    },
    {
      "name": "--bytes",
      "alias": [
        "-B"
      ],
      "usage": [
        "-B, --bytes"
      ],
      "tip": [
        "Print sizes in bytes rather than in human readable format."
      ]
    },
    {
      "name": "--caches",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --caches[=<list>]"
      ],
      "tip": [
        "Info about caches in extended readable format."
      ],
      "next": []
    },
    {
      "name": "--extended",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --extended[=<list>]"
      ],
      "tip": [
        "Print out an extended readable format."
      ],
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--hex",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --hex"
      ],
      "tip": [
        "Print hexadecimal masks rather than lists of CPUs."
      ]
    },
    {
      "name": "--hierarchic",
      "usage": [
        "--hierarchic[=when]"
      ],
      "tip": [
        "Use subsections in summary.",
        "Possible values: auto, never, always"
      ],
      "next": [
        {
          "name": "always"
        },
        {
          "name": "auto"
        },
        {
          "name": "never"
        }
      ]
    },
    {
      "name": "--json",
      "alias": [
        "-J"
      ],
      "usage": [
        "-J, --json"
      ],
      "tip": [
        "Use JSON for default or extended format."
      ]
    },
    {
      "name": "--offline",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --offline"
      ],
      "tip": [
        "Print offline CPUs only."
      ]
    },
    {
      "name": "--online",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --online"
      ],
      "tip": [
        "Print online CPUs only (default for -p)."
      ]
    },
    {
      "name": "--output-all",
      "tip": [
        "Print all available columns for -e, -p or -C."
      ]
    },
    {
      "name": "--parse",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --parse[=<list>]"
      ],
      "tip": [
        "Print out a parsable format."
      ],
      "next": []
    },
    {
      "name": "--physical",
      "alias": [
        "-y"
      ],
      "usage": [
        "-y, --physical"
      ],
      "tip": [
        "Print physical instead of logical IDs."
      ]
    },
    {
      "name": "--raw",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --raw"
      ],
      "tip": [
        "Use raw output format (for -e, -p and -C)."
      ]
    },
    {
      "name": "--sysroot",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --sysroot <dir>"
      ],
      "tip": [
        "Use specified directory as system root."
      ],
      "next": []
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
