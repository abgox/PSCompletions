{
  "meta": {
    "url": "https://github.com/remy/nodemon",
    "description": [
      "监控文件变化并自动重启 Node.js 服务器。"
    ]
  },
  "option": [
    {
      "name": "--config",
      "usage": [
        "--config <file>"
      ],
      "tip": [
        "使用备用 nodemon.json 配置文件"
      ],
      "next": []
    },
    {
      "name": "--cwd",
      "usage": [
        "--cwd <dir>"
      ],
      "tip": [
        "在运行脚本之前切换到 <dir> 目录"
      ],
      "next": []
    },
    {
      "name": "--delay",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --delay <n>"
      ],
      "tip": [
        "将重启防抖 \"n\" 秒"
      ],
      "next": []
    },
    {
      "name": "--dump",
      "tip": [
        "打印完整的调试配置"
      ]
    },
    {
      "name": "--exec",
      "alias": [
        "-x"
      ],
      "usage": [
        "-x, --exec <app>"
      ],
      "tip": [
        "使用 \"app\" 执行脚本，例如 -x \"python -v\""
      ],
      "next": []
    },
    {
      "name": "--exitcrash",
      "tip": [
        "崩溃时退出，允许 nodemon 与其他监视器一起工作"
      ]
    },
    {
      "name": "--ext",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --ext <ext>"
      ],
      "tip": [
        "要监视的扩展名，例如 \"js,pug,hbs\""
      ],
      "next": []
    },
    {
      "name": "--ignore",
      "alias": [
        "-i"
      ],
      "usage": [
        "-i, --ignore <path>"
      ],
      "tip": [
        "忽略特定文件或目录"
      ],
      "next": []
    },
    {
      "name": "--legacy-watch",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --legacy-watch"
      ],
      "tip": [
        "使用轮询监视更改（通常在网络/Docker 上监视时需要）"
      ]
    },
    {
      "name": "--no-colors",
      "tip": [
        "禁用彩色输出"
      ]
    },
    {
      "name": "--no-stdin",
      "alias": [
        "-I"
      ],
      "usage": [
        "-I, --no-stdin"
      ],
      "tip": [
        "nodemon 将标准输入直接传递给子进程"
      ]
    },
    {
      "name": "--no-update-notifier",
      "tip": [
        "退出更新版本检查"
      ]
    },
    {
      "name": "--on-change-only",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --on-change-only"
      ],
      "tip": [
        "仅在更改时执行脚本，不在启动时执行"
      ]
    },
    {
      "name": "--polling-interval",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --polling-interval <ms>"
      ],
      "tip": [
        "与 -L 配合使用，轮询间隔毫秒数（默认 100）"
      ],
      "next": [
        {
          "name": "1000"
        },
        {
          "name": "5000"
        }
      ]
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "最小化 nodemon 消息，仅显示启动/停止"
      ]
    },
    {
      "name": "--signal",
      "usage": [
        "--signal <signal>"
      ],
      "tip": [
        "使用指定的终止信号代替默认值（例如 SIGTERM）"
      ],
      "next": []
    },
    {
      "name": "--spawn",
      "tip": [
        "强制 nodemon 使用 spawn（而不是 fork）[仅限 node]"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --verbose"
      ],
      "tip": [
        "显示导致重启的详细信息"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示当前 nodemon 版本"
      ]
    },
    {
      "name": "--watch",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --watch <path>"
      ],
      "tip": [
        "监视目录 \"path\" 或文件。每个目录或文件使用一次"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息"
      ]
    }
  ]
}
