{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "修改用户账户。"
    ]
  },
  "option": [
    {
      "name": "--add-subgids",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --add-subgids <FIRST-LAST>"
      ],
      "tip": [
        "向用户账户添加从属 gid 范围。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--add-subuids",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --add-subuids <FIRST-LAST>"
      ],
      "tip": [
        "向用户账户添加从属 uid 范围。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--append",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --append"
      ],
      "tip": [
        "将用户追加到 -G 选项提到的附加组，而不从其他组中移除该用户。"
      ]
    },
    {
      "name": "--badname",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --badname"
      ],
      "tip": [
        "允许不符合标准的名称。(已弃用)"
      ]
    },
    {
      "name": "--comment",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --comment <COMMENT>"
      ],
      "tip": [
        "GECOS 字段的新值。"
      ],
      "next": []
    },
    {
      "name": "--del-subgids",
      "alias": [
        "-W"
      ],
      "usage": [
        "-W, --del-subgids <FIRST-LAST>"
      ],
      "tip": [
        "从用户账户移除从属 gid 范围。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--del-subuids",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --del-subuids <FIRST-LAST>"
      ],
      "tip": [
        "从用户账户移除从属 uid 范围。"
      ],
      "repeat": 99,
      "next": []
    },
    {
      "name": "--expiredate",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --expiredate <EXPIRE_DATE>"
      ],
      "tip": [
        "将账户失效日期设置为 EXPIRE_DATE。"
      ],
      "next": []
    },
    {
      "name": "--gid",
      "alias": [
        "-g"
      ],
      "usage": [
        "-g, --gid <GROUP>"
      ],
      "tip": [
        "强制使用 GROUP 作为新的主组。"
      ],
      "next": []
    },
    {
      "name": "--groups",
      "alias": [
        "-G"
      ],
      "usage": [
        "-G, --groups <GROUPS>"
      ],
      "tip": [
        "新的附加组列表。"
      ],
      "separator": ",",
      "next": []
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--home",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --home <HOME_DIR>"
      ],
      "tip": [
        "用户账户的新主目录。"
      ],
      "next": []
    },
    {
      "name": "--inactive",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --inactive <INACTIVE>"
      ],
      "tip": [
        "设置密码过期后的不活跃天数。"
      ],
      "next": []
    },
    {
      "name": "--lock",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --lock"
      ],
      "tip": [
        "锁定用户账户。"
      ]
    },
    {
      "name": "--login",
      "alias": [
        "-l"
      ],
      "usage": [
        "-l, --login <NEW_LOGIN>"
      ],
      "tip": [
        "登录名的新值。"
      ],
      "next": []
    },
    {
      "name": "--move-home",
      "alias": [
        "-m"
      ],
      "usage": [
        "-m, --move-home"
      ],
      "tip": [
        "将主目录内容移动到新位置（仅与 -d 一起使用）。"
      ]
    },
    {
      "name": "--non-unique",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --non-unique"
      ],
      "tip": [
        "允许使用重复（非唯一）的 UID。"
      ]
    },
    {
      "name": "--password",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --password <PASSWORD>"
      ],
      "tip": [
        "为新密码使用加密密码。"
      ],
      "next": []
    },
    {
      "name": "--prefix",
      "alias": [
        "-P"
      ],
      "usage": [
        "-P, --prefix <PREFIX_DIR>"
      ],
      "tip": [
        "在 PREFIX_DIR 下的根文件系统中应用对配置文件的更改。",
        "该选项不会 chroot，用于准备交叉编译目标。"
      ],
      "next": []
    },
    {
      "name": "--remove",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --remove"
      ],
      "tip": [
        "仅从 -G 选项提到的附加组中移除用户，而不从其他组中移除该用户。"
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--selinux-range",
      "usage": [
        "--selinux-range <SERANGE>"
      ],
      "tip": [
        "用户账户的新的 SELinux MLS 范围。"
      ],
      "next": []
    },
    {
      "name": "--selinux-user",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --selinux-user <SEUSER>"
      ],
      "tip": [
        "用户账户的新的 SELinux 用户映射。"
      ],
      "next": []
    },
    {
      "name": "--shell",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --shell <SHELL>"
      ],
      "tip": [
        "用户账户的新的登录 Shell。"
      ],
      "next": []
    },
    {
      "name": "--uid",
      "alias": [
        "-u"
      ],
      "usage": [
        "-u, --uid <UID>"
      ],
      "tip": [
        "用户账户的新 UID。"
      ],
      "next": []
    },
    {
      "name": "--unlock",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --unlock"
      ],
      "tip": [
        "解锁用户账户。"
      ]
    }
  ]
}
