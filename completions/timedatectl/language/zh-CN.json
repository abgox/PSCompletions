{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "查询或更改系统时间和日期设置。"
    ]
  },
  "next": [
    {
      "name": "list-timezones",
      "tip": [
        "显示已知时区。"
      ]
    },
    {
      "name": "ntp-servers",
      "usage": [
        "ntp-servers INTERFACE SERVER…"
      ],
      "tip": [
        "设置接口特定的 NTP 服务器。"
      ]
    },
    {
      "name": "revert",
      "usage": [
        "revert INTERFACE"
      ],
      "tip": [
        "还原接口特定的 NTP 服务器。"
      ]
    },
    {
      "name": "set-local-rtc",
      "usage": [
        "set-local-rtc BOOL"
      ],
      "tip": [
        "控制 RTC 是否使用本地时间。"
      ]
    },
    {
      "name": "set-ntp",
      "usage": [
        "set-ntp BOOL"
      ],
      "tip": [
        "启用或禁用网络时间同步。"
      ]
    },
    {
      "name": "set-time",
      "usage": [
        "set-time TIME"
      ],
      "tip": [
        "设置系统时间。"
      ]
    },
    {
      "name": "set-timezone",
      "usage": [
        "set-timezone ZONE"
      ],
      "tip": [
        "设置系统时区。"
      ]
    },
    {
      "name": "show",
      "tip": [
        "显示 systemd-timedated 的属性。"
      ]
    },
    {
      "name": "show-timesync",
      "tip": [
        "显示 systemd-timesyncd 的属性。"
      ]
    },
    {
      "name": "status",
      "tip": [
        "显示当前时间设置。"
      ]
    },
    {
      "name": "timesync-status",
      "tip": [
        "显示 systemd-timesyncd 状态。"
      ]
    }
  ],
  "option": [
    {
      "name": "--adjust-system-clock",
      "tip": [
        "更改本地 RTC 模式时调整系统时钟。"
      ]
    },
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "显示所有属性，包括空属性。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助信息。"
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "在远程主机上操作。"
      ],
      "next": []
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "对本机容器操作。"
      ],
      "next": []
    },
    {
      "name": "--monitor",
      "tip": [
        "监视 systemd-timesyncd 的状态。"
      ]
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "不提示输入密码。"
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "不将输出通过管道传给分页器。"
      ]
    },
    {
      "name": "--property",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --property=NAME"
      ],
      "tip": [
        "仅显示此名称的属性。"
      ],
      "next": []
    },
    {
      "name": "--value",
      "tip": [
        "显示属性时仅打印值。"
      ]
    },
    {
      "name": "--version",
      "tip": [
        "显示软件包版本。"
      ]
    },
    {
      "name": "-P",
      "usage": [
        "-P NAME"
      ],
      "tip": [
        "等同于 --value --property=NAME。"
      ],
      "next": []
    }
  ]
}
