{
  "meta": {
    "url": "https://github.com/systemd/systemd",
    "description": [
      "Query or change system time and date settings."
    ]
  },
  "next": [
    {
      "name": "list-timezones",
      "tip": [
        "Show known time zones."
      ]
    },
    {
      "name": "ntp-servers",
      "usage": [
        "ntp-servers INTERFACE SERVER…"
      ],
      "tip": [
        "Set the interface specific NTP servers."
      ]
    },
    {
      "name": "revert",
      "usage": [
        "revert INTERFACE"
      ],
      "tip": [
        "Revert the interface specific NTP servers."
      ]
    },
    {
      "name": "set-local-rtc",
      "usage": [
        "set-local-rtc BOOL"
      ],
      "tip": [
        "Control whether RTC is in local time."
      ]
    },
    {
      "name": "set-ntp",
      "usage": [
        "set-ntp BOOL"
      ],
      "tip": [
        "Enable or disable network time synchronization."
      ]
    },
    {
      "name": "set-time",
      "usage": [
        "set-time TIME"
      ],
      "tip": [
        "Set system time."
      ]
    },
    {
      "name": "set-timezone",
      "usage": [
        "set-timezone ZONE"
      ],
      "tip": [
        "Set system time zone."
      ]
    },
    {
      "name": "show",
      "tip": [
        "Show properties of systemd-timedated."
      ]
    },
    {
      "name": "show-timesync",
      "tip": [
        "Show properties of systemd-timesyncd."
      ]
    },
    {
      "name": "status",
      "tip": [
        "Show current time settings."
      ]
    },
    {
      "name": "timesync-status",
      "tip": [
        "Show status of systemd-timesyncd."
      ]
    }
  ],
  "option": [
    {
      "name": "--adjust-system-clock",
      "tip": [
        "Adjust system clock when changing local RTC mode."
      ]
    },
    {
      "name": "--all",
      "alias": [
        "-a"
      ],
      "usage": [
        "-a, --all"
      ],
      "tip": [
        "Show all properties, including empty ones."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show this help message."
      ]
    },
    {
      "name": "--host",
      "alias": [
        "-H"
      ],
      "usage": [
        "-H, --host=[USER@]HOST"
      ],
      "tip": [
        "Operate on remote host."
      ],
      "next": []
    },
    {
      "name": "--machine",
      "alias": [
        "-M"
      ],
      "usage": [
        "-M, --machine=CONTAINER"
      ],
      "tip": [
        "Operate on local container."
      ],
      "next": []
    },
    {
      "name": "--monitor",
      "tip": [
        "Monitor status of systemd-timesyncd."
      ]
    },
    {
      "name": "--no-ask-password",
      "tip": [
        "Do not prompt for password."
      ]
    },
    {
      "name": "--no-pager",
      "tip": [
        "Do not pipe output into a pager."
      ]
    },
    {
      "name": "--property",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --property=NAME"
      ],
      "tip": [
        "Show only properties by this name."
      ],
      "next": []
    },
    {
      "name": "--value",
      "tip": [
        "When showing properties, only print the value."
      ]
    },
    {
      "name": "--version",
      "tip": [
        "Show package version."
      ]
    },
    {
      "name": "-P",
      "usage": [
        "-P NAME"
      ],
      "tip": [
        "Equivalent to --value --property=NAME."
      ],
      "next": []
    }
  ]
}
