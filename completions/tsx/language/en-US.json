{
  "meta": {
    "url": "https://tsx.hirok.io",
    "description": [
      "TypeScript Execute. The easiest way to run TypeScript in Node.js."
    ]
  },
  "next": [
    {
      "name": "watch",
      "tip": [
        "Run the script and watch for changes."
      ],
      "option": [
        {
          "name": "--clear-screen",
          "tip": [
            "Clearing the screen on rerun (default: true)."
          ]
        },
        {
          "name": "--exclude",
          "usage": [
            "--exclude <string>"
          ],
          "tip": [
            "Paths & globs to exclude from being watched."
          ],
          "next": []
        },
        {
          "name": "--ignore",
          "usage": [
            "--ignore <string>"
          ],
          "tip": [
            "Paths & globs to exclude from being watched (Deprecated: use --exclude)."
          ],
          "next": []
        },
        {
          "name": "--include",
          "usage": [
            "--include <string>"
          ],
          "tip": [
            "Additional paths & globs to watch."
          ],
          "next": []
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--no-cache",
      "tip": [
        "Disable caching."
      ]
    },
    {
      "name": "--tsconfig",
      "usage": [
        "--tsconfig <string>"
      ],
      "tip": [
        "Custom tsconfig.json path."
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Show help."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "Show version."
      ]
    }
  ]
}
