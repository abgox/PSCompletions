{
  "meta": {
    "url": "https://tsx.hirok.io",
    "description": [
      "TypeScript Execute。在 Node.js 中运行 TypeScript 的最简单方式。"
    ]
  },
  "next": [
    {
      "name": "watch",
      "tip": [
        "运行脚本并监视更改。"
      ],
      "option": [
        {
          "name": "--clear-screen",
          "tip": [
            "重新运行时清屏（默认：true）。"
          ]
        },
        {
          "name": "--exclude",
          "usage": [
            "--exclude <string>"
          ],
          "tip": [
            "要排除监视的路径和 glob 模式。"
          ],
          "next": []
        },
        {
          "name": "--ignore",
          "usage": [
            "--ignore <string>"
          ],
          "tip": [
            "要排除监视的路径和 glob 模式（已弃用：请使用 --exclude）。"
          ],
          "next": []
        },
        {
          "name": "--include",
          "usage": [
            "--include <string>"
          ],
          "tip": [
            "要监视的附加路径和 glob 模式。"
          ],
          "next": []
        }
      ]
    }
  ],
  "option": [
    {
      "name": "--no-cache",
      "tip": [
        "禁用缓存。"
      ]
    },
    {
      "name": "--tsconfig",
      "usage": [
        "--tsconfig <string>"
      ],
      "tip": [
        "自定义 tsconfig.json 路径。"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
