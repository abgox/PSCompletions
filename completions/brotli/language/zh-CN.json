{
  "meta": {
    "url": "https://github.com/google/brotli",
    "description": [
      "使用 Brotli 算法压缩或解压文件。"
    ]
  },
  "option": [
    {
      "name": "--best",
      "alias": [
        "-Z"
      ],
      "usage": [
        "-Z, --best"
      ],
      "tip": [
        "使用最高压缩级别 (11)。",
        "这是默认行为。"
      ]
    },
    {
      "name": "--comment=",
      "alias": [
        "-C"
      ],
      "usage": [
        "-C, --comment=B64"
      ],
      "tip": [
        "设置注释。",
        "参数会先进行 base64 解码；解码后的最大长度为 80。",
        "解码时: 检查流中的注释。",
        "编码时: 嵌入注释 (指纹)。"
      ],
      "next": []
    },
    {
      "name": "--concatenated",
      "alias": [
        "-K"
      ],
      "usage": [
        "-K, --concatenated"
      ],
      "tip": [
        "允许将拼接的 brotli 流作为输入。",
        "仅在与 --decompress 一起使用时有效。"
      ]
    },
    {
      "name": "--decompress",
      "alias": [
        "-d"
      ],
      "usage": [
        "-d, --decompress"
      ],
      "tip": [
        "解压。"
      ]
    },
    {
      "name": "--dictionary=",
      "alias": [
        "-D"
      ],
      "usage": [
        "-D, --dictionary=FILE"
      ],
      "tip": [
        "使用 FILE 作为原始 (LZ77) 字典。"
      ],
      "next": []
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "强制覆盖输出文件。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示此帮助信息并退出。"
      ]
    },
    {
      "name": "--keep",
      "alias": [
        "-k"
      ],
      "usage": [
        "-k, --keep"
      ],
      "tip": [
        "保留源文件。",
        "这是默认行为。"
      ]
    },
    {
      "name": "--large_window=",
      "usage": [
        "--large_window=NUM"
      ],
      "tip": [
        "使用不兼容的大窗口 brotli 比特流，窗口大小为 (0, 10-30)。",
        "窗口大小 = 2**NUM - 16。",
        "警告: 此格式与 brotli RFC 7932 不兼容，常规 brotli 解码器可能无法解码。",
        "不能与 --lgwin 一起使用。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "10"
        },
        {
          "name": "11"
        },
        {
          "name": "12"
        },
        {
          "name": "13"
        },
        {
          "name": "14"
        },
        {
          "name": "15"
        },
        {
          "name": "16"
        },
        {
          "name": "17"
        },
        {
          "name": "18"
        },
        {
          "name": "19"
        },
        {
          "name": "20"
        },
        {
          "name": "21"
        },
        {
          "name": "22"
        },
        {
          "name": "23"
        },
        {
          "name": "24"
        },
        {
          "name": "25"
        },
        {
          "name": "26"
        },
        {
          "name": "27"
        },
        {
          "name": "28"
        },
        {
          "name": "29"
        },
        {
          "name": "30"
        }
      ]
    },
    {
      "name": "--lgwin=",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --lgwin=NUM"
      ],
      "tip": [
        "设置 LZ77 窗口大小 (0, 10-24)。",
        "窗口大小 = 2**NUM - 16。",
        "0 表示由压缩器选择最优值。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "10"
        },
        {
          "name": "11"
        },
        {
          "name": "12"
        },
        {
          "name": "13"
        },
        {
          "name": "14"
        },
        {
          "name": "15"
        },
        {
          "name": "16"
        },
        {
          "name": "17"
        },
        {
          "name": "18"
        },
        {
          "name": "19"
        },
        {
          "name": "20"
        },
        {
          "name": "21"
        },
        {
          "name": "22"
        },
        {
          "name": "23"
        },
        {
          "name": "24"
        }
      ]
    },
    {
      "name": "--no-copy-stat",
      "alias": [
        "-n"
      ],
      "usage": [
        "-n, --no-copy-stat"
      ],
      "tip": [
        "不复制源文件属性。"
      ]
    },
    {
      "name": "--output=",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --output=FILE"
      ],
      "tip": [
        "输出文件 (仅限 1 个输入文件)。"
      ],
      "next": []
    },
    {
      "name": "--quality=",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quality=NUM"
      ],
      "tip": [
        "压缩级别 (0-11)。",
        "-Z 和 --best 会选择 11。"
      ],
      "next": [
        {
          "name": "0"
        },
        {
          "name": "1"
        },
        {
          "name": "10"
        },
        {
          "name": "11"
        },
        {
          "name": "2"
        },
        {
          "name": "3"
        },
        {
          "name": "4"
        },
        {
          "name": "5"
        },
        {
          "name": "6"
        },
        {
          "name": "7"
        },
        {
          "name": "8"
        },
        {
          "name": "9"
        }
      ]
    },
    {
      "name": "--rm",
      "alias": [
        "-j"
      ],
      "usage": [
        "-j, --rm"
      ],
      "tip": [
        "删除源文件。"
      ]
    },
    {
      "name": "--squash",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --squash"
      ],
      "tip": [
        "如果目标文件大于源文件，则删除目标文件。",
        "不能与 --stdout 一起使用。"
      ]
    },
    {
      "name": "--stdout",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --stdout"
      ],
      "tip": [
        "写入标准输出。"
      ]
    },
    {
      "name": "--suffix=",
      "alias": [
        "-S"
      ],
      "usage": [
        "-S, --suffix=SUF"
      ],
      "tip": [
        "输出文件后缀 (默认为 '.br')。",
        "允许使用任何不含 / 或 \\ 的后缀。"
      ],
      "next": [
        {
          "name": ".br"
        }
      ]
    },
    {
      "name": "--test",
      "alias": [
        "-t"
      ],
      "usage": [
        "-t, --test"
      ],
      "tip": [
        "测试压缩文件的完整性。"
      ]
    },
    {
      "name": "--verbose",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --verbose"
      ],
      "tip": [
        "详细模式。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息并退出。"
      ]
    },
    {
      "name": "-0",
      "tip": [
        "使用压缩级别 0。"
      ]
    },
    {
      "name": "-1",
      "tip": [
        "使用压缩级别 1。"
      ]
    },
    {
      "name": "-2",
      "tip": [
        "使用压缩级别 2。"
      ]
    },
    {
      "name": "-3",
      "tip": [
        "使用压缩级别 3。"
      ]
    },
    {
