        "使用压缩级别 4。"
      ]
    },
    {
      "name": "-5",
      "tip": [
        "使用压缩级别 5。"
      ]
    },
    {
      "name": "-6",
      "tip": [
        "使用压缩级别 6。"
      ]
    },
    {
      "name": "-7",
      "tip": [
        "使用压缩级别 7。"
      ]
    },
    {
      "name": "-8",
      "tip": [
        "使用压缩级别 8。"
      ]
    },
    {
      "name": "-9",
      "tip": [
        "使用压缩级别 9。"
      ]
    }
  ]
}
