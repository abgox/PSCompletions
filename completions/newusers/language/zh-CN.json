{
  "meta": {
    "url": "https://github.com/shadow-maint/shadow",
    "description": [
      "批量更新并创建新用户。"
    ]
  },
  "option": [
    {
      "name": "--badname",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --badname"
      ],
      "tip": [
        "允许不符合标准的名称。(已弃用)"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息并退出。"
      ]
    },
    {
      "name": "--root",
      "alias": [
        "-R"
      ],
      "usage": [
        "-R, --root <CHROOT_DIR>"
      ],
      "tip": [
        "在 CHROOT_DIR 目录中应用更改，并使用该目录中的配置文件。",
        "仅支持绝对路径。"
      ],
      "next": []
    },
    {
      "name": "--system",
      "alias": [
        "-r"
      ],
      "usage": [
        "-r, --system"
      ],
      "tip": [
        "创建系统账户。"
      ]
    }
  ]
}
