{
  "meta": {
    "url": "https://uutils.org",
    "description": [
      "将每个文件写入标准输出，同时拆分长行。"
    ]
  },
  "option": [
    {
      "name": "--bytes",
      "alias": [
        "-b"
      ],
      "usage": [
        "-b, --bytes"
      ],
      "tip": [
        "使用字节而非列来计数",
        "（意味着换行符等控制字符不会被特殊处理）"
      ]
    },
    {
      "name": "--characters",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --characters"
      ],
      "tip": [
        "按字符位置而非显示列数计数"
      ]
    },
    {
      "name": "--spaces",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --spaces"
      ],
      "tip": [
        "在单词边界处断行而非硬截断"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    },
    {
      "name": "--width",
      "alias": [
        "-w"
      ],
      "usage": [
        "-w, --width <WIDTH>"
      ],
      "tip": [
        "设置 WIDTH 为最大行宽而非 80"
      ],
      "next": []
    }
  ],
  "global_option": [
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    }
  ]
}
