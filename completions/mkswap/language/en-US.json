{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "Set up a Linux swap area."
    ]
  },
  "option": [
    {
      "name": "--check",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --check"
      ],
      "tip": [
        "Check bad blocks before creating the swap area."
      ]
    },
    {
      "name": "--endianness",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --endianness=<value>"
      ],
      "tip": [
        "Specify the endianness to use.",
        "Possible values: native, little, big"
      ],
      "next": [
        {
          "name": "big"
        },
        {
          "name": "little"
        },
        {
          "name": "native"
        }
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --file"
      ],
      "tip": [
        "Create a swap file."
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "Allow the swap area to be larger than the device."
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "Display this help."
      ]
    },
    {
      "name": "--label",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --label <LABEL>"
      ],
      "tip": [
        "Specify label."
      ],
      "next": []
    },
    {
      "name": "--lock",
      "usage": [
        "--lock[=<mode>]"
      ],
      "tip": [
        "Use exclusive device lock.",
        "Possible values: yes, no, nonblock"
      ],
      "next": [
        {
          "name": "no"
        },
        {
          "name": "nonblock"
        },
        {
          "name": "yes"
        }
      ]
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <OFFSET>"
      ],
      "tip": [
        "Specify the offset in the device."
      ],
      "next": []
    },
    {
      "name": "--pagesize",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pagesize <SIZE>"
      ],
      "tip": [
        "Specify page size in bytes."
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "Suppress output and warning messages."
      ]
    },
    {
      "name": "--size",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --size <SIZE>"
      ],
      "tip": [
        "Specify the size of a swap file in bytes."
      ],
      "next": []
    },
    {
      "name": "--swapversion",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --swapversion <NUM>"
      ],
      "tip": [
        "Specify swap-space version number.",
        "Only version 1 is supported."
      ],
      "next": [
        {
          "name": "1"
        }
      ]
    },
    {
      "name": "--uuid",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --uuid <UUID>"
      ],
      "tip": [
        "Specify the UUID to use."
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "tip": [
        "Verbose output."
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "Display version."
      ]
    }
  ]
}
