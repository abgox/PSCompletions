{
  "meta": {
    "url": "https://github.com/util-linux/util-linux",
    "description": [
      "设置 Linux 交换区。"
    ]
  },
  "option": [
    {
      "name": "--check",
      "alias": [
        "-c"
      ],
      "usage": [
        "-c, --check"
      ],
      "tip": [
        "创建交换区前检查坏块。"
      ]
    },
    {
      "name": "--endianness",
      "alias": [
        "-e"
      ],
      "usage": [
        "-e, --endianness=<value>"
      ],
      "tip": [
        "指定要使用的字节序。",
        "可能值: native, little, big"
      ],
      "next": [
        {
          "name": "big"
        },
        {
          "name": "little"
        },
        {
          "name": "native"
        }
      ]
    },
    {
      "name": "--file",
      "alias": [
        "-F"
      ],
      "usage": [
        "-F, --file"
      ],
      "tip": [
        "创建交换文件。"
      ]
    },
    {
      "name": "--force",
      "alias": [
        "-f"
      ],
      "usage": [
        "-f, --force"
      ],
      "tip": [
        "允许交换区大于设备。"
      ]
    },
    {
      "name": "--help",
      "alias": [
        "-h"
      ],
      "usage": [
        "-h, --help"
      ],
      "tip": [
        "显示帮助信息。"
      ]
    },
    {
      "name": "--label",
      "alias": [
        "-L"
      ],
      "usage": [
        "-L, --label <LABEL>"
      ],
      "tip": [
        "指定标签。"
      ],
      "next": []
    },
    {
      "name": "--lock",
      "usage": [
        "--lock[=<mode>]"
      ],
      "tip": [
        "使用独占的设备锁。",
        "可能值: yes, no, nonblock"
      ],
      "next": [
        {
          "name": "no"
        },
        {
          "name": "nonblock"
        },
        {
          "name": "yes"
        }
      ]
    },
    {
      "name": "--offset",
      "alias": [
        "-o"
      ],
      "usage": [
        "-o, --offset <OFFSET>"
      ],
      "tip": [
        "指定设备中的偏移量。"
      ],
      "next": []
    },
    {
      "name": "--pagesize",
      "alias": [
        "-p"
      ],
      "usage": [
        "-p, --pagesize <SIZE>"
      ],
      "tip": [
        "以字节指定页大小。"
      ],
      "next": []
    },
    {
      "name": "--quiet",
      "alias": [
        "-q"
      ],
      "usage": [
        "-q, --quiet"
      ],
      "tip": [
        "抑制输出和警告消息。"
      ]
    },
    {
      "name": "--size",
      "alias": [
        "-s"
      ],
      "usage": [
        "-s, --size <SIZE>"
      ],
      "tip": [
        "以字节指定交换文件的大小。"
      ],
      "next": []
    },
    {
      "name": "--swapversion",
      "alias": [
        "-v"
      ],
      "usage": [
        "-v, --swapversion <NUM>"
      ],
      "tip": [
        "指定交换空间版本号。",
        "仅支持版本 1。"
      ],
      "next": [
        {
          "name": "1"
        }
      ]
    },
    {
      "name": "--uuid",
      "alias": [
        "-U"
      ],
      "usage": [
        "-U, --uuid <UUID>"
      ],
      "tip": [
        "指定要使用的 UUID。"
      ],
      "next": []
    },
    {
      "name": "--verbose",
      "tip": [
        "详细输出。"
      ]
    },
    {
      "name": "--version",
      "alias": [
        "-V"
      ],
      "usage": [
        "-V, --version"
      ],
      "tip": [
        "显示版本信息。"
      ]
    }
  ]
}
