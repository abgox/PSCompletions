{
  "[json]": {
    "editor.detectIndentation": false,
    "editor.tabSize": 2,
    "prettier.printWidth": 0
  },
  "[jsonc]": {
    "editor.detectIndentation": false,
    "editor.tabSize": 2,
    "prettier.printWidth": 0
  },
  "[lua]": {
    "editor.defaultFormatter": "sumneko.lua"
  },
  "[markdown]": {
    "editor.formatOnSave": false
  },
  "[powershell]": {
    "editor.defaultFormatter": "ms-vscode.powershell",
    "files.encoding": "utf8bom"
  },
  "[rust]": {
    "editor.formatOnSave": false
  },
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "editor.insertSpaces": true,
  "files.insertFinalNewline": true,
  "json-schema-plus.schemas": [
    {
      "fileMatch": [
        "completions/*/language/*.json"
      ],
      "url": "./schema/completion-manifest.en-US.json",
      "urls": [
        {
          "language": "zh",
          "url": "./schema/completion-manifest.zh-CN.json"
        }
      ]
    },
    {
      "fileMatch": [
        "completions/*/config.json"
      ],
      "url": "./schema/completion-config.en-US.json",
      "urls": [
        {
          "language": "zh",
          "url": "./schema/completion-config.zh-CN.json"
        }
      ]
    }
  ],
  "Lua.diagnostics.globals": [
    "psc",
    "completions"
  ],
  "Lua.workspace.ignoreDir": [
    "**/hooks.lua"
  ],
  "Lua.workspace.library": [
    "${workspaceFolder}/types"
  ],
  "powershell.codeFormatting.trimWhitespaceAroundPipe": true,
  "powershell.codeFormatting.useConstantStrings": true,
  "powershell.codeFormatting.useCorrectCasing": true,
  "powershell.scriptAnalysis.enable": false
}
