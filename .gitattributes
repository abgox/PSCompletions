# LF everywhere, PowerShell excepted.
#
# `text=auto` keeps git's own binary detection (a binary is never rewritten); `eol=lf` forces the checkout form on every platform. 
# A CRLF bridge fails in bash/zsh/fish with `syntax error near unexpected token '$'{\r''`.
* text=auto eol=lf

*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
