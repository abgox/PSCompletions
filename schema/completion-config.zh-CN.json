{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "required": [
    "id",
    "language"
  ],
  "definitions": {
    "string": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "\\s"
          },
          "errorMessage": "请移除空格"
        }
      ]
    },
    "array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "properties": {
    "id": {
      "markdownDescription": "补全的稳定唯一标识符。\n\n- 创建补全时生成的随机 UUID\n- 即使补全被重命名（目录名改变）也保持不变\n- 引擎用它检测重命名并自动迁移配置",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "language": {
      "markdownDescription": "可用的语言。",
      "examples": [
        [
          "en-US",
          "zh-CN"
        ]
      ],
      "allOf": [
        {
          "$ref": "#/definitions/array"
        },
        {
          "items": [
            {
              "const": "en-US",
              "description": "英文"
            },
            {
              "const": "zh-CN",
              "description": "简体中文"
            }
          ]
        },
        {
          "items": {
            "type": "string",
            "enum": [
              "en-US",
              "zh-CN"
            ]
          }
        }
      ]
    },
    "hooks": {
      "markdownDescription": "定义 hooks 的默认值\n\n- 如果为 `false`，则需要手动启用它: `psc completion xxx enable_hooks 1`\n- 如果不需要 hooks，请移除这个字段",
      "type": "boolean"
    },
    "alias": {
      "markdownDescription": "补全的触发别名\n\n- 如果不设置，则使用目录名\n- 如果设置了，则目录名会被忽略，仅使用此字段中的名称",
      "examples": [
        []
      ],
      "allOf": [
        {
          "$ref": "#/definitions/array"
        },
        {
          "items": {
            "allOf": [
              {
                "$ref": "#/definitions/string"
              },
              {
                "not": {
                  "pattern": "\\.(cmd|exe|bat)$"
                },
                "errorMessage": "请省略 .cmd、.exe、.bat 后缀，直接使用命令名称"
              }
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
