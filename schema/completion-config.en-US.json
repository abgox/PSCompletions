{
  "$schema": "http://json-schema.org/draft-07/schema",
  "type": "object",
  "required": [
    "id",
    "language"
  ],
  "definitions": {
    "string": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        {
          "not": {
            "pattern": "\\s"
          },
          "errorMessage": "Please remove whitespace"
        }
      ]
    },
    "array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "properties": {
    "id": {
      "markdownDescription": "Stable unique identifier for the completion.\n\n- A random UUID generated when the completion is created\n- Never changes, even if the completion is renamed (directory name changes)\n- Used by the engine to detect renames and migrate configs automatically",
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "language": {
      "markdownDescription": "Available languages.",
      "examples": [
        [
          "en-US",
          "zh-CN"
        ]
      ],
      "allOf": [
        {
          "$ref": "#/definitions/array"
        },
        {
          "items": [
            {
              "const": "en-US",
              "description": "English"
            },
            {
              "const": "zh-CN",
              "description": "Chinese Simplified"
            }
          ]
        },
        {
          "items": {
            "type": "string",
            "enum": [
              "en-US",
              "zh-CN"
            ]
          }
        }
      ]
    },
    "hooks": {
      "markdownDescription": "Define the default value of hooks.\n\n- If it is `false`, enable it manually: `psc completion xxx enable_hooks 1`\n- If it does not need hooks, please remove it.",
      "type": "boolean"
    },
    "alias": {
      "markdownDescription": "Trigger alias for completions\n\n- If not set, the directory name is used\n- If set, the directory name is ignored and only the names in this array are used",
      "examples": [
        []
      ],
      "allOf": [
        {
          "$ref": "#/definitions/array"
        },
        {
          "items": {
            "allOf": [
              {
                "$ref": "#/definitions/string"
              },
              {
                "not": {
                  "pattern": "\\.(cmd|exe|bat)$"
                },
                "errorMessage": "Please omit .cmd, .exe, .bat suffixes, use the command name directly"
              }
            ]
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
